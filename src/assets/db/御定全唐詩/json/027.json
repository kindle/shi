[
    {
        "title": "雜曲歌辭：遼東行",
        "author": "王建",
        "biography": "",
        "paragraphs": [
            "遼東万里遼水曲，古戍无城複无屋。黃雲蓋地雪作山，",
            "年年郡縣送征人，将与遼東作丘阪。寧為草木鄉中生，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 1
    },
    {
        "title": "雜曲歌辭：渡遼水",
        "author": "王建",
        "biography": "",
        "paragraphs": [
            "渡遼水，此去咸阳五千里。來时父母知隔生，",
            "身在應无回渡日，駐馬相看遼水傍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 2
    },
    {
        "title": "雜曲歌辭：昔昔鹽：垂柳覆金堤",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "新年垂柳色，嫋嫋对空閨。不畏芳菲好，自緣離別啼。",
            "因风飄玉戶，向日映金堤。驛使何时度，還将贈隴西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 3
    },
    {
        "title": "雜曲歌辭：昔昔鹽：蘼蕪葉複齊",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "提筐紅葉下，度日采蘼蕪。掬翠香盈袖，看花憶故夫。",
            "葉齊谁複見，风暖恨偏孤。一被春光累，容顏与昔殊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 4
    },
    {
        "title": "雜曲歌辭：昔昔鹽：水溢芙蓉沼",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "淥沼春光后，青青草色濃。綺羅驚翡翠，暗粉妒芙蓉。",
            "雲遍窗前見，荷翻鏡裏逢。将心托流水，終日渺无從。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 5
    },
    {
        "title": "雜曲歌辭：昔昔鹽：花飛桃李蹊",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "遠期難可托，桃李自依依。花徑无容跡，戎裘未下机。",
            "隨风開又落，度日掃還飛。欲折枝枝贈，那知归不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 6
    },
    {
        "title": "雜曲歌辭：昔昔鹽：采桑秦氏女",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "南陌采桑出，谁知妾姓秦。独怜傾國貌，不負早鶯春。",
            "珠履蕩花濕，龍鉤折桂新。使君那駐馬，自有侍中人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 7
    },
    {
        "title": "雜曲歌辭：昔昔鹽：織錦竇家妻",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "當年谁不羨，分作竇家妻。錦字行行苦，羅帷日日啼。",
            "豈知登隴遠，只恨下机迷。直候阳關使，殷勤寄海西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 8
    },
    {
        "title": "雜曲歌辭：昔昔鹽：關山別蕩子",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "那堪闻蕩子，迢遞涉關山。腸為馬嘶斷，衣從淚滴斑。",
            "愁看塞上路，詎惜鏡中顏。儻見征西雁，應傳一字還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 9
    },
    {
        "title": "雜曲歌辭：昔昔鹽：风月守空閨",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "良人犹遠戍，耿耿夜閨空。繡戶流宵月，羅帷坐曉风。",
            "魂飛沙帳北，腸斷玉關中。尚自无消息，錦衾那得同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 10
    },
    {
        "title": "雜曲歌辭：昔昔鹽：恒斂千金笑",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "玉顏恒自斂，羞出鏡臺前。早惑阳城客，今悲華錦筵。",
            "從军人更遠，投喜鵲空傳。夫婿交河北，迢迢路幾千。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 11
    },
    {
        "title": "雜曲歌辭：昔昔鹽：長垂雙玉啼",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雙雙紅淚墮，度日暗中啼。雁出居延北，人犹遼海西。",
            "向燈垂玉枕，对月灑金閨。不惜羅衣濕，惟愁归意迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 12
    },
    {
        "title": "雜曲歌辭：昔昔鹽：蟠龍隨鏡隱",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "鸞鏡无由照，蛾眉豈忍看。不知愁發换，空見隱龍蟠。",
            "那愜紅顏改，偏傷白日残。今朝窺玉匣，雙淚落闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 13
    },
    {
        "title": "雜曲歌辭：昔昔鹽：彩鳳逐帷低",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "巧繡雙飛鳳，朝朝伴下帷。春花那見照，暮色已频欺。",
            "欲卷思君处，将啼裛淚时。何年征戍客，傳语報佳期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 14
    },
    {
        "title": "雜曲歌辭：昔昔鹽：驚魂同夜鵲",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "万里无人見，眾情難与論。思君常入夢，同鵲屡驚魂。",
            "孤寢紅羅帳，雙啼玉箸痕。妾心甘自保，豈複暫忘恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 15
    },
    {
        "title": "雜曲歌辭：昔昔鹽：倦寢聽晨雞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "去去邊城騎，愁眠掩夜閨。披衣窺落月，拭淚待鳴雞。",
            "不憤連年別，那堪長夜啼。功成應自恨，早晚發遼西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 16
    },
    {
        "title": "雜曲歌辭：昔昔鹽：暗牖懸蛛網",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "暗中蛛網織，曆乱綺窗前。万里終无信，一條徒自懸。",
            "分從珠露滴，愁見隙风牽。妾意何聊賴，看看劇斷弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 17
    },
    {
        "title": "雜曲歌辭：昔昔鹽：空梁落燕泥",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "春至今朝燕，花时伴独啼。飛斜珠箔隔，语近画梁低。",
            "帷卷閑窺戶，床空暗落泥。谁能長对此，雙去複雙棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 18
    },
    {
        "title": "雜曲歌辭：昔昔鹽：前年過代北",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "代北幾千里，前年又複經。燕山雲自合，胡塞草應青。",
            "鐵馬喧鼙鼓，蛾眉怨錦屏。不知羌笛曲，掩淚若為聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 19
    },
    {
        "title": "雜曲歌辭：昔昔鹽：今歲往遼西",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "万里飛书至，闻君已渡遼。只諳新別苦，忘卻舊时嬌。",
            "烽戍年将老，紅顏日向凋。胡沙兼漢苑，相望幾迢迢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 20
    },
    {
        "title": "雜曲歌辭：昔昔鹽：一去无還意",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "良人征絕域，一去不言還。百戰攻胡虜，三冬阻玉關。",
            "蕭蕭邊馬思，獵獵戍旗閑。独把千重恨，連年未解顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 21
    },
    {
        "title": "雜曲歌辭：昔昔鹽：那能惜馬蹄",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雲中路杳杳，江畔草萋萋。妾久垂珠淚，君何惜馬蹄。",
            "邊风悲曉角，營月怨春鼙。未道休征戰，愁眉又複低。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 22
    },
    {
        "title": "雜曲歌辭：水調歌第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "平沙落日大荒西，隴上明星高複低。",
            "孤山幾处看烽火，壯士連營候鼓鼙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 23
    },
    {
        "title": "雜曲歌辭：水調歌第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "猛将關西意气多，能騎駿馬弄雕戈。",
            "金鞍寶鉸精神出，笛倚新翻水調歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 24
    },
    {
        "title": "雜曲歌辭：水調歌第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "王孫別上綠珠輪，不羨名公樂此身。",
            "戶外碧潭春洗馬，樓前紅燭夜迎人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 25
    },
    {
        "title": "雜曲歌辭：水調歌第四",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "隴頭一段气長秋，舉目蕭條總是愁。",
            "只為征人多下淚，年年添作斷腸流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 26
    },
    {
        "title": "雜曲歌辭：水調歌第五",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "雙帶仍分影，同心巧結香。不應須换彩，意欲媚濃妝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 27
    },
    {
        "title": "雜曲歌辭：入破第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "細草河邊一雁飛，黃龍關裏掛戎衣。",
            "為受明王恩寵甚，從事經年不復归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 28
    },
    {
        "title": "雜曲歌辭：入破第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "錦城絲管日紛紛，半入江风半入雲。",
            "此曲只應天上去，人間能得幾回闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 29
    },
    {
        "title": "雜曲歌辭：入破第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "昨夜遙歡出建章，今朝綴賞度昭阳。",
            "傳聲莫閉黃金屋，為報先開白玉堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 30
    },
    {
        "title": "雜曲歌辭：入破第四",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "日晚笳聲咽戍樓，隴雲漫漫水東流。",
            "行人万里向西去，滿目關山空恨愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 31
    },
    {
        "title": "雜曲歌辭：入破第五",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "千年一遇圣明朝，愿对君王舞細腰。",
            "乍可當熊任生死，谁能伴鳳上雲霄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 32
    },
    {
        "title": "雜曲歌辭：第六徹",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "閨燭无人影，羅屏有夢魂。近來音耗絕，終日望君門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 33
    },
    {
        "title": "雜曲歌辭：水調",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "鑿河千里走黃沙，浮殿西來動日華。",
            "可道新聲是亡國，且貪惆悵后庭花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 34
    },
    {
        "title": "雜曲歌辭：堂堂",
        "author": "李義府",
        "biography": "",
        "paragraphs": [
            "鏤月成歌扇，裁雲作舞衣。自怜回雪影，好取洛川归。",
            "懶正鴛鴦被，羞褰玳瑁床。春风別有意，密处也尋香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 35
    },
    {
        "title": "雜曲歌辭：堂堂",
        "author": "李義府",
        "biography": "",
        "paragraphs": [
            "堂堂複堂堂，紅脫梅灰香。十年粉蠹生画梁，",
            "華清源中iJ石湯，裴回百鳳隨君王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 36
    },
    {
        "title": "雜曲歌辭：涼州歌第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "漢家宮裏柳如絲，上苑桃花連碧池。",
            "圣壽已傳千歲酒，天文更賞百僚诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 37
    },
    {
        "title": "雜曲歌辭：涼州歌第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "朔风吹葉雁門秋，万里煙塵昏戍樓。",
            "征馬長思青海北，胡笳夜聽隴山頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 38
    },
    {
        "title": "雜曲歌辭：涼州歌第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "開篋淚沾襦，見君前日书。夜台空寂寞，犹見紫雲車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 39
    },
    {
        "title": "雜曲歌辭：排遍第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "三秋陌上早霜飛，羽獵平田淺草齊。",
            "錦背蒼鷹初出按，五花驄馬喂來肥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 40
    },
    {
        "title": "雜曲歌辭：排遍第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "鴛鴦殿裏笙歌起，翡翠樓前出舞人。",
            "喚上紫微三五夕，圣明方壽一千春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 41
    },
    {
        "title": "雜曲歌辭：涼州詞",
        "author": "耿湋",
        "biography": "",
        "paragraphs": [
            "國使翩翩隨旆旌，隴西岐路足荒城。",
            "氈裘牧馬胡雛小，日暮蕃歌三两聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 42
    },
    {
        "title": "雜曲歌辭：涼州詞",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "邊城暮雨雁飛低，蘆筍初生漸欲齊。",
            "无数鈴聲遙過磧，應馱白練到安西。",
            "古鎮城門白磧開，胡兵往往傍沙堆。",
            "巡邊使客行應早，每待平安火到來。",
            "鳳林關裏水東流，白草黃榆六十秋。",
            "邊将皆承主恩澤，无人解道取涼州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 43
    },
    {
        "title": "雜曲歌辭：涼州詞",
        "author": "薛逢",
        "biography": "",
        "paragraphs": [
            "昨夜蕃兵報國仇，沙州都護破涼州。",
            "黃河九曲今归漢，塞外縱橫戰血流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 44
    },
    {
        "title": "雜曲歌辭：太和第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "國門卿相舊山莊，圣主移來宴綠芳。",
            "簾外輾為車馬路，花間踏出舞人場。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 45
    },
    {
        "title": "雜曲歌辭：太和第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "國鳥尚含天樂轉，寒风犹帶禦衣香。",
            "為報碧潭明月夜，會須留賞待君王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 46
    },
    {
        "title": "雜曲歌辭：太和第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "庭前鵲繞相思樹，井上鶯歌爭刺桐。",
            "含情少婦悲春草，多是良人學轉蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 47
    },
    {
        "title": "雜曲歌辭：太和第四",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "塞北江南共一家，何須淚落怨黃沙。",
            "春酒半酣千日醉，庭前還有落梅花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 48
    },
    {
        "title": "雜曲歌辭：太和第五徹",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "我皇膺运太平年，四海朝宗會百川。",
            "自古幾多明圣主，不如今帝勝堯天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 49
    },
    {
        "title": "雜曲歌辭：伊川歌第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "秋风明月独離居，蕩子從戎十载餘。",
            "征人去日殷勤屬，归雁來时数寄书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 50
    },
    {
        "title": "雜曲歌辭：伊川歌第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "彤闈曉辟万鞍回，玉輅春遊薄晚開。",
            "渭北清光搖草樹，州南嘉景入樓臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 51
    },
    {
        "title": "雜曲歌辭：伊川歌第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "闻道黃花戍，频年不解兵。可怜閨裏月，偏照漢家營。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 52
    },
    {
        "title": "雜曲歌辭：伊川歌第四",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "千里東归客，无心憶舊遊。掛帆遊白水，高枕到青州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 53
    },
    {
        "title": "雜曲歌辭：伊川歌第五",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "桂殿江烏对，雕屏海燕重。只應多釀酒，醉罷樂高鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 54
    },
    {
        "title": "雜曲歌辭：入破第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "千門今夜曉初晴，万里天河徹帝京。",
            "璨璨繁星駕秋色，棱棱霜气韵鐘聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 55
    },
    {
        "title": "雜曲歌辭：入破第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "長安二月柳依依，西出流沙路漸微。",
            "閼氏山上春光少，相府庭邊驛使稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 56
    },
    {
        "title": "雜曲歌辭：入破第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "三秋大漠冷溪山，八月嚴霜變草顏。",
            "卷旆风行宵渡磧，銜枚電掃曉應還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 57
    },
    {
        "title": "雜曲歌辭：入破第四",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "行樂三阳早，芳菲二月春。閨中紅粉態，陌上看花人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 58
    },
    {
        "title": "雜曲歌辭：入破第五",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "君住孤山下，煙深夜徑長。轅門渡綠水，游苑繞垂楊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 59
    },
    {
        "title": "雜曲歌辭：陸州歌第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "分野中峰變，阴晴眾壑殊。欲投人处宿，隔浦问樵夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 60
    },
    {
        "title": "雜曲歌辭：陸州歌第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "共得煙霞徑，東归山水遊。蕭蕭望林夜，寂寂坐中秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 61
    },
    {
        "title": "雜曲歌辭：陸州歌第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "香气傳空滿，妝花映薄紅。歌聲天仗外，舞態禦樓中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 62
    },
    {
        "title": "雜曲歌辭：排遍第一",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "樹發花如錦，鶯啼柳若絲。更逢歡宴地，愁見別離时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 63
    },
    {
        "title": "雜曲歌辭：排遍第二",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "明月照秋葉，西风響夜砧。強言徒自乱，往事不堪尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 64
    },
    {
        "title": "雜曲歌辭：排遍第三",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "坐对銀釭曉，停留玉箸痕。君門常不見，无处謝前恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 65
    },
    {
        "title": "雜曲歌辭：排遍第四",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "曙月當窗滿，征人出塞遙。画樓終日閉，清管為谁調。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 66
    },
    {
        "title": "雜曲歌辭：簇拍陸州",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "西去輪台万里餘，故鄉音耗日應疏。",
            "隴山鸚鵡能言语，為報閨人数寄书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 67
    },
    {
        "title": "雜曲歌辭：石州",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "自從君去遠巡邊，終日羅幃独自眠。看花情轉切，",
            "何时狂虜滅，免得更留連。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 68
    },
    {
        "title": "雜曲歌辭：蓋羅縫",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "秦时明月漢时關，万里征人尚未還。",
            "但愿龍庭神将在，不教胡馬渡阴山。",
            "音书杜絕白狼西，桃李无顏黃鳥啼。",
            "寒鳥春深归去盡，出門腸斷草萋萋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 69
    },
    {
        "title": "雜曲歌辭：雙帶子",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "私言切语谁人會，海燕雙飛繞画梁。",
            "君學秋胡不相识，妾亦无心去采桑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 70
    },
    {
        "title": "雜曲歌辭：昆侖子",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "揚子譚經去，淮王载酒過。醉來啼鳥喚，坐久落花多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 71
    },
    {
        "title": "雜曲歌辭：祓禊曲",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "昨見春條綠，那知秋葉黃。蟬聲犹未斷，寒雁已成行。",
            "金谷園中柳，春來已舞腰。那堪好风景，独上洛阳橋。",
            "何处堪愁思，花間長樂宮。君王不重客，泣淚向春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 72
    },
    {
        "title": "雜曲歌辭：上巳樂",
        "author": "张祜",
        "biography": "",
        "paragraphs": [
            "猩猩血彩系頭標，天上齊聲舉画橈。",
            "卻是內人爭意切，六宮羅袖一时招。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 73
    },
    {
        "title": "雜曲歌辭：穆護砂",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "玉管朝朝弄，清歌日日新。折花當驛路，寄与隴頭人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 74
    },
    {
        "title": "雜曲歌辭：思归樂",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "晚日催弦管，春风入綺羅。杏花如有意，偏落舞衫多。",
            "万里春應盡，三江雁亦稀。連天漢水廣，孤客未言归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 75
    },
    {
        "title": "雜曲歌辭：金殿樂",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "入夜秋砧動，千門起四鄰。不緣樓上月，應為隴頭人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 76
    },
    {
        "title": "雜曲歌辭：胡渭州",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "亭亭孤月照行舟，寂寂長江万里流。",
            "鄉國不知何处是，雲山漫漫使人愁。",
            "楊柳千尋色，桃花一苑芳。风吹入簾裏，惟有惹衣香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 77
    },
    {
        "title": "雜曲歌辭：戎渾",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "风勁角弓鳴，将军獵渭城。草枯鷹眼疾，雪盡馬蹄輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 78
    },
    {
        "title": "雜曲歌辭：牆頭花",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "蟋蟀鳴洞房，梧桐落金井。為君裁舞衣，天寒剪刀冷。",
            "妾有羅衣裳，秦王在时作。為舞春风多，秋來不堪著。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 79
    },
    {
        "title": "雜曲歌辭：采桑",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "自古多征戰，由來尚甲兵。長驅千里去，一舉两蕃平。",
            "按劍從沙漠，歌謠滿帝京。寄言天下将，須立武功名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 80
    },
    {
        "title": "雜曲歌辭：楊下采桑",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "飛絲惹綠塵，軟葉对孤輪。今朝入園去，物色強看人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 81
    },
    {
        "title": "雜曲歌辭：破陣樂",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "秋來四面足风沙，塞外征人暫別家。",
            "千里不辭行路遠，时光早晚到天涯。",
            "漢兵出頓金微，照日明光鐵衣。百里火幡焰焰，",
            "正屬四方朝賀，端知万舞皇威。",
            "少年膽气淩雲，共许驍雄出群。匹馬城南挑戰，",
            "誓欲成名報國，羞将開口論勳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 82
    },
    {
        "title": "雜曲歌辭：戰勝樂",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "百戰得功名，天兵意气生。三邊永不戰，此是我皇英。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 83
    },
    {
        "title": "雜曲歌辭：劍南臣",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "不分君恩斷，觀妝視鏡中。容華尚春日，嬌愛已秋风。",
            "枕席臨窗曉，屏帷对月空。年年后庭樹，芳悴在深宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 84
    },
    {
        "title": "雜曲歌辭：征步郎",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "塞外虜塵飛，频年度磧西。死生隨玉劍，辛苦向金微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 85
    },
    {
        "title": "雜曲歌辭：歎疆場",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "闻道行人至，妝梳对鏡臺。淚痕犹尚在，笑靨自然開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 86
    },
    {
        "title": "雜曲歌辭：塞姑",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "昨日盧梅塞口，整見諸人鎮守。",
            "都護三年不归，折盡江邊楊柳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 87
    },
    {
        "title": "雜曲歌辭：水鼓子",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "雕弓白羽獵初回，薄夜牛羊複下來。",
            "夢水河邊秋草合，黑山峰外陣雲開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 88
    },
    {
        "title": "雜曲歌辭：浣沙女",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "南陌春风早，東鄰去日斜。千花開瑞錦，香撲美人車。",
            "長樂青門外，宜春小苑東。樓開万戶上，人向百花中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 90
    },
    {
        "title": "雜曲歌辭：鎮西",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "天邊物色更无春，只有羊群与馬群。",
            "谁家營裏吹羌笛，哀怨教人不忍闻。",
            "歲去年來拜圣朝，更无山闕对溪橋。",
            "九門楊柳渾无半，犹自千條与万條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 91
    },
    {
        "title": "雜曲歌辭：回紇",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "曾闻瀚海使難通，幽閨少婦罷裁縫。緬想邊庭征戰苦，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 92
    },
    {
        "title": "雜曲歌辭：長命女",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "雲送關西雨，风傳渭北秋。孤燈然客夢，寒杵搗鄉愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 93
    },
    {
        "title": "雜曲歌辭：醉公子",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "昨日春園飲，今朝倒接z5。谁人扶上馬，不省下樓时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 94
    },
    {
        "title": "雜曲歌辭：一片子",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "柳色青山映，梨花雪鳥藏。綠窗桃李下，閑坐歎春芳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 95
    },
    {
        "title": "雜曲歌辭：甘州",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "欲使傳消息，空书意不任。寄君明月鏡，偏照故人心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 96
    },
    {
        "title": "雜曲歌辭：濮阳女",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "雁來书不至，月照独眠房。賤妾多愁思，不堪秋夜長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 97
    },
    {
        "title": "雜曲歌辭：相府蓮",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "夜闻鄰婦泣，切切有餘哀。即问緣何事，征人戰未回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 98
    },
    {
        "title": "雜曲歌辭：簇拍相府蓮",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "莫以今时寵，寧无舊日恩。看花滿眼淚，不共楚王言。",
            "閨燭无人影，羅屏有夢魂。近來音耗絕，終日望應門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 99
    },
    {
        "title": "雜曲歌辭：離別難",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "此別難重陳，花深複變人。來时梅覆雪，去日柳含春。",
            "物候催行客，归途淑气新。剡川今已遠，魂夢暗相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 100
    },
    {
        "title": "雜曲歌辭：離別難",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "綠楊陌上送行人，馬去車回一望塵。",
            "不觉別时紅淚盡，归來无淚可沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 101
    },
    {
        "title": "雜曲歌辭：山鷓鴣",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "玉關征戍久，空閨人独愁。寒露濕青苔，別來蓬鬢秋。",
            "人坐青樓晚，鶯语百花时。愁人多自老，腸斷君不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 102
    },
    {
        "title": "雜曲歌辭：鷓鴣詞",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "湘江斑竹枝，錦翼鷓鴣飛。处处湘阴合，郎從何处归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 103
    },
    {
        "title": "雜曲歌辭：鷓鴣詞",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "湘江煙水深，沙岸隔楓林。何处鷓鴣飛，日斜斑竹阴。",
            "二女虛垂淚，三閭枉自沉。惟有鷓鴣鳥，独傷行客心。",
            "越岡連越井，越鳥更南飛。何处鷓鴣啼，夕煙東嶺归。",
            "嶺頭行人少，天涯北客稀。鷓鴣啼別处，相对淚沾衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 104
    },
    {
        "title": "雜曲歌辭：樂世",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "管急絲繁拍漸稠，綠腰宛轉曲終頭。",
            "誠知樂世聲聲樂，老病人聽未免愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 105
    },
    {
        "title": "雜曲歌辭：急樂世",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "正抽碧線繡紅羅，忽聽黃鶯斂翠蛾。",
            "秋思冬愁春恨望，大都不得意时多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 106
    },
    {
        "title": "雜曲歌辭：何滿子",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "世傳滿子是人名，臨就刑时曲始成。",
            "一曲四詞歌八疊，從頭便是斷腸聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 107
    },
    {
        "title": "雜曲歌辭：何滿子",
        "author": "薛逢",
        "biography": "",
        "paragraphs": [
            "系馬宮槐老，持懷店菊黃。故交今不見，流恨滿川光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 108
    },
    {
        "title": "雜曲歌辭：清平調",
        "author": "李白",
        "biography": "",
        "paragraphs": [
            "雲想衣裳花想容，春风拂檻露華濃。",
            "若非群玉山頭見，會向瑤台月下逢。",
            "一枝紅豔露凝香，雲雨巫山枉斷腸。",
            "借问漢宮谁得似，可怜飛燕倚新妝。",
            "名花傾國两相歡，長得君王帶笑看。",
            "解釋春风无限恨，沉香亭北倚闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 109
    },
    {
        "title": "雜曲歌辭：回波樂",
        "author": "李景伯",
        "biography": "",
        "paragraphs": [
            "回波爾时酒卮，微臣職在箴規。",
            "侍宴既過三爵，喧嘩竊恐非仪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 110
    },
    {
        "title": "雜曲歌辭：圣明樂",
        "author": "张仲素",
        "biography": "",
        "paragraphs": [
            "玉帛殊方至，歌鐘比屋闻。華夷今一貫，同賀圣明君。",
            "九陌祥煙合，千春瑞月明。宮花将苑柳，先發鳳凰城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 111
    },
    {
        "title": "雜曲歌辭：圣明樂",
        "author": "令狐楚",
        "biography": "",
        "paragraphs": [
            "海浪恬丹徼，邊塵靖黑山。從今万里外，不復鎮蕭關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 112
    },
    {
        "title": "雜曲歌辭：大酺樂",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "淚滴珠難盡，容残玉易銷。儻隨明月去，莫道夢魂遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 113
    },
    {
        "title": "雜曲歌辭：大酺樂",
        "author": "杜審言",
        "biography": "",
        "paragraphs": [
            "圣后乘幹日，皇明禦曆辰。紫宮初啟坐，蒼璧正臨春。",
            "雷雨垂膏澤，金錢賜下人。詔酺歡賞遍，交泰睹惟新。",
            "毗陵震澤九州通，士女歡娛万國同。伐鼓撞鐘驚海上，",
            "大德不官逢道泰，天長地久屬年豐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 114
    },
    {
        "title": "雜曲歌辭：大酺樂",
        "author": "张祜",
        "biography": "",
        "paragraphs": [
            "車駕東來值太平，大酺三日洛阳城。",
            "小兒一伎竿頭絕，天下傳呼万歲聲。",
            "紫陌酺归日欲斜，紅塵開路薛王家。",
            "雙鬟前说樓前鼓，两伎爭輪好結花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 115
    },
    {
        "title": "雜曲歌辭：千秋樂",
        "author": "张祜",
        "biography": "",
        "paragraphs": [
            "八月平时花萼樓，万方同樂奏千秋。",
            "傾城人看長竿出，一伎初成趙解愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 116
    },
    {
        "title": "雜曲歌辭：火鳳辭",
        "author": "李百药",
        "biography": "",
        "paragraphs": [
            "歌聲扇裏出，妝影扇中輕。未能令掩笑，何处欲鄣聲。",
            "知音自不惑，得念是分明。莫見雙嚬斂，疑人含笑情。",
            "佳人靚晚妝，清唱動蘭房。影入含风扇，聲飛照日梁。",
            "嬌嚬眉際斂，逸韵口中香。自有橫陳分，應怜秋夜長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 117
    },
    {
        "title": "雜曲歌辭：熱戲樂",
        "author": "张祜",
        "biography": "",
        "paragraphs": [
            "熱戲爭心劇火燒，銅槌暗執不相饒。",
            "上皇失喜甯王笑，百尺幢竿果動搖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 118
    },
    {
        "title": "雜曲歌辭：春鶯囀",
        "author": "张祜",
        "biography": "",
        "paragraphs": [
            "興慶池南柳未開，太真先把一枝梅。",
            "內人已唱春鶯囀，花下傞傞軟舞來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 119
    },
    {
        "title": "雜曲歌辭：達摩支",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "搗麝成塵香不滅，拗蓮作寸絲難絕。紅淚文姬洛水春，",
            "舊臣頭鬢霜華早，可惜雄心醉中老。万古春归夢不归，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 120
    },
    {
        "title": "雜曲歌辭：如意娘",
        "author": "武則天",
        "biography": "",
        "paragraphs": [
            "看朱成碧思紛紛，憔悴支離為憶君。",
            "不信比來長下淚，開箱驗取石榴裙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 121
    },
    {
        "title": "雜曲歌辭：雨霖鈴",
        "author": "张祜",
        "biography": "",
        "paragraphs": [
            "雨霖鈴夜卻归秦，犹是张徽一曲新。",
            "長说上皇垂淚教，月明南內更无人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 122
    },
    {
        "title": "雜曲歌辭：桂花曲",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "可怜天上桂花孤，試问姮娥更要无。",
            "月宮幸有闲田地，何不中央種两株。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 123
    },
    {
        "title": "雜曲歌辭：渭城曲",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "渭城朝雨浥輕塵，客舍青青柳色春。",
            "勸君更盡一杯酒，西出阳關无故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二十七",
        "no#": 124
    }
]