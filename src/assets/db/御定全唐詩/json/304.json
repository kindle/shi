[
    {
        "title": "怨婦",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "淨掃黃金階，飛霜皎如雪。下簾彈箜篌，不忍見秋月。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 1
    },
    {
        "title": "綠珠怨",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "從來上臺榭，不敢倚闌幹。零落知成血，高樓直下看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 2
    },
    {
        "title": "古意",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "達曉寢衣冷，開帷霜露凝。风吹昨夜淚，一片枕前冰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 3
    },
    {
        "title": "哭蕭掄",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "何处哭故人，青門水如箭。當时水頭別，從此不相見。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 4
    },
    {
        "title": "送從弟赴上都",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "車騎秦城遠，囊裝楚客貧。月明思遠道，诗罷訴何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 5
    },
    {
        "title": "登相國寺閣",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "晴日登臨好，春风各望家。垂楊夾城路，客思逐楊花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 6
    },
    {
        "title": "酬浚上人采药見寄",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "玉英期共采，雲嶺独先過。應得靈芝也，诗情一倍多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 7
    },
    {
        "title": "曲水寺枳實",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "枳實繞僧房，攀枝置药囊。洞庭山上橘，霜落也應黃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 8
    },
    {
        "title": "酬问師",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "虛空无处所，仿佛似琉璃。诗境何人到，禪心又過诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 9
    },
    {
        "title": "殷秀才求诗",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "傾蓋見芳姿，晴天瓊樹枝。連城犹隱石，唯有卞和知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 10
    },
    {
        "title": "行營即事",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "万姓厭干戈，三邊尚未和。将军誇寶劍，功在殺人多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 11
    },
    {
        "title": "送劉寰北归",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "南巢登望縣城孤，半是青山半是湖。",
            "知爾素多山水興，此回归去更來无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 12
    },
    {
        "title": "送王閈归蘇州",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "深山窮谷沒人來，邂逅相逢眼漸開。",
            "雲鶴洞宮君未到，夕阳帆影幾时回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 13
    },
    {
        "title": "送人往虔州",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "莫歎乘軺道路賒，高樓日日望還家。",
            "人到南康皆下淚，唯君笑向此中花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 14
    },
    {
        "title": "送僧往湖南",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "閑出東林日影斜，稻苗深淺映袈裟。",
            "船到南湖风浪靜，可怜秋水照蓮花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 15
    },
    {
        "title": "送元使君自楚移越",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "露冕行春向若耶，野人懷惠欲移家。",
            "東风二月淮阴郡，唯見棠梨一樹花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 16
    },
    {
        "title": "移居深山謝別親故",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "不食黃精不采薇，葛苗為帶草為衣。",
            "孤雲更入深山去，人絕音书雁自飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 17
    },
    {
        "title": "送王永二首",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "君去春山谁共遊，鳥啼花落水空流。",
            "如今送別臨溪水，他日相思來水頭。",
            "綿衣似熱夾衣寒，时景雖和春已闌。",
            "誠知暫別那惆悵，明日藤花独自看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 18
    },
    {
        "title": "送別",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "灞岸青門有弊廬，昨來闻道半丘墟。",
            "陌頭空送長安使，舊裏无人可寄书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 19
    },
    {
        "title": "送王貞",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "清阳玉潤複多才，邂逅佳期過早梅。",
            "槿花亦可浮杯上，莫待東籬黃菊開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 20
    },
    {
        "title": "送薛六暫游揚州",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "志在乘軒鳴玉珂，心期未快隱青蘿。",
            "廣陵行路风塵合，城郭新秋砧杵多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 21
    },
    {
        "title": "送楊行元赴舉",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "晚渡邗溝惜別離，漸看烽火馬行迟。",
            "千鈞何处穿楊葉，二月長安折桂枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 22
    },
    {
        "title": "行營送人",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "鞞鼓喧喧对古城，独尋归鳥馬蹄輕。",
            "回來看覓鶯飛处，即是将军細柳營。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 23
    },
    {
        "title": "滑州送人先归",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "河水冰消雁北飛，寒衣未足又春衣。",
            "自怜漂蕩經年客，送別千回独未归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 24
    },
    {
        "title": "送浚上人",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "木落前山霜露多，手持寒錫遠頭陀。",
            "眼看庭樹梅花發，不見诗人独詠歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 25
    },
    {
        "title": "高郵送弟遇北游",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "門臨楚國舟船路，易見行人易別離。",
            "今日送君心最恨，孤帆水下又风吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 26
    },
    {
        "title": "送豆盧郎赴海陵",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "煙波极目已沾襟，路出東塘水更深。",
            "看取海頭秋草色，一如江上別離心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 27
    },
    {
        "title": "送女子",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "青娥宛宛聚為裳，烏鵲橋成別恨長。",
            "惆悵梧桐非舊影，不悲鴻雁暫隨阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 28
    },
    {
        "title": "酬道芬寄画松",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "闻道鉛華學沈寧，寒枝淅瀝葉青青。",
            "一株将比囊中樹，若個年多有茯苓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 29
    },
    {
        "title": "山翁持酒相訪以画松酬之",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "白社风霜驚暮年，銅瓶桑落慰秋天。",
            "怜君意厚留新画，不著松枝當酒錢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 30
    },
    {
        "title": "題潘師房",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "渡水傍山尋石壁，白雲飛处洞門開。",
            "仙人來往行无跡，石徑春风長綠苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 31
    },
    {
        "title": "謝自然卻還舊居",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "仙侶招邀自有期，九天升降五雲隨。",
            "不知辭罷虛皇日，更向人間住幾时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 32
    },
    {
        "title": "寄李俌",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "掛卻衣冠披薜荔，世人應是笑狂愚。",
            "年來漸觉髭須黑，欲寄松花君用无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 33
    },
    {
        "title": "贈頭陀師",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "少壯從戎馬上飛，雪山童子未緇衣。",
            "秋山年長頭陀处，说我军前射虎归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 34
    },
    {
        "title": "贈嚴四草屨",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "輕微菅蒯将何用，容足偷安事頗同。",
            "日入信陵賓館靜，贈君闲步月明中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 35
    },
    {
        "title": "題劉偃莊",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "何事退耕滄海畔，閑看富貴白雲飛。",
            "門前種稻三回熟，縣裏官人四考归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 36
    },
    {
        "title": "題黃陂夫人祠",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "蒼山雲雨逐明神，唯有香名万歲春。",
            "東风三月黃陂水，只見桃花不見人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 37
    },
    {
        "title": "題道濟上人房",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "何处營求出世間，心中无事即身閑。",
            "門外水流风葉落，唯将定性对前山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 38
    },
    {
        "title": "梨樹阴",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "福庭人靜少攀援，雨露偏滋影易繁。",
            "磊落紫香香亞樹，清阴滿地晝當軒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 39
    },
    {
        "title": "秋蟬聲",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "蕭條旅舍客心驚，斷续僧房靜又清。",
            "借问蟬聲何所為，人家古寺两般聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 40
    },
    {
        "title": "归山留別子侄二首",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "車馬驅馳人在世，東西南北鶴隨雲。",
            "莫言貧病无留別，百代簪纓将付君。",
            "不逐浮雲不羨魚，杏花茅屋向阳居。",
            "鶴鳴華表應傳语，雁度霜天懶寄书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 41
    },
    {
        "title": "与湛上人院画松",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "水墨乍成岩下樹，摧残半隱洞中雲。",
            "猷公曾住天臺寺，阴雨猿聲何处闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 42
    },
    {
        "title": "白沙宿竇常宅觀妓",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "揚子澄江映晚霞，柳條垂岸一千家。",
            "主人留客江邊宿，十月繁霜見杏花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 43
    },
    {
        "title": "上巳日两縣寮友會集时主郵不遂馳赴輒題以寄方寸",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "踏青看竹共佳期，春水晴山祓禊詞。",
            "独坐郵亭心欲醉，櫻桃落盡暮愁时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 44
    },
    {
        "title": "懷张璪",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "苔石蒼蒼臨澗水，阴风嫋嫋動松枝。",
            "世間唯有张通會，流向衡阳那得知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 45
    },
    {
        "title": "与於中丞",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "万頃荒林不敢看，買山容足擬求安。",
            "田園失计全蕪沒，何处春风種蕙蘭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 46
    },
    {
        "title": "袁十五遠訪山門",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "僻居謀道不謀身，避病桃源不避秦。",
            "遠入青山何所見，寒花滿徑白頭人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 47
    },
    {
        "title": "行營病中",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "心许征南破虜归，可言羸病臥戎衣。",
            "迟迟不見怜弓箭，惆悵秋鴻敢近飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 48
    },
    {
        "title": "合溪水漲寄敬山人",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "共愛碧溪臨水住，相思來往踐莓苔。",
            "而今卻欲嫌溪水，雨漲春流隔往來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 49
    },
    {
        "title": "不羨花",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "惆悵朝阳午又斜，剩栽桃李學仙家。",
            "花開花落人如舊，谁道容顏不及花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 50
    },
    {
        "title": "醉后",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "春草秋风老此身，一瓢長醉任家貧。",
            "醒來還愛浮萍草，漂寄官河不屬人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 51
    },
    {
        "title": "題水洞二首",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "桃花流出武陵洞，夢想仙家雲樹春。",
            "今看水入洞中去，卻是桃花源裏人。",
            "長看岩穴泉流出，忽聽懸泉入洞聲。",
            "莫摘山花拋水上，花浮出洞世人驚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 52
    },
    {
        "title": "代人村中悼亡二首",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "花落茅簷轉寂寥，魂隨暮雨此中銷。",
            "邇來庭柳无人折，長得垂枝一万條。",
            "虛室无人乳燕飛，蒼苔滿地履痕稀。",
            "庭前唯有薔薇在，花似残妝葉似衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 53
    },
    {
        "title": "觀獵三首",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "夢非熊虎数年間，驅盡豺狼宇宙閑。",
            "傳道單于闻校獵，相期不敢過阴山。",
            "日隱寒山獵未归，鳴弦落羽雪霏霏。",
            "梁園射盡南飛雁，淮楚人驚阳鳥啼。",
            "松月東軒许独遊，深恩未報復淹留。",
            "梁園日暮從公獵，每過青山不舉頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 54
    },
    {
        "title": "画石",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "蒼蘚千年粉繪傳，堅貞一片色犹全。",
            "那知忽遇非常用，不把分銖補上天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 55
    },
    {
        "title": "詠雙開蓮花",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "菡萏新花曉並開，濃妝美笑面相隈。",
            "西方采画迦陵鳥，早晚雙飛池上來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 56
    },
    {
        "title": "夜闻鄰管",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "何事霜天月滿空，鸝雛百囀向春风。",
            "鄰家思婦更長短，楊柳如絲在管中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 57
    },
    {
        "title": "山中寄元二侍禦二首",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "心期汗漫臥雲扃，家计漂零水上萍。",
            "桃李向秋凋落盡，一枝松色独青青。",
            "拖紫鏘金濟世才，知君倚玉望三台。",
            "深山窮谷无人到，唯有狂愚独自來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 58
    },
    {
        "title": "上崔十五老丈",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "天漢乘槎可问津，寂寥深景到无因。",
            "看花独往尋诗客，不為經时謁丈人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 59
    },
    {
        "title": "袁德師求画松",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "柏偃松俯勢自分，森梢古意出浮雲。",
            "如今眼暗画不得，舊有三株持贈君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 60
    },
    {
        "title": "早夏月夜问王開",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "清风首夏夜犹寒，嫩筍侵階竹数竿。",
            "君向蘇台長見月，不知何事此中看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 61
    },
    {
        "title": "裴十六廳即事",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "主人能政訟庭閑，帆影雲峰戶牖間。",
            "每到夕阳嵐翠近，只言籬障倚前山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 62
    },
    {
        "title": "春日行營即事",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "风引雙旌馬首齊，曹南戰勝日平西。",
            "為儒不解從戎事，花落春深闻鼓鼙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 63
    },
    {
        "title": "画樹后呈浚師",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "翔鳳邊风十月寒，蒼山古木更摧残。",
            "為君壁上画松柏，勁雪嚴霜君試看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 64
    },
    {
        "title": "吊從甥",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "日晚河邊訪煢独，衰柳寒蕪繞茅屋。",
            "兒童驚走報人來，孀婦開門一聲哭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 65
    },
    {
        "title": "句",
        "author": "劉商",
        "biography": "",
        "paragraphs": [
            "郵筒不解獻茱萸。。",
            "趙侯首帶鹿耳巾，規模出自陶弘景。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百零四",
        "no#": 66
    }
]