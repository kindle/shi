[
    {
        "title": "途中除夜",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "南北浮萍跡，年華又暗催。残燈和臘盡，曉角帶春來。",
            "鬢欲漸侵雪，心仍未肯灰。金門舊知己，谁為脫塵埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 1
    },
    {
        "title": "長門怨",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "天上何勞万古春，君前谁是百年人。魂銷尚愧金爐燼，",
            "可怜明鏡來相向，何似恩光朝夕新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 2
    },
    {
        "title": "秋日寄華阳山人",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "雲木送秋何草草，风波凝冷太星星。銀鞍公子魂俱斷，",
            "人間不見清涼事，犹向溪翁乞画屏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 3
    },
    {
        "title": "感事",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "濁河從北下，清洛向東流。清濁皆如此，何人不白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 4
    },
    {
        "title": "楚思",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "疊浪与雲急，翠蘭和意香。风流化為雨，日暮下巫阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 5
    },
    {
        "title": "雪中",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "金閣倚雲開，朱軒犯雪來。三冬辛苦樣，天意似難栽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 6
    },
    {
        "title": "道中有感",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "一醉六十日，一裘三十年。年華經幾日，日日掉征鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 7
    },
    {
        "title": "宋汴道中",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "平野有千里，居人无一家。甲兵年正少，日久戍天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 8
    },
    {
        "title": "秋思",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "天地太蕭索，山川何渺茫。不堪星斗柄，犹把歲寒量。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 9
    },
    {
        "title": "即事",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "三年離水石，一旦隱樵漁。為问青雲上，何人识卷舒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 10
    },
    {
        "title": "漁家",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "野水千年在，閑花一夕空。近來浮世狹，何似釣船中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 11
    },
    {
        "title": "關中",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "风雨去愁晚，關河归思涼。西遊无紫气，一夕九回腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 12
    },
    {
        "title": "归思",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "紫府归期斷，芳洲別思迢。黃金作人世，只被歲寒消。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 13
    },
    {
        "title": "下第出春明門",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "曾和秋雨驅愁入，卻向春风領恨回。",
            "深謝灞陵堤畔柳，与人頭上拂塵埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 14
    },
    {
        "title": "華清宮",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "何事金輿不再遊，翠鬟丹臉豈勝愁。",
            "重門深鎖禁鐘后，月滿驪山宮樹秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 15
    },
    {
        "title": "秋日北固晚望二首",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "风含遠思翛翛晚，日照高情的的秋。",
            "何事滿江惆悵水，年年无语向東流。",
            "澤國路岐當面苦，江城砧杵入心寒。",
            "不知白发谁醫得，為问无情歲月看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 16
    },
    {
        "title": "送张道士",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "因将歲月離三島，閑貯风煙在一壺。",
            "為问金烏頭白后，人間流水卻回无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 17
    },
    {
        "title": "吳門春雨",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "吳甸落花春漫漫，吳宮芳樹晚沉沉。",
            "王孫不耐如絲雨，罥斷春风一寸心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 18
    },
    {
        "title": "旅夕",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "风散古陂驚宿雁，月臨荒戍起啼鴉。",
            "不堪吟斷无人見，时複寒燈落一花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 19
    },
    {
        "title": "瓜洲夜泊",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "偶為芳草无情客，況是青山有事身。",
            "一夕瓜洲渡頭宿，天风吹盡廣陵塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 20
    },
    {
        "title": "金陵晚望",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "曾伴浮雲归晚翠，犹陪落日泛秋聲。",
            "世間无限丹青手，一片傷心画不成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 21
    },
    {
        "title": "晚思",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "虞泉冬恨由來短，楊葉春期分外長。",
            "惆悵浮生不知处，明朝依舊出滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 22
    },
    {
        "title": "長信宮二首",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "天上夢魂何杳杳，日宮消息太沉沉。",
            "君恩不似黃金井，一处團圓万丈深。",
            "天上鳳凰休寄夢，人間鸚鵡舊堪悲。",
            "平生心緒无人识，一隻金梭万丈絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 23
    },
    {
        "title": "長安旅懷",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "馬嘶九陌年年苦，人语千門日日新。",
            "唯有終南寂无事，寒光不入帝鄉塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 24
    },
    {
        "title": "春",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "天柱幾條支白日，天門幾扇鎖明时。",
            "阳春發处无根蒂，凭仗東风分外吹。",
            "明月斷魂清靄靄，平蕪归思綠迢迢。",
            "人生莫遣頭如雪，縱得春风亦不消。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 25
    },
    {
        "title": "秋",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "阳羨溪聲冷駭人，洞庭山翠晚凝神。",
            "天将金玉為风露，曾為高秋幾度貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 26
    },
    {
        "title": "灞陵亭",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "一條归夢朱弦直，一片離心白羽輕。",
            "明日灞陵新霽后，馬頭煙樹綠相迎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 27
    },
    {
        "title": "偶作二首",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "丁當玉佩三更雨，平帖金閨一觉雲。",
            "明日薄情何处去，风流春水不知君。",
            "霞衣重疊紅蟬暖，雲髻蔥籠紫鳳寒。",
            "天上少年分散后，一條煙水若為看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 28
    },
    {
        "title": "永夕",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "雲鴻宿处江村冷，独狖啼时海國阴。",
            "不會残燈无一事，觉來犹有向隅心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 29
    },
    {
        "title": "落花",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "一葉落时空下淚，三春归盡複何情。",
            "无人共得東风语，半日尊前计不成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 30
    },
    {
        "title": "下第后上永崇高侍郎",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "天上碧桃和露種，日邊紅杏倚雲栽。",
            "芙蓉生在秋江上，不向東风怨未開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 31
    },
    {
        "title": "句",
        "author": "高蟾",
        "biography": "",
        "paragraphs": [
            "君恩秋后葉，日日向人疏。",
            "知古齋主精校2000。01。22。",
            "j"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十八",
        "no#": 32
    }
]