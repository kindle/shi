[
    {
        "title": "翰林作",
        "author": "劉鄴",
        "biography": "",
        "paragraphs": [
            "曾是江波垂釣人，自怜深厭九衢塵。浮生漸老年隨水，",
            "多慚不是相如筆，虛直金鑾接侍臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 1
    },
    {
        "title": "待漏院吟",
        "author": "劉鄴",
        "biography": "",
        "paragraphs": [
            "玉堂簾外独迟迟，明月初沉勘契时。",
            "閑聽景阳鐘盡後，两鶯飛上万年枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 2
    },
    {
        "title": "慧山寺肄业送懷坦上人",
        "author": "李騭",
        "biography": "",
        "paragraphs": [
            "流水何山分，浮雲空中遇。我生无根株，聚散亦難固。",
            "憶昨鬥龍春，岩棲侶高步。清懷去羈束，幽境无滓汙。",
            "日落九峰明，煙生万華暮。茲歡未雲隔，前笑倏已故。",
            "四时難信留，百草换霜露。離襟一成解，悵抱将何諭。",
            "驚泉有餘哀，永日谁与度。緬思孤帆影，再往重江路。",
            "去去忽淒悲，因风暫回顧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 3
    },
    {
        "title": "讀惠山若冰師集因題故院三首",
        "author": "李騭",
        "biography": "",
        "paragraphs": [
            "五天何處望，心念起皆知。化塔留今日，泉鳴自昔时。",
            "古苔生石靜，秋草滿山悲。莫道聲容遠，長歌白雪詞。",
            "高懷逢異境，佳句想吟频。月冷松溪夜，煙濃草寺春。",
            "浮雲将世遠，清聽与名新。不見開岩日，空為拜影人。",
            "景物搜求歇，山雲放縱飛。樹寒煙鶴去，池靜水龍归。",
            "暗榻塵飄滿，阴簷月到稀。何年燈焰盡，风動影堂扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 4
    },
    {
        "title": "自惠山至吳下寄酬南徐從事",
        "author": "李騭",
        "biography": "",
        "paragraphs": [
            "不接芳晨遊，独此長洲苑。风顏一成阻，翰墨勞空返。",
            "悠悠汀渚長，杳杳蘋花晚。如何西府歡，尚念東吳遠。",
            "瑤音動清韵，蘭思芬盈畹。犹及九峰春，归吟白雲巘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 5
    },
    {
        "title": "中秋夜戲酬顧道流",
        "author": "孫蜀",
        "biography": "",
        "paragraphs": [
            "不那此身偏愛月，等闲看月即更深。",
            "仙翁每被嫦娥使，一度逢圓一度吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 6
    },
    {
        "title": "詠燕上主司鄭愚",
        "author": "歐阳澥",
        "biography": "",
        "paragraphs": [
            "翩翩雙燕画堂開，送古迎今幾万回。",
            "長向春秋社前後，為谁归去為谁來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 7
    },
    {
        "title": "句",
        "author": "歐阳澥",
        "biography": "",
        "paragraphs": [
            "黃菊離家十四年。",
            "離家已是夢松年。",
            "落日望鄉處，何人知客情？"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 8
    },
    {
        "title": "自詠豆花",
        "author": "陳黯",
        "biography": "",
        "paragraphs": [
            "玳瑁應難比，斑犀定不加。天嫌未端正，滿面与妝花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 9
    },
    {
        "title": "雪诗",
        "author": "张孜",
        "biography": "",
        "paragraphs": [
            "長安大雪天，鳥雀難相覓。其中豪貴家，搗椒泥四壁。",
            "到處爇紅爐，周回下羅冪。暖手調金絲，蘸甲斟瓊液。",
            "醉唱玉塵飛，困融香汗滴。豈知饑寒人，手腳生皴劈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 10
    },
    {
        "title": "句",
        "author": "张孜",
        "biography": "",
        "paragraphs": [
            "著牙賣朱紫，斷錢賒舉選。",
            "華山秀作英雄骨，黃河瀉出縱橫才。",
            "夢破青霄春，煙霞无去塵。若誇郭璞五色筆，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 11
    },
    {
        "title": "贈妓仙哥",
        "author": "鄭仁表",
        "biography": "",
        "paragraphs": [
            "嚴吹如何下太清，玉肌无疹六銖輕。",
            "自知不是流霞酌，愿聽雲和瑟一聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 12
    },
    {
        "title": "贈妓命洛真",
        "author": "鄭仁表",
        "biography": "",
        "paragraphs": [
            "巧制新章拍拍新，金罍巡舉助精神。",
            "时时欲得橫波眄，又怕回籌錯指人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 13
    },
    {
        "title": "句",
        "author": "鄭仁表",
        "biography": "",
        "paragraphs": [
            "文章世上爭開路，閥閱山東拄破天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 14
    },
    {
        "title": "杜甫同谷茅茨",
        "author": "趙鴻",
        "biography": "",
        "paragraphs": [
            "工部棲迟後，鄰家大半无。青羌迷道路，白社寄杯盂。",
            "大雅何人繼，全生此地孤。孤雲飛鳥什，空勒舊山隅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 15
    },
    {
        "title": "栗亭",
        "author": "趙鴻",
        "biography": "",
        "paragraphs": [
            "杜甫栗亭诗，诗人多在口。悠悠二甲子，題紀今何有。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 16
    },
    {
        "title": "泥功山",
        "author": "趙鴻",
        "biography": "",
        "paragraphs": [
            "立石泥功狀，天然詭怪形。未嘗私禍福，終不費丹青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 17
    },
    {
        "title": "昆明池織女石",
        "author": "童翰卿",
        "biography": "",
        "paragraphs": [
            "一片昆明石，千秋織女名。見人虛脈脈，臨水更盈盈。",
            "苔作輕衣色，波為促杼聲。岸雲連鬢濕，沙月對眉生。",
            "有臉蓮同笑，无心鳥不驚。還如朝鏡裏，形影两分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 18
    },
    {
        "title": "絕句",
        "author": "童翰卿",
        "biography": "",
        "paragraphs": [
            "大樸逐物盡，哀我天地功。爭得榮辱心，灑然归西风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零七",
        "no#": 19
    }
]