[
    {
        "title": "郢城西樓吟",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "連山盡塞水縈回，山上戍門臨水開。珠簾直下一百丈，",
            "沙洲楓岸无來客，草綠花開山鳥鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 1
    },
    {
        "title": "登丹阳樓",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "寒皋那可望，旅客又初還。迢遞高樓上，蕭疏涼野間。",
            "暮晴依遠水，秋興屬連山。浮客时相見，霜凋朱翠顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 2
    },
    {
        "title": "春夜皇甫冉宅歡宴",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "流落时相見，悲歡共此情。興因尊酒洽，愁為故人輕。",
            "暗滴花莖露，斜暉月過城。那知橫吹笛，江外作邊聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 3
    },
    {
        "title": "會稽秋晚奉呈于太守",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "寂寂訟庭幽，森森戟戶秋。山光隱危堞，湖色上高樓。",
            "禹穴探书罷，天臺作賦遊。雲浮将越客，歲晚共淹留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 4
    },
    {
        "title": "題嚴陵釣台",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "舊隱人如在，清风亦似秋。客星沈夜壑，釣石俯春流。",
            "鳥向喬枝聚，魚依淺瀨遊。古來芳餌下，谁是不吞鉤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 5
    },
    {
        "title": "清明日自西午橋至瓜岩村有懷",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "晚霽龍門雨，春生汝穴风。鳥啼官路靜，花發毀垣空。",
            "鳴玉慚时輩，垂絲學老翁。舊遊人不見，惆悵洛城東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 6
    },
    {
        "title": "洛阳作",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "洛阳天子縣，金谷石崇鄉。草色侵官道，花枝出苑牆。",
            "书成休逐客，賦罷遂為郎。貧賤非吾事，西游思自強。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 7
    },
    {
        "title": "晚次淮阳",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "微涼风葉下，楚俗轉清闲。候館臨秋水，郊扉掩暮山。",
            "月明潮漸近，露濕雁初還。浮客了无定，萍流淮海間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 8
    },
    {
        "title": "送竇十九判官使江南",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "遊客淹星紀，裁诗煉土风。今看乘傳去，那与问津同。",
            "南郡迎徐子，臨川謁謝公。思归一惆悵，于越古亭中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 9
    },
    {
        "title": "江上送客游廬山",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "楚客自相送，沾裳春水邊。晚來风信好，併發上江船。",
            "花映新林岸，雲開瀑布泉。愜心應在此，佳句向谁傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 10
    },
    {
        "title": "酬张二十員外前國子博士竇叔向",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "故交日零落，心賞寄何人。幸与馮唐遇，心同跡複親。",
            "语言未終夕，離別又傷春。結念湓城下，闻猿诗興新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 11
    },
    {
        "title": "會稽郡樓雪霽",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "江城昨夜雪如花，郢客登樓齊望華。夏禹壇前仍聚玉，",
            "數處微明銷不盡，湖山清映越人家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 12
    },
    {
        "title": "馮翊西樓",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "城上西樓倚暮天，樓中归望正淒然。近郭乱山橫古渡，",
            "陶令好文常對酒，相招那惜醉為眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 13
    },
    {
        "title": "送鄒判官往陳留",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "齊宋傷心地，频年此用兵。女停襄邑杼，農廢汶阳耕。",
            "國使乘軺去，諸侯擁節迎。深仁荷君子，薄賦恤黎甿。",
            "火燎原犹熱，波搖海未平。應将否泰理，一问魯諸生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 14
    },
    {
        "title": "酬李书記校书越城秋夜見贈",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "東越秋城夜，西人白发年。寒城警刁鬥，孤憤抱龍泉。",
            "鳳輦棲岐下，鯨波鬥洛川。量空海陵粟，賜乏水衡錢。",
            "投閣嗤揚子，飛书代魯連。蒼蒼不可问，餘亦賦思玄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 15
    },
    {
        "title": "感懷",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "調与时人背，心将靜者論。終年帝城裏，不识五侯門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 16
    },
    {
        "title": "長相思",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "遼阳望河縣，白首无由見。海上珊瑚枝，年年寄春燕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 17
    },
    {
        "title": "奉寄皇甫補闕",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "京口情人別久，揚州估客來疏。",
            "潮至潯阳回去，相思无處通书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 18
    },
    {
        "title": "楓橋夜泊",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "月落烏啼霜滿天，江楓漁父對愁眠。",
            "姑蘇城外寒山寺，夜半鐘聲到客船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 19
    },
    {
        "title": "閶門即事",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "耕夫召募逐樓船，春草青青万頃田。",
            "試上吳門窺郡郭，清明幾處有新煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 20
    },
    {
        "title": "安公房问法",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "流年一日復一日，世事何时是了时。",
            "試向東林问禪伯，遣将心地學琉璃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 21
    },
    {
        "title": "上清詞",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "紫阳宮女捧丹砂，王母令過漢帝家。",
            "春风不肯停仙馭，卻向蓬萊看杏花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 22
    },
    {
        "title": "送顧況泗上覲叔父",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "吳鄉歲貢足嘉賓，後進之中見此人。",
            "別业更臨洙泗上，擬将书卷對残春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 23
    },
    {
        "title": "留別",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "何事千年遇聖君，坐令雙鬢老江雲。",
            "南行更入山深淺，岐路悠悠水自分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 24
    },
    {
        "title": "送张中丞归使幕",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "独受主恩归，當朝似者稀。玉壺分禦酒，金殿賜春衣。",
            "拂席流鶯醉，鳴鞭駿馬肥。滿台簪白筆，捧手戀清輝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 25
    },
    {
        "title": "華州夜宴庾侍禦宅",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "世故他年別，心期此夜同。千峰孤燭外，片雨一更中。",
            "酒客逢山簡，诗人得謝公。自怜驅匹馬，拂曙向關東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 26
    },
    {
        "title": "贈章八元",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "相見談經史，江樓坐夜闌。风聲吹戶響，燈影照人寒。",
            "俗薄交遊盡，时危出處難。衰年逢二妙，亦得悶懷寬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 27
    },
    {
        "title": "城西虎跑寺",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "石勢虎蹲伏，山形龍屈盤。寺開梁殿閣，墳掩晉衣冠。",
            "出澗泉聲細，斜阳塔影寒。近城多□□，棲息此中安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 28
    },
    {
        "title": "褚主簿宅會畢庶子錢員外郎使君",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "開甕臘酒熟，主人心賞同。斜阳疏竹上，残雪乱山中。",
            "更喜宣城印，朝廷与謝公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 29
    },
    {
        "title": "奉送王相公赴幽州",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "黃閣開幃幄，丹墀拜冕旒。位高湯左相，權總漢諸侯。",
            "不改周南化，仍分趙北憂。雙旌過易水，千騎入幽州。",
            "塞草連天暮，邊风動地愁。无因隨遠道，結束佩吳鉤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 30
    },
    {
        "title": "重經巴丘",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "昔年高接李膺歡，日泛仙舟醉碧瀾。诗句乱隨青草落，",
            "今日片帆城下去，秋风回首淚闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 31
    },
    {
        "title": "九日巴丘楊公臺上宴集",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "淒淒霜日上高臺，水國秋涼客思哀。万疊銀山寒浪起，",
            "江漢路長身不定，菊花三笑旅懷開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 32
    },
    {
        "title": "遊靈岩",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "靈岩有路入煙霞，台殿高低釋子家。风滿回廊飄墜葉，",
            "谁謂无生真可學，山中亦自有年華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 33
    },
    {
        "title": "河間獻王墓",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "漢家宗室独稱賢，遺事閑中見舊編。偶過河間尋往跡，",
            "雅樂未興人已逝，雄歌依舊大风傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 34
    },
    {
        "title": "秋日道中",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "齊魯西风草樹秋，川原高下過東州。道邊白鶴來華表，",
            "徑行俯仰成今古，卻憶當年賦遠遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 35
    },
    {
        "title": "華清宮",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "天寶承平奈樂何，華清宮殿鬱嵯峨。朝元閣峻臨秦嶺，",
            "只今惟有溫泉水，嗚咽聲中感慨多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 36
    },
    {
        "title": "春申君祠",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "春申祠宇空山裏，古柏阴阴石泉水。日暮江南无主人，",
            "當时珠履三千客，趙使懷慚不敢言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 37
    },
    {
        "title": "人日代客子是日立春",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "人日兼春日，長懷複短懷。遙知雙彩勝，並在一金釵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 38
    },
    {
        "title": "寄鄭員外",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "經月愁闻雨，新年苦憶君。何时共登眺，整屐待晴雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 39
    },
    {
        "title": "飲李十二宅",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "重門敞春夕，燈燭靄餘輝。醉我百尊酒，留連夜未归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 40
    },
    {
        "title": "山家",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "板橋人渡泉聲，茅簷日午雞鳴。",
            "莫嗔焙茶煙暗，卻喜曬谷天晴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 41
    },
    {
        "title": "归山",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "心事數莖白发，生涯一片青山。",
            "空林有雪相待，古道无人独還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 42
    },
    {
        "title": "金谷園",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "彩樓歌館正融融，一騎星飛錦帳空。",
            "老盡名花春不管，年年啼鳥怨東风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 43
    },
    {
        "title": "郵亭",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "雲淡山橫日欲斜，郵亭下馬對残花。",
            "自從身逐征西府，每到開时不在家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 44
    },
    {
        "title": "宿白馬寺",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "白馬馱經事已空，斷碑残刹見遺蹤。",
            "蕭蕭茅屋秋风起，一夜雨聲羈思濃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十二",
        "no#": 45
    },
    {
        "title": "明德宮",
        "author": "张繼",
        "biography": "",
        "paragraphs": [
            "碧瓦朱楹白晝閑，金衣寶扇曉风寒。",
            "摩雲觀閣高如许，長對河流出斷山。"
        ],
        "notes": [
            ""
        ],
