[
    {
        "title": "酬耿拾遺題贈",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "掩扉常自靜，驛吏忽傳呼。水巷驚馴鳥，藜床起病軀。",
            "顧身悲欲老，戒子力為儒。明日公西去，煙霞複作徒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 1
    },
    {
        "title": "酬王侍禦西陵渡見寄",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "前年万里別，昨日一封书。郢曲西陵渡，秦官使者車。",
            "柳塘熏晝日，花水溢春渠。若不嫌雞黍，先令掃弊廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 2
    },
    {
        "title": "酬劉員外見寄",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "蘇耽佐郡时，近出白雲司。药補清羸疾，窗吟絕妙詞。",
            "柳塘春水慢，花塢夕阳迟。欲识懷君意，明朝訪楫師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 3
    },
    {
        "title": "同韓員外宿雲門寺",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "小嶺路難近，仙郎此夕過。潭空觀月定，澗靜見雲多。",
            "竹翠煙深鎖，松聲雨點和。万緣俱不有，對境自垂蘿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 4
    },
    {
        "title": "酬諸公宿鏡水宅",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "倖免低頭向府中，貴将藜藿与君同。阳雁叫霜來枕上，",
            "闻道漢家偏尚少，此身那此訪芝翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 5
    },
    {
        "title": "送薛尚书入蜀",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "卑情不敢論，拜首入轅門。列郡諸侯長，登朝八座尊。",
            "凝笳臨水發，行旆向风翻。幾许遺黎泣，同懷父母恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 6
    },
    {
        "title": "送李秘书往儋州",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "魑魅曾為伍，蓬萊近拜郎。臣心瞻北闕，家事在南荒。",
            "莎草山城小，毛洲海驛長。玄成知必大，寧是泛滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 7
    },
    {
        "title": "送人入金華",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "明月雙溪水，清风八詠樓。昔年為客處，今日送君遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 8
    },
    {
        "title": "送崔峒使往睦州兼寄薛司戶",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "如今相府用英髦，独往南州肯告勞，冰水近開漁浦出，",
            "使者應須訪廉吏，府中惟有范功曹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 9
    },
    {
        "title": "送房元直赴北京",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "犹道樓蘭十万師，书生匹馬去何之。臨岐未斷归家目，",
            "遙知到日逢寒食，彩筆長裾會晉祠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 10
    },
    {
        "title": "荊溪館呈丘義興",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "失路荊溪上，依人忽暝投。長橋今夜月，阳羨古时州。",
            "野燒明山郭，寒更出縣樓。先生能館我，无事五湖遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 11
    },
    {
        "title": "一公新泉",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "山下新泉出，泠泠北去源。落池才有響，噴石未成痕。",
            "独映孤松色，殊分眾鳥喧。唯當清夜月，觀此啟禪門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 12
    },
    {
        "title": "奉試水精環",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "王室符長慶，環中得水精。任圓循不極，見素質仍貞。",
            "信是天然瑞，非因朴斫成。无瑕勝玉美，至潔過冰清。",
            "未肯齊瑉價，寧同雜佩聲。能銜任黃雀，亦欲應时明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 13
    },
    {
        "title": "自雲阳归晚泊陸澧宅",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "天阴行易晚，前路故人居。孤棹所思久，寒林相見初。",
            "閑燈忘夜永，清漏任更疏。明發還須去，離家幾歲除。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 14
    },
    {
        "title": "九日陪崔郎中北山宴",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "上客南台至，重阳此會文。菊芳寒露洗，杯翠夕阳曛。",
            "務簡人同醉，溪閑鳥自群。府中官最小，唯有孟參军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 15
    },
    {
        "title": "留別鄒紹劉長卿",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "中年從一尉，自笑此身非。道在甘微祿，时難恥息机。",
            "晨趨本郡府，晝掩故山扉。待見干戈畢，何妨更采薇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 16
    },
    {
        "title": "书情獻相公",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "年來白发欲星星，誤卻生涯是一經。魏闕望中何日見，",
            "今日更須詢哲匠，不應休去老岩扃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 17
    },
    {
        "title": "贈送朱放",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "昔年居漢水，日醉習家池。道勝跡常在，名高身不知。",
            "欲依天目住，新自始寧移。生事曾无長，惟将白接z5。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 18
    },
    {
        "title": "剡中贈张卿侍禦",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "辟疆年正少，公子貴初還。早列月卿位，新參柱史班。",
            "千夫馳驛道，駟馬入家山。深巷烏衣盛，高門画戟閑。",
            "逶迤天樂下，照耀剡溪間。自賤遊章句，空為衰草顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 19
    },
    {
        "title": "贈万經",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "万公長慢世，昨日又隳官。縱酒真彭澤，論诗得建安。",
            "家山伯禹穴，別墅小長幹。輒有时人至，窗前白眼看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 20
    },
    {
        "title": "书情上李蘇州",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "東土苗人尚有残，皇皇亞相出朝端。手持國憲群僚畏，",
            "誤著青袍将十载，忍令漁浦卻垂竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 21
    },
    {
        "title": "餘姚祗役奉簡鮑參军",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "童年獻賦在皇州，方寸思量君与侯。万事无成新白首，",
            "知己欲依何水部，鄉人今正賤東丘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 22
    },
    {
        "title": "奉和独孤中丞遊雲門寺",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "絕壑開花界，耶溪極上源。光輝三独坐，登陟五雲門。",
            "深木鳴騶馭，晴山曜武賁。乱泉觀坐臥，疏磬發朝昏。",
            "蒼翠新秋色，莓苔積雨痕。上方看度鳥，後夜聽吟猿。",
            "異跡焚香對，新诗酌茗論。归來還撫俗，諸老莫攀轅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 23
    },
    {
        "title": "奉和皇甫大夫夏日游花嚴寺",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "初第華嚴會，王家少長行。到宮龍節駐，禮塔雁行成。",
            "蓮界千峰靜，梅天一雨清。禪庭未可戀，聖主寄蒼生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 24
    },
    {
        "title": "宿法華寺",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "一夕雨沉沉，哀猿万木阴。天龍來護法，長老密看心。",
            "魚梵空山靜，紗燈古殿深。无生久已學，白发浪相侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 25
    },
    {
        "title": "題茅山李尊師所居",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "天師百歲少如童，不到山中更不逢。洗药每臨新瀑水，",
            "此去人寰知近遠，回看路隔一重重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 26
    },
    {
        "title": "送薛居士和州讀书",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "孤雲独鶴共悠悠，万卷經书一葉舟，楚地巢城民舍少，",
            "年少不應辭苦節，諸生若遇亦封侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 27
    },
    {
        "title": "送李端",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "故關衰草遍，離別正堪悲。路出寒雲外，人归暮雪时。",
            "少孤為客早，多難识君迟。掩泣空相向，风塵何所期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 28
    },
    {
        "title": "宿天竺寺",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "方外主人名道林，怕将水月淨身心。",
            "居然對我说无我，寂曆山深将夜深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 29
    },
    {
        "title": "丹阳送韋參军",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "丹阳郭裏送行舟，一別心知两地秋。",
            "日晚江南望江北，寒鴉飛盡水悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 30
    },
    {
        "title": "入唐溪",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "嘯終万籟起，吹去當溪雲。環嶼或明昧，遠峰尚氛氳。",
            "雨新翠葉發，夜早玄象分。金澗流不盡，入山深更闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 31
    },
    {
        "title": "送桃岩成上人归本寺",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "長老归緣起，桃花憶舊岩。清晨雲抱石，深夜月籠杉。",
            "道具門人捧，齋糧谷鳥銜。餘生愿依止，文字欲三緘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 32
    },
    {
        "title": "酬普選二上人期相會見寄",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "本意宿東林，因聽子賤琴。遙知大小朗，已斷去來心。",
            "夜靜溪聲近，庭寒月色深。寧知塵外意，定後便成吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 33
    },
    {
        "title": "相裏使君宅聽澄上人吹小管",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "秦僧吹竹閉秋城，早在梨園稱主情。",
            "今夕襄阳山太守，座中流淚聽商聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 34
    },
    {
        "title": "贈別至弘上人",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "最稱弘偃少，早歲草茅居。年老從僧律，生知解佛书。",
            "衲衣求壞帛，野飯拾春蔬。章句无求斷，时中學有餘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 35
    },
    {
        "title": "奉和劉祭酒傷白馬",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "沛艾如龍馬，來從上苑中。棣華恩見賜，伯舅禮仍崇。",
            "鏡點黃金眼，花開白雪鬃。性柔君子德，足逸大王风。",
            "色照鳴珂靜，聲連噴玉雄。食場恩未盡，過隙命旋終。",
            "練影依雲沒，銀鞍向月空。仍闻樂府唱，犹念代勞功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 36
    },
    {
        "title": "哭靈一上人",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "一公何不住，空有遠公名。共说岑山路，今时不可行。",
            "舊房松更老，新塔草初生。經論傳緇侶，文章遍墨卿。",
            "禪林枝幹折，法宇棟樑傾。谁複修僧史，應知傳已成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 37
    },
    {
        "title": "題鮑行军小閣",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "宇下无留事，經營意独新。文房已得地，相閣是推輪。",
            "席上招賢急，山阴對雪频。虛明先旦暮，啟閉異冬春。",
            "談笑兵家法，逢迎幕府賓。還将負暄處，时借在阴人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 38
    },
    {
        "title": "陪皇甫大夫謁禹廟",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "竹使羞殷薦，松龕拜夏祠。為魚歌德後，舞羽降神时。",
            "文衛瞻如在，精靈信有期。夕阳陪醉止，塘上鳥咸迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 39
    },
    {
        "title": "同王征君湘中有懷",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "八月洞庭秋，瀟湘水北流。還家万里夢，為客五更愁。",
            "不用看书帙，偏宜上酒樓。故人京洛滿，何日複同遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 40
    },
    {
        "title": "奉和皇甫大夫祈雨應时雨降",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "致和知必感，歲旱未书災。伯禹明靈降，元戎禱請來。",
            "九成陳夏樂，三獻奉殷罍。掣曳旗交電，鏗鏘鼓應雷。",
            "行雲依蓋轉，飛雨逐車回。欲识皇天意，為霖貺在哉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 41
    },
    {
        "title": "贈別劉長卿时赴河南嚴中丞幕府",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "早見登郎署，同时跡下僚。幾年江路永，今去國門遙。",
            "文變騷人體，官移漢帝朝。望山吟度日，接枕話通宵。",
            "万里趨公府，孤帆恨信潮。匡时知已老，聖代恥逃堯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 42
    },
    {
        "title": "晦日宴游",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "晦日湔裾俗，春樓致酒时。出山還已醉，謝客舊能诗。",
            "溪柳熏晴淺，岩花待閏迟。為邦久无事，比屋自熙熙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 43
    },
    {
        "title": "夏日納涼",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "山阴過野客，鏡裏接仙郎。盥漱臨寒水，褰闈入夏堂。",
            "杉松交日影，枕簟上湖光。袞袞承嘉話，清风納晚涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 44
    },
    {
        "title": "僧房避暑",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "支公好閑寂，庭宇愛林篁。幽曠无煩暑，恬和不可量。",
            "蕙风清水殿，荷氣雜天香。明月談空坐，怡然道術忘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 45
    },
    {
        "title": "九日登高",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "诗家九日怜芳菊，迟客高齋瞰浙江。漢浦浪花搖素壁，",
            "四子醉时爭講德，笑論黃霸屈為邦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 46
    },
    {
        "title": "九月十日即事",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "家貧惟種竹，时幸故人看。菊度重阳少，林經閏月寒。",
            "宿酲犹落帽，華发強扶冠。美景良難得，今朝更盡歡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 47
    },
    {
        "title": "送丘為下第归蘇州",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "滄江一身客，獻賦空十年。明主豈能好，今人谁舉賢。",
            "國門稅征駕，旅食謀归旋。皦日媚春水，綠蘋香客船。",
            "无媒既不達，餘亦思归田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 48
    },
    {
        "title": "送少微上人東南游",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "舊遊多不見，師在翟公門。瘴海空山熱，雷州白日昏。",
            "片心應為法，万里独无言。人盡酬恩去，平生未感恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 49
    },
    {
        "title": "贈送崔子向",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "旅食來江上，求名赴洛阳。新诗蹤謝守，內學似支郎。",
            "行怯秦為客，心依越是鄉。何人作知己，送爾淚浪浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 50
    },
    {
        "title": "答劉長卿七裏瀨重送",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "新安非欲枉帆過，海內如君有幾何。",
            "醉裏別时秋水色，老人南望一狂歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 51
    },
    {
        "title": "歲初喜皇甫侍禦至",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "湖上新正逢故人，情深應不笑家貧。",
            "明朝別後門還掩，修竹千竿一老身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 52
    },
    {
        "title": "送舍弟",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "疏懶吾成性，才華爾自強。早稱眉最白，何事綬仍黃。",
            "时暑嗟於邁，家貧念聚糧。只應宵夢裏，诗興屬池塘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 53
    },
    {
        "title": "示外生",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "牽役非吾好，寬情爾在傍。經過悲井邑，起坐倦舟航。",
            "相宅生應貴，逢时學可強。无輕吾未用，世事有行藏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 54
    },
    {
        "title": "詠孩子",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "嘉客會初筵，宜时魄再圓。眾皆含笑戲，谁不點頤怜。",
            "繡被花堪摘，羅繃色欲妍。将雛有舊曲，還入武城弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 55
    },
    {
        "title": "酬謝侍禦喜王宇及第見賀不遇之作",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "寂寞柴門掩，經過柱史榮。老夫甯有力，半子自成名。",
            "柳映三橋發，花連上道明。緘书到別墅，郢曲果先成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 56
    },
    {
        "title": "秋日与諸公文會天□寺",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "相訪從吾道，因緣會爾时。龍盤餘帝宅，花界古人祠。",
            "明月虛空色，青林大小枝。還将經濟學，來问道安師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 57
    },
    {
        "title": "答劉長卿蛇浦橋月下重送",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "月色今宵最明，庭閑夜久天清。寂寞多年老宦，",
            "耿耿相看不寐，遙闻曉柝山城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 58
    },
    {
        "title": "發桐戶寄劉員外",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "處處雲山无盡时，桐廬南望轉參差。",
            "舟人莫道新安近，欲上潺湲行自迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 59
    },
    {
        "title": "秋夜船行",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "扁舟时屬暝，月上有餘輝。海燕秋還去，漁人夜不归。",
            "中流何寂寂，孤棹也依依。一點前村火，谁家未掩扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 60
    },
    {
        "title": "遊灞陵山",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "入山未盡意，勝跡聊独尋。方士去在昔，药堂留至今。",
            "四隅白雲閑，一路清溪深。芳秀愜春目，高閑宜遠心。",
            "潭分化丹水，路繞升仙林。此道人不悟，坐鳴松下琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 61
    },
    {
        "title": "重送新安劉員外",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "秋江渺渺水空波，越客孤舟欲榜歌。",
            "手折衰楊悲老大，故人零落已无多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 62
    },
    {
        "title": "憶長安：五月",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "憶長安，五月时，君王避暑華池。進膳甘瓜朱李，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 63
    },
    {
        "title": "狀江南：季春",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "江南季春天，蓴葉細如弦。池邊草作徑，湖上葉如船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 64
    },
    {
        "title": "句",
        "author": "嚴維",
        "biography": "",
        "paragraphs": [
            "五色驚彩鳳，千里象驄威。。",
            "三伏軒車動，堯心急諫官。名通內籍貴，",
            "波從少海息，雲自大风開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百六十三",
        "no#": 65
    }
]