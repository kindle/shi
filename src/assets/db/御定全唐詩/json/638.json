[
    {
        "title": "宴邊将",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "一曲梁州金石清，邊风蕭颯動江城。",
            "座中有老沙場客，橫笛休吹塞上聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 1
    },
    {
        "title": "郢州即事",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "孤城臨遠水，千里見寒山。白雪无人唱，滄洲盡日閑。",
            "鳥归残燒外，帆出斷雲間。此地秋风起，應隨计吏還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 2
    },
    {
        "title": "送賓貢金夷吾奉使归本國",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "渡海頓仙籍，還家備漢仪。孤舟无岸泊，万里有星隨。",
            "積水浮魂夢，流年半別離。東风未回日，音信杳難期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 3
    },
    {
        "title": "華山",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "谁将倚天劍，削出倚天峰。眾水背流急，他山相向重。",
            "樹黏青靄合，崖夾白雲濃。一夜盆傾雨，前湫起毒龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 4
    },
    {
        "title": "滕王閣",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "昔人登覽处，遺閣大江隅。疊浪有时有，閑雲无日无。",
            "早涼先燕去，返照后帆孤。未得營归计，菱歌滿舊湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 5
    },
    {
        "title": "寄处士梁燭",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "賢哉君子风，諷与古人同。采药楚雲裏，移家湘水東。",
            "星霜秋野闊，雨雹夜山空。早晚相招隱，深耕老此中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 6
    },
    {
        "title": "送许棠下第游蜀",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "天下猿多处，西南是蜀關。馬登青壁瘦，人宿翠微閑。",
            "帶雨逢残日，因江見斷山。行歌风月好，莫老錦城間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 7
    },
    {
        "title": "題終南山白鶴觀",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "上徹煉丹峰，求玄意未窮。古壇青草合，往事白雲空。",
            "仙境日月外，帝鄉煙霧中。人間足煩暑，欲去戀松风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 8
    },
    {
        "title": "贈邊将",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "将军誇膽气，功在殺人多。对酒擎鐘飲，臨风拔劍歌。",
            "翻師平碎葉，掠地取交河。應笑孔門客，年年羨四科。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 9
    },
    {
        "title": "吊建州李員外",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "銘旌归故里，猿鳥亦淒然。已葬桐江月，空回建水船。",
            "客傳為郡日，僧说讀书年。恐有吟魂在，深山古木邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 10
    },
    {
        "title": "送许棠及第归宣州",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "雅調一生吟，谁為晚達心。傍人賀及第，独自卻沾襟。",
            "宴別喧天樂，家归礙日岑。青門许攀送，故里接雲林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 11
    },
    {
        "title": "送龐百篇之任青阳縣尉",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "都堂公試日，詞翰独超群。品秩台庭与，篇章圣主闻。",
            "鄉連三楚樹，縣封九華雲。多少青門客，臨岐共羨君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 12
    },
    {
        "title": "曲江春",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "尋春与送春，多繞曲江濱。一片鳧鷖水，千秋輦轂塵。",
            "岸涼隨眾木，波影逐遊人。自是遊人老，年年管吹新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 13
    },
    {
        "title": "秦原春望",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "无窮名利塵，軒蓋逐年新。北闕東堂路，千山万水人。",
            "雲離僧榻曙，燕遠鳳樓春。荏苒文明代，難归釣艇身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 14
    },
    {
        "title": "游華山雲際寺",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "少華中峰寺，高秋眾景归。地連秦塞起，河隔晉山微。",
            "晚木蟬相應，涼天雁並飛。殷勤記岩石，只恐再來稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 15
    },
    {
        "title": "送棋待詔樸球归新羅",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "海東谁敵手，归去道應孤。闕下傳新勢，船中覆舊图。",
            "窮荒回日月，積水载寰區。故國多年別，桑田複在无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 16
    },
    {
        "title": "送鄭谷先輩赴妝州辟命",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "看花興未休，已散曲江遊。载筆離秦甸，從军過洛州。",
            "嵩雲将雨去，汝水背城流。應念依門客，蒿萊滿徑秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 17
    },
    {
        "title": "贈敬亭清越上人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "海上独隨緣，归來二十年。久闲时得句，漸老不離禪。",
            "砌木欹臨水，窗峰直倚天。犹期向雲裏，別掃石床眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 18
    },
    {
        "title": "題靈山寺",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "樹涼清島寺，虛閣敞禪扉。四面閑雲入，中流独鳥归。",
            "湖平幽徑近，船泊夜燈微。一宿秋风裏，煙波隔擣衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 19
    },
    {
        "title": "吊棲白上人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "今古遞相送，幾时无逝波。篇章名不朽，寂滅理如何。",
            "內殿留真影，闲房落貝多。從茲高塔寺，惆悵懶經過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 20
    },
    {
        "title": "北山书事",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "黃河一曲山，天半鎖重關。圣日雄藩靜，秋风老将閑。",
            "車輿穿谷口，市井響雲間。大野无飛鳥，元戎校獵還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 21
    },
    {
        "title": "長安书事",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "出送鄉人盡，滄洲未得還。秋风五陵樹，晴日六街山。",
            "有景終年住，无机是处閑。何當向雲外，免老別離間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 22
    },
    {
        "title": "送鄭侍禦赴汴州辟命",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "官從諫署清，暫去佐戎旌。朝客多相戀，吟僧欲伴行。",
            "河冰天際白，嶽雪眼前明。即見東风起，梁園聽早鶯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 23
    },
    {
        "title": "吊造微上人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "至人隨化往，遺路自堪傷。白塔收真骨，青山閉影堂。",
            "鐘残含細韵，煙滅有餘香。松上齋烏在，迟迟立夕阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 24
    },
    {
        "title": "經隱岩舊居",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "夜久村落靜，徘徊楊柳津。青山犹有路，明月已无人。",
            "夢寐空前事，星霜倦此身。嘗期結茅处，來往躡遺塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 25
    },
    {
        "title": "再題敬亭清越上人山房",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "重來訪惠休，已是十年遊。向水千松老，空山一磬秋。",
            "石窗清吹入，河漢夜光流。久別多新作，長吟洗俗愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 26
    },
    {
        "title": "浮汴東归",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "日暖泗濱西，无窮岸草齊。薄煙衰草樹，微月迥城雞。",
            "水近滄浪急，山隨綠野低。羞将舊名姓，還向舊遊題。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 27
    },
    {
        "title": "雨中宿僧院",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "千燈有宿因，長老许相親。夜永樓臺雨，更深江海人。",
            "勞生无了日，妄念起微塵。不是真如理，何門靜此身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 28
    },
    {
        "title": "江行至沙浦",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "煙霞接杳冥，旅泊寄回汀。夜雨雷電歇，春江蛟蜃腥。",
            "城侵潮影白，嶠截鳥行青。遍欲探泉石，南須過洞庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 29
    },
    {
        "title": "送友人归江南",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "辛勤同失意，迢遞独還家。落日江邊笛，残春島上花。",
            "親安誠可喜，道在亦何嗟。谁伴高吟处，晴天望九華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 30
    },
    {
        "title": "劉補闕自九華山拜官因以寄獻",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "冥鴻久不群，征拜動天文。地主迎過郡，山僧送出雲。",
            "登車残月在，宿館乱流分。若更思林下，還須共致君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 31
    },
    {
        "title": "岳阳即事",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "遠色岳阳樓，湘帆数片愁。竹风山上路，沙月水中洲。",
            "力學桑田廢，思归鬢发秋。功名如不立，豈易狎汀鸥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 32
    },
    {
        "title": "題興善寺僧道深院",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "江峰峰頂人，受法老西秦。法本无前业，禪非為后身。",
            "院栽他國樹，堂展祖師真。甚愿依宗旨，求閑未有因。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 33
    },
    {
        "title": "送龍門令劉滄",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "去宰龍門縣，應思變化年。還将魯儒政，又与晉人傳。",
            "峭壁開中古，長河落半天。幾鄉因勸勉，耕稼滿雲煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 34
    },
    {
        "title": "送友人往宜春",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "落花兼柳絮，无处不紛紛。遠道空归去，流鶯独自闻。",
            "野橋喧磑水，山郭入樓雲。故里南陵曲，秋期更送君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 35
    },
    {
        "title": "书邊事",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "調角斷清秋，征人倚戍樓。春风对青塚，白日落梁州。",
            "大漢无兵阻，窮邊有客遊。蕃情似此水，長愿向南流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 36
    },
    {
        "title": "送僧雅觉归東海",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "山川心地內，一念即千重。老別關中寺，禪归海外峰。",
            "鳥行來有路，帆影去无蹤。幾夜波濤息，先闻本國鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 37
    },
    {
        "title": "和薛監察題興善寺古松",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "種在法王城，前朝古寺名。瘦根盤地遠，香吹入雲清。",
            "鶴動池台影，僧禪雨雪聲。看來人旋老，因此歎浮生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 38
    },
    {
        "title": "聽琴",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "清月轉瑤軫，弄中湘水寒。能令坐來客，不语自相看。",
            "靜恐鬼神出，急疑风雨残。幾时归嶺嶠，更過洞庭彈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 39
    },
    {
        "title": "送友人游蜀",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "此心知者稀，欲別倍相依。无食擬同去，有家還未归。",
            "巴山開國遠，劍道入天微。必恐臨邛客，疑君學賦非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 40
    },
    {
        "title": "闻仰山禪師往曹溪因贈",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "曹溪松下路，猿鳥重相親。四海求玄理，千峰繞定身。",
            "異花天上墮，靈草雪中春。自惜經行处，焚香禮舊真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 41
    },
    {
        "title": "藍溪夜坐",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "藍水警塵夢，夜吟開草堂。月臨山靄薄，松滴露花香。",
            "诗外真风遠，人間靜興長。明朝訪禪侶，更上翠微房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 42
    },
    {
        "title": "題鄭侍禦藍田別业",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "秋山清若水，吟客靜於僧。小徑通商嶺，高窗見杜陵。",
            "雲霞朝入鏡，猿鳥夜窺燈。许作前峰侶，終來寄上層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 43
    },
    {
        "title": "送友人進士许棠",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "離鄉積歲年，归路遠依然。夜火山頭市，春江樹杪船。",
            "干戈愁鬢改，瘴癘喜家全。何处營甘旨，潮濤浸薄田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 44
    },
    {
        "title": "秘省伴直",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "喬枝聚暝禽，疊閣鎖遙岑。待月當秋直，看书廢夜吟。",
            "残薪留火細，古井下瓶深。縱欲抄前史，貧難遂此心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 45
    },
    {
        "title": "宿昭應",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "夜憶開元寺，淒涼裏巷間。薄煙通魏闕，明月照驪山。",
            "半壁空宮閉，連天白道閑。清晨更回首，独向灞陵還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 46
    },
    {
        "title": "送陸处士",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "樽前放浩歌，便起泛煙波。舟楫故人少，江湖明月多。",
            "孤峰經宿上，僻寺共雲過。若向仙岩住，還應著薜蘿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 47
    },
    {
        "title": "送韓处士归少室山",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "江外曆千岑，還归少室吟。地閑緱嶺月，窗迥洛城砧。",
            "石竇垂寒乳，松枝長別琴。他年瀑泉下，亦擬置家林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 48
    },
    {
        "title": "贈初上人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "竹色覆禪棲，幽禽繞院啼。空門无去住，行客自東西。",
            "井气春來歇，庭枝雪后低。相看念山水，盡日話曹溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 49
    },
    {
        "title": "送新羅僧",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "東來此學禪，多病念佛緣。把錫離岩寺，收經上海船。",
            "落帆敲石火，宿島汲瓶泉。永向扶桑老，知无再少年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 50
    },
    {
        "title": "題山僧院",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "溪路曾來日，年多与舊同。地寒松影裏，僧老磬聲中。",
            "遠水清风落，閑雲別院通。心源若无礙，何必更論空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 51
    },
    {
        "title": "书梅福殿壁二首",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "梅真從羽化，万古是須臾。此地名空在，西山雲亦孤。",
            "井痕平野水，壇級上春蕪。縱有雙飛鶴，年多松已枯。",
            "一自白雲去，千秋壇月明。我來思往事，谁更得長生。",
            "雅韵磬鐘遠，真风樓殿清。今來為尉者，天下有仙名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 52
    },
    {
        "title": "荊楚道中",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "前程曾未到，岐路擬何為。返照行人急，荒郊去鳥迟。",
            "春宵多旅夢，夏閏遠秋期。处处牽愁緒，无窮是柳絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 53
    },
    {
        "title": "送南陵尉李频",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "重作東南尉，生涯尚似僧。客程淮館月，鄉思海船燈。",
            "晚霧看春轂，晴天見朗陵。不應三考足，先授詔书征。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 54
    },
    {
        "title": "将归江淮书",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "東风搖眾木，即有看花期。紫陌频來日，滄洲独去时。",
            "郡因兵役苦，家為海翻移。未老多如此，那堪鬢不衰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 55
    },
    {
        "title": "沿漢東归",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "北去窮秦塞，南归繞漢川。深山逢古跡，遠道見新年。",
            "絕壁雲銜寺，空江雪灑船。縈回還此景，多坐夜燈前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 56
    },
    {
        "title": "送蜀客",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "劍閣緣空去，西南轉幾州。丹霄行客语，明月杜鵑愁。",
            "露帶山花落，雲隨野水流。相如曾醉地，莫滯少年游。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 57
    },
    {
        "title": "塞上",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "勒兵遼水邊，风急卷旌旃。絕塞寒无樹，平沙勢盡天。",
            "雪晴回探騎，月落控鳴弦。永定山河誓，南归改漢年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 58
    },
    {
        "title": "送友人归袁州",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "袁江猿鳥清，曾向此中行。才子登科去，諸侯掃榻迎。",
            "山藏明月浦，樹繞白雲城。遠想安親后，秋风夢不驚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 59
    },
    {
        "title": "贈別李山人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "分合老西秦，年年夢白蘋。曾為洞庭客，還送洞庭人。",
            "语別惜残夜，思归愁見春。遙知泊舟处，沙月自相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 60
    },
    {
        "title": "思宜春寄友人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "勝遊雖來年，魂夢亦依然。瀑水喧秋思，孤燈動夜船。",
            "斷虹全嶺雨，斜月半溪煙。舊日吟诗侶，何人更不眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 61
    },
    {
        "title": "江行夜雨",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "江风木落天，遊子感流年。万里波連蜀，三更雨到船。",
            "夢残燈影外，愁積葦叢邊。不及樵漁客，全家住島田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 62
    },
    {
        "title": "贈仰大師",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "仰山因久住，天下仰山名。井邑身雖到，林泉性本清。",
            "野雲居处盡，江月定中明。仿佛曾相识，今來隔幾生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 63
    },
    {
        "title": "江南逢洛下友人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "洛下吟诗侶，南遊只有君。波濤归路見，蟋蟀在船闻。",
            "曉月江城出，晴霞島樹分。无窮懷古意，豈独繞湘雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 64
    },
    {
        "title": "東湖贈僧子蘭",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "名利了无时，何人暫訪師。道情閑外見，心地语來知。",
            "竹落穿窗葉，松寒蔭井枝。匡山许同社，愿蔔掛帆期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 65
    },
    {
        "title": "隱岩陪鄭少師夜坐",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "幸喜陪騶馭，频來向此宵。硯磨清澗石，廚爨白雲樵。",
            "竹外村煙細，燈中禁漏遙。衣冠与文理，靜语对前朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 66
    },
    {
        "title": "送三傳赴長城尉",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "登科精魯史，為尉及良时。高論窮諸國，長才並幾司。",
            "地傾流水疾，山疊過雲迟。暇日琴书畔，何人对手棋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 67
    },
    {
        "title": "送李道士归南嶽",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "千峰隔湘水，迢遞掛帆归。掃月眠蒼壁，和雲著褐衣。",
            "洞虛懸溜滴，徑狹長松圍。只恐相尋日，人間舊识稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 68
    },
    {
        "title": "延福裏秋懷",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "終年九陌行，要路跡皆生。苦學犹難至，甘貧豈有成。",
            "病攜秋卷重，閑著暑衣輕。一別林泉久，中宵禦水聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 69
    },
    {
        "title": "題玄哲禪師影堂",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "吾師視化身，一念即遺塵。岩谷藏虛塔，江湖散學人。",
            "雲迷禪处石，院掩写來真。寂寞焚香后，閑階細草生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 70
    },
    {
        "title": "登慈恩寺塔",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "窗戶幾層风，清涼碧落中。世人來往別，煙景古今同。",
            "列岫橫秦斷，長河极塞空。斜阳越鄉思，天末見归鴻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 71
    },
    {
        "title": "送友人東归",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "遠涉期秋卷，将行不廢吟。故鄉芳草路，來往別離心。",
            "掛席春风盡，開齋夏景深。子規谁共聽，江月上清岑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 72
    },
    {
        "title": "送僧鸞归蜀甯親",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "歌诗精外學，天子是知音。坐夏宮鐘近，寧親劍閣深。",
            "高名徹西國，舊跡寄東林。自此棲禪者，因師滿蜀吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 73
    },
    {
        "title": "送人归江南",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "貧归无定程，水宿与山行。未有安親计，難為去國情。",
            "島煙孤寺磬，江月遠船箏。思苦秋回日，多應吟更清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 74
    },
    {
        "title": "将離江上作",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "白衣归樹下，青草戀江邊。三楚足深隱，五陵多少年。",
            "寂寥闻蜀魄，清絕怨湘弦。岐路在何处，西行心渺然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 75
    },
    {
        "title": "別李參军",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "王孫游不遇，況我五湖人。野店難投宿，漁家独问津。",
            "嶺分中夜月，江隔两鄉春。靜想青雲路，還應寄此身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 76
    },
    {
        "title": "送睦州张參军",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "重祿輕身日，清資近故鄉。因知送君后，轉自惜年芳。",
            "遠水分林影，層峰起鳥行。扁舟此中去，溪月有餘光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 77
    },
    {
        "title": "贈棋僧侶",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "机謀时未有，多向弈棋銷。已与山僧敵，无令海客饒。",
            "靜驅雲陣起，疏點雁行遙。夜雨如相憶，松窗更見招。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 78
    },
    {
        "title": "題湖上友人居",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "豈得戀樵漁，全家湖畔居。遠无潮客信，閑寄嶽僧书。",
            "野白梅繁后，山明雨散初。逍遙向雲水，莫与宦情疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 79
    },
    {
        "title": "送友人归宣州",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "失计複離愁，君归我独遊。乱花藏道發，春水繞鄉流。",
            "暝火叢橋市，晴山疊郡樓。无為謝公戀，吟過曉蟬秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 80
    },
    {
        "title": "題古觀",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "急景遞衰老，此經谁養真。松留千载鶴，碑隔六朝人。",
            "洞水流花早，壺天閉雪春。其如為名利，归踏五陵塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 81
    },
    {
        "title": "送友人及第归江南",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "豈易及归榮，辛勤致此名。登車思往事，回首勉諸生。",
            "路繞山光曉，帆通海气清。秋期卻閑坐，林下聽江聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 82
    },
    {
        "title": "送樸充侍禦归海東",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "天涯離二紀，闕下曆三朝。漲海雖然闊，归帆不觉遙。",
            "驚波时失侶，舉火夜相招。來往尋遺事，秦皇有斷橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 83
    },
    {
        "title": "吊前水部賈員外",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "籠中江海禽，日夕有归心。魏闕長謠久，吳山独往深。",
            "別时群木落，終处乱猿吟。李白墳前路，溪僧送入林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 84
    },
    {
        "title": "題小松",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "松子落何年，纖枝長水邊。斫開深澗雪，移出遠林煙。",
            "帶月棲幽鳥，兼花灌冷泉。微风動清韵，閑聽罷琴眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 85
    },
    {
        "title": "寄中嶽顓頊先生",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "先生顓頊后，得道自何人。松柏卑于壽，兒孫老卻身。",
            "夜窗峰頂曙，寒澗洞中春。戀此逍遙境，雲間不可親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 86
    },
    {
        "title": "送沈先輩尉昭應",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "餘才不廢诗，佐邑喜閑司。丹陛終須去，青山未可期。",
            "葉凋溫谷晚，雲出古宮迟。若草東封疏，君王到有时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 87
    },
    {
        "title": "送友人游湖南",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "所投非舊知，亦似有前期。路向長江上，帆揚細雨时。",
            "春生南嶽早，日轉大荒迟。盡采瀟湘句，重來會近期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 88
    },
    {
        "title": "江上送友人南游",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "何处積鄉愁，天涯聚乱流。岸長群岫晚，湖闊片帆秋。",
            "買酒過漁舍，分燈与釣舟。瀟湘見來雁，應念独邊遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 89
    },
    {
        "title": "江南別友人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "勞生故白頭，頭白未應休。闕下難孤立，天涯尚旅遊。",
            "聽猿吟島寺，待月上江樓。醉別醒惆悵，雲帆滿乱流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 90
    },
    {
        "title": "商山道中",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "春去计秋期，長安在夢思。多逢山好处，少值客行时。",
            "雲起爭峰勢，花交隱澗枝。停驂一惆悵，應只嶺猿知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 91
    },
    {
        "title": "吳江旅次",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "行人愁落日，去鳥倦遙林。曠野鳴流水，空山響暮砧。",
            "旅途归计晚，鄉樹別年深。寂寞逢村酒，漁家一醉吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 92
    },
    {
        "title": "寄南中友人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "相夢如相見，相思去后频。舊时行处斷，華发別來新。",
            "浪動三湘月，煙藏五嶺春。又无归北客，书劄寄何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 93
    },
    {
        "title": "寄績溪陳明府",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "古邑猿聲裏，空城只半存。岸移无舊路，沙漲別成村。",
            "鼓角喧京口，江山盡汝濆。六朝興廢地，行子一銷魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 94
    },
    {
        "title": "試月中桂",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "与月轉洪蒙，扶疏万古同。根非生下土，葉不墜秋风。",
            "每以圓时足，還隨缺处空。影高群木外，香滿一輪中。",
            "未種丹霄日，應虛玉兔宮。何當因羽化，細得问玄功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 95
    },
    {
        "title": "遊歙州興唐寺",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "山橋通絕境，到此憶天臺。竹裏尋幽徑，雲邊上古台。",
            "鳥归残照出，鐘斷細泉來。為愛澄溪月，因成隔宿回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 96
    },
    {
        "title": "題詮律師院",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "院涼松雨聲，相对有山情。未许溪邊老，犹思嶽頂行。",
            "紗燈留火細，石井灌瓶清。欲问吾師外，何人得此生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 97
    },
    {
        "title": "金山寺空上人院",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "已老金山頂，无心上石橋。講移三楚遍，梵譯五天遙。",
            "板閣禪秋月，銅瓶汲夜潮。自慚昏醉客，來坐亦通宵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 98
    },
    {
        "title": "題廣信寺",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "亭北敞靈溪，林梢与檻齊。野雲來影遠，沙鳥去行低。",
            "晚渡明村火，晴山響郡鼙。思鄉值搖落，賴不有猿啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十八",
        "no#": 99
    }
]