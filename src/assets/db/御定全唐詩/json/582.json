[
    {
        "title": "寄山中人",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "月中一雙鶴，石上千尺松。素琴入爽籟，山酒和春容。",
            "幽瀑有时斷，片雲无所從。何事蘇門生，攜手東南峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 1
    },
    {
        "title": "送淮阴孫令之官",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "隋堤楊柳煙，孤棹正悠然。蕭寺通淮戍，蕪城枕楚壖。",
            "魚鹽橋上市，燈火雨中船。故老青葭岸，先知i7子賢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 2
    },
    {
        "title": "宿輝公精舍",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "禪房无外物，清話此宵同。林彩水煙裏，澗聲山月中。",
            "橡霜諸壑霽，杉火一爐空。擁褐寒更徹，心知觉路通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 3
    },
    {
        "title": "旅泊新津卻寄一二知己",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "維舟息行役，霽景近江村。並起別離恨，似闻歌吹喧。",
            "高林月初上，遠水霧犹昏。王粲平生感，登臨幾斷魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 4
    },
    {
        "title": "贈僧雲棲",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "麈尾与筇杖，幾年離石壇。梵餘林雪厚，棋罷岳鐘残。",
            "開卷喜先悟，漱瓶知早寒。衡阳寺前雁，今日到長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 5
    },
    {
        "title": "雪夜与友生同宿曉寄近鄰",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "閉門群動息，積雪透疏林。有客寒方觉，无聲曉已深。",
            "正繁闻近雁，並落起棲禽。寂寞寒塘路，怜君独阻尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 6
    },
    {
        "title": "題造微禪師院",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "夜香闻偈后，岑寂掩雙扉。照竹燈和雪，看松月到衣。",
            "草堂疏磬斷，江寺故人稀。唯憶湘南雨，春风独鳥归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 7
    },
    {
        "title": "正見寺曉別生公",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "清曉盥秋水，高窗留夕阴。初阳到古寺，宿鳥起寒林。",
            "香火有良愿，宦名非素心。靈山緣未絕，他日重來尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 8
    },
    {
        "title": "旅次盱眙縣",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "離離麥擢芒，楚客意偏傷。波上旅愁起，天邊归路長。",
            "孤橈投楚驛，残月在淮檣。外杜三千里，谁人数雁行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 9
    },
    {
        "title": "鄠郊別墅寄所知",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "持頤望平綠，万景集所思。南塘遇新雨，百草生容姿。",
            "幽鳥不相识，美人如何期。徒然委搖盪，惆悵春风时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 10
    },
    {
        "title": "京兆公池上作",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "稻香山色疊，平野接荒陂。蓮折舟行遠，萍多釣下迟。",
            "壞堤泉落处，涼簟雨來时。京口兵堪用，何因入夢思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 11
    },
    {
        "title": "盧氏池上遇雨贈同游者",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "簟翻涼气集，溪上潤残棋。萍皺风來后，荷喧雨到时。",
            "寂寥閑望久，飄灑独归迟。无限松江恨，煩君解釣絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 12
    },
    {
        "title": "題薛昌之所居",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "所得乃清曠，寂寥常掩關。独來春尚在，相得暮方還。",
            "花白风露晚，柳青街陌閑。翠微應有雪，窗外見南山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 13
    },
    {
        "title": "東归有懷",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "晴川通野陂，此地昔傷離。一去跡常在，独來心自知。",
            "鹭眠茭葉折，魚靜蓼花垂。无限高秋淚，扁舟极路岐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 14
    },
    {
        "title": "休浣日西掖謁所知",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "赤墀高閣自從容，玉女窗扉報曙鐘。日麗九門青鎖闥，",
            "荀令鳳池春婉娩，好将餘潤變魚龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 15
    },
    {
        "title": "博山",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "博山香重欲成雲，錦段机絲妒鄂君。粉蝶團飛花轉影，",
            "見说楊朱无限淚，豈能空為路岐分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 16
    },
    {
        "title": "送盧处士游吳越",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "羨君東去見残梅，唯有王孫独未回。吳苑夕阳明古堞，",
            "試逐漁舟看雪浪，幾多江燕荇花開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 17
    },
    {
        "title": "過新豐",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "一劍乘时帝业成，沛中鄉里到咸京。寰區已作皇居貴，",
            "至今留得離家恨，雞犬相闻落照明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 18
    },
    {
        "title": "過潼關",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "地形盤屈帶河流，景气澄明是勝遊。十裏曉雞關樹暗，",
            "麈尾角巾應曠望，更嗟芳靄隔秦樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 19
    },
    {
        "title": "題西平王舊賜屏风",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "曾向金扉玉砌來，百花鮮濕隔塵埃。披香殿下櫻桃熟，",
            "世間剛有東流水，一送恩波更不回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 20
    },
    {
        "title": "河中陪帥遊亭",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "倚闌愁立独徘徊，欲賦慚非宋玉才。滿座山光搖劍戟，",
            "添得五湖多少恨，柳花飄蕩似寒梅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 21
    },
    {
        "title": "和趙嘏題岳寺",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "疏鐘細響乱鳴泉，客省高臨似水天。嵐翠暗來空觉潤，",
            "张邴宦情何太薄，遠公窗外有池蓮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 22
    },
    {
        "title": "蘇武廟",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "蘇武魂銷漢使前，古祠高樹两茫然。雲邊雁斷胡天月，",
            "茂陵不見封侯印，空向秋波哭逝川。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 23
    },
    {
        "title": "送客偶作",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "石路荒涼接野蒿，西风吹馬利如刀。小橋連驛楊柳晚，",
            "故山有夢不归去，官樹陌塵何太勞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 24
    },
    {
        "title": "寒食前有懷",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "万物鮮華雨乍晴，春寒寂曆近清明。残芳荏苒雙飛蝶，",
            "悠然更起嚴灘恨，一宿東风蕙草生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 25
    },
    {
        "title": "宿雲際寺",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "白蓋微雲一徑深，東峰弟子遠相尋。蒼苔路熟僧归寺，",
            "自從紫桂岩前別，不見南能直至今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 26
    },
    {
        "title": "寄岳州李外郎遠",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "含蘋不语坐持頤，天遠樓高宋玉悲。湖上残棋人散后，",
            "独有袁宏正憔悴，一樽惆悵落花时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 27
    },
    {
        "title": "游南塘寄知者",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "白鳥梳翎立岸莎，藻花菱刺泛微波。煙光似帶侵垂柳，",
            "鎦公不信归心切，聽取江樓一曲歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 28
    },
    {
        "title": "寄盧生",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "遺业荒涼近故都，門前堤路枕平湖。綠楊阴裏千家月，",
            "他年犹擬金貂换，寄语黃公舊酒壚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 29
    },
    {
        "title": "春日訪李十四处士",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "花深橋轉水潺潺，甪裏先生自閉關。看竹已知行处好，",
            "一局残棋千點雨，綠萍池上暮方還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 30
    },
    {
        "title": "宿松門寺",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "白石青崖世界分，捲簾孤坐对氛氳。林間禪室春深雪，",
            "西山舊是經行地，愿漱寒瓶逐領军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 31
    },
    {
        "title": "詠寒宵",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "寒宵何耿耿，良宴有餘姿。寶靺徘徊处，熏爐悵望时。",
            "曲瓊垂翡翠，斜月到罘罳。委墜金釭燼，闌珊玉局棋。",
            "話窮犹注睇，歌罷尚持頤。晻暖遙相屬，氛氳積所思。",
            "秦蛾卷衣晚，胡雁度雲迟。上郡归來夢，那知錦字诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 32
    },
    {
        "title": "寄渚宮遺民弘裏生",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "柳弱湖堤曲，籬疏水巷深。酒闌初促席，歌罷欲分襟。",
            "波月欺華燭，汀雲潤故琴。鏡清花並蒂，床冷簟連心。",
            "荷疊平橋暗，萍稀敗舫沉。城頭五通鼓，窗外万家砧。",
            "異縣魚投浪，當年鳥共林。八行香未滅，千里夢難尋。",
            "未肯睽良愿，空期嗣好音。他时因詠作，犹得比南金。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 33
    },
    {
        "title": "春盡与友人入裴氏林探漁竿",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "一徑互紆直，茅棘亦已繁。晴阳入荒竹，曖曖和春園。",
            "倚杖息慚倦，徘徊戀微暄。曆尋嬋娟節，剪破蒼筤根。",
            "地閉修莖孤，林振餘籜翻。適心在所好，非必尋湘沅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 34
    },
    {
        "title": "春日",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "问君何所思，迢遞豔阳时。門靜人归晚，牆高蝶過迟。",
            "一雙青瑣燕，千万綠楊絲。屏上吳山遠，樓中朔管悲。",
            "寶书无寄处，香轂有來期。草色将林彩，相添入黛眉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 35
    },
    {
        "title": "洛阳",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "鞏樹先春雪滿枝，上阳宮柳囀黃鸝。",
            "桓譚未便忘西笑，豈為長安有鳳池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 36
    },
    {
        "title": "題賀知章故居疊韵作",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "廢砌翳薜荔，枯湖无菰蒲。老媼飽槁草，愚儒輸逋租。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 37
    },
    {
        "title": "雨中与李先生期垂釣先后相失，因作疊韵",
        "author": "溫庭筠",
        "biography": "",
        "paragraphs": [
            "隔石覓屐跡，西溪迷雞啼。小鳥擾曉沼，犁泥齊低畦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十二",
        "no#": 38
    }
]