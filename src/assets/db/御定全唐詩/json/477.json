[
    {
        "title": "懷古",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "尼父未適魯，屡屡倦迷津。徒懷教化心，紆鬱不能伸。",
            "一遇知己言，万方始喧喧。至今百王則，孰不挹其源。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 1
    },
    {
        "title": "詠古",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "大智思濟物，道行心始休。垂綸自消息，歲月任春秋。",
            "紂虐武既賢，风雲固可求。顺天行殺机，所向協良謀。",
            "況以丈人師，将濟安川流。何勞问枯骨，再取阴阳籌。",
            "霸國不務仁，兵戈恣相酬。空令渭水跡，千古独悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 2
    },
    {
        "title": "題清溪鬼谷先生舊居",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "翠壁開天池，青崖列雲樹。水容不可狀，杳若清河霧。",
            "常闻先生教，指示秦仪路。二子才不同，逞詞過尺度。",
            "偶因從吏役，遠到冥棲處。松月想舊山，煙霞了如故。",
            "未遑煉金鼎，日覺容光暮。万慮隨境生，何由返真素。",
            "寂寞天籟息，清迥鳥聲曙。回首望重重，无期挹风馭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 3
    },
    {
        "title": "感興",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "隋氏造宮闕，峨峨倚雲煙。搜奇竭四海，立制謀千年。",
            "秦兵半夜來，烈火焚高臺。万人聚筋血，一旦為塵埃。",
            "君看汴河路，尚说隋家柳。但问哭陵人，秋草沒來久。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 4
    },
    {
        "title": "鷓鴣詞二首",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "湘江煙水深，沙岸隔楓林。何處鷓鴣飛，日斜斑竹阴。",
            "二女空垂淚，三閭枉自沉。惟有鷓鴣啼，独傷行客心。",
            "越岡連越井，越鳥更南飛。何處鷓鴣啼，夕煙東嶺归。",
            "嶺外行人少，天涯北客稀。鷓鴣啼別處，相對淚沾衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 5
    },
    {
        "title": "山中",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "无奈牧童何，放牛吃我竹。隔林呼不應，叫笑如生鹿。",
            "欲報田舍翁，更深不归屋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 6
    },
    {
        "title": "寄荊娘写真",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "章華台南莎草齊，長河柳色連金堤。青樓曈曨曙光蚤，",
            "教坊大使久知名，郢上詞人歌不足。少年才子心相许，",
            "緣池並戲雙鴛鴦，田田翠葉紅蓮香。百年恩愛两相许，",
            "只愁陵谷變人寰，空歎桑田归海岸。愿分精魄定形影，",
            "忽然相對两不语，疑是妝成來鏡中。豈期人愿天不違，",
            "良人翻作東飛翼，卻遣江頭问消息。經年不得一封书，",
            "征帆三千里，前月發豫章。知我別时言，识我馬上郎。",
            "恨无羽翼飛，使我徒怨滄波長。開篋取画圖，",
            "蒼梧九疑在何處，斑斑竹淚連瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 7
    },
    {
        "title": "与弟渤新羅劍歌",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "我有神劍異人与，暗中往往精靈语。识者知從東海來，",
            "昨夜大樑城下宿，不借eZ跌光顏看。刃邊颯颯塵沙缺，",
            "我有愛弟都九江，一條直氣今无雙。青光好去莫惆悵，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 8
    },
    {
        "title": "六歎",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "綺羅香风翡翠車，清明独傍芙蓉渠。上有雲鬟洞仙女，",
            "欲傳一劄孤飛翼，山長水遠无消息。卻鎖重門一院深，",
            "深院梧桐夾金井，上有轆轤青絲索。美人清晝汲寒泉，",
            "惆悵不來照明鏡，卻掩洞房抱寂寂。",
            "漢臣一沒丁零塞，牧羊西過阴沙外。朝凭南雁信難回，",
            "但将鐘鼓悅私愛，肯以犬羊為國羞。夜宿寒雲臥冰雪，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 9
    },
    {
        "title": "春山三朅來",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "釣魚朅來春日暖，沿溪不厭舟行緩。野竹初栽碧玉長，",
            "我今无事亦如此，赤鯉忽到長竿頭。泛泛隨波凡幾裏，",
            "有时帶月归扣舷，身閑自是漁家仙。",
            "山上朅來采新茗，新花乱发前山頂。瓊英動搖鐘乳碧，",
            "越甌遙見裂鼻香，欲覺身輕騎白鶴。",
            "采药朅來药苗盛，药生只傍行人徑。世人重耳不重目，",
            "小男學语便分別，已辯君臣知匹配。都市廣長開大鋪，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 10
    },
    {
        "title": "牧童詞",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "朝牧牛，牧牛下江曲。夜牧牛，牧牛度村谷。",
            "荷蓑出林春雨細，蘆管臥吹莎草綠。乱插蓬蒿箭滿腰，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 11
    },
    {
        "title": "醉中贈崔膺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "与君兄弟匡嶺故，与君相逢揚子渡。白浪南分吳塞雲，",
            "煬帝陵邊草木深，汴河流水空归海。古今悠悠人自別，",
            "与君一言两相许，外舍形骸中爾女。揚州歌酒不可追，",
            "暫到香爐一夕間，能展愁眉百世事。君看白日光如箭，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 12
    },
    {
        "title": "岳阳別张祜",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "十年蹭蹬為逐臣，鬢毛白盡巴江春。鹿鳴猿嘯雖寂寞，",
            "半夜州符喚牧童，虛教衰病生驚怕。巫峽洞庭千里餘，",
            "霸橋昔与张生別，万變桑田何處说。龍蛇縱在沒泥塗，",
            "洛下諸生懼刺先，烏鳶不得齊鷹鷂。岳阳西南湖上寺，",
            "策馬前途須努力，莫學龍鍾虛歎息。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 13
    },
    {
        "title": "寄河阳從事楊潛",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "憶昨天台尋石樑，赤城枕下看扶桑。金烏欲上海如血，",
            "回舟偶得风水便，煙帆數夕归瀟湘。瀟湘水清岩嶂曲，",
            "進者恐不榮，退者恐不深。魚遊鳥逝两雖異，",
            "稚子才年七歲餘，漁樵一半分渠力。吾友從军在河上，",
            "見君顏色犹憔悴，知君未展心中事。落日驅車出孟津，",
            "漢家天子不東游，古木行宮閉煙月。洛濱老翁年八十，",
            "當时天下无甲兵，雖闻賦斂毫毛輕。紅車翠蓋滿衢路，",
            "九重宮殿閉豺狼，万國生人自相噬。蹭蹬瘡痍今不平，",
            "秦中豪寵爭出群，巧将言智寬明君。南山四皓不敢语，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 14
    },
    {
        "title": "重登滕王閣",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "滕王閣上唱伊州，二十年前向此遊。",
            "半是半非君莫问，好山長在水長流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 15
    },
    {
        "title": "重到襄阳哭亡友韋壽朋",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "故人墳樹立秋风，伯道无兒跡便空。",
            "重到笙歌分散地，隔江吹笛月明中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 16
    },
    {
        "title": "再至長安",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "十年謫宦鬼方人，三遇鴻恩始到秦。",
            "今日九衢騎馬望，卻疑渾是刹那身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 17
    },
    {
        "title": "贈道器法師",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "冰作形容雪作眉，早知談論两川知。",
            "如今不用空求佛，但把令狐宰相诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 18
    },
    {
        "title": "廬山得元侍禦书",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "慚君知我命龍鍾，一紙书來意万重。",
            "正著白衣尋古寺，忽然郵遞到雲峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 19
    },
    {
        "title": "竹枝詞",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "荊門灘急水潺潺，两岸猿啼煙滿山。",
            "渡頭少年應官去，月落西陵望不還。",
            "巫峽雲開神女祠，綠潭紅樹影參差。",
            "不勞戍口初相问，无義灘頭剩別離。",
            "石壁千重樹万重，白雲斜掩碧芙蓉。",
            "昭君溪上年年月，偏照嬋娟色最濃。",
            "十二峰頭月欲低，空聆灘上子規啼。",
            "孤舟一夜東归客，泣向東风憶建溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 20
    },
    {
        "title": "京口送朱晝之淮南",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "两行客淚愁中落，万樹山花雨後残。",
            "君到揚州見桃葉，為傳风水渡江難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 21
    },
    {
        "title": "題鶴林寺僧舍",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "終日昏昏醉夢間，忽闻春盡強登山。",
            "因過竹院逢僧話，又得浮生半日閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 22
    },
    {
        "title": "重過文上人院",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "南隨越鳥北燕鴻，松月三年別遠公。",
            "无限心中不平事，一宵清話又成空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 23
    },
    {
        "title": "雙峰寺得舍弟书",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "暫入松門拜祖師，殷勤再讀塔前碑。",
            "回頭忽向尋阳使，太守如今是惠持。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 24
    },
    {
        "title": "木蘭花",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "碧落真人著紫衣，始堪相並木蘭枝。",
            "今朝繞郭花看遍，儘是深村田舍兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 25
    },
    {
        "title": "過招隱寺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "每憶中林訪惠持，今來正遇早春时。",
            "自從休去无心事，唯向高僧说便知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 26
    },
    {
        "title": "酬舉生许遇山居",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "琉璃潭上新秋月，清淨泉中智惠珠。",
            "不似本宗疏二教，许過雲壑訪潛夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 27
    },
    {
        "title": "春晚游鶴林寺寄使府諸公",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "野寺尋花春已迟，背岩唯有两三枝。",
            "明朝攜酒犹堪賞，為報春风且莫吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 28
    },
    {
        "title": "題開聖寺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "宿雨初收草木濃，群鴉飛散下堂鐘。",
            "長廊无事僧归院，盡日門前独看松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 29
    },
    {
        "title": "奉使淮南",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "漢使徵兵詔未休，两行旌旆接揚州。",
            "試上高樓望春色，一年风景盡堪愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 30
    },
    {
        "title": "登北固山亭",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "海繞重山江抱城，隋家宮苑此分明。",
            "居人不覺三吳恨，卻笑關河又戰爭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 31
    },
    {
        "title": "秋日過員太祝林園",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "望水尋山二裏餘，竹林斜到地仙居。",
            "秋光何處堪消日，玄晏先生滿架书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 32
    },
    {
        "title": "題武關",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "來往悲歡万里心，多從此路计浮沉。",
            "皆緣不得空門要，舜葬蒼梧直到今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 33
    },
    {
        "title": "題溫泉",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "能使时平四十春，開元聖主得賢臣。",
            "當时姚宋並燕许，儘是驪山從駕人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 34
    },
    {
        "title": "經溳川館寄使府群公",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "溳川水竹十家餘，漁艇蓬門對岸居。",
            "大勝塵中走鞍馬，与他军府判文书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 35
    },
    {
        "title": "葺夷陵幽居",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "負郭依山一徑深，万竿如朿翠沉沉。",
            "從來愛物多成癖，辛苦移家為竹林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 36
    },
    {
        "title": "再遊頭陀寺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "无因暫泊魯阳戈，白发兼愁日日多。",
            "只恐雪晴花便盡，數來山寺亦无他。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 37
    },
    {
        "title": "看射柳枝",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "玉弝朱弦敕賜弓，新加二鬥得秋风。",
            "万人齊看翻金勒，百步穿楊逐箭空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 38
    },
    {
        "title": "寄峽州韋郎中",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "年過五十鬢如絲，不必前程更问師。",
            "幸得休耕樂堯化，楚山深處最相宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 39
    },
    {
        "title": "贈田玉卿",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "長安裏巷舊鄰居，未解梳頭五歲餘。",
            "今朝嫁得风流婿，歌舞闲时看讀书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 40
    },
    {
        "title": "題招隱寺即戴顒舊宅",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "两崖古樹千般色，一井寒泉數丈冰。",
            "欲问前朝戴居士，野煙秋色是丘陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 41
    },
    {
        "title": "山居送僧",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "失意因休便買山，白雲深處寄柴關。",
            "若逢城邑人相问，報導花时也不閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 42
    },
    {
        "title": "過襄阳上于司空頔",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "方城漢水舊城池，陵谷依然世自移。",
            "歇馬独來尋故事，逢人唯说峴山碑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 43
    },
    {
        "title": "送魏簡能東遊二首",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "獻賦論兵命未通，卻乘羸馬出關東。",
            "灞陵原上重回首，十载長安似夢中。",
            "燕市悲歌又送君，目隨征雁過寒雲。",
            "孤亭宿處时看劍，莫使塵埃蔽鬥文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 44
    },
    {
        "title": "中秋夜君山台望月",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "大堤花裏錦江前，诗酒同遊四十年。",
            "不料中秋最明夜，洞庭湖上見當天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 45
    },
    {
        "title": "酬彭伉",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "公孫閣裏見君初，衣錦南归二十餘。",
            "莫歎屈聲犹未展，同年今日在中书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 46
    },
    {
        "title": "硤石遇赦",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "天網初開釋楚囚，残骸已廢自知休。",
            "荷蓑不是人間事，归去滄江有釣舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 47
    },
    {
        "title": "贈龍泉洞塵上人",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "八十山僧眼未昏，独尋流水到窮源。",
            "自言共得龍神语，擬作茅庵住洞門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 48
    },
    {
        "title": "題湖台",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "山有松門江有亭，不勞他處问青冥。",
            "有时帶月床舁到，一陣风來酒盡醒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 49
    },
    {
        "title": "送妻入道",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "人无回意似波瀾，琴有離聲為一彈。",
            "縱使空門再相見，還如秋月水中看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 50
    },
    {
        "title": "遇湖州妓宋態宜二首",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "曾识雲仙至小时，芙蓉頭上綰青絲。",
            "當时驚覺高唐夢，唯有如今宋玉知。",
            "陵阳夜會使君筵，解语花枝出眼前。",
            "一從明月西沉海，不見嫦娥二十年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 51
    },
    {
        "title": "逢舊二首",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "碧落高高雲万重，當时孤鶴去无蹤。",
            "不期陵谷遷朝市，今日遼東特地逢。",
            "将作乘槎去不還，便尋雲海住三山。",
            "不知留得支机石，卻逐黃河到世間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 52
    },
    {
        "title": "潤州聽暮角",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "江城吹角水茫茫，曲引邊聲怨思長。",
            "驚起暮天沙上雁，海門斜去两三行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 53
    },
    {
        "title": "頭陀寺看竹",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "寺前新筍已成竿，策馬重來独自看。",
            "可惜班皮空滿地，无人解取作頭冠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 54
    },
    {
        "title": "奉使京西",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "盧龍已複两河平，烽火樓邊處處耕。",
            "何事书生走羸馬，原州城下又添兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 55
    },
    {
        "title": "題連雲堡",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "由來天地有關扃，斷壑連山接杳冥。",
            "一出縱知邊上事，滿朝谁信语堪聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 56
    },
    {
        "title": "再宿武關",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "遠別秦城万里遊，乱山高下出商州。",
            "關門不鎖寒溪水，一夜潺湲送客愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 57
    },
    {
        "title": "長安悶作",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "宵分独坐到天明，又策羸驂信腳行。",
            "每日除书空滿紙，不曾闻有介推名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 58
    },
    {
        "title": "和尚书舅見寄",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "欲隨流水去幽棲，喜伴归雲入虎溪。",
            "深謝陳蕃怜寂寞，遠飛芳字警沉迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 59
    },
    {
        "title": "送王六覲巢縣叔父二首",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "巢岸南分戰鳥山，水雲程盡到東關。",
            "弦歌自是君家事，莫怪今來一邑閑。",
            "長憶山阴舊會时，王家兄弟盡相隨。",
            "老來放逐瀟湘路，淚滴秋风引獻之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 60
    },
    {
        "title": "偶懷",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "轉知名宦是悠悠，分付空源始到頭。",
            "待送妻兒下山了，便隨雲水一生休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 61
    },
    {
        "title": "秋夜題夷陵水館",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "凝碧初高海氣秋，桂輪斜落到江樓。",
            "三更浦上巴歌歇，山影沉沉水不流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 62
    },
    {
        "title": "与梧州劉中丞",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "三代盧龍将相家，五分符竹到天涯。",
            "瘴山江上重相見，醉裏同看豆蔻花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 63
    },
    {
        "title": "聽多美唱歌",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "黃鶯慢轉引秋蟬，沖斷行雲直入天。",
            "一曲梁州聽初了，為君別唱想夫怜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 64
    },
    {
        "title": "題澗飲寺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "百年如夢竟何成，白发重來此地行。",
            "還似蕭郎许玄度，再看庭石悟前生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 65
    },
    {
        "title": "題蘇仙宅枯松",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "幾年蒼翠在仙家，一旦枝枯類海槎。",
            "不如酸澀棠梨樹，卻占高城独放花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 66
    },
    {
        "title": "山居",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "一從身世两相遺，往往關門到午时。",
            "想得俗流應大笑，不知年老识便宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 67
    },
    {
        "title": "聽鄰女吟",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "含情遙夜幾人知，閑詠风流小謝诗。",
            "還似霓旌下煙露，月邊吹落上清詞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 68
    },
    {
        "title": "題宇文秀才櫻桃",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "风光莫占少年家，白发殷勤最戀花。",
            "今日顛狂任君笑，趁愁得醉眼麻茶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 69
    },
    {
        "title": "漢上偶題",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "謫仙唐世遊茲郡，花下聽歌醉眼迷。",
            "今日漢江煙樹盡，更无人唱白銅鞮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 70
    },
    {
        "title": "送楊敬之倅湖南",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "久嗟塵匣掩青萍，見说除书試一聽。",
            "闻君卻作長沙傅，便逐秋风過洞庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 71
    },
    {
        "title": "送孫堯夫赴舉",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "自说軒皇息戰威，万方无複事戎衣。",
            "卻教孫子藏兵法，空把文章向禮闈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 72
    },
    {
        "title": "題水月臺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "平流白日无人愛，橋上閑行若個知。",
            "水似晴天天似水，两重星點碧琉璃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 73
    },
    {
        "title": "早春霽後發頭陀寺寄院中",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "紅樓金刹倚晴岡，雨雪初收望漢阳。",
            "草檄可中能有暇，迎春一醉也无妨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 74
    },
    {
        "title": "哭田布",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "魏師臨陣卻抽營，谁管豺狼作信兵。",
            "縱使将军能伏劍，何人島上哭田橫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 75
    },
    {
        "title": "黃葵花",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "此花莫遣俗人看，新染鵝黃色未幹。",
            "好逐秋风上天去，紫阳宮女要頭冠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 76
    },
    {
        "title": "別南溪二首",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "如雲不厭蒼梧遠，似雁逢春又北飛。",
            "唯有隱山溪上月，年年相望两依依。",
            "常歎春泉去不回，我今此去更難來。",
            "欲知別後留情處，手種岩花次第開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 77
    },
    {
        "title": "井欄砂宿遇夜客",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "暮雨蕭蕭江上村，綠林豪客夜知闻。",
            "他时不用逃名姓，世上如今半是君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 78
    },
    {
        "title": "謝王連州送海阳圖",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "謝家為郡實风流，画得青山寄楚囚。",
            "驚起草堂寒氣晚，海阳潮水到床頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 79
    },
    {
        "title": "再謫夷陵題長樂寺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "當时謫宦向夷陵，愿得身閑便作僧。",
            "谁知漸漸因緣重，羞見長燃一盞燈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 80
    },
    {
        "title": "譴謫康州先寄弟渤",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "唯将直道信蒼蒼，可料无名抵憲章。",
            "阴騭卻應先有謂，已交鴻雁早隨阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 81
    },
    {
        "title": "贈廖道士",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "膏已明煎信矣哉，二年人世不归來。",
            "庭前為報仙桃樹，今歲花时好好開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 82
    },
    {
        "title": "山花",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "六出花開赤玉盤，當中紅濕耐春寒。",
            "長安若在五侯宅，谁肯将錢買牡丹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 83
    },
    {
        "title": "聽歌",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "颯颯先飛梁上塵，朱唇不動翠眉顰。",
            "愿得春风吹更遠，直教愁殺滿城人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 84
    },
    {
        "title": "送顏覺赴舉",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "顏子将才應四科，料量时輩更谁過。",
            "居然一片荊山玉，可怕无人是卞和。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 85
    },
    {
        "title": "題五松驛",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "雲木蒼蒼數万株，此中言命的應无。",
            "人生不得如松樹，卻遇秦封作大夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 86
    },
    {
        "title": "湘妃廟",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "斑竹林邊有古祠，鳥啼花發盡堪悲。",
            "當时惆悵同今日，南北行人可得知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 87
    },
    {
        "title": "贈長安小主人",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "上清真子玉童顏，花態嬌羞月思閑。",
            "仙路迷人應有術，桃源不必在深山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 88
    },
    {
        "title": "邠州詞獻高尚书三首",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "單于都護再分疆，西引雙旌出帝鄉。",
            "朝日詔书添戰馬，即闻千騎取河湟。",
            "将家難立是威聲，不見多傳衛霍名。",
            "一自元和平蜀後，馬頭行處即長城。",
            "朔方忠義舊來闻，儘是邠城父子军。",
            "今日兵符归上将，旄頭不用更妖氛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 89
    },
    {
        "title": "游西林寺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "十地初心在此身，水能生月即離塵。",
            "如今再結林中社，可羨當年會裏人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 90
    },
    {
        "title": "題白鹿蘭若",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "只去都門十裏強，竹阴流水繞回廊。",
            "滿城車馬皆知有，每喚同遊盡道忙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 91
    },
    {
        "title": "寄趙准乞湘川山居",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "閑说班超有舊居，山橫水曲占商於。",
            "知君不用磻溪石，乞取終年独釣魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 92
    },
    {
        "title": "曉過函谷關",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "因韓為趙两游秦，十月冰霜渡孟津。",
            "縱使雞鳴遇關吏，不知余也是何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 93
    },
    {
        "title": "奉和九弟渤見寄絕句",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "忽啟新緘吟近诗，诗中韵出碧雲詞。",
            "且喜陟岡愁已散，登舟只恨渡江迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 94
    },
    {
        "title": "贈友人孩子",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "驪龍頷下亦生珠，便与人間眾寶殊。",
            "他时若要追风日，須得君家万里駒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 95
    },
    {
        "title": "奉宣慰使魚十四郎",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "年才二十眾知名，孤鶴仪容徹骨清。",
            "口傳天语來人世，卻逐祥雲上玉京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 96
    },
    {
        "title": "題善光寺",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "雲門天竺舊姻緣，臨老移家住玉泉。",
            "早到可中溳南寺，免得翻經住幾年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 97
    },
    {
        "title": "題宣化寺道光上人居",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "二十年前不系身，草堂曾与雪為鄰。",
            "常思和尚當时语，衣缽留将与此人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 98
    },
    {
        "title": "柳枝詞",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "錦池江上柳垂橋，风引蟬聲送寂寥。",
            "不必如絲千万縷，只禁離恨两三條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 99
    },
    {
        "title": "竹枝詞",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "十二山晴花盡開，楚宮雙闕對阳臺。",
            "細腰爭舞君沉醉，白日秦兵天下來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 100
    },
    {
        "title": "竹裏",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "竹裏編茅倚石根，竹莖疏處見前村。",
            "閑眠盡日无人到，自有春风為掃門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 101
    },
    {
        "title": "失題",
        "author": "李涉",
        "biography": "",
        "paragraphs": [
            "華表千年一鶴归，丹砂為頂雪為衣。",
            "泠泠仙语人聽盡，卻向五雲翻翅飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十七",
        "no#": 102
    }
]