[
    {
        "title": "草檄答南蠻有詠",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "辭天出塞陣雲空，霧卷霞開万里通。親受虎符安宇宙，",
            "為報南蠻須屏跡，不同蜀将武侯功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 1
    },
    {
        "title": "寒食都門作",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "二年寒食住京華，寓目春风万万家。金絡馬銜原上草，",
            "谁念都門两行淚，故園寥落在長沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 2
    },
    {
        "title": "薄命妾",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "阿嬌初失漢皇恩，舊賜羅衣亦罷熏。倚枕夜悲金屋雨，",
            "龍騎不巡时漸久，長門空掩綠苔紋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 3
    },
    {
        "title": "独不見",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "玉關一自有氛埃，年少從军竟未回。門外塵凝张樂榭，",
            "万里寂寥音信絕，寸心爭忍不成灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 4
    },
    {
        "title": "交河塞下曲",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "交河冰薄日迟迟，漢将思家感別離。塞北草生蘇武泣，",
            "何处疲兵心最苦，夕阳樓上笛聲时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 5
    },
    {
        "title": "車遙遙",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "自從車馬出門朝，便入空房守寂寥。玉枕夜残魚信絕，",
            "芳草又衰還不至，碧天霜冷轉无憀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 6
    },
    {
        "title": "早發潛水驛謁郎中員外",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "半床秋月一聲雞，万里行人費馬蹄。青野霧銷凝晉洞，",
            "已是大仙怜后進，不應來向武陵迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 7
    },
    {
        "title": "贈漁者",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "不愧人間万戶侯，子孫相繼老扁舟。往來南越諳鮫室，",
            "羨君独得逃名趣，身外无机任白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 8
    },
    {
        "title": "自嶺下泛鷁到清遠峽作",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "乘船浮鷁下韶水，絕境方知在嶺南。薜荔雨餘山自黛，",
            "不為篋中书未獻，便來茲地結茅庵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 9
    },
    {
        "title": "題周瑜将军廟",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "共说生前國步難，山川龍戰血漫漫。交鋒魏帝旌旗退，",
            "功勳碑碣今何在，不得當时一字看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 10
    },
    {
        "title": "詠史诗：烏江",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "爭帝图王勢已傾，八千兵散楚歌聲。",
            "烏江不是无船渡，恥向東吳再起兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 11
    },
    {
        "title": "詠史诗：章華台",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "茫茫衰草沒章華，因笑靈王昔好奢。",
            "台土未幹簫管絕，可怜身死野人家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 12
    },
    {
        "title": "詠史诗：細腰宮",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "楚王辛苦戰无功，國破城荒霸业空。",
            "唯有青春花上露，至今犹泣細腰宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 13
    },
    {
        "title": "詠史诗：沙苑",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "馮翊南邊宿霧開，行人一步一裴回。",
            "谁知此地凋残柳，儘是高歡敗后栽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 14
    },
    {
        "title": "詠史诗：石城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "古郢雲開白雪樓，漢江還繞石城流。",
            "何人知道寥天月，曾向朱門送莫愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 15
    },
    {
        "title": "詠史诗：荊山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "抱玉岩前桂葉稠，碧溪寒水至今流。",
            "空山落日猿聲叫，疑是荊人哭未休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 16
    },
    {
        "title": "詠史诗：阳臺",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "楚國城池颯已空，阳臺雲雨過无蹤。",
            "何人更有襄王夢，寂寂巫山十二重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 17
    },
    {
        "title": "詠史诗：居延",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漠漠平沙際碧天，问人雲此是居延。",
            "停驂一顧犹魂斷，蘇武爭禁十九年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 18
    },
    {
        "title": "詠史诗：沛宮",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢高辛苦事干戈，帝业興隆俊傑多。",
            "犹恨四方无壯士，還鄉悲唱大风歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 19
    },
    {
        "title": "詠史诗：金谷園",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一自佳人墜玉樓，繁華東逐洛河流。",
            "唯餘金谷園中樹，残日蟬聲送客愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 20
    },
    {
        "title": "詠史诗：湘川",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "虞舜南捐万乘君，靈妃揮涕竹成紋。",
            "不知精魄遊何处，落日瀟湘空白雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 21
    },
    {
        "title": "詠史诗：夷門",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "六龍冉冉驟朝昏，魏國賢才杳不存。",
            "唯有侯嬴在时月，夜來空自照夷門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 22
    },
    {
        "title": "詠史诗：黃金台",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "北乘羸馬到燕然，此地何人複禮賢。",
            "若问昭王无处所，黃金臺上草連天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 23
    },
    {
        "title": "詠史诗：夷陵",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "夷陵城闕倚朝雲，戰敗秦師縱火焚。",
            "何事三千珠履客，不能西禦武安君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 24
    },
    {
        "title": "詠史诗：漢江",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢江一帶碧流長，两岸春风起綠楊。",
            "借问膠船何处沒，欲停蘭棹祀昭王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 25
    },
    {
        "title": "詠史诗：蒼梧",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "有虞龍駕不西還，空委簫韶洞壑間。",
            "无计得知陵寢处，愁雲長滿九疑山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 26
    },
    {
        "title": "詠史诗：陳宮",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "陳國机權未可涯，如何后主恣嬌奢。",
            "不知即入宮中井，犹自聽吹玉樹花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 27
    },
    {
        "title": "詠史诗：南阳",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "世乱英雄百戰餘，孔明方此樂耕鋤。",
            "蜀王不自垂三顧，爭得先生出舊廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 28
    },
    {
        "title": "詠史诗：即墨",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "即墨門開縱火牛，燕師營裏血波流。",
            "固存不得田單術，齊國尋成一土丘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 29
    },
    {
        "title": "詠史诗：渭濱",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "岸草青青渭水流，子牙曾此独垂釣。",
            "當时未入非熊兆，幾向斜阳歎白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 30
    },
    {
        "title": "詠史诗：五湖",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "東上高山望五湖，雪濤煙浪起天隅。",
            "不知範蠡乘舟后，更有功臣繼踵无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 31
    },
    {
        "title": "詠史诗：易水",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一旦秦皇馬角生，燕丹归北送荊卿。",
            "行人欲识无窮恨，聽取東流易水聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 32
    },
    {
        "title": "詠史诗：長平",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "長平瓦震武安初，趙卒俄成戲鼎魚。",
            "四十万人俱下世，元戎何用讀兵书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 33
    },
    {
        "title": "詠史诗：西園",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "月滿西園夜未央，金风不動鄴天涼。",
            "高情公子多秋興，更領诗人入醉鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 34
    },
    {
        "title": "詠史诗：長沙",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "江上南风起白蘋，長沙城郭異咸秦。",
            "故鄉犹自嫌卑濕，何況當时賦鵩人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 35
    },
    {
        "title": "詠史诗：圯橋",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "廟算张良独有餘，少年逃難下邳初。",
            "逡巡不進泥中履，爭得先生一卷书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 36
    },
    {
        "title": "詠史诗：銅雀台",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "魏武龍輿逐逝波，高臺空按望陵歌。",
            "遏雲聲絕悲风起，翻向樽前泣翠娥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 37
    },
    {
        "title": "詠史诗：東晉",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "石頭城下浪崔嵬，风起聲疑出地雷。",
            "何事苻堅太相小，欲投鞭策過江來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 38
    },
    {
        "title": "詠史诗：吳江",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "子胥今日委東流，吳國明朝亦古丘。",
            "大笑夫差諸将相，更无人解守蘇州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 39
    },
    {
        "title": "詠史诗：函谷關",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "寂寂函關鎖未開，田文車馬出秦來。",
            "朱門不養三千客，谁為雞鳴得放回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 40
    },
    {
        "title": "詠史诗：武關",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "戰國相持竟不休，武關才掩楚王憂。",
            "出門若取靈均语，豈作咸阳一死囚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 41
    },
    {
        "title": "詠史诗：垓下",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "拔山力盡霸图隳，倚劍空歌不逝騅。",
            "明月滿營天似水，那堪回首別虞姬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 42
    },
    {
        "title": "詠史诗：郴縣",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "義帝南遷路入郴，國亡身死乱山深。",
            "不知埋恨窮泉后，幾度西陵片月沉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 43
    },
    {
        "title": "詠史诗：東海",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "東巡玉輦委泉台，徐福樓船尚未回。",
            "自是祖龍先下世，不關无路到蓬萊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 44
    },
    {
        "title": "詠史诗：故宜城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "武安南伐勒秦兵，疏鑿功将夏禹並。",
            "谁謂長渠千载后，水流犹入故宜城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 45
    },
    {
        "title": "詠史诗：成都",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "杜宇曾為蜀帝王，化禽飛去舊城荒。",
            "年年來叫桃花月，似向春风訴國亡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 46
    },
    {
        "title": "詠史诗：檀溪",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "三月襄阳綠草齊，王孫相引到檀溪。",
            "的盧何处埋龍骨，流水依前繞大堤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 47
    },
    {
        "title": "詠史诗：青塚",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "玉貌元期漢帝招，谁知西嫁怨天驕。",
            "至今青塚愁雲起，疑是佳人恨未銷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 48
    },
    {
        "title": "詠史诗：李陵台",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "北入單于万里疆，五千兵敗滯窮荒。",
            "英雄不伏蠻夷死，更築高臺望故鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 49
    },
    {
        "title": "詠史诗：河梁",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢家英傑出皇都，攜手河梁話入胡。",
            "不是子卿全大節，也應低首拜單于。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 50
    },
    {
        "title": "詠史诗：軹道",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢祖西來秉白旄，子嬰宗廟委波濤。",
            "谁怜君有翻身術，解向秦宮殺趙高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 51
    },
    {
        "title": "詠史诗：漢宮",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "明妃遠嫁泣西风，玉箸雙垂出漢宮。",
            "何事将军封万戶，卻令紅粉為和戎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 52
    },
    {
        "title": "詠史诗：豫讓橋",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "豫讓酬恩歲已深，高名不朽到如今。",
            "年年橋上行人過，谁有當时國士心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 53
    },
    {
        "title": "詠史诗：華亭",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "陸机西沒洛阳城，吳國春风草又青。",
            "惆悵月中千歲鶴，夜來犹為唳華亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 54
    },
    {
        "title": "詠史诗：東山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "五馬南浮一化龍，謝安入相此山空。",
            "不知攜妓重來日，幾樹鶯啼谷口风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 55
    },
    {
        "title": "詠史诗：殺子谷",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "舉國賢良盡淚垂，扶蘇屈死樹邊时。",
            "至今谷口泉嗚咽，犹似秦人恨李斯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 56
    },
    {
        "title": "詠史诗：馬陵",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "墜葉蕭蕭九月天，驅兵独過馬陵前。",
            "路傍古木蟲书处，記得将军破敵年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 57
    },
    {
        "title": "詠史诗：玉門關",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "西戎不敢過天山，定遠功成白馬閑。",
            "半夜帳中停燭坐，唯思生入玉門關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 58
    },
    {
        "title": "詠史诗：滹沱河",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "光武經營业未興，王郎兵革正凭陵。",
            "須知后漢功臣力，不及滹沱一片冰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 59
    },
    {
        "title": "詠史诗：黃河",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "博望沉埋不復旋，黃河依舊水茫然。",
            "沿流欲共牛郎语，只得靈槎送上天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 60
    },
    {
        "title": "詠史诗：鳳凰台",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "秦娥一別鳳凰台，東入青冥更不回。",
            "空有玉簫千载后，遺聲时到世間來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 61
    },
    {
        "title": "詠史诗：五丈原",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "蜀相西驅十万來，秋风原下久裴回。",
            "長星不為英雄住，半夜流光落九垓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 62
    },
    {
        "title": "詠史诗：平城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢帝西征陷虜塵，一朝圍解議和親。",
            "當时已有吹毛劍，何事无人殺奉春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 63
    },
    {
        "title": "詠史诗：汴水",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "千里長河一旦開，亡隋波浪九天來。",
            "錦帆未落干戈起，惆悵龍舟更不回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 64
    },
    {
        "title": "詠史诗：蘭台宮",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "迟迟春日滿長空，亡國離宮蔓草中。",
            "宋玉不憂人事變，從游那賦大王风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 65
    },
    {
        "title": "詠史诗：金牛驛",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "山嶺千重擁蜀門，成都別是一乾坤。",
            "五丁不鑿金牛路，秦惠何由得併吞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 66
    },
    {
        "title": "詠史诗：望思台",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "太子銜冤去不回，臨皋從築望思台。",
            "至今漢武銷魂处，犹有悲风木上來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 67
    },
    {
        "title": "詠史诗：邯鄲",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "曉入邯鄲十裏春，東风吹下玉樓塵。",
            "青娥莫怪频含笑，記得當年失步人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 68
    },
    {
        "title": "詠史诗：箕山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "寂寂箕山春複秋，更无人到此溪頭。",
            "棄瓢岩畔中宵月，千古空闻屬许由。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 69
    },
    {
        "title": "詠史诗：會稽山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "越王兵敗已山棲，豈望全生出會稽。",
            "何事夫差无遠慮，更開羅網放鯨鯢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 70
    },
    {
        "title": "詠史诗：不周山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "共工爭帝力窮秋，因此捐生觸不周。",
            "遂使世間多感客，至今哀怨水東流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 71
    },
    {
        "title": "詠史诗：虞阪",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "悠悠虞阪路欹斜，迟日和风簇野花。",
            "未省孫阳身沒后，幾多騏驥困鹽車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 72
    },
    {
        "title": "詠史诗：秦庭",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "楚國君臣草莽間，吳王戈甲未東還。",
            "包胥不動咸阳哭，爭得秦兵出武關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 73
    },
    {
        "title": "詠史诗：延平津",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "延平津路水溶溶，峭壁巍岑一万重。",
            "昨夜七星潭底見，分明神劍化為龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 74
    },
    {
        "title": "詠史诗：瑤池",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "阿母瑤池宴穆王，九天仙樂送瓊漿。",
            "漫矜八駿行如電，归到人間國已亡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 75
    },
    {
        "title": "詠史诗：銅柱",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一柱高標險塞垣，南蠻不敢犯中原。",
            "功成自合分茅土，何事翻銜薏苡冤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 76
    },
    {
        "title": "詠史诗：關西",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "楊震幽魂下北邙，關西蹤跡遂荒涼。",
            "四知美譽留人世，應与乾坤共久長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 77
    },
    {
        "title": "詠史诗：高阳池",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "古人未遇即銜杯，所貴愁腸得酒開。",
            "何事山公持玉節，等闲深入醉鄉來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 78
    },
    {
        "title": "詠史诗：瀘水",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "五月驅兵入不毛，月明瀘水瘴煙高。",
            "誓将雄略酬三顧，豈憚征蠻七縱勞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 79
    },
    {
        "title": "詠史诗：細柳營",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "文帝鑾輿勞北征，條侯此地整嚴兵。",
            "轅門不峻将军令，今日爭知細柳營。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 80
    },
    {
        "title": "詠史诗：葉縣",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "葉公丘墓已塵埃，雲矗崇墉亦半摧。",
            "借问往年龍見日，幾多风雨送将來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 81
    },
    {
        "title": "詠史诗：杜郵",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "自古功成禍亦侵，武安冤向杜郵深。",
            "五湖煙月无窮水，何事遷延到陸沉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 82
    },
    {
        "title": "詠史诗：柯亭",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一宿柯亭月滿天，笛亡人沒事空傳。",
            "中郎在世无甄別，爭得名垂爾许年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 83
    },
    {
        "title": "詠史诗：葛陂",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "長房回到葛陂中，人已登真竹化龍。",
            "莫道神仙難頓學，嵇生自是不遭逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 84
    },
    {
        "title": "詠史诗：博浪沙",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "嬴政鯨吞六合秋，削平天下虜諸侯。",
            "山東不是无公子，何事张良独報仇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 85
    },
    {
        "title": "詠史诗：隴西",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "乘春來到隴山西，隗氏城荒碧草齊。",
            "好笑王元不量力，函關那受一丸泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 86
    },
    {
        "title": "詠史诗：白帝城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "蜀江一帶向東傾，江上巍峨白帝城。",
            "自古山河归圣主，子阳虛共漢家爭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 87
    },
    {
        "title": "詠史诗：牛渚",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "溫嶠南归輟棹晨，燃犀牛渚照通津。",
            "谁知万丈洪流下，更有朱衣躍馬人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 88
    },
    {
        "title": "詠史诗：朝歌",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "長嗟墨翟少风流，急管繁弦似寇仇。",
            "若解闻韶知肉味，朝歌欲到肯回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 89
    },
    {
        "title": "詠史诗：谷口",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一旦天真逐水流，虎爭龍戰為諸侯。",
            "子真独有煙霞趣，谷口耕鋤到白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 90
    },
    {
        "title": "詠史诗：武陵溪",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一溪春水徹雲根，流出桃花片片新。",
            "若道長生是虛语，洞中爭得有秦人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 91
    },
    {
        "title": "詠史诗：大澤",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "白蛇初斷路人通，漢祖龍泉血刃紅。",
            "不是咸阳将瓦解，素靈那哭月明中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 92
    },
    {
        "title": "詠史诗：澠池",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "日照荒城芳草新，相如曾此挫強秦。",
            "能令百二山河主，便作樽前擊缶人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 93
    },
    {
        "title": "詠史诗：峴山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "曉日登臨感晉臣，古碑零落峴山春。",
            "松間残露频频滴，酷似當时墮淚人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 94
    },
    {
        "title": "詠史诗：滎阳",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢祖東征屈未伸，滎阳失律紀生焚。",
            "當时天下方龍戰，谁為将军作誄文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 95
    },
    {
        "title": "詠史诗：長城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "祖舜宗堯自太平，秦皇何事苦蒼生。",
            "不知禍起蕭牆內，虛築防胡万里城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 96
    },
    {
        "title": "詠史诗：赤壁",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "烈火西焚魏帝旗，周郎開國虎爭时。",
            "交兵不假揮長劍，已挫英雄百万師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 97
    },
    {
        "title": "詠史诗：田橫墓",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "古墓崔巍約路岐，歌傳薤露到今时。",
            "也知不去朝黃屋，只為曾烹酈食其。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 98
    },
    {
        "title": "詠史诗：青門",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢皇提劍滅咸秦，亡國諸侯儘是臣。",
            "唯有東陵守高節，青門甘作種瓜人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 99
    },
    {
        "title": "詠史诗：姑蘇台",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "吳王恃霸棄雄才，貪向姑蘇醉醁醅。",
            "不觉錢塘江上月，一宵西送越兵來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 100
    },
    {
        "title": "詠史诗：息城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "息亡身入楚王家，回首春风一面花。",
            "感舊不言長掩淚，只應翻恨有容華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 101
    },
    {
        "title": "詠史诗：上蔡",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "上蔡東門狡兔肥，李斯何事忘南归。",
            "功成不解謀身退，直待雲阳血染衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 102
    },
    {
        "title": "詠史诗：武昌",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "王浚戈鋋發上流，武昌鴻业土崩秋。",
            "思量鐵鎖真兒戲，谁為吳王画此籌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 103
    },
    {
        "title": "詠史诗：鴻溝",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "虎倦龍疲白刃秋，两分天下指鴻溝。",
            "項王不觉英雄挫，欲向彭門醉玉樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 104
    },
    {
        "title": "詠史诗：褒城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "恃寵嬌多得自由，驪山舉火戲諸侯。",
            "只知一笑傾人國，不觉胡塵滿玉樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 105
    },
    {
        "title": "詠史诗：金陵",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "侯景長驅十万人，可怜梁武坐蒙塵。",
            "生前不得空王力，徒向金田自捨身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 106
    },
    {
        "title": "詠史诗：洛阳",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "石勒童年有戰机，洛阳長嘯倚門时。",
            "晉朝不是王夷甫，大智何由得預知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 107
    },
    {
        "title": "詠史诗：番禺",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "重岡複嶺勢崔巍，一卒當關万卒回。",
            "不是大夫多辨说，尉他爭肯築朝台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 108
    },
    {
        "title": "詠史诗：汨羅",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "襄王不用直臣籌，放逐南來澤國秋。",
            "自向波間葬魚腹，楚人徒倚濟川舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 109
    },
    {
        "title": "詠史诗：彭澤",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "英傑那堪屈下僚，便栽門柳事蕭條。",
            "鳳凰不共雞爭食，莫怪先生懶折腰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 110
    },
    {
        "title": "詠史诗：涿鹿",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "涿鹿茫茫白草秋，軒轅曾此破蚩尤。",
            "丹霞遙映祠前水，疑是成川血尚流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 111
    },
    {
        "title": "詠史诗：洞庭",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "五月扁舟過洞庭，魚龍吹浪水雲腥。",
            "軒轅黃帝今何在，回首巴山蘆葉青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 112
    },
    {
        "title": "詠史诗：嶓塚",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "夏禹崩來一万秋，水從嶓塚至今流。",
            "當时若訴胼胝苦，更使何人別九州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 113
    },
    {
        "title": "詠史诗：塗山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "大禹塗山御座開，諸侯玉帛走如雷。",
            "防风謾有專車骨，何事茲辰最后來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 114
    },
    {
        "title": "詠史诗：商郊",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "鶯囀商郊百草新，殷湯遺跡在荒榛。",
            "谁知繼桀為天子，便是當初祝網人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 115
    },
    {
        "title": "詠史诗：傅岩",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "岩前版築不求伸，方寸那希據要津。",
            "自是武丁安寢夜，一宵宮裏夢賢人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 116
    },
    {
        "title": "詠史诗：鉅橋",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "積粟成塵竟不開，谁知拒諫剖賢才。",
            "武王兵起无人敵，遂作商郊一聚灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 117
    },
    {
        "title": "詠史诗：首阳山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "孤竹夷齊恥戰爭，望塵遮道請休兵。",
            "首阳山倒為平地，應始无人说姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 118
    },
    {
        "title": "詠史诗：孟津",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "秋风颯颯孟津頭，立馬沙邊看水流。",
            "見说武王東渡日，戎衣曾此叱阳侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 119
    },
    {
        "title": "詠史诗：流沙",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "七雄戈戟乱如麻，四海无人得坐家。",
            "老氏卻思天竺住，便将徐甲去流沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 120
    },
    {
        "title": "詠史诗：鄧城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "鄧侯城壘漢江幹，自謂深根百世安。",
            "不用三甥謀楚计，臨危方觉噬臍難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 121
    },
    {
        "title": "詠史诗：召陵",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "小白匡周入楚郊，楚王雄霸亦咆哮。",
            "不思管仲為謀主，爭取言征縮酒茅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 122
    },
    {
        "title": "詠史诗：綿山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "親在要君召不來，乱山重疊使空回。",
            "如何堅執尤人意，甘向岩前作死灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 123
    },
    {
        "title": "詠史诗：魯城",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "魯公城闕已丘墟，荒草无由認玉除。",
            "因笑臧孫才智少，東門鐘鼓祀鶢鶋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 124
    },
    {
        "title": "詠史诗：驌驦陂",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "行行西至一荒陂，因笑唐公不見机。",
            "莫惜驌驦輸令尹，漢東宮闕早时归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 125
    },
    {
        "title": "詠史诗：夾谷",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "夾谷鶯啼三月天，野花芳草整相鮮。",
            "來时不見侏儒死，空笑齊人失措年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 126
    },
    {
        "title": "詠史诗：吳宮",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "草長黃池千里餘，归來宗廟已丘墟。",
            "出師不聽忠臣諫，徒恥窮泉見子胥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 127
    },
    {
        "title": "詠史诗：摩笄山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "春草綿綿岱日低，山邊立馬看摩笄。",
            "黃鶯也解追前事，來向夫人死处啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 128
    },
    {
        "title": "詠史诗：房陵",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "趙王一旦到房陵，國破家亡百恨增。",
            "魂斷叢台归不得，夜來明月為谁升。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 129
    },
    {
        "title": "詠史诗：濮水",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "青春行役思悠悠，一曲汀蒲濮水流。",
            "正見塗中龜曳尾，令人特地感莊周。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 130
    },
    {
        "title": "詠史诗：柏舉",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "野田极目草茫茫，吳楚交兵此路傍。",
            "谁料伍員入郢后，大開陵寢撻平王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 131
    },
    {
        "title": "詠史诗：望夫山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一上青山便化身，不知何代怨離人。",
            "古來節婦皆銷朽，独爾不為泉下塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 132
    },
    {
        "title": "詠史诗：金義嶺",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "鑿開山嶺引湘波，上去昭回不較多。",
            "无限鵲臨橋畔立，適來天道過天河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 133
    },
    {
        "title": "詠史诗：云云亭",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一上高亭日正晡，青山重疊片雲无。",
            "万年松樹不知数，若個虯枝是大夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 134
    },
    {
        "title": "詠史诗：阿房宮",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "新建阿房壁未幹，沛公兵已入長安。",
            "帝王苦竭生靈力，大业沙崩固不難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 135
    },
    {
        "title": "詠史诗：沙丘",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "年年遊覽不曾停，天下山川欲遍經。",
            "堪笑沙丘才過处，鑾輿风過鮑魚腥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 136
    },
    {
        "title": "詠史诗：咸阳",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "一朝閻樂統群凶，二世朝廷掃地空。",
            "唯有渭川流不盡，至今犹繞望夷宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 137
    },
    {
        "title": "詠史诗：廢丘山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "此水雖非禹鑿開，廢丘山下重縈回。",
            "莫言只解東流去，曾使章邯自殺來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 138
    },
    {
        "title": "詠史诗：廣武山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "数罪楚師應奪气，底須多論破深艱。",
            "倉皇鬥智成何语，遺笑當时廣武山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 139
    },
    {
        "title": "詠史诗：長安",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "關東新破項王归，赤幟悠揚日月旗。",
            "從此漢家无敵國，爭教彭越受誅夷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 140
    },
    {
        "title": "詠史诗：鴻門",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "項籍鷹揚六合晨，鴻門開宴賀亡秦。",
            "樽前若取謀臣计，豈作阴陵失路人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 141
    },
    {
        "title": "詠史诗：漢中",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "荊棘蒼蒼漢水湄，将壇煙草覆餘基。",
            "適來投石空江上，犹似龍顏納諫时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 142
    },
    {
        "title": "詠史诗：泜水",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "韓信經營按鏌鋣，臨戎叱吒有谁加。",
            "犹疑轉戰逢勍敵，更向军中问左車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 143
    },
    {
        "title": "詠史诗：雲夢",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢祖聽讒不可防，偽游韓信果罹殃。",
            "十处辛苦平天下，何事生擒入帝鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 144
    },
    {
        "title": "詠史诗：高阳",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "路入高阳感酈生，逢时長揖便論兵。",
            "最怜伏軾東遊日，下盡齊王七十城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 145
    },
    {
        "title": "詠史诗：四皓廟",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "四皓忘机飲碧松，石岩雲殿隱高蹤。",
            "不知俱出龍樓后，多在商山第幾重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 146
    },
    {
        "title": "詠史诗：霸陵",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "原頭日落雪邊雲，犹放韓盧逐兔群。",
            "況是四方无事日，霸陵谁识舊将军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 147
    },
    {
        "title": "詠史诗：昆明池",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "欲出昆明万里師，漢皇習戰此穿池。",
            "如何一面图攻取，不念生靈气力疲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 148
    },
    {
        "title": "詠史诗：回中",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "武皇无路及昆丘，青鳥西沈隴樹秋。",
            "欲问生前躬祀日，幾煩龍駕到涇州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 149
    },
    {
        "title": "詠史诗：東門",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "何人知足反田廬，玉管東門餞二疏。",
            "豈是不榮天子祿，后賢那使久闲居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 150
    },
    {
        "title": "詠史诗：射熊館",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "漢帝荒唐不解憂，大誇田獵廢農收。",
            "子雲徒獻長楊賦，肯念高皇沐雨秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 151
    },
    {
        "title": "詠史诗：昆阳",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "師克由來在協和，蕭王兵馬固无多。",
            "谁知大敵昆阳敗，卻笑前朝困楚歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 152
    },
    {
        "title": "詠史诗：七裏灘",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "七裏青灘映碧層，九天星象感嚴陵。",
            "釣魚臺上无絲竹，不是高人谁解登。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 153
    },
    {
        "title": "詠史诗：潁川",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "古賢高尚不爭名，行止由來動杳冥。",
            "今日浪為千里客，看花慚上德星亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 154
    },
    {
        "title": "詠史诗：江夏",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "黃祖才非長者儔，禰衡珠碎此江頭。",
            "今來鸚鵡洲邊過，惟有无情碧水流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 155
    },
    {
        "title": "詠史诗：官渡",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "本初屈指定中華，官渡相持勒虎牙。",
            "若使许攸財用足，山河爭得屬曹家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 156
    },
    {
        "title": "詠史诗：灞岸",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "長安城外白雲秋，蕭索悲风灞水流。",
            "因想漢朝離乱日，仲宣從此向荊州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 157
    },
    {
        "title": "詠史诗：濡須橋",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "徒向濡須欲受降，英雄才略独无雙。",
            "天心不与金陵便，高步何由得渡江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 158
    },
    {
        "title": "詠史诗：豫州",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "策馬行行到豫州，祖生寂寞水空流。",
            "當时更有三年壽，石勒尋為關下囚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 159
    },
    {
        "title": "詠史诗：八公山",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "苻堅舉國出西秦，東晉危如累卵晨。",
            "谁料此山諸草木，盡能排難化為人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 160
    },
    {
        "title": "詠史诗：下第",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "翰苑何时休嫁女，文昌早晚罷生兒。",
            "上林新桂年年發，不许平人折一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 161
    },
    {
        "title": "詠史诗：贈薛濤",
        "author": "胡曾",
        "biography": "",
        "paragraphs": [
            "万里橋邊女校书，枇杷花下閉門居。",
            "掃眉才子知多少，管領春风總不如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十七",
        "no#": 162
    }
]