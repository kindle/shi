[
    {
        "title": "春閨辭二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "捲簾迟日暖，睡起思沉沉。遼海音塵遠，春风旅館深。",
            "疏篁留鳥语，曲砌轉花阴。寄语長征客，流年不易禁。",
            "不得遼阳信，春心何以安。鳥啼窗樹曉，夢斷碧煙残。",
            "綠鑒開還懶，紅顏駐且難。相思谁可訴，时取舊书看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 1
    },
    {
        "title": "臘中作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "冬至雖雲遠，渾疑朔漠中。勁风吹大野，密雪翳高空。",
            "泉凍如頑石，人藏類蟄蟲。豪家應不觉，獸炭滿爐紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 2
    },
    {
        "title": "海城秋日书懷寄朐山孫明府",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "槐柳蟬聲起渡頭，海城孤客思悠悠。青雲展志知何日，",
            "鳴琴良宰揮毫士，應笑蹉跎身未酬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 3
    },
    {
        "title": "題柴司徒亭假山",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "疊石峨峨象翠微，遠山魂夢便應稀。從教蘚長添峰色，",
            "知君創得茲幽致，公退吟看到落暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 4
    },
    {
        "title": "都下寒食夜作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "香塵未歇暝煙收，城滿笙歌事勝遊。",
            "自是離人睡長早，千家簾卷月當樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 5
    },
    {
        "title": "客中春思",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "又聽黃鳥綿蠻，目斷家鄉未還。",
            "春水引将客夢，悠悠繞遍關山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 6
    },
    {
        "title": "所思",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "門掩残花寂寂，簾垂斜月悠悠。",
            "縱有一庭萱草，何曾与我忘憂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 7
    },
    {
        "title": "江館秋思因成自勉",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "江邊候館幽，汀鳥暝煙收。客思雖悲月，诗魔又愛秋。",
            "聲名都是幻，窮達未能憂。散逸怜漁父，波中漾小舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 8
    },
    {
        "title": "贈朐山楊宰",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "訟閑征賦畢，吏散捲簾时。聽雨入秋竹，留僧覆舊棋。",
            "得诗书落葉，煮茗汲寒池。化俗功成后，煙霄會有期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 9
    },
    {
        "title": "廬山",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "控壓潯阳景，崔嵬古及今。勢雄超地表，翠盛接天心。",
            "湓浦春煙列，星灣晚景沈。图經宜細覽，題詠卒難任。",
            "靖節門遙对，庾公樓俯臨。參差含積雪，隱映見归禽。",
            "峭拔推雙劍，清虛数二林。白蓮池宛在，翠輦事難尋。",
            "天近星河冷，龍归洞穴深。谷春攢錦繡，石潤疊瓊琳。",
            "玄鶴傳仙拜，青猿伴客吟。泉通九江遠，雲出幾州阴。",
            "冬有靈湯溢，夏无炎暑侵。他年如遂隱，五老是知音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 10
    },
    {
        "title": "送孫霽书記赴壽阳辟命",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "辟命羨君赴，其如愴別情。酒闌汀樹晚，帆展野风生。",
            "淮靜寒煙斂，村遙夜火明。醉沈朐嶺夢，吟達壽春城。",
            "舊友搖鞭接，元戎掃榻迎。雪晴蓮幕啟，雲散桂山橫。",
            "王粲從军画，陳琳草檄名。知君提健筆，重振此嘉聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 11
    },
    {
        "title": "聽蟬寄朐山孫明府",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "忽聽新蟬發，客情其奈何。西风起槐柳，故國阻煙波。",
            "壟笛悲犹少，巴猿恨未多。不知陶靖節，還動此心麼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 12
    },
    {
        "title": "秋江夜泊寄劉鈞正字",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "閑憶诗人思倍勞，維舟清夜泥风騷。魚龍不動澄江遠，",
            "此时吟苦君知否，雙鬢從他有二毛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 13
    },
    {
        "title": "贈朐山孫明府",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "縣庭无事似山齋，滿砌青青旋長苔。閑撫素琴曹吏散，",
            "幾度訪君留我醉，甕香皆值酒新開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 14
    },
    {
        "title": "贈海上书記张濟員外",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "鵬霄休歎志難伸，貧病雖縈道且存。阮瑀不能專筆硯，",
            "劍有塵埃书有蠹，昔年心事共谁論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 15
    },
    {
        "title": "对竹",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "懶穿幽徑沖鳴鳥，忍踏清阴損翠苔。",
            "不似閉門欹枕聽，秋聲如雨入軒來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 16
    },
    {
        "title": "送朐山孫明府赴壽阳幕府辟命",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "堪羨元戎虛右席，便承綸綍起金台。菊叢憔悴陶潛去，",
            "預愁別后相思处，月入閑窗遠夢回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 17
    },
    {
        "title": "經廢宅",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "一夢奢華去不還，斷牆花發豈堪看。",
            "玉纖素綆知何处，金井梧枯碧甃寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 18
    },
    {
        "title": "溪邊吟",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "鸂鶒雙飛下碧流，蓼花蘋穗正含秋。",
            "茜裙二八採蓮去，笑沖微雨上蘭舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 19
    },
    {
        "title": "得故人消息",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "多難分離久，相思每淚垂。夢归残月曉，信到落花时。",
            "未必乖良會，何當有后期。那堪樓上望，煙水接天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 20
    },
    {
        "title": "芳草",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "二月正綿綿，離情被爾牽。四郊初過雨，万里正鋪煙。",
            "眷戀残花惹，留連醉客眠。飄香是杜若，最憶楚江邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 21
    },
    {
        "title": "江南春",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "千家事勝遊，景物可忘憂。水國樓臺晚，春郊煙雨收。",
            "鷓鴣啼竹樹，杜若媚汀洲。永巷歌聲遠，王孫會莫愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 22
    },
    {
        "title": "悼亡",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "巷深芳草細，門靜綠楊低。室邇人何处，花残月又西。",
            "武陵期已負，巫峽夢終迷。独立銷魂久，雙雙好鳥啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 23
    },
    {
        "title": "春晏寄從弟德潤",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "相思禁煙近，樓上動吟魂。水國春寒在，人家暮雨昏。",
            "朱橋通竹樹，香徑匝蘭蓀。安得吾宗會，高歌醉一尊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 24
    },
    {
        "title": "贈致仕沈彬郎中",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "自言婚嫁畢，塵事不關心。老去诗魔在，春來酒病深。",
            "山翁期采药，海月伴鳴琴。多謝維舟处，相留接靜吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 25
    },
    {
        "title": "憶溪居",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "竹軒臨水靜无塵，別后鳧鷖入夢频。",
            "杜若菰蒲煙雨歇，一溪春色屬何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 26
    },
    {
        "title": "登下蔡縣樓",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "長涯煙水又含秋，吏散时时独上樓。",
            "信斷蘭台鄉國遠，依稀王粲在荊州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 27
    },
    {
        "title": "下蔡春偶作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "旅館飄飄類斷蓬，悠悠心緒有谁同。一宵风雨花飛后，",
            "采蘭扇枕何时遂，洗慮焚香叩上穹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 28
    },
    {
        "title": "再游洞神宮懷邵羽人有感",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "重向煙蘿省舊遊，因尋遺跡想浮丘。峰頭鶴去三清遠，",
            "自慚未得沖虛術，白发无情漸滿頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 29
    },
    {
        "title": "秋雨二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "飄灑當窮巷，苔深落葉鋪。送寒來客館，滴夢在庭梧。",
            "逼砌蛩聲斷，侵窗竹影孤。遙思漁叟興，蓑笠在江湖。",
            "竟日聲蕭颯，兼风不暫闌。竹窗秋睡美，荻浦夜漁寒。",
            "地僻苔生易，林疏鳥宿難。谁知苦吟者，坐聽一燈残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 30
    },
    {
        "title": "經古觀有感",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "古觀寥寥枕碧溪，偶思前事立残暉。漆園化蝶名空在，",
            "回頭因歎浮生事，夢裏光阴疾若飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 31
    },
    {
        "title": "吉水春暮訪蔡文慶处士留題",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "无事无憂鬢任蒼，濁醪閑酌送韶光。溟蒙雨過池塘暖，",
            "戀君清話難留处，归路迢迢又夕阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 32
    },
    {
        "title": "烈祖孝高挽歌二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "谁解叩幹關，音容去不還。位方尊北极，壽忽殞南山。",
            "鳳輦應難问，龍髯不可攀。千秋遺恨处，雲物鎖橋山。",
            "仙馭归何处，蒼蒼问且難。華夷喧道德，陵壟葬衣冠。",
            "禦水穿城咽，宮花泣露寒。九疑消息斷，空望白雲端。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 33
    },
    {
        "title": "贈海上觀音院文依上人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "煙霞海邊寺，高臥出門慵。白日少來客，清风生古松。",
            "虛窗從燕入，壞屐任苔封。幾度陪師話，相留到暮鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 34
    },
    {
        "title": "秋夕病中作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "臥病當秋夕，悠悠枕上情。不堪拋月色，无计避蟲聲。",
            "煎药惟憂澀，停燈又怕明。曉臨清鑒裏，應有白髭生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 35
    },
    {
        "title": "寄黃鶚秀才",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "長憶狂遊日，惜春心恰同。預愁花片落，不遣酒壺空。",
            "草軟眠難舍，鶯嬌聽莫窮。如今千里隔，搔首对秋风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 36
    },
    {
        "title": "春日书懷寄朐山孫明府",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "一作邊城客，閑門两度春。鶯花深院雨，书劍滿床塵。",
            "紫閣期終負，青雲道未伸。犹怜陶靖節，诗酒每相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 37
    },
    {
        "title": "柴司徒宅牡丹",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "暮春欄檻有佳期，公子開顏乍拆时。翠幄密籠鶯未识，",
            "只恐卻隨雲雨去，來年還是動相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 38
    },
    {
        "title": "贈王道者",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "混俗從教鬢似銀，世人无分得相親。槎流海上波濤闊，",
            "仙家變化谁能測，只恐洪崖是此身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 39
    },
    {
        "title": "春閨辭二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "塵昏菱鑒懶修容，雙臉桃花落盡紅。",
            "玉塞夢归残燭在，曉鶯窗外囀梧桐。",
            "邊无音信暗消魂，茜袖香裙積淚痕。",
            "海燕归來門半掩，悠悠花落又黃昏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 40
    },
    {
        "title": "暮春懷故人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "池館寂寥三月盡，落花重疊蓋莓苔。惜春眷戀不忍掃，",
            "琅玕繡段安可得，流水浮雲共不回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 41
    },
    {
        "title": "秋日登潤州城樓",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "虛樓一望极封疆，積雨晴來野景長。水接海門鋪遠色，",
            "吟罷倚欄深有思，清风留我到斜阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 42
    },
    {
        "title": "晚春客次偶吟",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "暫駐征輪野店間，悠悠时節又春残。落花风急宿酲解，",
            "卻怜村寺僧相引，閑上虛樓共倚欄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 43
    },
    {
        "title": "对雨寄朐山林番明府",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "竟日如絲不暫停，莎階閑聽滴秋聲。斜飄虛閣琴书潤，",
            "遙知公退琴堂靜，坐对蕭騷飲興生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 44
    },
    {
        "title": "落花",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "残紅引動诗魔，懷古牽情奈何。半落銅台月曉，",
            "谁見長門深鎖，黃昏細雨相和。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 45
    },
    {
        "title": "燕",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "豪家五色泥香，銜得營巢太忙。",
            "喧觉佳人晝夢，雙雙犹在雕梁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 46
    },
    {
        "title": "鶯",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "羽毛特異諸禽，出谷堪聽好音。",
            "薄暮欲棲何处，雨昏楊柳深深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 47
    },
    {
        "title": "宿山中寺",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "寄宿深山寺，惟逢老病僧。风吹幾世樹，雲暗暮秋燈。",
            "瞑目忘塵慮，談空入上乘。明晨返名路，何计戀南能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 48
    },
    {
        "title": "海上载筆依韵酬左偃見寄",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "都城分別后，海嶠夢魂迷。吟興疏煙月，邊情起鼓鼙。",
            "戍旗风颭小，營柳霧籠低。草檄无餘刃，難将阮瑀齊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 49
    },
    {
        "title": "春晚招魯從事",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "袞袞利名役，常嗟聚會稀。有心游好景，无術駐残暉。",
            "南陌草爭茂，西園花乱飛。期君舉杯酒，不醉莫言归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 50
    },
    {
        "title": "和易秀才春日見寄",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "每恨多流落，吾徒不易親。相逢千里客，共醉百花春。",
            "小檻山當面，閑階柳拂塵。何时卜西上，明月桂枝新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 51
    },
    {
        "title": "送黃秀才",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "雨餘飛絮乱，相別思難任。酒罷河橋晚，帆開煙水深。",
            "蟾宮須展志，漁艇莫牽心。岐路從茲遠，雙魚信勿沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 52
    },
    {
        "title": "庭竹",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "偶自山僧院，移归傍砌栽。好风終日起，幽鳥有时來。",
            "篩月牽诗興，籠煙伴酒杯。南窗睡輕起，蕭颯雨聲回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 53
    },
    {
        "title": "送戴秀才",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "已是殊鄉客，送君重慘然。河橋乍分首，槐柳正鳴蟬。",
            "短棹離幽浦，孤帆觸遠煙。清朝重文物，變化莫遷延。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 54
    },
    {
        "title": "病中作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "閑齋病初起，心緒複悠悠。開篋群书蠹，聽蟬滿樹秋。",
            "诗魔還漸動，药債未能酬。為憶前山色，扶持上小樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 55
    },
    {
        "title": "離家",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "送別人归春日斜，独鞭羸馬指天涯。",
            "月生江上鄉心動，投宿匆忙近酒家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 56
    },
    {
        "title": "村行",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "极目青青壟麥齊，野塘波闊下鳧鷖。阳烏景暖林桑密，独立閑聽戴勝啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 57
    },
    {
        "title": "獻喬侍郎",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "位望谁能並，當年志已伸。人間傳鳳藻，天上演龍綸。",
            "賈馬才无敵，褒雄譽益臻。除奸深系念，致主迥忘身。",
            "諫疏縱橫上，危言果敢陳。忠貞雖貫世，消長豈由人。",
            "慷慨辭朝闕，迢遙涉路塵。千山明夕照，孤棹渡長津。",
            "杜宇聲方切，江蘺色正新。卷舒唯合道，喜慍不勞神。",
            "禪客陪清論，漁翁作近鄰。靜吟窮野景，狂醉養天真。",
            "格論思名士，輿情渴直臣。九霄恩複降，比戶意皆忻。",
            "卻入鴛鸞序，終身顧问频。漏残丹禁曉，日暖玉墀春。",
            "鑒物心如水，憂时鬢若銀。惟期康庶事，永要敘彝倫。",
            "貴賤知无間，孤寒必许親。幾多沈滯者，拭目望陶鈞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 58
    },
    {
        "title": "獻中书张舍人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "仙桂從攀后，人間播大名。飛騰諧素志，霄漢是前程。",
            "持憲威聲振，司言品秩清。簾開春酒醒，月上草麻成。",
            "丹陛淩晨对，青雲逐步生。照人裴玉瑩，鑒物憲陂明。",
            "下直无他事，闲遊恣逸情。林僧開戶接，溪叟掃苔迎。",
            "煮茗山房冷，垂綸野艇輕。神清宜放曠，诗苦益縱橫。",
            "餘刃时皆仰，嘉謀眾佇行。四方觀啟沃，畢竟念孤平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 59
    },
    {
        "title": "海上和郎戩員外赴倅職",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "宋玉逢秋何起悲，新恩委寄好開眉。班升鴛鹭频經歲，",
            "一朝鳳詔重征入，鵬化那教尺鷃知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 60
    },
    {
        "title": "又送赴關",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "心似白雲归帝鄉，暫停良画別龔黃。煙波乍曉浮蘭棹，",
            "想應敷对忠言后，不放鄉雲離太阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 61
    },
    {
        "title": "书郭判官幽齋壁",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "不妨公退尚清虛，創得幽齋興有餘。要引好风清戶牖，",
            "更有野情堪愛处，石床苔蘚似匡廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 62
    },
    {
        "title": "石棋局獻时宰",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "得從嶽叟誠堪重，卻獻皋夔事更宜。公退啟枰书院靜，",
            "預想幽窗风雨夜，一燈閑照覆图时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 63
    },
    {
        "title": "海城秋夕寄懷舍弟",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "鳥棲庭樹夜悠悠，枕上谁知淚暗流。千里夢魂迷舊业，",
            "早晚萊衣同著去，免悲流落在邊州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 64
    },
    {
        "title": "和夏侯秀才春日見寄",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "綿蠻黃鳥不堪聽，觸目離愁怕酒醒。雲散碧山當晚檻，",
            "晝夢不成吟有興，揮毫书在枕邊屏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 65
    },
    {
        "title": "送夏侯秀才",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "江村搖落暮蟬鳴，執手臨岐動別情。古岸相看残照在，",
            "況是清朝至公在，預知喬木定遷鶯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 66
    },
    {
        "title": "江南重會友人感舊二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "江南重會面，聊話十年心。共立黃花畔，空驚素發侵。",
            "斜阳浮遠水，归鳥下疏林。牽動诗魔处，涼风村落砧。",
            "長江落照天，物景似當年。憶昔攜村酒，相将上釣船。",
            "狂歌紅蓼岸，驚起白鸥眠。今日趨名急，臨风一黯然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 67
    },
    {
        "title": "己未歲冬捧宣頭離下蔡",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "詔下如春煦，巢南志不違。空将感恩淚，滴盡冒寒衣。",
            "覆载元容善，形骸果得归。无心慚季路，負米覲親闈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 68
    },
    {
        "title": "哭舍弟二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "鴻雁離群后，成行憶日存。谁知归故里，只得奠吟魂。",
            "蟲蠹书盈篋，人稀草擁門。從茲長慟后，独自奉晨昏。",
            "浮生多夭枉，惟爾最堪悲。同气未归日，慈親臨老时。",
            "舊诗傳海嶠，新塚枕江湄。遺稚嗚嗚处，黃昏繞繐帷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 69
    },
    {
        "title": "书情寄诗友",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "默默谁知我，裴回野水邊。诗情長若舊，吾事更无先。",
            "芳草人稀地，残阳雁過天。靜思吟友外，此意複谁怜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 70
    },
    {
        "title": "讀蜀志",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "鼎分天地日，先主力元微。魚水從相得，山河遂有归。",
            "任賢无間忌，報國盡神机。草昧爭雄者，君臣似此稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 71
    },
    {
        "title": "獻张拾遺",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "官資清貴近丹墀，性格孤高世所稀。金殿日開親鳳扆，",
            "獻替频陳忠譽播，鵬霄万里展雄飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 72
    },
    {
        "title": "獻中书湯舍人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "慶雲呈瑞為明时，演暢絲綸在紫微。鑾殿对时親舜日，",
            "隔座銀屏看是設，一門清貴古今稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 73
    },
    {
        "title": "海上太守新創東亭",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "使君心智杳難同，選勝開亭景莫窮。高敞軒窗迎海月，",
            "滿徑苔紋疏雨后，入簷山色夕阳中。偏宜下榻延徐孺，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 74
    },
    {
        "title": "宮詞二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "門鎖簾垂月影斜，翠華咫尺隔天涯。",
            "香鋪羅幌不成夢，背壁銀缸落盡花。",
            "金波寒透水精簾，燒盡沈檀手自添。",
            "风遞笙歌門已掩，翠華何处夜厭厭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 75
    },
    {
        "title": "採蓮女",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "晚涼含笑上蘭舟，波底紅妝影欲浮。",
            "陌上少年休植足，荷香深处不回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 76
    },
    {
        "title": "鐘陵春思",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "沉沉樓影月當午，冉冉风香花正開。",
            "芳草迢迢滿南陌，王孫何处不归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 77
    },
    {
        "title": "贈夏秀才",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "軒車紫陌競尋春，独掩衡門病起身。步月怕傷三徑蘚，",
            "況是青雲知己在，原思生计莫憂貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 78
    },
    {
        "title": "夏日书依上人壁",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "門外塵飛暑气濃，院中蕭索似山中。",
            "最怜煮茗相留处，疏竹當軒一榻风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 79
    },
    {
        "title": "下蔡春暮旅懷",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "柳過春霖絮乱飛，旅中懷抱独淒淒。月生淮上雲初散，",
            "拜恩為養慈親急，愿向明朝捧紫泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 80
    },
    {
        "title": "捧宣頭许归侍養",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "泥书捧处圣恩新，许覲庭闈養二親。",
            "螻蟻至微寧足数，未知何处答穹旻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十八",
        "no#": 81
    },
    {
