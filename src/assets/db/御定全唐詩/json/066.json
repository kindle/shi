[
    {
        "title": "古劍篇",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "君不見昆吾鐵冶飛炎煙，紅光紫气俱赫然。",
            "良工鍛煉凡幾年，鑄得寶劍名龍泉。龍泉顏色如霜雪，",
            "正逢天下无风塵，幸得周防君子身。精光黯黯青蛇色，",
            "何言中路遭棄捐，零落漂淪古獄邊。雖複塵埋无所用，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 1
    },
    {
        "title": "塞上",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "塞外虜塵飛，频年出武威。死生隨玉劍，辛苦向金微。",
            "久戍人将老，長征馬不肥。仍闻酒泉郡，已合数重圍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 2
    },
    {
        "title": "寄劉校书",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "俗吏三年何足論，每将榮辱在朝昏。才微易向风塵老，",
            "回首漢家丞相府，昨來谁得掃重門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 3
    },
    {
        "title": "同徐員外除太子舍人寓直之作",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "太子擅元良，宮臣命偉長。除榮辭會府，直宿總书坊。",
            "露濕幽岩桂，风吹便坐桑。閣連雲一色，池帶月重光。",
            "葉死蘭无气，荷枯水不香。遙闻秋興作，言是晉中郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 4
    },
    {
        "title": "春江曲",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "江水春沉沉，上有雙竹林。竹葉壞水色，郎亦壞人心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 5
    },
    {
        "title": "王昭君三首",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "自嫁單于國，長銜漢掖悲。容顏日憔悴，有甚画图时。",
            "厭踐冰霜域，嗟為邊塞人。思從漠南獵，一見漢家塵。",
            "闻有南河信，傳言殺画師。始知君念重，更肯惜蛾眉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 6
    },
    {
        "title": "子夜四时歌六首：春歌",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "陌頭楊柳枝，已被春风吹。妾心正斷絕，君懷那得知。",
            "青樓含日光，綠池起风色。贈子同心花，殷勤此何极。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 7
    },
    {
        "title": "子夜四时歌六首：秋歌",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "邀歡空佇立，望美频回顧。何时複采菱，江中密相遇。",
            "辟惡茱萸囊，延年菊花酒。与子結綢繆，丹心此何有。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 8
    },
    {
        "title": "子夜四时歌六首：冬歌",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "北极嚴气升，南至溫风謝。調絲競短歌，拂枕怜長夜。",
            "帷橫雙翡翠，被卷两鴛鴦。婉態不自得，宛轉君王床。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 9
    },
    {
        "title": "二月樂游诗",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "二月芳遊始，開軒望曉池。綠蘭日吐葉，紅蕊向盈枝。",
            "柳色行将改，君心幸莫移。阳春遽多意，唯愿两人知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 10
    },
    {
        "title": "十月樂游诗",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "十月嚴阴盛，霜气下玉台。羅衣羞自解，綺帳待君開。",
            "銀箭更籌緩，金爐香气來。愁仍夜未幾，已使炭成灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 11
    },
    {
        "title": "螢",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "秋风凜凜月依依，飛過高梧影裏时。",
            "暗处若教同眾類，世間爭得有人知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 12
    },
    {
        "title": "蛩",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "愁殺離家未達人，一聲聲到枕前闻。",
            "苦吟莫向朱門裏，滿耳笙歌不聽君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 13
    },
    {
        "title": "雲",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "聚散虛空去複還，野人閑处倚筇看。",
            "不知身是无根物，蔽月遮星作万端。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 14
    },
    {
        "title": "野井",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "縱无汲引味清澄，冷浸寒空月一輪。",
            "鑿处若教當要路，為君常濟往來人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 15
    },
    {
        "title": "米囊花",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "開花空道勝於草，結實何曾濟得民。",
            "卻笑野田禾与黍，不闻弦管過青春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 16
    },
    {
        "title": "惜花",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "豔拂衣襟蕊拂杯，繞枝閑共蝶徘徊。",
            "春风滿目還惆悵，半欲離披半未開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 17
    },
    {
        "title": "蓮花",
        "author": "郭震",
        "biography": "",
        "paragraphs": [
            "臉膩香熏似有情，世間何物比輕盈。",
            "湘妃雨后來池看，碧玉盤中弄水晶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六十六",
        "no#": 18
    }
]