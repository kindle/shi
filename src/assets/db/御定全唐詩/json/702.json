[
    {
        "title": "登單于台",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "邊兵春盡回，独上單于台。白日地中出，黃河天外來。",
            "沙翻痕似浪，风急響疑雷。欲向阴關度，阴關曉不開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 1
    },
    {
        "title": "寄友人",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "戀道欲何如，東西遠索居。長疑即見面，翻致久无书。",
            "甸麥深藏雉，淮苔淺露魚。相思不我會，明月幾盈虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 2
    },
    {
        "title": "和崔監丞春遊鄭僕射東園",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "春興隨花盡，東園自養閑。不離三畝地，似入万重山。",
            "白鳥穿蘿去，清泉抵石還。豈同秦代客，无位隱商山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 3
    },
    {
        "title": "過蕭關",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "出得蕭關北，儒衣不稱身。隴狐來試客，沙鶻下欺人。",
            "曉戍残烽火，晴原起獵塵。邊戎莫相忌，非是霍家親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 4
    },
    {
        "title": "盆池",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "圓內陶化功，外絕眾流通。選處離松影，穿时減药叢。",
            "別疑天在地，長對月當空。每使登門客，煙波入夢中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 5
    },
    {
        "title": "野泉",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "遠出白雲中，長年聽不同。清聲縈乱石，寒色入長空。",
            "掛壁聊成雨，穿林別起风。溫泉非爾數，源發在深空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 6
    },
    {
        "title": "送成州牧",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "清时為塞郡，自古有儒流。素望知難愜，新恩且用酬。",
            "犬牙連蜀國，兵額貫秦州。只作三年別，谁能聽邑留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 7
    },
    {
        "title": "薊北书事",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "度磧如經海，茫然但見空。戍樓承落日，沙塞礙驚蓬。",
            "暑過燕僧出，时平虜客通。逢人皆上将，谁有定邊功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 8
    },
    {
        "title": "送徐州薛尚书",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "上将出儒中，論诗擬立功。州從禹後別，军自漢來雄。",
            "遠驛銷寒日，嚴城肅暮空。龍顏有遺廟，犹得奠英风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 9
    },
    {
        "title": "貽曹郎中",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "所作高前古，封章自曲台。細看明主意，終用出人才。",
            "省印尋僧鎖，书樓領鶴開。南山有舊友，时向白雲來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 10
    },
    {
        "title": "送縉雲尉",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "釋褐從仙尉，之官興若何。去程唯水石，公署在雲蘿。",
            "野飯樓中迥，晴峰案上多。三年罷趨府，應更戰高科。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 11
    },
    {
        "title": "送董卿赴台州",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "九陌除书出，尋僧问海城。家從中路挈，吏隔數州迎。",
            "夜蚌侵燈影，春禽雜櫓聲。開圖見異跡，思上石橋行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 12
    },
    {
        "title": "送友人赴涇州幕",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "杏園沈飲散，榮別就佳招。日月相期盡，山川独去遙。",
            "府樓明蜀雪，關磧轉胡雕。縱有煙塵動，應隨上策銷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 13
    },
    {
        "title": "逢漳州崔使君北归",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "在郡多殊稱，无人不望回。離城攜客去，度嶺擔猿來。",
            "障写經冬蕊，瓶緘落暑梅。長安有归宅，归見鎖青苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 14
    },
    {
        "title": "雲朔逢山友",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "會面卻生疑，居然似夢归。塞深行客少，家遠识人稀。",
            "戰馬分旗牧，驚禽曳箭飛。将军雖異禮，難便脫麻衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 15
    },
    {
        "title": "別後寄友生",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "上馬如飛鳥，飄然隔去塵。共看今夜月，独作異鄉人。",
            "就養江南熟，移居井賦新。襄阳曾卜隱，應与孟家鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 16
    },
    {
        "title": "邊游別友人",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "欲別不止淚，當杯難強歌。家貧隨日長，身病涉寒多。",
            "雨雪迷燕路，田園隔楚波。良时未自致，归去欲如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 17
    },
    {
        "title": "邊庭送別",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "一生雖達理，遠別亦相悲。白发无修處，青松有老时。",
            "暮煙傳戍起，寒日隔沙垂。若是長安去，何難定後期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 18
    },
    {
        "title": "将之京師留別親友",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "達命何勞问，西遊且自期。至公如有日，知我豈无时。",
            "野迥蟬相答，堤長柳對垂。酣歌一舉袂，明發不堪思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 19
    },
    {
        "title": "贈別山友",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "從容无限意，不独為離群。年長驚黃葉，时清厭白雲。",
            "舊山回馬見，寒瀑別家闻。相与存吾道，窮通各自分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 20
    },
    {
        "title": "途次績溪先寄陳明府",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "入境风煙好，幽人不易傳。新居多是客，舊隱半成仙。",
            "山斷雲沖騎，溪長柳拂船。何當许過縣，闻有篋中篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 21
    },
    {
        "title": "送友人归武陵",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "闻近桃源住，无村不是花。戍旗招海客，廟鼓集江鴉。",
            "別島垂橙實，闲田長荻芽。游秦未得意，看即更離家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 22
    },
    {
        "title": "乱中寄友人",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "別來難覓信，何處避艱危。鬢黑无多日，塵清是幾时。",
            "人情将厭武，王澤即興诗。若便懷深隱，還應聖主知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 23
    },
    {
        "title": "哭建州李員外",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "诗名不易出，名出又何為。捷到重科早，官終一郡卑。",
            "素风无後嗣，遺跡有生祠。自罷羊公市，溪猿哭舊时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 24
    },
    {
        "title": "吊孟浩然",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "每每樵家说，孤墳亦夜吟。若重生此世，應更苦前心。",
            "名与襄阳遠，诗同漢水深。親栽鹿門樹，犹蓋石床阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 25
    },
    {
        "title": "送友人及第归",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "家林滄海東，未曉日先紅。作貢諸蕃別，登科幾國同。",
            "遠聲魚呷浪，層氣蜃迎风。鄉俗稀攀桂，爭來问月宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 26
    },
    {
        "title": "次韵和友人冬月书齋",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "四季多花木，窮冬亦不凋。薄冰行處斷，残火睡來消。",
            "象版簽书帙，蠻藤絡酒瓢。公卿有知己，时得一相招。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 27
    },
    {
        "title": "過山家",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "避暑得探幽，忘言遂久留。雲深窗失曙，松合徑先秋。",
            "響谷傳人语，鳴泉洗客愁。家山不在此，至此可归休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 28
    },
    {
        "title": "宿山驛",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "驛在千峰裏，寒宵独此身。古墳时見火，荒壁悄无鄰。",
            "月白翻驚鳥，雲閑欲就人。只應明日鬢，更与老相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 29
    },
    {
        "title": "宿開照寺光澤上人院",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "靜室譚玄旨，清宵独細聽。真身非有像，至理本无經。",
            "鐘定遙闻水，樓高別見星。不教人觸穢，偏说此山靈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 30
    },
    {
        "title": "宿山寺",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "中峰半夜起，忽覺有青冥。此界自生雨，上方犹有星。",
            "樓高鐘尚遠，殿古像多靈。好是潺湲水，房房伴誦經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 31
    },
    {
        "title": "題紫閣院",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "上方人海外，苔徑上千層。洞壑有靈药，房廊无老僧。",
            "古岩雕素像，喬木掛寒燈。每到思修隱，将回苦不能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 32
    },
    {
        "title": "白菊",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "秋天木葉幹，犹有白花残。舉世稀栽得，豪家卻画看。",
            "片苔相應綠，諸卉独宜寒。幾度攜佳客，登高欲折難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 33
    },
    {
        "title": "叢葦",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "叢叢寒水邊，曾折打魚船。忽与亭台近，翻嫌島嶼偏。",
            "花明无月夜，聲急正秋天。遙憶巴陵渡，残阳一望煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 34
    },
    {
        "title": "鄭轂補闕山松",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "心将積雪欺，根与白雲離。遠寄僧犹憶，高看鶴未知。",
            "影交新長葉，皴匝舊生枝。多少同时種，深山不得移。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 35
    },
    {
        "title": "新竹",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "新鞭暗入庭，初長两三莖。不是他山少，无如此地生。",
            "垂梢叢上出，柔葉籜間成。何用高唐峽，风枝掃月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 36
    },
    {
        "title": "和友人送趙能卿東归",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "一第时難得，归期日已過。相看玄鬢少，共憶白雲多。",
            "楚闊天垂草，吳空月上波。无人不有遇，之子独狂歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 37
    },
    {
        "title": "送人归南中",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "有家谁不別，經乱独難尋。遠路波濤惡，窮荒雨霧深。",
            "燒驚山象出，雷觸海鼇沉。為问南遷客，何人在瘴林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 38
    },
    {
        "title": "塞下曲",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "邊事多更變，天心亦為憂。胡兵來作寇，漢将也封侯。",
            "夜燒沖星赤，寒塵翳日愁。无門展微略，空上望西樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 39
    },
    {
        "title": "邊将二首",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "曆戰燕然北，功高劍有威。闻名外國懼，輕命故人稀。",
            "角怨星芒動，塵愁日色微。從為漢都護，未得脫征衣。",
            "按劍立城樓，西看極海頭。承家為上将，開地得邊州。",
            "磧迥兵難伏，天寒馬易收。胡风一度獵，吹裂錦貂裘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 40
    },
    {
        "title": "朔方书事",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "秋盡角聲苦，逢人唯荷戈。城池向隴少，岐路出關多。",
            "雁遠行垂地，烽高影入河。仍闻黑山寇，又覓漢家和。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 41
    },
    {
        "title": "經荒驛",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "古驛成幽境，雲蘿隔四鄰。夜燈移宿鳥，秋雨禁行人。",
            "廢巷荊叢合，荒庭虎跡新。昔年經此地，終日是紅塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 42
    },
    {
        "title": "贈棲白大師",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "剃發得时名，僧應別應星。偶題皆有詔，閑論便成經。",
            "掃葉寒燒鼎，融冰曉注瓶。長因內齋出，多客叩禪扃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 43
    },
    {
        "title": "贈闻一上人",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "見面雖年少，闻名似白頭。玄談窮釋旨，清思掩诗流。",
            "果落痕生砌，松高影上樓。壇場在三殿，應召入焚修。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 44
    },
    {
        "title": "贈可倫上人",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "師教本於空，流來不自東。修從多劫後，行出眾人中。",
            "衲冷湖山雨，幡輕海甸风。游吳累夏講，還与虎溪同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 45
    },
    {
        "title": "寄法幹寺令諲太師",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "師居中禁寺，外請已无緣。望幸唯修偈，承恩不乱禪。",
            "院多喧種药，池有化生蓮。何日龍宮裏，相尋借法船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 46
    },
    {
        "title": "寄太白禪師",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "何年万仞頂，独有坐禪僧。客上應无路，人傳或見燈。",
            "齋廚唯有橡，講石任生藤。遙想東林社，如師谁複能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 47
    },
    {
        "title": "遇道者",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "數裏白雲裏，身輕无履蹤。故尋多不見，偶到即相逢。",
            "古井生雲水，高壇出異松。聊看杏花酌，便似换顏容。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 48
    },
    {
        "title": "贈道者",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "得道疑人识，都城独閉關。頭從白後黑，心向鬧中閑。",
            "饑渴唯調氣，兒孫亦駐顏。始知仙者隱，殊不在深山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 49
    },
    {
        "title": "雨",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "半夜西亭雨，離人独啟關。桑麻荒舊國，雷電照前山。",
            "細滴高槐底，繁聲疊漏間。唯應孤鏡裏，明月長愁顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 50
    },
    {
        "title": "長安春望",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "明时不敢臥煙霞，又見秦城换物華。残雪未銷雙鳳闕，",
            "故國別來桑柘盡，十年兵踐海西艖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 51
    },
    {
        "title": "過黃牛峽",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "黃牛來勢瀉巴川，疊日孤舟逐峽前。雷電夜驚猿落樹，",
            "多少人經過此去，一生魂夢怕潺湲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 52
    },
    {
        "title": "逢道者",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "縱意出山无遠近，還如孤鶴在空虛。昔年親種樹皆老，",
            "只尋隱跡归何處，方说煙霞不定居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 53
    },
    {
        "title": "邊情",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "窮荒始得靜天驕，又说天兵擬渡遼。聖主尚嫌蕃界近，",
            "惆悵臨戎皆效國，豈无人似霍嫖姚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 54
    },
    {
        "title": "贈李司徒",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "承家拓定隴關西，勳貴名應上将齊。金庫夜開龍甲冷，",
            "長怪魯儒頭枉白，不親弓劍覓丹梯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 55
    },
    {
        "title": "送盧尚书赴靈武",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "西北正傳烽候急，靈州共喜信臣居。從军儘是清才去，",
            "山川不異江湖景，賓館常闻食有魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 56
    },
    {
        "title": "投翰林张侍郎",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "舉家貧拾海邊樵，來認仙宗在碧霄。丹穴雖无凡羽翼，",
            "愿与吾君作霖雨，且應平地活枯苗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 57
    },
    {
        "title": "投翰林蕭侍郎",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "九仞牆邊絕路岐，野才非合自求知。靈湫豈要魚棲浪，",
            "從來為學投文鏡，文鏡如今更有谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 58
    },
    {
        "title": "宴駙馬宅",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "牙香禁樂鎮相攜，日日君恩降紫泥。紅药院深人半醉，",
            "別向庭蕪寘吟石，不教宮妓踏成蹊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 59
    },
    {
        "title": "邊将",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "上馬乘秋欲建勳，飛弧夜闕出師频。若无紫塞煙塵事，",
            "由來邊卒皆如此，只是君門合殺身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 60
    },
    {
        "title": "贈水军都将",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "平生為有安邦術，便別秋曹最上階。戰艦卻容儒客臥，",
            "直待門前見幢節，始應高愜聖君懷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 61
    },
    {
        "title": "贈九江太守",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "江頭暫駐木蘭船，漁父來誇太守賢。二邑旋添新戶口，",
            "昨日西亭從遊騎，信旗风裏说诗篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 62
    },
    {
        "title": "贈信安太守",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "三衢正對福星时，喜得君侯妙撫綏。甲士散教耕壟畝，",
            "昨日中官说天意，即飛丹詔立新碑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 63
    },
    {
        "title": "贈江都鄭明府",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "他人豈是稱才術，才術須觀力有餘。兵乱幾年臨劇邑，",
            "更欲棲蹤近彭澤，香爐峰下結茅廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 64
    },
    {
        "title": "贈南昌宰",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "假邑邀真邑命分，明庭元有至公存。每鋤奸弊同荊棘，",
            "新銜便合兼朱紱，應待蒼生更舉論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 65
    },
    {
        "title": "贈丘衙推",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "仙都高處掩柴扉，人世闻名見者稀。诗逸不拘凡對屬，",
            "任醉賓筵莫深隱，綺羅絲竹勝漁磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 66
    },
    {
        "title": "獻所知",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "跡熟荀家見弟兄，九霄同与指前程。吹噓漸覺馨香出，",
            "登龍不敢懷他愿，只望為霖致太平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 67
    },
    {
        "title": "投所知",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "十五年看帝裏春，一枝頭白未酬身。自闻離乱開公道，",
            "省郎門似龍門峻，應借风雷變涸鱗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 68
    },
    {
        "title": "南康夜宴東溪留別郡守陸郎中",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "飄然野客才无取，多謝君侯独見知。竹葉樽前教駐樂，",
            "明發別愁何處去，片帆天際酒醒时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 69
    },
    {
        "title": "言懷",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "十载聲沈覺自非，賤身元合衣荷衣。豈能得路陪先達，",
            "平生只學穿楊箭，更向何門是見机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 70
    },
    {
        "title": "喜友人日南回",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "南游曾去海南涯，此去遊人不易归。白日霧昏张夜燭，",
            "重入帝城何寂寞，共回遷客半輕肥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 71
    },
    {
        "title": "下第述懷",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "十载長安跡未安，杏花還是看人看。名從近事方知險，",
            "如何直道為身累，坐月眠霜思枉幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 72
    },
    {
        "title": "華阳道者",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "華阳洞裏持真經，心嫌來客风塵腥。惟餐白石過白日，",
            "長生不必論貴賤，卻是幽人骨主靈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 73
    },
    {
        "title": "夏日題老将林亭",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "百戰功成翻愛靜，侯門漸欲似仙家。牆頭雨細垂纖草，",
            "幾人圖在淩煙閣，曾不交鋒向塞沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 74
    },
    {
        "title": "觀江南牡丹",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "北地花開南地风，寄根還与客心同。群芳盡怯千般態，",
            "近年明主思王道，不许新栽滿六宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 75
    },
    {
        "title": "錢塘夜宴留別郡守",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "四方騷動一州安，夜列樽罍伴客歡。觱栗調高山閣迥，",
            "沈醉不愁归棹遠，晚风吹上子陵灘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 76
    },
    {
        "title": "送薛郎中赴江州",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "幾州闻出刺，謠美有江民。正面傳天旨，懸心禱嶽神。",
            "尺书先假路，紅旆旋燒塵。郡顯山川別，衙開将吏新。",
            "散招僧坐暑，閑载客行春。聽事棋忘著，探題酒乱巡。",
            "好編高隱傳，多貌上升真。近日居清近，求人在此人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 77
    },
    {
        "title": "送南海僧游蜀",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "真修絕故鄉，一衲度暄涼。此世能先覺，他生豈再忘。",
            "定中船過海，臘後路沿湘。野迥鴉隨笠，山深虎背囊。",
            "瀑流垂石室，蘿蔓蓋銅梁。卻後何年會，西方有上房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 78
    },
    {
        "title": "和友人许裳題宣平裏古藤",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "欲結千年茂，生來便近松。迸根通井潤，交葉覆庭穠。",
            "歷代频更主，盤空漸變龍。晝风圓影乱，宵雨細聲重。",
            "蓋密勝丹桂，層危類遠峰。嫩條懸野鼠，枯節叫秋蛩。",
            "翠老霜難蝕，皴多蘚乍封。幾家遙共玩，何寺不堪容。",
            "客對忘離榻，僧看誤過鐘。頃因陪預作，終夕繞枝筇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 79
    },
    {
        "title": "十五夜与友人對月",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "每到月圓思共醉，不宜同醉不成歡。",
            "一千二百如輪夜，浮世谁能得盡看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 80
    },
    {
        "title": "青塚",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "傾國可能勝效國，无勞冥寞更思回。",
            "太真雖是承恩死，只作飛塵向馬嵬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 81
    },
    {
        "title": "古戰場",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "荒骨潛銷壘已平，漢家曾说此交兵。",
            "如何万古冤魂在，风雨时闻有戰聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 82
    },
    {
        "title": "贈段逸人",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "長筇自擔药兼琴，話著名山即擬尋。",
            "從聽世人權似火，不能燒得臥雲心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 83
    },
    {
        "title": "贈鄭司业",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "晚學更求來世達，正懷非与百邪侵。",
            "古人名在今人口，不合於名不苦心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 84
    },
    {
        "title": "上所知",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "初向眾中留姓氏，敢期言下致时名。",
            "而今馬亦知人意，每到門前不肯行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 85
    },
    {
        "title": "別鄭仁表",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "春雷醉別鏡湖邊，官顯才狂正少年。",
            "紅燭滿汀歌舞散，美人迎上木蘭船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 86
    },
    {
        "title": "言懷",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "不将高蓋竟煙塵，自向蓬茅認此身。",
            "唐祖本來成大业，豈非姚宋是平人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 87
    },
    {
        "title": "敘懷",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "月裏路從何處上，江邊身合幾时归。",
            "十年九陌寒风夜，夢掃蘆花絮客衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 88
    },
    {
        "title": "抒懷",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "幾出東堂謝不才，便甘閑望故山回。",
            "翻思未是離家久，更有人從外國來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 89
    },
    {
        "title": "自諷",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "鹿鳴筵上強稱賢，一送離家十四年。",
            "同隱海山燒药伴，不求丹桂卻登仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 90
    },
    {
        "title": "傷賈島",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "生為明代苦吟身，死作長江一逐臣。",
            "可是當时少知已，不知知己是何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 91
    },
    {
        "title": "再游西山贈许尊師",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "別後已闻師得道，不期犹在此山頭。",
            "昔时霜鬢今如漆，疑是年光卻倒流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 92
    },
    {
        "title": "宮詞",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "日透珠簾見冕旒，六宮爭逐百花球。",
            "回看不覺君王去，已聽笙歌在遠樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 93
    },
    {
        "title": "經範蠡舊居",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "一變姓名離百越，越城犹在範家无。",
            "他人不見扁舟意，卻笑輕生泛五湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 94
    },
    {
        "title": "題嘉陵驛",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "嘉陵路惡石和泥，行到長亭日已西。",
            "独倚闌幹正惆悵，海棠花裏鷓鴣啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 95
    },
    {
        "title": "龜山寺晚望",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "四面湖光絕路岐，鸊鵜飛起暮鐘时。",
            "漁舟不用懸帆席，归去乘风插柳枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 96
    },
    {
        "title": "華山孤松",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "石罅引根非土力，冒寒犹助嶽蓮光。",
            "綠槐生在膏腴地，何得无心拒雪霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 97
    },
    {
        "title": "吊万人塚",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "兵罷淮邊客路通，乱鴉來去噪寒空。",
            "可怜白骨攢孤塚，盡為将军覓戰功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 98
    },
    {
        "title": "送友尉蜀中",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "故友漢中尉，請為西蜀吟。人家多種橘，风土愛彈琴。",
            "水向昆明闊，山通大夏深。理閑无別事，时寄一登臨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 99
    },
    {
        "title": "長安寓懷",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "九衢秋雨掩閑扉，不似幹名似息机。",
            "貧病卻慚牆上土，年來犹自换新衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 100
    },
    {
        "title": "費征君舊居",
        "author": "张蠙",
        "biography": "",
        "paragraphs": [
            "浮世拋身外，棲蹤入九華。遺篇補樂府，舊籍隸仙家。",
            "池靜龜升樹，庭荒鶴隱花。古來天子命，還少到煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零二",
        "no#": 101
    }
]