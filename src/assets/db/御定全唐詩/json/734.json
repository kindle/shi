[
    {
        "title": "柳",
        "author": "羅紹威",
        "biography": "",
        "paragraphs": [
            "妝點青春更有谁，青春常许占先知。亞夫營畔风輕處，",
            "交情別緒論多少，好向仁人贈一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 1
    },
    {
        "title": "白菊",
        "author": "羅紹威",
        "biography": "",
        "paragraphs": [
            "雖被风霜競欲催，皎然顏色不低摧。已疑素手能妝出，",
            "尋思閉戶中宵見，應認寒窗雪一堆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 2
    },
    {
        "title": "句",
        "author": "羅紹威",
        "biography": "",
        "paragraphs": [
            "樓前澹澹雲頭日，簾外蕭蕭雨腳风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 3
    },
    {
        "title": "清明登奉先城樓",
        "author": "羅袞",
        "biography": "",
        "paragraphs": [
            "年來年去只艱危，春半堯山草尚衰。四海清平耆舊見，",
            "拭盡賈生无限淚，一行归雁遠參差。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 4
    },
    {
        "title": "清明赤水寺居",
        "author": "羅袞",
        "biography": "",
        "paragraphs": [
            "榆火輕煙處處新，旋從閑望到諸鄰。浮生浮世只多事，",
            "蓑衣毳衲誠吾黨，自結村園一社貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 5
    },
    {
        "title": "贈羅隱",
        "author": "羅袞",
        "biography": "",
        "paragraphs": [
            "平日时风好涕流，讒书雖盛一名休。寰區歎屈瞻天问，",
            "何當世祖從人望，早以公台命卓侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 6
    },
    {
        "title": "哭趙州和尚二首",
        "author": "王鎔",
        "biography": "",
        "paragraphs": [
            "師離dt水動王侯，心印光潛麈尾收。碧落霧霾松嶺月，",
            "縱是了然雲外客，每瞻瓶幾淚還流。",
            "佛日西傾祖印隳，珠沈丹沼月沈輝。影敷丈室爐煙慘，",
            "解空弟子絕悲喜，犹自潸然對雪幃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 7
    },
    {
        "title": "答同年李昉見贈次韵",
        "author": "鄧洵美",
        "biography": "",
        "paragraphs": [
            "詞場幾度讓長鞭，又向清朝賀九遷。品秩雖然殊此日，",
            "今日相逢翻自愧，閑吟對酒倍潸然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 8
    },
    {
        "title": "除夜長安作",
        "author": "李京",
        "biography": "",
        "paragraphs": [
            "長安朔风起，窮巷掩雙扉。新歲明朝是，故鄉何路归。",
            "鬢絲饒鏡色，隙雪奪燈輝。卻羨秦州雁，逢春盡北飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 9
    },
    {
        "title": "登嶺望",
        "author": "许鼎",
        "biography": "",
        "paragraphs": [
            "淼淼三江水，悠悠五嶺關。雁飛犹不度，人去若為還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 10
    },
    {
        "title": "崿嶺四望",
        "author": "许鼎",
        "biography": "",
        "paragraphs": [
            "漢家仙仗在咸阳，洛水東流出建章。",
            "野老至今犹望幸，離宮秋樹独蒼蒼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 11
    },
    {
        "title": "官左拾遺归隱作",
        "author": "王易簡",
        "biography": "",
        "paragraphs": [
            "汩沒朝班愧不才，谁能低折向塵埃。",
            "青山得去且归去，官職有來還自來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 12
    },
    {
        "title": "悼楊氏妓琴弦",
        "author": "朱褒",
        "biography": "",
        "paragraphs": [
            "魂归寥廓魄归泉，只住人間十五年。",
            "昨日施僧裙帶上，斷腸犹系琵琶弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 13
    },
    {
        "title": "公子行",
        "author": "黃損",
        "biography": "",
        "paragraphs": [
            "春草綠綿綿，驕驂驟暖煙。微风飄樂韵，半日醉花邊。",
            "打鵲拋金盞，招人舉玉鞭。田翁与蠶婦，平地看神仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 14
    },
    {
        "title": "讀史",
        "author": "黃損",
        "biography": "",
        "paragraphs": [
            "逐鹿走紅塵，炎炎火德新。家肥生孝子，國霸有餘臣。",
            "帝道雲龍合，民心草木春。須知煙閣上，一半老儒真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 15
    },
    {
        "title": "出山吟",
        "author": "黃損",
        "biography": "",
        "paragraphs": [
            "來书初出白雲扃，乍躡秋风馬走輕。遠近留連分嶽色，",
            "昨夜細看雲色裏，進賢星座甚分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 16
    },
    {
        "title": "书壁",
        "author": "黃損",
        "biography": "",
        "paragraphs": [
            "一別人間歲月多，归來人事已銷磨。",
            "惟有門前鑒池水，春风不改舊时波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 17
    },
    {
        "title": "句",
        "author": "黃損",
        "biography": "",
        "paragraphs": [
            "机關才运動，勝敗便相隨。",
            "忽遇南遷客，若為西入心。",
            "往來三島近，活计一囊空。",
            "三通明主詔，一片白雲心。",
            "掃地待明月，踏花迎野僧。",
            "水諳彭澤闊，山憶武陵深。",
            "金鐙冷光风宛轉，錦袍紅潤雨霏微。",
            "高齊日月方為道，動合乾坤始是心。",
            "傍水野禽通體白，飣盤山果半邊紅。",
            "而今世上多離別，莫向相思樹下啼。（《鷓鴣》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 18
    },
    {
        "title": "梁郊祀樂章：慶肅",
        "author": "张袞",
        "biography": "",
        "paragraphs": [
            "籩豆簠簋，黍稷非馨。懿茲彝器，厥德惟明。",
            "金石匏革，以和以平。由此无疆，期乎永寧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 19
    },
    {
        "title": "梁郊祀樂章：慶熙",
        "author": "张袞",
        "biography": "",
        "paragraphs": [
            "哲後躬享，旨酒斯陳。王恭无斁，嚴祀惟寅。",
            "皇祖以配，大孝以振。宜錫景福，永休下民。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 20
    },
    {
        "title": "梁郊祀樂章：慶隆",
        "author": "张袞",
        "biography": "",
        "paragraphs": [
            "恭祀上帝，于國之阳。爵醴是荷，鴻基永昌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 21
    },
    {
        "title": "梁郊祀樂章：慶融",
        "author": "张袞",
        "biography": "",
        "paragraphs": [
            "道和氣兮襲氤氳，宣皇規兮彰聖神。",
            "服遐裔兮敷質文，格苗扈兮息煙塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 22
    },
    {
        "title": "梁郊祀樂章：慶休",
        "author": "张袞",
        "biography": "",
        "paragraphs": [
            "大业來四夷，仁风和万國。白日體无私，皇天輔有德。",
            "七旬罪已服，六月師方克。偉哉帝道隆，終始常作則。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 23
    },
    {
        "title": "梁郊祀樂章：慶和",
        "author": "张袞",
        "biography": "",
        "paragraphs": [
            "煙燎升，禮容徹。誠感達，人神悅。",
            "靈貺彰，聖情結。玉座寂，金爐歇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 24
    },
    {
        "title": "梁郊祀樂章：慶和",
        "author": "趙光逢",
        "biography": "",
        "paragraphs": [
            "就阳位，升圜丘。佩雙玉，禦大裘。",
            "膺天命，擁神休。万靈感，百祿遒。",
            "秉黃鉞，建朱旗。震八表，清二仪。",
            "帝业顯，王道夷。受景命，啟皇基。",
            "開九門，懷百神。通肸蚃，接氤氳。",
            "明粢薦，廣樂陳。奠嘉璧，燎芳薪。",
            "膺寶圖，執左契。德應天，聖饗帝。",
            "薦表衷，荷靈惠。壽万年，祚百世。",
            "惟德動天，有感必通。秉茲一德，禋于六宗。",
            "欽夤寶命，恭肅禮容。來顧來享，永穆皇风。",
            "天惟佑德，辟乃奉天。交感斯在，昭事罔愆。",
            "歲功已就，王道无偏。於焉報本，是用告虔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 25
    },
    {
        "title": "梁郊祀樂章：慶顺",
        "author": "趙光逢",
        "biography": "",
        "paragraphs": [
            "聖皇戾止，天步舒迟。幹幹睿相，穆穆皇仪。",
            "進退必肅，陟降是祗。六變克協，万靈協隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 26
    },
    {
        "title": "梁郊祀樂章：慶平",
        "author": "趙光逢",
        "biography": "",
        "paragraphs": [
            "天命降鑒，帝德惟馨。享祀不忒，禮容孔明。",
            "奠璧布幣，薦純獻精。神佑以答，敷錫永寧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十四",
        "no#": 27
    }
]