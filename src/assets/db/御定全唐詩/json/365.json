[
    {
        "title": "聽琴",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "禪思何妨在玉琴，真僧不見聽时心。",
            "秋堂境寂夜方半，雲去蒼梧湘水深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 1
    },
    {
        "title": "魏宮詞二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "日晚長秋簾外報，望陵歌舞在明朝。",
            "添爐欲爇熏衣麝，憶得分时不忍燒。",
            "日映西陵松柏枝，下臺相顧一相思。",
            "朝來樂府長歌曲，唱著君王自作詞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 2
    },
    {
        "title": "楊枝詞二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "迎得春光先到來，淺黃輕綠映樓臺。",
            "只緣嫋娜多情思，更被春风長倩猜。",
            "巫峽巫山楊柳多，朝雲暮雨遠相和。",
            "因想阳臺无限事，來君回唱竹枝歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 3
    },
    {
        "title": "竹枝詞二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "楊柳青青江水準，闻郎江上唱歌聲。",
            "東邊日出西邊雨，道是无晴卻有晴。",
            "楚水巴山江雨多，巴人能唱本鄉歌。",
            "今朝北客思归去，回入紇那披綠羅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 4
    },
    {
        "title": "堤上行三首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "酒旗相望大堤頭，堤下連檣堤上樓。",
            "日暮行人爭渡急，槳聲幽軋滿中流。",
            "江南江北望煙波，入夜行人相應歌。",
            "桃葉傳情竹枝怨，水流无限月明多。",
            "春堤繚繞水徘徊，酒舍旗亭次第開。",
            "日晚上樓招估客，軻峨大艑落帆來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 5
    },
    {
        "title": "《踏歌詞四首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "春江月出大堤平，堤上女郎連袂行。",
            "唱盡新詞歡不見，紅霞映樹鷓鴣鳴。",
            "桃蹊柳陌好經過，燈下妝成月下歌。",
            "為是襄王故宮地，至今犹自細腰多。",
            "新詞宛轉遞相傳，振袖傾鬟风露前。",
            "月落烏啼雲雨散，游童陌上拾花鈿。",
            "日暮江頭闻竹枝，南人行樂北人悲。",
            "自從雪裏唱新曲，直到三春花盡时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 6
    },
    {
        "title": "步虛詞二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "阿母種桃雲海際，花落子成三千歲。",
            "海风吹折最繁枝，跪捧瓊盤獻天帝。",
            "華表千年一鶴归，凝丹為頂雪為衣。",
            "星星仙语人聽盡，卻向五雲翻翅飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 7
    },
    {
        "title": "阿嬌怨",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "望見葳蕤舉翠華，試開金屋掃庭花。",
            "須臾宮女傳來信，言幸平阳公主家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 8
    },
    {
        "title": "秋扇詞",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "莫道恩情无重來，人間榮謝遞相催。",
            "當时初入君懷袖，豈念寒爐有死灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 10
    },
    {
        "title": "竹枝詞九首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "白帝城頭春草生，白鹽山下蜀江清。",
            "南人上來歌一曲，北人莫上動鄉情。",
            "山桃紅花滿上頭，蜀江春水拍山流。",
            "花紅易衰似郎意，水流无限似儂愁。",
            "江上朱樓新雨晴，瀼西春水縠紋生。",
            "橋東橋西好楊柳，人來人去唱歌行。",
            "日出三竿春霧消，江頭蜀客駐蘭橈。",
            "凭寄狂夫书一紙，家住成都万里橋。",
            "两岸山花似雪開，家家春酒滿銀盃。",
            "昭君坊中多女伴，永安宮外踏青來。",
            "城西門前灩澦堆，年年波浪不能摧。",
            "懊惱人心不如石，少时東去複西來。",
            "瞿塘嘈嘈十二灘，人言道路古來難。",
            "長恨人心不如水，等闲平地起波瀾。",
            "巫峽蒼蒼煙雨时，清猿啼在最高枝。",
            "個裏愁人腸自斷，由來不是此聲悲。",
            "山上層層桃李花，雲間煙火是人家。",
            "銀釧金釵來負水，長刀短笠去燒畬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 11
    },
    {
        "title": "楊柳枝詞九首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "塞北梅花羌笛吹，淮南桂樹小山詞。",
            "請君莫奏前朝曲，聽唱新翻楊柳枝。",
            "南陌東城春早时，相逢何處不依依。",
            "桃紅李白皆誇好，須得垂楊相發揮。",
            "鳳闕輕遮翡翠幃，龍池遙望麹塵絲。",
            "禦溝春水相輝映，狂殺長安年少兒。",
            "金谷園中鶯乱飛，銅駝陌上好风吹。",
            "城中桃李須臾盡，爭似垂楊无限时。",
            "花萼樓前初種时，美人樓上鬥腰肢。",
            "如今拋擲長街裏，露葉如啼欲向谁。",
            "煬帝行宮汴水濱，數枝楊柳不勝春。",
            "晚來风起花如雪，飛入宮牆不見人。",
            "禦陌青門拂地垂，千條金縷万條絲。",
            "如今綰作同心結，将贈行人知不知。",
            "城外春风吹酒旗，行人揮袂日西时。",
            "長安陌上无窮樹，唯有垂楊管別離。",
            "輕盈嫋娜占年華，舞榭妝樓處處遮。",
            "春盡絮花留不得，隨风好去落谁家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 12
    },
    {
        "title": "浪淘沙九首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "九曲黃河万里沙，浪淘风簸自天涯。",
            "如今直上銀河去，同到牽牛織女家。",
            "洛水橋邊春日斜，碧流清淺見瓊砂。",
            "无端陌上狂风急，驚起鴛鴦出浪花。",
            "汴水東流虎眼紋，清淮曉色鴨頭春。",
            "君看渡口淘沙處，渡卻人間多少人。",
            "鸚鵡洲頭浪颭沙，青樓春望日将斜。",
            "銜泥燕子爭归舍，独自狂夫不憶家。",
            "濯錦江邊两岸花，春风吹浪正淘沙。",
            "女郎剪下鴛鴦錦，将向中流匹晚霞。",
            "日照澄洲江霧開，淘金女伴滿江隈。",
            "美人首飾侯王印，儘是沙中浪底來。",
            "八月濤聲吼地來，頭高數丈觸山回。",
            "須臾卻入海門去，卷起沙堆似雪堆。",
            "莫道讒言如浪深，莫言遷客似沙沉。",
            "千淘万漉雖辛苦，吹盡狂沙始到金。",
            "流水淘沙不暫停，前波未滅後波生。",
            "令人忽憶瀟湘渚，回唱迎神三两聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 13
    },
    {
        "title": "洛中送韓七中丞之吳興口號五首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "昔年意氣結群英，幾度朝回一字行。",
            "海北江南零落盡，两人相見洛阳城。",
            "自從雲散各東西，每日歡娛卻慘淒。",
            "離別苦多相見少，一生心事在书題。",
            "今朝无意訴離杯，何況清弦急管催。",
            "本欲醉中輕遠別，不知翻引酒悲來。",
            "駱駝橋上蘋风急，鸚鵡杯中箬下春。",
            "水碧山青知好處，開顏一笑向何人。",
            "溪中士女出笆籬，溪上鴛鴦避画旗。",
            "何處人間似仙境，春山攜妓採茶时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 14
    },
    {
        "title": "送廖參謀東游二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "九陌逢君又別離，行雲別鶴本无期。",
            "望嵩樓上忽相見，看過花開花落时。",
            "繁花落盡君辭去，綠草垂楊引征路。",
            "東道諸侯皆故人，留連必是多情處。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 15
    },
    {
        "title": "洛中春末送杜錄事赴蘄州",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "樽前花下長相見，明日忽為千里人。",
            "君過午橋回首望，洛城犹自有残春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 16
    },
    {
        "title": "夜燕福建盧侍郎宅因送之鎮",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "暫駐旌旗洛水堤，綺筵紅燭醉蘭閨。",
            "美人美酒長相逐，莫怕猿聲發建溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 17
    },
    {
        "title": "重送鴻舉師赴江陵謁馬逢侍禦",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "西北秋风凋蕙蘭，洞庭波上碧雲寒。",
            "茂陵才子江陵住，乞取新诗合掌看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 18
    },
    {
        "title": "贈長沙贊頭陀",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "外道邪山千万重，真言一發盡摧峰。",
            "有时明月无人夜，独向昭潭制惡龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 19
    },
    {
        "title": "送霄韵上人遊天臺",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "曲江僧向松江見，又到天臺看石橋。",
            "鶴戀故巢雲戀岫，比君犹自不逍遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 20
    },
    {
        "title": "台城懷古",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "清江悠悠王氣沉，六朝遺事何處尋。",
            "宮牆隱嶙圍野澤，鸛鶂夜鳴秋色深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 21
    },
    {
        "title": "戲贈崔千牛",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "學道深山许老人，留名万代不關身。",
            "勸君多買長安酒，南陌東城占取春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 22
    },
    {
        "title": "揚州春夜李端公益张侍御登段侍御平路密縣李少府畼祕书张正字復元同會於水館對酒聯句追刻燭擊銅缽故事迟輒舉觥以飲之逮夜艾群公沾醉紛然就枕余偶独醒因題诗於段君枕上以志其事",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "寂寂独看金燼落，紛紛只見玉山頹。",
            "自羞不是高阳侶，一夜星星騎馬回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 23
    },
    {
        "title": "逢王十二學士入翰林，因以诗贈",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "廄馬翩翩禁外逢，星槎上漢杳難從。",
            "定知欲報淮南詔，促召王褒入九重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 24
    },
    {
        "title": "闕下口號呈柳仪曹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "彩仗神旗獵曉风，雞人一唱鼓蓬蓬。",
            "銅壺漏水何时歇，如此相催即老翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 25
    },
    {
        "title": "監祠夕月壇书事",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "西皞司分晝夜平，羲和停午太阴生。",
            "鏗鏘揖讓秋光裏，觀者如雲出鳳城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 26
    },
    {
        "title": "元和甲午歲詔书盡徵江湘逐客余自武陵赴京宿於都亭有懷续來諸君子",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "雷雨江山起臥龍，武陵樵客躡仙蹤。",
            "十年楚水楓林下，今夜初闻長樂鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 27
    },
    {
        "title": "元和十一年自朗州召至京，戲贈看花諸君子",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "紫陌紅塵拂面來，无人不道看花回。",
            "玄都觀裏桃千樹，儘是劉郎去後栽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 28
    },
    {
        "title": "再游玄都觀",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "百畝庭中半是苔，桃花淨盡菜花開。",
            "種桃道士归何處，前度劉郎今又來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 29
    },
    {
        "title": "与歌者米嘉榮",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "唱得涼州意外聲，舊人唯數米嘉榮。",
            "近來时世輕先輩，好染髭須事後生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 30
    },
    {
        "title": "望夫石",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "終日望夫夫不归，化為孤石苦相思。",
            "望來已是幾千载，只似當时初望时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 31
    },
    {
        "title": "聽舊宮中樂人穆氏唱歌",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "曾隨織女渡天河，記得雲間第一歌。",
            "休唱貞元供奉曲，當时朝士已无多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 32
    },
    {
        "title": "金陵五題：石頭城",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "山圍故國周遭在，潮打空城寂寞回。",
            "淮水東邊舊时月，夜深還過女牆來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 33
    },
    {
        "title": "金陵五題：烏衣巷",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "朱雀橋邊野草花，烏衣巷口夕阳斜。",
            "舊时王謝堂前燕，飛入尋常百姓家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 34
    },
    {
        "title": "金陵五題：台城",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "台城六代競豪華，結綺臨春事最奢。",
            "万戶千門成野草，只緣一曲後庭花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 35
    },
    {
        "title": "金陵五題：生公講堂",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "生公说法鬼神聽，身後空堂夜不扃。",
            "高坐寂寥塵漠漠，一方明月可中庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 36
    },
    {
        "title": "金陵五題：江令宅",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "南朝詞臣北朝客，归來唯見秦淮碧。",
            "池台竹樹三畝餘，至今人道江家宅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 37
    },
    {
        "title": "韓信廟",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "将略兵机命世雄，蒼黃鐘室歎良弓。",
            "遂令後代登壇者，每一尋思怕立功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 38
    },
    {
        "title": "李賈二大諫拜命後寄楊八壽州",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "諫省新登二直臣，万方驚喜捧絲綸。",
            "則知天子明如日，肯放淮南高臥人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 39
    },
    {
        "title": "美溫尚书鎮定興元以诗寄賀",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "旌旗入境犬无聲，戮盡鯨鯢漢水清。",
            "從此世人開耳目，始知名将出书生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 40
    },
    {
        "title": "酬瑞州吳大夫夜泊湘川見寄一絕",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "夜泊湘川逐客心，月明猿苦血沾襟。",
            "湘妃舊竹痕犹淺，從此因君染更深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 41
    },
    {
        "title": "征還京師見舊番官馮叔達",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "前者匆匆襆被行，十年憔悴到京城。",
            "南宮舊吏來相问，何處淹留白发生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 42
    },
    {
        "title": "与歌者何戡",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "二十餘年別帝京，重闻天樂不勝情。",
            "舊人唯有何戡在，更与殷勤唱渭城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 43
    },
    {
        "title": "与歌童田顺郎",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "天下能歌禦史娘，花前葉底奉君王。",
            "九重深處无人見，分付新聲与顺郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 44
    },
    {
        "title": "燕爾館破，屏风所画至精，人多歎賞題之",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "画时應遇空亡日，賣處難逢识別人。",
            "唯有多情往來客，強将衫袖拂埃塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 45
    },
    {
        "title": "賞牡丹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "庭前芍药妖无格，池上芙蕖淨少情。",
            "唯有牡丹真國色，花開时節動京城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 46
    },
    {
        "title": "題欹器圖",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "秦國功成思稅駕，晉臣名遂歎危机。",
            "无因上蔡牽黃犬，愿作丹徒一布衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 47
    },
    {
        "title": "傷桃源薛道士",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "壇邊松在鶴巢空，白鹿閑行舊徑中。",
            "手植紅桃千樹發，滿山无主任春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 48
    },
    {
        "title": "王思道碑堂下作",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "蒼蒼宰樹起寒煙，尚有威名海內傳。",
            "四府舊闻多故吏，幾人垂淚拜碑前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 49
    },
    {
        "title": "傷愚溪三首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "溪水悠悠春自來，草堂无主燕飛回。",
            "隔簾惟見中庭草，一樹山榴依舊開。",
            "草聖數行留壞壁，木奴千樹屬鄰家。",
            "唯見裏門通德榜，残阳寂寞出樵車。",
            "柳門竹巷依依在，野草青苔日日多。",
            "縱有鄰人解吹笛，山阳舊侶更谁過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 50
    },
    {
        "title": "傷循州渾尚书",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "貴人淪落路人哀，碧海連天丹旐回。",
            "遙想長安此时節，朱門深巷百花開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 51
    },
    {
        "title": "代靖安佳人怨二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "寶馬鳴珂踏曉塵，魚文匕首犯車茵。",
            "適來行哭裏門外，昨夜華堂歌舞人。",
            "秉燭朝天遂不回，路人彈指望高臺。",
            "牆東便是傷心地，夜夜流螢飛去來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 52
    },
    {
        "title": "碧澗寺見元九侍禦和展上人诗有三生之句因以和",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "廊下題诗滿壁塵，塔前松樹已皴鱗。",
            "古來唯有王文度，重見平生竺道人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 53
    },
    {
        "title": "思黯南墅賞牡丹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "偶然相遇人間世，合在增城阿姥家。",
            "有此傾城好顏色，天教晚發賽諸花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 54
    },
    {
        "title": "和浙西尚书闻常州楊給事制新樓因寄之作",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "文昌星象盡東來，油幕朱門次第開。",
            "且上新樓看风月，會乘雲雨一时回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 55
    },
    {
        "title": "後樑宣明二帝碑堂下作",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "玉馬朝周從此辭，園陵寂寞對豐碑。",
            "千行宰樹荊州道，暮雨蕭蕭闻子規。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 56
    },
    {
        "title": "贈李司空妓",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "高髻雲鬟宮樣妝，春风一曲杜韋娘。",
            "司空見慣渾闲事，斷盡蘇州刺史腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 57
    },
    {
        "title": "和西川李尚书傷孔雀及薛濤之什",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "玉兒已逐金鐶葬，翠羽先隨秋草萎。",
            "唯見芙蓉含曉露，數行紅淚滴清池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 58
    },
    {
        "title": "同樂天登棲靈寺塔",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "步步相攜不覺難，九層雲外倚闌幹。",
            "忽然笑语半天上，无限遊人舉眼看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 59
    },
    {
        "title": "有所嗟二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "庾令樓中初見时，武昌春柳似腰肢。",
            "相逢相笑盡如夢，為雨為雲今不知。",
            "鄂渚濛濛煙雨微，女郎魂逐暮雲归。",
            "只應長在漢阳渡，化作鴛鴦一隻飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 60
    },
    {
        "title": "和裴相公傍水閑行",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "為愛逍遙第一篇，时时闲步賞风煙。",
            "看花臨水心无事，功业成來二十年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 61
    },
    {
        "title": "杏園花下酬樂天見贈",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "二十餘年作逐臣，归來還見曲江春。",
            "遊人莫笑白頭醉，老醉花間有幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 62
    },
    {
        "title": "和樂天春詞",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "新妝面面下朱樓，深鎖春光一院愁。",
            "行到中庭數花朵，蜻蜓飛上玉搔頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 63
    },
    {
        "title": "和嚴給事闻唐昌觀玉蕊花下有遊仙二絕",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "玉女來看玉蕊花，異香先引七香車。",
            "攀枝弄雪时回顧，驚怪人間日易斜。",
            "雪蕊瓊絲滿院春，衣輕步步不生塵。",
            "君平簾下徒相问，長伴吹簫別有人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 64
    },
    {
        "title": "憶樂天",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "尋常相見意殷勤，別後相思夢更频。",
            "每遇登臨好风景，羨他天性少情人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 65
    },
    {
        "title": "醉答樂天",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "洛城洛城何日归，故人故人今轉稀。",
            "莫嗟雪裏暫时別，終擬雲間相逐飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 66
    },
    {
        "title": "虎丘寺見元相公二年前題名愴然有詠",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "滻水送君君不還，見君題字虎丘山。",
            "因知早貴兼才子，不得多时在世間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 67
    },
    {
        "title": "寄贈小樊",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "花面丫頭十三四，春來綽約向人时。",
            "終須買取名春草，處處将行步步隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 68
    },
    {
        "title": "吟樂天自问愴然有作",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "親友關心皆不見，风光滿眼倍傷神。",
            "洛阳城裏多池館，幾處花開有主人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 69
    },
    {
        "title": "和令狐相公別牡丹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "平章宅裏一欄花，臨到開时不在家。",
            "莫道两京非遠別，春明門外即天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 70
    },
    {
        "title": "和令狐相公闻思帝鄉有感",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "當初造曲者為谁，说得思鄉戀闕时。",
            "滄海西頭舊丞相，停杯處分不須吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 71
    },
    {
        "title": "酬令狐相公見寄",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "群玉山頭住四年，每闻笙鶴看諸仙。",
            "何时得把浮丘袖，白日将升第九天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 72
    },
    {
        "title": "令狐相公春思見寄",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "一紙书封四句诗，芳晨對酒遠相思。",
            "長吟盡日西南望，犹及残春花落时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 73
    },
    {
        "title": "城內花園頗曾遊玩令公居守亦有素期適春霜一夕委謝书實以答令狐相公見謔",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "樓下芳園最占春，年年結侶采花频。",
            "繁霜一夜相撩治，不似佳人似老人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 74
    },
    {
        "title": "奉和裴晉公涼风亭睡覺",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "驪龍睡後珠元在，仙鶴行时步又輕。",
            "方寸瑩然无一事，水聲來似玉琴聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 75
    },
    {
        "title": "答裴令公雪中訝白二十二与諸公不相訪之什",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "玉樹瓊樓滿眼新，的知開合待諸賓。",
            "迟迟未去非无意，擬作梁園坐右人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 76
    },
    {
        "title": "吳方之見示聽江西故吏朱幼恭歌三篇頗有懷故林之想吟諷不足因而和之",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "侯家故吏歌聲發，逸處能高怨處低。",
            "今歲洛中无雨雪，眼前风景是江西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 77
    },
    {
        "title": "裴令公見示誚樂天寄奴買馬絕句斐言仰和且戲樂天",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "常奴安得似方回，爭望追风絕足來。",
            "若把翠娥酬騄耳，始知天下有奇才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 78
    },
    {
        "title": "酬思黯代书見戲",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "官冷如漿病滿身，淩寒不易過天津。",
            "少年留取多情興，請待花时作主人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 79
    },
    {
        "title": "答张侍禦賈喜再登科後，自洛赴上都贈別",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "又被时人写姓名，春风引路入京城。",
            "知君憶得前身事，分付鶯花与後生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 80
    },
    {
        "title": "赴連州途經洛阳諸公置酒相送张員外賈以诗見贈率爾酬之",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "謫在三湘最遠州，邊鴻不到水南流。",
            "如今暫寄樽前笑，明日辭君步步愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 81
    },
    {
        "title": "贈元九侍禦文石枕以诗獎之",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "文章似錦氣如虹，宜薦華簪綠殿中。",
            "縱使涼飆生旦夕，犹堪拂拭愈頭风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 82
    },
    {
        "title": "酬元九院長自江陵見寄",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "无事尋花至仙境，等闲栽樹比封君。",
            "金門通籍真多士，黃紙除书每日闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 83
    },
    {
        "title": "酬楊侍郎凭見寄",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "翔鸞闕底謝皇恩，纓上滄浪舊水痕。",
            "疏傅揮金忽相憶，遠擎長句与招魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 84
    },
    {
        "title": "酬馬大夫登洭口戍見寄",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "新辭将印拂朝纓，臨水登山四體輕。",
            "犹念天涯未归客，瘴雲深處守孤城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 85
    },
    {
        "title": "答楊八敬之絕句",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "飽霜孤竹聲偏切，帶火焦桐韵本悲。",
            "今日知音一留聽，是君心事不平时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 86
    },
    {
        "title": "重寄表臣二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "對酒臨流奈別何，君今已醉我蹉跎。",
            "分明記取星星鬢，他日相逢應更多。",
            "世間人事有何窮，過後思量儘是空。",
            "早晚同归洛阳陌，卜鄰須近祝雞翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 87
    },
    {
        "title": "重寄絕句",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "淮西既是平安地，鴉路今无羽檄飛。",
            "闻道唐州最清靜，戰場耕盡野花稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 88
    },
    {
        "title": "酬楊八副使将赴湖南途中見寄一絕",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "知逐征南冠楚材，遠勞书信到阳臺。",
            "明朝若上君山上，一道巴江自此來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 89
    },
    {
        "title": "遙和韓睦州元相公二君子",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "玉人紫綬相輝映，卻要霜須一两莖。",
            "其奈无成空老去，每臨明鏡若為情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 90
    },
    {
        "title": "吳興敬郎中見惠斑竹杖兼示一絕聊以謝之",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "一莖炯炯琅玕色，數節重重玳瑁文。",
            "拄到高山未登處，青雲路上愿逢君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 91
    },
    {
        "title": "奉和裴令公夜宴",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "天下蒼生望不休，東山雖有但时遊。",
            "從來海上仙桃樹，肯逐人間风露秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 92
    },
    {
        "title": "秋夜安國觀闻笙",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "織女分明銀漢秋，桂枝梧葉共颼飀。月露滿庭人寂寂，霓裳一曲在高樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 93
    },
    {
        "title": "酬僕射牛相公晉國池上別後至甘棠館忽夢同遊因成口號見寄",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "已嗟池上別魂驚，忽報夢中攜手行。",
            "此夜独归還乞夢，老人无睡到天明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 94
    },
    {
        "title": "裴侍郎大尹雪中遺酒一壺兼示喜眼疾平一絕有闲行把酒之句斐然仰酬",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "卷盡輕雲月更明，金篦不用且閑行。",
            "若傾家釀招來客，何必池塘春草生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 95
    },
    {
        "title": "和滑州李尚书上巳憶江南禊事",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "白馬津頭春日迟，沙州归雁拂旌旗。",
            "柳營唯有军中戲，不似江南三月时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 96
    },
    {
        "title": "酬柳柳州家雞之贈",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "日日臨池弄小雛，還思写論付官奴。",
            "柳家新樣元和腳，且盡姜芽斂手徒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 97
    },
    {
        "title": "答前篇",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "小兒弄筆不能嗔，涴壁书窗且當勤。",
            "闻彼夢熊犹未兆，女中谁是衛夫人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 98
    },
    {
        "title": "答後篇",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "昔日慵工記姓名，遠勞辛苦写西京。",
            "近來漸有臨池興，為報元常欲抗行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 99
    },
    {
        "title": "重答柳柳州",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "弱冠同懷長者憂，臨岐回想盡悠悠。",
            "耦耕若便遺身老，黃發相看万事休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 100
    },
    {
        "title": "登清暉樓",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "潯阳江色潮添滿，彭蠡秋聲雁送來。",
            "南望廬山千万仞，共誇新出棟樑材。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 101
    },
    {
        "title": "赴和州于武昌縣再遇毛仙翁十八兄因成一絕",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "武昌山下蜀江東，重向仙舟見葛洪。",
            "又得案前親禮拜，大羅天訣玉函封。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 102
    },
    {
        "title": "寄毗陵楊給事三首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "揮毫起制來東省，躡足修名謁外台。",
            "好著櫜鞬莫惆悵，出文入武是全才。",
            "曾主魚书輕刺史，今朝自請左魚來。",
            "青雲直上无多地，卻要斜飛取勢回。",
            "東城南陌昔同遊，坐上无人第二流。",
            "屈指如今已零落，且須歡喜作鄰州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 103
    },
    {
        "title": "陪崔大尚书及諸閣老宴杏園",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "更将何面上春台，百事无成老又催。",
            "唯有落花无俗態，不嫌憔悴滿頭來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 104
    },
    {
        "title": "曹剛",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "大弦嘈囋小弦清，噴雪含风意思生。",
            "一聽曹剛彈薄媚，人生不合出京城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 105
    },
    {
        "title": "寄湖州韓中丞",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "老郎日日憂蒼鬢，遠守年年厭白蘋。終日相思不相見，長频相見是何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 106
    },
    {
        "title": "楊柳枝",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "楊子江頭煙景迷，隋家宮樹拂金堤。",
            "嵯峨犹有當时色，半蘸波中水鳥棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 107
    },
    {
        "title": "田顺郎歌",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "清歌不是世間音，玉殿嘗闻稱主心。",
            "唯有顺郎全學得，一聲飛出九重深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 108
    },
    {
        "title": "夜闻商人船中箏",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "大艑高帆一百尺，新聲促柱十三弦。",
            "揚州市里商人女，來占江西明月天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 109
    },
    {
        "title": "闻道士彈思归引",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "仙公一奏思归引，逐客初闻自泫然。",
            "莫怪殷勤悲此曲，越聲長苦已三年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 110
    },
    {
        "title": "喜康将军見訪",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "謫居愁寂似幽棲，百草當門茅舍低。",
            "夜獵将军忽相訪，鷓鴣驚起繞籬啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 111
    },
    {
        "title": "贈劉景擢第",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "湘中才子是劉郎，望在長沙住桂阳。",
            "昨日鴻都新上第，五陵年少讓清光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 112
    },
    {
        "title": "赴連山途次德宗山陵寄张員外",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "常时並冕奉天顏，委佩低簪彩仗間。",
            "今日独來张樂地，万重雲水望橋山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 113
    },
    {
        "title": "嘗茶",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "生拍芳叢鷹觜芽，老郎封寄謫仙家。",
            "今宵更有湘江月，照出菲菲滿碗花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 114
    },
    {
        "title": "梁國祠",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "梁國三郎威德尊，女巫簫鼓走鄉村。",
            "万家長見空山上，雨氣蒼茫生廟門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 115
    },
    {
        "title": "楊柳枝",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "春江一曲柳千條，二十年前舊板橋。",
            "曾与美人橋上別，恨无消息到今朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 117
    },
    {
        "title": "樓上",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "江上樓高二十梯，梯梯登遍与雲齊。",
            "人從別浦經年去，天向平蕪盡處低。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 118
    },
    {
        "title": "洛濱病臥戶部李侍郎見惠药物謔以文星之句斐然仰謝",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "隱幾支頤對落暉，故人书信到柴扉。",
            "周南留滯商山老，星象如今屬少微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 119
    },
    {
        "title": "故洛城古牆",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "粉落椒飛知幾春，风吹雨灑旋成塵。",
            "莫言一片危基在，犹過无窮來往人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 120
    },
    {
        "title": "句",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "湖上收宿雨。",
            "故國思如此，若為天外心。",
            "東屯滄海闊，南讓洞庭寬。",
            "翠粒照晴露。。",
            "銀花垂院榜，翠羽撼絛鈴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十五",
        "no#": 121
    }
]