[
    {
        "title": "旅泊吳門",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "一舸吳江晚，堪憂病廣文。鱸魚谁与伴，鸥鳥自成群。",
            "反照縱橫水，斜空斷续雲。異鄉无限思，盡付酒醺醺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 1
    },
    {
        "title": "賁中間有吳門旅泊之什蒙魯望垂和更作一章以伸酬謝",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "偶發陶匏響，皆蒙組繡文。清秋将落帽，子夏正離群。",
            "有恨书燕雁，无聊賦郢雲。遍看心自醉，不是酒能醺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 2
    },
    {
        "title": "酬襲美先見寄倒來韵",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "尋疑天意喪斯文，故選茅峰寄白雲。酒後只留滄海客，",
            "為有此身犹苦患，不知何者是玄纁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 3
    },
    {
        "title": "奉和襲美醉中即席見贈次韵",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "桂枝新下月中仙，學海詞鋒譽藹然。文陣已推忠信甲，",
            "共许逢蒙快弓箭，再穿楊葉在明年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 4
    },
    {
        "title": "奉和襲美題褚家林亭",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "疏野林亭震澤西，朗吟闲步喜相攜。时时风折蘆花乱，",
            "今朝偶得高阳伴，從放山翁醉似泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 5
    },
    {
        "title": "奉和襲美傷開元觀顧道士",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "鳳麟膠盡夜如何，共歎先生劍解多。幾度吊來唯白鶴，",
            "惆悵真靈又空返，玉书谁授紫微歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 6
    },
    {
        "title": "和魯望白菊",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "雪彩冰姿號女華，寄身多是地仙家。有时南國和霜立，",
            "自知終古清香在，更出梅妝弄晚霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 7
    },
    {
        "title": "奉和襲美先輩悼鶴",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "池塘蕭索掩空籠，玉樹同嗟一土中。莎徑罷鳴唯泣露，",
            "雲減霧消无處问，只留華发与衰翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 8
    },
    {
        "title": "偶約道流終乖文會答皮陸",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "仙侶无何訪蔡經，两煩韶濩出彤庭。",
            "人間若有登樓望，應怪文星近客星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 9
    },
    {
        "title": "和襲美寒夜見訪",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "雲孤鶴独且相親，仿效從它折角巾。",
            "不用吳江歎留滯，风姿俱是玉清人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 10
    },
    {
        "title": "和襲美醉中先起次韵",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "何事桃源路忽迷，惟留雲雨怨空閨。",
            "仙郎共许多情調，莫遣重歌濁水泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 11
    },
    {
        "title": "和皮陸酒病偶作",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "白編椰席鏤冰明，應助楊青解宿酲。",
            "難繼二賢金玉唱，可怜空作斷猿聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 12
    },
    {
        "title": "送浙東德師侍禦罷府西归",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "孤雲独鳥本无依，江海重逢故舊稀。",
            "楊柳漸疏蘆葦白，可怜斜日送君归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 13
    },
    {
        "title": "以青z3飯分送襲美魯望因成一絕",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "谁屑瓊瑤事青z3，舊傳名品出華阳。",
            "應宜仙子胡麻拌，因送劉郎与阮郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 14
    },
    {
        "title": "玩金鸂鶒和陸魯望",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "翠羽紅襟鏤彩雲，雙飛常笑白鸥群。",
            "谁怜化作雕金質，從倩沉檀十裏闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 15
    },
    {
        "title": "悼鶴和襲美",
        "author": "张賁",
        "biography": "",
        "paragraphs": [
            "渥頂鮮毛品格馴，莎庭闲暇重難群。",
            "无端日暮東风起，飄散春空一片雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 16
    },
    {
        "title": "覽皮先輩盛制，因作十韵以寄，用伸款仰",
        "author": "崔璐",
        "biography": "",
        "paragraphs": [
            "河嶽挺靈異，星辰精氣殊。在人為英傑，与國作禎符。",
            "襄阳得奇士，俊邁真龍駒。勇果魯仲由，文賦蜀相如。",
            "渾浩江海廣，葩華桃李敷。小言入无間，大言塞空虛。",
            "幾人游赤水，夫子得玄珠。鬼神爭奧秘，天地惜洪爐。",
            "既有曾參行，仍兼君子儒。吾知上帝意，将使居黃樞。",
            "好保千金體，須為万姓謨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 17
    },
    {
        "title": "浙東罷府西归酬別张廣文皮先輩陸秀才",
        "author": "李縠",
        "biography": "",
        "paragraphs": [
            "豈有頭风筆下痊，浪成蠻语向初筵。蘭亭舊趾雖曾見，",
            "相逢只恨相知晚，一曲驪歌又幾年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 18
    },
    {
        "title": "和皮日休悼鶴",
        "author": "李縠",
        "biography": "",
        "paragraphs": [
            "才子襟期本上清，陸雲家鶴伴闲情。犹怜反顧五六裏，",
            "人間華表堪留语，剩向秋风寄一聲。",
            "道林曾放雪翎飛，應悔庭除閉羽衣。",
            "料得王恭披鶴氅，倚吟犹待月中归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 19
    },
    {
        "title": "醉中襲美先月中归",
        "author": "李縠",
        "biography": "",
        "paragraphs": [
            "休文雖即逃瓊液，阿鶩還須掩玉閨。",
            "月落金雞一聲後，不知谁悔醉如泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 20
    },
    {
        "title": "奉酬皮先輩霜菊見贈",
        "author": "崔璞",
        "biography": "",
        "paragraphs": [
            "菊花開晚過秋风，闻道芳香正滿叢。",
            "爭奈病夫難強飲，應須速自召車公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 21
    },
    {
        "title": "蒙恩除替将還京洛偶敘所懷因成六韵呈军事院諸公郡中一二秀才",
        "author": "崔璞",
        "biography": "",
        "paragraphs": [
            "两载求人瘼，三春受代归。務繁多簿籍，才短乏恩威。",
            "共理乖天獎，分憂值歲饑。遽蒙交郡印，安敢整朝衣。",
            "作牧慚為政，思鄉念式微。儻容還故里，高臥掩柴扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 22
    },
    {
        "title": "和皮日休悼鶴",
        "author": "魏樸",
        "biography": "",
        "paragraphs": [
            "直欲裁诗问杳冥，豈教靈化亦浮生。风林月動疑留魄，",
            "人間飛去犹堪恨，況是泉台遠玉京。",
            "經秋宋玉已悲傷，況報胎禽昨夜亡。",
            "霜曉起來无问處，伴僧彈指繞荷塘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 23
    },
    {
        "title": "皮襲美見留小宴次韵",
        "author": "羊昭业",
        "biography": "",
        "paragraphs": [
            "澤國春來少遇晴，有花開日且飛觥。王戎似電休推病，",
            "知君不肯然官燭，爭得華筵徹夜明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 24
    },
    {
        "title": "送羊振文归覲桂阳",
        "author": "顏萱",
        "biography": "",
        "paragraphs": [
            "高掛吳帆喜動容，问安归去指湘峰。懸魚庭內芝蘭秀，",
            "臨岐独有沾襟戀，南巷當年共化龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 25
    },
    {
        "title": "送圓载上人",
        "author": "顏萱",
        "biography": "",
        "paragraphs": [
            "師來一世恣經行，卻泛滄波问去程。心靜已能防渴鹿，",
            "料得還鄉无別利，只應先見日華生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 26
    },
    {
        "title": "過张祜處士丹阳故居",
        "author": "顏萱",
        "biography": "",
        "paragraphs": [
            "憶昔為兒逐我兄，曾拋竹馬拜先生。书齋已换當时主，",
            "柴扉草屋无人问，犹向荒田責地征。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 27
    },
    {
        "title": "和襲美傷顧道士",
        "author": "鄭璧",
        "biography": "",
        "paragraphs": [
            "斜漢銀瀾一夜東，飄飄何處五雲中。空留華表千年約，",
            "門人不睹飛升去，犹与浮生哭恨同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 28
    },
    {
        "title": "奉和陸魯望白菊",
        "author": "鄭璧",
        "biography": "",
        "paragraphs": [
            "白豔輕明帶露痕，始知佳色重難群。終朝疑笑梁王雪，",
            "瓊妃若會寬裁剪，堪作蟾宮夜舞裙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 29
    },
    {
        "title": "和襲美索友人酒",
        "author": "鄭璧",
        "biography": "",
        "paragraphs": [
            "乘興閑來小謝家，便裁诗句乞榴花。",
            "邴原雖不无端醉，也愛臨风從鹿車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 30
    },
    {
        "title": "文燕潤卿不至",
        "author": "鄭璧",
        "biography": "",
        "paragraphs": [
            "已知羽駕朝金闕，不用燒蘭望玉京。",
            "應是易遷明月好，玉皇留看舞雙成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十一",
        "no#": 31
    }
]