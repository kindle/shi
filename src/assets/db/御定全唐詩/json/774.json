[
    {
        "title": "題春夢秋归故里",
        "author": "吉師老",
        "biography": "",
        "paragraphs": [
            "故國归路賒，春晚在天涯。明月夜來夢，碧山秋到家。",
            "開窗闻落葉，遠墅見晴鴉。驚起曉庭際，鶯啼桃杏花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 1
    },
    {
        "title": "看蜀女轉昭君變",
        "author": "吉師老",
        "biography": "",
        "paragraphs": [
            "妖姬未著石榴裙，自道家連錦水濆。檀口解知千载事，",
            "说盡綺羅當日恨，昭君傳意向文君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 2
    },
    {
        "title": "放猿",
        "author": "吉師老",
        "biography": "",
        "paragraphs": [
            "放爾千山万水身，野泉晴樹好為鄰。",
            "啼时莫近瀟湘岸，明月孤舟有旅人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 3
    },
    {
        "title": "鴛鴦",
        "author": "吉師老",
        "biography": "",
        "paragraphs": [
            "江島濛濛煙靄微，綠蕪深處刷毛衣。",
            "渡頭驚起一雙去，飛上文君舊錦机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 4
    },
    {
        "title": "巫峽聽猿",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "巴江猿嘯苦，響入客舟中。孤枕破残夢，三聲隨曉风。",
            "連雲波澹澹，和霧雨濛濛。巫峽去家遠，不堪魂斷空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 5
    },
    {
        "title": "長安春贈友人",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "繁華堪泣帝城春，粉堞青樓勢礙雲。花對玉鉤簾外發，",
            "各有归程千万里，東风时節恨離群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 6
    },
    {
        "title": "塞上即事",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "身似星流跡似蓬，玉關孤望杳溟蒙。寒沙万里平鋪月，",
            "分明更想残宵夢，故國依然在甬東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 7
    },
    {
        "title": "宿山驛",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "文戰何堪功未圖，又驅羸馬指天衢。露華凝夜渚蓮盡，",
            "好同範蠡扁舟興，高掛一帆归五湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 8
    },
    {
        "title": "北邙山",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "北邙山草又青青，今日銷魂事可明。綠酒醉來春未歇，",
            "堪取金爐九還药，不能隨夢向浮生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 9
    },
    {
        "title": "秋塘曉望",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "鐘盡疏桐散曙鴉，故山煙樹隔天涯。",
            "西风一夜秋塘曉，零落幾多紅藕花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 10
    },
    {
        "title": "水樓感事",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "高柳螿啼雨後秋，年光空感淚如流。",
            "滿湖菱荇東归晚，閑倚南軒盡日愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 11
    },
    {
        "title": "泊舟",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "身逐煙波魂自驚，木蘭舟上一帆輕。",
            "雲中有寺在何處，山底宿时闻磬聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 12
    },
    {
        "title": "湘雲",
        "author": "吳商浩",
        "biography": "",
        "paragraphs": [
            "□滿湘江雲瑩空，紛紛長對水溶溶。",
            "日西遙望自归處，盡掛九疑千万峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 13
    },
    {
        "title": "秋閨",
        "author": "沈祖仙",
        "biography": "",
        "paragraphs": [
            "白馬三军客，青娥十载思。玉庭霜落夜，羅幌月明时。",
            "爐冷蜘蛛喜，燈高熠耀期。愁多不可曙，流涕坐空幃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 14
    },
    {
        "title": "秋閨",
        "author": "邵士彥",
        "biography": "",
        "paragraphs": [
            "斜日空庭暮，幽閨積恨盈。細风吹帳冷，微月度窗明。",
            "怨坐啼相续，愁眠夢不成。調琴欲有弄，畏作斷腸聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 15
    },
    {
        "title": "擣衣",
        "author": "吳大江",
        "biography": "",
        "paragraphs": [
            "沙塞秋應晚，金閨恨已空。那堪裂紈素，时许出房櫳。",
            "杵影弄寒月，砧聲調夜风。裁縫雙淚盡，万里寄雲中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 16
    },
    {
        "title": "題慈恩塔",
        "author": "荊叔",
        "biography": "",
        "paragraphs": [
            "漢國山河在，秦陵草樹深。暮雲千里色，无處不傷心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 17
    },
    {
        "title": "三湘有懷",
        "author": "蕭靜",
        "biography": "",
        "paragraphs": [
            "柳絮飛來別洛阳，梅花落後到三湘。",
            "世情已逐浮雲散，離恨空隨江水長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 18
    },
    {
        "title": "九日對酒",
        "author": "元凜",
        "biography": "",
        "paragraphs": [
            "嘉辰複遇登高台，良朋笑语傾金罍。煙攤秋色正堪玩，",
            "谁知靖節當时事，空學狂歌倒载回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 19
    },
    {
        "title": "中秋夜不見月",
        "author": "元凜",
        "biography": "",
        "paragraphs": [
            "蟾輪何事色全微，賺得佳人出繡幃。四野霧凝空寂寞，",
            "公子倚欄犹悵望，懶将紅燭草堂归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 20
    },
    {
        "title": "雷塘",
        "author": "徐振",
        "biography": "",
        "paragraphs": [
            "九重城闕悲涼盡，一聚園林怨恨長。花憶所為犹自笑，",
            "若问皇天惆悵事，只應斜日照雷塘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 21
    },
    {
        "title": "古意",
        "author": "徐振",
        "biography": "",
        "paragraphs": [
            "擾擾都城曉又昏，六街車馬五侯門。",
            "箕山渭水空明月，可是巢由絕子孫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 22
    },
    {
        "title": "寄人",
        "author": "张侹",
        "biography": "",
        "paragraphs": [
            "酷怜风月為多情，還到春时別恨生。",
            "倚柱尋思倍惆悵，一場春夢不分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 23
    },
    {
        "title": "武昌阻风",
        "author": "方澤",
        "biography": "",
        "paragraphs": [
            "江上春风留客舟，无窮归思滿東流。",
            "与君盡日閑臨水，貪看飛花忘卻愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 24
    },
    {
        "title": "秋夜宿淮口",
        "author": "景池",
        "biography": "",
        "paragraphs": [
            "露白草犹青，淮舟倚岸停。风帆幾處客，天地两河星。",
            "樹靜禽眠草，沙寒鹿過汀。明朝谁結伴，直去泛滄溟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 25
    },
    {
        "title": "贈喬尊師",
        "author": "张鴻",
        "biography": "",
        "paragraphs": [
            "長忌时人识，有家雲澗深。性惟耽嗜酒，貧不破除琴。",
            "靜鼓三通齒，频湯一味參。知師最知我，相引坐檉阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 26
    },
    {
        "title": "村行",
        "author": "姚揆",
        "biography": "",
        "paragraphs": [
            "天淡雨初晴，遊人恨不勝。乱山啼蜀魄，孤棹宿巴陵。",
            "影暗村橋柳，光寒水寺燈。罷吟思故國，窗外有漁罾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 27
    },
    {
        "title": "潁川客舍",
        "author": "姚揆",
        "biography": "",
        "paragraphs": [
            "素琴孤劍尚闲遊，谁共芳尊話唱酬。鄉夢有时生枕上，",
            "回首帝京归未得，不堪吟倚夕阳樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 28
    },
    {
        "title": "独不見",
        "author": "王訓",
        "biography": "",
        "paragraphs": [
            "日晚宜春暮，风軟上林朝。對酒近初節，開樓蕩夜謠。",
            "石橋通小澗，竹路上青霄。持底谁見许，長愁成細腰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 29
    },
    {
        "title": "归去來引",
        "author": "张熾",
        "biography": "",
        "paragraphs": [
            "归去來，归期不可違。相見旋明月，浮雲共我归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 30
    },
    {
        "title": "結客少年場行",
        "author": "虞羽客",
        "biography": "",
        "paragraphs": [
            "幽並俠少年，金絡控連錢。竊符方救趙，擊築正懷燕。",
            "輕生辭鳳闕，揮袂上祁連。陸離橫寶劍，出沒騖征旃。",
            "蒙輪恒顧敵，超乘忽爭先。摧枯逾百戰，拓地遠三千。",
            "骨都魂已散，樓蘭首複傳。龍城含宿霧，瀚海接遙天。",
            "歌吹金微返，振旅玉門旋。烽火今已息，非複照甘泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 31
    },
    {
        "title": "塞上",
        "author": "鄭渥",
        "biography": "",
        "paragraphs": [
            "出門何處问西東，指画翻為语論同。到此客頭潛覺白，",
            "早晚回鞭複南去，大衣高蓋漢鄉风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 32
    },
    {
        "title": "洛阳道",
        "author": "鄭渥",
        "biography": "",
        "paragraphs": [
            "客亭門外路東西，多少喧騰事不齊。楊柳惹鞭公子醉，",
            "頃刻知音幾存歿，半回依約認輪蹄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十四",
        "no#": 33
    }
]