[
    {
        "title": "雨霽晚眺",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "入谷路縈紆，岩巔日欲晡。嶺雲寒掃蓋，溪雪凍黏須。",
            "臥草跧如兔，聽冰怯似狐。仍闻關外火，昨夜徹皇都。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 1
    },
    {
        "title": "立春日作",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "九重天子去蒙塵，禦柳无情依舊春。",
            "今日不關妃妾事，始知辜負馬嵬人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 2
    },
    {
        "title": "贈雲阳裴明府",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "南北三年一解攜，海為深谷岸為蹊。已闻陳勝心降漢，",
            "归來能作煙波伴，我有魚舟在五溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 3
    },
    {
        "title": "賊中与蕭韋二秀才同臥重疾二君尋愈…因有題",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "与君同臥疾，独我漸彌留。弟妹不知处，兵戈殊未休。",
            "胸中疑晉豎，耳下鬥殷牛。縱有秦醫在，懷鄉亦淚流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 4
    },
    {
        "title": "重圍中逢蕭校书",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "相逢俱此地，此地是何鄉。側目不成语，撫心空自傷。",
            "劍高无鳥度，樹暗有兵藏。底事征西将，年年戍洛阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 5
    },
    {
        "title": "咸通",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "咸通时代物情奢，歡殺金张许史家。破產競留天上樂，",
            "人意似知今日事，急催弦管送年華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 6
    },
    {
        "title": "白櫻桃",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "王母階前種幾株，水精簾外看如无。",
            "只應漢武金盤上，瀉得珊珊白露珠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 7
    },
    {
        "title": "夜景",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "滿庭松桂雨餘天，宋玉秋聲韵蜀弦。烏兔不知多事世，",
            "欲把傷心问明月，素娥无语淚娟娟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 8
    },
    {
        "title": "宿山家",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "山行侵夜到，雲竇一星燈。草動蛇尋穴，枝搖鼠上藤。",
            "背风開药灶，向月展漁罾。明日前溪路，煙蘿更幾層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 9
    },
    {
        "title": "長年",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "長年方悟少年非，人道新诗勝舊诗。十畝野塘留客釣，",
            "大盜不将爐冶去，有心重築太平基。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 10
    },
    {
        "title": "辛醜年",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "九衢漂杵已成川，塞上黃雲戰馬閑。但有羸兵填渭水，",
            "西望翠華殊未返，淚痕空濕劍文斑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 11
    },
    {
        "title": "思归",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "暖絲无力自悠揚，牽引東风斷客腸。外地見花終寂寞，",
            "舊裏若為归去好，子期凋謝呂安亡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 12
    },
    {
        "title": "憶昔",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "昔年曾向五陵游，子夜歌清月滿樓。銀燭樹前長似晝，",
            "今日乱離俱是夢，夕阳唯見水東流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 13
    },
    {
        "title": "合歡蓮花",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "虞舜南巡去不归，二妃相誓死江湄。",
            "空留万古香魂在，結作雙葩合一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 14
    },
    {
        "title": "覽蕭必先卷",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "滿軸編新句，翛然大雅风。名因五字得，命合一言通。",
            "景盡才難盡，吟終意未終。似逢曹与謝，煙雨思何窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 15
    },
    {
        "title": "和人歲宴旅舍見寄",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "積雪滿前除，寒光夜皎如。老憂新歲近，貧觉故交疏。",
            "意合論文后，心降得句初。莫言常鬱鬱，天道有盈虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 16
    },
    {
        "title": "宿泊孟津寄三堂友人",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "解纜西征未有期，槐花又逼桂花时。鴻臚陌上归耕晚，",
            "分明昨夜南池夢，還把漁竿詠楚詞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 17
    },
    {
        "title": "对酒賦友人",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "多病仍多感，君心自我心。浮生都是夢，浩歎不如吟。",
            "白雪篇篇麗，清酤盞盞深。乱離俱老大，強醉莫沾襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 18
    },
    {
        "title": "天井關",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "太行山上雲深处，谁向雲中築女牆。短綆詎能垂玉甃，",
            "守吏不教飛鳥過，赤眉何路到吾鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 19
    },
    {
        "title": "贈邊将",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "昔因征遠向金微，馬出榆關一鳥飛。万里只攜孤劍去，",
            "只待煙塵報天子，滿頭霜雪為兵机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 20
    },
    {
        "title": "春日",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "忽觉東风景漸迟，野梅山杏暗芳菲。落星樓上吹残角，",
            "紅塵遮斷長安陌，芳草王孫暮不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 21
    },
    {
        "title": "早秋夜作",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "翠簟初清暑半銷，撇簾松韵送輕飆。莎庭露永琴书潤，",
            "不須更作悲秋賦，王粲辭家鬢已凋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 22
    },
    {
        "title": "寄江南逐客",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "二年音信阻湘潭，花下相思酒半酣。",
            "記得竹齋风雨夜，对床孤枕話江南。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 23
    },
    {
        "title": "冬夜",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "睡觉寒爐酒半消，客情鄉夢两遙遙。",
            "无人為我磨心劍，割斷愁腸一寸苗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 24
    },
    {
        "title": "又闻湖南荊渚相次陷沒",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "幾时闻唱凱旋歌，处处屯兵未倒戈。天子只凭紅旆壯，",
            "莫问流離南越事，戰餘空有舊山河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 25
    },
    {
        "title": "家叔南游卻归因獻賀",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "繚繞江南一歲归，归來行色滿戎衣。長闻鳳詔徵兵急，",
            "遙知倚棹思家处，澤國煙深暮雨微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 26
    },
    {
        "title": "楚行吟",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "章華台下草如煙，故郢城頭月似弦。",
            "惆悵楚宮雲雨后，露啼花笑一年年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 27
    },
    {
        "title": "洛阳吟",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "万戶千門夕照邊，開元时節舊风煙。宮官試馬遊三市，",
            "如今父老偏垂淚，不見承平四十年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 28
    },
    {
        "title": "過舊宅",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "華軒不見馬蕭蕭，廷尉門人久寂寥。朱檻翠樓為蔔肆，",
            "莫问此中銷歇寺，娟娟紅淚滴芭蕉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 29
    },
    {
        "title": "喻東军",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "四年龍馭守峨嵋，鐵馬西來步步迟。五运未教移漢鼎，",
            "独把一樽和淚酒，隔雲遙奠武侯祠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 30
    },
    {
        "title": "清河縣樓作",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "有客微吟独凭樓，碧雲紅樹不勝愁。盤雕迥印天心沒，",
            "故人此地揚帆去，何处相思雪滿頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 31
    },
    {
        "title": "北原閑眺",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "春城回首樹重重，立馬平原夕照中。五鳳灰残金翠滅，",
            "欲问向來陵谷事，野桃无语淚花紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 32
    },
    {
        "title": "贈戍兵",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "漢皇无事暫遊汾，底事狐狸嘯作群。夜指碧天占晉分，",
            "止竟有征須有戰，洛阳何用久屯军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 33
    },
    {
        "title": "睹军回戈",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "關中群盜已心離，關外犹闻羽檄飛。御苑綠莎嘶戰馬，",
            "昨日屯军還夜遁，滿車空载洛神归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 34
    },
    {
        "title": "中渡晚眺",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "魏王堤畔草如煙，有客傷时独扣舷。妖气欲昏唐社稷，",
            "家寄杜陵归不得，一回回首一潸然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 35
    },
    {
        "title": "河內別村业閑題",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "阮氏清风竹巷深，滿溪松竹似山阴。門當谷路多樵客，",
            "鄰翁莫问傷时事，一曲高歌夕照沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 36
    },
    {
        "title": "闻官军繼至未睹凱旋",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "嫖姚何日破重圍，秋草深來戰馬肥。已有孔明傳将略，",
            "何事小臣偏注目，帝鄉遙羨白雲归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 37
    },
    {
        "title": "和集賢侯學士分司丁侍禦秋日雨霽之作",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "洛岸秋晴夕照長，鳳樓龍闕倚清光。玉泉山淨雲初散，",
            "多慚十载游梁士，卻伴賓鴻入帝鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 38
    },
    {
        "title": "題安定张使君",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "器度风標合出塵，桂宮何負一枝新。成丹始見金无滓，",
            "中興若繼開元事，堪向龍池作近臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 39
    },
    {
        "title": "潁阳縣",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "琴堂連少室，故事即仙蹤。樹老风聲壯，山高臘候濃。",
            "雪多庭有鹿，縣僻寺无鐘。何处留诗客，茆簷倚后峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 40
    },
    {
        "title": "寄園林主人",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "主人常不在，春物為谁開。桃豔紅将落，梨華雪又摧。",
            "曉鶯閑自囀，遊客暮空回。尚有餘芳在，犹堪载酒來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 41
    },
    {
        "title": "洛北村居",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "十畝松篁百畝田，归來方屬大兵年。岩邊石室低臨水，",
            "无人说得中興事，独倚斜暉憶仲宣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 42
    },
    {
        "title": "对梨花贈皇甫秀才",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "林上梨花雪壓枝，独攀瓊豔不勝悲。依前此地逢君处，",
            "騰騰戰鼓正多事，須信明朝難重持。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 43
    },
    {
        "title": "立春",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "青帝東來日馭迟，暖煙輕逐曉风吹。罽袍公子樽前觉，",
            "殷勤為作宜春曲，題向花箋帖繡楣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 44
    },
    {
        "title": "村笛",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "簫韶九奏韵淒鏘，曲度雖高調不傷。",
            "卻見孤村明月夜，一聲牛笛斷人腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 45
    },
    {
        "title": "題李斯傳",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "蜀魄湘魂万古悲，未悲秦相死秦时。",
            "臨刑莫恨倉中鼠，上蔡東門去自迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 46
    },
    {
        "title": "贈薛秀才",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "相辭因避世，相見尚兵戈。乱后故人少，別來新話多。",
            "但闻哀痛詔，未睹凱旋歌。欲結岩棲伴，何山好薜蘿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 47
    },
    {
        "title": "和元秀才別业书事",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "僻居春事好，水曲乱花阴。浪過河移岸，雛成鳥別林。",
            "綠錢榆貫重，紅障杏籬深。莫飲宜城酒，愁多醉易沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 48
    },
    {
        "title": "紀村事",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "綠蔓映雙扉，循牆一徑微。雨多庭果爛，稻熟渚禽肥。",
            "釀酒迎新社，遙砧送暮暉。数聲牛上笛，何处餉田归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 49
    },
    {
        "title": "題许仙師院",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "地古多喬木，遊人到且吟。院開金鎖澀，門映綠篁深。",
            "山色不離眼，鶴聲長在琴。往來谁与熟，乳鹿住前林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 50
    },
    {
        "title": "離筵訴酒",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "感君情重惜分離，送我殷勤酒滿卮。",
            "不是不能判酩酊，卻憂前路酒醒时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 51
    },
    {
        "title": "不寐",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "不寐天将曉，心勞轉似灰。蚊吟频到耳，鼠鬥競緣台。",
            "戶闇知蟾落，林喧觉雨來。馬嘶朝客過，知是禁門開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 52
    },
    {
        "title": "贈武处士",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "一身唯一室，高靜若僧家。掃地留疏影，穿池浸落霞。",
            "綠蘿臨水合，白道向村斜。賣药归來醉，吟诗倚釣查。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 53
    },
    {
        "title": "題吉澗盧拾遺莊",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "主人西游去不归，滿溪春雨長春薇。",
            "怪來馬上诗情好，印破青山白鹭飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 54
    },
    {
        "title": "題潁源廟",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "曾是巢由棲隱地，百川唯说潁源清。微波乍向雲根吐，",
            "臨川試问堯年事，犹被封人勸濯纓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 55
    },
    {
        "title": "東遊遠归",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "扣角幹名计已疏，劍歌休恨食无魚。辭家柳絮三春半，",
            "青雲不识楊生面，天子何由问子虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 56
    },
    {
        "title": "新正日商南道中作寄李明府",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "相看又見歲華新，依舊楊朱拭淚巾。踏雪偶因尋戴客，",
            "今日与君同避世，卻怜无事是家貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 57
    },
    {
        "title": "春暮",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "一春春事好，病酒起常迟。流水綠縈砌，落花紅墮枝。",
            "樓高喧乳燕，樹密鬥雛鸝。不學山公醉，将何自解頤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 58
    },
    {
        "title": "哭麻处士",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "卻到歌吟地，閑門草色中。百年流水盡，万事落花空。",
            "繐帳扃秋月，诗樓鎖夜蟲。少微何处墮，留恨白楊风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 59
    },
    {
        "title": "春早",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "闻鶯才觉曉，閉戶已知晴。一帶窗間月，斜穿枕上生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 60
    },
    {
        "title": "和友人",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "閉門同隱士，不出動經时。靜閱王維画，閑翻褚胤棋。",
            "落泉當戶急，残月下窗迟。卻想從來意，譙周亦自嗤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 61
    },
    {
        "title": "春愁",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "寓思本多傷，逢春恨更長。露沾湘竹淚，花墮越梅妝。",
            "睡怯交加夢，閑傾瀲灩觴。后庭人不到，斜月上松篁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 62
    },
    {
        "title": "晚春",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "花開疑乍富，花落似初貧。万物不如酒，四时唯愛春。",
            "峨峨秦氏髻，皎皎洛川神。风月應相笑，年年醉病身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 63
    },
    {
        "title": "題许渾诗卷",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "江南才子许渾诗，字字清新句句奇。",
            "十斛明珠量不盡，惠休虛作碧雲詞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 64
    },
    {
        "title": "贈禮佛名者",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "何用辛勤禮佛名，我從无得到真庭。",
            "尋思六祖傳心印，可是從來讀藏經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 65
    },
    {
        "title": "残花",
        "author": "韋莊",
        "biography": "",
        "paragraphs": [
            "和煙和露雪離披，金蕊紅須尚滿枝。",
            "十日笙歌一宵夢，苧蘿因雨失西施。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十六",
        "no#": 66
    }
]