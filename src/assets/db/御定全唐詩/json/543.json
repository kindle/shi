[
    {
        "title": "贈李商隱",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "羽翼恣摶扶，山河使筆驅。月疏吟夜桂，龍失詠春珠。",
            "草細盤金勒，花繁倒玉壺。徒嗟好章句，无力致前途。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 1
    },
    {
        "title": "元日即事",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "斂板賀交親，稱觴詎有巡。年光悲擲舊，景色喜呈新。",
            "水柳煙中重，山梅雪后真。不知将白发，何以度青春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 2
    },
    {
        "title": "送賈島往金州謁姚員外",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "山光与水色，独往此中深。溪瀝椒花气，岩盤漆葉阴。",
            "瀟湘終共去，巫峽羨先尋。幾夕江樓月，玄暉伴靜吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 3
    },
    {
        "title": "送友人罷舉归蜀",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "憔悴滿衣塵，风光豈屬身。賣琴紅粟貴，看鏡白髭新。",
            "棧畔谁高步，巴邊自问津。淒然莫滴血，杜宇正哀春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 4
    },
    {
        "title": "送衛尉之延陵",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "草木正花时，交親觸雨辭。一官之任遠，盡室出城迟。",
            "乳滴茅君洞，鴉鳴季子祠。想知佐理暇，日有詠懷诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 5
    },
    {
        "title": "送越州高錄事",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "官曹權紀綱，行李半舟航。浦漵潮來廣，川源鳥去長。",
            "筍成稽嶺岸，蓮發鏡湖香。澤國還之任，鱸魚浪得嘗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 6
    },
    {
        "title": "送潘咸",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "时时齎破囊，訪我息閑坊。煮雪问茶味，當风看雁行。",
            "心齊山鹿逸，句敵柳花狂。堅苦今如此，前程豈渺茫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 7
    },
    {
        "title": "送友人下第归甯",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "紫閣雪未盡，杏園花亦寒。灞西辭舊友，楚外憶新安。",
            "細雨猿啼枿，微阳鹭起灘。旋應赴秋貢，詎得久承歡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 8
    },
    {
        "title": "遊北山寺",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "煙岡影畔寺，游步此时孤。庭靜眾药在，鶴閑雙檜枯。",
            "藍峰露秋院，灞水入春廚。便可棲心跡，如何返舊途。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 9
    },
    {
        "title": "冬日題无可上人院",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "入戶道心生，茶間踏葉行。瀉风瓶水澀，承露鶴巢輕。",
            "閣北長河气，窗東一檜聲。诗言与禪味，语默此皆清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 10
    },
    {
        "title": "遊雲際寺",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "澗壑吼风雷，香門絕頂開。閣寒僧不下，鐘定虎常來。",
            "鳥啄林稍果，鼯跳竹裏苔。心源无一事，塵界擬休回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 11
    },
    {
        "title": "題翠微寺",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "沿溪又涉巔，始喜入前軒。鐘度鳥沈壑，殿扃雲濕幡。",
            "涼泉墮眾石，古木徹疏猿。月上僧階近，斯游豈易言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 12
    },
    {
        "title": "廣德官舍二松",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "楊公休簿領，二木日堅牢。直甚彰吾節，清終庇爾曹。",
            "幽阴月裏細，冷樹雪中高。谁見幹霄后，枝飄白鶴毛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 13
    },
    {
        "title": "浴馬",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "解控複收鞭，長津動細漣。空蹄沈綠玉，闊臆沒連錢。",
            "沫漩橋聲下，嘶盤柳影邊。常闻稟龍性，固与白波便。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 14
    },
    {
        "title": "和段學士南亭春日对雨",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "晨飛晚未休，蘭閣客吟愁。蕭颯柳邊掛，縈紆花底流。",
            "聲繁乍離籟，灑急不成漚。經夕江湖思，煙波一釣舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 15
    },
    {
        "title": "书懷",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "只是守琴书，僧中独寓居。心唯務鶴靜，分合与名疏。",
            "暮雨啼螿次，涼风落木初。家山太湖淥，归去複何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 16
    },
    {
        "title": "一公房",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "幽深谁掩關，清淨自多閑。一雨收眾木，孤雲生遠山。",
            "花萎綠苔上，鴿乳翠樓間。嵐靄燃香夕，容聽半偈還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 17
    },
    {
        "title": "晚次臨涇",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "路入犬羊群，城寒雉堞曛。居人只尚武，過客謾投文。",
            "馬怯奔渾水，雕沈莽蒼雲。沙田積蒿艾，竟夕見燒焚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 18
    },
    {
        "title": "王母祠前写望",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "雲霞千古事，桃李舊花顏。芳信沈青鳥，空祠掩暮山。",
            "香傳一座暗，柳匝万家閑。那複傷神所，河昏落日間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 19
    },
    {
        "title": "遊暖泉精舍",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "塢木殿前空，山河澤國同。鳥閑沙影上，泉落樹阴中。",
            "纜舸蒲花水，縈幡柳絮风。翛然方寸地，何事更悲蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 20
    },
    {
        "title": "懷鄉",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "秋风江上家，釣艇泊蘆花。斷岸綠楊蔭，疏籬紅槿遮。",
            "鼉鳴積雨窟，鶴步夕阳沙。抱疾僧窗夜，归心過月斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 21
    },
    {
        "title": "岫禪師南溪蘭若",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "錫影配瓶光，孤溪照草堂。水懸青石磴，鐘動白雲床。",
            "樹色含残雨，河流帶夕阳。唯應无月夜，瞑目見他方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 22
    },
    {
        "title": "龍翔寺寄李频",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "鐘聲南北寺，不道往來遙。人事因循過，时光荏苒銷。",
            "懸燈灑砌雨，上閣繞雲雕。即是洲中柳，嘶蟬急暮條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 23
    },
    {
        "title": "送武瑴之邠甯",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "戍路少人蹤，邊煙淡複濃。诗寧写別恨，酒不上離容。",
            "燕拂沙河柳，鴉高石窟鐘。悠然一暌阻，山疊虜雲重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 24
    },
    {
        "title": "夏日題岫禪師房",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "朝朝聲磬罷，章子掃藤阴。花過少遊客，日長无事心。",
            "回山閉院直，落水下橋深。安得開方便，容身老此林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 25
    },
    {
        "title": "夏日因懷阳羨舊游寄裴书記",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "落日太湖西，波涵万象低。藕花熏浦漵，菱蔓匿鳧鷖。",
            "樹及長橋盡，灘回七裏迷。還應坐籌暇，时一夢荊溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 26
    },
    {
        "title": "呈薛博士",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "辛勤長在學，一室少曾開。时憶暮山寺，独登衰草台。",
            "名期五字立，跡愧九年來。此意今聊写，還希君子哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 27
    },
    {
        "title": "即事",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "抱杖立溪口，迎秋看塞門。連山互蒼翠，二水各清渾。",
            "笛發孤煙戍，鴉归夕照村。萋萋芳草色，終是憶王孫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 28
    },
    {
        "title": "龍翔寺閣夜懷渭南张少府",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "春城帶病別，秋塞見除书。況是神仙吏，仍非塵土居。",
            "河风吹鳥迥，嶽雨滴桐疏。坐閣馳思夕，沙東涼月虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 29
    },
    {
        "title": "夏日龍翔寺居即事寄崔侍禦",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "古刹一幡斜，吹門水過沙。数聲鐘裏飯，雙影樹間茶。",
            "落日窮荒雨，微风古塹花。何當戴豸客，複此问生涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 30
    },
    {
        "title": "龍翔寺居喜胡權見訪因宿",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "林棲无異歡，煮茗就花欄。雀啅北岡曉，僧開西閣寒。",
            "沖橋二水急，扣月一鐘残。明發還分手，徒悲行路難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 31
    },
    {
        "title": "宿石窟寺",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "一刹古岡南，孤鐘撼夕嵐。客閑明月閣，僧閉白雲庵。",
            "野鶴立枯枿，天龍吟淨潭。因知不生理，合自此中探。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 32
    },
    {
        "title": "夏日龍翔寺寄张侍禦",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "沙西林杪寺，殿倚石棱開。曉月僧汲井，残阳鐘殷台。",
            "河沖綠野去，鳥背白雲來。日夕唯增思，京關未想回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 33
    },
    {
        "title": "秋日将归長安留別王尚书",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "朔漠正秋霖，西风傳夕砧。滄洲未归跡，華发受恩心。",
            "露色岡莎冷，蟬聲塢木深。清晨鈇鉞內，只獻白雲吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 34
    },
    {
        "title": "龍翔寺言懷",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "眠雲喜道存，讀易過朝昏。喬木青連郭，長河白瀉門。",
            "鐘沈残月塢，鳥去夕阳村。搜此成閑句，期逢作者論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 35
    },
    {
        "title": "龍翔寺居夏日寄獻王尚书",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "那期高旆下，得遇重臣知。泉石容居止，风沙免路岐。",
            "河兼落下望，句入大荒思。无複愁煩暑，回山翠閣危。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 36
    },
    {
        "title": "題弘濟寺不出院僧",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "楚鞋應此世，只繞砌苔休。色相栽花視，身心坐石修。",
            "聲寒通節院，城黑見烽樓。欲取閑雲並，閑雲有去留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 37
    },
    {
        "title": "寄劉錄事",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "城西青島寺，累夏漱寒泉。今在提綱所，應難掃石眠。",
            "风沙榆塞迥，波浪橘洲偏。重整瀟湘棹，心期更幾年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 38
    },
    {
        "title": "酬王檀見寄",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "馳心棲杳冥，何物比清泠。夜月照巫峽，秋风吹洞庭。",
            "酬難塵鬢皓，坐久壁燈青。竟晚蒼山詠，喬枝有鶴聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 39
    },
    {
        "title": "寺居秋日对雨有懷",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "修修復雭雭，黃葉此时飛。隱幾客吟斷，鄰房僧話稀。",
            "鴿寒棲樹定，螢濕在窗微。即事瀟湘渚，漁翁披草衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 40
    },
    {
        "title": "答劉錄事夜月懷湘西友人見寄",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "相逢仍朔漠，相问即波濤。江思葦花折，笛聲關月高。",
            "簿书君閱倦，章句我吟勞。竟夕空凭閣，長河漴石壕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 41
    },
    {
        "title": "上高侍禦",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "舊隱白雲峰，生涯落葉同。關河一棲旅，楊柳十東风。",
            "跡处龍鍾內，聲居汩沒中。酬恩若有地，寧止殺微躬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 42
    },
    {
        "title": "冬日寄友人",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "空為梁甫吟，谁竟是知音。风雪坐閑夜，鄉園來舊心。",
            "滄江孤棹迥，落日一鐘深。君子久忘我，此誠甘自沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 43
    },
    {
        "title": "冬夜宿餘正字靜恭裏闲居",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "每來多便宿，不負白雲言。古木朔风動，寒城疏雪翻。",
            "微燈懸刻漏，舊夢返湘沅。先是琴邊起，知為閣務繁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 44
    },
    {
        "title": "得子侄书",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "遠书來阮巷，闕下見江東。不得經史力，枉拋耕稼功。",
            "雁天霞腳雨，漁夜葦條风。无複琴杯興，開懷向爾同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 45
    },
    {
        "title": "獻知己",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "亦忝受恩身，當殊投刺新。竟蒙分玉石，終不離埃塵。",
            "大谷非无暖，幽枝自未春。昏昏過朝夕，應念苦吟人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 46
    },
    {
        "title": "贈张濆处士",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "露白覆棋宵，林青讀易朝。道高天子问，名重四方招。",
            "许鶴归華頂，期僧過石橋。雖然在京國，心跡自逍遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 47
    },
    {
        "title": "早秋寺居酬张侍禦六韵見寄",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "六十上清冥，曉緘東越藤。山光紫衣陟，寺影白雲凝。",
            "濕葉起寒鳥，深林驚古僧。微风窗靜展，細雨閣吟登。",
            "清韵嶽磬遠，佳音湖水澄。卻思前所獻，何以豸冠稱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 48
    },
    {
        "title": "和段學士对雪",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "盈尺知豐稔，開窗对酒壺。飄當大野匝，灑到急流无。",
            "密際西风盡，凝間朔气扶。幹摧鳥棲枿，冷射夜残壚。",
            "贊月登斜漢，兼沙攪北湖。慚於郢客坐，一此調巴歈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 49
    },
    {
        "title": "監試夜雨滴空階",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "霎霎複淒淒，飄松又灑槐。气蒙蛛網檻，聲疊蘚花階。",
            "古壁青燈動，深庭濕葉埋。徐垂舊鴛瓦，競曆小茅齋。",
            "冷与阴蟲間，清将玉漏諧。病身唯輾轉，谁見此时懷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 50
    },
    {
        "title": "春雨如膏",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "冪冪斂輕塵，濛濛濕野春。細光添柳重，幽點濺花勻。",
            "慘澹遊絲景，阴沈落絮辰。回低飛蝶翅，寒滴语禽身。",
            "灑嶽摧餘雪，吹江疊遠蘋。東城与西陌，晴后趣何新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 51
    },
    {
        "title": "送友人南中訪舊知",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "春盡大方遊，思君便白頭。地蒸川有毒，天暖樹无秋。",
            "水急三巴險，猿分五嶺愁。為緣知己分，南國必淹留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 52
    },
    {
        "title": "玄都觀李尊師",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "蘚幘翠髯公，存思古觀空。曉壇檉葉露，晴圃柳花风。",
            "壽已将椿並，棋難見局終。何當与高鶴，飛去海光中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 53
    },
    {
        "title": "送石賁归吳興",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "同志幸同年，高堂君独還。齊榮恩未報，共隱事皆閑。",
            "訪寺臨河岸，開樓見海山。洛中推二陸，莫久戀鄉關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 54
    },
    {
        "title": "感遇",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "江鄉十年別，京國累日同。在客幾多事，俱付酒杯中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 55
    },
    {
        "title": "晚思",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "鶴下紫閣雲，沉沉翠微雨。独坐正无言，孤莊一聲杵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 56
    },
    {
        "title": "贈空禪師",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "虎見修行久，松知夏臘高。寒堂坐风雨，瞑目尚波濤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 57
    },
    {
        "title": "西山寒日逢韋侍禦",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "獬豸霜中貌，龍鍾病后顏。慘傷此身事，风雪動江山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 58
    },
    {
        "title": "題禪院",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "无花地亦香，有鶴松多直。向此奚必孤，山僧盡相识。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 59
    },
    {
        "title": "驚秋",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "鶯囀才間關，蟬鳴旋蕭屑。如何两鬢毛，不作千枝雪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 60
    },
    {
        "title": "經劉校书墓",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "遠塚松回曲渚风，一官闻是校书終。",
            "霜情月思今何在，零落人間策子中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 61
    },
    {
        "title": "蔣处士宅喜閑公至",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "絕杯夏別螺江渡，單缽春過处士齋。",
            "嘗茗議空經不夜，照花明月影侵階。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 62
    },
    {
        "title": "絕句",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "銀地无塵金菊開，紫梨紅枣墮莓苔。",
            "一泓秋水一輪月，今夜故人來不來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 63
    },
    {
        "title": "句",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "顏凋明鏡觉，思苦白雲知。",
            "滄洲迷釣隱，紫閣負僧期。。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十三",
        "no#": 64
    }
]