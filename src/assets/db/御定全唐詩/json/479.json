[
    {
        "title": "應制賀邊军支春衣",
        "author": "柳公權",
        "biography": "",
        "paragraphs": [
            "去歲雖无戰，今年未得归。皇恩何以報，春日得春衣。",
            "挾纊非真纊，分衣是假衣。從今貔武士，不憚戍金微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 1
    },
    {
        "title": "應制為宮嬪詠",
        "author": "柳公權",
        "biography": "",
        "paragraphs": [
            "不分前时忤主恩，已甘寂寞守長門。",
            "今朝卻得君王顧，重入椒房拭淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 2
    },
    {
        "title": "題朱審寺壁山水画",
        "author": "柳公權",
        "biography": "",
        "paragraphs": [
            "朱審偏能視夕嵐，洞邊深墨写秋潭。",
            "与君一顧西牆画，從此看山不向南。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 3
    },
    {
        "title": "閶門即事",
        "author": "柳公權",
        "biography": "",
        "paragraphs": [
            "耕夫占募逐樓船，春草青青万頃田。",
            "試上吳門看郡郭，清明幾处有新煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 4
    },
    {
        "title": "貢院樓北新栽小松",
        "author": "吳武陵",
        "biography": "",
        "paragraphs": [
            "拂檻愛貞容，移根自遠峰。已曾經草沒，終不任苔封。",
            "葉少初陵雪，鱗生欲化龍。乘春濯雨露，得地近垣墉。",
            "逐吹香微動，含煙色漸濃。时回日月照，為謝小山松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 5
    },
    {
        "title": "題路左佛堂",
        "author": "吳武陵",
        "biography": "",
        "paragraphs": [
            "雀兒來逐颺风高，下視鷹鸇意气豪。",
            "自謂能生千里翼，黃昏依舊委蓬蒿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 6
    },
    {
        "title": "盛山十二诗：隱月岫",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "初映鉤如線，終銜鏡似鉤。遠澄秋水色，高倚曉河流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 7
    },
    {
        "title": "盛山十二诗：流杯渠",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "激曲縈飛箭，浮溝泛滿卮。将來山太守，早向習家池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 8
    },
    {
        "title": "盛山十二诗：竹岩",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "不資冬日秀，為作暑天寒。先植誠非鳳，來翔定是鸞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 9
    },
    {
        "title": "盛山十二诗：繡衣石榻",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "巉巉雪中嶠，磊磊標方峭。勿為枕蒼山，還當礎清廟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 10
    },
    {
        "title": "盛山十二诗：宿雲亭",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "雨合飛危砌，天開卷曉窗。齊平聯郭柳，帶繞抱城江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 11
    },
    {
        "title": "盛山十二诗：梅溪",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "夾岸凝清素，交枝漾淺淪。味調方薦實，臘近又先春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 12
    },
    {
        "title": "盛山十二诗：桃塢",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "噴日舒紅景，通蹊茂綠阴。終期王母摘，不羨武陵深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 13
    },
    {
        "title": "盛山十二诗：胡盧沼",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "疏鑿徒為巧，圓窪自可澄。倒花紛錯秀，鑒月靜涵冰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 14
    },
    {
        "title": "盛山十二诗：茶嶺",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "顧渚吳商絕，蒙山蜀信稀。千叢因此始，含露紫英肥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 15
    },
    {
        "title": "盛山十二诗：磐石磴",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "繚繞緣雲上，璘玢甃玉聯。高高曾幾折，极目瞰秋鳶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 16
    },
    {
        "title": "盛山十二诗：琵琶台",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "褊地難層土，因厓遂削成。淺深嵐嶂色，盡向此中呈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 17
    },
    {
        "title": "盛山十二诗：上士瓶泉",
        "author": "韋处厚",
        "biography": "",
        "paragraphs": [
            "綆汲豈无井，顛崖貴非浚。愿灑塵垢餘，一雨根莖潤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 18
    },
    {
        "title": "客思吟",
        "author": "楊敬之",
        "biography": "",
        "paragraphs": [
            "禾黍正離離，南園剪白芝。細腰沈趙女，高髻唱蠻姬。",
            "路愧前岡月，梳慚一頷絲。鄉人不可语，独念畏人知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 19
    },
    {
        "title": "贈項斯",
        "author": "楊敬之",
        "biography": "",
        "paragraphs": [
            "幾度見诗诗總好，及觀標格過於诗。",
            "平生不解藏人善，到处逢人说項斯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 20
    },
    {
        "title": "句",
        "author": "楊敬之",
        "biography": "",
        "paragraphs": [
            "霜樹鳥棲夜，空街雀報明。",
            "碧山相倚暮，归雁一行斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 21
    },
    {
        "title": "初日照鳳樓",
        "author": "李虞仲",
        "biography": "",
        "paragraphs": [
            "旭日煙雲殿，朝阳燭帝居。斷霞生峻宇，通閣麗晴虛。",
            "流彩連朱檻，騰輝照綺疏。曈曨晨景裏，明滅曉光初。",
            "戶牖仙山近，軒楹鳳翼舒。還如王母過，遙度五雲車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 22
    },
    {
        "title": "郡齋三月下旬作",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "春事日已歇，池塘曠幽尋。残紅披独墜，初綠間淺深。",
            "偃仰倦芳褥，顧步愛新阴。謀春未及竟，夏初遽見侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 23
    },
    {
        "title": "五月水邊柳",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "結根挺涯涘，垂影覆清淺。睡臉寒未開，懶腰晴更軟。",
            "搖空條已重，拂水帶方展。似醉煙景凝，如愁月露泫。",
            "絲長魚誤恐，枝弱禽驚踐。悵別幾多情，含春任攀搴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 24
    },
    {
        "title": "三月五日陪大夫泛長沙東湖",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "上巳餘风景，芳辰集遠坰。彩舟浮泛蕩，繡轂下娉婷。",
            "棲樹回蔥蒨，笙歌轉杳冥。湖光迷翡翠，草色醉蜻蜓。",
            "鳥弄桐花日，魚翻谷雨萍。從今留勝會，谁看画蘭亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 25
    },
    {
        "title": "贈廣陵妓",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "雲雨分飛二十年，當时求夢不曾眠。",
            "今來頭白重相見，還上襄王玳瑁筵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 26
    },
    {
        "title": "牡丹",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "牡丹一朵值千金，将謂從來色最深。",
            "今日滿欄開似雪，一生辜負看花心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 27
    },
    {
        "title": "遊白鶴山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "白鶴山邊秋複春，张文宅畔少风塵。",
            "欲驅五馬尋真隱，谁是當初□竹人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 28
    },
    {
        "title": "行田诗",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "白石岩前湖水春，湖邊舊境有清塵。",
            "欲追謝守行田意，今古同憂是長人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 29
    },
    {
        "title": "羅浮山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "江北重巒積翠濃，綺霞遙映碧芙蓉。",
            "不知末后滄溟上，減卻瀛洲第幾峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 30
    },
    {
        "title": "青障山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "一派遠光澄碧月，万株聳翠獵金飆。",
            "陶仙謾學長生術，暑往寒來更寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 31
    },
    {
        "title": "中界山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "瑟瑟峰頭玉水流，晉时遺跡更堪愁。",
            "愁人到此勞長望，何处煙波是祖州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 32
    },
    {
        "title": "帆游山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "漲海嘗從此地流，千帆飛過碧山頭。",
            "君看深谷為陵后，翻覆人間未肯休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 33
    },
    {
        "title": "謝池",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "郡郭東南積谷山，謝公曾是此躋攀。",
            "今來惟有靈池月，犹是嬋娟一水間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 34
    },
    {
        "title": "華蓋山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "一岫坡陀凝綠草，千重虛翠透紅霞。",
            "愁來始上消归思，見盡江城数百家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 35
    },
    {
        "title": "吹臺山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "吹臺山上彩煙凝，日落雲收疊翠屏。",
            "應謂焦桐堪采斫，不知谁是柳吳興。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 36
    },
    {
        "title": "青嶴山",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "靈海泓澄匝翠峰，昔賢心賞已成空。",
            "今朝亭館无遺制，積水滄浪一望中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 37
    },
    {
        "title": "孤嶼",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "碧水逶迤浮翠巘，綠蘿蒙密媚晴江。",
            "不知谁与名孤嶼，其實中川是一雙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 38
    },
    {
        "title": "春草池",
        "author": "张又新",
        "biography": "",
        "paragraphs": [
            "謝公夢草一差微，謫宦當时道不机。",
            "且謂飛霞遊賞地，池塘煙柳亦依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 39
    },
    {
        "title": "春色滿皇州",
        "author": "封敖",
        "biography": "",
        "paragraphs": [
            "帝裏春光正，蔥蘢喜气浮。錦鋪仙禁側，鏡写曲江頭。",
            "紅萼開蕭閣，黃絲拂禦樓。千門歌吹動，九陌綺羅遊。",
            "日近风先滿，仁深澤共流。應非憔悴質，辛苦在神州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 40
    },
    {
        "title": "題西隱寺",
        "author": "封敖",
        "biography": "",
        "paragraphs": [
            "三年未到九華山，終日披图一室間。秋寺喜因晴后賞，",
            "勝事倘能銷歲月，已co名利不相關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 41
    },
    {
        "title": "奉和白敏中圣道和平致茲休运歲終功就合詠盛明呈上",
        "author": "馬植",
        "biography": "",
        "paragraphs": [
            "舜德堯仁化犬戎，许提河隴款皇风。指揮貙武皆神算，",
            "天留此事還英主，不在他年在大中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 42
    },
    {
        "title": "夏日途中",
        "author": "李廓",
        "biography": "",
        "paragraphs": [
            "樹夾炎风路，行人正午稀。初蟬数聲起，戲蝶一團飛。",
            "日色欺清鏡，槐膏點白衣。无成归故里，自觉少光輝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十九",
        "no#": 43
    },
    {
        "title": "長安少年行",
        "author": "李廓",
        "biography": "",
        "paragraphs": [
            "金紫少年郎，繞街鞍馬光。身從左中尉，官屬右春坊。",
            "剗戴揚州帽，重熏異國香。垂鞭踏青草，來去杏園芳。",
            "追逐輕薄伴，闲遊不著緋。長攏出獵馬，数换打球衣。",
            "曉日尋花去，春风帶酒归。青樓无晝夜，歌舞歇时稀。",
            "日高春睡足，帖馬賞年華。倒插銀魚袋，行隨金犢車。",
            "還攜新市酒，遠醉曲江花。幾度归侵黑，金吾送到家。",
            "好勝耽長夜，天明燭滿樓。留人看独腳，賭馬换偏頭。",
            "樂奏曾无歇，杯巡不暫休。时时遙冷笑，怪客有春愁。",
            "遨遊攜豔妓，裝束似男兒。杯酒逢花住，笙歌簇馬吹。",
            "鶯聲催曲急，春色送归迟。不以闻街鼓，華筵待月移。",
            "賞春惟逐勝，大宅可曾归。不樂還逃席，多狂慣衩衣。",
            "歌人踏日起，语燕捲簾飛。婦好唯相妒，倡樓不醉稀。",
            "戟門連日閉，苦飲惜残春。開鎖通新客，教姬屈醉人。",
            "倩歌牽白馬，自舞踏紅茵。时輩皆相许，平生不負身。",
            "新年高殿上，始見有光輝。玉雁排方帶，金鵝立仗衣。",
            "酒深和碗賜，馬疾打珂飛。朝下人爭看，香街意气归。",
            "遊市慵騎馬，隨姬入坐車。樓邊聽歌吹，簾外見鶯花。",
            "樂眼從人鬧，归心畏日斜。蒼頭來去報，飲伴到倡家。",
            "小婦教鸚鵡，頭邊喚醉醒。犬嬌眠玉簟，鷹掣撼金鈴。",
            "碧地攢花障，紅泥待客亭。雖然長按曲，不飲不曾聽。"
        ],
