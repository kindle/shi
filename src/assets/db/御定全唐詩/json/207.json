[
    {
        "title": "和袁郎中破賊後經剡縣山水上太尉",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "受律仙郎貴，長驅下會稽。鳴笳山月曉，搖旆野雲低。",
            "翦寇人皆賀，回军馬自嘶。地閑春草綠，城靜夜烏啼。",
            "破竹清閩嶺，看花入剡溪。元戎催獻捷，莫道事攀躋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 1
    },
    {
        "title": "送評事十九叔入秦",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "白露沾蕙草，王孫轉憶归。蔡州新戰罷，郢路去人稀。",
            "謁帝不辭遠，懷親空有違。孤舟看落葉，平楚逐斜暉。",
            "北闕見端冕，南台當繡衣。唯餘播遷客，只伴鷓鴣飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 2
    },
    {
        "title": "贈王八衢",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "丹地偏相逐，清江若有期。腰金才子貴，剖竹老人迟。",
            "桂楫閑迎客，茶甌對说诗。渚田分邑裏，山桂樹罘罳。",
            "心靜无華发，人和似古时。別君遠山去，幽独更應悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 3
    },
    {
        "title": "入睦州分水路憶劉長卿",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "北闕忤明主，南方隨白雲。沿洄灘草色，應接海鸥群。",
            "建德潮已盡，新安江又分。回看嚴子瀨，朗詠謝安文。",
            "雨過暮山碧，猿吟秋日曛。吳洲不可到，刷鬢為思君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 4
    },
    {
        "title": "奉和杜相公長興新宅即事呈元相公",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "意有空門樂，居无甲第奢。經過容法侶，雕飾讓侯家。",
            "隱樹重簷肅，開園一徑斜。據梧聽好鳥，行药寄名花。",
            "夢蝶留清簟，垂貂坐絳紗。當山不掩戶，映日自傾茶。",
            "雅望归安石，深知在叔牙。還成吉甫頌，贈答比瑤華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 5
    },
    {
        "title": "江湖秋思",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "趨陪禁掖雁行隨，遷向江潭鶴發垂。素浪遙疑八溪水，",
            "共望漢朝多霈澤，蒼蠅早晚得先知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 6
    },
    {
        "title": "送朱中舍游江東",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "孤城郭外送王孫，越水吳洲共爾論。野寺山邊斜有徑，",
            "若到西陵征戰處，不堪秋草自傷魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 7
    },
    {
        "title": "送竇拾遺赴朝因寄中书十七弟",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "自歎未沾黃紙詔，那堪遠送赤墀人。老為僑客偏相戀，",
            "凭爾将书通令弟，唯論華发愧頭巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 8
    },
    {
        "title": "自蘇台至望亭驛人家盡空春物增思悵然有作因寄從弟紓",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "南浦菰蔣覆白蘋，東吳黎庶逐黃巾。野棠自發空臨水，",
            "那堪回首長洲苑，烽火年年報虜塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 9
    },
    {
        "title": "承恩量移宰江邑，臨鄱江悵然之作",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "四年謫宦滯江城，未厭門前鄱水清。谁言宰邑化黎庶，",
            "惆悵閑眠臨極浦，夕阳秋草不勝情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 10
    },
    {
        "title": "題靈台縣東山村主人",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "處處征胡人漸稀，山村寥落暮煙微。門臨莽蒼經年閉，",
            "天子如今能用武，只應歲晚息兵机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 11
    },
    {
        "title": "同皇甫冉登重玄閣",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "高閣朱欄不厭遊，蒹葭白水繞長洲。孤雲独鳥川光暮，",
            "谁怜遠作秦吳別，離恨归心雙淚流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 12
    },
    {
        "title": "宋州東登望題武陵驛",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "梁宋人稀鳥自啼，登艫一望倍含淒。白骨半隨河水去，",
            "明主频移虎符守，幾时行縣向黔黎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 13
    },
    {
        "title": "晚登江樓有懷",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "独坐南樓佳興新，青山綠水共為鄰。爽氣遙分隔浦岫，",
            "只憶帝京不可到，秋琴一弄欲沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 14
    },
    {
        "title": "游徐城河忽見清淮，因寄趙八",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "自緣迟暮憶滄洲，翻愛南河濁水流。初過重阳惜残菊，",
            "長恨相逢即分首，含情掩淚独回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 15
    },
    {
        "title": "題游仙閣白公廟",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "仙冠輕舉竟何之，薜荔緣階竹映祠。甲子不知风馭日，",
            "逐客自怜雙鬢改，焚香多負白雲期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 16
    },
    {
        "title": "送鄭正則漢阳迎婦",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "錦字相催鳥急飛，郎君暫脫老萊衣。遙想雙眉待人画，",
            "令秩和鳴真可羨，此行谁道負春輝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 17
    },
    {
        "title": "送皇甫冉往安宜",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "江皋盡日唯煙水，君向白田何日归。楚地蒹葭連海迥，",
            "若问行人与征戰，使君雙淚定沾衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 18
    },
    {
        "title": "晚發咸阳，寄同院遺補",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "征戰初休草又衰，咸阳晚眺淚堪垂。去路全无千里客，",
            "回首青山独不语，羨君談笑万年枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 19
    },
    {
        "title": "早秋京口旅泊，章侍禦寄书相问，因以贈之，时七夕",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "移家避寇逐行舟，厭見南徐江水流。吳越征徭非舊日，",
            "只有同时驄馬客，偏宜尺牘问窮愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 20
    },
    {
        "title": "秋曉招隱寺東峰茶宴，送內弟閻伯均归江州",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "万畦新稻傍山村，數裏深松到寺門。幸有香茶留稚子，",
            "莫怪臨歧独垂淚，魏舒偏念外家恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 21
    },
    {
        "title": "送嚴員外",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "春风倚棹闔閭城，水國春寒阴複晴。細雨濕衣看不見，",
            "君去若逢相识问，青袍今已誤儒生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 22
    },
    {
        "title": "赴南中留別褚七少府湖上林亭",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "種田東郭傍春陂，万事无情把釣絲。綠竹放侵行徑裏，",
            "從此別君千万里，白雲流水憶佳期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 23
    },
    {
        "title": "与從弟正字、從兄兵曹宴集林園",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "竹窗松戶有佳期，美酒香茶慰所思。輔嗣外生還解易，",
            "去路归程仍待月，垂韁不控馬行迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 24
    },
    {
        "title": "酬皇甫十六侍禦曾見寄",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "自顧衰容累玉除，忽承優詔赴銅魚。江頭鳥避青旄節，",
            "更枉新诗思何苦，離騷愁處亦无如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 25
    },
    {
        "title": "暮春宜阳郡齋愁坐，忽枉劉七侍禦新诗，因以酬答",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "子規夜夜啼櫧葉，遠道逢春半是愁。芳草伴人還易老，",
            "唯羨君為周柱史，手持黃紙到滄洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 26
    },
    {
        "title": "送舍弟",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "諸謝偏推永嘉守，三何独许水曹郎。老兄鄙思難儔匹，",
            "定知馬上多新句，早寄袁溪當八行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 27
    },
    {
        "title": "送從弟永任饒州錄事參军",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "一官万里向千溪，水宿山行魚浦西。日晚長煙高岸近，",
            "闻道慈親倚門待，到时蘭葉正萋萋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 28
    },
    {
        "title": "送馬将军奏事畢归滑州使幕",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "吳門別後蹈滄州，帝裏相逢俱白頭。自歎馬卿常帶病，",
            "想到滑台桑葉落，黃河東注荻花秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 29
    },
    {
        "title": "闻逝者自驚",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "亦知死是人間事，年老闻之心自疑。黃卷清琴總為累，",
            "兒女眼前難喜舍，彌怜雙鬢漸如絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 30
    },
    {
        "title": "傷歙州陳二使君",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "怜君辭滿臥滄洲，一旦雲亡万事休。慈母斷腸妻独泣，",
            "寂寞荒墳近漁浦，野松孤月即千秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 31
    },
    {
        "title": "白田西憶楚州使君弟",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "山阳郭裏无潮，野水自向新橋。魚網平鋪荷葉，",
            "卻憶士龍賓閣，清琴綠竹蕭蕭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 32
    },
    {
        "title": "送陸澧還吳中",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "瓜步寒潮送客，楊花暮雨沾衣。",
            "故鄉南望何處，春水連天独归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 33
    },
    {
        "title": "春日憶家",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "自覺勞鄉夢，无人見客心。空餘庭草色，日日伴愁襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 34
    },
    {
        "title": "遠寺鐘",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "疏鐘何處來，度竹兼拂水。漸逐微风聲，依依犹在耳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 35
    },
    {
        "title": "白鹭",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "江南淥水多，顧影逗輕波。落日秦雲裏，山高奈若何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 36
    },
    {
        "title": "夜宴南陵留別",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "雪滿前庭月色閑，主人留客未能還。",
            "預愁明日相思處，匹馬千山与万山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 37
    },
    {
        "title": "題前溪館",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "两年謫宦在江西，舉目雲山要自迷。",
            "今日始知风土異，潯阳南去鷓鴣啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 38
    },
    {
        "title": "過烏公山寄錢起員外",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "雨過青山猿叫时，愁人淚點石榴枝。",
            "无端王事還相系，腸斷蒹葭君不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 39
    },
    {
        "title": "寄王舍人竹樓",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "傲吏身閑笑五侯，西江取竹起高樓。",
            "南风不用蒲葵扇，紗帽閑眠對水鸥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 40
    },
    {
        "title": "韋潤州後亭海榴",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "江上年年小雪迟，年光独報海榴知。",
            "寂寂山城风日暖，謝公含笑向南枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 41
    },
    {
        "title": "送崔十一弟归北京",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "潘郎美貌謝公诗，銀印花驄年少时。",
            "楚地江皋一為別，晉山沙水独相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零七",
        "no#": 42
    },
    {
        "title": "訪韓司空不遇",
        "author": "李嘉佑",
        "biography": "",
        "paragraphs": [
            "圖画风流似長康，文詞體格效陳王。",
            "蓬萊對去归常晚，叢竹閑飛滿夕阳。"
        ],
        "notes": [
            ""
        ],
