[
    {
        "title": "上浙東元相",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "婺女星邊喜气频，越王臺上坐诗人。雪晴山水勾留客，",
            "何言禹跡无人繼，万頃湖田又斬新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 1
    },
    {
        "title": "贈茅山高拾遺蔓",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "人皆貪祿利，白首更營營。若見无為理，兼忘不朽名。",
            "幽禽窺飯下，好药入籬生。夢觉幽泉滴，應疑禁漏聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 2
    },
    {
        "title": "次韵和光祿錢卿二首",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "大隱嚴城內，閑門向水開。扇风知暑退，樹影觉秋來。",
            "望遠雲生海，行稀砌長苔。廢興今古事，何必歎池灰。",
            "閑論憂王室，愁眉仗酒開。方嗟三覆役，又喜四愁來。",
            "晨起螢穿竹，晡餐鳥下苔。同期阳月至，靈室祝葭灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 3
    },
    {
        "title": "贈廬山錢卿",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "象魏抽簪早，匡廬築室牢。宦情归去薄，天爵隱來高。",
            "篋有新征詔，囊餘舊縕袍。何如舍麋鹿，明主仰风騷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 4
    },
    {
        "title": "山中送進士劉蟾赴舉",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "去住跡雖異，愛憎情不同。因君向帝裏，使我厭山中。",
            "故友多朝客，新文盡國风。藝精心更苦，何患不成功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 5
    },
    {
        "title": "送進士陳嶢往睦州謁馮郎中",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "孤帆幾日程，投刺水邊城。倚棹逢春老，登筵見月生。",
            "飲酣杯有浪，棋散漏无聲。太守怜才者，從容禮不輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 6
    },
    {
        "title": "豐城劍池即事",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "神物不復見，小池空在茲。因嫌沖鬥夜，未是偃戈时。",
            "岸古魚藏穴，蒲凋翠立危。吾皇別有劍，何必鑄金為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 7
    },
    {
        "title": "詠弓",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "較量武藝論勳庸，曾發将军箭落鴻。握內從誇彎似月，",
            "得病自從杯裏后，至今形狀怕相逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 8
    },
    {
        "title": "送无相禪師入關",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "九衢車馬塵，不染了空人。暫舍中峰雪，應看內殿春。",
            "齋心无外事，定力見前身。圣主方崇教，深宜謁紫宸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 9
    },
    {
        "title": "贈匡山道者",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "嘗闻一粒功，足以反衰容。方寸如不達，此生安可逢。",
            "寄书时態盡，憶语道情濃。爭得攜巾屨，同归鳥外峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 10
    },
    {
        "title": "道者与金丹開合已失，因為二首，再有投擲",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "木鑽鑽磐石，辛勤四十年。一朝才見物，五色互呈妍。",
            "七魄憎阳盛，三彭惡命延。被他迷失卻，歎息只潸然。",
            "阴阳曾作炭，造化亦分功。減自青囊裏，收安玉合中。",
            "凡材難度世，神物自归空。惆悵流年速，看成白首翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 11
    },
    {
        "title": "思越州山水寄朱慶餘",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "窗戶潮頭雪，雲霞鏡裏天。島桐秋送雨，江艇暮搖煙。",
            "藕折蓮芽脆，茶挑茗眼鮮。還将歐冶劍，更淬若耶泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 12
    },
    {
        "title": "蜀中上王尚书",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "梓桐花幕碧雲浮，天许文星寄上頭。武略劍峰環相府，",
            "自古名高閑不得，肯容王粲賦登樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 13
    },
    {
        "title": "贈陸鬯浙西進诗除官",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "帝城雲物得阳春，水國煙花失主人。",
            "昨日天风吹樂府，六宮絲管一时新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 14
    },
    {
        "title": "古行宮",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "瓦煙疏冷古行宮，寂寞朱門反鎖空。残粉水銀流砌下，",
            "天子时清不巡幸，只應鸞鳳集梧桐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 15
    },
    {
        "title": "題上皇觀",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "煙霞星蓋七星壇，想像先朝駐禁鑾。輦路已平栽药地，",
            "翻感惠休並李郭，劍門空处望長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 16
    },
    {
        "title": "鷹",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "星眸未放瞥秋毫，频掣金鈴試雪毛。會使老拳供口腹，",
            "可惜忍饑寒日暮，向人鵮斷碧絲絛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 17
    },
    {
        "title": "方山寺松下泉",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "石脈綻寒光，松根噴曉霜。注瓶雲母滑，漱齒茯苓香。",
            "野客偷煎茗，山僧惜淨床。三禪不要问，孤月在中央。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 18
    },
    {
        "title": "瀑布",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "秋河溢長空，天灑万丈布。深雷隱雲壑，孤電掛岩樹。",
            "滄溟曉噴寒，碧落晴蕩素。非趨下流急，熱使不得住。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 19
    },
    {
        "title": "送张使君赴饒州",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "饒阳因富得州名，不独農桑別有營。日暖提筐依茗樹，",
            "太守能诗兼愛靜，西樓見月幾篇成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 20
    },
    {
        "title": "和滕邁先輩傷馬",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "浮雲變化失龍兒，始憶嘶风噴沫时。蹄想塵中翻碧玉，",
            "今日櫪前興一歎，不關行李乏金羈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 21
    },
    {
        "title": "省試騏驥長鳴",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "有馬骨堪驚，无人眼暫明。力窮吳阪峻，嘶苦朔风生。",
            "逐逐懷良禦，蕭蕭顧樂鳴。瑤池期弄影，天路擬飛聲。",
            "皎月谁知種，浮雲莫问程。鹽車今愿脫，千里為君行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 22
    },
    {
        "title": "鯉魚",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "眼似真珠鱗似金，时时動浪出還沈。",
            "河中得上龍門去，不歎江湖歲月深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 23
    },
    {
        "title": "饑鷹詞",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "遙想平原兔正肥，千回礪吻振毛衣。",
            "縱令啄解絲絛結，未得人呼不敢飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 24
    },
    {
        "title": "归燕詞辭工部侍郎",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "舊壘危巢泥已落，今年故向社前归。",
            "連雲大廈无棲处，更望谁家門戶飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 25
    },
    {
        "title": "归海上舊居",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "鄉路繞蒹葭，縈紆出海涯。人衣披蜃气，馬跡印鹽花。",
            "草沒題诗石，潮摧坐釣槎。還归舊窗裏，凝思向餘霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 26
    },
    {
        "title": "答友人惠牙簪",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "牙簪不可忘，來处隔炎荒。截得半環月，磨成四寸霜。",
            "曉辭梳齒膩，秋入發根涼。好是紗巾下，纖纖錐出囊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 27
    },
    {
        "title": "日者",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "十指中央了五行，说人休咎見前生。",
            "我來本乞真消息，卻怕呵錢卦欲成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 28
    },
    {
        "title": "送金可紀归新羅",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "登唐科第语唐音，望日初生憶故林。鮫室夜眠阴火冷，",
            "想把文章合夷樂，蟠桃花裏醉人參。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 29
    },
    {
        "title": "闻角",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "邊秋画角怨金微，半夜对吹驚賊圍。塞雁繞空秋不下，",
            "餘韵嫋空何处盡，戍天寥落曉星稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 30
    },
    {
        "title": "夢鄉",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "家住吳王舊苑東，屋頭山水勝屏风。",
            "尋常夢在秋江上，釣艇游揚藕葉中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 31
    },
    {
        "title": "織綾詞",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "去年蠶惡綾帛貴，官急无絲織紅淚。残經脆緯不通梭，",
            "瑤台雪裏鶴张翅，禁苑风前梅折枝。不學鄰家婦慵懶，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 32
    },
    {
        "title": "諸葛武侯廟",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "木牛零落陣图残，山姥燒錢古柏寒。",
            "七縱七擒何处在，茅花櫪葉蓋神壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 33
    },
    {
        "title": "長安秋夜",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "田家无五行，水旱蔔蛙聲。牛犢乘春放，兒童候暖耕。",
            "池塘煙未起，桑柘雨初晴。步晚香醪熟，村村自送迎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 34
    },
    {
        "title": "錢塘贈武翊黃",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "曾将心劍作戈矛，一戰名場造化愁。花錦文章開四面，",
            "时伴庾公看海月，好吟诗斷望潮樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 35
    },
    {
        "title": "风不鳴條",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "旭日懸清景，微风在綠條。入松聲不發，過柳影空搖。",
            "長養應潛變，扶疏每暗飄。有林时杳杳，无樹暫蕭蕭。",
            "慢逐清煙散，輕和瑞气饒。豐年知有待，歌詠美唐堯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 36
    },
    {
        "title": "貽美人",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "諸侯帳下慣新妝，皆怯劉家薄媚娘。寶髻巧梳金翡翠，",
            "何事不归巫峽去，故來人世斷人腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 37
    },
    {
        "title": "闻雲中唳鶴",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "久在青田唳，天高忽暫闻。翩翩縈碧落，嘹唳入重雲。",
            "出谷鶯何待，鳴岐鳳欲群。九皋寧足道，此去透絪縕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 38
    },
    {
        "title": "柘枝",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "柘枝初出鼓聲招，花鈿羅衫聳細腰。移步錦靴空綽約，",
            "只恐相公看未足，便隨风雨上青霄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 39
    },
    {
        "title": "上太皇先生",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "顥气貫精神，蒼崖老姓名。煙霞空送景，水木苦无情。",
            "劚药雲根斷，眠花石面平。折鬆開月色，決水放秋聲。",
            "顏為忘憂嫩，身緣絕粒輕。圍棋看局勢，对鏡戮妖精。",
            "過海量鯨力，归天算鶴程。露凝鐘乳冷，风定玉簫清。",
            "坐觉衣裳古，行疑羽翼生。應怜市朝客，開眼鎖浮榮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 40
    },
    {
        "title": "破山水屏风",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "时人嫌古画，倚壁不曾收。雨滴膠山斷，风吹絹海秋。",
            "残雲飛屋裏，片水落床頭。尚勝凡花鳥，君能補綴休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 41
    },
    {
        "title": "覽楊校书文卷",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "跪伸霜素剖琅玕，身墮瑤池魄暗寒。紅錦晚開雲母殿，",
            "谁有軒轅古銅片，為持相並照妖看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 42
    },
    {
        "title": "送陳校书赴蔡州幕",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "天假縱橫入幕籌，東南頓減一方憂。行齎健筆辭天閣，",
            "此行領取從军樂，莫慮功名不拜侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 43
    },
    {
        "title": "少年行",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "平明小獵出中军，異國名香滿袖熏。画榼倒懸鸚鵡嘴，",
            "落日胡姬樓上飲，风吹簫管滿樓闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 44
    },
    {
        "title": "蜀中贈廣上人",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "曾持麈尾引金根，万乘前頭草五言。疏講青龍归禁苑，",
            "今日西川无子美，诗风又起浣花村。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 45
    },
    {
        "title": "和顧校书新開井",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "霜鍤破桐阴，青絲試淺深。月輪開地脈，鏡面写天心。",
            "碧甃花千片，香泉乳百尋。欲知爭汲引，聽取轆轤音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 46
    },
    {
        "title": "遊雲際寺",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "衫袖拂青冥，推鞍上翠屏。塵埃辭馬尾，城闕入窗櫺。",
            "雲領浮名去，鐘撞大夢醒。茫茫山下事，滿眼送流萍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 47
    },
    {
        "title": "贈劉寬夫昆季",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "文聚星辰衣彩霞，问谁兄弟是劉家。雁行雲摻參差翼，",
            "曾窮晉漢儒林傳，龍虎雖多未足誇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 48
    },
    {
        "title": "贈杭州嚴史君",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "州青縣白浙河濆，飽向蒼龍闕下闻。鼓角自嚴寒海月，",
            "長恐抱轅留不住，九天鴛鹭待成群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 49
    },
    {
        "title": "題朱秀城南亭子",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "朱家亭子象懸匏，階瑩青莎棟剪茆。癭掛眼開欺鴝鵒，",
            "土木欲知精潔处，社天归燕怯安巢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 50
    },
    {
        "title": "上西川王尚书",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "人人入蜀謁文翁，妍醜終須露鏡中。诗景荒涼難道合，",
            "下客低頭來又去，暗堆冰炭在深衷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 51
    },
    {
        "title": "駱谷行",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "捫雲嫋棧入青冥，鞿馬鈴騾傍日星。仰踏劍棱梯万仞，",
            "若比爭名求利处，尋思此路卻安寧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 52
    },
    {
        "title": "初及第归酬孟元翊見贈",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "六年衣破帝城塵，一日天池水脫鱗。未有片言驚后輩，",
            "何幸致诗相慰賀，東归花發杏桃春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 53
    },
    {
        "title": "淮南李相公紳席上賦春雪",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "六出花飛处处飄，粘窗著砌上寒條。",
            "朱門到曉難盈尺，儘是三军喜气消。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 54
    },
    {
        "title": "及第后寄廣陵故人",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "及第全勝十政官，金鞍鍍了出長安。",
            "馬頭漸入揚州郭，為報时人洗眼看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 55
    },
    {
        "title": "小松",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "爪葉鱗條龍不盤，梳风幕翠一庭寒。",
            "莫言只是人長短，須作浮雲向上看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 56
    },
    {
        "title": "宮詞",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "明日鑾輿欲向東，守宮金翠帶愁紅。",
            "九門佳气已西去，千里花開一夜风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 57
    },
    {
        "title": "題杭州樟亭驛",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "樟亭驛上題诗客，一半尋為山下塵。",
            "世事日隨流水去，紅花還似白頭人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 58
    },
    {
        "title": "劉侍中宅盤花紫薔薇",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "真宰偏饒麗景家，當春盤出帶根霞。",
            "從開一朵朝衣色，免踏塵埃看雜花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 59
    },
    {
        "title": "題東林寺寄江州李員外",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "山勢棱層入杳冥，寺形高下趁山行。象牙床坐蓮花佛，",
            "門前更有清江水，便是潯阳太守廳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 60
    },
    {
        "title": "玄都觀栽桃十韵",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "驅使鬼神功，攢栽万樹紅。熏香丹鳳闕，妝點紫瓊宮。",
            "寶帳重庶日，妖金遍累空。色然燒药火，影舞步虛风。",
            "粉撲青牛過，枝驚白鶴沖。拜星春錦上，服食晚霞中。",
            "棋局阴長合，簫聲秘不通。豔阳迷俗客，幽邃失壺公。",
            "根柢終磐石，桑麻自轉蓬。求師飽靈药，他日訪遼東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 61
    },
    {
        "title": "僧院小松",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "拋杉背柏冷僧簾，鎖月梳风出殿簷。",
            "還似天臺新雨后，小峰雲外碧尖尖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 62
    },
    {
        "title": "春原早望",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "一忝鄉书薦，長安未得回。年光逐渭水，春色上秦台。",
            "燕掠平蕪去，人沖細雨來。東风生故里，又過幾花開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 63
    },
    {
        "title": "西山廣福院",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "野寺孤峰上，危樓聳翠微。捲簾滄海近，洗缽白雲飛。",
            "竹影臨經案，松花點衲衣。日斜登望处，湖畔一僧归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 64
    },
    {
        "title": "遊地肺",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "市朝擾擾千古，林壑冥冥四賢。黃鶴不归丹灶，",
            "高跡无人更躡，碧峰寥落孤煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 65
    },
    {
        "title": "八月",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "徙倚仙居繞翠樓，分明宮漏靜兼秋。",
            "長安夜夜家家月，幾处笙歌幾处愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 66
    },
    {
        "title": "題紫微山上方",
        "author": "章孝標",
        "biography": "",
        "paragraphs": [
            "地勢連滄海，山名號紫微。景閑僧坐久，路僻客來稀。",
            "峽影雲相照，河流石自圍。塵喧都不到，安得此忘归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零六",
        "no#": 67
    }
]