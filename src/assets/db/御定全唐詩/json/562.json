[
    {
        "title": "早春",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "曉來庭戶外，草樹似依依。一夜東风起，万山春色归。",
            "冰消泉派動，日暖露珠晞。已醞看花酒，嬌鶯莫預飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 1
    },
    {
        "title": "傷春感懷",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "花飛惜不得，年長更堪悲。春盡有归日，老來无去时。",
            "风前千片雪，鏡裏数莖絲。腸斷青山暮，独攀楊柳枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 2
    },
    {
        "title": "閏三月",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "三年皆一閏，此閏勝常时。莫怪花開晚，都緣春盡迟。",
            "節分炎气近，律應蕙风移。夢得成蝴蝶，芳菲幸不遺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 3
    },
    {
        "title": "早秋遊湖上亭",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "危亭秋尚早，野思已无窮。竹葉一尊酒，荷香四座风。",
            "曉煙孤嶼外，归鳥夕阳中。漸愛湖光冷，移舟月滿空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 4
    },
    {
        "title": "宿漁家",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "竹屋清江上，风煙四五家。水園分芰葉，鄰界認蘆花。",
            "雨到魚翻浪，洲回鳥傍沙。月明何处去，片片席帆斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 5
    },
    {
        "title": "旅中早秋",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "金威生止水，爽气遍遙空。草色蕭條路，槐花零落风。",
            "夜來万里月，觉后一聲鴻。莫问前程事，颯然沙上蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 6
    },
    {
        "title": "早秋西归有懷",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "求归方有计，惜別更堪愁。上馬江城暮，出郊山戍秋。",
            "暗銷何限事，白盡去年頭。莫怪频惆悵，異鄉難再遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 7
    },
    {
        "title": "冬夜旅懷",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "寒窗危竹枕，月過半床阴。嫩葉不归夢，晴蟲成苦吟。",
            "酒无通夜力，事滿五更心。寂寞谁相似，残燈与素琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 8
    },
    {
        "title": "塞上作",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "蕭蕭隴水側，落日客愁中。古塞一聲笛，長沙千里风。",
            "鳥无棲息处，人愛戰爭功。数夜城頭月，彎彎如引弓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 9
    },
    {
        "title": "秋日寄陳景孚秀才",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "征車日已遠，物候尚淒淒。风葉青桐落，露花紅槿低。",
            "心隨秦國遠，夢到楚山迷。卻恨銜蘆雁，秋飛不向西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 10
    },
    {
        "title": "冬日送友人西归",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "北风吹別思，杳杳度雲山。滿望是归处，一生犹未閑。",
            "知音方見譽，浮宦久相關。空有心如月，同居千里還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 11
    },
    {
        "title": "感寓",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "海竭山移歲月深，分明齊得世人心。顏回徒恨少成古，",
            "他年免似驪山鬼，信有蓬萊不可尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 12
    },
    {
        "title": "七夕",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "烏鵲橋成上界通，千秋靈會此宵同。雲收喜气星樓曉，",
            "采盤花閣无窮意，只在遊絲一縷中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 13
    },
    {
        "title": "晚春陪王員外東塘游宴",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "水綠山青春日長，政成因暇泛回塘。初移柳岸笙歌合，",
            "一聲画角嚴城暮，雲雨分时滿路光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 14
    },
    {
        "title": "游東湖黃处士園林",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "偶向東湖更向東，数聲雞犬翠微中。遙知楊柳是門处，",
            "物情多与閑相稱，所恨求安计不同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 15
    },
    {
        "title": "題许子正处士新池",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "坐愛风塵日已西，功成得与化工齊。巧分孤島思何遠，",
            "那堪更到芙蓉拆，晚夕香聯桃李蹊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 16
    },
    {
        "title": "旅懷",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "物態人心漸渺茫，十年徒學釣滄浪。老将何面還吾土，",
            "无名无位卻无事，醉落烏紗臥夕阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 17
    },
    {
        "title": "早秋归",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "数口飄零身未回，夢魂遙斷越王台。家书欲寄雁飛遠，",
            "茫茫归路在何处，砧杵一聲心已摧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 18
    },
    {
        "title": "歐阳示新诗因貽四韵",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "沖戛瑤瓊得至音，数篇清越應南金。都由苦思无休日，",
            "欲知字字驚神鬼，一气秋时試夜吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 19
    },
    {
        "title": "尉迟将军",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "天仗擁門希授鉞，重臣入夢豈安金。江河定后威风在，",
            "明妃若遇英雄世，青塚何由怨陸沉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 20
    },
    {
        "title": "贈歐阳秀才",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "桐上知音日下身，道光谁不仰清塵。偶來水館逢為客，",
            "權門要路應行遍，閑伴山夫一夜貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 21
    },
    {
        "title": "贈道者",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "五雲深处有真仙，歲月催多卻少年。入郭不知今世事，",
            "时向人間深夜坐，鬼神長在药囊邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 22
    },
    {
        "title": "贈道者",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "道帔輕裾三島雲，綠髯長占鏡中春。高风已駕祥鸞馭，",
            "儒生也愛長生術，不見人間大笑人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 23
    },
    {
        "title": "遣懷寄歐阳秀才",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "地上江河天上烏，百年流轉只須臾。平生閑過日将日，",
            "古來晚達人何限，莫笑空枝犹望蘇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 24
    },
    {
        "title": "送元秀才入道",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "不教榮樂損天机，愿逐鸞皇次第飛。明月滿时開道帔，",
            "空有緘題報親愛，一千年后始西归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 25
    },
    {
        "title": "三閭大夫",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "三閭一去湘山老，煙水悠悠痛古今。青史已书殷鑒在，",
            "再引離騷見微旨，肯教漁父會升沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 26
    },
    {
        "title": "傷曾秀才馬",
        "author": "劉威",
        "biography": "",
        "paragraphs": [
            "買得龍媒越水濆，輕桃細杏色初分。秋归未過阳關日，",
            "臨軒振策休惆悵，坐致煙霄只在君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 27
    },
    {
        "title": "噴玉泉冥會诗八首：白衣叟途中吟二首",
        "author": "李玖",
        "biography": "",
        "paragraphs": [
            "春草萋萋春水綠，野棠開盡飄香玉。",
            "繡嶺宮前鶴發人，犹唱開元太平曲。",
            "厭世逃名者，谁能答姓名。曾闻王樂否，眷取路傍情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 28
    },
    {
        "title": "噴玉泉冥會诗八首：白衣叟述甘棠館西楹诗",
        "author": "李玖",
        "biography": "",
        "paragraphs": [
            "浮雲淒慘日微明，沉痛将军負罪名。白晝叫閽无近戚，",
            "六合茫茫皆漢土，此身无处哭田橫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 29
    },
    {
        "title": "噴玉泉冥會诗八首：白衣叟噴玉泉感舊遊书懷",
        "author": "李玖",
        "biography": "",
        "paragraphs": [
            "樹色川光向晚晴，舊曾遊处事分明。鼠穿月榭荊榛合，",
            "傷心谷口東流水，犹噴當时寒玉聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 30
    },
    {
        "title": "噴玉泉冥會诗八首：四丈夫同賦",
        "author": "李玖",
        "biography": "",
        "paragraphs": [
            "鳥啼鶯语思何窮，一世榮華一夢中。李固有冤藏蠹簡，",
            "春月不知人事改，閑垂光影照洿宮。",
            "桃蹊李徑盡荒涼，訪舊尋新益自傷。雖有衣衾藏李固，",
            "天爵竟為人爵誤，谁能高叫问蒼蒼。",
            "落花寂寂草綿綿，雲影山光盡宛然。壞室基摧新石鼠，",
            "惆悵林間中夜月，孤光曾照讀书筵。",
            "新荊棘路舊衡門，又駐高車會一尊。寒骨未沾新雨露，",
            "珍重昔年金谷友，共來泉際話幽魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 31
    },
    {
        "title": "下第归宜春酬黃頗餞別",
        "author": "潘唐",
        "biography": "",
        "paragraphs": [
            "圣代澄清雨露均，独懷惆悵出咸秦。承明未薦相如賦，",
            "一從此地曾攜手，益羨江頭桃李春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十二",
        "no#": 32
    }
]