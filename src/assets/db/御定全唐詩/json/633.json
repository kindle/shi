[
    {
        "title": "有感",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "國事皆須救未然，漢家高閣漫淩煙。",
            "功臣盡遣詞人贊，不省滄洲画魯連。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 1
    },
    {
        "title": "歌",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "处处亭台只壞牆，军營人學內人妝。",
            "太平故事因君唱，馬上曾聽隔教坊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 2
    },
    {
        "title": "偈",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "人若憎时我亦憎，逃名最要是无能。",
            "后生乞汝残风月，自作深林不语僧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 3
    },
    {
        "title": "鸝",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "不是流鶯独佔春，林間彩翠四时新。",
            "應知擬上屏风画，偏坐橫枝亦向人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 4
    },
    {
        "title": "白菊雜书四首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "黃昏寒立更披襟，露浥清香悅道心。",
            "卻笑谁家扃繡戶，正熏龍麝暖鴛衾。",
            "四面雲屏一帶天，是非斷得自翛然。",
            "此生只是償诗債，白菊開时最不眠。",
            "狂才不足自英雄，僕妾驅令學販舂。",
            "侯印幾人封万戶，儂家只辦買孤峰。",
            "黃鸝囀处谁同聽，白菊開时且剩過。",
            "漫道南朝足流品，由來叔寶不宜多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 5
    },
    {
        "title": "漫題",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "經乱年年厭別離，歌聲喜似太平时。",
            "詞臣更有中興頌，磨取蓮峰便作碑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 6
    },
    {
        "title": "率題",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "宦路前銜閑不記，醉鄉佳境興方濃。",
            "一林高竹長遮日，四壁寒山更閏冬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 7
    },
    {
        "title": "澗戶",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "澗戶芳煙接水村，乱來归得道仍存。",
            "数竿新竹當軒上，不羨侯家立戟門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 8
    },
    {
        "title": "故鄉杏花",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "寄花寄酒喜新開，左把花枝右把杯。",
            "欲问花枝与杯酒，故人何得不同來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 9
    },
    {
        "title": "華上二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "故國春归未有涯，小欄高檻別人家。",
            "五更惆悵回孤枕，犹自残燈照落花。",
            "關外风昏欲雨天，薺花耕倒枕河壖。",
            "村南寂寞时回望，一隻鴛鴦下渡船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 10
    },
    {
        "title": "夢中",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "幾多親愛在人間，上徹霞梯會卻還。",
            "須是蓬瀛長買得，一家同占作家山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 11
    },
    {
        "title": "榜下",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "三十功名志未伸，初将文字競通津。",
            "春风漫折一枝桂，煙閣英雄笑殺人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 12
    },
    {
        "title": "涔阳渡",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "楚田人立帶残暉，驛迥村幽客路微。",
            "两岸蘆花正蕭颯，渚煙深处白牛归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 13
    },
    {
        "title": "偶作",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "索得身归未保閑，乱來道在辱來頑。",
            "留侯万戶雖无分，病骨應消一片山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 14
    },
    {
        "title": "寓居有感三首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "亦知世路薄忠貞，不忍残年負圣明。",
            "只待東封沾慶賜，碑阴別刻老臣名。",
            "不放残年卻到家，銜杯懶更问生涯。",
            "河堤往往人相送，一曲晴川隔蓼花。",
            "黑須寄在白須生，一度秋风減幾莖。",
            "客处不堪频送別，无多情緒更傷情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 15
    },
    {
        "title": "淮西",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "鼇冠三山安海浪，龍盤九鼎鎮皇都。",
            "莫誇十万兵威盛，消個忠良效顺无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 16
    },
    {
        "title": "河湟有感",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "一自蕭關起戰塵，河湟隔斷異鄉春。",
            "漢兒盡作胡兒语，卻向城頭罵漢人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 17
    },
    {
        "title": "自gM鄉北归",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "巴煙冪冪久縈恨，楚柳綿綿今送归。",
            "回避江邊同去雁，莫教驚起錯南飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 18
    },
    {
        "title": "青龍師安上人",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "災曜偏臨许國人，雨中衰菊病中身。",
            "清香一炷知師意，應為昭陵惜老臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 19
    },
    {
        "title": "山中",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "凡鳥愛喧人靜处，閑雲似妒月明时。",
            "世間万事非吾事，只愧秋來未有诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 20
    },
    {
        "title": "有感二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "自古經綸足是非，阴謀最忌奪天机。",
            "留侯卻粒商翁去，甲第何人意气归。",
            "古來賢俊共悲辛，長是豪家拒要津。",
            "從此當歌唯痛飲，不須經世為闲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 21
    },
    {
        "title": "閑夜二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "道侶難留為虐棋，鄰家闻说厭吟诗。",
            "前峰月照分明見，夜合香中露臥时。",
            "此身閑得易為家，业是吟诗与看花。",
            "若使他生拋筆硯，更應无事老煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 22
    },
    {
        "title": "雨中",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "維摩居士陶居士，盡说高情未足誇。",
            "簷外蓮峰階下菊，碧蓮黃菊是吾家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 23
    },
    {
        "title": "送道者二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "洞天真侶昔曾逢，西嶽今居第幾峰。",
            "峰頂他时教我認，相招須把碧芙蓉。",
            "殷勤不為學燒金，道侶惟應识此心。",
            "雪裏千山訪君易，微微鹿跡入深林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 24
    },
    {
        "title": "重阳阻雨",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "重阳阻雨独銜杯，移得山家菊未開。",
            "犹勝登高閑望斷，孤煙残照馬嘶回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 25
    },
    {
        "title": "省試",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "粉闈深鎖唱同人，正是終南雪霽春。",
            "閑系長安千匹馬，今朝似減六街塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 26
    },
    {
        "title": "有贈",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "有诗有酒有高歌，春色年年奈我何。",
            "試问羲和能駐否，不勞频借魯阳戈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 27
    },
    {
        "title": "證因亭",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "峰北幽亭愿證因，他生此地卻容身。",
            "上方僧在时應到，笑認前銜記写真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 28
    },
    {
        "title": "頃年陪恩地赴甘棠之召感動留題",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "去时憔悴青衿在，归路淒涼絳帳空。",
            "无限酬恩心未展，又将孤劍別從公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 29
    },
    {
        "title": "九月八日",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "已是人間寂寞花，解怜寂寞傍貧家。",
            "老來不得登高看，更甚残春惜歲華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 30
    },
    {
        "title": "敷溪橋院有感",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "昔歲攀遊景物同，药爐今在鶴归空。",
            "青山滿眼淚堪碧，絳帳无人花自紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 31
    },
    {
        "title": "寺閣",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "昔歲登臨未衰颯，不知何事愛傷情。",
            "今來攬鏡翻堪喜，乱后霜須長幾莖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 32
    },
    {
        "title": "武陵路",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "橘岸舟間罾網掛，茶坡日暖鷓鴣啼。",
            "女郎指點行人笑，知向花間路已迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 33
    },
    {
        "title": "南北史感遇十首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "雨淋麟閣名臣画，雪臥龍庭猛将碑。",
            "不用黃金鑄侯印，盡輸公子買蛾眉。",
            "漢世频封万戶侯，雲台空峻謝风流。",
            "江南不有名儒相，齒冷中原笑未休。",
            "天风斡海怒長鯨，永固南來百万兵。",
            "若向滄洲犹笑傲，江山虛有石頭城。",
            "花迷公子玉樓恩，鏡弄佳人紅粉春。",
            "不信關山勞遠戍，綺羅香外任行塵。",
            "兵圍梁殿金甌破，火發陳宮玉樹摧。",
            "奸佞豈能慚誤國，空令懷古更徘徊。",
            "行樂最宜連夜景，太平方觉有春风。",
            "千金盡把酬歌舞，犹勝三邊賞戰功。",
            "桃芳李豔年年發，羌管蠻弦处处多。",
            "海上應无三島路，人間惟有一聲歌。",
            "佳人自折一枝紅，把唱新詞曲未終。",
            "惟向眼前怜易落，不如拋擲任春风。",
            "景阳樓下花鈿鏡，玄武湖邊錦繡旗。",
            "昔日繁華今日恨，雉媒聲晚草芳时。",
            "乱后人間盡不平，秦川花木最傷情。",
            "无窮紅豔紅塵裏，驟馬分香散入營。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 34
    },
    {
        "title": "狂題二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "草堂舊隱犹招我，煙閣英才不見君。",
            "惆悵故山归未得，酒狂叫斷暮天雲。",
            "須知世乱身難保，莫喜天晴菊並開。",
            "長短此身長是客，黃花更助白頭催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 35
    },
    {
        "title": "紅茶花",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "景物诗人見即誇，豈怜高韵说紅茶。",
            "牡丹枉用三春力，開得方知不是花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 36
    },
    {
        "title": "秋燕",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "從撲香塵拂面飛，怜渠只為解相依。",
            "經冬好近深爐暖，何必千岩万水归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 37
    },
    {
        "title": "見后雁有感",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "笑爾窮通亦似人，高飛偶滯莫悲辛。",
            "卻緣风雪频相阻，只向關中待得春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 38
    },
    {
        "title": "移桃栽",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "独臨官路易傷摧，從遣春风恣意開。",
            "禪客笑移山上看，流鶯直到檻前來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 39
    },
    {
        "title": "憶中條",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "燕辭旅舍人空在，螢出疏籬菊正芳。",
            "堪恨昔年聯句地，念經僧掃過重阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 40
    },
    {
        "title": "樂府",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "五更窗下簇妝台，已怕堂前阿母催。",
            "滿鴨香熏鸚鵡睡，隔簾燈照牡丹開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 41
    },
    {
        "title": "放龜二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "卻為多知自不靈，今朝教汝卜長生。",
            "若求深处无深处，只有依人會有情。",
            "世外犹迷不死庭，人間莫恃自无營。",
            "本期滄海堪投跡，卻向朱門待放生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 42
    },
    {
        "title": "燈花三首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "蜀柳絲絲冪画樓，窗塵滿鏡不梳頭。",
            "幾时金雁傳归信，剪斷香魂一縷愁。",
            "姊姊教人且抱兒，逐他女伴卸頭迟。",
            "明朝鬥草多應喜，翦得燈花自掃眉。",
            "閏前小雪過經旬，犹自依依向主人。",
            "開盡菊花怜強舞，与教弟子待新春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 43
    },
    {
        "title": "偶題三首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "浮世悠悠旋一空，多情偏解挫英雄。",
            "风光只在歌聲裏，不必樓前万樹紅。",
            "小池隨事有风荷，燒酹傾壺一曲歌。",
            "欲待秋塘擎露看，自怜生意已无多。",
            "遼阳音信近來稀，縱有虛傳逼節归。",
            "永日无人新睡觉，小窗晴暖螖蟲飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 44
    },
    {
        "title": "華下对菊",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "清香裛露对高齋，泛酒偏能浣旅懷。",
            "不似春风逞紅豔，鏡前空墜玉人釵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 45
    },
    {
        "title": "与都統參謀书有感",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "驚鸞迸鹭盡归林，弱羽低垂分独沈。",
            "帶病深山犹草檄，昭陵應识老臣心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 46
    },
    {
        "title": "漫題",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "无宦无名拘逸興，有歌有酒任他鄉。",
            "看看万里休征戍，莫向新詞寄斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 47
    },
    {
        "title": "商山二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "清溪一路照羸身，不似雲台画像人。",
            "國史数行犹有志，只将談笑繼英塵。",
            "馬上搜奇已数篇，籍中犹愧是頑仙。",
            "關頭傳说開元事，指點多疑孟浩然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 48
    },
    {
        "title": "与伏牛長老偈二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "不算菩提与闡提，惟應執著便生迷。",
            "无端指個清涼地，凍殺胡僧雪嶺西。",
            "長繩不見系空虛，半偈傳心亦未疏。",
            "推倒我山无一事，莫将文字縛真如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 49
    },
    {
        "title": "客中重九",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "楚老相逢淚滿衣，片名薄宦已知非。",
            "他鄉不似人間路，應共東流更不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 50
    },
    {
        "title": "柳二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "谁家按舞傍池塘，已見繁枝嫩眼黃。",
            "漫说早梅先得意，不知春力暗分张。",
            "似擬淩寒妒早梅，无端弄色傍高臺。",
            "折來未有新枝長，莫遣佳人更折來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 51
    },
    {
        "title": "光啟丁未別山",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "草堂琴画已判燒，犹托鄰僧護燕巢。",
            "此去不緣名利去，若逢逋客莫相嘲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 52
    },
    {
        "title": "石楠",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "客处偷闲未是閑，石楠雖好懶频攀。",
            "如何风葉西归路，吹斷寒雲見故山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 53
    },
    {
        "title": "力疾馬上走筆",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "釀黍長添不盡杯，只憂花盡客空回。",
            "垂楊且為晴遮日，留遇重阳即放開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 54
    },
    {
        "title": "華阴縣樓",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "丹霄能有幾層梯，懶更揚鞭聳翠蜺。偶凭危欄且南望，不勞高掌欲相攜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 55
    },
    {
        "title": "南至四首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "今冬臘后无残日，故國燒來有幾家。",
            "卻恨早梅添旅思，強偷春力報年華。",
            "花时不是偏愁我，好事應難總取他。",
            "已被诗魔長役思，眼中莫厭早梅多。",
            "年華乱后偏堪惜，世路拋來已自生。",
            "犹有玉真長命縷，樽前时唱緩羈情。",
            "一任喧闐繞四鄰，閑忙皆是自由身。",
            "人來客去還須議，莫遣他人作主人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 56
    },
    {
        "title": "蓮峰前軒",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "人間上壽若能添，只向人間也不嫌。",
            "看著四鄰花競發，高樓從此莫垂簾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 57
    },
    {
        "title": "步虛",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "阿母親教學步虛，三元長遣下蓬壺。",
            "雲韶韵俗停瑤瑟，鸞鶴飛低拂寶爐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 58
    },
    {
        "title": "劍器",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "樓下公孫昔擅場，空教女子愛军裝。",
            "潼關一敗吳兒喜，簇馬驪山看禦湯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 59
    },
    {
        "title": "乙丑人日",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "自怪扶持七十身，归來又見故鄉春。",
            "今朝人日逢人喜，不料偷生作老人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 60
    },
    {
        "title": "攜仙籙九首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "嶽北秋空渭北川，晴雲漸薄薄如煙。",
            "坐來還見微风起，吹散残阳一片蟬。",
            "一半晴空一半雲，遠籠仙掌日初曛。",
            "洞天有路不知处，絕頂異香難更闻。",
            "決事還須更事酬，清譚妙理一时休。",
            "漁翁亦被机心誤，眼暗汀邊結釣鉤。",
            "跡不趨时分不侯，功名身外最悠悠。",
            "聽君總画麒麟閣，還我閑眠舴艋舟。",
            "仙凡路阻两難留，煙樹人間一片秋。",
            "若道阴功能濟活，且将方寸自焚修。",
            "若有阴功救未然，玉皇品籍亦搜賢。",
            "應知譚笑還高謝，別就滄洲贊上仙。",
            "英名何用苦搜奇，不朽才銷一句诗。",
            "卻賴风波阻三島，老臣犹得戀明时。",
            "剪取紅雲剩写诗，年年高會趁花时。",
            "水精樓閣分明見，只欠霞漿別著旗。",
            "此生得作太平人，只向塵中便出塵。",
            "移取碧桃花万樹，年年自樂故鄉春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 61
    },
    {
        "title": "浪淘沙",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "不必長漂玉洞花，曲中偏愛浪淘沙。",
            "黃河卻勝天河水，万里縈紆入漢家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 62
    },
    {
        "title": "贈日東鑒禪師",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "故國无心度海潮，老禪方丈倚中條。",
            "夜深雨絕松堂靜，一點飛螢照寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 63
    },
    {
        "title": "暮春对柳二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "縈愁惹恨奈楊花，閉戶垂簾亦滿家。",
            "惱得闲人作酒病，剛須又撲越溪茶。",
            "洞中犹说看桃花，輕絮狂飛自俗家。",
            "正是階前開遠信，小娥旋拂碾新茶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 64
    },
    {
        "title": "戊午三月晦二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "隨风逐浪劇蓬萍，圓首何曾解最靈。",
            "筆硯近來多自棄，不關妖气暗文星。",
            "牛誇棋品无勍敵，謝占诗家作上流。",
            "豈似小敷春水漲，年年鸞鶴待仙舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 65
    },
    {
        "title": "偶书五首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "情知了得未如僧，客处高樓莫強登。",
            "鶯也解啼花也發，不關心事最堪憎。",
            "自有池荷作扇搖，不關风動愛芭蕉。",
            "只怜直上抽紅蕊，似我丹心向本朝。",
            "曾看輕舟渡遠津，无风著岸不經旬。",
            "只緣命蹇須知命，卻是人爭阻得人。",
            "上谷何曾解有情，有情人自惜君行。",
            "證因池上今生愿，的的他生作化生。",
            "新店南原后夜程，黃河风浪信難平。",
            "渡頭楊柳知人意，為惹官船莫放行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 66
    },
    {
        "title": "喜山鵲初归三首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "翠衿紅觜便知机，久避重羅穩处飛。",
            "只為從來偏護惜，窗前今賀主人归。",
            "山中只是惜珍禽，语不分明识爾心。",
            "若使解言天下事，燕台今築幾千金。",
            "阻他羅網到柴扉，不奈偷倉雀轉肥。",
            "賴爾林塘添景趣，剩留山果引教归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 67
    },
    {
        "title": "虞鄉北原",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "澤北村貧煙火獰，稚田冬旱倩牛耕。",
            "老人惆悵逢人訴，開盡黃花麥未金。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 68
    },
    {
        "title": "洛中三首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "秋风團扇未驚心，笑看妝台落葉侵。",
            "繡鳳不教金縷暗，青樓何处有寒砧。",
            "不用频嗟世路難，浮生各自系悲歡。",
            "风霜一夜添羈思，羅綺谁家待早寒。",
            "燕巢空后谁相伴，鴛被縫來不忍熏。",
            "薄命敢辭長滴淚，倡家未必肯留君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 69
    },
    {
        "title": "寓筆",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "年年鑷鬢到花飄，依舊花繁鬢易凋。",
            "撩乱一場人更恨，春风谁道勝輕飆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 70
    },
    {
        "title": "戲題試衫",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "朝班盡说人宜紫，洞府應无鶴著緋。",
            "從此玉皇須破例，染霞裁賜地仙衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 71
    },
    {
        "title": "汴柳半枯因悲柳中隱",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "行人莫歎前朝樹，已占河堤幾百春。",
            "惆悵題诗柳中隱，柳衰犹在自无身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 72
    },
    {
        "title": "上方",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "花落更同悲木落，鶯聲相续即蟬聲。",
            "榮枯了得无多事，只是闲人漫系情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 73
    },
    {
        "title": "寄王贊學",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "黃卷不關兼濟业，青山自保老閑身。",
            "一行万里纖塵靜，可要张仪更入秦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 74
    },
    {
        "title": "新節",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "轉悲新歲重於山，不似輕鸥肯複還。",
            "朱紱縱教金印换，青雲未勝白頭閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 75
    },
    {
        "title": "自河西归山二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "一水悠悠一葉危，往來長恨阻归期。",
            "鄉關不是无華表，自為多驚独上迟。",
            "水闊风驚去路危，孤舟欲上更迟迟。",
            "鶴群長擾三珠樹，不借人間一隻騎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 76
    },
    {
        "title": "王官二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "风荷似醉和花舞，沙鳥无情伴客閑。",
            "總是此中皆有恨，更堪微雨半遮山。",
            "荷塘煙罩小齋虛，景物皆宜入画图。",
            "盡日无人只高臥，一雙白鳥隔紗廚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 77
    },
    {
        "title": "賀翰林侍郎二首",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "太白東归鶴背吟，鏡湖空在酒船沈。",
            "今朝忽見銀台事，早晚重征入翰林。",
            "玉版征书洞裏看，沈羲新拜侍郎官。",
            "文星喜气連台曜，圣主方知四海安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 78
    },
    {
        "title": "寄王十四舍人",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "幾年汶上約同遊，擬為蓮峰別置樓。",
            "今日鳳凰池畔客，五千仞雪不回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 79
    },
    {
        "title": "綸閣有感",
        "author": "司空图",
        "biography": "",
        "paragraphs": [
            "风濤曾阻化鱗來，谁料蓬瀛路卻開。",
            "欲去迟迟還自笑，狂才應不是仙才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十三",
        "no#": 80
    }
]