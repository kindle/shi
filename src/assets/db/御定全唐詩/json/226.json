[
    {
        "title": "蜀相",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "丞相祠堂何处尋，錦官城外柏森森。映階碧草自春色，",
            "出師未捷身先死，長使英雄淚滿襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 1
    },
    {
        "title": "卜居",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "浣花流水水西頭，主人為卜林塘幽。已知出郭少塵事，",
            "東行万里堪乘興，須向山阴上小舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 2
    },
    {
        "title": "一室",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "一室他鄉遠，空林暮景懸。正愁闻塞笛，独立見江船。",
            "巴蜀來多病，荊蠻去幾年。應同王粲宅，留井峴山前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 3
    },
    {
        "title": "梅雨",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "南京西浦道，四月熟黃梅。湛湛長江去，冥冥細雨來。",
            "茅茨疏易濕，雲霧密難開。竟日蛟龍喜，盤渦与岸回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 4
    },
    {
        "title": "為農",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "錦裏煙塵外，江村八九家。圓荷浮小葉，細麥落輕花。",
            "卜宅從茲老，為農去國賒。遠慚句漏令，不得问丹砂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 5
    },
    {
        "title": "有客",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "幽棲地僻經過少，老病人扶再拜難。豈有文章驚海內，",
            "不嫌野外无供給，乘興還來看药欄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 6
    },
    {
        "title": "賓至",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "患气經时久，臨江卜宅新。喧卑方避俗，疏快頗宜人。",
            "有客過茅宇，呼兒正葛巾。自鋤稀菜甲，小摘為情親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 8
    },
    {
        "title": "王十五司馬弟出郭相訪，兼遺營茅屋貲",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "客裏何遷次，江邊正寂寥。肯來尋一老，愁破是今朝。",
            "憂我營茅棟，攜錢過野橋。他鄉唯表弟，還往莫辭遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 9
    },
    {
        "title": "堂成",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "背郭堂成蔭白茅，緣江路熟俯青郊。榿林礙日吟风葉，",
            "旁人錯比揚雄宅，懶惰无心作解嘲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 10
    },
    {
        "title": "田舍",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "田舍清江曲，柴門古道旁。草深迷市井，地僻懶衣裳。",
            "櫸柳枝枝弱，枇杷樹樹香。鸕鷀西日照，曬翅滿魚梁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 11
    },
    {
        "title": "進艇",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "南京久客耕南畝，北望傷神坐北窗。晝引老妻乘小艇，",
            "茗飲蔗漿攜所有，瓷罌无謝玉為缸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 12
    },
    {
        "title": "西郊",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "时出碧雞坊，西郊向草堂。市橋官柳細，江路野梅香。",
            "傍架齊书帙，看題減药囊。无人觉來往，疏懶意何長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 13
    },
    {
        "title": "所思",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "苦憶荊州醉司馬，謫官樽俎定常開。九江日落醒何处，",
            "故凭錦水将雙淚，好過瞿塘灩澦堆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 14
    },
    {
        "title": "江村",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "清江一曲抱村流，長夏江村事事幽。自去自來堂上燕，",
            "多病所須唯药物，微軀此外更何求。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 15
    },
    {
        "title": "江漲",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "江漲柴門外，兒童報急流。下床高数尺，倚杖沒中洲。",
            "細動迎风燕，輕搖逐浪鸥。漁人縈小楫，容易拔船頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 16
    },
    {
        "title": "野老",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "野老籬前江岸回，柴門不正逐江開。漁人網集澄潭下，",
            "王師未報收東郡，城闕秋生画角哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 17
    },
    {
        "title": "雲山",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "京洛雲山外，音书靜不來。神交作賦客，力盡望鄉台。",
            "衰疾江邊臥，親朋日暮回。白鸥元水宿，何事有餘哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 18
    },
    {
        "title": "遣興",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "干戈犹未定，弟妹各何之。拭淚沾襟血，梳頭滿面絲。",
            "地卑荒野大，天遠暮江迟。衰疾那能久，應无見汝时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 19
    },
    {
        "title": "北鄰",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "明府豈辭滿，藏身方告勞。青錢買野竹，白幘岸江皋。",
            "愛酒晉山簡，能诗何水曹。时來訪老疾，步屟到蓬蒿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 20
    },
    {
        "title": "南鄰",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "錦裏先生烏角巾，園收芋粟不全貧。慣看賓客兒童喜，",
            "白沙翠竹江村暮，相对柴門月色新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 21
    },
    {
        "title": "出郭",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "霜露晚淒淒，高天逐望低。遠煙鹽井上，斜景雪峰西。",
            "故國犹兵馬，他鄉亦鼓鼙。江城今夜客，還与舊烏啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 22
    },
    {
        "title": "過南鄰朱山人水亭",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "相近竹參差，相過人不知。幽花欹滿樹，小水細通池。",
            "归客村非遠，残樽席更移。看君多道气，從此数追隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 23
    },
    {
        "title": "恨別",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "洛城一別四千里，胡騎長驅五六年。草木變衰行劍外，",
            "闻道河阳近乘勝，司徒急為破幽燕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 24
    },
    {
        "title": "寄賀蘭銛",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "朝野歡娛后，乾坤震盪中。相隨万里日，總作白頭翁。",
            "歲晚仍分袂，江邊更轉蓬。勿雲俱異域，飲啄幾回同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 25
    },
    {
        "title": "寄楊五桂州譚",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "五嶺皆炎熱，宜人独桂林。梅花万里外，雪片一冬深。",
            "闻此寬相憶，為邦複好音。江邊送孫楚，遠附白頭吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 26
    },
    {
        "title": "逢唐興劉主簿弟",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "分手開元末，連年絕尺书。江山且相見，戎馬未安居。",
            "劍外官人冷，關中驛騎疏。輕舟下吳會，主簿意何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 27
    },
    {
        "title": "和裴迪登新津寺寄王侍郎",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "何限倚山木，吟诗秋葉黃。蟬聲集古寺，鳥影度寒塘。",
            "风物悲遊子，登臨憶侍郎。老夫貪佛日，隨意宿僧房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 28
    },
    {
        "title": "敬簡王明府",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "葉縣郎官宰，周南太史公。神仙才有数，流落意无窮。",
            "驥病思偏秣，鷹愁怕苦籠。看君用高義，恥与万人同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 29
    },
    {
        "title": "重簡王明府",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "甲子西南異，冬來隻薄寒。江雲何夜盡，蜀雨幾时幹。",
            "行李須相问，窮愁豈有寬。君聽鴻雁響，恐致稻粱難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 30
    },
    {
        "title": "建都十二韵",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "蒼生未蘇息，胡馬半乾坤。議在雲臺上，谁扶黃屋尊。",
            "建都分魏闕，下韶辟荊門。恐失東人望，其如西极存。",
            "时危當雪恥，计大豈輕論。雖倚三階正，終愁万國翻。",
            "牽裾恨不死，漏網荷殊恩。永負漢庭哭，遙怜湘水魂。",
            "窮冬客江劍，隨事有田園。风斷青蒲節，霜埋翠竹根。",
            "衣冠空穰穰，關輔久昏昏。愿枉長安日，光輝照北原。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 31
    },
    {
        "title": "歲暮",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "歲暮遠為客，邊隅還用兵。煙塵犯雪嶺，鼓角動江城。",
            "天地日流血，朝廷谁請纓。濟时敢愛死，寂寞壯心驚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 32
    },
    {
        "title": "和裴迪登蜀州東亭送客逢早梅相憶見寄",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "東閣官梅動诗興，還如何遜在揚州。此时对雪遙相憶，",
            "江邊一樹垂垂發，朝夕催人自白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 33
    },
    {
        "title": "寄贈王十将军承俊",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "将军膽气雄，臂懸两角弓。纏結青驄馬，出入錦城中。",
            "时危未授鉞，勢屈難為功。賓客滿堂上，何人高義同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 34
    },
    {
        "title": "暮登四安寺鐘樓寄裴十",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "暮倚高樓对雪峰，僧來不语自鳴鐘。孤城返照紅将斂，",
            "知君苦思緣诗瘦，大向交遊万事慵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 35
    },
    {
        "title": "散愁二首",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "久客宜旋旆，興王未息戈。蜀星阴見少，江雨夜闻多。",
            "百万傳深入，寰區望匪它。司徒下燕趙，收取舊山河。",
            "闻道並州鎮，尚书訓士齊。幾时通薊北，當日報關西。",
            "戀闕丹心破，沾衣皓首啼。老魂招不得，归路恐長迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 36
    },
    {
        "title": "奉酬李都督表丈早春作",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "力疾坐清曉，來时悲早春。轉添愁伴客，更觉老隨人。",
            "紅入桃花嫩，青归柳葉新。望鄉應未已，四海尚风塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 37
    },
    {
        "title": "客至",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "舍南舍北皆春水，但見群鸥日日來。花徑不曾緣客掃，",
            "肯与鄰翁相对飲，隔籬呼取盡餘杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 38
    },
    {
        "title": "遣意二首",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "囀枝黃鳥近，泛渚白鸥輕。一徑野花落，孤村春水生。",
            "衰年催釀黍，細雨更移橙。漸喜交遊絕，幽居不用名。",
            "簷影微微落，津流脈脈斜。野船明細火，宿雁聚圓沙。",
            "雲掩初弦月，香傳小樹花。鄰人有美酒，稚子夜能賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 39
    },
    {
        "title": "漫成二首",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "野日荒荒白，春流泯泯清。渚蒲隨地有，村徑逐門成。",
            "只作披衣慣，常從漉酒生。眼前无俗物，多病也身輕。",
            "江皋已仲春，花下複清晨。仰面貪看鳥，回頭錯應人。",
            "讀书難字過，对酒滿壺频。近识峨眉老，知予懶是真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 40
    },
    {
        "title": "春夜喜雨",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "好雨知时節，當春乃發生。隨风潛入夜，潤物細无聲。",
            "野徑雲俱黑，江船火独明。曉看紅濕处，花重錦官城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 41
    },
    {
        "title": "春水",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "三月桃花浪，江流復舊痕。朝來沒沙尾，碧色動柴門。",
            "接縷垂芳餌，連筒灌小園。已添无数鳥，爭浴故相喧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 42
    },
    {
        "title": "春水生二絕",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "二月六夜春水生，門前小灘渾欲平。",
            "鸕鷀鸂鶒莫漫喜，吾与汝曹俱眼明。",
            "一夜水高二尺強，数日不可更禁當。",
            "南市津頭有船賣，无錢即買系籬旁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 43
    },
    {
        "title": "江亭",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "坦腹江亭暖，長吟野望时。水流心不競，雲在意俱迟。",
            "寂寂春将晚，欣欣物自私。故林归未得，排悶強裁诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 44
    },
    {
        "title": "村夜",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "蕭蕭风色暮，江頭人不行。村舂雨外急，鄰火夜深明。",
            "胡羯何多難，漁樵寄此生。中原有兄弟，万里正含情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 45
    },
    {
        "title": "早起",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "春來常早起，幽事頗相關。帖石防隤岸，開林出遠山。",
            "一丘藏曲折，緩步有躋攀。童僕來城市，瓶中得酒還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 46
    },
    {
        "title": "可惜",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "花飛有底急，老去愿春迟。可惜歡娛地，都非少壯时。",
            "寬心應是酒，遣興莫過诗。此意陶潛解，吾生后汝期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 47
    },
    {
        "title": "落日",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "落日在簾鉤，溪邊春事幽。芳菲緣岸圃，樵爨倚灘舟。",
            "啅雀爭枝墜，飛蟲滿院遊。濁醪谁造汝，一酌散千憂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 48
    },
    {
        "title": "独酌",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "步屨深林晚，開樽独酌迟。仰蜂黏落絮，行蟻上枯梨。",
            "薄劣慚真隱，幽偏得自怡。本无軒冕意，不是傲當时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 49
    },
    {
        "title": "徐步",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "整履步青蕪，荒庭日欲晡。芹泥隨燕觜，花蕊上蜂須。",
            "把酒從衣濕，吟诗信杖扶。敢論才見忌，實有醉如愚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 50
    },
    {
        "title": "寒食",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "寒食江村路，风花高下飛。汀煙輕冉冉，竹日靜暉暉。",
            "田父要皆去，鄰家鬧不違。地偏相识盡，雞犬亦忘归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 51
    },
    {
        "title": "高楠",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "楠樹色冥冥，江邊一蓋青。近根開药圃，接葉制茅亭。",
            "落景阴犹合，微风韵可聽。尋常絕醉困，臥此片时醒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 52
    },
    {
        "title": "惡樹",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "独繞虛齋徑，常持小斧柯。幽阴成頗雜，惡木剪還多。",
            "枸杞因吾有，雞棲奈汝何。方知不材者，生長漫婆娑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 53
    },
    {
        "title": "石鏡",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "蜀王将此鏡，送死置空山。冥寞怜香骨，提攜近玉顏。",
            "眾妃无複歎，千騎亦虛還。独有傷心石，埋輪月宇間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 54
    },
    {
        "title": "琴台",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "茂陵多病后，尚愛卓文君。酒肆人間世，琴台日暮雲。",
            "野花留寶靨，蔓草見羅裙。归鳳求皇意，寥寥不復闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 55
    },
    {
        "title": "闻斛斯六官未归",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "故人南郡去，去索作碑錢。本賣文為活，翻令室倒懸。",
            "荊扉深蔓草，土銼冷疏煙。老甘休无賴，归來省醉眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 56
    },
    {
        "title": "游修觉寺",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "野寺江天豁，山扉花竹幽。诗應有神助，吾得及春遊。",
            "徑石相縈帶，川雲自去留。禪枝宿眾鳥，漂轉暮归愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 57
    },
    {
        "title": "后游",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "寺憶新遊处，橋怜再渡时。江山如有待，花柳更无私。",
            "野潤煙光薄，沙暄日色迟。客愁全為減，舍此複何之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 58
    },
    {
        "title": "題新津北橋樓",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "望极春城上，開筵近鳥巢。白花簷外朵，青柳檻前梢。",
            "池水觀為政，廚煙觉遠庖。西川供客眼，唯有此江郊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 59
    },
    {
        "title": "江漲",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "江發蠻夷漲，山添雨雪流。大聲吹地轉，高浪蹴天浮。",
            "魚鱉為人得，蛟龍不自謀。輕帆好去便，吾道付滄洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 60
    },
    {
        "title": "晚晴",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "村晚驚风度，庭幽過雨沾。夕阳熏細草，江色映疏簾。",
            "书乱谁能帙，懷幹可自添。时闻有餘論，未怪老夫潛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 61
    },
    {
        "title": "朝雨",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "涼气晚蕭蕭，江雲乱眼飄。风鴛藏近渚，雨燕集深條。",
            "黃綺終辭漢，巢由不見堯。草堂樽酒在，幸得過清朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 62
    },
    {
        "title": "江上值水如海勢，聊短述",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "為人性僻耽佳句，语不驚人死不休。老去诗篇渾漫興，",
            "焉得思如陶謝手，令渠述作与同遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 63
    },
    {
        "title": "送裴五赴東川",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "故人亦流落，高義動乾坤。何日通燕塞，相看老蜀門。",
            "東行應暫別，北望苦銷魂。凜凜悲秋意，非君谁与論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 64
    },
    {
        "title": "赴青城縣出成都，寄陶、王二少尹",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "老恥妻孥笑，貧嗟出入勞。客情投異縣，诗態憶吾曹。",
            "東郭滄江合，西山白雪高。文章差底病，回首興滔滔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 65
    },
    {
        "title": "因崔五侍禦寄高彭州",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "百年已過半，秋至轉饑寒。為问彭州牧，何时救急難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 66
    },
    {
        "title": "野望因過常少仙",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "野橋齊度馬，秋望轉悠哉。竹覆青城合，江從灌口來。",
            "入村樵徑引，嘗果栗皺開。落盡高天日，幽人未遣回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 67
    },
    {
        "title": "寄杜位",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "近闻寬法離新州，想見懷归尚百憂。逐客雖皆万里去，",
            "玉壘題书心緒乱，何时更得曲江遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 68
    },
    {
        "title": "奉簡高三十五使君",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "當代論才子，如公複幾人。驊騮開道路，鷹隼出风塵。",
            "行色秋将晚，交情老更親。天涯喜相見，披豁对吾真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 69
    },
    {
        "title": "送韓十四江東覲省",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "兵戈不見老萊衣，歎息人間万事非。我已无家尋弟妹，",
            "此別應須各努力，故鄉犹恐未同归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 70
    },
    {
        "title": "酬高使君相贈",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "古寺僧牢落，空房客寓居。故人供祿米，鄰舍与園蔬。",
            "雙樹容聽法，三車肯载书。草玄吾豈敢，賦或似相如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 71
    },
    {
        "title": "草堂即事",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "荒村建子月，独樹老夫家。霧裏江船渡，风前徑竹斜。",
            "寒魚依密藻，宿鹭起圓沙。蜀酒禁愁得，无錢何处賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 72
    },
    {
        "title": "魏十四侍禦就弊廬相別",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "有客騎驄馬，江邊问草堂。遠尋留药價，惜別到文場。",
            "入幕旌旗動，归軒錦繡香。时應念衰疾，书疏及滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 73
    },
    {
        "title": "徐九少尹見過",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "晚景孤村僻，行军数騎來。交新徒有喜，禮厚愧无才。",
            "賞靜怜雲竹，忘归步月臺。何當看花蕊，欲發照江梅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 74
    },
    {
        "title": "范二員外邈、吳十侍禦鬱特枉駕闕展待，聊寄此",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "暫往比鄰去，空闻二妙归。幽棲誠簡略，衰白已光輝。",
            "野外貧家遠，村中好客稀。論文或不愧，肯重款柴扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 75
    },
    {
        "title": "王十七侍御掄许攜酒至草堂奉寄此诗便請邀高三十五使君同到",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "老夫臥穩朝慵起，白屋寒多暖始開。江鸛巧當幽徑浴，",
            "戲假霜威促山簡，須成一醉習池回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 76
    },
    {
        "title": "王竟攜酒，高亦同過，共用寒字",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "臥病荒郊遠，通行小徑難。故人能領客，攜酒重相看。",
            "自愧无鮭菜，空煩卸馬鞍。移樽勸山簡，頭白恐风寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 77
    },
    {
        "title": "陪李七司馬皂江上觀造竹橋即日成往來之人免冬寒入水聊題短作簡李公二首",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "伐竹為橋結構同，褰裳不涉往來通。天寒白鶴归華表，",
            "合歡卻笑千年事，驅石何时到海東。",
            "把燭成橋夜，回舟坐客时。天高雲去盡，江迥月來迟。",
            "衰謝多扶病，招邀屡有期。異方乘此興，樂罷不无悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 78
    },
    {
        "title": "李司馬橋了承高使君自成都回",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "向來江上手紛紛，三日成功事出群。",
            "已傳童子騎青竹，總擬橋東待使君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 79
    },
    {
        "title": "少年行二首",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "莫笑田家老瓦盆，自從盛酒長兒孫。",
            "傾銀注瓦驚人眼，共醉終同臥竹根。",
            "巢燕養雛渾去盡，江花結子已无多。",
            "黃衫年少來宜数，不見堂前東逝波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 80
    },
    {
        "title": "野人送朱櫻",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "西蜀櫻桃也自紅，野人相贈滿筠籠。数回細写愁仍破，",
            "金盤玉箸无消息，此日嘗新任轉蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 81
    },
    {
        "title": "即事",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "百寶裝腰帶，真珠絡臂鞲。笑时花近眼，舞罷錦纏頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 82
    },
    {
        "title": "贈花卿",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "錦城絲管日紛紛，半入江风半入雲。",
            "此曲只應天上有，人間能得幾回闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 83
    },
    {
        "title": "少年行",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "馬上谁家薄媚郎，臨階下馬坐人床。",
            "不通姓字粗豪甚，指點銀瓶索酒嘗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 84
    },
    {
        "title": "觀李固請司馬弟山水图三首",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "簡易高人意，匡床竹火爐。寒天留遠客，碧海掛新图。",
            "雖对連山好，貪看絕島孤。群仙不愁思，冉冉下蓬壺。",
            "方丈渾連水，天臺總映雲。人間長見画，老去恨空闻。",
            "範蠡舟偏小，王喬鶴不群。此生隨万物，何路出塵氛。",
            "高浪垂翻屋，崩崖欲壓床。野橋分子細，沙岸繞微茫。",
            "紅浸珊瑚短，青懸薜荔長。浮查並坐得，仙老暫相将。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 85
    },
    {
        "title": "題桃樹",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "小徑升堂舊不斜，五株桃樹亦從遮。高秋總喂貧人實，",
            "寡妻群盜非今日，天下車书正一家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 86
    },
    {
        "title": "蕭八明府堤处覓桃栽",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "奉乞桃栽一百根，春前為送浣花村。",
            "河阳縣裏雖无数，濯錦江邊未滿園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 87
    },
    {
        "title": "從韋二明府续处覓綿竹",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "華軒藹藹他年到，綿竹亭亭出縣高。",
            "江上舍前无此物，幸分蒼翠拂波濤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 88
    },
    {
        "title": "凭何十一少府邕覓榿木栽",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "草堂塹西无樹林，非子谁複見幽心。",
            "飽闻榿木三年大，与致溪邊十畝阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 89
    },
    {
        "title": "凭韋少府班覓松樹子",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "落落出群非櫸柳，青青不朽豈楊梅。",
            "欲存老蓋千年意，為覓霜根数寸栽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 90
    },
    {
        "title": "又于韋处乞大邑瓷碗",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "大邑燒瓷輕且堅，扣如哀玉錦城傳。",
            "君家白碗勝霜雪，急送茅齋也可怜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 91
    },
    {
        "title": "詣徐卿覓果栽",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "草堂少花今欲栽，不问綠李与黃梅。",
            "石筍街中卻归去，果園坊裏為求來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 92
    },
    {
        "title": "贈別何邕",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "生死論交地，何由見一人。悲君隨燕雀，薄宦走风塵。",
            "綿谷元通漢，沱江不向秦。五陵花滿眼，傳语故鄉春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 93
    },
    {
        "title": "贈別鄭煉赴襄阳",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "戎馬交馳際，柴門老病身。把君诗過日，念此別驚神。",
            "地闊峨眉晚，天高峴首春。為於耆舊內，試覓姓龐人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 94
    },
    {
        "title": "重贈鄭煉",
        "author": "杜甫",
        "biography": "",
        "paragraphs": [
            "鄭子将行罷使臣，囊无一物獻尊親。",
            "江山路遠羈離日，裘馬谁為感激人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百二十六",
        "no#": 95
    }
]