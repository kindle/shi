[
    {
        "title": "酬崔法曹遺劍",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "臨风脫佩劍，相勸靜胡塵。自料无筋力，何由答故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 1
    },
    {
        "title": "敬報孫常州二首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "衰病苦奔走，未嘗追舊遊。何言问憔悴，此日駐方舟。",
            "遠道曳故屐，餘春會高齋。因言別離久，得盡平生懷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 2
    },
    {
        "title": "将赴東阳留上包諫議",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "敝邑連山遠，仙舟数刻同。多慚屡回首，前路在泥中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 3
    },
    {
        "title": "答崔法曹",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "后會知不遠，今歡亦愿留。江天梅雨散，況在月中樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 4
    },
    {
        "title": "问嚴居士易",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "自公來问易，不復待加年。更有垂簾會，遙知续草玄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 5
    },
    {
        "title": "新年第二夜答处上人宿玉芝觀見寄",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "阳春已三日，會友闻昨夜。可愛剡溪僧，独尋陶景舍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 6
    },
    {
        "title": "赴撫州对酬崔法曹夜雨滴空階五首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "雨落濕孤客，心驚比棲鳥。空階夜滴繁，相乱應到曉。",
            "高會枣樹宅，清言蓮社僧。两鄉同夜雨，旅館又无燈。",
            "謗議不自辨，親朋那得知。雨中驅馬去，非是独傷離。",
            "離室雨初晦，客程雲陡暗。方為对吏人，敢望郵童探。",
            "縱酒常擲盞，狂歌时入室。離群怨雨聲，幽抑方成疾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 7
    },
    {
        "title": "又酬曉燈離暗室五首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "知疑奸叟謗，閑与情人話。犹是別时燈，不眠同此夜。",
            "寒燈揚曉焰，重屋驚春雨。應想遠行人，路逢泥濘阻。",
            "燈光照虛屋，雨影懸空壁。一向簷下聲，遠來愁处滴。",
            "楚僧話寂滅，俗慮比虛空。賴有残燈喻，相傳昏暗中。",
            "雨聲乱燈影，明滅在空階。並枉五言贈，知同万里懷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 8
    },
    {
        "title": "同賦龍沙墅",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "回轉沙岸近，欹斜林嶺重。因君訪遺跡，此日見真龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 9
    },
    {
        "title": "昭君詞",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "漢宮若遠近，路在寒沙上。到死不得归，何人共南望。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 10
    },
    {
        "title": "勸陸三飲酒",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "寒郊好天气，勸酒莫辭频。擾擾鐘陵市，无窮不醉人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 11
    },
    {
        "title": "關山月二首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "月出照關山，秋风人未還。清光无遠近，鄉淚半书間。",
            "一雁過連營，繁霜覆古城。胡笳在何处，半夜起邊聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 12
    },
    {
        "title": "送王司直",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "西塞雲山遠，東风道路長。人心勝潮水，相送過潯阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 13
    },
    {
        "title": "宿无可上人房",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "偶來人境外，何处染囂塵。倘许棲林下，僧中老此身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 14
    },
    {
        "title": "山居",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "麋鹿自成群，何人到白雲。山中无外事，終日醉醺醺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 15
    },
    {
        "title": "口號",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "白发千莖雪，寒窗懶著书。最怜吟苜蓿，不及向桑榆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 16
    },
    {
        "title": "夜坐",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "夜靜河漢高，独坐庭前月。忽起故園思，動作經年別。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 17
    },
    {
        "title": "堤上柳",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "垂柳万條絲，春來織別離。行人攀折处，閨妾斷腸时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 18
    },
    {
        "title": "遣興",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "明月臨滄海，閑雲戀故山。诗名滿天下，終日掩柴關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 19
    },
    {
        "title": "贈张揮使",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "謫戍孤城小，思家万里遙。漢廷求衛霍，劍佩上青霄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 20
    },
    {
        "title": "偶成",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "野水連天碧，峰巒入海青。滄浪者谁子，一曲醉中聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 21
    },
    {
        "title": "画蟬",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "飲露身何潔，吟风韵更長。斜阳千万樹，无处避螳螂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 22
    },
    {
        "title": "題天柱山图",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "拔翠五雲中，擎天不计功。谁能淩絕頂，看取日升東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 23
    },
    {
        "title": "松鶴",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "雨濕松阴涼，风落松花細。独鶴愛清幽，飛來不飛去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 24
    },
    {
        "title": "草堂一上人",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "一公持一缽，相複度遙岑。地瘦无黃独，春來草更深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 25
    },
    {
        "title": "題黃司直園",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "為憶去年梅，淩寒特地來。門前空臘盡，渾未有花開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 26
    },
    {
        "title": "北山游亭",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "西崦水泠泠，沿岡有遊亭。自從春草長，遙見只青青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 27
    },
    {
        "title": "贈李唐山人",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "此意无所欲，閉門风景迟。柳條将白发，相对共垂絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 28
    },
    {
        "title": "題秦隱君麗句亭",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "北人归欲盡，犹自住蕭山。閉戶不曾出，诗名滿世間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 29
    },
    {
        "title": "答孫常州見憶",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "画鷁春风裏，迢遙去若飛。那能寄相憶，不並子猷归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 30
    },
    {
        "title": "送裴明州效南朝體",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "沅水連湘水，千波万浪中。知郎未得去，慚愧石尤风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 31
    },
    {
        "title": "戲留顧十一明府",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "江明雨初歇，山暗雲犹濕。未可動归橈，前程风浪急。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 32
    },
    {
        "title": "答崔载華",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "文案日成堆，愁眉拽不開。偷归甕間臥，逢個楚狂來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 33
    },
    {
        "title": "将赴行營勸客同醉",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "絲管霜天夜，煙塵淮水西。明朝上征去，相伴醉如泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 34
    },
    {
        "title": "夏夜江樓會別",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "不作十日別，煩君此相留。雨餘江上月，好醉竹間樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 35
    },
    {
        "title": "歲除日奉推事使牒追赴撫州辨对留別崔法曹陸大祝处士上人同賦人字口號",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "上國杳未到，流年忽複新。回車不自识，君定送何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 36
    },
    {
        "title": "江館會別",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "離亭一會宿，能有幾人同。莫以回車泣，前途不盡窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 37
    },
    {
        "title": "容州回逢陸三別",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "西南積水遠，老病喜生归。此地故人別，空餘淚滿衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 38
    },
    {
        "title": "古意寄呈王侍郎",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "夜光貯懷袖，待報一顧恩。日向江湖老，此心谁為論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 39
    },
    {
        "title": "送李大夫渡口阻风",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "浪息定何时，龍門到恐迟。輕舟不敢渡，空立望旌旗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 40
    },
    {
        "title": "過三閭廟",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "沅湘流不盡，屈宋怨何深。日暮秋煙起，蕭蕭楓樹林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 41
    },
    {
        "title": "泊湘口",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "湘山千嶺樹，桂水九秋波。露重猿聲絕，风清月色多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 42
    },
    {
        "title": "游道林寺",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "佳山路不遠，俗侶到常稀。及此煙霞暮，相看複欲归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 43
    },
    {
        "title": "后宮曲",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "初入長門宮，謂言君戲妾。寧知秋风至，吹盡庭前葉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 44
    },
    {
        "title": "新別離",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "手把杏花枝，未曾經別離。黃昏掩閨后，寂寞心自知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 45
    },
    {
        "title": "夏日登鶴岩偶成",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "天风吹我上層岡，露灑長松六月涼。",
            "愿借老僧雙白鶴，碧雲深处共翱翔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 46
    },
    {
        "title": "題淨居寺",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "玉壺山下雲居寺，六百年來選佛場。",
            "滿地白雲關不住，石泉流出落花香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 47
    },
    {
        "title": "昭君詞",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "漢家宮闕夢中归，幾度氈房淚濕衣。",
            "惆悵不如邊雁影，秋风犹得向南飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 48
    },
    {
        "title": "織女詞",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "鳳梭停織鵲无音，夢憶仙郎夜夜心。",
            "難得相逢容易別，銀河爭似妾愁深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 49
    },
    {
        "title": "塞上曲二首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "军門频納受降书，一劍橫行万里餘。",
            "漢祖謾誇婁敬策，卻将公主嫁單于。",
            "漢家旌幟滿阴山，不遣胡兒匹馬還。",
            "愿得此身長報國，何須生入玉門關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 50
    },
    {
        "title": "閨怨",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "看花无语淚如傾，多少春风怨別情。",
            "不识玉門關外路，夢中昨夜到邊城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 51
    },
    {
        "title": "春怨",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "金鴨香消欲斷魂，梨花春雨掩重門。",
            "欲知別后相思意，回看羅衣積淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 52
    },
    {
        "title": "旅次寄湖南张郎中",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "閉門茅底偶為鄰，北阮那怜南阮貧。",
            "卻是梅花无世態，隔牆分送一枝春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 53
    },
    {
        "title": "題友人山居",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "四郭青山处处同，客懷无计答秋风。",
            "数家茅屋清溪上，千樹蟬聲落日中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 54
    },
    {
        "title": "別鄭谷",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "朝阳齋前桃李樹，手栽清蔭接比鄰。",
            "明年此地看花發，愁向東风憶故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 55
    },
    {
        "title": "贈鶴林上人",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "日日澗邊尋茯芩，岩扉常掩鳳山青。",
            "归來掛衲高林下，自剪芭蕉写佛經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 56
    },
    {
        "title": "題稚川山水",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "松下茅亭五月涼，汀沙雲樹晚蒼蒼。",
            "行人无限秋风思，隔水青山似故鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 57
    },
    {
        "title": "過柳溪道院",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "溪上谁家掩竹扉，鳥啼渾似惜春暉。",
            "日斜深巷无人跡，时見梨花片片飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 58
    },
    {
        "title": "荔枝",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "紅顆真珠誠可愛，白須太守亦何癡。",
            "十年結子知谁在，自向中庭種荔枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 59
    },
    {
        "title": "憶原上人",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "一两棕鞋八尺藤，廣陵行遍又金陵。",
            "不知竹雨竹风夜，吟对秋山那寺燈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 60
    },
    {
        "title": "閑思",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "伯勞東去鶴西還，雲總无心亦度山。",
            "何似嚴陵灘上客，一竿長伴白鸥閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 61
    },
    {
        "title": "蘭溪棹歌",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "涼月如眉掛柳灣，越中山色鏡中看。",
            "蘭溪三日桃花雨，半夜鯉魚來上灘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 62
    },
    {
        "title": "蘇溪亭",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "蘇溪亭上草漫漫，谁倚東风十二闌。",
            "燕子不归春事晚，一汀煙雨杏花寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 63
    },
    {
        "title": "敬酬陸山人二首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "党議連誅不可闻，直臣高士去紛紛。",
            "當时漏奪无人问，出宰東阳笑殺君。",
            "由來海畔逐樵漁，奉詔因乘使者車。",
            "卻掌山中子男印，自看犹是舊潛夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 64
    },
    {
        "title": "答崔法曹賦四雪",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "楚僧躡雪來招隱，先訪高人積雪中。",
            "已別剡溪逢雪去，雪山修道与師同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 65
    },
    {
        "title": "撫州被推昭雪答陸太祝三首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "求理由來许便宜，漢朝龔遂不為疵。",
            "如今謗起翻成累，唯有新人子細知。",
            "貧交相愛果无疑，共向人間聽直詞。",
            "從古以來何限枉，慚知暗室不曾欺。",
            "春风旅館長庭蕪，俯首低眉一老夫。",
            "已对鐵冠窮事本，不知廷尉念冤无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 66
    },
    {
        "title": "送独孤cl還京",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "舉家相逐還鄉去，不向秋风怨別时。",
            "湖水两重山万里，定知行盡到京師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 67
    },
    {
        "title": "臨流送顧東阳",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "海上独归慚不及，邑中遺愛定无雙。",
            "蘭橈起唱逐流去，卻恨山溪通外江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 68
    },
    {
        "title": "行營送馬侍禦",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "万里羽书來未絕，五關烽火晝仍傳。",
            "故人多病盡归去，唯有劉楨不得眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 69
    },
    {
        "title": "送秦系",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "五都來往无舊业，一代公卿盡故人。",
            "不肯低頭受羈束，遠師溪上拂纓塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 70
    },
    {
        "title": "送裴判官回湖南",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "莫怕南风且盡歡，湘山多雨夏中寒。",
            "送君万里不觉遠，此地曾為心鐵官。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 71
    },
    {
        "title": "再巡道永留別",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "鬢下初驚白发时，更逢離別助秋悲。",
            "從今不學四方事，已共家人海上期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 72
    },
    {
        "title": "別崔法曹",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "欲作別離西入秦，芝田枣徑往來频。",
            "東湖此夕更留醉，逢著廬山學道人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 73
    },
    {
        "title": "送蕭二",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "擬向田間老此身，寒郊怨別甚於春。",
            "又闻故里朋遊盡，到日知逢何处人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 74
    },
    {
        "title": "湘川野望",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "懷王独与佞人謀，闻道忠臣入乱流。",
            "今日登高望不見，楚雲湘水各悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 75
    },
    {
        "title": "将至道州寄李使君",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "九疑深路繞山回，木落天清猿晝哀。",
            "犹隔簫韶一峰在，遙傳五馬向東來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 76
    },
    {
        "title": "与虞沔州謁藏真上人",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "故侯将我到山中，更上西峰見遠公。",
            "共问置心何处好，主人揮手指虛空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 77
    },
    {
        "title": "題招隱寺",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "昨日臨川謝病還，求田问舍独相關。",
            "宋时有井如今在，卻種胡麻不買山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 78
    },
    {
        "title": "過珥瀆單老",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "毫末成圍海變田，單家依舊住溪邊。",
            "比來已向人間老，今日相過卻少年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 79
    },
    {
        "title": "族兄各年八十餘見招游洞",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "鶴發婆娑鄉里親，相邀共看往年春。",
            "擬将兒女归來住，且是茅山見老人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 80
    },
    {
        "title": "登高回乘月尋僧",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "插鬢茱萸來未盡，共隨明月下沙堆。",
            "高緇寂寂不相问，醉客无端入定來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 81
    },
    {
        "title": "贈殷亮",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "日日河邊見水流，傷春未已複悲秋。",
            "山中舊宅无人住，來往风塵共白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 82
    },
    {
        "title": "夜發袁江寄李潁川劉侍禦",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "半夜回舟入楚鄉，月明山水共蒼蒼。",
            "孤猿更叫秋风裏，不是愁人亦斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 83
    },
    {
        "title": "对酒示申屠學士",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "三重江水万重山，山裏春风度日閑。",
            "且向白雲求一醉，莫教愁夢到鄉關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 84
    },
    {
        "title": "对月答袁明府",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "山下孤城月上迟，相留一醉本无期。",
            "明年此夕遊何处，縱有清光知对谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 85
    },
    {
        "title": "送前上饒嚴明府攝玉山",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "家在故林吳楚間，冰為溪水玉為山。",
            "更将舊政化鄰邑，遙見逋人相逐還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 86
    },
    {
        "title": "聽歌回馬上贈崔法曹",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "秋风裏许杏花開，杏樹傍邊醉客來。",
            "共待夜深聽一曲，醒人騎馬斷腸回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 87
    },
    {
        "title": "酬駱侍禦答诗",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "风傳画閣空知曉，雨濕江城不見春。",
            "堆案繞床君莫怪，已經愁思古时人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 88
    },
    {
        "title": "送孫直游郴州",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "孤舟上水過湘沅，桂嶺南枝花正繁。",
            "行客自知心有托，不闻驚浪与啼猿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 89
    },
    {
        "title": "麓山寺會送尹秀才",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "湖上逢君亦不閑，暫将離別到深山。",
            "飄蓬驚鳥那自定，強欲相留雲樹間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 90
    },
    {
        "title": "送董頲",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "霜雁群飛下楚田，羈人掩淚望秦天。",
            "君行江海无定所，別后相思何处邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 91
    },
    {
        "title": "別张員外",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "木葉紛紛湘水濱，此中何事往频频。",
            "臨风自笑归时晚，更送浮雲逐故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 92
    },
    {
        "title": "送张評事",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "城郭喧喧爭送遠，危梁嫋嫋渡東津。",
            "楊花輾轉引征騎，莫怪山中多看人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 93
    },
    {
        "title": "送呂少府",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "共醉流芳独归去，故園高士日相親。",
            "深山古路无楊柳，折取桐花寄遠人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 94
    },
    {
        "title": "送人游嶺南",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "少別華阳万里游，近南风景不曾秋。",
            "紅芳綠筍是行路，縱有啼猿聽卻幽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 95
    },
    {
        "title": "妻亡后別妻弟",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "楊柳青青滿路垂，贈行惟折古松枝。",
            "停舟一对湘江哭，哭罷无言君自知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 96
    },
    {
        "title": "和崔法曹建溪闻猿",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "曾向巫山峽裏行，羈猿一叫一回驚。",
            "闻道建溪腸欲斷，的知斷著第三聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 97
    },
    {
        "title": "湘南即事",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "盧橘花開楓葉衰，出門何处望京師。",
            "沅湘日夜東流去，不為愁人住少时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 98
    },
    {
        "title": "代书寄京洛舊游",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "今年十月溫风起，湘水悠悠生白蘋。欲寄遠书還不敢，卻愁驚動故鄉人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 99
    },
    {
        "title": "蘄州行營作",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "蘄水城西向北看，桃花落盡柳花残。",
            "朱旗半卷山川小，白馬連嘶草樹寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 100
    },
    {
        "title": "題武當逸禪師蘭若",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "我身本似遠行客，況是乱时多病身。",
            "經山涉水向何处，羞見竹林禪定人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 101
    },
    {
        "title": "谷城逢楊評事",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "遠自五陵独竄身，築阳山中归路新。",
            "橫流夜長不得渡，駐馬荒亭逢故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 102
    },
    {
        "title": "聽韓使君美人歌",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "仙人此夜忽淩波，更唱瑤台一遍歌。",
            "嫁与将军天上住，人間可得再相過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 103
    },
    {
        "title": "轉應詞",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "邊草，邊草，邊草盡來共老。山南山北雪晴，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 104
    },
    {
        "title": "精舍对雨",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "空門寂寂澹吾身，溪雨微微洗客塵。",
            "臥向白雲晴未盡，任他黃鳥醉芳春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 105
    },
    {
        "title": "宿灌阳灘",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "十月江邊蘆葉飛，灌阳灘冷上舟迟。",
            "今朝未遇高风便，還与沙鸥宿水湄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 106
    },
    {
        "title": "酬贈张眾甫",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "野人无本意，散木任天材。分向空山老，何言上苑來。",
            "迢遙千里道，依倚九層台。出处寧知命，輪轅豈自媒。",
            "更慚张处士，相与別蒿萊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 107
    },
    {
        "title": "客舍秋懷呈駱正字士則",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "无言堪自喻，偶坐更相悲。木落驚年長，門閑惜草衰。",
            "買山犹未得，諫獵又非时。設被浮名系，归休漸欲迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 108
    },
    {
        "title": "寄中书李舍人紓",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "萍翻蓬自卷，不共本心期。複入重城裏，频看百草滋。",
            "水流归思遠，花發長年悲。盡日春风起，无人見此时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 109
    },
    {
        "title": "贈康老人洽",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "酒泉布衣舊才子，少小知名帝城裏。一篇飛入九重門，",
            "南鄰北裏日經過，处处淹留樂事多。不脫弊裘輕錦綺，",
            "暗将心事隔风塵，盡擲年光逐杯酒。青門幾度見春归，",
            "繁霜入鬢何足論，舊國連天不知处。爾來倏忽五十年，",
            "百人會中一身在，被褐飲瓢終不改。陌頭車馬共營營，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 110
    },
    {
        "title": "暮春游長沙東湖贈辛兗州巢父二首",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "湘流分曲浦，繚繞古城東。岸轉千家合，林開一鏡空。",
            "人生无事少，心賞幾回同。且複忘羈束，悠悠落照中。",
            "回環路不盡，曆覽意彌新。古木佘田火，澄江蕩槳人。",
            "緩歌尋极浦，一醉送残春。莫恨長沙遠，他年憶此辰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 111
    },
    {
        "title": "同兗州张秀才過王侍禦參謀宅賦十韵",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "十年官不進，斂跡无怨咎。漂蕩海內遊，淹留楚鄉久。",
            "因參戎幕下，寄宅湘川口。翦竹開廣庭，瞻山敞虛牖。",
            "閑門早春至，陋巷新晴后。覆地落残梅，和风嫋輕柳。",
            "逢迎車馬客，邀結风塵友。意愜时會文，夜長聊飲酒。",
            "秉心轉孤直，沈照隨可否。豈學屈大夫，憂慚对漁叟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 112
    },
    {
        "title": "同辛兗州巢父虛副端岳相思獻酬之作因紓归懷兼呈辛魏二院長楊長寧",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "暮角發高城，情人坐中起。臨觴不及醉，分散秋风裏。",
            "雖有明日期，離心若千里。前歡反惆悵，后會還如此。",
            "焉得夜淹留，一回終宴喜。羈遊複牽役，皆去重湖水。",
            "早晚泛归舟，吾從数君子。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 113
    },
    {
        "title": "酬袁太祝長卿小湖村山居书懷見寄",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "背江居隙地，辭職作遺人。耕鑿資餘力，樵漁逐四鄰。",
            "麥秋桑葉大，梅雨稻田新。籬落栽山果，池塘養海鱗。",
            "放歌聊自足，幽思忽相親。餘亦归休者，依君老此身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 114
    },
    {
        "title": "送汶水王明府",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "何时別故鄉，归去佩銅章。親族移家盡，閭閻百戰場。",
            "背關餘古木，近塞足风霜。遺老應相賀，知君不下堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 115
    },
    {
        "title": "奉同汴州李相公勉送郭布殿中出巡",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "軒車出東閣，都邑繞南河。馬首先春至，人心比歲和。",
            "省风傳隱恤，持法去煩苛。卻想埋輪者，論功此日多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 116
    },
    {
        "title": "送東阳顧明府罷归",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "祖帳臨鮫室，黎人擁鷁舟。坐藍高士去，繼組鄙夫留。",
            "白日落寒水，青楓繞曲洲。相看作離別，一倍不禁愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 117
    },
    {
        "title": "撫州对事后送外生宋垓归饒州覲侍呈上姊夫",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "淮汴初喪乱，蔣山烽火起。与君隨親族，奔迸辭故里。",
            "京口附商客，海門正狂风。憂心不敢住，夜發驚浪中。",
            "雲開方見日，潮盡爐峰出。石壁轉棠阴，鄱阳寄茅室。",
            "淹留三十年，分種越人田。骨肉无半在，鄉園犹未旋。",
            "爾家習文藝，旁究天人際。父子自相傳，優遊聊卒歲。",
            "學成不求達，道勝那厭貧。时入閭巷醉，好是羲皇人。",
            "頃因物役牽，偶逐簪組輩。謗书喧朝市，撫己慚淺昧。",
            "世业大小禮，近通顏謝诗。念渠還領會，非敢独為師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 118
    },
    {
        "title": "永康孫明府頲秩滿将归枉路訪別",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "門前水流咽，城下乱山多。非是還家路，寧知枉騎過。",
            "风煙複欲隔，悲笑屡相和。不學陶公醉，无因奈別何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 119
    },
    {
        "title": "将赴湖南留別東阳舊僚兼示吏人",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "智力苦不足，黎甿殊未安。忽從新命去，複隔舊僚歡。",
            "曉路整車馬，離亭會衣冠。冰堅細流咽，燒盡乱峰寒。",
            "耆老相餞送，兒童亦悲酸。桐鄉寄生怨，欲話此情難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 120
    },
    {
        "title": "撫州处士胡泛見送北回两館至南昌縣界查溪蘭若別",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "移樽鋪山曲，祖帳查溪阴。鋪山即遠道，查溪非故林。",
            "淒然誦新诗，落淚沾素襟。郡政我何有，別情君独深。",
            "禪庭古樹秋，宿雨清沉沉。揮袂千里遠，悲傷去住心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 121
    },
    {
        "title": "将巡郴永途中作",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "行役留三楚，思归又一春。自疑冠下發，聊此鏡中人。",
            "机息知名誤，形衰恨道貧。空将舊泉石，長与夢相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 122
    },
    {
        "title": "桂阳北嶺偶過野人所居，聊书即事呈王永州邕李道州圻",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "犬吠空山響，林深一徑存。隔雲尋板屋，渡水到柴門。",
            "日晝风煙靜，花明草樹繁。乍疑秦世客，漸识楚人言。",
            "不記逃鄉里，居然長子孫。種田燒險谷，汲井鑿高原。",
            "畦葉藏春雉，庭柯宿旅猿。嶺阴无瘴癘，地隙有蘭蓀。",
            "內戶均皮席，枯瓢沃野餐。遠心知自負，幽賞詎能論。",
            "轉步重崖合，瞻途落照昏。他时愿攜手，莫比武陵源。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 123
    },
    {
        "title": "下鼻亭瀧行八十裏聊狀艱險，寄青苗鄭副端朔阳",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "瀧水天際來，鼻山地中坼。盤渦幾十处，疊溜皆千尺。",
            "直写卷沈沙，驚翻沖絕壁。淙淙振崖谷，洶洶竟朝夕。",
            "人语不自闻，日光乱相射。艤舟始搖漾，舉棹旋奔激。",
            "既下同建瓴，半空方避石。前危苦未盡，后險何其迫。",
            "倏閃疾风雷，蒼皇蕩魂魄。因隨伏流出，忽与跳波隔。",
            "遠想欲回軒，豈茲還泛鷁。雲涯多候館，努力勤登曆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 124
    },
    {
        "title": "少女生日感懷",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "五逢晬日今方見，置爾懷中自惘然。乍喜老身辭遠役，",
            "還有蔡家残史籍，可能分与外人傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 125
    },
    {
        "title": "张評事涉秦居士系見訪郡齋，即同賦中字",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "軺車忽枉轍，郡府自生风。遣吏山禽在，開樽野客同。",
            "古牆抽臘筍，喬木颺春鴻。能賦傳幽思，清言盡至公。",
            "城欹残照入，池曲大江通。此地人來少，相歡一醉中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 126
    },
    {
        "title": "小雪",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "花雪隨风不厭看，更多還肯失林巒。",
            "愁人正在书窗下，一片飛來一片寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 127
    },
    {
        "title": "句",
        "author": "戴叔倫",
        "biography": "",
        "paragraphs": [
            "鄰里龍沙北。。",
            "麥秋桑葉大，梅雨稻田新。籬落栽山果，池塘養錦鱗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百七十四",
        "no#": 128
    }
]