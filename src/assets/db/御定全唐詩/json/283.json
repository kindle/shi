[
    {
        "title": "竹窗闻风寄苗發司空曙",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "微风驚暮坐，臨牖思悠哉。開門複動竹，疑是故人來。",
            "时滴枝上露，稍沾階下苔。何當一入幌，為拂綠琴埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 1
    },
    {
        "title": "賦得垣衣",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "漠漠複霏霏，為君垣上衣。昭阳輦下草，應笑此生非。",
            "掩藹青春去，蒼茫白露稀。犹勝萍逐水，流浪不相依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 2
    },
    {
        "title": "送人流貶",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "漢章雖約法，秦律已除名。謗遠人多惑，官微不自明。",
            "霜风先独樹，瘴雨失荒城。疇昔長沙事，三年召賈生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 3
    },
    {
        "title": "送人南归",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "人言下江疾，君道下江迟。五月江路惡，南风驚浪时。",
            "應知近家喜，還有異鄉悲。无奈孤舟夕，山歌闻竹枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 4
    },
    {
        "title": "水亭夜坐賦得曉霧",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "月落寒霧起，沈思浩通川。宿禽囀木散，山澤一蒼然。",
            "漠漠沙上路，沄沄洲外田。犹當依遠樹，斷续欲窮天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 5
    },
    {
        "title": "送常曾侍禦使西蕃寄題西川",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "涼王宮殿盡，蕪沒隴雲西。今日闻君使，雄心逐鼓鼙。",
            "行當收漢壘，直可取蒲泥。舊國无由到，煩君下馬題。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 6
    },
    {
        "title": "入南山至全師蘭若",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "木隕水归壑，寂然无念心。南行有真子，被褐息山阴。",
            "石路瑤草散，松門寒景深。吾師亦何愛，自起定中吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 7
    },
    {
        "title": "送韓将军還邊",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "白馬羽林兒，揚鞭薄暮时。独将輕騎出，暗与伏兵期。",
            "雨雪移军遠，旌旗上壟迟。聖心戎寄重，未许讓恩私。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 8
    },
    {
        "title": "晚春臥病喜振上人見訪",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "臥床如舊日，窺戶易傷春。靈壽扶衰力，芭蕉對病身。",
            "道心空寂寞，时物自芳新。旦夕谁相訪，唯當攝上人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 9
    },
    {
        "title": "春行",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "侍臣朝謁罷，戚裏自相過。落日青絲騎，春风白紵歌。",
            "恩承三殿近，獵向五陵多。归路南橋望，垂楊拂細波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 10
    },
    {
        "title": "洛阳河亭奉酬留守群公追送",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "離亭餞落暉，臘酒減春衣。歲晚煙霞重，川寒雲樹微。",
            "戎裝千里至，舊路十年归。還似汀洲雁，相逢又背飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 11
    },
    {
        "title": "尋紀道士偶會諸叟",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "山阴尋道士，映竹羽衣新。侍坐雙童子，陪游五老人。",
            "水花松下靜，壇草雪中春。見说桃源洞，如今犹避秦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 12
    },
    {
        "title": "同蕭煉師宿太乙廟",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "微月空山曙，春祠謁少君。落花壇上拂，流水洞中闻。",
            "酒引芝童奠，香餘桂子焚。鶴飛将羽節，遙向赤城分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 13
    },
    {
        "title": "送同落第者東归",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "東門有行客，落日滿前山。聖代谁知者，滄洲今独還。",
            "片雲归海暮，流水背城閑。餘亦依嵩潁，松花深閉關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 14
    },
    {
        "title": "送柳判官赴振武",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "邊庭漢仪重，旌甲似雲中。虜地山川壯，單于鼓角雄。",
            "關寒塞榆落，月白胡天风。君逐嫖姚将，麒麟有戰功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 15
    },
    {
        "title": "述懷寄衡州令狐相公",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "調元方翼聖，軒蓋忽言東。道以中樞密，心将外理同。",
            "白頭生遠浪，丹葉下高楓。江上蕭疏雨，何人對謝公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 16
    },
    {
        "title": "喜入蘭陵望紫閣峰呈宣上人",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "薙草開三徑，巢林喜一枝。地寬留種竹，泉淺欲開池。",
            "紫閣當疏牖，青松入壞籬。從今安僻陋，蕭相是吾師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 17
    },
    {
        "title": "喜見外弟又言別",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "十年離乱後，長大一相逢。问姓驚初見，稱名憶舊容。",
            "別來滄海事，语罷暮天鐘。明日巴陵道，秋山又幾重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 18
    },
    {
        "title": "立春日寧州行營因賦朔风吹飛雪",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "邊聲日夜合，朔风驚複來。龍山不可望，千里一裴回。",
            "捐扇破谁執，素紈輕欲裁。非时妒桃李，自是舞阳臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 19
    },
    {
        "title": "獻劉濟",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "草綠古燕州，鶯聲引独遊。雁归天北畔，春盡海西頭。",
            "向日花偏落，馳年水自流。感恩知有地，不上望京樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 20
    },
    {
        "title": "哭柏岩禪師",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "遍与傍人別，臨終盡不愁。影堂谁為掃，坐塔自看修。",
            "白日鐘邊晚，青苔缽上秋。天涯禪弟子，空到柏岩遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 21
    },
    {
        "title": "赴邠甯留別",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "身承漢飛将，束發即言兵。俠少何相问，從來事不平。",
            "黃雲斷朔吹，白雪擁沙城。幸應邊书募，橫戈會取名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 22
    },
    {
        "title": "紫騮馬",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "爭場看鬥雞，白鼻紫騮嘶。漳水春閨晚，叢台日向低。",
            "歇鞍珠作汗，試劍玉如泥。為謝紅梁燕，年年妾独棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 23
    },
    {
        "title": "夜上受降城闻笛",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "入夜思归切，笛聲清更哀。愁人不愿聽，自到枕前來。",
            "风起塞雲斷，夜深關月開。平明独惆悵，落盡一庭梅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 24
    },
    {
        "title": "同崔邠登鸛雀樓",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "鸛雀樓西百尺檣，汀洲雲樹共茫茫。漢家蕭鼓空流水，",
            "风煙並起思归望，遠目非春亦自傷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 25
    },
    {
        "title": "奉酬崔員外副使攜琴宿使院見示",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "忽闻此夜攜琴宿，遂歎常时塵吏喧。庭木已衰空月亮，",
            "谁问南飛長繞樹，官微同在謝公門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 26
    },
    {
        "title": "送賈校书東归寄振上人",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "北风吹雁數聲悲，況指前林是別时。秋草不堪频送遠，",
            "為向東州故人道，江淹已擬惠休诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 27
    },
    {
        "title": "過馬嵬二首",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "路至牆垣问樵者，顧予雲是太真宮。太真血染馬蹄盡，",
            "世人莫重霓裳曲，曾致干戈是此中。",
            "金甲銀旌盡已回，蒼茫羅袖隔风埃。濃香犹自隨鸞輅，",
            "唯留坡畔彎環月，时送残輝入夜台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 28
    },
    {
        "title": "鹽州過胡兒飲馬泉",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "綠楊著水草如煙，舊是胡兒飲馬泉。幾處吹笳明月夜，",
            "莫遣行人照容鬢，恐驚憔悴入新年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 29
    },
    {
        "title": "宿馮翊夜雨贈主人",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "危心驚夜雨，起望漫悠悠。氣耿残燈暗，聲繁高樹秋。",
            "涼軒辭夏扇，风幌攬輕裯。思緒蓬初斷，归期燕暫留。",
            "關山藹已失，臉淚迸難收。賴君时一笑，方能解四愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 30
    },
    {
        "title": "送襄阳李尚书",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "天寒發梅柳，憶昔到襄州。樹暖然紅燭，江清展碧油。",
            "风煙臨峴首，雲水接昭丘。俗尚春秋學，詞稱文選樓。",
            "都門送旌節，符竹領諸侯。漢沔分戎寄，黎元減聖憂。",
            "时追山簡興，本自習家流。莫廢思康樂，诗情滿沃洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 31
    },
    {
        "title": "春日晉祠同聲會集得疏字韵",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "风壤瞻唐本，山祠閱晉餘。水亭開帟幕，岩榭引簪裾。",
            "地綠苔犹少，林黃柳尚疏。菱苕生皎鏡，金碧照澄虛。",
            "翰苑聲何舊，賓筵醉止初。中州有遼雁，好為系邊书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 32
    },
    {
        "title": "再赴渭北使府留別",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "結发逐鳴鼙，連兵追谷蠡。山川搜伏虜，鎧甲被重犀。",
            "故府旌旗在，新军羽校齊。報恩身未死，识路馬還嘶。",
            "列嶂高烽舉，當營太白低。平戎七尺劍，封檢一丸泥。",
            "截海取蒲類，跑泉飲鸊鵜。漢庭中選重，更事五原西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 33
    },
    {
        "title": "送归中丞使新羅冊立弔祭",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "東望扶桑日，何年是到时。片帆通雨露，積水隔華夷。",
            "浩渺风來遠，虛明鳥去迟。長波靜雲月，孤島宿旌旗。",
            "別葉傳秋意，回潮動客思。滄溟无舊路，何處问前期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 34
    },
    {
        "title": "賦得路傍一株柳送邢校书赴延州使府",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "路傍一株柳，此路向延州。延州在何處，此路起悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 35
    },
    {
        "title": "重贈邢校书",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "俱從四方事，共會九秋中。斷蓬与落葉，相值各因风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 36
    },
    {
        "title": "照鏡",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "衰鬢朝臨鏡，将看卻自疑。慚君明似月，照我白如絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 37
    },
    {
        "title": "书院无曆日，以诗代书，问路侍禦六月大小",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "野性迷堯曆，松窗有道經。故人為柱史，為我數階蓂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 38
    },
    {
        "title": "闻雞贈主人",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "膠膠司晨鳴，報爾東方旭。无事戀君軒，今君重鳧鵠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 39
    },
    {
        "title": "登白樓見白鳥席上命鷓鴣辭",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "一鳥如霜雪，飛向白樓前。问君何以至，天子太平年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 40
    },
    {
        "title": "石樓山見月",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "紫塞連年戍，黃砂磧路窮。故人今夜宿，見月石樓中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 41
    },
    {
        "title": "惜春傷同幕故人孟郎中兼呈去年看花友",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "畏老身全老，逢春解惜春。今年看花伴，已少去年人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 42
    },
    {
        "title": "嘉禾寺見亡友王七題壁",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "今日憶君處，憶君君豈知。空餘暗塵字，讀罷淚仍垂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 43
    },
    {
        "title": "聽唱赤白桃李花",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "赤白桃李花，先皇在时曲。欲向西宮唱，西宮宮樹綠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 44
    },
    {
        "title": "江南詞",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "嫁得瞿塘賈，朝朝誤妾期。早知潮有信，嫁与弄潮兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 45
    },
    {
        "title": "贈內兄盧綸",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "世故中年別，餘生此會同。卻将悲与病，來對朗陵翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 46
    },
    {
        "title": "答竇二曹長留酒還榼",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "榼小非由榼，星郎是酒星。解酲元有數，不用嚇劉伶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 47
    },
    {
        "title": "答廣宣供奉问蘭陵居",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "居北有朝路，居南无住人。勞師问家第，山色是南鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 48
    },
    {
        "title": "乞寬禪師癭山罍呈宣供奉",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "石色凝秋蘚，峰形若夏雲。谁留秦苑地，好贈杏溪君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 49
    },
    {
        "title": "觀騎射",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "邊頭射雕将，走馬出中军。遠見平原上，翻身向暮雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 50
    },
    {
        "title": "幽州賦诗見意时佐劉幕",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "征戍在桑幹，年年薊水寒。殷勤驛西路，北去向長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 51
    },
    {
        "title": "军次阳城烽舍北流泉",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "何地可潸然，阳城烽樹邊。今朝望鄉客，不飲北流泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 52
    },
    {
        "title": "金吾子",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "繡帳博山爐，銀鞍馮子都。黃昏莫攀折，驚起欲棲烏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 53
    },
    {
        "title": "山鷓鴣詞",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "湘江斑竹枝，錦翅鷓鴣飛。處處湘雲合，郎從何處归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 54
    },
    {
        "title": "立秋前一日覽鏡",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "万事銷身外，生涯在鏡中。唯将滿鬢雪，明日對秋风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 55
    },
    {
        "title": "代人乞花",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "繡戶朝眠起，開簾滿地花。春风解人意，欲落妾西家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 56
    },
    {
        "title": "上洛橋",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "金谷園中柳，春來似舞腰。何堪好风景，独上洛阳橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 57
    },
    {
        "title": "揚州懷古",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "故國歌鐘地，長橋車馬塵。彭城閣邊柳，偏似不勝春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 58
    },
    {
        "title": "水宿闻雁",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "早雁忽為雙，驚秋风水窗。夜長人自起，星月滿空江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 59
    },
    {
        "title": "揚州早雁",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "江上三千雁，年年過故宮。可怜江上月，偏照斷根蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 60
    },
    {
        "title": "下樓",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "話舊全應老，逢春喜又悲。看花行拭淚，倍覺下樓迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 61
    },
    {
        "title": "度破訥沙二首",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "眼見风來沙旋移，經年不省草生时。",
            "莫言塞北无春到，總有春來何處知。",
            "破訥沙頭雁正飛，鸊鵜泉上戰初归。",
            "平明日出東南地，滿磧寒光生鐵衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 62
    },
    {
        "title": "拂雲堆",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "漢将新從虜地來，旌旗半上拂雲堆。",
            "單于每近沙場獵，南望阴山哭始回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 63
    },
    {
        "title": "中橋北送穆質兄弟應制，戲贈蕭二策",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "洛水橋邊雁影疏，陸机兄弟駐行車。",
            "欲陳漢帝登封草，犹待蕭郎寄內书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 64
    },
    {
        "title": "九月十日雨中過张伯佳期柳鎮未至以诗招之",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "柳吳興近无消息，张長公貧苦寂寥。",
            "唯有角巾沾雨至，手持残菊向西招。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 65
    },
    {
        "title": "汴河曲",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "汴水東流无限春，隋家宮闕已成塵。",
            "行人莫上長堤望，风起楊花愁殺人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 66
    },
    {
        "title": "塞下曲",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "蕃州部落能結束，朝暮馳獵黃河曲。",
            "燕歌未斷塞鴻飛，牧馬群嘶邊草綠。",
            "秦築長城城已摧，漢武北上單于台。",
            "古來征戰虜不盡，今日還複天兵來。",
            "黃河東流流九折，沙場埋恨何时絕。",
            "蔡琰沒去造胡笳，蘇武归來持漢節。",
            "為報如今都護雄，匈奴且莫下雲中。",
            "請书塞北阴山石，愿比燕然車騎功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 67
    },
    {
        "title": "夜上西城聽梁州曲二首",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "行人夜上西城宿，聽唱梁州雙管逐。",
            "此时秋月滿關山，何處關山无此曲。",
            "鴻雁新從北地來，闻聲一半卻飛回。",
            "金河戍客腸應斷，更在秋风百尺台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 68
    },
    {
        "title": "暖川",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "胡风凍合鸊鵜泉，牧馬千群逐暖川。",
            "塞外征行无盡日，年年移帳雪中天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 69
    },
    {
        "title": "過馬嵬",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "漢将如雲不直言，寇來翻罪綺羅恩。",
            "托君休洗蓮花血，留記千年妾淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 70
    },
    {
        "title": "答许五端公馬上口號",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "晚逐旌旗俱白首，少遊京洛共緇塵。",
            "不堪身外悲前事，強向杯中覓舊春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 71
    },
    {
        "title": "牡丹",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "紫蕊叢開未到家，卻教遊客賞繁華。",
            "始知年少求名處，滿眼空中別有花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 72
    },
    {
        "title": "邊思",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "腰懸錦帶佩吳鉤，走馬曾防玉塞秋。",
            "莫笑關西将家子，只将诗思入涼州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 73
    },
    {
        "title": "奉和武相公春曉闻鶯",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "蜀道山川心易驚，綠窗残夢曉闻鶯。",
            "分明似写文君恨，万怨千愁弦上聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 74
    },
    {
        "title": "送客還幽州",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "惆悵秦城送独归，薊門雲樹遠依依。",
            "秋來莫射南飛雁，從遣乘春更北飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 75
    },
    {
        "title": "柳楊送客",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "青楓江畔白蘋洲，楚客傷離不待秋。",
            "君見隋朝更何事，柳楊南渡水悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 76
    },
    {
        "title": "從军北征",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "天山雪後海风寒，橫笛偏吹行路難。",
            "磧裏征人三十万，一时回向月明看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 77
    },
    {
        "title": "聽曉角",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "邊霜昨夜墮關榆，吹角當城漢月孤。",
            "无限塞鴻飛不度，秋风捲入小單于。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 78
    },
    {
        "title": "宮怨",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "露濕晴花春殿香，月明歌吹在昭阳。",
            "似将海水添宮漏，共滴長門一夜長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 79
    },
    {
        "title": "暮過回樂烽",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "烽火高飛百尺台，黃昏遙自磧西來。",
            "昔时征戰回應樂，今日從军樂未回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 80
    },
    {
        "title": "奉和武相公郊居寓目",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "黃扉晚下禁垣鐘，归坐南闈山万重。",
            "独有月中高興盡，雪峰明處見寒松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 81
    },
    {
        "title": "詣紅樓院尋廣宣不遇留題",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "柿葉翻紅霜景秋，碧天如水倚紅樓。",
            "隔窗愛竹有人问，遣向鄰房覓戶鉤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 82
    },
    {
        "title": "回军行",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "關城榆葉早疏黃，日暮沙雲古戰場。",
            "表請回军掩塵骨，莫教士卒哭龍荒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 83
    },
    {
        "title": "邠寧春日",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "桃李年年上國新，风沙日日塞垣人。",
            "傷心更見庭前柳，忽有千條欲占春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 84
    },
    {
        "title": "古瑟怨",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "破瑟悲秋已減弦，湘靈沈怨不知年。",
            "感君拂拭遺音在，更奏新聲明月天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 85
    },
    {
        "title": "夜宴觀石将军舞",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "微月東南上戍樓，琵琶起舞錦纏頭。",
            "更闻橫笛關山遠，白草胡沙西塞秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 86
    },
    {
        "title": "春夜闻笛",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "寒山吹笛喚春归，遷客相看淚滿衣。",
            "洞庭一夜无窮雁，不待天明盡北飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 87
    },
    {
        "title": "揚州送客",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "南行直入鷓鴣群，万歲橋邊一送君。",
            "闻道望鄉闻不得，梅花暗落嶺頭雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 88
    },
    {
        "title": "統漢峰下",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "統漢峰西降戶營，黃河戰骨擁長城。",
            "只今已勒燕然石，北地无人空月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 89
    },
    {
        "title": "避暑女冠",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "霧袖煙裾雲母冠，碧琉璃簟井冰寒。",
            "焚香欲使三清鳥，靜拂桐阴上玉壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 90
    },
    {
        "title": "行舟",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "柳花飛入正行舟，臥引菱花信碧流。",
            "闻道风光滿揚子，天晴共上望鄉樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 91
    },
    {
        "title": "隋宮燕",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "燕语如傷舊國春，宮花一落已成塵。",
            "自從一閉风光後，幾度飛來不見人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 92
    },
    {
        "title": "送人归岳阳",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "煙草連天楓樹齊，岳阳归路子規啼。",
            "春江万里巴陵戍，落日看沈碧水西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 93
    },
    {
        "title": "上汝州郡樓",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "黃昏鼓角似邊州，三十年前上此樓。",
            "今日山城對垂淚，傷心不独為悲秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 94
    },
    {
        "title": "臨滹沱見蕃使列名",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "漠南春色到滹沱，碧柳青青塞馬多。",
            "万里關山今不閉，漢家频许郅支和。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 95
    },
    {
        "title": "写情",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "水紋珍簟思悠悠，千里佳期一夕休。",
            "從此无心愛良夜，任他明月下西樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 96
    },
    {
        "title": "夜上受降城闻笛",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "回樂峰前沙似雪，受降城下月如霜。",
            "不知何處吹蘆管，一夜征人盡望鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 97
    },
    {
        "title": "赴渭北宿石泉驛南望黃堆烽",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "邊城已在虜城中，烽火南飛入漢宮。",
            "漢庭議事先黃老，麟閣何人定戰功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 98
    },
    {
        "title": "逢归信偶寄",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "无事将心寄柳條，等闲书字滿芭蕉。",
            "鄉關若有東流信，遣送揚州近驛橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 99
    },
    {
        "title": "贈毛仙翁",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "玉樹溶溶仙氣深，含光混俗似无心。",
            "長愁忽作鶴飛去，一片孤雲何處尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 100
    },
    {
        "title": "長幹行",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "憶妾深閨裏，煙塵不曾识。嫁与長幹人，沙頭候风色。",
            "五月南风興，思君下巴陵。八月西风起，想君發揚子。",
            "去來悲如何，見少離別多。湘潭幾日到，妾夢越风波。",
            "昨夜狂风度，吹折江頭樹。渺渺暗无邊，行人在何處。",
            "好乘浮雲驄，佳期蘭渚東。鴛鴦綠浦上，翡翠錦屏中。",
            "自怜十五餘，顏色桃花紅。那作商人婦，愁水複愁风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 101
    },
    {
        "title": "和丘員外題湛長史舊居",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "昔降英王顧，屏身幽岩曲。靈波結繁笳，爽籟赴鳴玉。",
            "运轉春華至，歲來山草綠。青松掩落暉，白雲竟空谷。",
            "伊人撫遺歎，惻惻芳又縟。雲谁斅美香，分毫寄明牧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 102
    },
    {
        "title": "送客归振武",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "駿馬事輕車，军行万里沙。胡山通嗢落，漢節繞渾邪。",
            "桂滿天西月，蘆吹塞北笳。別離俱報主，路極不為賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 103
    },
    {
        "title": "府試古鏡",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "舊是秦时鏡，今藏古匣中。龍盤初掛月，鳳舞欲生风。",
            "石黛曾留殿，朱光適在宮。應祥知道泰，鑒物覺神通。",
            "肝膽誠難隱，妍媸信易窮。幸居君子室，長愿免塵蒙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 104
    },
    {
        "title": "贈宣大師",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "一國沙彌独解诗，人人道勝惠林師。先皇詔下征還日，",
            "因論佛地求心地，只说常吟是住持。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 105
    },
    {
        "title": "漢宮詞",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "漢室長陵小市東，珠簾繡戶對春风。",
            "君王昨日移仙仗，玉輦将迎入漢中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 106
    },
    {
        "title": "江南曲",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "長樂花枝雨點銷，江城日暮好相邀。",
            "春樓不閉葳蕤鎖，綠水回連宛轉橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 107
    },
    {
        "title": "宿石邑山中",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "浮雲不共此山齊，山靄蒼蒼望轉迷。",
            "曉月暫飛高樹裏，秋河隔在數峰西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 108
    },
    {
        "title": "寄贈衡州楊使君",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "湘竹斑斑湘水春，衡阳太守虎符新。",
            "朝來笑向归鴻道，早晚南飛見主人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 109
    },
    {
        "title": "途中寄李二",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "楊柳含煙灞岸春，年年攀折為行人。",
            "好风若借低枝便，莫遣青絲掃路塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 110
    },
    {
        "title": "寄许煉師",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "掃石焚香禮碧空，露華偏濕蕊珠宮。",
            "如何说得天壇上，万里无雲月在中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 111
    },
    {
        "title": "失題",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "世故相逢各未閑，百年多在別離間。",
            "昨夜秋风今夜雨，不知何處入空山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 112
    },
    {
        "title": "塞下曲",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "伏波惟愿裹屍還，定遠何須生入關。",
            "莫遣只輪归海窟，仍留一箭射天山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 113
    },
    {
        "title": "上黃堆烽",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "心期紫閣山中月，身過黃堆烽上雲。",
            "年發已從书劍老，戎衣更逐霍将军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 114
    },
    {
        "title": "句",
        "author": "李益",
        "biography": "",
        "paragraphs": [
            "闲庭草色能留馬，當路楊花不避人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百八十三",
        "no#": 115
    }
]