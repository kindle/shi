[
    {
        "title": "送程德琳郎中學士",
        "author": "徐鍇",
        "biography": "",
        "paragraphs": [
            "瓜步妖氛滅，昆岡草樹青。終朝空望极，今日送君行。",
            "報政秋雲靜，微吟曉月生。樓中長可見，特用滅離情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 1
    },
    {
        "title": "太傅相公以東觀庭梅西垣舊植昔陪盛賞…伏愧斐然",
        "author": "徐鍇",
        "biography": "",
        "paragraphs": [
            "靜对含章樹，閑思共有时。香隨荀令在，根異武昌移。",
            "物性雖搖落，人心豈變衰。唱酬勝笛曲，來往韵朱絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 2
    },
    {
        "title": "太傅相公与家兄梅花酬唱许綴末篇再賜新诗…伏惟采覽",
        "author": "徐鍇",
        "biography": "",
        "paragraphs": [
            "重歎梅花落，非關塞笛悲。論文叨接萼，末曲愧吹篪。",
            "枝逐清风動，香因白雪知。陶鈞敷左悌，更賦邵公诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 3
    },
    {
        "title": "同家兄哭喬侍郎",
        "author": "徐鍇",
        "biography": "",
        "paragraphs": [
            "諸公長者鄭當时，事事无心性坦夷。但是登臨皆有作，",
            "三日笑談成理命，一篇投吊尚應知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 4
    },
    {
        "title": "秋詞",
        "author": "徐鍇",
        "biography": "",
        "paragraphs": [
            "井梧紛墮砌，寒雁遠橫空。雨久莓苔紫，霜濃薜荔紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 5
    },
    {
        "title": "和徐鼎臣見寄",
        "author": "包穎",
        "biography": "",
        "paragraphs": [
            "平生中表最情親，浮世那堪聚散频。謝脁卻吟归省閣，",
            "且喜新吟報強健，明年相望杏園春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 6
    },
    {
        "title": "貽耀州将",
        "author": "鐘謨",
        "biography": "",
        "paragraphs": [
            "翩翩归盡塞垣鴻，隱隱驚開蟄戶蟲。渭北離愁春色裏，",
            "多謝賢侯振吾道，免令搔首泣途窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 7
    },
    {
        "title": "獻周世宗",
        "author": "鐘謨",
        "biography": "",
        "paragraphs": [
            "三年耀武群雄服，一日回鑾万國春。",
            "南北通歡永无事，謝恩归去老陪臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 8
    },
    {
        "title": "代京妓越賓答徐鉉",
        "author": "鐘謨",
        "biography": "",
        "paragraphs": [
            "一幅輕綃寄海濱，越姑長感昔时恩。",
            "欲知別后情多少，點點凭君看淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 9
    },
    {
        "title": "寄麻姑仙壇道士",
        "author": "查文徽",
        "biography": "",
        "paragraphs": [
            "別后相思鶴信稀，郡樓南望遠峰迷。人归仙洞雲連地，",
            "方平車駕今何在，常苦塵中日易西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 10
    },
    {
        "title": "贈韓定辭",
        "author": "馬彧",
        "biography": "",
        "paragraphs": [
            "燧林芳草綿綿思，盡日相攜陟麗譙。",
            "別后巏嵍山上望，羨君时複見王喬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 11
    },
    {
        "title": "答馬彧",
        "author": "韓定辭",
        "biography": "",
        "paragraphs": [
            "崇霞臺上神仙客，學辨癡龍藝最多。",
            "盛德好将銀管述，麗詞堪与雪兒歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 12
    },
    {
        "title": "題楊克儉池館",
        "author": "何昌齡",
        "biography": "",
        "paragraphs": [
            "經旬因雨不重來，門有蛛絲徑有苔。",
            "再向白蓮亭上望，不知花木為谁開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 13
    },
    {
        "title": "獻江淮郡守盧公",
        "author": "李羽",
        "biography": "",
        "paragraphs": [
            "塞詔東來淝水濱，时情惟望秉陶鈞。",
            "将军一陣為功业，忍見沙場百戰人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 14
    },
    {
        "title": "南山池",
        "author": "梁藻",
        "biography": "",
        "paragraphs": [
            "翡翠戲翻荷葉雨，鹭鷥飛破竹林煙。",
            "时沽村酒臨軒酌，擬摘新茶靠石煎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 15
    },
    {
        "title": "嘲廬山道士",
        "author": "陳沆",
        "biography": "",
        "paragraphs": [
            "啖肉先生欲上升，黃雲踏破紫雲崩。",
            "龍腰鶴背无多力，傳与麻姑借大鵬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 16
    },
    {
        "title": "句",
        "author": "陳沆",
        "biography": "",
        "paragraphs": [
            "罷卻兒女戲，放他花木生。",
            "掃地雲粘帚，耕山鳥怕牛。",
            "點入旱雲千國仰，力浮塵世一毫輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 17
    },
    {
        "title": "贈織錦人",
        "author": "李詢",
        "biography": "",
        "paragraphs": [
            "劄劄机聲曉複晡，眼穿力盡竟何如。",
            "美人一曲成千賜，心裏犹嫌花樣疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 18
    },
    {
        "title": "題金山",
        "author": "韓垂",
        "biography": "",
        "paragraphs": [
            "靈山一峰秀，岌然殊眾山。盤根大江底，插影浮雲間。",
            "雷霆常間作，风雨时往還。象外懸清影，千载長躋攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 19
    },
    {
        "title": "后湖",
        "author": "朱存",
        "biography": "",
        "paragraphs": [
            "雷轟疊鼓火翻旗，三異翩翩試水師。",
            "驚起黑龍眠不得，狂风猛雨不多时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 20
    },
    {
        "title": "和徐舍人九月十一日見寄",
        "author": "陳彥",
        "biography": "",
        "paragraphs": [
            "衡門寂寂逢迎少，不見仙郎向五旬。",
            "莫问龍山前日事，菊花開卻為闲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 21
    },
    {
        "title": "登游齊山",
        "author": "许堅1",
        "biography": "",
        "paragraphs": [
            "星使南馳入楚重，此山偏得駐行蹤。",
            "落花滿地月華冷，寂寞舊山三四峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 22
    },
    {
        "title": "游溧阳下山寺",
        "author": "许堅1",
        "biography": "",
        "paragraphs": [
            "地枕吳溪与越峰，前朝恩錫靈泉額。竹林晴見雁塔高，",
            "客有經年说別林，落日啼猿情脈脈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 23
    },
    {
        "title": "題幽棲觀",
        "author": "许堅1",
        "biography": "",
        "paragraphs": [
            "仙翁上升去，丹井寄晴壑。山色接天臺，湖光照寥廓。",
            "玉洞絕无人，老檜犹棲鶴。我欲掣青蛇，他时沖碧落。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 24
    },
    {
        "title": "上舍人徐鉉",
        "author": "许堅1",
        "biography": "",
        "paragraphs": [
            "幾宵煙月鎖樓臺，欲寄侯門薦下才。",
            "滿面塵埃人不识，謾隨流水出山來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 25
    },
    {
        "title": "題茅山觀",
        "author": "许堅1",
        "biography": "",
        "paragraphs": [
            "常恨清风千载鬱，洞天令得恣遊遨。松楸古色玉壇靜，",
            "分明有個長生路，休向紅塵歎二毛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 26
    },
    {
        "title": "建州節帥更代，筵上獻诗",
        "author": "王感化",
        "biography": "",
        "paragraphs": [
            "旌旗赴天臺，溪山曉色開。万家悲更喜，迎佛送如來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 27
    },
    {
        "title": "奉元宗命詠苑中白野鵲",
        "author": "王感化",
        "biography": "",
        "paragraphs": [
            "碧岩深洞恣遊遨，天与蘆花作羽毛。",
            "要识此來棲宿处，上林瓊樹一枝高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 28
    },
    {
        "title": "句",
        "author": "王感化",
        "biography": "",
        "paragraphs": [
            "草中誤認将军虎，山上曾為道士羊。（《題怪石》八句，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 29
    },
    {
        "title": "元宗釣魚无獲，進诗",
        "author": "李家明",
        "biography": "",
        "paragraphs": [
            "玉甃垂鉤興正濃，碧池春暖水溶溶。",
            "凡鱗不敢吞香餌，知是君王合釣龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 30
    },
    {
        "title": "詠臥牛",
        "author": "李家明",
        "biography": "",
        "paragraphs": [
            "曾遭甯戚鞭敲角，又被田單火燎身。",
            "閑向斜阳嚼枯草，近來问喘為无人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 31
    },
    {
        "title": "題紙鳶止宋齊丘哭子",
        "author": "李家明",
        "biography": "",
        "paragraphs": [
            "安排唐祚革強吳，儘是先生作计謨。",
            "一個孩兒拚不得，讓皇百口合何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 32
    },
    {
        "title": "詠皖公山",
        "author": "李家明",
        "biography": "",
        "paragraphs": [
            "龍舟輕颭錦帆风，正值宸遊望遠空。",
            "回首皖公山色翠，影斜不到壽杯中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 33
    },
    {
        "title": "奉和圣制送鄧王牧宣城",
        "author": "湯悅",
        "biography": "",
        "paragraphs": [
            "千里陵阳同陝服，鑿門胙土寄親賢。曙煙已別黃金殿，",
            "天心待報期年政，留与工師播管弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 34
    },
    {
        "title": "早春寄華下同志",
        "author": "湯悅",
        "biography": "",
        "paragraphs": [
            "正是花时節，思君寢復興。市沽終不醉，春夢亦无凭。",
            "嶽面懸清雨，河心走濁冰。東門一條路，離恨正相仍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 35
    },
    {
        "title": "鼎臣學士侍郎以東館庭梅昔翰苑之毫末今複半枯…攀和",
        "author": "湯悅",
        "biography": "",
        "paragraphs": [
            "憶見萌芽日，還怜合抱时。舊歡如夢想，物態暗還移。",
            "素豔今无幾，朱顏亦自衰。樹将人共老，何暇更悲絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 36
    },
    {
        "title": "再次前韵代梅答",
        "author": "湯悅",
        "biography": "",
        "paragraphs": [
            "托植經多稔，頃筐向盛时。枝條雖已故，情分不曾移。",
            "莫向階前老，還同鏡裏衰。更應怜墮葉，残吹掛蟲絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 37
    },
    {
        "title": "鼎臣學士侍郎、楚金舍人學士以再傷…成四十字陳謝",
        "author": "湯悅",
        "biography": "",
        "paragraphs": [
            "人物同遷謝，重成念舊悲。連華得瓊玖，合奏發塤篪。",
            "餘枿雖无取，残芳尚獲知。问君何所似，珍重杜秋诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 38
    },
    {
        "title": "送鐘員外",
        "author": "蕭彧",
        "biography": "",
        "paragraphs": [
            "麗漢金波滿，當筵玉斝傾。因思频聚散，幾複换虧盈。",
            "光徹離襟冷，聲符別管清。那堪還目此，两地倚樓情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 39
    },
    {
        "title": "送德林郎中學士赴東府",
        "author": "蕭彧",
        "biography": "",
        "paragraphs": [
            "離情折楊柳，此別異春哉。含露東籬豔，泛香南浦杯。",
            "惜持行次贈，留插醉中回。暮齒如能制，玉山甘判頹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 40
    },
    {
        "title": "送鐘員外",
        "author": "孫峴",
        "biography": "",
        "paragraphs": [
            "万物中蕭灑，修篁独逸群。貞姿曾冒雪，高節欲淩雲。",
            "細韵风初發，濃煙日正曛。因題偏惜別，不可暫无君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 41
    },
    {
        "title": "送鐘員外",
        "author": "謝仲宣",
        "biography": "",
        "paragraphs": [
            "送人多折柳，唯我独吟松。若保歲寒在，何妨霜雪重。",
            "森梢逢靜境，廓落見孤峰。還似君高節，亭亭鮮繼蹤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 42
    },
    {
        "title": "別諸同志",
        "author": "鐘蒨",
        "biography": "",
        "paragraphs": [
            "隨阳來万里，點點度遙空。影落長江水，聲悲半夜风。",
            "残秋辭絕漠，无定似驚蓬。我有離群恨，飄飄類此鴻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 43
    },
    {
        "title": "送德林郎中學士赴東府",
        "author": "喬舜",
        "biography": "",
        "paragraphs": [
            "摻袂向江頭，朝宗勢未休。何人乘桂楫，之子過揚州。",
            "颯颯翹沙雁，漂漂逐浪鸥。欲知離別恨，半是淚和流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 44
    },
    {
        "title": "送鐘員外",
        "author": "王沂",
        "biography": "",
        "paragraphs": [
            "靜追蘋末興，況複值蕭條。猛勢資新雁，寒聲伴暮潮。",
            "過山雲散乱，經樹葉飄颻。今日煙江上，征帆望望遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十七",
        "no#": 45
    },
    {
        "title": "送德林郎中學士赴東府",
        "author": "陳元裕",
        "biography": "",
        "paragraphs": [
            "上善湛然秋，恩波洽帝猷。謾言生險浪，豈爽見安流。",
            "泛去星槎遠，澄來月練浮。滔滔对離酌，入洛稱仙舟。"
