[
    {
        "title": "釣台",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "金門谁奉詔，碧岸独垂鉤。舊友只樵叟，新交惟野鸥。",
            "嘉名懸日月，深谷化陵丘。便可招巢父，長川好飲牛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 1
    },
    {
        "title": "旅次寓題",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "胡為名利役，來往老關河。白发隨梳少，青山入夢多。",
            "途窮怜抱疾，世乱恥登科。卻起漁舟念，春风釣綠波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 2
    },
    {
        "title": "贈嚴司直",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "承家居闕下，避世出關東。有酒劉伶醉，无兒伯道窮。",
            "新诗吟閣賞，舊业釣台空。雨雪還相訪，心懷与我同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 3
    },
    {
        "title": "贈東方道士",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "葫蘆窗畔掛，是物在其間。雪色老人鬢，桃花童子顏。",
            "祭星秋蔔日，采药曉登山。舊放長生鹿，时銜瑞草還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 4
    },
    {
        "title": "題僧壁",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "香廚流瀑布，独院鎖孤峰。紺發青螺長，文茵紫豹重。",
            "卵枯皆化燕，蜜老卻成蜂。明月留人宿，秋聲夜著松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 5
    },
    {
        "title": "和人經隋唐間戰处",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "孤军前度戰，一敗一成功。卷旆早归國，臥屍犹臂弓。",
            "草間腥半在，沙上血残紅。傷魄何為者，五湖垂釣翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 6
    },
    {
        "title": "追和常建歎王昭君",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "紅顏如朔雪，日爍忽成空。淚盡黃雲雨，塵消白草风。",
            "君心爭不悔，恨思竟何窮。愿化南飛燕，年年入漢宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 7
    },
    {
        "title": "贈董先生",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "壽歲過於百，时閑到上京。餐松雙鬢嫩，絕粒四支輕。",
            "雨雪思中嶽，雲霞夢赤城。來年期壽籙，何处待先生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 8
    },
    {
        "title": "河流",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "洪流盤砥柱，淮濟不同波。莫訝清时少，都緣曲处多。",
            "遠能通玉塞，高複接銀河。大禹成門嶮，為龍始得過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 9
    },
    {
        "title": "題南寺",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "久別猿啼寺，流年劫逝波。舊僧归塔盡，古瓦長松多。",
            "壁蘚昏題記，窗螢散薜蘿。平生英壯節，何故旋消磨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 10
    },
    {
        "title": "北山秋晚",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "十载衣裘盡，臨寒隱薜蘿。心閑緣事少，身老愛山多。",
            "玉露催收菊，金风促剪禾。燕秦正戎馬，林下好婆娑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 11
    },
    {
        "title": "昔游",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "昔游紅杏苑，今隱刺桐村。歲计懸僧債，科名負國恩。",
            "不书胝漸穩，频鑷鬢无根。惟有經邦事，年年志尚存。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 12
    },
    {
        "title": "酒鬍子",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "紅筵絲竹合，用爾作歡娛。直指寧偏黨，无私絕覬覦。",
            "當歌谁擐袖，應節漸輕軀。恰与真相似，氈裘滿頷須。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 13
    },
    {
        "title": "吊崔補闕",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "近來吾道少，慟哭博陵君。直節岩前竹，孤魂嶺上雲。",
            "縉紳傳確論，丞相取遺文。廢卻中興策，何由免用军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 14
    },
    {
        "title": "吊赤水李先生",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "三年悲過隙，一室類銷冰。妻病入仙觀，子窮隨嶽僧。",
            "荒丘寒有雨，古屋夜无燈。往日清猷著，金門幾欲征。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 15
    },
    {
        "title": "香鴨",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "不假陶熔妙，谁教羽翼全。五金池畔質，百和口中煙。",
            "觜鈍魚難啄，心空火自燃。禦爐如有闕，須進圣君前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 16
    },
    {
        "title": "雞",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "名參十二屬，花入羽毛深。守信催朝日，能鳴送曉阴。",
            "峨冠裝瑞璧，利爪削黃金。徒有稻粱感，何由報德音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 17
    },
    {
        "title": "白鴿",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "舉翼淩空碧，依人到大邦。粉翎棲画閣，雪影拂瓊窗。",
            "振鹭堪為侶，鳴鳩好作雙。狎鸥归未得，睹爾憶晴江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 18
    },
    {
        "title": "龜",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "行止竟何從，深溪与古峰。青荷巢瑞質，綠水返靈蹤。",
            "鑽骨神明應，酬恩感激重。仙翁求一卦，何日脫龍鍾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 19
    },
    {
        "title": "銀結條冠子",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "日下征良匠，宮中贈阿嬌。瑞蓮開二孕，瓊縷織千條。",
            "蟬翼輕輕結，花紋細細挑。舞时紅袖舉，纖影透龍綃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 20
    },
    {
        "title": "蜀葵",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "劍門南面樹，移向會仙亭。錦水饒花豔，岷山帶葉青。",
            "文君慚婉娩，神女讓娉婷。爛熳紅兼紫，飄香入繡扃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 21
    },
    {
        "title": "華清宮",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "十二瓊樓鎖翠微，暮霞遺卻六銖衣。桐枯丹穴鳳何去，",
            "君王魂斷驪山路，且向蓬瀛伴貴妃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 22
    },
    {
        "title": "再幸華清宮",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "腸斷将军改葬归，錦囊香在憶當时。年來卻恨相思樹，",
            "霓裳舊曲飛霜殿，夢破魂驚絕后期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 23
    },
    {
        "title": "喜雨上主人尚书",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "天皇攘袂敕神龍，雨我公田兆歲豐。幾日淋漓侵暮角，",
            "門下十年耕稼者，坐來偏憶翠微峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 24
    },
    {
        "title": "回文诗二首",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "飛书一幅錦文回，恨写深情寄雁來。机上月残香閣掩，",
            "归日幾人行问卜，徽音想望倚高臺。",
            "輕帆数點千峰碧，水接雲山四望遙。晴日海霞紅靄靄，",
            "明月釣舟漁浦遠，傾山雪浪暗隨潮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 25
    },
    {
        "title": "不把漁竿",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "不把漁竿不灌園，策筇吟繞綠蕪村。得爭野老眠雲樂，",
            "何人買我安貧趣，百万黃金未可論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 26
    },
    {
        "title": "古往今來",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "古往今來恨莫窮，不如沈醉臥春风。雀兒无角長穿屋，",
            "閑思郭令長安宅，草沒匡牆舊事空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 27
    },
    {
        "title": "十裏煙籠",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "十裏煙籠一徑分，故人迢遞久離群。白雲明月皆由我，",
            "北邙坡上青松下，儘是鏘金佩玉墳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 28
    },
    {
        "title": "偶书",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "巧者多為拙者資，良籌第一在乘时。市門逐利終身飽，",
            "高皇冷笑重瞳客，蓋世拔山何所為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 29
    },
    {
        "title": "潤屋",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "潤屋豐家莫妄求，眼看多是与身讎。百禽羅得皆黃口，",
            "朱門粉署何由到，空寄新诗謝列侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 30
    },
    {
        "title": "退居",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "鶴性松心合在山，五侯門館怯趨攀。三年臥病不能免，",
            "笑他範蠡貪婪甚，相罷金多始退閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 31
    },
    {
        "title": "閉門",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "閉卻閑門臥小窗。更何人与療膏肓。一生有酒唯知醉，",
            "漳濱伏枕文園渴，盜蹠縱橫似虎狼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 32
    },
    {
        "title": "開窗",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "閉戶開窗寢又興，三更时節也如冰。長閑便是忘机者，",
            "薔薇花盡熏风起，綠葉空隨滿架藤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 33
    },
    {
        "title": "燈花",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "點蠟燒銀卻勝栽，九華紅豔吐玫瑰。独含冬夜寒光拆，",
            "貪膏附熱多相誤，為報飛蛾罷拂來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 34
    },
    {
        "title": "東归出城留別知己",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "韋蒙屈指许非才，三载長安共酒杯。欲別未攀楊柳贈，",
            "他日因书问衰颯，東溪須訪子陵台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 35
    },
    {
        "title": "詠懷",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "愁花變出白髭須，半世辛勤一事无。道在或期君夢想，",
            "借取秦宮臺上鏡，為时開照漢妖狐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 36
    },
    {
        "title": "郊村独游",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "歲閏堪怜曆候迟，出門惟与野雲期。驚魚擲上綠荷芰，",
            "市頭相者休相戲，蹙膝先生半自知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 37
    },
    {
        "title": "經故翰林楊左丞池亭",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "八角紅亭蔭綠池，一朝青草蓋遺基。薔薇藤老開花淺，",
            "平生德義人間誦，身后何勞更立碑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 38
    },
    {
        "title": "經故廣平員外舊宅",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "門巷蕭條引涕洟，遺孤三歲著麻衣。綠楊樹老垂絲短，",
            "平生欲獻匡君策，抱病犹言未息机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 39
    },
    {
        "title": "潘丞相舊宅",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "綠樹垂枝蔭四鄰，春风還似舊时春。年年燕是雕梁主，",
            "秋槐影薄蟬聲盡，休謂龍門待化鱗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 40
    },
    {
        "title": "門外闲田数畝長有泉源因築直堤分為两沼",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "左右澄漪小檻前，直堤高築古平川。十分春水雙簷影，",
            "坐來暗起江湖思，速问溪翁買釣船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 41
    },
    {
        "title": "北園",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "北園幹葉旋空枝，蘭蕙還将眾草衰。籠鳥上天犹有待，",
            "生事罷求名与利，一窗书策是年支。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 42
    },
    {
        "title": "溪上要一隻白簟扇蓋頭垂釣去年就節推…遂成拙句",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "難求珍箑過炎天，遠就金貂乞月圓。直在引风欹角枕，",
            "莫道如今时較晚，也應留得到明年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 43
    },
    {
        "title": "招隱",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "齒發那能敵歲華，早知休去避塵沙。鬼神只闞高明裏，",
            "贈君吉语堪銘座，看取朝開暮落花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 44
    },
    {
        "title": "憶山中友人",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "憶得當年接善鄰，苦将闲事強夫君。鬥開碧沼分明月，",
            "金門幾欲言西上，惆悵關河正用军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 45
    },
    {
        "title": "溪隱",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "将名将利已无緣，深隱清溪擬學仙。絕卻腥膻勝服药，",
            "鸞鶴久從籠檻閉，春风卻放紙為鳶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 46
    },
    {
        "title": "酒醒",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "酒醒欲得適闲情，騎馬那勝策杖行。天暖天寒三月暮，",
            "望斷長安故交遠，來书未说九河清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 47
    },
    {
        "title": "夢斷",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "夢斷紗窗半夜雷，別君花落又花開。漁阳路遠书難寄，",
            "人生若得長相对，螢火生煙草化灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 48
    },
    {
        "title": "人事",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "人事飄如一炷煙，且須求佛与求仙。豐年甲子春无雨，",
            "平生生计何為者，三徑蒼苔十畝田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 49
    },
    {
        "title": "休说",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "休说人間有陸沈，一樽閑待月明斟。时來不怕滄溟闊，",
            "梓桐賦罷相如隱，谁為君前永夜吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 50
    },
    {
        "title": "嘉运",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "嘉运良时两阻修，釣竿蓑笠樂林丘。家无寸帛渾闲事，",
            "晨炊一箸紅銀粒，憶著長安索米秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 51
    },
    {
        "title": "綠鬢",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "綠鬢先生自出林，孟光同樂野雲深。躬耕為食古人操，",
            "君看黃閣南遷客，一過瀧州絕好音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 52
    },
    {
        "title": "驕侈",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "驕侈阽危儉素牢，鏡中形影豈能逃。石家恃富身還滅，",
            "古今人事惟堪醉，好脫霜裘换綠醪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 53
    },
    {
        "title": "龍蟄二首",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "龍蟄蛇蟠卻待伸，和光何惜且同塵。伍員豈是吹簫者，",
            "穰侯休忌關東客，张祿先生竟相秦。",
            "休说雄才間代生，到頭難与运相爭。时通有詔征枚乘，",
            "中林且作煙霞侶，塵滿關河未可行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 54
    },
    {
        "title": "逐臭蒼蠅",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "逐臭蒼蠅豈有為，清蟬吟露最高奇。多藏苟得何名富，",
            "首阳山翠千年在，好奠冰壺吊伯夷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 55
    },
    {
        "title": "牡丹花二首",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "看遍花无勝此花，剪雲披雪蘸丹砂。開當青律二三月，",
            "不隨寒令同时放，倍種雙松与辟邪。",
            "万万花中第一流，淺霞輕染嫩銀甌。能狂綺陌千金子，",
            "诗书滿架塵埃撲，盡日无人略舉頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 56
    },
    {
        "title": "尚书座上賦牡丹花得輕字韵其花自越中移植",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "流蘇凝作瑞華精，仙閣開时麗日晴。霜月冷銷銀燭焰，",
            "早晚有人天上去，寄他将贈董雙成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 57
    },
    {
        "title": "依韵和尚书再贈牡丹花",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "爛銀基地薄紅妝，羞殺千花百卉芳。紫陌昔曾遊寺看，",
            "多著黃金何处買，輕橈挑過鏡湖光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 58
    },
    {
        "title": "郡庭惜牡丹",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "腸斷東风落牡丹，為祥為瑞久留難。青春不駐堪垂淚，",
            "明年万葉千枝長，倍發芳菲借客看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 59
    },
    {
        "title": "追和白舍人詠白牡丹",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "蓓蕾抽開素練囊，瓊葩熏出白龍香。裁分楚女朝雲片，",
            "檻邊幾笑東籬菊，冷折金风待降霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 60
    },
    {
        "title": "憶牡丹",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "綠樹多和雪霰栽，長安一別十年來。王侯買得價偏重，",
            "滄洲春暮空腸斷，画看犹将勸酒杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 61
    },
    {
        "title": "惜牡丹",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "今日狂风揭錦筵，預愁吹落夕阳天。閑看紅豔只須醉，",
            "良时雖作鶯花主，白馬王孫恰少年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 62
    },
    {
        "title": "覽柳渾汀洲采白蘋之什，因成一章",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "采盡汀蘋恨別離，鴛鴦鸂鶒總雙飛。月明南浦夢初斷，",
            "年來泣淚知多少，重疊成痕在繡衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 63
    },
    {
        "title": "司直巡官无諸移到玫瑰花",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "芳菲移自越王台，最似薔薇好並栽。穠豔盡怜勝彩繪，",
            "為報朱衣早邀客，莫教零落委蒼苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 64
    },
    {
        "title": "梅花",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "瓊瑤初綻嶺頭葩，蕊粉新妝姹女家。舉世更谁怜潔白，",
            "結實和羹知有日，肯隨羌笛落天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 65
    },
    {
        "title": "荔枝二首",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "朱彈星丸粲日光，綠瓊枝散小香囊。龍綃殼綻紅紋粟，",
            "蠻山蹋曉和煙摘，拜捧金盤奉越王。",
            "日日熏风卷瘴煙，南園珍果荔枝先。靈鴉啄破瓊津滴，",
            "何人刺出猩猩血，深染羅紋遍殼鮮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 66
    },
    {
        "title": "菊花",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "桓景登高事可尋，黃花開处綠畦深。消災辟惡君須采，",
            "陶公豈是居貧者，剩有東籬万朵金。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 67
    },
    {
        "title": "画松",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "澗底阴森驗筆精，筆閑開展觉神清。曾當月照還无影，",
            "天臺道士频來見，说似株株倚赤城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 68
    },
    {
        "title": "草木",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "草木无情亦可嗟，重開明鏡照无涯。菊英空折羅含宅，",
            "仙翁乞取金盤露，洗卻蒼蒼两鬢華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 69
    },
    {
        "title": "松",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "澗底青松不染塵，未逢良匠競谁分。龍盤勁節岩前見，",
            "皇王自有增封日，修竹徒勞號此君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 70
    },
    {
        "title": "竹",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "翠染琅玕粉漸開，東南移得會稽栽。遊絲掛处漁竿去，",
            "王猷舊宅无人到，抱卻清阴蓋綠苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 71
    },
    {
        "title": "尚书打球，小驄步驟最奇，因有所贈",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "善價千金未可論，燕王新寄小龍孫。逐将白日馳青漢，",
            "桃花雪點多雖貴，全假當場一顧恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 72
    },
    {
        "title": "尚书惠蠟麵茶",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "武夷春暖月初圓，採摘新芽獻地仙。飛鵲印成香蠟片，",
            "分贈恩深知最異，晚鐺宜煮北山泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 73
    },
    {
        "title": "勸酒",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "休向尊前訴羽觥，百壺清酌与君傾。身同綠樹年年老，",
            "醉鄉路与乾坤隔，豈信人間有利名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 74
    },
    {
        "title": "斷酒",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "因論沈湎觉前非，便碎金罍与羽卮。采茗早馳三蜀使，",
            "此事十年前已说，匡廬山下老僧知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 75
    },
    {
        "title": "憶舊山",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "澗竹岩雲有舊期，二年频長鬢邊絲。游魚不愛金杯水，",
            "龍爭虎攫皆闲事，数疊山光在夢思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零八",
        "no#": 76
    }
]