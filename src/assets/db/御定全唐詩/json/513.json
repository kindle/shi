[
    {
        "title": "獻歲书情",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "白发添雙鬢，空宮又一年。音书鴻不到，夢寐兔空懸。",
            "地遠星辰側，天高雨露偏。圣期知有感，雲海漫相連。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 1
    },
    {
        "title": "奉和大樑相公重九日军中宴會之什",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "今古同嘉節，歡娛但異名。陶公緣綠醑，謝傅為蒼生。",
            "酒泛金英麗，诗通玉律清。何言辭物累，方系万人情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 2
    },
    {
        "title": "奉和大樑相公同张員外重九日宴集",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "重九思嘉節，追歡從謝公。酒清欺玉露，菊盛愧金风。",
            "不待秋蟾白，須沈落照紅。更将門下客，酬和管弦中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 3
    },
    {
        "title": "同樂天中秋夜洛河玩月二首",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "清洛半秋懸璧月，彩船當夕泛銀河。蒼龍頷底珠皆沒，",
            "須知天地為爐意，盡取黃金鑄作波。",
            "不熱不寒三五夕，晴川明月正相臨。千珠競沒蒼龍頷，",
            "如何清洛如清晝，共見初升又見沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 4
    },
    {
        "title": "和邢郎中病中重阳強遊樂游原",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "嘉晨令節共陶陶，风景牽情並不勞。曉日整冠蘭室靜，",
            "何必銷憂凭外物，只将清韵敵春醪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 5
    },
    {
        "title": "觀淬龍泉劍",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "歐冶将成器，风胡幸見逢。發硎思剸玉，投水化為龍。",
            "詎肯藏深匣，終朝用刜鐘。蓮花生寶鍔，秋日勵霜鋒。",
            "煉質才三尺，吹毛過百重。擊磨如不倦，提握愿長從。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 6
    },
    {
        "title": "春色滿皇州",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "寒銷山水地，春遍帝王州。北闕晴光動，南山喜气浮。",
            "夭紅妝暖樹，急綠走阴溝。思婦開香閣，王孫上玉樓。",
            "氛氳直城北，駘蕩曲江頭。今日靈台下，翻然卻是愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 7
    },
    {
        "title": "亞夫碎玉鬥",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "雄謀竟不決，寶玉終不愛。倏爾霜刃揮，颯然春冰碎。",
            "飛光動旗幟，散響驚環佩。霜灑繡障前，星流錦筵內。",
            "图王业已失，為虜言空悔。独有青史中，英风觀千载。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 8
    },
    {
        "title": "水亭",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "歲律行将變，君恩竟未回。門前即潮水，朝去暮常來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 9
    },
    {
        "title": "揚州寄諸子",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "千里隔煙波，孤舟宿何处。遙思耿不眠，淮南夜风雨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 10
    },
    {
        "title": "酬盧郎中游寺見招不遇",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "偶出送山客，不知游梵宮。秋光古松下，谁伴一仙翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 11
    },
    {
        "title": "寓言",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "秋樹卻逢暖，未凋能幾时。何須尚松桂，搖動暫青枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 12
    },
    {
        "title": "唁人喪侍兒",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "夜情河耿耿，春恨草綿綿。唯有嫦娥月，從今照墓田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 13
    },
    {
        "title": "席上夜別张主簿",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "紅燭剪還明，綠尊添又滿。不愁前路長，只畏今宵短。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 14
    },
    {
        "title": "方丈泉",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "循涯不知淺，見底似非深。永日无波浪，澄澄照我心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 15
    },
    {
        "title": "晚望",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "日下夕阴長，前山凝積翠。白鳥一行飛，聯聯粉书字。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 16
    },
    {
        "title": "前山",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "只謂一蒼翠，不知犹数重。晚來雲映处，更見两三峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 17
    },
    {
        "title": "發交州日留題解煉師房",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "久喜房廊接，今成道路賒。明朝回首处，此地是天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 18
    },
    {
        "title": "令和州買松",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "好覓淩霜質，仍須帶雨栽。須知剖竹日，便是看松來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 19
    },
    {
        "title": "題斷金集后",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "一覽斷金集，再悲埋玉人。牙弦千古絕，珠淚万行新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 20
    },
    {
        "title": "晚涼",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "簷前蔽日多高樹，竹下添池有小渠。",
            "山客野僧归去后，晚涼移案独臨书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 21
    },
    {
        "title": "和周侍禦洛城雪",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "天街飛轡踏瓊英，四顧全疑在玉京。",
            "一種相如抽秘思，兔園那比鳳凰城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 22
    },
    {
        "title": "奉和大樑相公送人二首",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "謝公日日傷離別，又向西堂送阿連。",
            "想到越中秋已盡，鏡河應羨月團圓。",
            "北津楊柳迎煙綠，南岸闌幹映水紅。",
            "君到襄阳渡江处，始應回首憶羊公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 23
    },
    {
        "title": "酬唐仁烈相別后喜阻风未發見寄",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "離心一起淚雙流，春浪无情也白頭。",
            "风若有知須放去，莫教重別又重愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 24
    },
    {
        "title": "秦中臥病思归",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "索索涼风滿樹頭，破窗残月五更秋。",
            "病身归处吳江上，一寸心中万里愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 25
    },
    {
        "title": "送王繢",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "翠羽長将玉樹期，偶然飛下肯多时。",
            "翩翩一路嵐阴晚，卻入青蔥宿舊枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 26
    },
    {
        "title": "贈美人琴弦",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "應從玉指到金徽，万態千情料可知。",
            "今夜燈前湘水怨，殷勤封在七條絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 27
    },
    {
        "title": "病中知皇子陂荷花盛發寄王繢",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "十裏蓮塘路不賒，病來簾外是天涯。",
            "煩君四句遙相寄，應得诗中便看花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 28
    },
    {
        "title": "戲唐仁烈",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "自知年幾偏應少，先把屠蘇不讓春。",
            "倘更数年逢此日，還應惆悵羨他人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 29
    },
    {
        "title": "上下七盤二首",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "鬥回山路掩皇州，二载歡娛一望休。",
            "從此万重青嶂合，无因更得重回頭。",
            "商山半月雨漫漫，偶值新晴下七盤。",
            "山似换來天似洗，可怜风日到長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 30
    },
    {
        "title": "八月十五日夜",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "去年今夜在商州，還為清光上驛樓。",
            "宛是依依舊顏色，自怜人换幾般愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 31
    },
    {
        "title": "南詔朱藤杖",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "六節南藤色似朱，拄行階砌勝人扶。",
            "會須将入深山去，倚看雲泉作老夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 32
    },
    {
        "title": "夜意",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "蕭疏盡地林无影，浩蕩連天月有波。",
            "独立空亭人睡后，洛橋风便水聲多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 33
    },
    {
        "title": "漫作",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "月色莫來孤寢处，春风又向別人家。",
            "梁園桃李雖无数，斷定今年不看花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 34
    },
    {
        "title": "訪劉君",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "擾擾馳蹄又走輪，五更飛盡九衢塵。",
            "靈芝破觀深松院，還有齋时未起人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 35
    },
    {
        "title": "楊柳枝詞",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "已作綠絲籠曉日，又成飛絮撲晴波。",
            "隋家不合栽楊柳，長遣行人春恨多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 36
    },
    {
        "title": "寄杭州崔使君",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "朝下归來只閉關，羨君高步出人寰。",
            "三年不見塵中事，滿眼江濤送雪山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 37
    },
    {
        "title": "窮冬曲江闲步",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "雪盡南坡雁北飛，草根春意勝春暉。",
            "曲江永日无人到，独繞寒池又独归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 38
    },
    {
        "title": "省中題新植雙松",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "端坐高宮起遠心，雲高水闊共幽沈。",
            "更堂寓直将谁语，自種雙松伴夜吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 39
    },
    {
        "title": "崇山郡",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "地盡炎荒瘴海頭，圣朝今又放驩兜。",
            "交州已在南天外，更過交州四五州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 40
    },
    {
        "title": "臨水",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "一見心原斷百憂，益知身世两悠悠。",
            "江亭独倚闌幹处，人亦无言水自流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 41
    },
    {
        "title": "題江上柳寄李使君",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "桂江南渡无楊柳，見此令人眼暫明。",
            "應學郡中賢太守，依依相向许多情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 42
    },
    {
        "title": "江上見月懷古",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "月上江平夜不风，伏波遺跡半成空。",
            "今宵倍欲悲陵谷，銅柱分明在水中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 43
    },
    {
        "title": "鸚鵡",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "勸爾莫移禽鳥性，翠毛紅觜任天真。",
            "如今漫學人言巧，解语終須累爾身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 44
    },
    {
        "title": "寄婺州李給事二首",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "心盡玉皇恩已遠，跡留江郡宦應孤。",
            "不知壯气今何似，犹得淩雲貫日无。",
            "瘴鬼翻能念直心，五年相遇不相侵。",
            "目前唯有思君病，无底滄溟未是深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 45
    },
    {
        "title": "秋日",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "六眸龜北涼應早，三足烏南日正長。",
            "常記京關怨搖落，如今目斷滿林霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 46
    },
    {
        "title": "遣意",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "梧桐墜露悲先朽，松桂淩霜倚后枯。",
            "不是世間長在物，暫分貞脆竟何殊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 47
    },
    {
        "title": "戲酬惟賞上人",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "師是浮雲无著身，我居塵網敢相親。",
            "應從海上秋风便，偶自飛來不為人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 48
    },
    {
        "title": "寓言",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "流水頹阳不暫停，東流西落两无情。",
            "不是世間人自老，古來華发此中生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 49
    },
    {
        "title": "憶家",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "天海相連无盡处，夢魂來往尚應難。",
            "谁言南海无霜雪，試向愁人两鬢看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 50
    },
    {
        "title": "留客",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "青梅欲熟筍初長，嫩綠新阴繞砌涼。",
            "湖館翛然无俗客，白衣居士且匡床。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 51
    },
    {
        "title": "別蘄春王判官",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "四十年來真久故，三千裏外暫相逢。",
            "今日一杯成遠別，煙波眇眇恨重重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 52
    },
    {
        "title": "将發循州社日于所居館宴送",
        "author": "裴夷直",
        "biography": "",
        "paragraphs": [
            "浪花如雪疊江风，社過高秋万恨中。",
            "明日便隨江燕去，依依俱是故巢空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十三",
        "no#": 53
    }
