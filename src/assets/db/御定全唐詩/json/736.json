[
    {
        "title": "從蜀後主幸秦川上梓潼山",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "彩仗拂寒煙，鳴騶在半天。黃雲生馬足，白日下松巔。",
            "盛德安疲俗，仁风扇極邊。前程问成紀，此去尚三千。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 1
    },
    {
        "title": "和蜀後主題劍門",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "孟阳曾有语，刊在白雲棱。李杜常挨托，孫劉亦恃凭。",
            "庸才安可守，上德始堪矜。暗指長天路，濃巒蔽幾層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 2
    },
    {
        "title": "荊南席上詠胡琴妓二首",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "紅妝齊抱紫檀槽，一抹朱弦四十條。湘水淩波慚鼓瑟，",
            "丹禁舊臣來側耳，骨清神爽似闻韶。",
            "玉纖挑落折冰聲，散入秋空韵轉清。二五指中句塞雁，",
            "无限細腰宮裏女，就中偏愜楚王情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 3
    },
    {
        "title": "題麥積山天堂",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "躡盡懸空万仞梯，等闲身共白雲齊。簷前下視群山小，",
            "天邊為要留名姓，拂石殷勤身自題。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 4
    },
    {
        "title": "題鬥山觀",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "霞衣欲舉醉陶陶，不覺全家住絳霄。拔宅只知雞犬在，",
            "為有故林蒼柏健，露華涼葉鎖金飆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 5
    },
    {
        "title": "題孤雲絕頂淮阴祠",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "一握寒天古木深，路人犹说漢淮阴。孤雲不掩興亡策，",
            "當时若放還西楚，尺寸中華未可侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 6
    },
    {
        "title": "和韓昭從駕過白衛嶺",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "龍旆飄颻指極邊，到时犹更二三千。登高曉蹋巉岩石，",
            "秦民莫遣无恩及，大散關東別有天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 7
    },
    {
        "title": "賀王溥入相",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "一戰文場拔趙旗，便調金鼎佐无為。白麻驟降恩何極，",
            "立班始得遙相見，親洽爭如未貴时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 8
    },
    {
        "title": "与諸門生春日會飲繁台賦",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "柳阴如霧絮成堆，又引門生飲古台。淑景即隨风雨去，",
            "爛醉也須诗一首，不能空放馬頭回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 9
    },
    {
        "title": "示諸門生",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "二百一十四門生，春风初長羽毛成。擲金换得天邊桂，",
            "衰翁漸老兒孫小，異日知谁略有情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 10
    },
    {
        "title": "過平戎谷吊胡翽",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "立馬荒郊滿目愁，伊人何罪死林丘。风號古木悲長在，",
            "不緣魂寄孤山下，此地堪名鸚鵡洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 11
    },
    {
        "title": "奉詔賦劍州途中鷙獸",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "劍牙釘舌血毛腥，窺算勞心豈暫停。不与大朝除患難，",
            "今日帝王親出狩，白雲岩下好藏形。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 12
    },
    {
        "title": "放猿",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "放爾丁甯複故林，舊來行處好追尋。月明巫峽堪怜靜，",
            "三秋果熟松梢健，任抱高枝徹曉吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 13
    },
    {
        "title": "遇放猿再作",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "嶓塚祠前漢水濱，飲猿連臂下嶙峋。漸來子細窺行客，",
            "數聲腸斷和雲叫，识是前时舊主人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 14
    },
    {
        "title": "句",
        "author": "王仁裕",
        "biography": "",
        "paragraphs": [
            "鐵鎖寨門扃白日，大张旗幟插青天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十六",
        "no#": 15
    }
]