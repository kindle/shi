[
    {
        "title": "春日山亭",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "醉來重整華阳巾，搔首驚看白发新。莫道愁多因病酒，",
            "正是圣朝全盛日，詎知林下有闲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 1
    },
    {
        "title": "寄周韶州",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "十年學道困窮廬，空有長才重老儒。功业要當垂永久，",
            "寄语故人休悵怏，古來賢達事多殊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 2
    },
    {
        "title": "秋夜醉归，有感而賦",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "銜杯谁道易更闌，沉醉归來不自歡。惆悵后时孤劍冷，",
            "多少客懷消不得，臨风搔首浩漫漫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 3
    },
    {
        "title": "寄範使君",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "未秋為別已終秋，咫尺婁江路阻修。心上惟君知委曲，",
            "西望家山成浩歎，臨风搔首不勝愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 4
    },
    {
        "title": "送羅約",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "雨晴江館柳依依，握手那堪此別離。独鶴孤琴隨遠旆，",
            "后夜定知相憶处，東风回首不勝悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 5
    },
    {
        "title": "題李昭訓山水",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "卜築藏修地自偏，尊前诗酒集群賢。半岩松暝时藏鶴，",
            "南州人物依然在，山水幽居勝輞川。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 6
    },
    {
        "title": "处厚游杭，作诗寄之",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "江村搖落暫逢秋，況是闻君独遠遊。浙水风煙思吊古，",
            "念我故人勞碌久，不如投老臥滄洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 7
    },
    {
        "title": "山中有懷李十二",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "林前风景晚蒼蒼，林下懷人路杳茫。白发流年淹舊业，",
            "何事登樓□□□，幾回搔首□思归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 8
    },
    {
        "title": "客中作",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "異鄉歲晚悵離懷，遊子驅馳愧不才。夜夜砧聲催客去，",
            "幾度无聊倍惆悵，臨风搔首独興哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 9
    },
    {
        "title": "山寺律僧画蘭竹图",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "偶來絕頂興无窮，独有山僧筆最工。綠徑日長袁戶在，",
            "欲結歲寒盟不去，忘机相对画图中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 10
    },
    {
        "title": "送客之杭",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "西风吹冷透貂裘，行色匆匆不暫留。帆帶夕阳投越浦，",
            "懸想到杭州興地，尊前應与話離憂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 11
    },
    {
        "title": "有感二首",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "何事離懷入夢频，貧居寂寞四无鄰。诗因韵險難成律，",
            "十年飄泊如萍跡，一度登臨一悵神。",
            "搔首臨风独倚欄，客邊驚觉歲華残。棲迟未遇常鋾薦，",
            "何如日日長如醉，付与诗人一笑看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 12
    },
    {
        "title": "送沈侯之京",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "悠悠旌旆出東樓，特出仙郎上帝州。劉旻才高能富國，",
            "欲盡故人尊酒意，春风江上暫停舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 13
    },
    {
        "title": "寄羽士",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "別來有路隔仙凡，幾度臨风欲去難。樂道无时忘鶴伴，",
            "使我浮生塵鞅脫，相從應得一盤桓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 14
    },
    {
        "title": "題趙支",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "林間曲徑掩衡茅，繞屋青青翡翠梢。一枕秋聲鸞舞月，",
            "我有清风高節在，知君不負歲寒交。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 15
    },
    {
        "title": "司馬遷墓",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "落落長才負不羈，中原回首益堪悲。英雄此日谁能薦，",
            "經過詞客空惆悵，落日寒煙賦黍離。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 16
    },
    {
        "title": "春遊",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "錦袍日暖耀冰蠶，上客陪遊酒半酣。笑拂吟鞭邀好興，",
            "正是太平行樂处，春风花下且停驂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 17
    },
    {
        "title": "水西草堂",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "蘿徑蕭然曲业存，閑雲流水四无鄰。身留白屋潛蹤跡，",
            "遺书自有親□处，何必驅馳擾世塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 18
    },
    {
        "title": "送羽衣之京",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "羽衣縹緲拂塵囂，悵別河梁贈柳條。閬苑雲深孤鶴迥，",
            "自是長生林下客，也陪鴛鹭入清朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 19
    },
    {
        "title": "題道院壁",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "山中舊宅四无鄰，草淨雲和迥絕塵。神枣胡麻能飯客，",
            "若使凡緣終可脫，也應從此度閑身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 20
    },
    {
        "title": "贈歐阳詹",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "為客囊无季子金，半生蹤跡任浮沉。服勤因念劬勞重，",
            "家林千里遙相憶，幾度停車一悵吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 21
    },
    {
        "title": "邵公母",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "搔首驚闻楚些歌，拂衣归去淚懸河。劬勞常想三春恨，",
            "傷心独有黃堂客，幾度臨风詠蓼莪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 22
    },
    {
        "title": "客中作",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "千里雲山戀舊遊，寒窗涼雨夜悠悠。浮亭花竹频勞夢，",
            "一杯重向樽前醉，莫遣相思累白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 23
    },
    {
        "title": "贈楊处厚",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "十年學道苦勞神，贏得尊前一病身。天上故人皆自貴，",
            "幾度臨风一回首，笑看華发及时新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 24
    },
    {
        "title": "重贈张籍",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "舊日仪容只宛然，笑談不觉度流年。凡緣未了嗟无子，",
            "人生隨处堪為樂，管甚秋香滿鬢邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 25
    },
    {
        "title": "贈殷以道",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "世路紅塵懶步趨，長年結屋傍岩隅。独留鄉井誠非隱，",
            "閑來撫景窮吟处，尊酒臨风不自娛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 26
    },
    {
        "title": "翁母些",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "滿頭華发向人垂，長逝音容迥莫追。先壟每懷风木夜，",
            "独有賢人崇孝義，傷心共詠蓼莪诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 27
    },
    {
        "title": "題山莊",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "蘿屋蕭蕭事事幽，臨风搔首遠凝眸。東園松菊存遺业，",
            "床頭濁酒时时漉，上客相過一任留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 28
    },
    {
        "title": "沈存尚林亭夜宴",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "草堂寂寂景偏幽，到此令人一縱眸。松菊寒香三徑晚，",
            "終日忘情能自樂，清尊應得遣闲愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 29
    },
    {
        "title": "題孫君山亭",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "長年樂道遠塵氛，靜築藏修學隱淪。吟对琴樽庭下月，",
            "林壑能忘軒冕貴，白雲黃鶴好相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 30
    },
    {
        "title": "題徐俞山居",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "青山重疊巧裁攢，引水流泉夜激湍。嵐鎖岩扉清晝暝，",
            "老我不堪诗思杳，幾回吟倚曲欄幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 31
    },
    {
        "title": "送範啟東還京",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "蕭蕭行李上征鞍，滿目離情欲去難。客裏故人尊酒別，",
            "重到京華舊游处，春风佳麗好盤桓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 32
    },
    {
        "title": "樓城敘別",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "故人為客上神州，傾蓋相逢感昔遊。屈指年華嗟遠別，",
            "此際那堪重分手，綠波芳草暫停舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 33
    },
    {
        "title": "写意二首",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "寂寥荒館閉閑門，苔徑阴阴屐少痕。白发顛狂塵夢斷，",
            "醉后曲肱林下臥，此生榮辱不須論。",
            "蕭蕭華发滿頭生，深遠蓬門倦送迎。独喜冥心无外慕，",
            "林下貧居甘困守，盡教城市不知名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 34
    },
    {
        "title": "贈浙西李相公",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "長庚烈烈独遙天，盛世應知降謫仙。月裏昔曾分兔药，",
            "尊酒与君稱壽畢，春风入醉綺羅筵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 35
    },
    {
        "title": "天臺",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "碧溪流水泛桃花，樹繞天臺迥不賒。洞裏无塵通客境，",
            "此地不知何处去，暫留瓊佩臥煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 36
    },
    {
        "title": "送陳衡",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "秋江煙景晚蒼蒼，江上離人促去航。千里一官嗟独往，",
            "不必臨风悲冷落，古來白首尚為郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 37
    },
    {
        "title": "送沈翔",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "江上西风一棹归，故人此別會應稀。清朝盡道无遺逸，",
            "臨岐不用空惆悵，未必新豐老布衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 38
    },
    {
        "title": "過蠡湖",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "東湖煙水浩漫漫，湘浦秋聲入夜寒。风外暗香飄落粉，",
            "幾度篝簾相对处，无邊诗思到吟壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 39
    },
    {
        "title": "登環翠樓",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "山中地僻好藏修，寂寂幽居架小樓。雲樹四圍當戶暝，",
            "我亦人間肥遁客，也将蹤跡寄林丘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 40
    },
    {
        "title": "遊淮雲寺",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "白雲深鎖沃州山，冠蓋登臨眾仰攀。松徑风清闻鶴唳，",
            "興盡凡緣因未晚，裴回依舊到人間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 41
    },
    {
        "title": "遊報本寺",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "山房寂寂蓽門開，此日相期社友來。雅興共尋方外樂，",
            "醉后不知明月上，狂歌直到夜深回。",
            "了然塵事不相關，錫杖时时独看山。白发任教雙鬢改，",
            "自笑微軀長碌碌，幾时來此學无還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 42
    },
    {
        "title": "題陳侯竹亭",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "曾向幽亭一榻分，清风滿座絕塵氛。丹山鳳泣鉤簾聽，",
            "歲寒高節谁能识，独有王猷愛此君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 43
    },
    {
        "title": "送報本寺分韵得通字",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "幾度乘閑謁梵宮，此郎聲價重江東。貴侯知重曾忘勢，",
            "□□□□□□□，□□□□□□□。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 44
    },
    {
        "title": "寄永平友人",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "故人千里隔天涯，幾度臨风動遠思。賈誼上书曾伏闕，",
            "何日归來話疇昔，一樽重敘舊襟期。",
            "朔风獵獵慘寒沙，關月寥寥咽暮笳。放逐一心終去國，",
            "直道未容淹屈久，暫勞蹤跡寄天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 45
    },
    {
        "title": "陳使君山莊",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "新蔔幽居地自偏，士林爭羨使君賢。数椽瀟灑臨溪屋，",
            "秋成准擬重來此，沉醉何妨一榻眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 46
    },
    {
        "title": "題寺壁",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "僧家勝景瞰平川，霧重嵐深馬不前。宛轉数聲花外鳥，",
            "闻道此中堪遁跡，肯容一榻學逃禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 47
    },
    {
        "title": "送徐浩",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "渡口潮平促去舟，莫辭尊酒暫相留。弟兄聚散雲邊雁，",
            "知君此去情偏切，堂上椿萱雪滿頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 48
    },
    {
        "title": "謝惠劍",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "感君三尺鐵，揮攉鬼神驚。浩气中心發，雄风两腋生。",
            "犬戎從此滅，巢穴不时平。万里橫行去，封侯賴有成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 49
    },
    {
        "title": "送僧",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "梵王生別思，之子事遐征。煙水浮杯渡，雲山只履行。",
            "三生塵夢醒，一錫衲衣輕。此去家林近，飄飄物外情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 50
    },
    {
        "title": "送友人",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "有客棹扁舟，相逢不暫留。衣冠重文物，诗酒足风流。",
            "官路生归興，家林想舊遊。臨岐分手后，乘月過蘇州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 51
    },
    {
        "title": "題朱慶餘闲居四首",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "瀟灑藏修处，琴书与画图。白丁門外遠，俗子眼前无。",
            "楚楚臨軒竹，青青映水蒲。道人能愛靜，諸事近清枯。",
            "盡日衡門閉，蒼苔一徑新。客心非厭靜，悟道不憂貧。",
            "白屋懸塵榻，清樽憶故人。近來疏懶甚，诗債后吟身。",
            "閑客幽棲处，瀟然一草廬。路通元亮宅，門对子雲居。",
            "按劍心犹壯，琴书樂有餘。黃金都散盡，收得鄴侯书。",
            "寂寥荒館下，投老欲何為。草色凝陳榻，书聲出董帷。",
            "閑雲長作伴，归鶴独相隨。才薄知无用，安貧不自危。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 52
    },
    {
        "title": "寄张源",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "咫尺西江路，悲歡暫莫闻。青年俱未達，白社独離群。",
            "曲徑荒秋草，衡茅掩夕曛。相思不相見，愁絕賦停雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 53
    },
    {
        "title": "題竹",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "瀟灑碧玉枝，清风追晉賢。数點渭川雨，一縷湘江煙。",
            "不見鳳凰尾，谁识珊瑚鞭。柯亭丁相遇，驚聽奏鈞天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 54
    },
    {
        "title": "有感",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "盛世嗟沉伏，中情怏未舒。途窮悲阮籍，病久憶相如。",
            "无客空塵榻，閑門閉草廬。不勝岑絕处，高臥半床书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 55
    },
    {
        "title": "題山房壁",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "珠林春寂寂，寶地夜沉沉。玄奧凝神久，禪机入妙深。",
            "參同大塊理，窺測至人心。定处波羅蜜，須從物外尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 56
    },
    {
        "title": "訪請上人",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "曲徑繞叢林，鐘聲雜梵音。松风吹定衲，蘿月照禪心。",
            "撫景吟行遠，談玄入悟深。不能塵鞅脫，聊複一登臨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 57
    },
    {
        "title": "送範啟東",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "楊柳春江上，東风一棹輕。行囊归客興，尊酒故人情。",
            "画史名當代，聲華重两京。臨岐分手处，无奈別離生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 58
    },
    {
        "title": "客中作",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "十年江漢客，幾度帝京遊。跡比风前葉，身如水上鸥。",
            "醉吟愁裏月，羞对鏡中秋。悵望频回首，西风憶故丘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 59
    },
    {
        "title": "贈韓翃",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "京國久知名，江河近识荊。不辭今日醉，便有故人情。",
            "細雨孤鴻遠，西风一棹輕。暫时分手去，應不負诗盟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 60
    },
    {
        "title": "禁煙作",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "柳拖金縷拂朱欄，花撲香塵滿繡鞍。",
            "尊酒臨风酬令節，越羅衣薄觉春寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 61
    },
    {
        "title": "閩中回",
        "author": "牟融",
        "biography": "",
        "paragraphs": [
            "帆影隨风過富阳，櫓聲搖月下錢塘。",
            "千山積雪凝寒碧，夢入楓宸繞禦床。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百六十七",
        "no#": 62
    }
]