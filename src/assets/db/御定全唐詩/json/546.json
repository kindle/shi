[
    {
        "title": "題山院",
        "author": "權審",
        "biography": "",
        "paragraphs": [
            "万葉风聲利，一山秋气寒。曉霜浮碧瓦，落日度朱欄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 1
    },
    {
        "title": "絕句",
        "author": "權審",
        "biography": "",
        "paragraphs": [
            "得即高歌失即休，多悲多恨謾悠悠。",
            "今朝有酒今朝醉，明日愁來明日愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 2
    },
    {
        "title": "郡中有懷寄上睦州員外杜十三兄",
        "author": "邢群",
        "biography": "",
        "paragraphs": [
            "城枕溪流更淺斜，麗譙連帶邑人家。經冬野菜青青色，",
            "如今歲晏從羈滯，心喜彈冠事不賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 3
    },
    {
        "title": "早發靈芝望九華寄杜員外使君",
        "author": "曹汾",
        "biography": "",
        "paragraphs": [
            "戴月早辭三秀館，迟明初识九華峰。嵯嵯玉劍寒鋩利，",
            "行春若到五溪上，此处褰帷正面逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 4
    },
    {
        "title": "落花",
        "author": "嚴惲",
        "biography": "",
        "paragraphs": [
            "春光冉冉归何处，更向花前把一杯。",
            "盡日问花花不语，為谁零落為谁開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 5
    },
    {
        "title": "題籌筆驛",
        "author": "殷潛之",
        "biography": "",
        "paragraphs": [
            "江東矜割據，鄴下奪孤嫠。霸略非匡漢，宏图欲佐谁。",
            "奏书辭后主，仗劍出全師。重襲褒斜路，懸開反正旗。",
            "欲将苞有截，必使舉无遺。沈慮經謀際，揮毫決勝时。",
            "圜觚當分画，前箸此操持。山秀扶英气，川流入妙思。",
            "算成功在彀，运去事終虧。命屈天方厭，人亡國自隨。",
            "艱難推舊姓，開創极初基。總歎曾過地，寧探作教資。",
            "若归新歷数，谁複顧衰危。報德兼明道，長留识者知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 6
    },
    {
        "title": "送高遂赴舉",
        "author": "祝元膺",
        "biography": "",
        "paragraphs": [
            "句曲舊宅真，自產日月英。既涵岳瀆气，安无神仙名。",
            "松桂邐迤色，与君相送情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 7
    },
    {
        "title": "寄道友",
        "author": "祝元膺",
        "biography": "",
        "paragraphs": [
            "两頷凝清霜，玉爐焚天香。為我延歲華，得入不死鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 8
    },
    {
        "title": "夢仙謠",
        "author": "祝元膺",
        "biography": "",
        "paragraphs": [
            "蟾蜍夜作青冥燭，螮蝀晴為碧落梯。",
            "好個分明天上路，谁教深入武陵溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 9
    },
    {
        "title": "句",
        "author": "祝元膺",
        "biography": "",
        "paragraphs": [
            "霧紋斑似豹，水力健如龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 10
    },
    {
        "title": "賀鄧璠使君正拜袁州",
        "author": "彭蟾",
        "biography": "",
        "paragraphs": [
            "六年惠愛及黎甿，大府論功俟陟明。尺一詔书天上降，",
            "更待皇恩醒善政，碧油幢到郡齋迎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 11
    },
    {
        "title": "和嚴惲落花诗",
        "author": "王樞",
        "biography": "",
        "paragraphs": [
            "花落花開人世夢，衰榮闲事且持杯。",
            "春风底事輕搖落，何似從來不要開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 12
    },
    {
        "title": "詠宣律和尚袈裟",
        "author": "张希複",
        "biography": "",
        "paragraphs": [
            "共覆三衣中夜寒，披时不鎮尼師壇。",
            "无因蓋得龍宮地，畦裏塵飛葉相残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 13
    },
    {
        "title": "鶯出谷",
        "author": "錢可複",
        "biography": "",
        "paragraphs": [
            "玉律阳和變，时禽羽翮新。载飛初出谷，一囀已驚人。",
            "拂柳宜煙暖，沖花觉露春。摶风翻翰疾，向日弄吭频。",
            "求友心何切，遷喬幸有因。華林高玉樹，棲托及芳晨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 14
    },
    {
        "title": "鶯出谷",
        "author": "张鹭",
        "biography": "",
        "paragraphs": [
            "弱柳隨儔匹，遷鶯正及春。乘风音響遠，映日羽毛新。",
            "已得辭幽谷，還将脫俗塵。鴛鸞方可慕，燕雀迥无鄰。",
            "游止知難屈，翻飛在此伸。一枝如借便，終冀托深仁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 15
    },
    {
        "title": "鶯出谷",
        "author": "劉莊物",
        "biography": "",
        "paragraphs": [
            "幸因辭舊谷，從此及芳晨。欲语如調舌，初飛似畏人。",
            "风調归影便，日暖吐聲频。翔集知无阻，聯綿貴有因。",
            "喜遷喬木近，寧厭对花新。堪念微禽意，關關也愛春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十六",
        "no#": 16
    }
]