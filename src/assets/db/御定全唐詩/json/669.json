[
    {
        "title": "城南偶題",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "谁家朱閣道邊開，竹拂欄幹滿壁苔。野水不知何处去，",
            "可惜登臨好光景，五門須聽鼓聲回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 1
    },
    {
        "title": "贈邊将",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "千千鐵騎擁塵紅，去去平吞万里空。宛轉龍蟠金劍雪，",
            "只有河源与遼海，如今全屬指麾中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 2
    },
    {
        "title": "桃源",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "絕壁相欹是洞門，昔人從此入仙源。数株花下逢珠翠，",
            "山前空有无情水，犹繞當时碧樹村。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 3
    },
    {
        "title": "曲江",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "日照香塵逐馬蹄，风吹浪濺幾回堤。无窮羅綺填花徑，",
            "只緣频燕蓬洲客，引得遊人去似迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 4
    },
    {
        "title": "送韋岫郎中典泗州",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "玉皇恩詔別星班，去壓徐方分野間。有鳥盡巢垂汴柳，",
            "想憶朝天独吟坐，旋飛新作過秦關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 5
    },
    {
        "title": "贈婺州蘇員外",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "帝念瓊枝欲並芳，星分婺女寄仙郎。鸞從闕下雖辭侶，",
            "即看龍虎西归去，便佐羲軒活万方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 6
    },
    {
        "title": "寄友人",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "謝家山水屬君家，曾共持鉤擲歲華。竹裏竹雞眠蘚石，",
            "昨日西风動归思，滿船涼葉在天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 7
    },
    {
        "title": "雨",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "低著煙花漠漠輕，正堪吟坐掩柴扃。乱沾細網垂窮巷，",
            "霽來還有风流事，重染南山一遍青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 8
    },
    {
        "title": "觀錫宴",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "傾朝朱紫正駢闐，紅杏青莎映廣筵。不道樓臺无錦繡，",
            "日暮驊騮相擁去，幾人沉醉失金鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 9
    },
    {
        "title": "城東即事",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "閑尋香陌鳳城東，时暫開襟向遠风。玉笛一聲芳草外，",
            "回首漢宮煙靄裏，天河金閣未央宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 10
    },
    {
        "title": "夏日湖上即事寄晉陵蕭明府",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "亭午羲和駐火輪，開門嘉樹庇湖濆。行來賓客奇茶味，",
            "陶家豈是无诗酒，公退堪驚日已曛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 11
    },
    {
        "title": "对月",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "残霞卷盡出東溟，万古難消一片冰。公子踏開香徑蘚，",
            "別有洞天三十六，水晶台殿冷層層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 12
    },
    {
        "title": "浙西送杜晦侍禦入關",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "紫詔征賢發帝聰，繡衣行处撲香风。鶚归秦樹幽禽散，",
            "鞭鞘所拂三千里，多少諸侯合避驄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 13
    },
    {
        "title": "寄江東道友",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "野亭歌罷指西秦，避俗爭名興各新。碧帶黃麻呈縹緲，",
            "可惜人間好聲勢，片帆羸馬不相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 14
    },
    {
        "title": "下第有懷",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "故鄉朝夕有人還，欲作家书下筆難。滅燭何曾妨夜坐，",
            "但使他年遇公道，月輪長在桂珊珊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 15
    },
    {
        "title": "春日經湖上友人別业",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "何处狂歌破積愁，攜觴共下木蘭舟。綠泉濺石銀屏濕，",
            "一年一電逡巡事，不合花前不醉遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 16
    },
    {
        "title": "長安春日",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "春日皇家瑞景迟，東风无力雨微微。六宮羅綺同时泊，",
            "輸他得路蓬洲客，紅綠山頭爛醉归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 17
    },
    {
        "title": "陪浙西王侍郎夜宴",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "深鎖雷門宴上才，旋看歌舞旋傳杯。黃金鸂鶒當筵睡，",
            "小儒末座频傾耳，只怕城頭画角催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 18
    },
    {
        "title": "春別",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "擲下離觴指乱山，趨程不待鳳笙残。花邊馬嚼金銜去，",
            "殷勤莫厭貂裘重，恐犯三邊五月寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 19
    },
    {
        "title": "送謝進士還閩",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "百越风煙接巨鼇，還鄉心壯不知勞。雷霆入地建溪險，",
            "名場聲利喧喧在，莫向林泉改鬢毛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 20
    },
    {
        "title": "焚书坑",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "竹帛煙銷帝业虛，關河空鎖祖龍居。",
            "坑灰未冷山東乱，劉項元來不讀书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 21
    },
    {
        "title": "東都望幸",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "懶修珠翠上高臺，眉月連娟恨不開。",
            "縱使東巡也无益，君王自領美人來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 22
    },
    {
        "title": "旅舍早起",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "跡暗心多感，神疲夢不遊。驚舟同厭夜，独樹对悲秋。",
            "晚角和人戰，残星入漢流。門前早行子，敲鐙唱離憂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 23
    },
    {
        "title": "癸卯歲毗陵登高會中貽同志",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "流落常嗟勝會稀，故人相遇菊花时。鳳笙龍笛数巡酒，",
            "長楊羽獵須留本，開濟重為闕下期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 24
    },
    {
        "title": "上元夜建元寺觀燈呈智通上人",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "建元看別上元燈，处处回廊鬥火層。珠玉乱拋高殿佛，",
            "无限喧闐留不得，月華西下露華凝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 25
    },
    {
        "title": "《變體诗",
        "author": "章碣",
        "biography": "",
        "paragraphs": [
            "東南路盡吳江畔，正是窮愁暮雨天。鸥鹭不嫌斜两岸，",
            "今古若論英達算，鴟夷高興固无邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十九",
        "no#": 26
    }
]