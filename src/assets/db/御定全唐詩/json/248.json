[
    {
        "title": "題劉相公三湘圖",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "昔別醉衡霍，邇來憶南州。今朝平津邸，兼得瀟湘遊。",
            "稍辨郢門樹，依然芳杜洲。微明三巴峽，咫尺万里流。",
            "飛鳥不知倦，遠帆生暮愁。涔阳指天末，北渚空悠悠。",
            "枕上見漁父，坐中常狎鸥。谁言魏闕下，自有東山幽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 1
    },
    {
        "title": "長安逢故人",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "數年音信斷，不意在長安。馬上相逢久，人中欲認難。",
            "一官今懶道，雙鬢竟羞看。莫问生涯事，只應持釣竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 2
    },
    {
        "title": "送韋湛判官",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "高閣晴江上，重阳古戍間。聊因送归客，更此望鄉山。",
            "惜別心能醉，經秋鬢自斑。臨流興不盡，惆悵水雲間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 3
    },
    {
        "title": "送長沙韋明府",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "秋入長沙縣，蕭條旅宦心。煙波連桂水，官舍映楓林。",
            "雲日楚天暮，沙汀白露深。遙知訟堂裏，佳政在鳴琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 4
    },
    {
        "title": "送孫愿",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "悠然富春客，憶与暮潮归。擢第人多羨，如君独步稀。",
            "乱流江渡淺，遠色海山微。若訪新安路，嚴陵有釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 5
    },
    {
        "title": "送林宗配雷州",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "昨日三峰尉，今朝万里人。平生任孤直，豈是不防身。",
            "海霧多為瘴，山雷乍作鄰。遙怜北戶月，与子独相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 6
    },
    {
        "title": "送洪州李別駕之任",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "南去秋江遠，孤舟興自多。能将流水引，更入洞庭波。",
            "夏口帆初上，潯阳雁正過。知音在霄漢，佐郡豈蹉跎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 7
    },
    {
        "title": "送楊中丞和蕃",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "錦車登隴日，邊草正萋萋。舊好尋君長，新愁聽鼓鼙。",
            "河源飛鳥外，雪嶺大荒西。漢壘今犹在，遙知路不迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 8
    },
    {
        "title": "送李将军赴定州",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "雙旌漢飛将，万里授橫戈。春色臨邊盡，黃雲出塞多。",
            "鼓鼙悲絕漠，烽戍隔長河。莫斷阴山路，天驕已請和。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 9
    },
    {
        "title": "關羽祠送高員外還荊州",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "将军稟天姿，義勇冠今昔。走馬百戰場，一劍万人敵。",
            "雖為感恩者，竟是思归客。流落荊巫間，裴回故鄉隔。",
            "離筵對祠宇，灑酒暮天碧。去去勿複言，銜悲向陳跡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 10
    },
    {
        "title": "送张南史",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "雨餘深巷靜，独酌送残春。車馬雖嫌僻，鶯花不棄貧。",
            "蟲絲粘戶網，鼠跡印床塵。借问山阳會，如今有幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 11
    },
    {
        "title": "送奚賈归吳",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "東南富春渚，曾是謝公遊。今日奚生去，新安江正秋。",
            "水清迎過客，霜葉落行舟。遙想赤亭下，闻猿應夜愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 12
    },
    {
        "title": "送陸員外赴潮州",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "含香臺上客，剖竹海邊州。楚地多归信，閩溪足乱流。",
            "今朝永嘉興，重見謝公遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 13
    },
    {
        "title": "送裴補闕入河南幕",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "皎然青瑣客，何事動行軒。苦節酬知己，清吟去掖垣。",
            "秋城臨海樹，寒月上營門。鄒魯诗书國，應无鼙鼓喧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 14
    },
    {
        "title": "送韓司直路出延陵",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "游吳還適越，來往任风波。複送王孫去，其如春草何。",
            "岸明残雪在，潮滿夕阳多。季子留遺廟，停舟試一過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 15
    },
    {
        "title": "盩厔縣鄭礒宅送錢大",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "暮蟬不可聽，落葉豈堪闻。共是悲秋客，那知此路分。",
            "荒城背流水，遠雁入寒雲。陶令門前菊，餘花可贈君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 16
    },
    {
        "title": "送元詵還丹阳別业",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "已知成傲吏，複見解朝衣。應向丹阳郭，秋山独掩扉。",
            "草堂連古寺，江日動晴暉。一別滄洲遠，蘭橈幾歲归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 17
    },
    {
        "title": "送崔侍禦往容州宣慰",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "秦原独立望湘川，擊隼南飛向楚天。奉詔不言空问俗，",
            "疇昔常闻陸賈说，故人今日豈徒然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 18
    },
    {
        "title": "朱方南郭留別皇甫冉",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "縈回楓葉岸，留滯木蘭橈。吳岫新經雨，江天正落潮。",
            "故人勞見愛，行客自无憀。若问前程事，孤雲入剡遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 19
    },
    {
        "title": "贈张五諲归濠州別业",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "常知罷官意，果与世人疏。複此涼风起，仍闻濠上居。",
            "故山期采菊，秋水憶觀魚。一去蓬蒿徑，羨君閑有餘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 20
    },
    {
        "title": "送王司馬赴潤州",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "暫屈文為吏，聊将祿代耕。金陵且不遠，山水複多名。",
            "楚塞因高出，寒潮入夜生。離心逐春草，直到建康城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 21
    },
    {
        "title": "留盧秦卿",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "知有前期在，歡如此夜中。无将故人酒，不及古淳风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 22
    },
    {
        "title": "贈強山人",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "或掉輕舟或杖藜，尋常適意釣前溪。",
            "草堂竹徑在何處，落日孤煙寒渚西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 23
    },
    {
        "title": "贈韋司直",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "闻君感歎二毛初，舊友相依万里餘。烽火有时驚暫定，",
            "昨日风光還入戶，登山臨水意何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 24
    },
    {
        "title": "石城館酬王将军",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "谁能繡衣客，肯駐木蘭舟。連雁沙邊至，孤城江上秋。",
            "归帆背南浦，楚塞入西樓。何處看離思，滄波日夜流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 25
    },
    {
        "title": "酬王季友題半日村別业兼呈李明府",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "村映寒原日已斜，煙生密竹早归鴉。長溪南路當群岫，",
            "欲待主人林上月，還思潘嶽縣中花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 26
    },
    {
        "title": "酬二十八秀才見寄",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "昨夜山月好，故人果相思。清光到枕上，嫋嫋涼风时。",
            "永意能在我，惜无攜手期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 27
    },
    {
        "title": "冬夕寄青龍寺源公",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "斂屨入寒竹，安禪過漏聲。高松残子落，深井凍痕生。",
            "罷磬风枝動，懸燈雪屋明。何當招我宿，乘月上方行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 28
    },
    {
        "title": "塞下曲",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "寶刀塞下兒，身經百戰曾百勝，壯心竟未嫖姚知。",
            "白草山頭日初沒，黃沙戍下悲歌發。蕭條夜靜邊风吹，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 29
    },
    {
        "title": "柏林寺南望",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "溪上遙闻精舍鐘，泊舟微徑度深松。",
            "青山霽後雲犹在，画出東南四五峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 30
    },
    {
        "title": "宿杜判官江樓",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "適楚豈吾愿，思归秋向深。故人江樓月，永夜千里心。",
            "葉落覺鄉夢，鳥啼驚越吟。寥寥更何有，斷续空城砧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 31
    },
    {
        "title": "春宴王補闕城東別业",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "柳陌乍隨州勢轉，花源忽傍竹阴開。能将瀑水清人境，",
            "地主同聲複同舍，留歡不畏夕阳催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 32
    },
    {
        "title": "郢城西樓吟",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "連山盡處水縈回，山上戍門臨水開。朱欄直下一百丈，",
            "沙洲楓岸无來客，草綠花紅山鳥鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 33
    },
    {
        "title": "聽鄰家吹笙",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "鳳吹聲如隔彩霞，不知牆外是谁家。",
            "重門深鎖无尋處，疑有碧桃千樹花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 34
    },
    {
        "title": "登丹阳北樓",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "寒皋那可望，旅望又初還。迢遞高樓上，蕭條曠野閑。",
            "暮晴依遠水，秋興屬連山。浮客时相見，霜凋動翠顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 35
    },
    {
        "title": "題精舍寺",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "石林精舍武溪東，夜扣禪關謁遠公。月在上方諸品靜，",
            "惟有雙峰最高頂，此心期与故人同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 36
    },
    {
        "title": "雙林寺謁傅大士",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "草露經前代，津梁及後人。此方今示滅，何國更分身。",
            "月色空知夜，松阴不記春。犹怜下生日，應在一微塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 37
    },
    {
        "title": "題尹真人祠",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "窅窅雲旗去不還，阴阴祠宇閉空山。",
            "我來始悟丹青妙，稽首如逢冰雪顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 38
    },
    {
        "title": "山中即事",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "入谷多春興，乘舟棹碧潯。山雲昨夜雨，溪水曉來深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 39
    },
    {
        "title": "湘夫人二首",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "蛾眉對湘水，遙哭蒼梧山。万乘既已歿，孤舟谁忍還。",
            "至今楚竹上，犹有淚痕斑。",
            "南有涔阳路，渺渺多新愁。桂酒神降时，回风江上秋。",
            "彩雲忽无處，碧水空安流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 40
    },
    {
        "title": "蓋少府新除江南尉问风俗",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "闻君作尉向江潭，吳越风煙到自諳。客路尋常隨竹影，",
            "惟有夜猿啼海樹，思鄉望國意難堪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 41
    },
    {
        "title": "春宴张舍人宅",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "懶尋芳草徑，來接侍臣筵。山色知残雨，牆阴覺暮天。",
            "鶯啼漢宮柳，花隔杜陵煙。地与東城接，春光醉目前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 42
    },
    {
        "title": "寄李袁州桑落酒",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "色比瓊漿犹嫩，香同甘露仍春。",
            "十千提攜一鬥，遠送瀟湘故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 43
    },
    {
        "title": "贈万生下第還吳）",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "直道多不偶，美才應息机。灞陵春欲暮，雲海独言归。",
            "為客成白首，入門嗟布衣。蓴羹若可憶，慚出掩柴扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 44
    },
    {
        "title": "送大德講时河東徐明府招",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "遠近作人天，王城指日邊。宰君迎说法，童子伴隨緣。",
            "到處花為雨，行时杖出泉。今宵松月下，開閣想安禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 45
    },
    {
        "title": "赴无錫別靈一上人",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "高僧本姓竺，開士舊名林。一入春山裏，千峰不可尋。",
            "新年芳草遍，度日白雲深。欲问微官去，懸知訝此心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 46
    },
    {
        "title": "送粲上人兼寄梁鎮員外",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "季月還鄉独未能，林行溪宿厭層冰。尺素欲傳三署客，",
            "借问從來香積寺，何时攜手更同登。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 47
    },
    {
        "title": "送韋逸人归鐘山",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "逸人归路遠，弟子出山迎。服药顏犹駐，耽书癖已成。",
            "柴扉多歲月，藜杖見公卿。更作儒林傳，應須载姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 48
    },
    {
        "title": "登无錫北樓",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "秋興因危堞，归心過遠山。风霜征雁早，江海旅人還。",
            "驛樹寒仍密，漁舟晚更閑。仲宣何所賦，只欲滯柴關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 49
    },
    {
        "title": "和王相公題中书叢竹寄上元相公",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "多时仙掖裏，色並翠琅玕。幽意含煙月，清阴庇蕙蘭。",
            "枝繁宜露重，葉老愛天寒。竟日雙鸞止，孤吟為一看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 50
    },
    {
        "title": "酬蕭二十七侍禦初秋言懷",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "楚客秋多興，江林月漸生。細枝涼葉動，極浦早鴻聲。",
            "勝賞睽前夕，新诗報遠情。曲高慚和者，惆悵閉寒城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 51
    },
    {
        "title": "奉和杜相公益昌路作",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "春半梁山正落花，台衡受律向天涯。南去猿聲傍雙節，",
            "已見廟謨能喻蜀，新文更喜報金華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 52
    },
    {
        "title": "賦得長洲苑送李惠",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "草深那可訪，地久阻相傳。散漫三秋雨，疏蕪万里煙。",
            "都迷采蘭處，強記館娃年。客有游吳者，臨风思眇然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 53
    },
    {
        "title": "別房士清",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "世路還相見，偏堪淚滿衣。那能郢門別，独向鄴城归。",
            "平楚看蓬轉，連山望鳥飛。蒼蒼歲阴暮，況複惜馳暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 54
    },
    {
        "title": "送彭偃房由赴朝因寄錢大郎中李十七舍人",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "衰病已經年，西峰望楚天。风光欺鬢发，秋色换山川。",
            "寂寞浮雲外，支離漢水邊。平生故人遠，君去話潸然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 55
    },
    {
        "title": "送李遂之越",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "未習风波事，初為東越遊。露沾湖草晚，月照海山秋。",
            "梅市門何處，蘭亭水向流。西興待潮信，落日滿孤舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 56
    },
    {
        "title": "送鄭正則徐州行營",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "從军非隴頭，師在古徐州。氣勁三河卒，功全万戶侯。",
            "元戎閫外略，才子握中籌。莫聽關山曲，還生塞上愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 57
    },
    {
        "title": "送錢拾遺归兼寄劉校书",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "墟落歲阴暮，桑榆煙景昏。蟬聲靜空館，雨色隔秋原。",
            "归客不可望，悠然林外村。終當報芸閣，攜手醉柴門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 58
    },
    {
        "title": "送郴縣裴明府之任兼充宣慰",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "白蘋楚水三湘遠，芳草秦城二月初。連雁北飛看欲盡，",
            "別後天涯何所寄，故交惟有袖中书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 59
    },
    {
        "title": "送李敖湖南书記",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "怜君才与阮家同，掌記能資亞相雄。入楚豈忘看淚竹，",
            "莫信衡湘书不到，年年秋雁過巴東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 60
    },
    {
        "title": "送麹司直",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "曙雪蒼蒼兼曙雲，朔风煙雁不堪闻。",
            "貧交此別无他贈，唯有青山遠送君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 61
    },
    {
        "title": "送別",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "穆陵關上秋雲起，安陸城邊遠行子。",
            "薄暮寒蟬三两聲，回頭故鄉千万里。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 62
    },
    {
        "title": "咸阳西樓別竇審",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "西樓迥起寒原上，霽日遙分万井間。小苑城隅連渭水，",
            "时命如今犹未偶，辭君擬欲拂衣還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 63
    },
    {
        "title": "闻蟬寄友人",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "昨日始闻鶯，今朝蟬又鳴。朱顏向華发，定是幾年程。",
            "故國白雲遠，闲居青草生。因垂數行淚，书寄十年兄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 64
    },
    {
        "title": "送李騎曹之靈武甯侍",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "一歲一归寧，涼天數騎行。河來當塞曲，山遠与沙平。",
            "縱獵旗风卷，聽笳帳月生。新鴻引寒色，回日滿京城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 65
    },
    {
        "title": "馮翊西樓",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "城上西樓倚暮天，樓中归望正淒然。近郭乱山橫古渡，",
            "陶令好文常對酒，相招一和白雲篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 66
    },
    {
        "title": "郢城秋望",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "白首思归归不得，空山闻雁雁聲哀。",
            "高城落日望西北，又見秋风逐水來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 67
    },
    {
        "title": "夜泊湘江",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "湘山木落洞庭波，湘水連雲秋雁多。",
            "寂寞舟中谁借问，月明只自聽漁歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 68
    },
    {
        "title": "留別常著",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "歲晏蒼郊蓬轉时，遊人相見说归期。",
            "宓君堂上能留客，明日還家應未迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 69
    },
    {
        "title": "送张光归吳",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "看取庭蕪白露新，勸君不用久风塵。",
            "秋來多見長安客，解愛鱸魚能幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 70
    },
    {
        "title": "闻吹楊葉者二首",
        "author": "郎士元",
        "biography": "",
        "paragraphs": [
            "妙吹楊葉動悲笳，胡馬迎风起恨賒。",
            "若是雁門寒月夜，此时應卷盡驚沙。",
            "天生一藝更无倫，寥亮幽音妙入神。",
            "吹向別離攀折處，當應合有斷腸人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百四十八",
        "no#": 71
    }
]