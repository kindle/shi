[
    {
        "title": "春日作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "和气來无象，物情還暗新。乾坤一夕雨，草木万方春。",
            "染水煙光媚，催花鳥语频。高臺曠望处，歌詠屬诗人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 1
    },
    {
        "title": "寒江暮泊寄左偃",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "維舟蘆荻岸，離恨若為寬。煙火人家遠，汀洲暮雨寒。",
            "天涯孤夢去，篷底一燈残。不是凭騷雅，相思写亦難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 2
    },
    {
        "title": "喜春雨有寄",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "青春終日雨，公子莫思晴。任阻西園會，且觀南畝耕。",
            "最怜滋壟麥，不恨濕林鶯。父老應相賀，豐年兆已成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 3
    },
    {
        "title": "魏夫人壇",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "仙壇遺跡在，苔合落花明。絳節何年返，白雲終日生。",
            "旋新芳草色，依舊偃松聲。欲问希夷事，音塵隔上清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 4
    },
    {
        "title": "訪洞神宮邵道者不遇",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "閑來仙觀问希夷，雲滿星壇水滿池。",
            "羽客不知何处去，洞前花落立多时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 5
    },
    {
        "title": "寄贈致仕沈彬郎中",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "鶴氅换朝服，逍遙雲水鄉。有时乘一葉，载酒入三湘。",
            "塵夢年來息，诗魔老亦狂。蓴羹与鱸膾，秋興最宜長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 6
    },
    {
        "title": "贈別",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "行杯酌罷歌聲歇，不觉前汀月又生。",
            "自是離人魂易斷，落花芳草本无情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 7
    },
    {
        "title": "送劉恭遊廬山兼寄令上人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "松桂煙霞蔽梵宮，诗流閑去訪支公。",
            "石堂磬斷相逢夜，五老月生溪影空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 8
    },
    {
        "title": "宿廬山白雲峰重道者院",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "絕頂松堂喜暫遊，一宵玄論接浮丘。雲開碧落星河近，",
            "他时书劍酬恩了，愿逐鸞車看十洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 9
    },
    {
        "title": "海上從事秋日书懷",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "悠悠旅宦役塵埃，舊业那堪信未回。千里夢隨残月斷，",
            "唯有搜吟遣懷抱，涼风时複上高臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 10
    },
    {
        "title": "訪蔡文慶处士留題",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "幽人棲息处，一到滌塵心。蘚色花阴闊，棋聲竹徑深。",
            "籬根眠野鹿，池面戲江禽。多謝相留宿，開樽拂素琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 11
    },
    {
        "title": "寄廬岳鑒上人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "嶽寺棲瓶錫，常人親亦難。病披青衲重，晚剃白髭寒。",
            "烘壁茶煙暗，填溝木葉幹。昔年皆禮謁，频到碧雲端。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 12
    },
    {
        "title": "书小齋壁",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "其谁肯見尋，冷淡少知音。塵土侵閑榻，煙波隔故林。",
            "竹风醒晚醉，窗月伴秋吟。道在唯求己，明时豈陸沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 13
    },
    {
        "title": "懷王道者",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "閑思王道者，逸格世難群。何处眠青嶂，從來愛白雲。",
            "酒沽應独醉，药熟许谁分。正作趨名计，如何得見君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 14
    },
    {
        "title": "桃花",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "只應紅杏是知音，灼灼偏宜間竹阴。幾樹半開金谷曉，",
            "谁步宋牆明月下，好香和影上衣襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 15
    },
    {
        "title": "思舊遊有感",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "長憶銜杯处，酕醄尚未闌。江南正煙雨，樓上恰春寒。",
            "好樹藏鶯密，平蕪徹野寬。如今无处覓，音信隔波瀾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 16
    },
    {
        "title": "依韵和智謙上人送李相公赴昭武军",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "暫別廟堂上，雄藩去豁情。秋风生雁渚，晚霧濕龍旌。",
            "吟裏過侯服，夢中归帝城。下車军庶樂，千里月華清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 17
    },
    {
        "title": "姑蘇懷古",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "闔閭興霸日，繁盛複风流。歌舞一場夢，煙波千古愁。",
            "樵人归野徑，漁笛起扁舟。觸目牽傷感，将行又駐留。",
            "蘇台蹤跡在，曠望向江濱。往事谁堪问，連空草自春。",
            "花疑西子臉，濤想伍胥神。吟盡情難盡，斜阳照路塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 18
    },
    {
        "title": "贈史虛白",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "致主嘉謀尚未伸，慨然深志与谁論。喚回古意琴開匣，",
            "九重夢卜时終在，莫向深雲独閉門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 19
    },
    {
        "title": "贈蒯亮处士",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "著得新书義更幽，負琴何处不遨遊。玄宮寄宿月華冷，",
            "吾君側席求賢切，未可懸瓢枕碧流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 20
    },
    {
        "title": "春夕偶作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "早是春愁觸目生，那堪春夕酒初醒。",
            "貫珠聲罷人归去，半落桃花月在庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 21
    },
    {
        "title": "子規",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "暮春滴血一聲聲，花落年年不忍聽。",
            "帶月莫啼江畔樹，酒醒遊子在離亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 22
    },
    {
        "title": "书王秀才壁",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "茅舍何寥落，門庭長綠蕪。貧來賣书劍，病起憶江湖。",
            "对枕暮山碧，伴吟涼月孤。前賢多晚達，莫歎有霜須。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 23
    },
    {
        "title": "春日途中作",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "幹祿趨名者，迢迢別故林。春风短亭路，芳草異鄉心。",
            "雨過江山出，鶯啼村落深。未知将雅道，何处謝知音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 24
    },
    {
        "title": "依韵和蠡澤王去微秀才見寄",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "咫尺风騷客，難諧面繼酬。相思对煙雨，一雁下汀洲。",
            "花影谁家塢，笛聲何处樓。支筇朗吟罷，搔首独迟留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 25
    },
    {
        "title": "送孫孔二秀才游廬山",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "廬山多勝景，偏稱二君遊。松徑蒼苔合，花阴碧澗流。",
            "傾壺同坐石，搜句共登樓。莫學天臺客，逢山即駐留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 26
    },
    {
        "title": "春日野望懷故人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "野外登臨望，蒼蒼煙景昏。暖风醫病草，甘雨洗荒村。",
            "雲散天邊野，潮回島上痕。故人不可見，倚杖役吟魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 27
    },
    {
        "title": "游玄真觀",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "閑吟游古觀，靜慮相神仙。上景非難度，阴功不易全。",
            "醮壇松作蓋，丹井蘚成錢。浩浩紅塵裏，谁來叩自然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 28
    },
    {
        "title": "劍客",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "恩酬期必報，豈是輒輕生。神劍沖霄去，谁為平不平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 29
    },
    {
        "title": "鶴",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "警露精神異，沖天羽翼新。千年一归日，谁识令威身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 30
    },
    {
        "title": "送致仕沈彬郎中游茅山",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "掛卻朝冠披鶴氅，羽人相伴恣遨遊。忽因风月思茅嶺，",
            "華阳洞府年光永，莫向仙鄉擬駐留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 31
    },
    {
        "title": "題廬山東寺遠大師影堂",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "遠公遺跡在東林，往事名存動苦吟。杉檜已依靈塔老，",
            "十八賢人消息斷，蓮池千载月沉沉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 32
    },
    {
        "title": "庭葦",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "品格清於竹，诗家景最幽。從栽向池沼，長似在汀洲。",
            "玩好招溪叟，棲堪待野鸥。影疏當夕照，花乱正深秋。",
            "韵細堪清耳，根牢好系舟。故溪高岸上，冷淡有谁遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 33
    },
    {
        "title": "寄左偃",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "每病风騷路，荒涼人莫遊。惟君還似我，成癖未能休。",
            "舍寐緣孤月，忘形為九秋。垂名如不朽，那恨雪生頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 34
    },
    {
        "title": "宿山店书懷寄東林令图上人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "一宿山前店，旅情安可窮。猿聲鄉夢后，月影竹窗中。",
            "南楚征途闊，東吳舊业空。虎溪蓮社客，應笑此飄蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 35
    },
    {
        "title": "途中闻子規",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "春残杜宇愁，越客思悠悠。雨歇孤村裏，花飛遠水頭。",
            "微风聲漸咽，高樹血應流。因此频回首，家山隔幾州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 36
    },
    {
        "title": "春日书懷",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "千峰雪盡鳥聲春，日永孤吟野水濱。",
            "霄漢路岐升未得，花时空拂滿衣塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 37
    },
    {
        "title": "所思代人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "巫峽雲深湘水遙，更无消息夢空勞。",
            "夢回深夜不成寐，起立闲庭花月高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 38
    },
    {
        "title": "春晚過明氏闲居",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "寥寥陋巷独扃門，自樂清虛不厭貧。数局棋中消永日，",
            "羨爾朗吟无外事，滄洲何必去垂綸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 39
    },
    {
        "title": "贈重安寂道者",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "寒松肌骨鶴心情，混俗陶陶隱姓名。白发只闻悲短景，",
            "每许相親應计分，琴餘常見話蓬瀛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 40
    },
    {
        "title": "江邊吟",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "风暖汀洲吟興生，遠山如画雨新晴。残阳影裏水東注，",
            "盤桓漁舍忘归去，雲靜高空月又明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 41
    },
    {
        "title": "獻张義方常侍",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "雄飛看是逼岩廊，逸思常闻不暫忘。公署靜眠思水石，",
            "乘興有时招羽客，橫琴移月啟茅堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 42
    },
    {
        "title": "贈永真杜翱少府",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "藍袍竹簡佐琴堂，縣僻人稀觉日長。愛靜不嫌官況冷，",
            "騫翥會應霄漢去，漁竿休更戀滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 43
    },
    {
        "title": "獻中书韓舍人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "丹墀朝退后，靜院即冥搜。盡日捲簾坐，前峰當檻秋。",
            "烹茶留野客，展画看滄洲。見说東林夜，尋常秉燭遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 44
    },
    {
        "title": "獻徐舍人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "清名喧四海，何止並南金。奧學群英伏，多才万乘欽。",
            "秩參金殿峻，步曆紫微深。顧问承中旨，絲綸演帝心。",
            "褒雄饒義路，賈馬避詞林。下直无他事，開門对遠岑。",
            "軒窗來晚吹，池沼歇秋霖。蘚點生棋石，茶煙過竹阴。",
            "希夷元已達，躁競豈能侵。羽客閑陪飲，诗人伴靜吟。",
            "自慚為滯物，多幸辱虛襟。此日重遭遇，心期出陸沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 45
    },
    {
        "title": "新秋有感",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "門巷涼秋至，高梧一葉驚。漸添衾簟爽，頓觉夢魂清。",
            "暗促蓮開豔，乍催蟬發聲。雨降炎气減，竹引冷煙生。",
            "戍客添归思，行人怯遠程。未逢征雁下，漸聽夜砧鳴。",
            "张翰思鱸興，班姬詠扇情。音塵两難问，蛩砌月空明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 46
    },
    {
        "title": "秋雨",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "竟日散如絲，吟看半掩扉。秋聲在梧葉，潤气逼书幃。",
            "曲澗泉承去，危簷燕帶归。寒蛩悲旅壁，乱蘚滑漁磯。",
            "爽欲除幽簟，涼須换熟衣。疏篷谁夢斷，荒徑独遊稀。",
            "偏稱江湖景，不妨鸥鹭飛。最怜為瑞处，南畝稻苗肥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 47
    },
    {
        "title": "寄廬山白大師",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "長憶尋師处，東林寓泊时。一秋同看月，无夜不論诗。",
            "泉美茶香異，堂深磬韵迟。鹿馴眠蘚徑，猿苦叫霜枝。",
            "別后音塵隔，年來鬢发衰。趨名方汲汲，未果再遊期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 48
    },
    {
        "title": "訪龍光智謙上人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "忽起尋師興，穿雲不觉勞。相留看山雪，盡日論风騷。",
            "竹影搖禪榻，茶煙上毳袍。夢魂曾去否，舊國阻波濤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 49
    },
    {
        "title": "送仙客",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "危言危行是男兒，倚伏相牽豈足悲。",
            "莫向汀洲时独立，悠悠斜日照江蘺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 50
    },
    {
        "title": "祀风師迎神曲",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "太皞禦气，勾芒肇功。蒼龍青旗，爰候祥风。",
            "律以和應，□以感通。鼎俎修蚃，时惟禮崇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 51
    },
    {
        "title": "柳二首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "春來无樹不青青，似共東风別有情。",
            "閑憶舊居湓水畔，数枝煙雨屬啼鶯。",
            "最愛青青水國中，莫愁門外間花紅。",
            "纖纖无力勝春色，撼起啼鶯恨晚风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 52
    },
    {
        "title": "送廬阜僧归山阳",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "山阳舊社終經夢，容易言归不可留。瓶貯瀑泉離五老，",
            "遙想枚皋宅邊寺，不知涼月共谁遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 53
    },
    {
        "title": "投所知",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "孤琴塵翳劍慵磨，自顧泥蟠欲奈何。千里交親消息斷，",
            "唯賴明公怜道在，敢攜蓑笠釣煙波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 54
    },
    {
        "title": "寄左偃",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "蕭條陋巷綠苔侵，何事君心似我心。貧戶懶開元愛靜，",
            "況是清朝重文物，无愁當路少知音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 55
    },
    {
        "title": "遊北山洞神宮",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "悶見塵中光景促，仙鄉來禮紫阳君。人居淡寂應難老，",
            "羨師向此朝星斗，一炷清香午夜焚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 56
    },
    {
        "title": "思簡寂觀舊遊寄重道者",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "閑憶當年遊物外，羽人曾许駐仙鄉。溪頭烘药煙霞暖，",
            "俗緣未斷归浮世，空望林泉意欲狂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 57
    },
    {
        "title": "雲",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "悠悠離洞壑，冉冉上天津。捧日終為異，從龍自有因。",
            "高行四海雨，暖拂万山春。靜与霞相近，閑将鶴最親。",
            "帝鄉归莫问，楚殿夢曾频。白向封中起，碧從诗裏新。",
            "冷容橫釣浦，輕縷絆蟾輪。不滯濃還淡，无心卷複伸。",
            "非煙聊擬議，幹呂在逡巡。會作五般色，為祥覆紫宸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 58
    },
    {
        "title": "徐司徒池亭",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "亭榭跨池塘，泓澄入座涼。扶疏皆竹柏，冷淡似瀟湘。",
            "萍嫩鋪波面，苔深鎖岸傍。朝回游不厭，僧到賞難忘。",
            "最稱收残雨，偏宜帶夕阳。吟堪期謝脁，醉好命嵇康。",
            "奢侈心難及，清虛趣最長。月明垂釣興，何必憶滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 59
    },
    {
        "title": "賦得江邊草",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "岸春芳草合，幾处思纏綿。向暮江蘺雨，初晴杜若煙。",
            "靜宜幽鹭立，遠稱碧波連。送別王孫处，萋萋南浦邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 60
    },
    {
        "title": "江行夜泊",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "扁舟倦行役，寂寂宿江幹。半夜风雷過，一天星斗寒。",
            "潮平沙觜沒，霜苦雁聲残。漁父何疏逸，扣舷歌未闌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 61
    },
    {
        "title": "訪山叟留題",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "策杖尋幽客，相攜入竹扃。野雲生晚砌，病鶴立秋庭。",
            "茶美睡心爽，琴清塵慮醒。輪蹄應少到，門巷草青青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 62
    },
    {
        "title": "江行晚泊寄湓城知友",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "孤舟相憶久，何处倍關情。野渡帆初落，秋风蟬一聲。",
            "江浮残照闊，雲散乱山橫。漸去湓城遠，那堪新月生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 63
    },
    {
        "title": "秋夕书懷",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "功名未立誠非晚，骨肉分飛又入秋。",
            "枕上不堪残夢斷，壁蛩窗月夜悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 64
    },
    {
        "title": "感興",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "漁休渭水興周日，龍起南阳相蜀时。",
            "不遇文王与先主，經天才业擬何為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 65
    },
    {
        "title": "舟中望九華山",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "排空蒼翠異，輟棹看崔嵬。一面雨初歇，九峰雲正開。",
            "當时思水石，便欲上樓臺。隱去心難遂，吟餘首懶回。",
            "僧休傳紫閣，屏歇写天臺。中有忘机者，逍遙不可陪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 66
    },
    {
        "title": "漁父",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "煙冷暮江濱，高歌散誕身。移舟過蓼岸，待月正絲綸。",
            "亦与樵翁約，同遊酒市春。白頭雲水上，不识独醒人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 67
    },
    {
        "title": "贈上都紫极宮劉日新先生",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "道德吾君重，含貞本去華。因知煉神骨，何必在煙霞。",
            "棋散庭花落，诗成海月斜。瀛洲舊仙侶，應许寄丹砂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 68
    },
    {
        "title": "勉同志",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "讀书与磨劍，旦夕但忘疲。儻若功名立，那愁變化迟。",
            "塵從侵硯席，苔任滿庭墀。明代搜揚切，升沈莫问龜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 69
    },
    {
        "title": "寄劉鈞秀才",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "掩戶當春晝，知君志在诗。閑花半落处，幽客未來时。",
            "野鳥穿莎徑，江雲過竹籬。會須明月夜，与子水邊期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 70
    },
    {
        "title": "離亭前思有寄",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "酒醒江亭客，纏綿恨別離。笙歌筵散后，风月夜長时。",
            "耿耿看燈暗，悠悠結夢迟。若无騷雅分，何计達相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 71
    },
    {
        "title": "贈上都先业大師",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "懶向人前著紫衣，虛堂閑倚一條藜。雖承雨露居龍闕，",
            "有时乘興尋師去，煮茗同吟到日西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 72
    },
    {
        "title": "思九江舊居三首",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "結茅曾在碧江隈，多病貧身養拙來。雨歇汀洲垂釣去，",
            "遊宦等闲千里隔，空餘魂夢到漁台。",
            "門前煙水似瀟湘，放曠優遊興味長。虛閣靜眠聽遠浪，",
            "犬吠疏籬明月上，鄰翁攜酒到茅堂。",
            "无机終日狎沙鸥，得意高吟景且幽。檻底江流偏稱月，",
            "別后再遊心未遂，設屏惟画白蘋洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 73
    },
    {
        "title": "贈東林白大師",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "虎溪久駐靈蹤，禪外诗魔尚濃。卷宿吟銷永日，",
            "自说年來老病，出門漸觉疏慵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 74
    },
    {
        "title": "春曉",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "残燭犹存月尚明，幾家幃幌夢魂驚。",
            "星河漸沒行人動，歷歷林梢百舌聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 75
    },
    {
        "title": "聽鄭羽人彈琴",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "仙鄉景已清，仙子啟琴聲。秋月空山寂，淳风一夜生。",
            "莎間蟲罷響，松頂鶴初驚。因感浮華世，谁怜太古情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 76
    },
    {
        "title": "秋夕书事寄友人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "信斷關河遠，相思秋夜深。砌蛩聲咽咽，簷月影沉沉。",
            "未遂青雲志，那堪素發侵。吟餘成不寐，徹曙四鄰砧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 77
    },
    {
        "title": "秋日途中",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "竹林已蕭索，客思正如讎。舊业吳江外，新蟬楚驛頭。",
            "遙天疏雨過，列岫乱雲收。今夕谁家宿，孤吟月色秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 78
    },
    {
        "title": "秋夜吟寄左偃",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "与君诗興素來狂，況入清秋夜景長。溪閣共谁看好月，",
            "會約垂名繼前哲，任他玄發盡如霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 79
    },
    {
        "title": "竹",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "森森移得自山莊，植向空庭野興長。便有好风來枕簟，",
            "閑約羽人同賞处，安排棋局就清涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 80
    },
    {
        "title": "懷廬岳舊游寄劉鈞因感鑒上人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "昔年廬嶽闲遊日，乘興因尋物外僧。寄宿愛聽松葉雨，",
            "一念支公安可見，影堂何处暮雲凝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 81
    },
    {
        "title": "依韵酬智謙上人見寄",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "性拙才非逸，同心友亦稀。风昏秋病眼，霜濕夜吟衣。",
            "鶯谷期犹負，蘭陔養不違。吾師惠佳句，勝得楚金归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 82
    },
    {
        "title": "落花",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "年年三月暮，无计惜残紅。酷恨西園雨，生憎南陌风。",
            "片隨流水遠，色逐斷霞空。悵望叢林下，悠悠飲興窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 83
    },
    {
        "title": "題柳",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "折向離亭畔，春光滿手生。群花豈无豔，柔質自多情。",
            "夾岸籠溪月，兼风撼野鶯。隋堤三月暮，飛絮想縱橫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 84
    },
    {
        "title": "贈謙明上人",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "雖寄上都眠竹寺，逸情終憶白雲端。閑登鐘阜林泉晚，",
            "常闻秋夕多无寐，月在高臺独凭欄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 85
    },
    {
        "title": "书蔡隱士壁",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "病后霜髭出，衡門寂寞中。蠹侵书帙損，塵覆酒樽空。",
            "池暗菰蒲雨，徑香蘭蕙风。幽闲已得趣，不見蔔窮通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 86
    },
    {
        "title": "贈鐘尊師游茅山",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "筇杖擔琴背俗塵，路尋茅嶺有谁群。仙翁物外應相遇，",
            "伊予亦有朝修志，異日遨遊愿見君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 87
    },
    {
        "title": "訪徐長史留題水閣",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "君家池閣靜，一到且淹留。坐聽蒹葭雨，如看島嶼秋。",
            "杯盤深有興，吟笑迥忘憂。更愛幽奇处，雙雙下野鸥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 88
    },
    {
        "title": "夕阳",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "影未沈山水面紅，遙天雨過促征鴻。",
            "魂銷舉子不回首，閑照槐花驛路中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 89
    },
    {
        "title": "鸂鶒",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "流品是鴛鴦，翻飛雲水鄉。风高離极浦，煙暝下方塘。",
            "比鹭行藏別，穿荷羽翼香。雙雙浴輕浪，谁見在瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 90
    },
    {
        "title": "所思",
        "author": "李中",
        "biography": "",
        "paragraphs": [
            "離思春來切，谁能慰寂寥。花飛寒食過，雲重楚山遙。",
            "耿耿夢徒往，悠悠鬢易凋。那堪对明月，独立水邊橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十七",
        "no#": 91
    }
]