[
    {
        "title": "江上燕別",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雲物如故鄉，山川異岐路。年來未归客，馬上春欲暮。",
            "一樽花下酒，残日水西樹。不待管弦終，搖鞭背花去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 1
    },
    {
        "title": "卜居招书侶",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "憶昨未知道，臨川每羨魚。世途行處見，人事病來疏。",
            "微雨秋栽竹，孤燈夜讀书。怜君亦同志，晚歲傍山居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 2
    },
    {
        "title": "西山草堂",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "何處少人事，西山舊草堂。曬书秋日晚，洗药石泉香。",
            "浚嶺有朝雨，北窗生夜涼。從勞问归路，峰疊繞家鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 3
    },
    {
        "title": "贈隱者",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "回報隱居士，莫愁山興闌。求人顏色盡，知道性情寬。",
            "信譜彈琴誤，緣崖劚药難。東皋亦自給，殊愧遠相安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 4
    },
    {
        "title": "舟次武陵寄天竺僧无晝",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "溪長山幾重，十裏万株松。秋日下丹檻，暮雲归碧峰。",
            "樹棲新放鶴，潭隱舊降龍。還在孤舟宿，臥闻初夜鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 5
    },
    {
        "title": "寄小弟",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "江城紅葉盡，旅思複淒傷。孤夢家山遠，独眠秋夜長。",
            "道存空倚命，身賤未归鄉。南望空垂淚，天邊雁一行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 6
    },
    {
        "title": "秋日",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "有计自安业，秋风罷苦吟。買山兼種竹，對客更彈琴。",
            "煙起药園晚，杵聲松院深。閑眠得真性，惆悵舊时心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 7
    },
    {
        "title": "石池",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "通竹引泉脈，泓澄瀲石盆。驚魚翻藻葉，浴鳥上松根。",
            "残月留山影，高风耗水痕。谁家秋洗药，來往自開門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 8
    },
    {
        "title": "留題李侍禦书齋",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "昔話平生志，高齋曾見留。道孤心易感，恩重力難酬。",
            "独立千峰曉，频來一葉秋。雞鳴應有處，不覺淚空流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 9
    },
    {
        "title": "行次白沙館，先寄上河南王侍禦",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "夜程何處宿，山疊樹層層。孤館閉秋雨，空堂停曙燈。",
            "歌慚漁浦客，诗學雁門僧。此意无人识，明朝見李膺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 10
    },
    {
        "title": "紫藤",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "綠蘿縈數匝，本在草堂間。秋色寄高樹，晝阴籠遠山。",
            "移花疏處種，劚药困时攀。日暮微风起，難尋舊徑還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 11
    },
    {
        "title": "暝投靈智寺渡溪不得，卻取沿江路往",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雙岩瀉一川，回馬斷橋前。古廟阴风地，寒鐘暮雨天。",
            "沙虛留虎跡，水滑帶龍涎。卻下臨江路，潮深无渡船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 12
    },
    {
        "title": "下第归蒲城墅居",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "失意归三徑，傷春別九門。薄煙楊柳路，微雨杏花村。",
            "牧豎還呼犢，鄰翁亦抱孫。不知餘正苦，迎馬问寒溫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 13
    },
    {
        "title": "重賦鹭鷥",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "何年去此地，南浦滿鳧雛。雲漢知心遠，林塘覺思孤。",
            "低飛下晚樹，独睡映新蒲。為爾多归興，前年在五湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 14
    },
    {
        "title": "途中寒食",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "處處哭聲悲，行人馬亦迟。店閑无火日，村暖斫桑时。",
            "泣路同楊子，燒山憶介推。清明明日是，甘負故園期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 15
    },
    {
        "title": "深春",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "故里千帆外，深春一雁飛。幹名频慟哭，将老欲何归。",
            "未谷拋還憶，交親晚更稀。空持望鄉淚，沾灑寄來衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 16
    },
    {
        "title": "歲首懷甘露寺自省上人",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "心悟覺身勞，雲中棄寶刀。久閑生髀肉，多壽長眉毫。",
            "客棹春潮急，禪齋暮雪高。南da一回首，山碧水滔滔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 17
    },
    {
        "title": "尋周煉師不遇留贈",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "閉門池館靜，雲訪紫芝翁。零落槿花雨，參差荷葉风。",
            "夜棋全局在，春酒半壺空。長嘯倚西閣，悠悠名利中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 18
    },
    {
        "title": "題灞西駱隱居",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "志淩三蜀客，心愛五湖人。co死酒中老，謀生书外貧。",
            "掃花眠石榻，搗药轉溪輪。往往乘黃牸，鹿裘烏角巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 19
    },
    {
        "title": "旅夜懷遠客",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "異鄉多遠情，夢斷落江城。病起慚书癖，貧家負酒名。",
            "過春花自落，竟曉月空明。独此一長嘯，故人天際行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 20
    },
    {
        "title": "秋夜棹舟訪李隱君",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "望月憶披襟，長溪柳半阴。高齋初釀酒，孤棹遠攜琴。",
            "犬吠秋山迥，雞鳴曉樹深。開門更欹枕，谁识野人心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 21
    },
    {
        "title": "臥病寄諸公",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "飛蓋集蘭堂，清歌遞柏觴。高城榆柳蔭，虛閣芰荷香。",
            "海月秋偏靜，山风夜更涼。自怜书万卷，扶病對螢光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 22
    },
    {
        "title": "寓崇聖寺懷李校书",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "幾日臥南亭，捲簾秋月清。河關初罷夢，池閣更含情。",
            "寒露潤金井，高风飄玉箏。前年共遊客，刀筆事戎旌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 23
    },
    {
        "title": "秋日行次關西",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "金风蕩天地，關西群木凋。早霜雞喔喔，残月馬蕭蕭。",
            "紫陌秦山近，青楓楚樹遙。還同長卿志，題字滿河橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 24
    },
    {
        "title": "山居冬夜喜魏扶見訪因贈",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "霜风露葉下，遠思独裴回。夜久草堂靜，月明山客來。",
            "遣貧相勸酒，憶字共书灰。何事清平世，幹名待有媒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 25
    },
    {
        "title": "喜李詡秀才見訪因贈",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "浙南分首日，谁謂別經时。路遠遙相訪，家貧喜見知。",
            "不須辭不酌，更請续新诗。但得心中劍，酬恩會有期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 26
    },
    {
        "title": "晚投慈恩寺呈俊上人",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雙岩瀉一川，十裏絕人煙。古廟阴风地，寒鐘暮雨天。",
            "沙虛留虎跡，水滑帶龍涎。不及曹溪侶，空林已夜禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 27
    },
    {
        "title": "行次虎頭岩酬寄路中丞",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "樟亭去已遠，來上虎頭岩。灘急水移棹，山回风滿帆。",
            "石梯迎雨滑，沙井落潮鹹。何以慰行旅，如公书一緘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 28
    },
    {
        "title": "送荔浦蔣明府赴任",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "路長春欲盡，歌怨酒初酣。白社蓮宮北，青袍桂水南。",
            "驛行盤鳥道，船宿避龍潭。真得诗人趣，煙霞處處諳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 29
    },
    {
        "title": "懷政禪師院",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "山齋路幾層，敗衲學真乘。寒暑移雙樹，光阴盡一燈。",
            "风飄高竹雪，泉漲小池冰。莫訝频來此，修身欲到僧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 30
    },
    {
        "title": "秋夕有懷",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "念遠坐西閣，華池涵月涼。书回秋欲盡，酒醒夜初長。",
            "露白蓮衣淺，风清蕙帶香。前年此佳景，蘭棹醉橫塘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 31
    },
    {
        "title": "秋霽寄遠",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "初霽独登賞，西樓多遠风。橫煙秋水上，疏雨夕阳中。",
            "高樹下山鳥，平蕪飛草蟲。唯應待明月，千里与君同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 32
    },
    {
        "title": "闻范秀才自蜀游江湖",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "蜀道下湘渚，客帆應不迷。江分三峽響，山並九華齊。",
            "秋泊雁初宿，夜吟猿乍啼。归时慎行李，莫到石城西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 33
    },
    {
        "title": "惜春",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "花開又花落，时節暗中遷。无计延春日，可能留少年。",
            "小叢初散蝶，高柳即闻蟬。繁豔归何處，滿山啼杜鵑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 34
    },
    {
        "title": "題愁",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "聚散竟无形，回腸百結成。古今銷不得，離別覺潛生。",
            "降虜将军思，窮秋遠客情。何人更憔悴，落第泣秦京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 35
    },
    {
        "title": "鴛鴦",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "两两戲沙汀，長疑画不成。錦机爭織樣，歌曲愛呼名。",
            "好□顧棲息，堪怜泛淺清。鳧鸥皆爾類，唯羨独含情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 36
    },
    {
        "title": "闻雁",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "帶霜南去雁，夜好宿汀沙。驚起向何處，高飛極海涯。",
            "入雲聲漸遠，離岳路犹賒。归夢當时斷，參差欲到家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 37
    },
    {
        "title": "不寢",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "到曉不成夢，思量堪白頭。多无百年命，長有万般愁。",
            "世事應難盡，營生卒未休。莫言名与利，名利是身仇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 38
    },
    {
        "title": "宿東橫山",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "孤舟路漸賒，时見碧桃花。溪雨灘聲急，岩风樹勢斜。",
            "獼猴垂弱蔓，鸛鶴睡橫槎。謾向仙林宿，无人识阮家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 39
    },
    {
        "title": "早行",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "失枕驚先起，人家半夢中。闻雞凭早晏，占鬥認西東。",
            "轡濕知行露，衣單覺曉风。秋阳弄光影，忽吐半林紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 40
    },
    {
        "title": "陪鄭史君泛舟晚归",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "南郭望归處，郡樓高捲簾。平橋低皂蓋，曲岸轉彤襜。",
            "江晚笙歌促，山晴鼓角嚴。羊公莫先醉，清曉月纖纖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 41
    },
    {
        "title": "酬殷堯藩",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "相如愧许詢，寥落向溪濱。竹馬兒犹小，荊釵婦慣貧。",
            "独愁憂過日，多病不如人。莫怪青袍選，長安隱舊春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 42
    },
    {
        "title": "贈遷客",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "无机還得罪，直道不傷情。微雨昏山色，疏籠閉鶴聲。",
            "闲居多野客，高枕見江城。門外長溪水，怜君又濯纓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 43
    },
    {
        "title": "征西舊卒",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "少年乘勇氣，百戰過烏孫。力盡邊城難，功加上将恩。",
            "曉风聽戍角，残月倚營門。自说輕生處，金瘡有舊痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十二",
        "no#": 44
