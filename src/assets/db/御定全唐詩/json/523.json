[
    {
        "title": "懷鐘陵舊遊四首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "一謁征南最少年，虞卿雙璧截肪鮮。歌謠千里春長暖，",
            "陸公餘德机雲在，如我酬恩合執鞭。",
            "滕閣中春綺席開，柘枝蠻鼓殷晴雷。垂樓万幕青雲合，",
            "連巴控越知何事，珠翠沉檀处处堆。",
            "十頃平湖堤柳合，岸秋蘭芷綠纖纖。一聲明月採蓮女，",
            "斜輝更落西山影，千步虹橋气象兼。",
            "控壓平江十万家，秋來江靜鏡新磨。城頭晚鼓雷霆后，",
            "昔年行樂穠桃畔，醉与龍沙揀蜀羅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 1
    },
    {
        "title": "台城曲二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "整整複斜斜，隨旗簇晚沙。門外韓擒虎，樓頭张麗華。",
            "谁怜容足地，卻羨井中蛙。",
            "王頒兵勢急，鼓下坐蠻奴。瀲灩倪塘水，叉牙出骨須。",
            "幹蘆一炬火，回首是平蕪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 2
    },
    {
        "title": "江上雨寄崔碣",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "春半平江雨，圓文破蜀羅。聲眠篷底客，寒濕釣來蓑。",
            "暗澹遮山遠，空蒙著柳多。此时懷舊恨，相望意如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 3
    },
    {
        "title": "罷鐘陵幕吏十三年，來泊湓浦，感舊為诗",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "青梅雨中熟，檣倚酒旗邊。故國残春夢，孤舟一褐眠。",
            "搖搖遠堤柳，暗暗十程煙。南奏鐘陵道，无因似昔年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 4
    },
    {
        "title": "商山麻澗",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雲光嵐彩四面合，柔柔垂柳十餘家。雉飛鹿過芳草遠，",
            "征車自念塵土计，惆悵溪邊书細沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 5
    },
    {
        "title": "商山富水驛",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "益戇由來未觉賢，終須南去吊湘川。當时物議朱雲小，",
            "驛名不合輕移改，留警朝天者惕然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 6
    },
    {
        "title": "丹水",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "何事苦縈回，離腸不自裁。恨身隨夢去，春態逐雲來。",
            "沈定藍光徹，喧盤粉浪開。翠岩三百尺，谁作子陵台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 7
    },
    {
        "title": "題武關",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "碧溪留我武關東，一笑懷王跡自窮。鄭袖嬌嬈酣似醉，",
            "今日圣神家四海，戍旗長卷夕阳中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 8
    },
    {
        "title": "除官赴闕商山道中絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "水疊鳴珂樹如帳，長楊春殿九門珂。",
            "我來惆悵不自決，欲去欲住終如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 9
    },
    {
        "title": "漢江",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "溶溶漾漾白鸥飛，綠淨春深好染衣。",
            "南去北來人自老，夕阳長送釣船归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 10
    },
    {
        "title": "襄阳雪夜感懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "往事起独念，飄然自不勝。前灘急夜響，密雪映寒燈。",
            "的的三年夢，迢迢一線縆。明朝楚山上，莫上最高層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 11
    },
    {
        "title": "詠歌圣德，遠懷天寶，因題關亭長句四韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "圣敬文思业太平，海寰天下唱歌行。秋來气勢洪河壯，",
            "君王若悟治安論，安史何人敢弄兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 12
    },
    {
        "title": "途中作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "綠樹南阳道，千峰勢遠隨。碧溪风澹態，芳樹雨餘姿。",
            "野渡雲初暖，征人袖半垂。残花不足醉，行樂是何时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 13
    },
    {
        "title": "重到襄阳，哭亡友韋壽朋",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "故人墳樹立秋风，伯道无兒跡更空。",
            "重到笙歌分散地，隔江吹笛月明中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 14
    },
    {
        "title": "赤壁",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "折戟沈沙鐵未銷，自将磨洗認前朝。",
            "東风不与周郎便，銅雀春深鎖二喬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 15
    },
    {
        "title": "雲夢澤",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "日旗龍旆想飄揚，一索功高縛楚王。",
            "直是超然五湖客，未如終始郭汾阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 16
    },
    {
        "title": "除官行至昭應，闻友人出官因寄",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "賤子來千里，明公去一麾。可能休涕淚，豈独感恩知。",
            "草木窮秋后，山川落照时。如何望故國，驅馬卻迟迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 17
    },
    {
        "title": "寄浙東韓八評事",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "一笑五雲溪上舟，跳丸日月十經秋。鬢衰酒減欲谁泥，",
            "无窮塵土无聊事，不得清言解不休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 18
    },
    {
        "title": "泊秦淮",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "煙籠寒水月籠沙，夜泊秦淮近酒家。",
            "商女不知亡國恨，隔江犹唱后庭花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 19
    },
    {
        "title": "秋浦途中",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "蕭蕭山路窮秋雨，淅淅溪风一岸蒲。",
            "為问寒沙新到雁，來时還下杜陵无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 20
    },
    {
        "title": "題桃花夫人廟",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "細腰宮裏露桃新，脈脈无言度幾春。",
            "至竟息亡緣底事，可怜金谷墜樓人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 21
    },
    {
        "title": "初春有感，寄歙州邢員外",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雪漲前溪水，啼聲已繞灘。梅衰未減態，春嫩不禁寒。",
            "跡去夢一觉，年來事百般。闻君亦多感，何处倚闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 22
    },
    {
        "title": "书懷寄中朝往還",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "平生自许少塵埃，為吏塵中勢自回。朱紱久慚官借与，",
            "霄漢幾多同學伴，可怜頭角盡卿材。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 23
    },
    {
        "title": "寄崔鈞",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "緘书報子玉，為我謝平津。自愧掃門士，谁為乞火人。",
            "詞臣陪羽獵，戰将騁騏驎。两地差池恨，江汀醉送君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 24
    },
    {
        "title": "初春雨中舟次和州橫江裴使君見迎李趙二秀才同來因书四韵兼寄江南许渾先輩",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "芳草渡頭微雨时，万株楊柳拂波垂。蒲根水暖雁初浴，",
            "江南仲蔚多情調，悵望春阴幾首诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 25
    },
    {
        "title": "和州絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "江湖醉渡十年春，牛渚山邊六问津。",
            "曆阳前事知何實，高位紛紛見陷人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 26
    },
    {
        "title": "題烏江亭",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "勝敗兵家事不期，包羞忍恥是男兒。",
            "江東子弟多才俊，捲土重來未可知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 27
    },
    {
        "title": "題橫江館",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "孫家兄弟晉龍驤，馳騁功名业帝王。",
            "至竟江山谁是主，苔磯空屬釣魚郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 28
    },
    {
        "title": "寄澧州张舍人笛",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "發勻肉好生春嶺，截玉鑽星寄使君。檀的染时痕半月，",
            "遙想紫泥封詔罷，夜深應隔禁牆闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 29
    },
    {
        "title": "寄揚州韓綽判官",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "青山隱隱水迢迢，秋盡江南草木凋。",
            "二十四橋明月夜，玉人何处教吹簫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 30
    },
    {
        "title": "送李群玉赴舉",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "故人別來面如雪，一榻拂雲秋影中。",
            "玉白花紅三百首，五陵谁唱与春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 31
    },
    {
        "title": "送薛種游湖南",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "賈傅松醪酒，秋來美更香。怜君片雲思，一去繞瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 32
    },
    {
        "title": "題壽安縣甘棠館禦溝",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "一渠東注芳華苑，苑鎖池塘百歲空。",
            "水殿半傾蟾口澀，為谁流下蓼花中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 33
    },
    {
        "title": "汴河懷古",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "錦纜龍舟隋煬帝，平臺複道漢梁王。",
            "遊人閑起前朝念，折柳孤吟斷殺腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 34
    },
    {
        "title": "汴河阻凍",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "千里長河初凍时，玉珂瑤佩響參差。",
            "浮生卻似冰底水，日夜東流人不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 35
    },
    {
        "title": "酬张祜处士見寄長句四韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "七子論诗谁似公，曹劉須在指揮中。薦衡昔日知文舉，",
            "可怜故國三千里，虛唱歌詞滿六宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 36
    },
    {
        "title": "寄宣州鄭諫議",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "大夫官重醉江東，瀟灑名儒振古风。文石陛前辭圣主。",
            "碧雲天外作冥鴻。五言甯謝顏光祿，百歲須齊衛武公。",
            "再拜宜同丈人行，過庭交分有无同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 37
    },
    {
        "title": "題元处士高亭",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "水接西江天外聲，小齋松影拂雲平。",
            "何人教我吹長笛，与倚春风弄月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 38
    },
    {
        "title": "鄭瓘協律",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "廣文遺韵留樗散，雞犬图书共一船。",
            "自说江湖不归事，阻风中酒過年年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 39
    },
    {
        "title": "和野人殷潛之題籌筆驛十四韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "三吳裂婺女，九錫獄孤兒。霸主业未半，本朝心是谁。",
            "永安宮受詔，籌筆驛沉思。画地乾坤在，濡毫勝負知。",
            "艱難同草創，得失计毫釐。寂默經千慮，分明渾一期。",
            "川流縈智思，山聳助扶持。慷慨匡时略，從容问罪師。",
            "褒中秋鼓角，渭曲晚旌旗。仗義懸无敵，鳴攻故有辭。",
            "若非天奪去，豈複慮能支。子夜星才落，鴻毛鼎便移。",
            "郵亭世自换，白日事長垂。何处躬耕者，犹題殄瘁诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 40
    },
    {
        "title": "重題絕句一首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "郵亭寄人世，人世寄郵亭。何如自籌度，鴻路有冥冥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 41
    },
    {
        "title": "送陸洿郎中棄官東归",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "少微星動照春雲，魏闕衡門路自分。",
            "倏去忽來應有意，世間塵土謾疑君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 42
    },
    {
        "title": "寄瑉笛与宇文舍人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "調高銀字聲還側，物比柯亭韵校奇。",
            "寄与玉人天上去，桓将军見不教吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 43
    },
    {
        "title": "寄內兄和州崔員外十二韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "曆阳崔太守，何日不含情。恩義同鐘李，塤篪實弟兄。",
            "光塵能混合，擘画最分明。台閣仁賢譽，閨門孝友聲。",
            "西方像教毀，南海繡衣行。金橐寧回顧，珠簟肯一棖。",
            "只宜裁密詔，何自取專城。進退无非道，徊翔必有名。",
            "好风初婉軟，離思苦縈盈。金馬舊遊貴，桐廬春水生。",
            "雨侵寒牖夢，梅引凍醪傾。共祝中興主，高歌唱太平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 44
    },
    {
        "title": "遣興",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "鏡弄白髭須，如何作老夫。浮生長勿勿，兒小且嗚嗚。",
            "忍過事堪喜，泰來憂勝无。治平心徑熟，不遣有窮途。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 45
    },
    {
        "title": "早秋",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "疏雨洗空曠，秋標驚意新。大熱去酷吏，清风來故人。",
            "尊酒酌未酌，晚花嚬不嚬。銖秤与縷雪，谁觉老陳陳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 46
    },
    {
        "title": "秋思",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "熱去解鉗釱，飄蕭秋半时。微雨池塘見，好风襟袖知。",
            "發短梳未足，枕涼閑且欹。平生分過此，何事不參差。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 47
    },
    {
        "title": "途中一絕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "鏡中絲發悲來慣，衣上塵痕拂漸難。",
            "惆悵江湖釣竿手，卻遮西日向長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 48
    },
    {
        "title": "春盡途中",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "田園不事來遊宦，故國谁教爾別離。",
            "独倚關亭還把酒，一年春盡送春诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 49
    },
    {
        "title": "題村舍",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "三樹稚桑春未到，扶床乳女午啼饑。",
            "潛銷暗鑠归何处，万指侯家自不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 50
    },
    {
        "title": "代人寄遠六言二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "河橋酒旆风軟，候館梅花雪嬌。",
            "宛陵樓上瞪目，我郎何处情饒。",
            "繡領任垂蓬髻，丁香閑結春梢。",
            "剩肯新年归否，江南綠草迢迢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 51
    },
    {
        "title": "閨情",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "娟娟卻月眉，新鬢學鴉飛。暗砌勻檀粉，晴窗画夾衣。",
            "袖紅垂寂寞，眉黛斂衣稀。還向長陵去，今宵归不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 52
    },
    {
        "title": "舊游",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "閑吟芍药诗，惆望久嚬眉。盼眄回眸遠，纖衫整髻迟。",
            "重尋春晝夢，笑把淺花枝。小市長陵住，非郎谁得知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 53
    },
    {
        "title": "寄遠",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "只影隨驚雁，單棲鎖画籠。向春羅袖薄，谁念舞臺风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 54
    },
    {
        "title": "簾",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "徒雲逢剪削，豈謂見偏裝。鳳節輕雕日，鸞花薄飾香。",
            "问屏何屈曲，怜帳解周防。下漬金階露，斜分碧瓦霜。",
            "沉沉伴春夢，寂寂侍華堂。谁見昭阳殿，真珠十二行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 55
    },
    {
        "title": "寄題甘露寺北軒",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "曾向蓬萊宮裏行，北軒闌檻最留情。孤高堪弄桓伊笛，",
            "他年會著荷衣去，不向山僧说姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 56
    },
    {
        "title": "題青雲館",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "虯蟠千仞劇羊腸，天府由來百二強。四皓有芝輕漢祖，",
            "深处會容高尚者，水苗三頃百株桑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 57
    },
    {
        "title": "正初奉酬歙州刺史邢群",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "翠岩千尺倚溪斜，曾得嚴光作釣家。越嶂遠分丁字水，",
            "一壑风煙阳羨裏，解龜休去路非賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 58
    },
    {
        "title": "江上偶見絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "楚江寒食橘花时，野渡臨风駐彩旗。",
            "草色連雲人去住，水紋如縠燕差池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 59
    },
    {
        "title": "題木蘭廟",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "彎弓征戰作男兒，夢裏曾經与画眉。",
            "幾度思归還把酒，拂雲堆上祝明妃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 60
    },
    {
        "title": "入商山",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "早入商山百里雲，藍溪橋下水聲分。",
            "流水舊聲人舊耳，此回嗚咽不堪闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 61
    },
    {
        "title": "偶題",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "甘羅昔作秦丞相，子政曾為漢輦郎。",
            "千载更逢王侍讀，當时還道有文章。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 62
    },
    {
        "title": "送盧秀才一絕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "春瀨与煙遠，送君孤棹開。潺湲如不改，愁更釣魚來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 63
    },
    {
        "title": "醉題",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "金鑷洗霜鬢，銀觥敵露桃。醉頭扶不起，三丈日還高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 64
    },
    {
        "title": "題商山四皓廟一絕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "呂氏強梁嗣子柔，我於天性豈恩讎。",
            "南军不袒左邊袖，四老安劉是滅劉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 65
    },
    {
        "title": "送隱者一絕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "无媒徑路草蕭蕭，自古雲林遠市朝。",
            "公道世間唯白发，貴人頭上不曾饒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 66
    },
    {
        "title": "題张处士山莊一絕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "好鳥疑敲磬，风蟬認軋箏。修篁与嘉樹，偏倚半岩生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 67
    },
    {
        "title": "有懷重送斛斯判官",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "蒼蒼煙月滿川亭，我有勞歌一為聽。",
            "将取離魂隨白騎，三台星裏拜文星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 68
    },
    {
        "title": "贈別二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "娉娉褭褭十三餘，豆蔻梢頭二月初。",
            "春风十裏揚州路，卷上珠簾總不如。",
            "多情卻似總无情，唯觉尊前笑不成。",
            "蠟燭有心還惜別，替人垂淚到天明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 69
    },
    {
        "title": "寄遠",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "前山极遠碧雲合，清夜一聲白雪微。",
            "欲寄相思千里月，溪邊残照雨霏霏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 70
    },
    {
        "title": "少年行",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "官為駿馬監，職帥羽林兒。两綬藏不見，落花何处期。",
            "獵敲白玉鐙，怒袖紫金錘。田竇長留醉，蘇辛曲讓岐。",
            "豪持出塞節，笑別遠山眉。捷報雲台賀，公卿拜夀卮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 71
    },
    {
        "title": "盆池",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "鑿破蒼苔地，偷他一片天。白雲生鏡裏，明月落階前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 72
    },
    {
        "title": "有寄",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雲闊煙深樹，江澄水浴秋。美人何处在，明月万山頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十三",
        "no#": 73
    }
]