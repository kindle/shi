[
    {
        "title": "塞上",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "万里隋城在，三邊虜氣衰。沙填孤障角，燒斷故關碑。",
            "馬色經寒慘，雕聲帶晚悲。将军正闲暇，留客换歌辭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 1
    },
    {
        "title": "寄永嘉崔道融",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "旅寓雖難定，乘閑是勝遊。碧雲蕭寺霽，紅樹謝村秋。",
            "戍鼓和潮暗，船燈照島幽。诗家多滯此，风景似相留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 2
    },
    {
        "title": "下方",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "三十年來往，中間京洛塵。倦行今白首，归臥已清神。",
            "坡暖冬抽筍，松涼夏健人。更慚征詔起，避世跡非真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 3
    },
    {
        "title": "華下",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "日炙旱雲裂，迸為千道血。天地沸一鑊，竟自烹妖孽。",
            "堯湯遇災數，災數還中輟。何事奸与邪，古來難撲滅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 4
    },
    {
        "title": "僧舍貽友",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "笑破人間事，吾徒莫自欺。解吟僧亦俗，愛舞鶴終卑。",
            "竹上題幽夢，溪邊約敵棋。舊山归有阻，不是故迟迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 5
    },
    {
        "title": "下方",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "昏旦松軒下，怡然對一瓢。雨微吟思足，花落夢无聊。",
            "細事當棋遣，衰容喜鏡饒。溪僧有深趣，书至又相邀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 6
    },
    {
        "title": "華下送文浦",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "郊居謝名利，何事最相親。漸与論诗久，皆知得句新。",
            "川明虹照雨，樹密鳥沖人。應念從今去，還來嶽下频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 7
    },
    {
        "title": "自誡",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "我祖銘座右，嘉謀貽厥孫。勤此苟不怠，令名日可存。",
            "媒衒士所恥，慈儉道所尊。松柏豈不茂，桃李亦自繁。",
            "眾人皆察察，而我独昏昏。取訓於老氏，大辯欲訥言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 8
    },
    {
        "title": "效陳拾遺子昂感遇二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "高燕飛何捷，啄害恣群雛。人豈玩其暴，華軒容爾居。",
            "強欺自天稟，剛吐信吾徒。乃知不平者，矯世道終孤。",
            "阳和含煦潤，卉木競紛華。當為眾所悅，私已汝何誇。",
            "北裏秘穠豔，東園鎖名花。豪奪乃常理，笑君徒咄嗟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 9
    },
    {
        "title": "效陳拾遺子昂",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "醜婦競簪花，花多映愈醜。鄰女恃其姿，掇之不盈手。",
            "量已苟自私，招損乃谁咎。寵祿既非安，于吾竟何有。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 10
    },
    {
        "title": "感时",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "好鳥无惡聲，仁獸肯狂噬。寧教鸚鵡啞，不遣麒麟細。",
            "人人语与默，唯觀利与勢。愛毀亦自遭，掩謗終失计。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 11
    },
    {
        "title": "秋思",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "身病时亦危，逢秋多慟哭。风波一搖盪，天地幾翻覆。",
            "孤螢出荒池，落葉穿破屋。勢利長草草，何人訪幽独。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 12
    },
    {
        "title": "早春",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "傷懷同客處，病眼卻花朝。草嫩侵沙短，冰輕著雨消。",
            "风光知可愛，容發不相饒。早晚丹丘去，飛书肯見招。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 13
    },
    {
        "title": "上陌梯寺懷舊僧二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "雲根禪客居，皆说舊无廬。松日明金像，山风向木魚。",
            "依棲應不阻，名利本來疏。縱有人相问，林間懶拆书。",
            "高鴉隔谷見，路轉寺西門。塔影蔭泉脈，山苗侵燒痕。",
            "鐘疏含杳靄，合迥亙黃昏。更待他僧到，長如前信存。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 14
    },
    {
        "title": "寄懷元秀上人",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "悠悠幹祿利，草草廢漁樵。身世堪惆悵，风騷頓寂寥。",
            "高秋期步野，積雨放趨朝。得句如相憶，莎齋且見招。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 15
    },
    {
        "title": "次韵和秀上人游南五台",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "中峰曾到處，題記沒蒼苔。振錫傳深谷，翻經想舊台。",
            "危松臨砌偃，驚鹿驀溪來。內殿禦诗切，身回心未回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 16
    },
    {
        "title": "贈圓昉公",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "天階讓紫衣，冷格鶴犹卑。道勝嫌名出，身閑覺老迟。",
            "曉香延宿火，寒磬度高枝。每说長松寺，他年与我期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 17
    },
    {
        "title": "贈信美寺岑上人",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "巡禮諸方遍，湘南频有緣。焚香老山寺，乞食向江船。",
            "紗碧籠名画，燈寒照淨禪。我來能永日，蓮漏滴寒泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 18
    },
    {
        "title": "江行二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "地闊分吳塞，楓高映楚天。曲塘春盡雨，方響夜深船。",
            "行紀添新夢，羈愁甚往年。何时京洛路，馬上見人煙。",
            "初程风信好，回望失津樓。日帶潮聲晚，煙含楚色秋。",
            "戍旗當遠客，島樹轉驚鸥。此去非名利，孤帆任白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 19
    },
    {
        "title": "長安贈王注",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "正下搜賢詔，多君独避名。客來當意愜，花發遇歌成。",
            "樂地留高趣，權門讓後生。東方禦閑駟，園外好同行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 20
    },
    {
        "title": "贈步寄李員外",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "危橋轉溪路，經雨石叢荒。幽瀑下仙果，孤巢懸夕阳。",
            "病辭青瑣秘，心在紫芝房。更喜諧招隱，诗家有望郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 21
    },
    {
        "title": "寄鄭仁規",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "清才鄭小戎，標的貴遊中。万里雲无侶，三山鶴不籠。",
            "香和丹地暖，晚著彩衣风。榮路期經濟，唯應在至公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 22
    },
    {
        "title": "寄考功王員外",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "喜闻三字耗，閑客是陪遊。白鳥閑疏索，青山日滯留。",
            "琴如高韵稱，诗愧逸才酬。更勉匡君志，論思在獻謀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 23
    },
    {
        "title": "雜言",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "烏飛飛，兔蹶蹶，朝來暮去驅时節。女媧只解補青天，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 24
    },
    {
        "title": "陳疾",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "自怜旅舍亦酣歌，世路无机奈爾何。霄漢逼來心不動，",
            "閑得此身归未得，磬聲深夏隔煙蘿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 25
    },
    {
        "title": "淅上",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "華下支離已隔河，又來此地避干戈。山田漸廣猿时到，",
            "兒童栗熟迷归路，归得仍隨牧豎歌。",
            "西北鄉關近帝京，煙塵一片正傷情。愁看地色連空色，",
            "從他煙棹更南去，休向津頭问去程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 26
    },
    {
        "title": "山中",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "全家与我戀孤岑，蹋得蒼苔一徑深。逃難人多分隙地，",
            "昨夜前溪驟雷雨，晚晴闲步數峰吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 27
    },
    {
        "title": "寄贈诗僧秀公",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "靈一心傳清塞心，可公吟後礎公吟。近來雅道相親少，",
            "冷曹孤宦甘寥落，多謝攜筇數訪尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 28
    },
    {
        "title": "重阳日訪元秀上人",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "紅葉黃花秋景寬，醉吟朝夕在樊川。卻嫌今日登山俗，",
            "归來童稚爭相笑，何事无人与酒船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 29
    },
    {
        "title": "丁未歲归王官谷",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "家山牢落戰塵西，匹馬偷归路已迷。塚上卷旗人簇立，",
            "将取一壺閑日月，長歌深入武陵溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 30
    },
    {
        "title": "书懷",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "病來犹強引雛行，力上東原欲試耕。幾處馬嘶春麥長，",
            "陶令若能兼不飲，无弦琴亦是沽名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 31
    },
    {
        "title": "退棲",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "宦游蕭索為无能，移住中條最上層。得劍乍如添健僕，",
            "自此致身繩檢外，肯教世路日兢兢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 32
    },
    {
        "title": "五十",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "閑身事少只題诗，五十今來覺陡衰。清秩偶叨非養望，",
            "漉酒有巾无黍釀，負他黃菊滿東籬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 33
    },
    {
        "title": "新歲對写真",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "得見明时下壽身，須甘歲酒更移巡。生情暗結千重恨，",
            "自傷衰颯慵開鏡，擬与兒童別写真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 34
    },
    {
        "title": "華下",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "籜冠新帶步池塘，逸韵偏宜夏景長。扶起綠荷承早露，",
            "不用名山訪真訣，退休便是養生方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 35
    },
    {
        "title": "重阳山居",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "诗人自古恨難窮，暮節登臨且喜同。四望交親兵乱後，",
            "明日更期來此醉，不堪寂寞對衰翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 36
    },
    {
        "title": "爭名",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "爭名豈在更搜奇，不朽才消一句诗。窮辱未甘英氣阻，",
            "只此共棲塵外境，无妨亦戀好文时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 37
    },
    {
        "title": "光啟四年春戊申",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "乱後燒残數架书，峰前犹自戀吾廬。忘机漸喜逢人少，",
            "酣歌自適逃名久，不必門多長者車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 38
    },
    {
        "title": "丁巳重阳",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "重阳未到已登臨，探得黃花且独斟。客舍喜逢連日雨，",
            "自賀逢时能自棄，归鞭唯拍馬韉吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 39
    },
    {
        "title": "喜王駕小仪重阳相訪",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "白菊初開臥內明，闻君相訪病身輕。樽前且撥傷心事，",
            "擬将寂寞同留住，且勸康时立大名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 40
    },
    {
        "title": "酬张芬赦後見寄",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "紫鳳朝銜五色书，阳春忽布網羅除。已将心變寒灰後，",
            "勞君故有诗相贈，欲報瓊瑤愧不如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 41
    },
    {
        "title": "上元放二雉",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "嬰網雖皆困，搴籠喜共归。无心期爾報，相見莫驚飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 42
    },
    {
        "title": "中秋",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "閑吟秋景外，万事覺悠悠。此夜若无月，一年虛過秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 43
    },
    {
        "title": "偶題",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "水榭花繁處，春晴日午前。鳥窺臨檻鏡，馬過隔牆鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 44
    },
    {
        "title": "闲步",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "幾處白煙斷，一川紅樹时。壞橋侵轍水，残照背村碑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 45
    },
    {
        "title": "春中",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "伏溜侵階潤，繁花隔竹香。嬌鶯方曉聽，无事過南塘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 46
    },
    {
        "title": "独望",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "綠樹連村暗，黃花出陌稀。遠陂春草綠，犹有水禽飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 47
    },
    {
        "title": "雜題",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "孤枕闻鶯起，幽懷独悄然。地融春力潤，花泛曉光鮮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 48
    },
    {
        "title": "漫題三首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "乱後他鄉節，燒残故國春。自怜垂白首，犹伴踏青人。",
            "齒落傷情久，心驚健忘频。蝸廬經歲客，蠶市異鄉人。",
            "率怕人言謹，閑宜酒韵高。山林若无慮，名利不難逃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 49
    },
    {
        "title": "河上二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "慘慘日将暮，驅羸独到莊。沙痕傍墟落，风色入牛羊。",
            "新霽田園處，夕阳禾黍明。沙村平見水，深巷有鸥聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 50
    },
    {
        "title": "早朝",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "白日新年好，青春上國多。街平雙闕近，塵起五雲和。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 51
    },
    {
        "title": "即事二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "茶爽添诗句，天清瑩道心。只留鶴一隻，此外是空林。",
            "禦禮征奇策，人心注盛时。從來留振滯，只待濟臨危。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 52
    },
    {
        "title": "永夜",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "永夜疑无日，危时只賴山。曠懷休戚外，孤跡是非間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 53
    },
    {
        "title": "秦關",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "形勝今雖在，荒涼恨不窮。虎狼秦國破，狐兔漢陵空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 54
    },
    {
        "title": "渡江",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "秋江共僧渡，鄉淚滴船回。一夜吳船夢，家书立馬開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 55
    },
    {
        "title": "退居漫題七首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "花缺傷難綴，鶯喧奈細聽。惜春春已晚，珍重草青青。",
            "堤柳自綿綿，幽人无恨牽。只憂诗病發，莫寄校书箋。",
            "燕语曾來客，花催欲別人。莫愁春又過，看著又新春。",
            "身外都无事，山中久避喧。破巢看乳燕，留果待啼猿。",
            "诗家通籍美，工部与司勳。高賈雖難敵，微官偶勝君。",
            "努力省前非，人生上壽稀。青雲无直道，暗室有危机。",
            "燕拙營巢苦，魚貪觸網驚。豈緣身外事，亦似我勞形。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 56
    },
    {
        "title": "即事九首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "宿雨川原霽，凭高景物新。陂痕侵牧馬，雲影帶耕人。",
            "十年深隱地，一雨太平心。匣澀休看劍，窗明複上琴。",
            "明时那棄置，多病自迟留。疏磬和吟斷，残燈照臥幽。",
            "衰鬢閑生少，丹梯望覺危。松須依石長，鶴不傍人卑。",
            "落葉频驚鹿，連峰欲映雕。此生诗病苦，此病更蕭條。",
            "旅思又驚夏，庭前長小松。遠峰生貴氣，残月斂衰容。",
            "林鳥频窺靜，家人亦笑慵。舊居留穩枕，归臥聽秋鐘。",
            "華宇知難保，燒來又卻修。只應巢燕惜，未必主人留。",
            "幽鳥穿籬去，鄰翁采药回。雲從潭底出，花向佛前開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 57
    },
    {
        "title": "松滋渡二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "步上短亭久，看回官渡船。江鄉宜晚霽，楚老语豐年。",
            "楚岫接鄉思，茫茫归路迷。更堪斑竹驛，初聽鷓鴣啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 58
    },
    {
        "title": "華清宮",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "帝业山河固，離宮宴幸频。豈知驅戰馬，只是太平人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 59
    },
    {
        "title": "牛頭寺",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "終南最佳處，禪誦出青霄。群木澄幽寂，疏煙泛泬寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 60
    },
    {
        "title": "感时上盧相",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "兵待皇威振，人隨國步安。万方休望幸，封嶽始鳴鑾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 61
    },
    {
        "title": "乱後三首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "喪乱家難保，艱虞病懶醫。空将憂國淚，犹擬灑丹墀。",
            "流芳能幾日，惆悵又闻蟬。行在多新貴，幽棲独長年。",
            "世事嘗艱險，僧居慣寂寥。美香闻夜合，清景見寅朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 62
    },
    {
        "title": "秋景",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "景物皆難駐，傷春複怨秋。旋书紅葉落，擬画碧雲收。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 63
    },
    {
        "title": "避乱",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "離乱身偶在，竄跡任浮沉。虎暴荒居迥，螢孤黑夜深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 64
    },
    {
        "title": "長亭",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "梅雨和鄉淚，終年共酒衣。殷勤華表鶴，羨爾亦曾归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 65
    },
    {
        "title": "村西杏花二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "薄膩力偏羸，看看愴別时。東风狂不惜，西子病難醫。",
            "肌細分紅脈，香濃破紫苞。无因留得玩，爭忍折來拋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 66
    },
    {
        "title": "独坐",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "幽徑入桑麻，塢西逢一家。編籬薪帶繭，補屋草和花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 67
    },
    {
        "title": "借居",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "借住郊園久，仍逢夏景新。綠苔行屐穩，黃鳥傍窗频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 68
    },
    {
        "title": "重阳",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "菊開犹阻雨，蝶意切於人。亦應知暮節，不比惜残春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 69
    },
    {
        "title": "偶书五首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "衰謝當何懺，惟應悔壯圖。磬聲花外遠，人影塔前孤。",
            "色變鶯雛長，竿齊筍籜垂。白頭身偶在，清夏景還移。",
            "蜀妓輕成妙，吳娃狎共纖。晚妝留拜月，卷上水精簾。",
            "独步荒郊暮，沉思遠墅幽。平生多少事，彈指一时休。",
            "掩謗知迎吠，欺心見強顏。有名人易困，无契債難還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 70
    },
    {
        "title": "雜題九首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "病來勝未病，名縛便忘名。今日甘為客，當时注湣征。",
            "暑濕深山雨，荒居破屋燈。此生无懺處，此去作高僧。",
            "不須频悵望，且喜脫喧囂。亦有終焉意，陂南看稻苗。",
            "樓帶猿吟迥，庭容鶴舞寬。z4书因閱画，封药偶和丹。",
            "宴罷論诗久，亭高拜表频。岸香蕃舶月，洲色海煙春。",
            "驛步堤縈閣，军城鼓振橋。鸥和湖雁下，雪隔嶺梅飄。",
            "帶雪南山道，和鐘北闕明。太平當共賀，開化喝來聲。",
            "舴艋猿偷上，蜻蜓燕競飛。樵香燒桂子，苔濕掛莎衣。",
            "溪漲漁家近，煙收鳥道高。松花飄可惜，睡裏灑離騷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 71
    },
    {
        "title": "古樂府",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "一葉隨西风，君行亦向東。知妾飛书意，无勞待早鴻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 72
    },
    {
        "title": "有感",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "燈影看須黑，牆阴惜草青。歲闌悲物我，同是冒霜螢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 73
    },
    {
        "title": "休休亭",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "且喜安能保，那堪病更憂。可怜藜杖者，真個種瓜侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 74
    },
    {
        "title": "漫书二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "剩欲逢花折，判須冒雨频。晴明開漸少，莫怕濕新巾。",
            "小蝶爾何競，追飛不憚勞。遠教群雀見，寧悟禍梯高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 75
    },
    {
        "title": "歲盡二首",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "明日添一歲，端憂奈爾何。沖寒出洞口，犹校夕阳多。",
            "莫話傷心事，投春滿鬢霜。殷勤共尊酒，今歲只残阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 76
    },
    {
        "title": "牡丹",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "得地牡丹盛，曉添龍麝香。主人犹自惜，錦幕護春霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 77
    },
    {
        "title": "乱後",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "羽书傳棧道，风火隔鄉關。病眼那堪泣，傷心不到間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 78
    },
    {
        "title": "春山",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "可是武陵溪，春芳著路迷。花明催曙早，雲膩惹空低。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 79
    },
    {
        "title": "樂府",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "寶馬跋塵光，雙馳照路旁。喧傳報戚裏，明日幸長楊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 80
    },
    {
        "title": "乱前上盧相",
        "author": "司空圖",
        "biography": "",
        "paragraphs": [
            "虜黠雖多變，兵驕即易乘。犹須勞斥候，勿遣大河冰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十二",
        "no#": 81
    }
]