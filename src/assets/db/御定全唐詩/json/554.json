[
    {
        "title": "寄石橋僧",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "逢師入山日，道在石橋邊。別后何人見，秋來幾处禪。",
            "溪中雲隔寺，夜半雪添泉。生有天臺約，知无卻出緣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 1
    },
    {
        "title": "送歐阳袞归閩中",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "秦城幾年住，犹著故鄉衣。失意时相识，成名后独归。",
            "海秋蠻樹黑，嶺夜瘴禽飛。為學心難滿，知君更掩扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 2
    },
    {
        "title": "古觀",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "置觀碑已折，看松年不分。洞中谁识药，門外日添墳。",
            "放去龜隨水，呼來鹿怕熏。壇邊見灰火，幾燒祭星文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 3
    },
    {
        "title": "題令狐处士溪居",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "白发已過半，无心離此溪。病嘗山药遍，貧起草堂低。",
            "為月窗從破，因诗壁重泥。近來常夜坐，寂寞与僧齊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 4
    },
    {
        "title": "送僧归南嶽",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "心知衡岳路，不怕去人稀。船裏谁鳴磬，沙頭自曝衣。",
            "有家從小別，是寺即言归。料得逢春住，當禪雲滿扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 5
    },
    {
        "title": "寧州春思",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "失意離城早，邊城任見花。初為斷酒客，舊识賣书家。",
            "寒寺稀无雪，春风亦有沙。思归频入夢，即路不言賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 6
    },
    {
        "title": "山友贈蘚花冠",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "塵汙出華发，慚君青蘚冠。此身閑未得，終日戴應難。",
            "好就松阴掛，宜當枕石看。會須尋道士，簪去繞霜壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 7
    },
    {
        "title": "蠻家",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "領得賣珠錢，還归銅柱邊。看兒調小象，打鼓試新船。",
            "醉后眠神樹，耕时语瘴煙。不逢寒便老，相问莫知年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 8
    },
    {
        "title": "早春題湖上顧氏新居二首",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "近得水雲看，門長侵早開。到时微有雪，行处又无苔。",
            "勸酒客初醉，留茶僧未來。每逢晴暖日，唯見乞花栽。",
            "門不當官道，行人到亦稀。故從餐后出，方至夜深归。",
            "開篋揀书卷，掃床移褐衣。幾时同買宅，相近有柴扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 9
    },
    {
        "title": "蒼梧雲气",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "何年化作愁，漠漠便難收。数點山能遠，平鋪水不流。",
            "濕連湘竹暮，濃蓋舜墳秋。亦有思归客，看來盡白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 10
    },
    {
        "title": "晚春花",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "阴洞日光薄，花開不及时。當春无半樹，經燒足空枝。",
            "疏与香风會，細将泉影移。此中人到少，開盡幾人知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 11
    },
    {
        "title": "宿胡氏溪亭",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "独住水聲裏，有亭无熱时。客來因月宿，床勢向山移。",
            "鶴睡松枝定，螢归葛葉垂。寂寥犹欠伴，谁為報僧知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 12
    },
    {
        "title": "送華阴隱者",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "往往到城市，得非征药錢。世人空识面，弟子莫知年。",
            "自说能醫死，相期更學仙。近來移住处，毛女舊峰前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 13
    },
    {
        "title": "落第后寄江南親友",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "古巷槐阴合，愁多晝掩扉。独存過江馬，強拂看花衣。",
            "送客心先醉，尋僧夜不归。龍鍾易惆悵，莫遣寄书稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 14
    },
    {
        "title": "欲別",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "花时人欲別，每日醉櫻桃。買酒金錢盡，彈箏玉指勞。",
            "归期无歲月，客路有风濤。錦緞裁衣贈，麒麟落剪刀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 15
    },
    {
        "title": "留別张水部籍",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "省中重拜別，兼領寄人书。已念此行遠，不應相问疏。",
            "子城西並宅，禦水北同渠。要取春前到，乘閑候起居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 16
    },
    {
        "title": "小古鏡",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "字已无人识，唯應記鑄年。見來深似水，攜去重于錢。",
            "鸞翅巢空月，菱花遍小天。宮中照黃帝，曾得化為仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 17
    },
    {
        "title": "題太白山隱者",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "高居在幽嶺，人得見时稀。写籙扃虛白，尋僧到翠微。",
            "掃壇星下宿，收药雨中归。從服小還后，自疑身解飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 18
    },
    {
        "title": "病中懷王展先輩在天臺",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "枕上用心靜，唯應改舊诗。強行休去早，暫臥起還迟。",
            "因说來归处，卻愁初病时。赤城山下寺，无计得相隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 19
    },
    {
        "title": "鯉魚",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "似龍鱗又足，只是欠登門。月裏腮犹濕，泥中目未昏。",
            "乞鋤防蟻穴，望水写金盆。他日能為雨，公田報此恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 20
    },
    {
        "title": "子規",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "遊魂自相叫，寧複記前身。飛過人家月，聲連客路春。",
            "夢邊催曉急，愁外送风频。自有沾花血，相和淚滴新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 21
    },
    {
        "title": "邊州客舍",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "開門不成出，麥色遍前坡。自小诗名在，如今白发多。",
            "經年无越信，終日厭蕃歌。近寺居僧少，春來亦懶過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 22
    },
    {
        "title": "贈道者",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "晏來知養气，度日语时稀。到处留丹井，終寒不絮衣。",
            "病鄉多惠药，鬼俗有符威。自说身輕健，今年数夢飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 23
    },
    {
        "title": "邊游",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "古鎮門前去，長安路在東。天寒明堠火，日晚裂旗风。",
            "塞館皆无事，儒裝亦有弓。防秋故鄉卒，暫喜语音同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 24
    },
    {
        "title": "夜泊淮阴",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "夜入楚家煙，煙中人未眠。望來淮岸盡，坐到酒樓前。",
            "燈影半臨水，箏聲多在船。乘流向東去，別此易經年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 25
    },
    {
        "title": "遠水",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "渺渺浸天色，一邊生晚光。闊浮萍思遠，寒入雁愁長。",
            "北极連平地，東流即故鄉。扁舟來宿处，仿佛似瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 26
    },
    {
        "title": "黃州暮愁",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "淩澌沖淚眼，重疊自西來。即夜寒應合，非春暖不開。",
            "豈无登陸计，宜棄濟川材。愿寄浮天外，高风万里回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 27
    },
    {
        "title": "曉發昭應",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "行人見雪愁，初作帝鄉遊。旅店開偏早，鄉帆去未收。",
            "燈残催卷席，手冷怕梳頭。是物寒无色，湯泉正自流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 28
    },
    {
        "title": "贈金州姚合使君",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "為郎名更重，領郡是蹉跎。官壁題诗盡，衙庭看鶴多。",
            "城池連草塹，籬落帶椒坡。未觉旗幡貴，閑行觸处過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 29
    },
    {
        "title": "送殷中丞游邊",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "話別无長夜，燈前闻曙鴉。已行難避雪，何处合逢花。",
            "野寺門多閉，羌樓酒不賒。還須見邊将，谁擬靜塵沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 30
    },
    {
        "title": "寄坐夏僧",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "坐夏日偏長，知師在律堂。多因束帶熱，更憶剃頭涼。",
            "苔色侵經架，松阴到簟床。還應煉诗句，借臥石池傍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 31
    },
    {
        "title": "寄盧式",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "到处久南望，未知何日回。寄书频到海，得夢忽闻雷。",
            "嶺日當秋暗，蠻花近臘開。白身居瘴癘，谁不惜君才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 32
    },
    {
        "title": "日東病僧",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "雲水絕归路，來时风送船。不言身后事，犹坐病中禪。",
            "深壁藏燈影，空窗出艾煙。已无鄉土信，起塔寺門前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 33
    },
    {
        "title": "泛溪",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "溪船泛渺彌，漸觉滅炎輝。動水花連影，逢人鳥背飛。",
            "深犹見白石，涼好换生衣。未得多诗句，終須隔宿归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 34
    },
    {
        "title": "送顧少府",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "作尉年犹少，无辭去路賒。漁舟縣前泊，山吏日高衙。",
            "幽景臨溪寺，秋蟬織杼家。行程須過越，先醉鏡湖花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 35
    },
    {
        "title": "咸阳別李处士",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "古道自迢迢，咸阳離別橋。越人闻水处，秦樹帶霜朝。",
            "駐馬言難盡，分程望易遙。秋前未相見，此意轉蕭條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 36
    },
    {
        "title": "寄流人",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "毒草不曾枯，長添客健无。霧開蠻市合，船散海城孤。",
            "象跡频藏齒，龍涎遠蔽珠。家人秦地老，泣对日南图。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 37
    },
    {
        "title": "華頂道者",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "仙人掌中住，生有上天期。已廢燒丹处，犹多種杏时。",
            "養龍於淺水，寄鶴在高枝。得道複无事，相逢盡日棋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 38
    },
    {
        "title": "酬從叔聽夜泉見寄",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "夢罷更開戶，寒泉聲隔雲。共谁尋最遠，独自坐偏闻。",
            "岩際和风滴，溪中泛月分。豈知當此夜，流念到江濆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 39
    },
    {
        "title": "和李用夫栽小松",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "移來未换葉，已勝在空山。靜对心標直，遙吟境助閑。",
            "影侵残雪際，聲透小窗間。即聳淩空幹，翛翛豈易攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 40
    },
    {
        "title": "哭南流人",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "遙見南來使，江頭哭问君。臨終时有雪，旅葬处无雲。",
            "官庫空收劍，蠻僧共起墳。知名人尚少，谁為錄遺文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 41
    },
    {
        "title": "經李白墓",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "夜郎归未老，醉死此江邊。葬闕官家禮，诗残樂府篇。",
            "游魂應到蜀，小碣豈旌賢。身沒犹何罪，遺墳野火燃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 42
    },
    {
        "title": "春夜樊川竹亭陪諸同年宴",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "相知皆是舊，每恨独遊频。幸此同芳夕，寧辭倒醉身。",
            "燈光遙映燭，萼粉暗飄茵。明月分归騎，重來更幾春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 43
    },
    {
        "title": "送僧",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "靈山巡未遍，不作住持心。逢寺暫投宿，是山皆独尋。",
            "有时過靜界，在处想空林。從小即行腳，出家來至今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 44
    },
    {
        "title": "送蘇处士归西山",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "南游何所為，一篋又空归。守道安清世，无心换白衣。",
            "深林蟬噪暮，絕頂客來稀。早晚重相見，論诗更及微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 45
    },
    {
        "title": "游爛柯山",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "步步出塵氛，溪山別是春。壇邊时過鶴，棋处寂无人。",
            "訪古碑多缺，探幽路不真。翻疑归去晚，清世累移晨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 46
    },
    {
        "title": "送友人之永嘉",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "長貧知不易，去计擬何逃。相对人愁別，經過幾处勞。",
            "城連沙岫遠，山斷夏雲高。犹想成诗处，秋燈半照濤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 47
    },
    {
        "title": "巴中逢故人",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "勞思空積歲，偶會更无由。以分難相舍，将行且暫留。",
            "路岐何处极，江峽半猿愁。到此分南北，離懷豈易收。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 48
    },
    {
        "title": "送归江州友人初下第",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "名高不俟召，收采獻君門。偶屈應緣数，他人盡為冤。",
            "新春城外路，舊隱水邊村。归去无勞久，知君更待論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 49
    },
    {
        "title": "舜城懷古",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "禪禹遜堯聰，巍巍盛此中。四隅咸啟圣，万古賴成功。",
            "道德去彌遠，山河勢不窮。停車一再拜，帝业即今同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 50
    },
    {
        "title": "送劉道士之成都嚴真觀",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "嚴君名不朽，道出二經中。归去精誠懇，還應夢寐通。",
            "池台鏡定月，松檜雨餘风。想对靈玄憶，人間戀若空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 51
    },
    {
        "title": "漢南遇友人",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "此身西複東，何计此相逢。夢盡吳越水，恨深襄漢鐘。",
            "積雲開去路，曙雪疊前峰。谁即知非舊，怜君忽見容。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 52
    },
    {
        "title": "遊頭陀寺上方",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "高步陟崔嵬，吟閑路惜回。寺知何代有，僧見梵天來。",
            "暮靄連沙積，餘霞遍檻開。更期招靜者，長嘯上南台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 53
    },
    {
        "title": "送友人游河東",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "停車曉燭前，一语幾潸然。路去干戈日，鄉遙饑饉年。",
            "湖波晴見雁，槐驛晚无蟬。莫縱經时住，東南书信偏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 54
    },
    {
        "title": "中秋夜懷",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "趨馳早晚休，一歲又残秋。若只如今日，何難至白頭。",
            "滄波归处遠，旅食尚邊愁。賴見前賢说，窮通不自由。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 55
    },
    {
        "title": "寄富春孫路处士",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "平生醉与吟，谁是見君心。上國一归去，滄江閑至今。",
            "鐘繁秋寺近，峰闊晚濤深。疏放長如此，何人長得尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 56
    },
    {
        "title": "送客归新羅",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "君家滄海外，一別見何因。风土雖知教，程途自致貧。",
            "浸天波色晚，橫笛鳥行春。明發千檣下，應无更遠人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 57
    },
    {
        "title": "杭州江亭留題登眺",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "处处日馳銷，凭軒夕似朝。漁翁閑鼓棹，沙鳥戲迎潮。",
            "樹間津亭密，城連塢寺遙。因谁報隱者，向此得耕樵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 58
    },
    {
        "title": "荊州夜与友親相遇",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "山海两分岐，停舟偶似期。別來何限意，相見卻无辭。",
            "坐永神凝夢，愁繁鬢欲絲。趨名易迟晚，此去莫經时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 59
    },
    {
        "title": "送友人游邊",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "方春到帝京，有戀有愁並。万里江海思，半年沙塞程。",
            "綠阴斜向驛，残照遠侵城。自可資新課，還期振盛名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 60
    },
    {
        "title": "題贈宣州亢拾遺",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "傳騎一何催，山門晝未開。高人終避世，圣主不遺才。",
            "坐次欹臨水，門中独舉杯。谁為旦夕侶，深寺数僧來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 61
    },
    {
        "title": "姚氏池亭",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "池館饒嘉致，幽人愜所閑。筱风能動浪，岸樹不遮山。",
            "嘯檻魚驚后，眠窗鶴语間。何須说廬阜，深处更躋攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 62
    },
    {
        "title": "送友人之江南",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "東南路苦辛，去路見无因。万里此相送，故交谁更親。",
            "日浮汀草綠，煙霽海山春。握手无別贈，為予书劄频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 63
    },
    {
        "title": "彭蠡湖春望",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "湖亭東极望，遠棹不須回。遍草新湖落，連天眾雁來。",
            "蘆洲残照盡，雲障積煙開。更想鴟夷子，扁舟安在哉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 64
    },
    {
        "title": "闻友人會裴明府縣樓",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "閑閣雨吹塵，陶家揖上賓。湖山万疊翠，門樹一行春。",
            "景遍归簷燕，歌喧已醉身。登臨興不足，喜有数來因。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 65
    },
    {
        "title": "归家山行",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "獻賦才何拙，經时不恥归。能知此意是，甘取眾人非。",
            "遍隴耕无圃，緣溪釣有磯。此懷難自遣，期在振儒衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 66
    },
    {
        "title": "長安书懷呈知己",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "江湖归不易，京邑计長貧。独夜有知己，論心无故人。",
            "一燈愁裏夢，九陌病中春。為问清平日，无門致出身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 67
    },
    {
        "title": "闻蟬",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "動葉複驚神，聲聲斷续勻。坐來同聽者，俱是未归人。",
            "一棹三湘浪，單車二蜀塵。傷秋各有日，千可念因循。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 68
    },
    {
        "title": "李处士道院南樓",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "霜晚複秋残，樓明近遠山。滿壺邀我醉，一榻為僧閑。",
            "樹簇孤汀眇，帆欹積浪間。從容更南望，殊欲外人寰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 69
    },
    {
        "title": "送顧非熊及第归茅山",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "吟诗三十载，成此一名難。自有恩門入，全无帝裏歡。",
            "湖光愁裏碧，岩景夢中寒。到后松杉月，何人共曉看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 70
    },
    {
        "title": "春日題李中丞樊川別墅",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "心知受恩地，到此亦裴回。上路移时立，中軒隔宿來。",
            "川光通沼沚，寺影帶樓臺。无限成蹊樹，花多向客開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 71
    },
    {
        "title": "龍州与韓将军夜會",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "庭綠草纖纖，邊州白露沾。別歌緣劍起，客淚是愁添。",
            "見月鵲啼樹，避风雲滿簾。将军盡尊酒，樓上賦星占。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 72
    },
    {
        "title": "途中逢友人",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "長大有南北，山川各所之。相逢孤館夜，共憶少年时。",
            "爛醉百花酒，狂題幾首诗。來朝又分袂，后會鬢應絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 73
    },
    {
        "title": "送友人下第归襄阳",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "失意已春残，归愁与別難。山分關路細，江繞夜城寒。",
            "草色連晴阪，鼉聲離曉灘。差池是秋賦，何以暫懷安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 74
    },
    {
        "title": "宿山寺",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "栗葉重重複翠微，黃昏溪上语人稀。月明古寺客初到，",
            "中宵能得幾时睡，又被鐘聲催著衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 75
    },
    {
        "title": "病鶴",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "青雲有意力犹微，豈料低回得所依。幸念翅因风雨困，",
            "縱使他年引仙駕，主人恩在亦應归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 76
    },
    {
        "title": "夢仙",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "昨宵魂夢到仙津，得見蓬山不死人。雲葉许裁成野服，",
            "次第引看行未遍，浮光牽入世間塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 77
    },
    {
        "title": "古扇",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "昨日裁成奪夏威，忽逢秋節便相違。寒塵妒盡秦王女，",
            "千年蕭瑟關人事，莫语當时掩淚归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 78
    },
    {
        "title": "涇州聽张处士彈琴",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "邊州独夜正思鄉，君又彈琴在客堂。",
            "仿佛不離燈影外，似闻流水到瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 79
    },
    {
        "title": "贈別",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "魚在深泉鳥在雲，從來只得影相親。",
            "他时縱有逢君处，應作人間白发身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 80
    },
    {
        "title": "对鱠",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "行到鱸魚鄉里时，鱠盤如雪怕风吹。",
            "犹怜醉裏江南路，馬上垂鞭學釣时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 81
    },
    {
        "title": "憶朝阳峰前居",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "每憶閑眠处，朝阳最上峰。溪僧來自遠，林路出无蹤。",
            "敗褐黏苔遍，新題出石重。霞光侵曙發，嵐翠近秋濃。",
            "健羨机能破，安危道不逢。雪残猿到閣，庭午鶴離松。",
            "此地虛為別，人間久未容。何时无一事，卻去養疏慵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 82
    },
    {
        "title": "暮上瞿唐峽",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "自古艱難地，孤舟旦暮程。独愁空托命，省已是輕生。",
            "有樹皆相倚，无岩不倒傾。蛟螭波数怒，鬼怪火潛明。",
            "履道知无負，離心自要驚。何年面骨肉，細話苦辛行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 83
    },
    {
        "title": "和李中丞醉中期王征君月夜同游滻水舊居",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "醉后情俱遠，難忘素滻間。照花深处月，當戶舊时山。",
            "事想同清話，歡期一破顏。风流還愛竹，此夜尚思閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 84
    },
    {
        "title": "濁水求珠",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "靈魄自沉浮，從來任濁流。愿從深处得，不向暗中投。",
            "圓月时堪惜，滄波路可求。沙尋龍窟遠，泥訪蚌津幽。",
            "是寶終知貴，唯恩且用酬。如能在公掌，的不負明眸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 85
    },
    {
        "title": "江村夜泊",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "日落江路黑，前村人语稀。幾家深樹裏，一火夜漁归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 86
    },
    {
        "title": "落第后归覲喜逢僧再阳",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "相逢須強笑，人世別離频。去曉長侵月，归鄉動隔春。",
            "見僧心暫靜，從俗事多屯。宇宙诗名小，山河客路新。",
            "翠桐犹入爨，青鏡未辭塵。逸足常思驥，隨群且退鱗。",
            "宴乖紅杏寺，愁在綠楊津。羞病難為药，開眉懶顧人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 87
    },
    {
        "title": "送越僧元瑞",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "靜中无伴侶，今亦独隨緣。昨夜離空室，焚香淨去船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 88
    },
    {
        "title": "舊宮人",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "自出先皇玉殿中，衣裳不更染深紅。宮釵折盡垂空鬢，",
            "如今還向城邊住，禦水東流意不通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 89
    },
    {
        "title": "夢游仙",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "夢遊飛上天家樓，珠箔當风掛玉鉤。鸚鵡隔簾呼再拜，",
            "将謂便長於此地，雞聲入耳所堪愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 90
    },
    {
        "title": "送宮人入道",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "愿隨仙女董雙成，王母前頭作伴行。初戴玉冠多誤拜，",
            "旦暮焚香繞壇上，步虛犹作按歌聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 91
    },
    {
        "title": "長安退将",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "塞晚沖沙損眼明，归來養病住秦京。上高樓閣看星坐，",
            "翠眉紅臉和回鶻，惆悵中原不用兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 92
    },
    {
        "title": "遙裝夜",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "卷席貧拋壁下床，且鋪他处对燈光。欲行千里從今夜，",
            "谁知更有芙蓉浦，南去令人愁思長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 93
    },
    {
        "title": "送苗七求職",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "相逢未得三回笑，风送離情入剪刀。客路最能銷日月，",
            "去去緣多山与海，鶴身寧肯為飛勞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 94
    },
    {
        "title": "山行",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "青櫪林深亦有人，一渠流水数家分。山當日午回峰影，",
            "行逢賣药归來客，不惜相隨入島雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 95
    },
    {
        "title": "題永忻寺影堂",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "不遇修寺日，无錢入影堂。故來空禮拜，臨去重添香。",
            "僧得名難近，燈傳火已長。發心依止后，借住有鄰房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 96
    },
    {
        "title": "獻令狐相公，时相公郊壇行事回",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "鶚在卿雲冰在壺，代天才业本籲謨。榮同伊陟傳朱戶，",
            "不知机務时多暇，還许诗家屬和无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 97
    },
    {
        "title": "句",
        "author": "項斯",
        "biography": "",
        "paragraphs": [
            "佳人背江坐，眉際列煙樹。。",
            "馬蹄沒青莎，船跡成空波。",
            "春风吹两意，何意更相值。（《古意》。",
            "以上並見张為《主客图》）",
            "更望會稽何处是，沙連竹箭白鷳群。。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十四",
        "no#": 98
    }
]