[
    {
        "title": "归山作",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "喧靜各有路，偶隨心所安。縱然在朝市，終不忘林巒。",
            "四皓将拂衣，二疏能掛冠。窗前隱逸傳，每日三时看。",
            "靳尚那可論，屈原亦可歎。至今黃泉下，名及青雲端。",
            "松牖見初月，花間禮古壇。何处論心懷，世上空漫漫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 1
    },
    {
        "title": "題醴陵玉仙觀歌",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "王喬一去空仙觀，白雲至今凝不散。星垣松殿幾千秋，",
            "路逢一人擎药碗，松花夜雨风吹滿。自言家住在東坡，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 2
    },
    {
        "title": "訪雲母山僧",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "森然古岩裏，淨行一番僧。松下濾寒水，佛前挑夜燈。",
            "蓮花國土異，貝葉梵书能。想到空王境，无心问愛憎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 3
    },
    {
        "title": "題王班水亭",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "湖上見秋色，曠然如爾懷。豈惟歡隴畝，兼亦外形骸。",
            "待月归山寺，彈琴坐暝齋。布衣閑自貴，何用謁天階。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 4
    },
    {
        "title": "山中寄王員外",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "為问幽蘭桂，空山複若何。芬芳終有分，采折更谁過。",
            "望在軒階近，恩沾雨露多。移居儻得地，長愿接瓊柯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 5
    },
    {
        "title": "许州鄭使君孩子",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "毛骨貴天生，肌膚片玉明。見人空解笑，弄物不知名。",
            "國器嗟犹小，門风望益清。抱來芳樹下，时引鳳雛聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 6
    },
    {
        "title": "愴故人舊居",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "惆悵至日暮，寒鴉啼樹林。破階苔色厚，残壁雨痕深。",
            "命与时不遇，福為禍所侵。空餘行徑在，令我歎人吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 7
    },
    {
        "title": "逢靈道士",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "浮丘山上見黃冠，松柏森森登古壇。一莖青竹以為杖，",
            "縮地往來无定所，花源到处路漫漫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 8
    },
    {
        "title": "別盛安",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "情人取次幾淹留，別后南州与北州。月色為怜今夜客，",
            "親故相逢且借问，古來无種是王侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 9
    },
    {
        "title": "傷蔡处士",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "篋中遺草是琅玕，对此空令灑淚看。三徑尚餘行跡在，",
            "欲问皇天天更遠，有才无命说應難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 10
    },
    {
        "title": "臨川道中",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "出谷入谷路回轉，秋风已至归期晚。",
            "舉頭何处望來蹤，万仞千山鳥飛遠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 11
    },
    {
        "title": "贈张駙馬斑竹柱杖",
        "author": "護國",
        "biography": "",
        "paragraphs": [
            "此君与我在雲溪，勁節奇文勝杖藜。",
            "為有歲寒堪贈遠，玉階行处愿提攜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 12
    },
    {
        "title": "病癒寄友",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "哀樂暗成疾，臥中芳月移。西山有清士，孤嘯不可追。",
            "搗药晝林靜，汲泉阴澗迟。微蹤与麋鹿，遠謝求羊知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 13
    },
    {
        "title": "程評事西園之作",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "谁向春鶯道，名園已共知。簷前回水影，城上出花枝。",
            "搖拂煙雲動，登臨翰墨隨。相招能不厭，山舍為君移。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 14
    },
    {
        "title": "陳九溪中草堂",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "溪草落濺濺，魚飛入稻田。早寒臨洞月，輕素捲簾煙。",
            "dU幘題新句，蓑衣象古賢。曙花閑秀色，三十六峰前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 15
    },
    {
        "title": "題天長阮少府湖上客归",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "孤棹移官舍，新農寄楚田。晴林渡海日，春草長湖煙。",
            "臥对閑鸥戲，談經稚子賢。佳期更何许，應向嘯台前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 16
    },
    {
        "title": "題万山许煉師",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "道成人不识，流水響空山。花暗軒窗外，雲隨坐臥間。",
            "驗图名已久，絕粒事長閑。更欲昆侖去，羞看絳節還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 17
    },
    {
        "title": "河源破賊后贈袁将军",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "白羽三千駐，蕭蕭万里行。出關深漢壘，帶月破蕃營。",
            "蔓草河原色，悲笳碎葉聲。欲朝王母殿，前路駐高旌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 18
    },
    {
        "title": "越中贈程先生",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "紗帽度残春，虛舟寄一身。溪邊逢越女，花裏问秦人。",
            "古塞連山靜，阴霞落海新。有时城郭去，暗与酒家親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 19
    },
    {
        "title": "送常大夫赴朔方",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "關山今不掩，军候鳥先知。大漢嫖姚入，烏孫部曲隨。",
            "高旌天外駐，寒角月中吹。归到長安第，花應再滿枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 20
    },
    {
        "title": "送人遊閩越",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "不須行借问，為爾話閩中。海島阴晴日，江帆來去风。",
            "道游玄度宅，身寄朗陵公。此別何傷遠，如今關塞通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 21
    },
    {
        "title": "送褚先生海上尋封煉師",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "潮落风初定，天吳避客舟。近承三殿旨，欲向五湖遊。",
            "不厭烏皮幾，新縫鶴氅裘。明珠漂斷岸，阴火映中流。",
            "華蓋芝童引，神丹桂女收。懸知居縹緲，因為识浮丘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 22
    },
    {
        "title": "送韓侍禦自使幕巡海北",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "微雨空山夜洗兵，繡衣朝拂海雲清。幕中运策心應苦，",
            "因说元戎能破敵，高歌一曲隴關情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 23
    },
    {
        "title": "张舍人南溪別业",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "新田繞屋半春耕，藜杖閑門引客行。山翠自成微雨色，",
            "入夜更宜明月滿，雙童喚出解吹笙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 24
    },
    {
        "title": "別盧使君归故柵村",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "归风白馬引嘶聲，落日犹看楚客情。塞口竹緣空戍沒，",
            "東道宿程投故柵，依依漁父解相迎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 25
    },
    {
        "title": "丹阳浦送客之海上",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "不到終南向幾秋，移居更欲近滄洲。风吹雨色連村暗，",
            "如君豈得空高枕，只益天书遣遠求。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 26
    },
    {
        "title": "月夜泛舟",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "西塞長雲盡，南湖片月斜。漾舟人不見，臥入武陵花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 27
    },
    {
        "title": "送友人之上都",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "玉帛征賢楚客稀，猿啼相送武陵归。",
            "湖頭望入桃花去，一片春帆帶雨飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 28
    },
    {
        "title": "句",
        "author": "法振",
        "biography": "",
        "paragraphs": [
            "画鼓催來錦臂襄，小娥雙起整霓裳。（《柘枝》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百一十一",
        "no#": 29
    }
]