[
    {
        "title": "奉和聖制從蓬萊向興慶閣道中留春雨中春望之作應制",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "渭水自縈秦塞曲，黃山舊繞漢宮斜。鑾輿迥出千門柳，",
            "為乘阳氣行时令，不是宸遊玩物華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 1
    },
    {
        "title": "大同殿柱產玉芝龍池上有慶雲神光照殿百官共覩聖恩便賜宴樂敢书即事",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "欲笑周文歌宴鎬，遙輕漢武樂橫汾。豈知玉殿生三秀，",
            "共歡天意同人意，万歲千秋奉聖君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 2
    },
    {
        "title": "敕賜百官櫻桃",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "芙蓉闕下會千官，紫禁朱櫻出上闌。才是寢園春薦後，",
            "飽食不須愁內熱，大官還有蔗漿寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 3
    },
    {
        "title": "敕借岐王九成宮避暑應教",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "帝子遠辭丹鳳闕，天书遙借翠微宮。隔窗雲霧生衣上，",
            "仙家未必能勝此，何事吹笙向碧空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 4
    },
    {
        "title": "和賈舍人早朝大明宮之作",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "絳幘雞人送曉籌，尚衣方進翠雲裘。九天閶闔開宮殿，",
            "朝罷須裁五色詔，佩聲归向鳳池頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 5
    },
    {
        "title": "和太常韋主簿五郎溫湯寓目之作",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "漢主離宮接露臺，秦川一半夕阳開。青山儘是朱旗繞，",
            "闻道甘泉能獻賦，懸知独有子雲才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 6
    },
    {
        "title": "苑舍人能书梵字兼達梵音，皆曲盡其妙，戲為之贈",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "名儒待詔滿公車。才子為郎典石渠。蓮花法藏心懸悟，",
            "故舊相望在三事，愿君莫厭承明廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 7
    },
    {
        "title": "重酬苑郎中",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "何幸含香奉至尊，多慚未報主人恩。草木盡能酬雨露，",
            "揚子解嘲徒自遣，馮唐已老複何論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 8
    },
    {
        "title": "酬郭給事",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "洞門高閣靄餘輝，桃李阴阴柳絮飛。禁裏疏鐘官舍晚，",
            "強欲從君无那老，将因臥病解朝衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 9
    },
    {
        "title": "出塞",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "居延城外獵天驕，白草連山野火燒。暮雲空磧时驅馬，",
            "玉靶角弓珠勒馬，漢家将賜霍嫖姚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 10
    },
    {
        "title": "既蒙宥罪旋復拜官伏感聖恩竊书鄙意兼奉簡新除使君等諸公",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "忽蒙漢詔還冠冕，始覺殷王解網羅。日比皇明犹自暗，",
            "闻道百城新佩印，還來雙闕共鳴珂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 11
    },
    {
        "title": "送方尊師归嵩山",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "仙官欲往九龍潭，旄節朱幡倚石龕。山壓天中半天上，",
            "借问迎來雙白鶴，已曾衡岳送蘇耽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 12
    },
    {
        "title": "送楊少府貶郴州",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "明到衡山与洞庭，若為秋月聽猿聲。愁看北渚三湘遠，",
            "長沙不久留才子，賈誼何須吊屈平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 13
    },
    {
        "title": "過乘如禪師蕭居士嵩丘蘭若",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "无著天親弟与兄，嵩丘蘭若一峰晴。食隨鳴磬巢烏下，",
            "深洞長松何所有，儼然天竺古先生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 14
    },
    {
        "title": "春日与裴迪過新昌裏訪呂逸人不遇",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "桃源一向絕风塵，柳市南頭訪隱淪。到門不敢題凡鳥，",
            "閉戶著书多歲月，種松皆老作龍鱗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 15
    },
    {
        "title": "酌酒与裴迪",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "酌酒与君君自寬，人情翻覆似波瀾。白首相知犹按劍，",
            "世事浮雲何足问，不如高臥且加餐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 16
    },
    {
        "title": "輞川別业",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "不到東山向一年，归來才及種春田。雨中草色綠堪染，",
            "披衣倒屣且相見，相歡语笑衡門前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 17
    },
    {
        "title": "早秋山中作",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "无才不敢累明时，思向東溪守故籬。豈厭尚平婚嫁早，",
            "寂寞柴門人不到，空林独与白雲期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 18
    },
    {
        "title": "積雨輞川莊作",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "積雨空林煙火迟，蒸藜炊黍餉東菑。漠漠水田飛白鹭，",
            "野老与人爭席罷，海鸥何事更相疑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 19
    },
    {
        "title": "聽百舌鳥",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "上蘭門外草萋萋，未央宮中花裏棲。亦有相隨過御苑，",
            "万戶千門應覺曉，建章何必聽鳴雞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 20
    },
    {
        "title": "息夫人",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "莫以今时寵，難忘舊日恩。看花滿眼淚，不共楚王言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 21
    },
    {
        "title": "班婕妤三首",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "玉窗螢影度，金殿人聲絕。秋夜守羅帷，孤燈耿不滅。",
            "宮殿生秋草，君王恩幸疏。那堪闻鳳吹，門外度金輿。",
            "怪來妝閣閉，朝下不相迎。總向春園裏，花間笑语聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 22
    },
    {
        "title": "輞川集：孟城坳",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "新家孟城口，古木餘衰柳。來者複為谁，空悲昔人有。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 23
    },
    {
        "title": "輞川集：華子岡",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "飛鳥去不窮，連山複秋色。上下華子岡，惆悵情何極。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 24
    },
    {
        "title": "輞川集：文杏館",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "文杏裁為梁，香茅結為宇。不知棟裏雲，去作人間雨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 25
    },
    {
        "title": "輞川集：斤竹嶺",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "檀欒映空曲，青翠漾漣漪。暗入商山路，樵人不可知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 26
    },
    {
        "title": "輞川集：鹿柴",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "空山不見人，但闻人语響。返景入深林，複照青苔上。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 27
    },
    {
        "title": "輞川集：木蘭柴",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "秋山斂餘照，飛鳥逐前侶。彩翠时分明，夕嵐无處所。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 28
    },
    {
        "title": "輞川集：茱萸沜",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "結實紅且綠，複如花更開。山中儻留客，置此芙蓉杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 29
    },
    {
        "title": "輞川集：宮槐陌",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "仄徑蔭宮槐，幽阴多綠苔。應門但迎掃，畏有山僧來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 30
    },
    {
        "title": "輞川集：臨湖亭",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "輕舸迎上客，悠悠湖上來。當軒對尊酒，四面芙蓉開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 31
    },
    {
        "title": "輞川集：南垞",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "輕舟南垞去，北垞淼難即。隔浦望人家，遙遙不相识。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 32
    },
    {
        "title": "輞川集：欹湖",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "吹簫淩極浦，日暮送夫君。湖上一回首，青山卷白雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 33
    },
    {
        "title": "輞川集：柳浪",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "分行接綺樹，倒影入清漪。不學禦溝上，春风傷別離。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 34
    },
    {
        "title": "輞川集：欒家瀨",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "颯颯秋雨中，淺淺石溜瀉。跳波自相濺，白鹭驚複下。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 35
    },
    {
        "title": "輞川集：金屑泉",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "日飲金屑泉，少當千餘歲。翠鳳翊文螭，羽節朝玉帝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 36
    },
    {
        "title": "輞川集：白石灘",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "清淺白石灘，綠蒲向堪把。家住水東西，浣紗明月下。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 37
    },
    {
        "title": "輞川集：北垞",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "北垞湖水北，雜樹映朱闌。逶迤南川水，明滅青林端。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 38
    },
    {
        "title": "輞川集：竹裏館",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "独坐幽篁裏，彈琴複長嘯。深林人不知，明月來相照。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 39
    },
    {
        "title": "輞川集：辛夷塢",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "木末芙蓉花，山中發紅萼。澗戶寂无人，紛紛開且落。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 40
    },
    {
        "title": "輞川集：漆園",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "古人非傲吏，自闕經世務。偶寄一微官，婆娑數株樹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 41
    },
    {
        "title": "輞川集：椒園",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "桂尊迎帝子，杜若贈佳人。椒漿奠瑤席，欲下雲中君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 42
    },
    {
        "title": "皇甫嶽雲溪雜題五首：鳥鳴澗",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "人閑桂花落，夜靜春山空。月出驚山鳥，时鳴春澗中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 43
    },
    {
        "title": "皇甫嶽雲溪雜題五首：蓮花塢",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "日日採蓮去，洲長多暮归。弄篙莫濺水，畏濕紅蓮衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 44
    },
    {
        "title": "皇甫嶽雲溪雜題五首：鸕鷀堰",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "乍向紅蓮沒，複出清蒲颺。独立何褵褷，銜魚古查上。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 45
    },
    {
        "title": "皇甫嶽雲溪雜題五首：上平田",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "朝耕上平田，暮耕上平田。借问问津者，寧知沮溺賢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 46
    },
    {
        "title": "皇甫嶽雲溪雜題五首：萍池",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "春池深且廣，會待輕舟回。靡靡綠萍合，垂楊掃複開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 47
    },
    {
        "title": "答裴迪輞口遇雨憶終南山之作",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "淼淼寒流廣，蒼蒼秋雨晦。君问終南山，心知白雲外。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 48
    },
    {
        "title": "山中寄諸弟妹",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "山中多法侶，禪誦自為群。城郭遙相望，唯應見白雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 49
    },
    {
        "title": "闻裴秀才迪吟诗因戲贈",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "猿吟一何苦，愁朝複悲夕。莫作巫峽聲，腸斷秋江客。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 50
    },
    {
        "title": "贈韋穆十八",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "与君青眼客，共有白雲心。不向東山去，日令春草深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 51
    },
    {
        "title": "送別",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "山中相送罷，日暮掩柴扉。春草明年綠，王孫归不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 52
    },
    {
        "title": "臨高臺送黎拾遺",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "相送臨高臺，川原杳何極。日暮飛鳥還，行人去不息。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 53
    },
    {
        "title": "別輞川別业",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "依迟動車馬，惆悵出松蘿。忍別青山去，其如綠水何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 54
    },
    {
        "title": "崔九弟欲往南山馬上口號与別",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "城隅一分手，幾日還相見。山中有桂花，莫待花如霰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 55
    },
    {
        "title": "題友人雲母障子",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "君家雲母障，时向野庭開。自有山泉入，非因采画來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 56
    },
    {
        "title": "紅牡丹",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "綠豔閑且靜，紅衣淺複深。花心愁欲斷，春色豈知心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 57
    },
    {
        "title": "左掖梨花",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "閑灑階邊草，輕隨箔外风。黃鶯弄不足，銜入未央宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 58
    },
    {
        "title": "菩提寺禁口號又示裴迪",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "安得舍羅網，拂衣辭世喧。悠然策藜杖，归向桃花源。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 59
    },
    {
        "title": "雜诗三首",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "家住孟津河，門對孟津口。常有江南船，寄书家中否。",
            "君自故鄉來，應知故鄉事。來日綺窗前，寒梅著花未。",
            "已見寒梅發，複闻啼鳥聲。心心視春草，畏向階前生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 60
    },
    {
        "title": "崔興宗写真詠",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "画君年少时，如今君已老。今时新识人，知君舊时好。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 61
    },
    {
        "title": "山茱萸",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "朱實山下開，清香寒更發。幸与叢桂花，窗前向秋月。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 62
    },
    {
        "title": "相思",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "紅豆生南國，秋來發故枝。愿君多採擷，此物最相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 63
    },
    {
        "title": "书事",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "輕阴閣小雨，深院晝慵開。坐看蒼苔色，欲上人衣來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 64
    },
    {
        "title": "哭孟浩然",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "故人不可見，漢水日東流。借问襄阳老，江山空蔡州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 65
    },
    {
        "title": "闕題二首",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "荊溪白石出，天寒紅葉稀。山路元无雨，空翠濕人衣。",
            "相看不忍發，慘澹暮潮平。语罷更攜手，月明洲渚生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 66
    },
    {
        "title": "田園樂七首",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "厭見千門万戶，經過北裏南鄰。",
            "官府鳴珂有底，崆峒散發何人。",
            "再見封侯万戶，立談賜璧一雙。",
            "詎勝耦耕南畝，何如高臥東窗。",
            "采菱渡頭风急，策杖林西日斜。",
            "杏樹壇邊漁父，桃花源裏人家。",
            "萋萋春草秋綠，落落長松夏寒。",
            "牛羊自归村巷，童稚不识衣冠。",
            "山下孤煙遠村，天邊独樹高原。",
            "一瓢顏回陋巷，五柳先生對門。",
            "桃紅複含宿雨，柳綠更帶朝煙。",
            "花落家童未掃，鶯啼山客犹眠。",
            "酌酒會臨泉水，抱琴好倚長松。",
            "南園露葵朝折，東谷黃粱夜舂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 67
    },
    {
        "title": "少年行四首",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "新豐美酒鬥十千，咸阳遊俠多少年。",
            "相逢意氣為君飲，系馬高樓垂柳邊。",
            "出身仕漢羽林郎，初隨驃騎戰漁阳。",
            "孰知不向邊庭苦，縱死犹闻俠骨香。",
            "一身能擘两雕弧，虜騎千重只似无。",
            "偏坐金鞍調白羽，紛紛射殺五單于。",
            "漢家君臣歡宴終，高議雲台論戰功。",
            "天子臨軒賜侯印，将军佩出明光宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 68
    },
    {
        "title": "贈裴旻将军",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "腰間寶劍七星文，臂上雕弓百戰勳。",
            "見说雲中擒黠虜，始知天上有将军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 69
    },
    {
        "title": "送王尊師归蜀中拜掃",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "大羅天上神仙客，濯錦江頭花柳春。",
            "不為碧雞稱使者，唯令白鶴報鄉人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 71
    },
    {
        "title": "渭城曲",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "渭城朝雨浥輕塵，客舍青青楊柳春。",
            "勸君更盡一杯酒，西出阳關无故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 72
    },
    {
        "title": "齊州送祖二",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "送君南浦淚如絲，君向東州使我悲。",
            "為報故人憔悴盡，如今不似洛阳时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 73
    },
    {
        "title": "送韋評事",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "欲逐将军取右賢，沙場走馬向居延。",
            "遙知漢使蕭關外，愁見孤城落日邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 74
    },
    {
        "title": "靈雲池送從弟",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "金杯緩酌清歌轉，画舸輕移豔舞回。",
            "自歎鶺鴒臨水別，不同鴻雁向池來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 75
    },
    {
        "title": "送沈子归江東",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "楊柳渡頭行客稀，罟師蕩槳向臨圻。",
            "唯有相思似春色，江南江北送君归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 76
    },
    {
        "title": "与盧員外象過崔處士興宗林亭",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "綠樹重阴蓋四鄰，青苔日厚自无塵。",
            "科頭箕踞長松下，白眼看他世上人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 77
    },
    {
        "title": "寒食汜上作",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "廣武城邊逢暮春，汶阳归客淚沾巾。",
            "落花寂寂啼山鳥，楊柳青青渡水人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 78
    },
    {
        "title": "戲題輞川別业",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "柳條拂地不須折，松樹披雲從更長。",
            "藤花欲暗藏猱子，柏葉初齊養麝香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 79
    },
    {
        "title": "戲題磐石",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "可怜磐石臨泉水，複有垂楊拂酒杯。",
            "若道春风不解意，何因吹送落花來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 80
    },
    {
        "title": "寄河上段十六",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "与君相見即相親，闻道君家在孟津。",
            "為見行舟試借问，客中时有洛阳人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 81
    },
    {
        "title": "菩提寺禁裴迪來相看说逆賊等凝碧池上作音樂供奉人等舉聲便一时淚下私成口號誦示裴迪",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "万戶傷心生野煙，百僚何日更朝天。",
            "秋槐葉落空宮裏，凝碧池頭奏管弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 82
    },
    {
        "title": "涼州賽神",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "涼州城外少行人，百尺峰頭望虜塵。",
            "健兒擊鼓吹羌笛，共賽城東越騎神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 83
    },
    {
        "title": "戲嘲史寰",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "清风細雨濕梅花，驟馬先過碧玉家。",
            "正值楚王宮裏至，門前初下七香車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 84
    },
    {
        "title": "歎白发",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "宿昔朱顏成暮齒，須臾白发變垂髫。",
            "一生幾许傷心事，不向空門何處銷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 85
    },
    {
        "title": "伊州歌",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "清风明月苦相思，蕩子從戎十载餘。",
            "征人去日殷勤囑，归雁來时數附书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 86
    },
    {
        "title": "送殷四葬",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "送君返葬石樓山，松柏蒼蒼賓馭還。",
            "埋骨白雲長已矣，空餘流水向人間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 87
    },
    {
        "title": "疑夢",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "莫驚寵辱空憂喜，莫计恩讎浪苦辛。",
            "黃帝孔丘何處问，安知不是夢中身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 88
    },
    {
        "title": "句",
        "author": "王維",
        "biography": "",
        "paragraphs": [
            "人家在仙掌，雲氣欲生衣。",
            "知古齋主精校2000。01。22。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十八",
        "no#": 89
    }
]