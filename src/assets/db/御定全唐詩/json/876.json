[
    {
        "title": "二賀诗",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "學行可師賀德基，文質彬彬賀德仁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 1
    },
    {
        "title": "四王语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "甯向儋崖振白，不事江滕蔣虢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 2
    },
    {
        "title": "时人為屈突语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "寧食三鬥艾，不見屈突蓋。寧服三鬥蔥，不逢屈突通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 3
    },
    {
        "title": "楊刺史语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "甯食三鬥蒜，不逢楊德幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 4
    },
    {
        "title": "万年人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "寧飲三鬥塵，无逢權懷恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 5
    },
    {
        "title": "贊皇人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "太沖无兄，孝端无弟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 6
    },
    {
        "title": "高宗时语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "左相宣威沙漠，右相馳譽丹青。",
            "三館學生放散，五台令史經明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 7
    },
    {
        "title": "时人為李義甫语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "今日巨唐年，還誅四凶族。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 8
    },
    {
        "title": "洛州语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "洛州有前賈后张，可敵京兆三王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 9
    },
    {
        "title": "江淮間语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "貴如许郝，富若田彭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 10
    },
    {
        "title": "河北语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "唯此两何，殺人最多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 11
    },
    {
        "title": "李昭德為王弘義语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "昔闻蒼鷹獄吏，今見白兔禦史。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 12
    },
    {
        "title": "京洛语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "衣裳好，仪貌惡。不姓许，即姓郝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 13
    },
    {
        "title": "台中语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "侯知一不伏致仕，张悰自請起複。高筠不肯作孝，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 14
    },
    {
        "title": "吏人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "不畏侯卿杖，惟畏尹卿筆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 15
    },
    {
        "title": "選人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "有錢石上好，无錢劉下好，士大夫张下好。",
            "碩學師劉子，儒生用与言。",
            "今年柿子並遭霜，為语石榴須早摘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 16
    },
    {
        "title": "韋氏语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "大郎罷相，小郎拜相。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 17
    },
    {
        "title": "益州人吏语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "錄事意，与天通，益州司馬折威风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 18
    },
    {
        "title": "天授中语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "遇徐杜者必生，遇來侯者必死。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 19
    },
    {
        "title": "时人為鄒昉语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "蕭佺駙馬子，鄒昉駱駝兒。非關道德合，只為錢相知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 20
    },
    {
        "title": "題张昌仪門语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "一两絲能得幾时絡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 21
    },
    {
        "title": "时人號李知遠语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "李下无蹊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 22
    },
    {
        "title": "又號李乂语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "李下无蹊徑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 23
    },
    {
        "title": "竇僕射语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "竇僕射，前為韋氏國yQ，后作公主邑丞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 24
    },
    {
        "title": "时人為崔无詖语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "皇后嫁女，天子娶婦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 25
    },
    {
        "title": "神龍中语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "崔冉鄭，乱时政。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 26
    },
    {
        "title": "斜封官语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "姚宋為相，邪不如正。太平用事，正不如邪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 27
    },
    {
        "title": "李处鬱语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "飧若入咽，百无一全。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 28
    },
    {
        "title": "景雲初语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "前有裴馬，后有盧李。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 29
    },
    {
        "title": "先天时京中语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "姜師度一心看地，傅孝忠两眼相天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 30
    },
    {
        "title": "时人號王丘、崔沔语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "丘山岌岌連天峻，沔水澄澄澈底清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 31
    },
    {
        "title": "吏部過官语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "麟之口，光庭手。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 32
    },
    {
        "title": "郇公廚语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "人欲不飯筋骨舒，夤緣須入郇公廚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 33
    },
    {
        "title": "四俊语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "令君四俊，苗呂崔員。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 34
    },
    {
        "title": "八友语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "殷顏柳陸，李蕭邵趙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 35
    },
    {
        "title": "羅吉口號",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "羅鉗吉網。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 36
    },
    {
        "title": "裏閭詛语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "若違教，值三豹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 37
    },
    {
        "title": "陝州语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "不須賽神明，不必求巫祝。爾莫犯盧公，立便有禍福。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 38
    },
    {
        "title": "真源邑语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "南金口，明府手。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 39
    },
    {
        "title": "稱二王语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "朝廷左相筆，天下右丞诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 40
    },
    {
        "title": "代宗朝京師语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "常无分別元好錢，賢者愚，愚者賢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 41
    },
    {
        "title": "戲諫司语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "韓諫議雖分左右，归拾遺莫辨存亡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 42
    },
    {
        "title": "裴度语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "雞豬魚蒜，逢著則吃。生老病死，时至則行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 43
    },
    {
        "title": "魏博语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "長安天子，魏府牙军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 44
    },
    {
        "title": "寶曆宮中语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "寶帳香重重，一雙紅芙蓉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 45
    },
    {
        "title": "京師人號牛楊语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "太牢筆，少牢口，東西南北何处走。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 46
    },
    {
        "title": "又號牛李",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "門生故吏，不牛則李。。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 47
    },
    {
        "title": "荊南语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "旱不苦，禱而雨。雨不愁，公出遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 48
    },
    {
        "title": "鄭仁表自语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "天瑞有五色雲，人瑞有鄭仁表。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 49
    },
    {
        "title": "湖蘇二郡语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "湖接两頭，蘇聯三尾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 50
    },
    {
        "title": "廣明初都人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "黃賊打黑賊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 51
    },
    {
        "title": "吏部舊语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "長名以前，選人屬侍郎。長名以后，侍郎屬選人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 52
    },
    {
        "title": "省中语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "后行祠屯，不博中行都門；中行禮部，不博前行駕庫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 53
    },
    {
        "title": "郎吏语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "司門水部，入省不数。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 54
    },
    {
        "title": "諫院台省语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "遺補相惜，禦史相憎，郎官相輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 55
    },
    {
        "title": "禦史台语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "事長如事端。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 56
    },
    {
        "title": "京兆府语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "不立两縣令，不坐两少尹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 57
    },
    {
        "title": "翰林諫議语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "饒道鬥上坡去，亦須卻下坡來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 58
    },
    {
        "title": "舉子语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "槐花黃，舉子忙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 59
    },
    {
        "title": "明經進士语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "三十老明經，五十少進士。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 60
    },
    {
        "title": "雜帖语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "常雜鮑帖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 61
    },
    {
        "title": "閩人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "歐阳独步，藻蘊橫行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 62
    },
    {
        "title": "舉場语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "欲入舉場，先问蘇张。蘇张犹可，三楊殺我。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 63
    },
    {
        "title": "大中后進士语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "欲得命通，问瑝嵎都雍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 64
    },
    {
        "title": "大中时语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "鄭楊段薛，炙手可熱。欲得命通，魯紹瑰蒙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 65
    },
    {
        "title": "選舉人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "王凝裴瓚。舍弟安潛。朝中无呼字，知闻廳裏，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 66
    },
    {
        "title": "科目舉人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "未見王竇，徒勞漫走。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 67
    },
    {
        "title": "戲杜審權语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "座主審權，門生处權。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 68
    },
    {
        "title": "崔沆放榜时人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "座主門生，沆瀣一家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 69
    },
    {
        "title": "唐末五代人语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "及第不必讀书，作官何須事业。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 70
    },
    {
        "title": "號沈宋语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "蘇李居前，沈宋比肩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 71
    },
    {
        "title": "號錢郎语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "前有沈宋，后有錢郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 72
    },
    {
        "title": "潘何诗賦语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "潘緯十年吟古鏡，何涓一夜賦瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 73
    },
    {
        "title": "魏薛草书语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "前有虞褚，后有薛魏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 74
    },
    {
        "title": "薛稷书语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "買褚得薛不落節。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 75
    },
    {
        "title": "时人為劉畢语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "劉郎中松樹孤標，畢庶子松根絕妙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 76
    },
    {
        "title": "时人為黃筌语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "黃筌画鶴，薛稷減價。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 77
    },
    {
        "title": "时人為楊惠之语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "道子画，惠之塑，奪得僧繇神筆路。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 78
    },
    {
        "title": "道傑语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "大頭傑，難殺人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 79
    },
    {
        "title": "馬周疏引俚语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "貧不學儉，富不學奢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 80
    },
    {
        "title": "杜甫引俚语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "城南韋杜，去天尺五。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 81
    },
    {
        "title": "《孫光憲瑣言》引古语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "乘船走馬，去死一分。",
            "好事不出門，惡事行千里。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 82
    },
    {
        "title": "杜重威引俚语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "逢賊得命，更望複子。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 83
    },
    {
        "title": "建安语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "龍門一半在閩川。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 84
    },
    {
        "title": "江陵语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "琵琶多於飯甑，措大多於鯽魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 85
    },
    {
        "title": "汾晉間语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "欲作千箱主，问取黃金母。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 86
    },
    {
        "title": "秦中兒童语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "顛當牢守門，蠮螉寇汝无处奔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 87
    },
    {
        "title": "滄洲语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "不戴金蓮花，不得到仙家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 88
    },
    {
        "title": "《段成式酉阳雜俎》引古语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "三守庚申三屍伏，七守庚申七尺滅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 89
    },
    {
        "title": "佛书引语",
        "author": "不詳",
        "biography": "",
        "paragraphs": [
            "停囚長智。",
            "赤腳人趁兔，著靴人吃肉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百七十六",
        "no#": 90
    }
]