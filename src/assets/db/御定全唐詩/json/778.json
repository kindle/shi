[
    {
        "title": "題季子廟",
        "author": "李季華",
        "biography": "",
        "paragraphs": [
            "季子讓社稷，又能聽國风。寧知千载后，蘋藻冷祠宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 1
    },
    {
        "title": "聽琴",
        "author": "王玄",
        "biography": "",
        "paragraphs": [
            "拂塵開按匣，何事独顰眉。古調俗不樂，正聲君自知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 2
    },
    {
        "title": "失鹭鶿",
        "author": "李归唐",
        "biography": "",
        "paragraphs": [
            "惜養來來歲月深，籠開不見意沈吟。",
            "也知只在秋江上，明月蘆花何处尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 3
    },
    {
        "title": "銅雀妓",
        "author": "朱光弼",
        "biography": "",
        "paragraphs": [
            "魏王銅雀妓，日暮管弦清。一見西陵樹，心悲舞不成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 4
    },
    {
        "title": "宮詞",
        "author": "朱光弼",
        "biography": "",
        "paragraphs": [
            "夢裏君王近，宮中河漢高。秋风能再熱，團扇不辭勞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 5
    },
    {
        "title": "惆悵诗九首",
        "author": "顧甄遠",
        "biography": "",
        "paragraphs": [
            "魂黯黯兮情脈脈，簾风清兮窗月白。",
            "夢驚枕上爐燼銷，不見蕊珠宮裏客。",
            "禁漏聲稀蟾魄冷，紗廚筠簟波光淨。",
            "独坐愁吟暗斷魂，滿窗风動芭蕉影。",
            "別恨離腸空惻惻，风動虛軒池水白。",
            "莫言靈圃步難尋，有心終效偷桃客。",
            "愁遇人間好风景，焦桐韵滿華堂靜。",
            "鑒鸞釵燕恨何窮，忍向銀床空抱影。",
            "綠槐影裏傍青樓，陌上行人空舉頭。",
            "煙水露花无处问，搖鞭凝睇不勝愁。",
            "役盡心神銷盡骨，恩情未斷忽分離。",
            "平生此恨无言处，只有衣襟淚得知。",
            "濃醪豔唱愁難破，骨瘦魂消病已成。",
            "若為多羅年少死，始甘人道有风情。",
            "淚滿羅衣酒滿卮，一聲歌斷怨傷離。",
            "如今两地心中事，直是瞿曇也不知。",
            "橫泥杯觴醉複醒，愁牽时有小诗成。",
            "早知惹得千般恨，悔不天生解薄情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 6
    },
    {
        "title": "登清居台",
        "author": "魏巒",
        "biography": "",
        "paragraphs": [
            "迤邐清居台，連延白雲外。側聆天上语，下視飛鳥背。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 7
    },
    {
        "title": "遊昌化精舍",
        "author": "柳明獻",
        "biography": "",
        "paragraphs": [
            "寶台侵漢遠，金地接霞高。何必遊天外，忻此契盧敖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 8
    },
    {
        "title": "善卷先生壇",
        "author": "蔡昆",
        "biography": "",
        "paragraphs": [
            "幾到壇邊登閣望，因思遺跡詠今朝。",
            "當时為有重華出，不是先生傲帝堯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 9
    },
    {
        "title": "句",
        "author": "蔡昆",
        "biography": "",
        "paragraphs": [
            "飄飄隨暮雨，颯颯落秋山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 10
    },
    {
        "title": "題鄜州相思鋪",
        "author": "令狐挺",
        "biography": "",
        "paragraphs": [
            "谁把相思號此河，塞垣車馬往來多。",
            "只應自古征人淚，灑向空川作逝波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 11
    },
    {
        "title": "鳳归雲二首",
        "author": "滕潛",
        "biography": "",
        "paragraphs": [
            "金井欄邊見羽仪，梧桐枝上宿寒枝。",
            "五陵公子怜文彩，画与佳人刺繡衣。",
            "飲啄蓬山最上頭，和煙飛下禁城秋。",
            "曾将弄玉归雲去，金翿斜開十二樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 12
    },
    {
        "title": "药圃",
        "author": "夏侯子雲",
        "biography": "",
        "paragraphs": [
            "綠葉紅英遍，仙經自討論。偶移岩畔菊，鋤斷白雲根。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 13
    },
    {
        "title": "讀孝經",
        "author": "方愚",
        "biography": "",
        "paragraphs": [
            "星彩滿天朝北极，源流是处赴東溟。",
            "為臣為子不忠孝，辜負宣尼一卷經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 14
    },
    {
        "title": "贈葛氏小娘子",
        "author": "潘雍",
        "biography": "",
        "paragraphs": [
            "曾闻仙子住天臺，欲結靈姻愧短才。",
            "若许隨君洞中住，不同劉阮卻归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 15
    },
    {
        "title": "送孫舍人归湘州",
        "author": "梁陟",
        "biography": "",
        "paragraphs": [
            "盛才傾世重，清論滿朝归。作隼他年计，為鴛此日飛。",
            "比肩移日近，抗首出郊畿。為報清漳水，分明照錦衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 16
    },
    {
        "title": "再登河阳城懷古",
        "author": "朱延",
        "biography": "",
        "paragraphs": [
            "客遊倦旅思，憩駕陟崇墉。元凱標奇跡，安仁擅美蹤。",
            "遠近濁河流，出沒青山峰。佇想空不极，懷古悵无從。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 17
    },
    {
        "title": "題瑩上人院",
        "author": "寇埴",
        "biography": "",
        "paragraphs": [
            "舍筏求香偈，因泉演妙音。是明捐俗網，何独在山林。",
            "繚繞藤軒密，逶迤竹徑深。為傳同學志，茲宇可清心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 18
    },
    {
        "title": "燕銜泥",
        "author": "馮渚",
        "biography": "",
        "paragraphs": [
            "雙燕碌碌飛入屋，屋中老人喜燕归，裴回繞我床頭飛。",
            "去年為爾逐黃雀，雨多屋漏泥土落。爾莫厭老翁茅屋低，",
            "井旁写水泥自足，銜泥上屋隨爾欲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十八",
        "no#": 19
    }
]