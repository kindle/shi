[
    {
        "title": "苦吟",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "莫話诗中事，诗中難更无。吟安一個字，撚斷数莖須。",
            "險覓天應悶，狂搜海亦枯。不同文賦易，為著者之乎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 1
    },
    {
        "title": "雪",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "瑞雪落紛華，隨风一向斜。地平鋪作月，天迥撒成花。",
            "客滿燒煙舍，牛牽賣炭車。吾皇憂挾纊，犹自问君家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 2
    },
    {
        "title": "松寺",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "山寺取涼當夏夜，共僧蹲坐石階前。两三條電欲為雨，",
            "通宵聽論蓮華義，不藉松窗一觉眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 3
    },
    {
        "title": "贈僧",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "浮世浮華一斷空，偶拋煩惱到蓮宮。高僧解语牙无水，",
            "禪師莫问求名苦，滋味過於食蓼蟲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 4
    },
    {
        "title": "逢友人赴闕",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "正當天下待雍熙，丹詔征來早為迟。倚馬才高犹愛藝，",
            "卻笑郡人留不得，感恩唯擬立生祠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 5
    },
    {
        "title": "哭李郢端公",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "军門半掩槐花宅，每過犹闻哭臨聲。北固暴亡兼在路，",
            "诗侶酒徒消散盡，一場春夢越王城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 6
    },
    {
        "title": "謝楊尚书惠櫻桃",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "滿合虛紅怕動搖，尚书知重賜櫻桃。揉藍尚帶新鮮葉，",
            "春來老病尤珍荷，並食中腸似火燒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 7
    },
    {
        "title": "寒食日戲贈李侍禦",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "十二街如市，紅塵咽不開。灑蹄驄馬汗，沒处看花來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 8
    },
    {
        "title": "樊川寒食二首",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "寒食權豪盡出行，一川如画雨初晴。",
            "谁家絡絡游春盛，擔入花間軋軋聲。",
            "鞍馬和花總是塵，歌聲处处有佳人。",
            "五陵年少粗於事，栲栳量金買斷春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 9
    },
    {
        "title": "句",
        "author": "盧延讓",
        "biography": "",
        "paragraphs": [
            "只訛些子緣，應耗沒多光。",
            "臂鷹健卒懸氊帽，騎馬佳人卷画衫。",
            "每過私第邀看鶴，長著公裳送上驢。",
            "名紙毛生五門下，家僮骨立六街中。",
            "雲間鬧鐸騾駝至，雪裏残骸虎拽來。",
            "樹上咨諏批頰鳥，窗間壁駁叩頭蟲。",
            "莫欺零落残牙齒，曾吃紅綾餅餤來。",
            "渡水蹇驢雙耳直，避风羸僕一肩高。",
            "高據襄阳播盛名，问人人道是诗星。（《吊孟浩然》，",
            "涼雨打低残菡萏，急风吹散小蜻蜓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 10
    },
    {
        "title": "示門生馬侍郎胤孫",
        "author": "裴皞",
        "biography": "",
        "paragraphs": [
            "宦途最重是文衡，天与愚夫著盛名。",
            "三主禮闈年八十，門生門下見門生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 11
    },
    {
        "title": "贈杜荀鶴",
        "author": "王希羽",
        "biography": "",
        "paragraphs": [
            "金榜曉懸生世日，玉书潛記上升时。",
            "九華山色高千尺，未必高於第八枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 12
    },
    {
        "title": "宮怨二首",
        "author": "柯崇",
        "biography": "",
        "paragraphs": [
            "塵滿金爐不炷香，黃昏独自立重廊。",
            "笙歌何处承恩寵，一一隨风入上阳。",
            "長門槐柳半蕭疏，玉輦沈思恨有餘。",
            "紅淚漸消傾國態，黃金谁為達相如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 13
    },
    {
        "title": "早春池亭独遊三首",
        "author": "劉象",
        "biography": "",
        "paragraphs": [
            "春意送残臘，春晴融小洲。蒲茸才簇岸，柳頰已遮樓。",
            "便有杯觴興，可據羈旅愁。鳧鷖亦相狎，盡日戲清流。",
            "清流環綠筱，清景媚虹橋。鶯刷初遷羽，莎拳擬拆苗。",
            "細沙擢暖岸，淑景動和飆。倍憶同袍侶，相歡倒一瓢。",
            "一瓢歡自足，一日興偏多。幽意人先賞，疏叢蝶未過。",
            "知音新句苦，窺沼醉顏酡。万慮從相擬，今朝欲奈何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 14
    },
    {
        "title": "鹭鷥",
        "author": "劉象",
        "biography": "",
        "paragraphs": [
            "潔白孤高生不同，頂絲清軟冷搖风。窺魚翹立荷香裏，",
            "摩霄志在潛修羽，會接鸞凰別葦叢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 15
    },
    {
        "title": "春夜二首",
        "author": "劉象",
        "biography": "",
        "paragraphs": [
            "幾处兵戈阻路岐，憶山心切与山違。",
            "时難何处披懷抱，日日日斜空醉归。",
            "一別杜陵归未期，只凭魂夢接親知。",
            "近來欲睡兼難睡，夜夜夜深闻子規。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 16
    },
    {
        "title": "曉登迎春閣",
        "author": "劉象",
        "biography": "",
        "paragraphs": [
            "未櫛凭欄眺錦城，煙籠万井二江明。",
            "香风滿閣花盈戶，樹樹樹梢啼曉鶯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 17
    },
    {
        "title": "詠仙掌",
        "author": "劉象",
        "biography": "",
        "paragraphs": [
            "万古亭亭倚碧霄，不成擎亦不成招。",
            "何如掬取天池水，灑向人間救旱苗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 18
    },
    {
        "title": "郪中感舊",
        "author": "劉象",
        "biography": "",
        "paragraphs": [
            "頃年曾住此中來，今日重遊事可哀。",
            "憶得幾家歡宴处，家家家业盡成灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 19
    },
    {
        "title": "白髭",
        "author": "劉象",
        "biography": "",
        "paragraphs": [
            "到处逢人求至药，幾回染了又成絲。",
            "素絲易染髭難染，墨翟當时合泣髭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 20
    },
    {
        "title": "題縣令范傳真化洽亭",
        "author": "沈顏",
        "biography": "",
        "paragraphs": [
            "前有淺山，屹然如屏。后有卑嶺，繚然如城。",
            "跨池左右，足以建亭。斯亭何名，化洽而成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 21
    },
    {
        "title": "书懷寄友人",
        "author": "沈顏",
        "biography": "",
        "paragraphs": [
            "江湖勞遍尋，只自長愁襟。到处慵開口，何人可話心。",
            "登樓得句遠，望月抒情深。卻憶山齋后，猿聲相伴吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 22
    },
    {
        "title": "題壁",
        "author": "楊凝式",
        "biography": "",
        "paragraphs": [
            "院似禪心靜，花如觉性圓。自然知了義，爭肯學神仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 23
    },
    {
        "title": "贈张全義",
        "author": "楊凝式",
        "biography": "",
        "paragraphs": [
            "洛阳风景實堪哀，昔日曾為瓦子堆。",
            "不是我公重葺理，至今犹是一堆灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 24
    },
    {
        "title": "題懷素酒狂帖后",
        "author": "楊凝式",
        "biography": "",
        "paragraphs": [
            "十年揮素學臨池，始识王公學衛非。",
            "草圣未須因酒發，筆端應解化龍飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 25
    },
    {
        "title": "句",
        "author": "楊凝式",
        "biography": "",
        "paragraphs": [
            "押引蝗蟲到洛京，合消郡守遠相迎。（归洛寄尹张從恩，",
            "到此今經三紀春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 26
    },
    {
        "title": "奉試詔用拓拔思恭為京北收復都統",
        "author": "李琪",
        "biography": "",
        "paragraphs": [
            "飛騎經巴棧，鴻恩及夏台。将從天上去，人自日邊來。",
            "此处金門遠，何时玉輦回。早平關右賊，莫待詔书催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 27
    },
    {
        "title": "題廣愛寺楞伽山",
        "author": "李琪",
        "biography": "",
        "paragraphs": [
            "善高天外遠，方丈海中遙。自有山神護，應无劫火燒。",
            "壞文侵古壁，飛劍出寒霄。何似蒼蒼色，嚴妝十七朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 28
    },
    {
        "title": "句",
        "author": "李琪",
        "biography": "",
        "paragraphs": [
            "哀痛不下詔，登封谁上书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 29
    },
    {
        "title": "寄桂帥",
        "author": "劉崇龜",
        "biography": "",
        "paragraphs": [
            "碧幢仁施合洪鈞，桂樹林前倍得春。",
            "莫戀此时好风景，磻溪不是釣漁人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 30
    },
    {
        "title": "席上吟",
        "author": "劉崇魯",
        "biography": "",
        "paragraphs": [
            "南行忽見李深之，手舞如蜚令不疑。",
            "任有风流兼蘊藉，天生不似鄭都知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 31
    },
    {
        "title": "寄孫儲",
        "author": "孫定",
        "biography": "",
        "paragraphs": [
            "行行血淚灑塵襟，事逐東流渭水深。秋跨蹇驢风尚緊，",
            "明月悲歌又前去，滿城煙樹噪春禽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 32
    },
    {
        "title": "江南行",
        "author": "许晝",
        "biography": "",
        "paragraphs": [
            "江南蕭灑地，本自与君宜。固節還同我，虛心欲待谁。",
            "澗泉傍借響，山木共含滋。粉膩蟲難篆，叢疏鳥易窺。",
            "盡應逢野渡，中忽見村祠。葉掃秋空靜，根橫古塹危。",
            "影迷寒靄裏，聲出夜风时。客棹深深過，人家遠遠移。",
            "游邊曾結念，到此数題诗。莫恨成龍晚，成龍會有期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 33
    },
    {
        "title": "中秋月",
        "author": "许晝",
        "biography": "",
        "paragraphs": [
            "應是蟾宮別有情，每逢秋半倍澄清。清光不向此中見，",
            "殷勤好長來年桂，莫遣平人道不平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 34
    },
    {
        "title": "臨終诗",
        "author": "薛准",
        "biography": "",
        "paragraphs": [
            "舊國深恩不易酬，又離繼母出他州。",
            "谁知天怒无因息，積愧終身乞速休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 35
    },
    {
        "title": "觀修处士画桃花图歌",
        "author": "裴諧",
        "biography": "",
        "paragraphs": [
            "一從天寶王維死，於今始遇修夫子。能向鮫綃四幅中，",
            "堪怜彩筆似東风，一朵一枝隨手發。燕支乍濕如含露，",
            "工夫妙麗實奇絕，似对韶光好时節。偏宜留著待深冬，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 36
    },
    {
        "title": "句",
        "author": "裴諧",
        "biography": "",
        "paragraphs": [
            "风回山火斷，朝落岸冰高。",
            "名終埋不得，骨任朽何妨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十五",
        "no#": 37
    }
]