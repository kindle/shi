[
    {
        "title": "燕子樓三首",
        "author": "關盼盼",
        "biography": "",
        "paragraphs": [
            "樓上残燈伴曉霜，独眠人起合歡床。",
            "相思一夜情多少，地角天涯不是長。",
            "北邙松柏鎖愁煙，燕子樓中思悄然。",
            "自埋劍履歌塵散，紅袖香銷一十年。",
            "適看鴻雁岳阳回，又睹玄禽逼社來。",
            "瑤瑟玉簫无意緒，任從蛛網任從灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 1
    },
    {
        "title": "和白公诗",
        "author": "關盼盼",
        "biography": "",
        "paragraphs": [
            "自守空樓斂恨眉，形同春后牡丹枝。",
            "舍人不會人深意，訝道泉台不去隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 2
    },
    {
        "title": "句",
        "author": "關盼盼",
        "biography": "",
        "paragraphs": [
            "兒童不识沖天物，漫把青泥汙雪毫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 3
    },
    {
        "title": "囉嗊曲六首",
        "author": "劉采春",
        "biography": "",
        "paragraphs": [
            "不喜秦淮水，生憎江上船。载兒夫婿去，經歲又經年。",
            "借问東園柳，枯來得幾年。自无枝葉分，莫恐太阳偏。",
            "莫作商人婦，金釵當卜錢。朝朝江口望，錯認幾人船。",
            "那年離別日，只道住桐廬。桐廬人不見，今得廣州书。",
            "昨日勝今日，今年老去年。黃河清有日，白發黑无緣。",
            "昨日北风寒，牽船浦里安。潮來打纜斷，搖櫓始知難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 4
    },
    {
        "title": "寄歐阳詹",
        "author": "太原妓",
        "biography": "",
        "paragraphs": [
            "自從別后減容光，半是思郎半恨郎。",
            "欲识舊來雲髻樣，為奴開取縷金箱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 5
    },
    {
        "title": "续韋蟾句",
        "author": "武昌妓",
        "biography": "",
        "paragraphs": [
            "悲莫悲兮生別離，登山臨水送将归。",
            "武昌无限新栽柳，不見楊花撲面飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 6
    },
    {
        "title": "獻李觀察",
        "author": "舞柘枝女",
        "biography": "",
        "paragraphs": [
            "湘江舞罷忽成悲，便脫蠻靴出絳帷。",
            "谁是蔡邕琴酒客，魏公懷舊嫁文姬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 7
    },
    {
        "title": "贈盧夫人",
        "author": "常浩",
        "biography": "",
        "paragraphs": [
            "佳人惜顏色，恐逐芳菲歇。日暮出画堂，下階拜新月。",
            "拜月如有詞，傍人那得知。归來投玉枕，始觉淚痕垂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 8
    },
    {
        "title": "寄遠",
        "author": "常浩",
        "biography": "",
        "paragraphs": [
            "年年二月时，十年期別期。春风不知信，軒蓋独迟迟。",
            "今日无端卷珠箔，始見庭花複零落。人心一往不復归，",
            "卻念容華非昔好，画眉犹自待君來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 9
    },
    {
        "title": "送武補闕",
        "author": "襄阳妓",
        "biography": "",
        "paragraphs": [
            "弄珠灘上欲銷魂，独把離懷寄酒尊。",
            "无限煙花不留意，忍教芳草怨王孫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 10
    },
    {
        "title": "題孫棨诗后",
        "author": "王福娘",
        "biography": "",
        "paragraphs": [
            "苦把文章邀勸人，吟看好個语言新。",
            "雖然不及相如賦，也直黃金一二斤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 11
    },
    {
        "title": "问棨诗",
        "author": "王福娘",
        "biography": "",
        "paragraphs": [
            "日日悲傷未有图，懶将心事話凡夫。",
            "非同覆水應收得，只问仙郎有意无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 12
    },
    {
        "title": "謝棨",
        "author": "王福娘",
        "biography": "",
        "paragraphs": [
            "久賦恩情欲托身，已将心事再三陳。",
            "泥蓮既沒移栽分，今日分離莫恨人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 13
    },
    {
        "title": "答小子弟诗",
        "author": "楊萊兒",
        "biography": "",
        "paragraphs": [
            "黃口小兒口莫凭，逡巡看取第三名。",
            "孝廉持水添瓶子，莫向街頭乱碗鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 14
    },
    {
        "title": "和趙光遠題壁",
        "author": "楊萊兒",
        "biography": "",
        "paragraphs": [
            "長者車塵每到門，長卿非慕卓王孫。定知羽翼難隨鳳，",
            "多情多病年應促，早辦名香為返魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 15
    },
    {
        "title": "貽鄭昌图",
        "author": "楚兒",
        "biography": "",
        "paragraphs": [
            "應是前生有宿冤，不期今世惡因緣。蛾眉欲碎巨靈掌，",
            "曲江昨日君相遇，當下遭他数十鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 16
    },
    {
        "title": "和李標",
        "author": "王蘇蘇",
        "biography": "",
        "paragraphs": [
            "怪得犬驚雞乱飛，羸童瘦馬老麻衣。",
            "阿谁乱引闲人到，留住青蚨熱趕归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 17
    },
    {
        "title": "臨終召客",
        "author": "顏令賓",
        "biography": "",
        "paragraphs": [
            "气餘三五喘，花剩两三枝。話別一尊酒，相邀无后期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 18
    },
    {
        "title": "寄故人",
        "author": "张窈窕",
        "biography": "",
        "paragraphs": [
            "淡淡春风花落时，不堪愁望更相思。",
            "无金可買長門賦，有恨空吟團扇诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 19
    },
    {
        "title": "上成都在事",
        "author": "张窈窕",
        "biography": "",
        "paragraphs": [
            "昨日賣衣裳，今日賣衣裳。衣裳渾賣盡，羞見嫁时箱。",
            "有賣愁仍緩，无时心轉傷。故園有虜隔，何处事蠶桑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 20
    },
    {
        "title": "春思二首",
        "author": "张窈窕",
        "biography": "",
        "paragraphs": [
            "門前梅柳爛春輝，閉妾深閨繡舞衣。",
            "雙燕不知腸欲斷，銜泥故故傍人飛。",
            "井上梧桐是妾移，夜來花發最高枝。",
            "若教不向深閨種，春過門前爭得知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 21
    },
    {
        "title": "西江行",
        "author": "张窈窕",
        "biography": "",
        "paragraphs": [
            "日下西塞山，南來洞庭客。晴空白鳥度，万里秋光碧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 22
    },
    {
        "title": "贈所思",
        "author": "张窈窕",
        "biography": "",
        "paragraphs": [
            "与君咫尺長離別，遣妾容華為谁说。",
            "夕望層城眼欲穿，曉臨明鏡腸堪絕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 23
    },
    {
        "title": "句",
        "author": "张窈窕",
        "biography": "",
        "paragraphs": [
            "滿院花飛人不到，含情欲语燕雙雙。（《春情》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 24
    },
    {
        "title": "贈裴思謙",
        "author": "平康妓",
        "biography": "",
        "paragraphs": [
            "銀釭斜背解明璫，小语偷聲賀玉郎。",
            "從此不知蘭麝貴，夜來新惹桂枝香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 25
    },
    {
        "title": "迷香洞",
        "author": "史鳳",
        "biography": "",
        "paragraphs": [
            "洞口飛瓊佩羽霓，香风飄拂使人迷。",
            "自從邂逅芙蓉帳，不数桃花流水溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 26
    },
    {
        "title": "神雞枕",
        "author": "史鳳",
        "biography": "",
        "paragraphs": [
            "枕繪鴛鴦久与棲，新裁霧縠鬥神雞。",
            "与郎酣夢渾忘曉，雞亦留連不肯啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 27
    },
    {
        "title": "鎖蓮燈",
        "author": "史鳳",
        "biography": "",
        "paragraphs": [
            "燈鎖蓮花花照罍，翠鈿同醉楚台巍。",
            "残灰剔罷攜纖手，也勝金蓮送轍回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 28
    },
    {
        "title": "鮫紅被",
        "author": "史鳳",
        "biography": "",
        "paragraphs": [
            "肱被當年僅禦寒，青樓慣染血猩紈。",
            "牙床舒卷鵷鸞共，正值窗櫺月一團。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 29
    },
    {
        "title": "傳香枕",
        "author": "史鳳",
        "biography": "",
        "paragraphs": [
            "韓壽香從何处傳，枕邊芳馥戀嬋娟。",
            "休疑粉黛加鋌刃，玉女旃檀侍佛前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 30
    },
    {
        "title": "八分羊",
        "author": "史鳳",
        "biography": "",
        "paragraphs": [
            "黨家风味足肥羊，綺閣留人漫較量。",
            "万羊亦是男兒事，莫學狂夫取次嘗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 31
    },
    {
        "title": "閉門羹",
        "author": "史鳳",
        "biography": "",
        "paragraphs": [
            "一豆聊供游冶郎，去时忙喚鎖倉琅。",
            "入門独慕相如侶，欲撥瑤琴彈鳳凰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 32
    },
    {
        "title": "突厥三台",
        "author": "盛小叢",
        "biography": "",
        "paragraphs": [
            "雁門山上雁初飛，馬邑闌中馬正肥。",
            "日旰山西逢驛使，殷勤南北送征衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 33
    },
    {
        "title": "雲鬟",
        "author": "趙鸞鸞",
        "biography": "",
        "paragraphs": [
            "擾擾香雲濕未幹，鴉領蟬翼膩光寒。",
            "側邊斜插黃金鳳，妝罷夫君帶笑看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 34
    },
    {
        "title": "柳眉",
        "author": "趙鸞鸞",
        "biography": "",
        "paragraphs": [
            "彎彎柳葉愁邊戲，湛湛菱花照处频。",
            "嫵媚不煩螺子黛，春山画出自精神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 35
    },
    {
        "title": "檀口",
        "author": "趙鸞鸞",
        "biography": "",
        "paragraphs": [
            "銜杯微動櫻桃顆，咳唾輕飄茉莉香。",
            "曾見白家樊素口，瓠犀顆顆綴榴芳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 36
    },
    {
        "title": "纖指",
        "author": "趙鸞鸞",
        "biography": "",
        "paragraphs": [
            "纖纖軟玉削春蔥，長在香羅翠袖中。",
            "昨日琵琶弦索上，分明滿甲染猩紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 37
    },
    {
        "title": "酥乳",
        "author": "趙鸞鸞",
        "biography": "",
        "paragraphs": [
            "粉香汗濕瑤琴軫，春逗酥融綿雨膏。",
            "浴罷檀郎捫弄处，靈華涼沁紫葡萄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 38
    },
    {
        "title": "獻陳陶处士",
        "author": "蓮花妓",
        "biography": "",
        "paragraphs": [
            "蓮花為號玉為腮，珍重尚书遣妾來。",
            "处士不生巫峽夢，虛勞神女下阳臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 39
    },
    {
        "title": "敘懷",
        "author": "徐月英",
        "biography": "",
        "paragraphs": [
            "為失三從泣淚频，此身何用处人倫。",
            "雖然日逐笙歌樂，長羨荊釵与布裙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 40
    },
    {
        "title": "送人",
        "author": "徐月英",
        "biography": "",
        "paragraphs": [
            "惆悵人間万事違，两人同去一人归。",
            "生憎平望亭前水，忍照鴛鴦相背飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 41
    },
    {
        "title": "句",
        "author": "徐月英",
        "biography": "",
        "paragraphs": [
            "枕前淚与階前雨，隔個窗兒滴到明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 42
    },
    {
        "title": "句",
        "author": "韓襄客",
        "biography": "",
        "paragraphs": [
            "連理枝前同設誓，丁香樹下共論心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零二",
        "no#": 43
    }
]