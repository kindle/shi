[
    {
        "title": "留辭杭州姚合郎中",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "波濤千里隔，抱疾亦相尋。會宿逢高士，辭归值積霖。",
            "叢桑山店迥，孤燭海船深。尚有重來約，知无省閣心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 1
    },
    {
        "title": "酬吳之问見贈",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "已當鳴雁夜，多事不同居。故疾離城晚，秋霖見月疏。",
            "趁风開靜戶，帶葉卷残书。蕩槳期南去，荒園久廢鋤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 2
    },
    {
        "title": "送分定归靈夏",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "南遊多老病，見说講經稀。塞寺幾僧在，關城空自归。",
            "帶河衰草斷，映日旱沙飛。卻到禪齋後，邊军识衲衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 3
    },
    {
        "title": "与崔弇話別",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "归思緣平澤，幽齋夜話迟。人尋馮翊去，草向建康衰。",
            "雨雪生中路，干戈阻後期。幾年方見面，應是鑷蒼髭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 4
    },
    {
        "title": "題何氏池亭",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "信是虛閑地，亭高亦有苔。繞池逢石坐，穿竹引山回。",
            "果落纖萍散，龜行細草開。主人偏好事，終不厭频來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 5
    },
    {
        "title": "送表兄東南游",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "山水疊層層，吾兄涉又登。掛帆春背雁，尋磬夜逢僧。",
            "雪溜懸衡岳，江雲蓋秣陵。評文永不忘，此说是中興。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 6
    },
    {
        "title": "送康紹归建业",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "南朝秋色滿，君去意如何。帝业空城在，民田壞塚多。",
            "月圓臺独上，栗綻寺频過。籬下西江闊，相思見白波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 7
    },
    {
        "title": "再過王輅原居納涼",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "夏天多憶此，早晚得秋分。舊月來還見，新蟬坐忽闻。",
            "扇风調病葉，溝水隔残雲。別有微涼處，從容不似君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 8
    },
    {
        "title": "送耿山人归湖南",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "南行隨越僧，別业幾池菱。两鬢已垂白，五湖归掛罾。",
            "夜濤鳴柵鎖，寒葦露船燈。去此應无事，卻來知不能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 9
    },
    {
        "title": "送省己上人归太原",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "惜別聽邊漏，窗燈落燼重。寒僧回絕塞，夕雪下窮冬。",
            "出定闻残角，休兵見壞鋒。何年更來此，老卻倚階松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 10
    },
    {
        "title": "宿甄山南溪晝公院",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "從作两河客，別離經半年。卻來峰頂宿，知廢甄南禪。",
            "餘霧沉斜月，孤燈照落泉。何當闲事盡，相伴老溪邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 11
    },
    {
        "title": "相次尋舉客寄住人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "停橈因舊识，白发向波濤。以我往來倦，知君耕稼勞。",
            "渚田臨舍盡，阪路出簷高。游者還南去，終期伴爾曹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 12
    },
    {
        "title": "出關寄賈島",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "舊鄉无子孫，谁共老青門。迢遞早秋路，別離深夜村。",
            "伊流偕行客，嶽響答啼猿。去後期招隱，何當複此言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 13
    },
    {
        "title": "暮冬長安旅舍",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "湖外谁相识，思归日日频。遍尋新住客，少見故鄉人。",
            "失计空知命，勞生恥為身。惟看洞庭樹，即是舊山春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 14
    },
    {
        "title": "贈胡僧",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "瘦形无血色，草屨著行穿。闲話似持咒，不眠同坐禪。",
            "背經來漢地，袒膊過冬天。情性人難會，游方應信緣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 15
    },
    {
        "title": "贈李主簿",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "稅时兼主印，每日得闲稀。對酒妨料吏，為官亦典衣。",
            "案迟吟坐待，宅近步行归。見说論诗道，應愁判是非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 16
    },
    {
        "title": "同朱慶餘宿翊西上人房",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "溪僧還共謁，相与坐寒天。屋雪淩高燭，山茶稱遠泉。",
            "夜清更徹寺，空闊雁沖煙。莫怪多时話，重來又來年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 17
    },
    {
        "title": "寄姚合郎中",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "轉刺名山郡，連年別省曹。分題得客少，著價買书高。",
            "晚柳蟬和角，寒城燭照濤。鄱溪臥疾久，未獲後乘騷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 18
    },
    {
        "title": "休糧僧",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "一齋難過日，況是更休糧。養力时行道，闻鐘不上堂。",
            "唯留溫药火，未写化金方。舊有山廚在，從僧請作房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 19
    },
    {
        "title": "懷西峰隱者",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "灌木藏岑色，天寒望即愁。高齋何日去，遠瀑入城流。",
            "臘近溪书絕，燈残夜雪稠。邇來相憶處，枕上苦吟休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 20
    },
    {
        "title": "贈柏岩禪師",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "野寺絕依念，靈山會遍行。老來披衲重，病後讀經生。",
            "乞食嫌村遠，尋溪愛路平。多年柏岩住，不記柏岩名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 21
    },
    {
        "title": "旅懷",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "不覺月又盡，未归還到春。雪通廬嶽夢，樹匝草堂身。",
            "澤雁和寒露，江槎帶遠薪。何年自此去，舊國複為鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 22
    },
    {
        "title": "緱氏韋明府廳",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "貴邑清风滿，谁同上宰心。杉松出郭外，雨電下嵩阴。",
            "度雁方離壘，來僧始別岑。西池月才迥，會接一宵吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 23
    },
    {
        "title": "送朱慶餘",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "野客行无定，全家在浦東。寄眠僧閣靜，贈別橐金空。",
            "舊裏千山隔，归舟百计同。药資如有分，相約老吳中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 24
    },
    {
        "title": "宿開元寺樓",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "西峰残日落，谁見寂寥心。孤枕客眠久，两廊僧話深。",
            "寒扉關雨氣，风葉隱鐘音。此愛東樓望，仍期別夜尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 25
    },
    {
        "title": "送僧還南嶽",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "辭僧下水柵，因夢嶽鐘聲。遠路独归寺，幾时重到城。",
            "风高寒葉落，雨絕夜堂清。自说深居後，鄰州亦不行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 26
    },
    {
        "title": "秋思",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "楊柳已秋思，楚田仍刈禾。归心病起切，敗葉夜來多。",
            "細雨城蟬噪，残阳嶠客過。舊山餘业在，杳隔洞庭波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 27
    },
    {
        "title": "旅情",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "黃葉下階频，徐徐起病身。残秋螢出盡，独夜雁來新。",
            "別业去千里，舊鄉空四鄰。孤舟尋幾度，又识岳阳人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 28
    },
    {
        "title": "送靈應禪師",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "寒天仍遠去，離寺雪霏霏。古跡曾重到，生涯不暫归。",
            "坐禪山店暝，補衲夜燈微。巡禮何时住，相逢的是稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 29
    },
    {
        "title": "送陸判官防秋",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "匹馬无窮地，三年逐大军。算程淮邑遠，起帳夕阳曛。",
            "瀑浪行时漱，邊笳语次闻。要傳书劄去，應到磧東雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 30
    },
    {
        "title": "山居秋思",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "一從雲水住，曾不下西岑。落木孤猿在，秋庭積霧深。",
            "泉流通井脈，蟲響出牆阴。夜靜溪聲徹，寒燈尚独吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 31
    },
    {
        "title": "贈皎然上人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "竹庭瓶水新，深稱北窗人。講罷見黃葉，诗成尋舊鄰。",
            "錫阴迷坐石，池影露齋身。苦作南行約，勞生始问津。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 32
    },
    {
        "title": "春日山居寄友人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "春居无俗喧，时立澗前村。路遠少來客，山深多過猿。",
            "帶岩松色老，臨水杏花繁。除憶文流外，何人更可言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 33
    },
    {
        "title": "留別南徐故人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "三年蒙見待，此夕是前程。未斷卻來約，且伸臨去情。",
            "潮回灘鳥下，月上客船明。他日南徐道，緣君又重行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 34
    },
    {
        "title": "送僧归江南",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "洗足北林去，遠途今已分。麻衣行嶽色，竹杖帶湘雲。",
            "饑鼠緣危壁，寒狸出壞墳。前峰一聲磬，此夕不同闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 35
    },
    {
        "title": "早春越中留故人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "此行經歲近，唯約半年回。野渡人初過，前山雲未開。",
            "雁群逢曉斷，林色映川來。清夜蘆中客，嚴家舊釣台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 36
    },
    {
        "title": "送友人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "彈琴多去情，浮楫背潮行。人望豐壖宿，蟲依蠹木鳴。",
            "檣煙離浦色，蘆雨入船聲。如疾登雲路，凭君寄此生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 37
    },
    {
        "title": "春日重到王依村居",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "野煙居舍在，曾約此重過。久雨初招客，新田未種禾。",
            "夜蟲鳴井浪，春鳥宿庭柯。莫為兒孫役，餘生能幾何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 38
    },
    {
        "title": "入靜隱寺途中作",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "乱雲迷遠寺，入路認青松。鳥道緣巢影，僧鞋印雪蹤。",
            "草煙連野燒，溪霧隔霜鐘。更遇樵人问，犹言過數峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 39
    },
    {
        "title": "送楊岳归巴陵",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "何處得鄉信，告行當雨天。人離京口日，潮送岳阳船。",
            "孤鳥背林色，遠帆開浦煙。悲君唯此別，不肯話回年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 40
    },
    {
        "title": "贈朱慶餘校书",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "风泉盡結冰，寒夢徹西陵。越信楚城得，遠懷中夜興。",
            "樹停沙島鶴，茶會石橋僧。寺閣邊官舍，行吟過幾層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 41
    },
    {
        "title": "逢播公",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "帶病希相見，西城早晚來。衲衣风壞帛，香印雨沾灰。",
            "坐久鐘聲盡，談餘嶽影回。卻思同宿夜，高枕说天臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 42
    },
    {
        "title": "尋北岡韓處士",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "相過值早涼，松帚掃山床。坐石泉痕黑，登城蘚色黃。",
            "逆风沈寺磬，初日曬鄰桑。幾處逢僧说，期來宿北岡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 43
    },
    {
        "title": "哭閑霄上人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "林徑西风急，松枝講鈔餘。凍髭亡夜剃，遺偈病时书。",
            "地燥焚身後，堂空著影初。吊來频落淚，曾憶到吾廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 44
    },
    {
        "title": "城中秋作",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "已落關東葉，空懸浙右心。寒燈隨故病，伏雨接秋霖。",
            "客話曾谁和，蟲聲少我吟。蒹葭半波水，夜夜宿邊禽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 45
    },
    {
        "title": "玉芝觀王道士",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "四面杉蘿合，空堂画老仙。蠹根停雪水，曲角積茶煙。",
            "道至心極盡，宵晴瑟韵全。暫來還又去，未得坐經年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 46
    },
    {
        "title": "出關後寄賈島",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "故國知何處，西风已度關。归人值落葉，遠路入寒山。",
            "多難喜相识，久貧寧自閑。唯将往來信，遙慰別離顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 47
    },
    {
        "title": "題晝公院",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "叢木開风徑，過從白晝寒。舍深原草合，茶疾竹薪幹。",
            "夕雨生眠興，禪心少話端。频來覺无事，盡日坐相看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 48
    },
    {
        "title": "京口贈崔固",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "積雨晴时近，西风葉滿泉。相逢嵩嶽客，共聽楚城蟬。",
            "宿館橫秋島，归帆漲遠田。別多還寂寞，不似剡中年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 49
    },
    {
        "title": "书實上人房",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "絕頂言无伴，長懷剃發師。禪中燈落燼，講次柏生枝。",
            "沙井泉澄疾，秋鐘韵盡迟。裏閭還受請，空有向南期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 50
    },
    {
        "title": "送张諲之睦州",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "遙憶新安舊，扁舟往復還。淺深看水石，來往逐雲山。",
            "到縣餘花在，過門五柳閑。東征隨子去，俱隱薜蘿間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 51
    },
    {
        "title": "贈王道士",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "药力資蒼鬢，應非舊日身。一為嵩嶽客，幾葬洛阳人。",
            "石縫瓢探水，雲根斧斫薪。關西來往路，谁得水銀銀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 52
    },
    {
        "title": "冬日山居思鄉",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "大野始嚴凝，雲天曉色澄。樹寒稀宿鳥，山迥少來僧。",
            "背日收窗雪，開爐釋硯冰。忽然归故國，孤想寓西陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 53
    },
    {
        "title": "如空上人移居大雲寺",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "竹溪人請住，何日向中峰。瓦舍山情少，齋身疾色濃。",
            "夏高移坐次，菊淺露行蹤。來往湓城下，三年两度逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 54
    },
    {
        "title": "送幻群法師",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "北京一別後，吳楚幾聽砧。住久白发出，講長枯葉深。",
            "香連鄰舍像，磬徹遠巢禽。寂默應關道，何人見此心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 55
    },
    {
        "title": "春喜友人至山舍",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "鳥鳴春日曉，喜見竹門開。路自高岩出，人騎大馬來。",
            "折花林影斷，移石洞阴回。更欲留深语，重城暮色催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 56
    },
    {
        "title": "春日重至南徐舊居",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "綠水阴空院，春深喜再來。独眠從草長，留酒看花開。",
            "過雨還山出，向风孤鳥回。忽思秋夕事，雲物卻悠哉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 57
    },
    {
        "title": "早秋過郭涯书堂",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "暑消岡舍清，閑语有餘情。澗水生茶味，松风滅扇聲。",
            "遠分臨海雨，靜覺掩山城。此地秋吟苦，时來繞菊行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 58
    },
    {
        "title": "長安送人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "上國多離別，年年渭水濱。空将未归意，说向欲行人。",
            "雁度池塘月，山連井邑春。臨岐惜分手，日暮一沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 59
    },
    {
        "title": "寄甯海李明府",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "山縣风光異，公門水石清。一官居外府，幾载別東京。",
            "故疾梅天發，新诗雪夜成。家貧思減選，时靜憶归耕。",
            "把疏尋书義，澄心得獄情。夢靈邀客解，劍古揀人呈。",
            "守月通宵坐，尋花迥路行。從來愛知道，何慮白髭生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 60
    },
    {
        "title": "投江州张郎中",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "要地无閑日，仍容冒謁频。借山年涉閏，寢郡月逾旬。",
            "驛徑曾沖雪，方泉省滌塵。隨行溪路細，接話草堂新。",
            "減药痊餘癖，飛书苦问貧。噪蟬離宿殼，吟客寄秋身。",
            "煉句貽箱篋，懸圖見蜀岷。使君匡嶽近，終作社中人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 61
    },
    {
        "title": "晚題江館",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "病寄曲江居帶城，傍門孤柳一蟬鳴。澄波月上見魚擲，",
            "故園盡賣休官去，潮水秋來空自平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 62
    },
    {
        "title": "秋晚归廬山留別道友",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "病起陵阳思翠微，秋风動後著行衣。月生石齒人同見，",
            "不嫌舊隱相隨去，廬嶽臨天好息机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 63
    },
    {
        "title": "同徐處士秋懷少室舊居",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "曾居少室黃河畔，秋夢長懸未得回。扶病半年離水石，",
            "燈下此心谁共说，傍松幽徑已多栽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 64
    },
    {
        "title": "贈神遘上人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "草履蒲團山意存，坐看庭木長桐孫。行齋罷講仍香氣，",
            "道情淡薄闲愁盡，霜色何因入鬢根。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 65
    },
    {
        "title": "贈道人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "布褐高眠石竇春，迸泉多濺黑紗巾。搖頭说易當朝客，",
            "擬归太華何时去，他日相尋乞药銀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 66
    },
    {
        "title": "贈厲玄侍禦",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "山松徑与瀑泉通，巾舄行吟想越中。塞雁去經華頂末，",
            "抱疾因尋周柱史，杜陵寒葉落无窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 67
    },
    {
        "title": "送韓評事",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "門枕平湖秋景好，水煙松色遠相依。罷官餘俸租田種，",
            "嵩阳舊隱多时別，閉目閑吟憶翠微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 68
    },
    {
        "title": "宿隱靜寺上人",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "一宿五峰杯度寺，虛廊中夜磬聲分。疏林未落上方月，",
            "暫來此地歇勞足，望斷故山滄海濆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 69
    },
    {
        "title": "寄新頭陀",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "見说北京尋祖後，瓶盂自挈繞窮邊。相逢竹塢晦暝夜，",
            "青城不得師同住，坐想滄江憶浩然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 70
    },
    {
        "title": "湘漢旅懷翁傑",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "一宿空江聽急流，仍同賈客坐归舟。遠书來隔巴陵雨，",
            "吾宗尚作无憀者，中夜閑吟生旅愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 71
    },
    {
        "title": "寄韓司兵",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "多病十年无舊识，滄州乱後只逢君。已知罷秩辭瀧水，",
            "若為此別終期老，书劄何因寄北军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 72
    },
    {
        "title": "寺居寄楊侍禦",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "雨過北林空晚涼，院闲人去掩斜阳。十年多病度落葉，",
            "還知謝客名先重，肯為诗篇问楚狂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 73
    },
    {
        "title": "上陝府姚中丞",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "此心長愛狎禽魚，仍候登封独著书。領郡只嫌生药少，",
            "見说養真求退靜，溪南泉石许同居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 74
    },
    {
        "title": "贈僧",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "藩府十年為律业，南朝本寺往來新。辭归幾別深山客，",
            "他年更息登壇计，應与雲泉作四鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 75
    },
    {
        "title": "送石協律归吳",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "僧窗夢後憶归耕，水涉應多半月程。幕府罷來无药價，",
            "已讓辟书稱抱疾，滄洲便许白髭生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 76
    },
    {
        "title": "寄金陵僧",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "水石致身閑自得，平雲竹閣少炎蒸。齋床幾減供禽食，",
            "行登總到諸山寺，坐聽蟬聲滿四棱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 77
    },
    {
        "title": "送忍禪師归廬岳",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "浪匝湓城嶽壁青，白頭僧去掃禪扃。龕燈度雪補残衲，",
            "已知身事非吾道，甘臥荒齋竹滿庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 78
    },
    {
        "title": "贈姚合郎中",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "望重來為守土臣，清高還似武功貧。道從會解唯求靜，",
            "两衙向後長无事，門館多逢請益人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 79
    },
    {
        "title": "宿李主簿",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "独樹倚亭新月入，城牆四面鎖山多。",
            "去年今夜還來此，坐見西风嫋鵲窠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 80
    },
    {
        "title": "寄潘緯",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "楊柳垂絲与地連，归來一醉向溪邊。",
            "相逢頭白莫惆悵，世上无人長少年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 81
    },
    {
        "title": "潯阳与孫郎中宴回",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "別酒已酣春漏前，他人扶上北归船。",
            "潯阳渡口月未上，漁火照江仍独眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 82
    },
    {
        "title": "送宗禪師",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "衡阳到卻十三春，行腳同來有幾人。",
            "老大又思归嶽裏，當时來漆祖師身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 83
    },
    {
        "title": "送僧",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "草履初登南客船，銅瓶犹貯北山泉。",
            "衡阳舊寺秋归去，門鎖寒潭幾樹蟬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 84
    },
    {
        "title": "送蜀僧",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "万里独行无弟子，惟齎筇竹与檀龕。",
            "看經更向吳中老，應是山川似劍南。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 85
    },
    {
        "title": "過僧竹院",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "一生愛竹自未有，每到此房归不能。",
            "高人留宿話禪後，寂寞雨堂空夜燈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 86
    },
    {
        "title": "憶潯阳舊居兼感長孫郎中",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "潯阳卻到是何日，此地今无舊使君。",
            "長憶窮冬宿廬嶽，瀑泉冰折共僧闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 87
    },
    {
        "title": "送郭秀才归金陵",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "夏後客堂黃葉多，又懷家國起悲歌。酒前欲別语難盡，",
            "南徐舊业幾时到，門掩残阳積翠蘿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 88
    },
    {
        "title": "宿李樞书齋",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "小齋經暮雨，四面絕纖埃。眠客闻风覺，飛蟲入燭來。",
            "夜涼书讀遍，月正戶全開。住遠稀相見，留連宿始回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 89
    },
    {
        "title": "杪秋登江樓",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "平楚起寒色，長沙犹未還。世情何處淡，湘水向人閑。",
            "空翠隱高鳥，夕阳归遠山。孤雲万餘裏，惆悵洞庭間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 90
    },
    {
        "title": "秋宿洞庭",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "洞庭初葉下，旅客不勝愁。明月天涯夜，青山江上秋。",
            "一官成白首，万里寄滄洲。只被浮名系，甯无愧海鸥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 91
    },
    {
        "title": "重阳",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "雲木疏黃秋滿川，茱萸风裏一樽前。幾回為客逢佳節，",
            "古來醉樂皆難得，留取窮通委上天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 92
    },
    {
        "title": "送李億東归",
        "author": "周賀",
        "biography": "",
        "paragraphs": [
            "黃山遠隔秦樹，紫禁斜通渭城。別路青青柳發，",
            "灞上金樽未飲，宴歌已有餘聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零三",
        "no#": 93
