[
    {
        "title": "病中诗十五首：初病风",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "六十八衰翁，乘衰百疾攻。朽株難免蠹，空穴易來风。",
            "肘痹宜生柳，頭旋劇轉蓬。恬然不動处，虛白在胸中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 1
    },
    {
        "title": "病中诗十五首：枕上作",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "风疾侵淩臨老頭，血凝筋滯不調柔。甘從此后支離臥，",
            "浩气自能充靜室，驚飆何必蕩虛舟。腹空先進松花酒，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 2
    },
    {
        "title": "病中诗十五首：答閑上人來问因何风疾",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "一床方丈向阳開，勞動文殊问疾來。",
            "欲界凡夫何足道，四禪天始免风災。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 3
    },
    {
        "title": "病中诗十五首：病中五絕句",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "世間生老病相隨，此事心中久自知。",
            "今日行年将七十，犹須慚愧病來迟。",
            "方寸成灰鬢作絲，假如強健亦何為。",
            "家无憂累身无事，正是安闲好病時。",
            "李君墓上松應拱，元相池頭竹盡枯。",
            "多幸樂天今始病，不知合要苦治无。",
            "目昏思寢即安眠，足軟妨行便坐禪。",
            "身作醫王心是药，不勞和扁到門前。",
            "交親不要苦相憂，亦擬時時強出遊。",
            "但有心情何用腳，陸乘肩輿水乘舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 4
    },
    {
        "title": "病中诗十五首：送嵩客",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "登山臨水分无期，泉石煙霞今屬谁。",
            "君到嵩阳吟此句，与教二十六峰知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 5
    },
    {
        "title": "病中诗十五首：罷灸",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "病身佛说将何喻，變滅須臾豈不闻。",
            "莫遣淨名知我笑，休将火艾灸浮雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 6
    },
    {
        "title": "病中诗十五首：賣駱馬",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "五年花下醉騎行，臨賣回頭嘶一聲。",
            "項籍顧騅犹解歎，樂天別駱豈无情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 7
    },
    {
        "title": "病中诗十五首：別柳枝",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "两枝楊柳小樓中，嫋嫋多年伴醉翁。",
            "明日放归归去后，世間應不要春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 8
    },
    {
        "title": "病中诗十五首：就暖偶酌戲諸诗酒舊侶",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "低屏軟褥臥藤床，舁向前軒就日阳。一足任他為外物，",
            "細酌徐吟犹得在，舊遊未必便相忘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 9
    },
    {
        "title": "病中诗十五首：歲暮呈思黯相公、皇甫朗之及夢得尚书",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "歲暮皤然一老夫，十分流輩九分无。",
            "莫嫌身病人扶侍，犹勝无身可遣扶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 10
    },
    {
        "title": "病中诗十五首：自解",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "房傳往世為禪客，王道前生應画師。我亦定中觀宿命，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 11
    },
    {
        "title": "歲暮病懷贈夢得",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "十年四海故交親，零落唯残两病身。共遣数奇從是命，",
            "新樂堂前舊池上，相過亦不要他人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 12
    },
    {
        "title": "雪后過集賢裴令公舊宅有感",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "梁王捐館后，枚叟過門時。有淚人還泣，无情雪不知。",
            "台亭留盡在，賓客散何之。唯有蕭條雁，時來下故池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 13
    },
    {
        "title": "酬夢得貧居詠懷見贈",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "歲阴生计两蹉跎，相顧悠悠醉且歌。廚冷難留烏止屋，",
            "日望揮金賀新命，俸錢依舊又如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 14
    },
    {
        "title": "酬夢得見喜疾瘳",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "暖臥摩綿褥，晨傾药酒螺。昏昏布裘底，病醉睡相和。",
            "末疾徒云爾，餘年有幾何。須知差与否，相去校无多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 15
    },
    {
        "title": "夜闻箏中彈瀟湘送神曲感舊",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "縹緲巫山女，归來七八年。殷勤湘水曲，留在十三弦。",
            "苦調吟還出，深情咽不傳。万重雲水思，今夜月明前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 16
    },
    {
        "title": "感蘇州舊舫",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "画梁朽折紅窗破，独立池邊盡日看。",
            "守得蘇州船舫爛，此身爭合不衰残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 17
    },
    {
        "title": "感舊石上字",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "閑撥船行尋舊池，幽情往事複谁知。",
            "太湖石上鐫三字，十五年前陳結之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 18
    },
    {
        "title": "見敏中初到邠寧秋日登城樓诗诗中頗多鄉思因以寄和",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "想爾到邊頭，蕭條正值秋。二年貧禦史，八月古邠州。",
            "絲管闻雖樂，风沙見亦愁。望鄉心若苦，不用数登樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 19
    },
    {
        "title": "齋戒",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "每因齋戒斷葷腥，漸觉塵勞染愛輕。六賊定知无气色，",
            "從此始堪為弟子，竺幹師是古先生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 20
    },
    {
        "title": "戲禮經老僧",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "香火一爐燈一盞，白頭夜禮佛名經。",
            "何年飲著聲闻酒，直到如今醉未醒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 21
    },
    {
        "title": "近見慕巢尚书诗中屡有歎老思退之意又於洛下新置郊居然寵寄方深归心大速因以長句戲而諭之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "近見诗中歎白发，遙知閫外憶東都。煙霞偷眼窺來久，",
            "應須待到懸車歲，然后東归伴老夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 22
    },
    {
        "title": "对鏡偶吟，贈张道士抱元",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "閑來对鏡自思量，年貌衰残分所當。白发万莖何所怪，",
            "今日逢師雖已晚，枕中治老有何方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 23
    },
    {
        "title": "病入新正",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "枕上驚新歲，花前念舊歡。是身老所逼，非意病相干。",
            "风月情犹在，杯觴興漸闌。便休心未伏，更試一春看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 24
    },
    {
        "title": "臥疾來早晚",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "臥疾來早晚，懸懸将十旬。婢能尋本草，犬不吠醫人。",
            "酒甕全生醭，歌筵半委塵。风光還欲好，爭向枕前春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 25
    },
    {
        "title": "強起迎春，戲寄思黯",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "杖策人扶廢病身，晴和強起一迎春。",
            "他時蹇跛縱行得，笑殺平原樓上人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 26
    },
    {
        "title": "夢得前所酬篇有鍊盡美少年之句因思往事兼詠今懷重以長句答之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "煉盡少年成白首，憶初相识到今朝。昔饒春桂長先折，",
            "聲華寵命人皆得，若個如君曆七朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 27
    },
    {
        "title": "病后寒食",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "故紗絳帳舊青氈，药酒醺醺引醉眠。鬥擻弊袍春晚后，",
            "拋擲风光負寒食，曾來未省似今年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 28
    },
    {
        "title": "老病相仍以诗自解",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "榮枯憂喜与彭殤，都是人間戲一場。蟲臂鼠肝犹不怪，",
            "還似遠行裝束了，迟回且住亦何妨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 29
    },
    {
        "title": "皇甫郎中親家翁赴任絳州，宴送出城贈別",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "慕賢入室交先定，結援通家好複成。新婦不嫌貧活计，",
            "欲识離群相戀意，為君扶病出都城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 30
    },
    {
        "title": "春暖",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "风痹宜和暖，春來腳較輕。鶯留花下立，鶴引水邊行。",
            "發少嫌巾重，顏衰訝鏡明。不論親与故，自亦昧平生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 31
    },
    {
        "title": "残春晚起，伴客笑談",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "掩戶下簾朝睡足，一聲黃鳥報残春。披衣岸幘日高起，",
            "莫言病后妨談笑，犹恐多於不病人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 32
    },
    {
        "title": "送唐州崔使君侍親赴任",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "連持使節曆專城，独賀崔侯最慶榮。烏府一拋霜簡去，",
            "唯慮郡齋賓友少，数杯春酒共谁傾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 33
    },
    {
        "title": "春晚詠懷贈皇甫朗之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "豔阳時節又蹉跎，迟暮光阴複若何。一歲平分春日少，",
            "賴有銷憂治悶药，君家濃酎我狂歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 34
    },
    {
        "title": "春盡日宴罷，感事独吟",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "五年三月今朝盡，客散筵空独掩扉。病共樂天相伴住，",
            "金帶縋腰衫委地，年年衰瘦不勝衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 35
    },
    {
        "title": "病中辱崔宣城長句見寄兼有觥綺之贈因以四韵總而酬之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "劉楨病發經春臥，謝脁诗來盡日吟。三道舊誇收片玉，",
            "科第門生滿霄漢，歲寒少得似君心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 36
    },
    {
        "title": "前有別楊柳枝絕句夢得繼和云春盡絮飛留不得隨风好去落谁家又復戲答",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "柳老春深日又斜，任他飛向別人家。",
            "谁能更學孩童戲，尋逐春风捉柳花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 37
    },
    {
        "title": "池上早夏",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "水積春塘晚，阴交夏木繁。舟船如野渡，籬落似江村。",
            "靜拂琴床席，香開酒庫門。慵閑无一事，時弄小嬌孫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 38
    },
    {
        "title": "談氏外孫生三日喜是男偶吟成篇兼戲呈夢得",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "玉芽珠顆小男兒，羅薦蘭湯浴罷時。芣苡春來盈女手，",
            "明日貧翁具雞黍，應須酬賽引雛诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 39
    },
    {
        "title": "開成大行皇帝挽歌詞四首，奉敕撰進",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "禦宇恢皇化，傳家葉至公。華夷臣妾內，堯舜弟兄中。",
            "制度移民俗，文章變國风。開成与貞觀，實錄事多同。",
            "晏駕辭雙闕，靈仪出九衢。上雲归碧落，下席葬蒼梧。",
            "蓂晚餘堯曆，龜新啟夏图。三朝聯棣萼，從古帝王无。",
            "嚴恭七月禮，哀慟万人心。地感勝秋气，天愁結夕阴。",
            "鼎湖龍漸遠，蒙汜日初沈。唯有雲韶樂，長留治世音。",
            "化成同軌表清平，恩結連枝感圣明。帝与九齡雖吉夢，",
            "老病龍髯攀不及，東周退傅最傷情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 40
    },
    {
        "title": "時熱少客，因詠所懷",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "冠櫛心多懶，逢迎興漸微。況當時熱甚，幸遇客來稀。",
            "濕灑池邊地，涼開竹下扉。露床青篾簟，风架白蕉衣。",
            "院靜留僧宿，樓空放妓归。衰残強歡宴，此事久知非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 41
    },
    {
        "title": "宣州崔大夫閤老忽以近诗数十首見示吟諷之下竊有所喜因成長句寄題郡齋",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "謝玄暉歿吟聲寢，郡閣寥寥筆硯閑。无複新诗題壁上，",
            "再喜宣城章句動，飛觴遙賀敬亭山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 42
    },
    {
        "title": "足疾",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "足疾无加亦不瘳，綿春曆夏複經秋。開顏且酌尊中酒，",
            "應須學取陶彭澤，但委心形任去留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 43
    },
    {
        "title": "晚池泛舟，遇景成詠，贈呂处士",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "岸淺橋平池面寬，飄然輕棹泛澄瀾。风宜扇引開懷入，",
            "唯怜呂叟時相伴，同把磻溪舊釣竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 44
    },
    {
        "title": "夢微之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "夜來攜手夢同遊，晨起盈巾淚莫收。漳浦老身三度病，",
            "阿衛韓郎相次去，夜台茫昧得知不。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 45
    },
    {
        "title": "感秋詠意",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "炎涼遷次速如飛，又脫生衣著熟衣。繞壁暗蛩无限思，",
            "舊语相傳聊自慰，世間七十老人稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 46
    },
    {
        "title": "老病幽独，偶吟所懷",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "眼漸昏昏耳漸聾，滿頭霜雪半身风。已将身出浮雲外，",
            "世緣俗念消除盡，別是人間清淨翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 47
    },
    {
        "title": "和楊尚书罷相后夏日游永安水亭兼招本曹楊侍郎同行",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "道行无喜退无憂，舒卷如雲得自由。良冶動時為哲匠，",
            "遙愛翩翩雙紫鳳，入同官署出同遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 48
    },
    {
        "title": "在家出家",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "衣食支吾婚嫁畢，從今家事不相仍。夜眠身是投林鳥，",
            "中宵入定跏趺坐，女喚妻呼多不應。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 49
    },
    {
        "title": "夜涼",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "露白风清庭戶涼，老人先著夾衣裳。",
            "舞腰歌袖拋何处，唯对无弦琴一张。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 50
    },
    {
        "title": "繼之尚书自余病來寄遺非一又蒙覽醉吟先生傳題诗以美之今以此篇用伸酬謝",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "衰残与世日相疏，惠好唯君分有餘。茶药贈多因病久，",
            "醉傅狂言人盡笑，独知我者是尚书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 51
    },
    {
        "title": "五年秋病后独宿香山寺三絕句",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "經年不到龍門寺，今夜何人知我情。",
            "還向暢師房裏宿，新秋月色舊灘聲。",
            "飲徒歌伴今何在，雨散雲飛盡不回。",
            "從此香山风月夜，只應長是一身來。",
            "石盆泉畔石樓頭，十二年來晝夜遊。",
            "更過今年年七十，假如无病亦宜休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 52
    },
    {
        "title": "題香山新經堂招僧",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "煙滿秋堂月滿庭，香花漠漠磬泠泠。",
            "谁能來此尋真諦，白老新開一藏經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 53
    },
    {
        "title": "偶題鄧公",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "偶因攜酒尋村客，聊複回車訪薜蘿。且值雪寒相慰问，",
            "一種共翁頭似雪，翁无衣食自如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 54
    },
    {
        "title": "早入皇城贈王留守僕射",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "津橋残月曉沉沉，风露淒清禁署深。",
            "城柳宮槐謾搖落，悲愁不到貴人心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 55
    },
    {
        "title": "寄題廬山舊草堂，兼呈二林寺道侶",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "三十年前草堂主，而今雖在鬢如絲。登山尋水應无力，",
            "君行過到爐峰下，為報東林長老知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 56
    },
    {
        "title": "改业",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "先生老去飲无興，居士病來閑有餘。犹觉醉吟多放逸，",
            "卻被山僧戲相问，一時改业意何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 57
    },
    {
        "title": "山下留別佛光和尚",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "勞師送我下山行，此別何人识此情。",
            "我已七旬師九十，當知后會在他生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 58
    },
    {
        "title": "山中五絕句：嶺上雲",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "嶺上白雲朝未散，田中青麥旱将枯。",
            "自生自滅成何事，能逐東风作雨无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 59
    },
    {
        "title": "山中五絕句：石上苔",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "漠漠斑斑石上苔，幽芳靜綠絕纖埃。",
            "路傍凡草榮遭遇，曾得七香車輾來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 60
    },
    {
        "title": "山中五絕句：林下樗",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "香檀文桂苦雕鐫，生理何曾得自全。",
            "知我无材老樗否，一枝不損盡天年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 61
    },
    {
        "title": "山中五絕句：澗中魚",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "海水桑田欲變時，风濤翻覆沸天池。",
            "鯨吞蛟鬥波成血，深澗游魚樂不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 62
    },
    {
        "title": "山中五絕句：洞中蝙蝠",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "千年鼠化白蝙蝠，黑洞深藏避網羅。",
            "遠害全身誠得计，一生幽暗又如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 63
    },
    {
        "title": "自戲三絕句：心问身",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "心问身雲何泰然，嚴冬暖被日高眠。",
            "放君快活知恩否，不早朝來十一年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 64
    },
    {
        "title": "自戲三絕句：身報心",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "心是身王身是宮，君今居在我宮中。",
            "是君家舍君須愛，何事論恩自说功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 65
    },
    {
        "title": "自戲三絕句：心重答身",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "因我疏慵休罷早，遣君安樂歲時多。",
            "世間老苦人何限，不放君閑奈我何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 66
    },
    {
        "title": "會昌元年春五絕句：病后喜過劉家",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "忽憶前年初病后，此生甘分不銜杯。",
            "谁能料得今春事，又向劉家飲酒來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 67
    },
    {
        "title": "會昌元年春五絕句：贈舉之僕射",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "雞球餳粥屡開筵，談笑謳吟間管弦。",
            "一月三回寒食會，春光應不負今年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 68
    },
    {
        "title": "會昌元年春五絕句：盧尹賀夢得會中作",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "病闻川守賀筵開，起伴尚书飲一杯。",
            "任意少年長笑我，老人自覓老人來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 69
    },
    {
        "title": "會昌元年春五絕句：題朗之槐亭",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "春风可惜无多日，家醞唯残軟半瓶。",
            "犹望君归同一醉，籃舁早晚入槐亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 70
    },
    {
        "title": "會昌元年春五絕句：勸夢得酒",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "谁人功画麒麟閣，何客新投魑魅鄉。",
            "两处榮枯君莫问，残春更醉两三場。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 71
    },
    {
        "title": "過裴令公宅二絕句",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "风吹楊柳出牆枝，憶得同歡共醉時。",
            "每到集賢坊地過，不曾一度不低眉。",
            "梁王舊館雪濛濛，愁殺鄒枚二老翁。",
            "假使明朝深一尺，亦无人到兔園中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 72
    },
    {
        "title": "百日假滿，少傅官停，自喜言懷",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "長告今朝滿十旬，從茲蕭灑便終身。老嫌手重拋牙笏，",
            "人言世事何時了，我是人間事了人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 73
    },
    {
        "title": "早熱",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "畏景又加旱，火雲殊未收。籬暄饑有雀，池涸渴无鸥。",
            "岸幘頭仍痛，褰裳汗亦流。若為當此日，遷客向炎州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 74
    },
    {
        "title": "題崔少尹上林坊新居",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "坊靜居新深且幽，忽疑縮地到滄洲。宅東籬缺嵩峰出，",
            "若能為客烹雞黍，愿伴田蘇日日遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 75
    },
    {
        "title": "新澗亭",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "煙蘿初合澗新開，閑上西亭日幾回。",
            "老病归山應未得，且移泉石就身來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 76
    },
    {
        "title": "对酒有懷寄李十九郎中",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "往年江外拋桃葉，去歲樓中別柳枝。寂寞春來一杯酒，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 77
    },
    {
        "title": "楊六尚书频寄新诗诗中多有思闲相就之志因书鄙意報而諭之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "君年殊未及懸車，未合将閑逐老夫。身健正宜金印綬，",
            "進退是非俱是夢，丘中闕下亦何殊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 78
    },
    {
        "title": "偶吟自慰兼呈夢得",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "且喜同年滿七旬，莫嫌衰病莫嫌貧。已為海內有名客，",
            "尊榮富壽難兼得，閑坐思量最要身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 79
    },
    {
        "title": "寄潮州楊繼之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "相府潮阳俱夢中，夢中何者是窮通。",
            "他時事過方應悟，不独榮空辱亦空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 80
    },
    {
        "title": "雪暮偶与夢得同致仕裴賓客王尚书飲",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "黃昏慘慘雪霏霏，白首相歡醉不归。",
            "四個老人三百歲，人間此會亦應稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 81
    },
    {
        "title": "雪朝乘興欲詣李司徒留守，先以五韵戲之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "夜寒生酒思，曉雪引诗情。熱飲一两盞，冷吟三五聲。",
            "鋪花怜地凍，銷玉畏天晴。好拂烏巾出，宜披鶴氅行。",
            "梁園應有興，何不召鄒生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 82
    },
    {
        "title": "贈思黯",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "為怜清淺愛潺湲，一日三回到水邊。",
            "若道归仁灘更好，主人何故別三年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 83
    },
    {
        "title": "聽歌六絕句：聽都子歌",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "都子新歌有性靈，一聲格轉已堪聽。",
            "更聽唱到嫦娥字，犹有樊家舊典刑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 84
    },
    {
        "title": "聽歌六絕句：樂世",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "管急弦繁拍漸稠，綠腰宛轉曲終頭。",
            "誠知樂世聲聲樂，老病人聽未免愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 85
    },
    {
        "title": "聽歌六絕句：水調",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "五言一遍最殷勤，調少情多似有因。",
            "不會當時翻曲意，此聲腸斷為何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 86
    },
    {
        "title": "聽歌六絕句：想夫怜",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "玉管朱弦莫急催，容聽歌送十分杯。",
            "長愛夫怜第二句，請君重唱夕阳開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 87
    },
    {
        "title": "聽歌六絕句：何滿子",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "世傳滿子是人名，臨就刑時曲始成。",
            "一曲四調歌八疊，從頭便是斷腸聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 88
    },
    {
        "title": "聽歌六絕句：離別難",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "綠楊陌上送行人，馬去車回一望塵。",
            "不觉別時紅淚盡，归來无淚可沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百五十八",
        "no#": 89
    },
    {
        "title": "閑樂",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "坐安臥穩輿平肩，倚杖披衫繞四邊。空腹三杯卯后酒，"
        ],
