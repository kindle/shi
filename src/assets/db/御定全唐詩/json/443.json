[
    {
        "title": "初罷中书舍人",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "自慚拙宦叨清貴，還有癡心怕素餐。或望君臣相獻替，",
            "分寸寵光酬未得，不休更擬覓何官。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 1
    },
    {
        "title": "宿阳城驛對月",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "親故尋回駕，妻孥未出關。鳳凰池上月，送我過商山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 2
    },
    {
        "title": "商山路有感",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "憶昨征還日，三人归路同。此生都是夢，前事旋成空。",
            "杓直泉埋玉，虞平燭過风。唯残樂天在，頭白向江東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 3
    },
    {
        "title": "重感",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "停驂歇路隅，重感一長籲。擾擾生還死，紛紛榮又枯。",
            "困支青竹杖，閑捋白髭須。莫歎身衰老，交遊半已无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 4
    },
    {
        "title": "逢张十八員外籍",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "旅思正茫茫，相逢此道傍。曉嵐林葉暗，秋露草花香。",
            "白发江城守，青衫水部郎。客亭同宿處，忽似夜归鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 5
    },
    {
        "title": "赴杭州重宿棣華驛，見楊八舊诗，感題一絕",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "往恨今愁應不殊，題诗梁下又踟躕。",
            "羨君犹夢見兄弟，我到天明睡亦无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 6
    },
    {
        "title": "寓言題僧",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "劫风火起燒荒宅，苦海波生蕩破船。",
            "力小无因救焚溺，清涼山下且安禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 7
    },
    {
        "title": "內鄉村路作",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "日下风高野路涼，緩驅疲馬暗思鄉。",
            "渭村秋物應如此，枣赤梨紅稻穗黃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 8
    },
    {
        "title": "路上寄銀匙与阿龜",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "謫宦心都慣，辭鄉去不難。緣留龜子住，涕淚一闌幹。",
            "小子須嬌養，鄒婆為好看。銀匙封寄汝，憶我即加餐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 9
    },
    {
        "title": "山泉煎茶有懷",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "坐酌泠泠水，看煎瑟瑟塵。无由持一碗，寄与愛茶人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 10
    },
    {
        "title": "郢州贈別王八使君",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "昔是诗狂客，今為酒病夫。強吟翻悵望，縱醉不歡娛。",
            "鬢发三分白，交親一半无。郢城君莫厭，犹校近京都。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 11
    },
    {
        "title": "吉祥寺見錢侍郎題名",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "雲雨三年別，风波万里行。愁來正蕭索，況見古人名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 12
    },
    {
        "title": "重到江州感舊遊，題郡樓十一韵",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "掌綸知是忝，剖竹信為榮。才薄官仍重，恩深責尚輕。",
            "昔征從典午，今出自承明。鳳詔休揮翰，漁歌欲濯纓。",
            "還乘小艛艓，卻到古湓城。醉客臨江待，禪僧出郭迎。",
            "青山滿眼在，白发半頭生。又校三年老，何曾一事成。",
            "重過蕭寺宿，再上庾樓行。雲水新秋思，閭閻舊日情。",
            "郡民犹認得，司馬詠诗聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 13
    },
    {
        "title": "贈江州李十使君員外十二韵",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "我本江湖上，悠悠任运身。朝隨賣药客，暮伴釣魚人。",
            "跡為燒丹隱，家緣嗜酒貧。經過剡溪雪，尋覓武陵春。",
            "豈有疏狂性，堪為侍從臣。仰頭驚鳳闕，下口觸龍鱗。",
            "劍佩辭天上，风波向海濱。非賢虛偶聖，无屈敢求伸。",
            "昔去曾同日，今來即後塵。中年俱白发，左宦各朱輪。",
            "長短才雖異，榮枯事略均。殷勤李員外，不合不相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 14
    },
    {
        "title": "題別遺愛草堂兼呈李十使君",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "曾住爐峰下，书堂對药台。斬新蘿徑合，依舊竹窗開。",
            "砌水親開決，池荷手自栽。五年方暫至，一宿又須回。",
            "縱未長归得，犹勝不到來。君家白鹿洞，闻道亦生苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 15
    },
    {
        "title": "重題",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "泉石尚依依，林疏僧亦稀。何年辭水閣，今夜宿雲扉。",
            "謾獻長楊賦，虛拋薜荔衣。不能成一事，贏得白頭归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 16
    },
    {
        "title": "夜泊旅望",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "少睡多愁客，中宵起望鄉。沙明連浦月，帆白滿船霜。",
            "近海江彌闊，迎秋夜更長。煙波三十宿，犹未到錢唐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 17
    },
    {
        "title": "九江北岸遇风雨",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "黃梅縣邊黃梅雨，白頭浪裏白頭翁。九江闊處不見岸，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 18
    },
    {
        "title": "舟中晚起",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "日高犹掩水窗眠，枕簟清涼八月天。泊處或依沽酒店，",
            "且向錢唐湖上去，冷吟閑醉二三年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 19
    },
    {
        "title": "秋寒",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "雪鬢年顏老，霜庭景氣秋。病看妻檢药，寒遣婢梳頭。",
            "身外名何有，人間事且休。澹然方寸內，唯擬學虛舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 20
    },
    {
        "title": "初到郡齋寄錢湖州李蘇州",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "俱來滄海郡，半作白頭翁。謾道风煙接，何曾笑语同。",
            "吏稀秋稅畢，客散晚庭空。霽後當樓月，潮來滿座风。",
            "霅溪殊冷僻，茂苑太繁雄。唯此錢唐郡，閑忙恰得中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 21
    },
    {
        "title": "對酒自勉",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "五十江城守，停杯一自思。頭仍未盡白，官亦不全卑。",
            "榮寵尋過分，歡娛已校迟。肺傷雖怕酒，心健尚誇诗。",
            "夜舞吳娘袖，春歌蠻子詞。犹堪三五歲，相伴醉花时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 22
    },
    {
        "title": "郡樓夜宴留客",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "北客勞相訪，東樓為一開。褰簾待月出，把火看潮來。",
            "豔聽竹枝曲，香傳蓮子杯。寒天殊未曉，归騎且迟回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 23
    },
    {
        "title": "醉題候仙亭",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "蹇步垂朱綬，華纓映白須。何因駐衰老，只有且歡娛。",
            "酒興還應在，诗情可便无。登山与臨水，犹未要人扶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 24
    },
    {
        "title": "東院",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "松下軒廊竹下房，暖簷晴日滿繩床。淨名居士經三卷，",
            "有时閑酌无人伴，独自騰騰入醉鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 25
    },
    {
        "title": "虛白堂",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "虛白堂前衙退後，更无一事到中心。",
            "移床就日簷間臥，臥詠閑诗側枕琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 26
    },
    {
        "title": "閑夜詠懷，因招周協律，劉、薛二秀才",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "世名檢束為朝士，心性疏慵是野夫。高置寒燈如客店，",
            "若厭雅吟須俗飲，妓筵勉力為君鋪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 27
    },
    {
        "title": "晚興",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "極浦收残雨，高城駐落暉。山明虹半出，松暗鶴雙归。",
            "将吏隨衙散，文书入務稀。閑吟倚新竹，筠粉汙朱衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 28
    },
    {
        "title": "衰病",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "老与病相仍，華簪發不勝。行多朝散药，睡少夜停燈。",
            "祿食分供鶴，朝衣減施僧。性多移不得，郡政謾如繩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 29
    },
    {
        "title": "病中對病鶴",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "同病病夫怜病鶴，精神不損翅翎傷。未堪再舉摩霄漢，",
            "唯應一事宜為伴，我發君毛俱似霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 30
    },
    {
        "title": "夜归",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "半醉閑行湖岸東，馬鞭敲鐙轡瓏璁。万株松樹青山上，",
            "归來未放笙歌散，画戟門開蠟燭紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 31
    },
    {
        "title": "臘後歲前遇景詠意",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "海梅半白柳微黃，凍水初融日欲長。度臘都无苦霜霰，",
            "公事漸閑身且健，使君殊未厭餘杭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 32
    },
    {
        "title": "白发",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "雪發隨梳落，霜毛繞鬢垂。加添老氣味，改變舊容仪。",
            "不肯長如漆，无過總作絲。最憎明鏡裏，黑白半頭时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 33
    },
    {
        "title": "錢湖州以箬下酒李蘇州以五酘酒相次寄到无因同飲聊詠所懷",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "勞将箬下忘憂物，寄与江城愛酒翁。鐺腳三州何處會，",
            "莫怪殷勤醉相憶，曾陪西省与南宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 34
    },
    {
        "title": "花樓望雪命宴賦诗",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "連天際海白皚皚，好上高樓望一回。何處更能分道路，",
            "素壁聯題分韵句，紅爐巡飲暖寒杯。冰鋪湖水銀為面，",
            "輸将虛白堂前鶴，失卻樟亭驛後梅。別有故情偏憶得，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 35
    },
    {
        "title": "晚歲",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "壯歲忽已去，浮榮何足論。身為百口長，官是一州尊。",
            "不覺白雙鬢，徒言朱两轓。病難施郡政，老未答君恩。",
            "歲暮別兄弟，年衰无子孫。惹愁諳世網，治苦賴空門。",
            "攬帶知腰瘦，看燈覺眼昏。不緣衣食系，尋合返丘園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 36
    },
    {
        "title": "宿竹閣",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "晚坐松簷下，宵眠竹閣間。清虛當服药，幽独抵归山。",
            "巧未能勝拙，忙應不及閑。无勞別修道，即此是玄關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 37
    },
    {
        "title": "歲暮枉衢州张使君书並诗，因以長句報之",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "西州彼此意何如，官職蹉跎歲欲除。浮石潭邊停五馬，",
            "貧薄诗家无好物，反投桃李報瓊琚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 38
    },
    {
        "title": "和薛秀才尋梅花同飲見贈",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "忽驚林下發寒梅，便試花前飲冷杯。白馬走迎诗客去，",
            "若到歲寒无雨雪，犹應醉得两三回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 39
    },
    {
        "title": "与諸客空腹飲",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "隔宿书招客，平明飲暖寒。麹神寅日合，酒聖卯时歡。",
            "促膝才飛白，酡顏已渥丹。碧籌攢米碗，紅袖拂骰盤。",
            "醉後歌尤異，狂來舞不難。拋杯语同坐，莫作老人看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 40
    },
    {
        "title": "小歲日對酒吟錢湖州所寄诗",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "独酌无多興，閑吟有所思。一杯新歲酒，两句故人诗。",
            "楊柳初黃日，髭須半白时。蹉跎春氣味，彼此老心知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 41
    },
    {
        "title": "錢唐湖春行",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "孤山寺北賈亭西，水面初平雲腳低。幾處早鶯爭暖樹，",
            "最愛湖東行不足，綠楊阴裏白沙堤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 42
    },
    {
        "title": "題靈隱寺紅辛夷花，戲酬光上人",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "紫粉筆含尖火焰，紅胭脂染小蓮花。",
            "芳情鄉思知多少，惱得山僧悔出家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 43
    },
    {
        "title": "重向火",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "火銷灰複死，疏棄已經旬。豈是人情薄，其如天氣春。",
            "风寒忽再起，手冷重相親。卻就紅爐坐，心如逢故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 44
    },
    {
        "title": "候仙亭同諸客醉作",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "謝安山下空攜妓，柳惲洲邊只賦诗。",
            "爭及湖亭今日會，嘲花詠水贈蛾眉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 45
    },
    {
        "title": "城上",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "城上冬冬鼓，朝衙複晚衙。為君慵不出，落盡繞城花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 46
    },
    {
        "title": "早行林下",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "披衣未冠櫛，晨起入前林。宿露残花氣，朝光新葉阴。",
            "傍松人跡少，隔竹鳥聲深。閑倚小橋立，傾頭时一吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 47
    },
    {
        "title": "送李校书趁寒食归義興山居",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "大見騰騰诗酒客，不憂生计似君稀。",
            "到舍将何作寒食，滿船唯载樹阴归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 48
    },
    {
        "title": "題孤山寺山石榴花示諸僧眾",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "山榴花似結紅巾，容豔新妍占斷春。色相故關行地道，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 49
    },
    {
        "title": "独行",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "暗誦黃庭經在口，閑攜青竹杖隨身。",
            "晚花新筍堪為伴，独入林行不要人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 50
    },
    {
        "title": "二月五日花下作",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "二月五日花如雪，五十二人頭似霜。闻有酒时須笑樂，",
            "只有且來花下醉，從人笑道老顛狂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 51
    },
    {
        "title": "戲題木蘭花",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "紫房日照胭脂拆，素豔风吹膩粉開。",
            "怪得独饒脂粉態，木蘭曾作女郎來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 52
    },
    {
        "title": "清明日觀妓舞聽客诗",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "看舞顏如玉，聽诗韵似金。綺羅從许笑，弦管不妨吟。",
            "可惜春风老，无嫌酒醆深。辭花送寒食，並在此时心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 53
    },
    {
        "title": "西湖晚归，回望孤山寺，贈諸客",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "柳湖松島蓮花寺，晚動归橈出道場。盧橘子低山雨重，",
            "到岸請君回首望，蓬萊宮在海中央。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 54
    },
    {
        "title": "湖中自照",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "重重照影看容鬢，不見朱顏見白絲。",
            "失卻少年无處覓，泥他湖水欲何為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 55
    },
    {
        "title": "贈蘇煉師",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "两鬢蒼然心浩然，松窗深處药爐前。攜将道士通宵语，",
            "犹嫌莊子多詞句，唯讀逍遙六七篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 56
    },
    {
        "title": "杭州春望",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "望海樓明照曙霞，護江堤白蹋晴沙。濤聲夜入伍員廟，",
            "谁開湖寺西南路，草綠裙腰一道斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 57
    },
    {
        "title": "飲散夜归贈諸客",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "鞍馬夜紛紛，香街起暗塵。回鞭招飲妓，分火送归人。",
            "风月應堪惜，杯觴莫厭频。明朝三月盡，忍不送残春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 58
    },
    {
        "title": "湖亭晚归",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "盡日湖亭臥，心闲事亦稀。起因残醉醒，坐待晚涼归。",
            "松雨飄藤帽，江风透葛衣。柳堤行不厭，沙軟絮霏霏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 59
    },
    {
        "title": "東樓南望八韵",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "不厭東南望，江樓對海門。风濤生有信，天水合无痕。",
            "鷁帶雲帆動，鸥和雪浪翻。魚鹽聚為市，煙火起成村。",
            "日腳金波碎，峰頭鈿點繁。送秋千裏雁，報暝一聲猿。",
            "已豁煩襟悶，仍開病眼昏。郡中登眺處，无勝此東軒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 60
    },
    {
        "title": "醉中酬殷協律",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "泗水亭邊一分散，浙江樓上重遊陪。揮鞭二十年前別，",
            "留君夜住非无分，且盡青娥紅燭臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 61
    },
    {
        "title": "孤山寺遇雨",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "拂波雲色重，灑葉雨聲繁。水鹭雙飛起，风荷一向翻。",
            "空蒙連北岸，蕭颯入東軒。或擬湖中宿，留船在寺門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 62
    },
    {
        "title": "樟亭雙櫻樹",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "南館西軒两樹櫻，春條長足夏阴成。",
            "素華朱實今雖盡，碧葉风來別有情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 63
    },
    {
        "title": "湖上夜飲",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "郭外迎人月，湖邊醒酒风。谁留使君飲，紅燭在舟中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 64
    },
    {
        "title": "贈沙鸥",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "老逼教垂白，官科遣著緋。形骸雖有累，方寸卻无机。",
            "遇酒多先醉，逢山愛晚归。沙鸥不知我，犹避隼旟飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 65
    },
    {
        "title": "餘杭形勝",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "餘杭形勝四方无，州傍青山縣枕湖。繞郭荷花三十裏，",
            "独有使君年太老，风光不稱白髭須。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 66
    },
    {
        "title": "江樓夕望招客",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "海天東望夕茫茫，山勢川形闊複長。燈火万家城四畔，",
            "能就江樓銷暑否，比君茅舍較清涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 67
    },
    {
        "title": "新秋病起",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "一葉落梧桐，年光半又空。秋多上階日，涼足入懷风。",
            "病瘦形如鶴，愁焦鬢似蓬。損心诗思裏，伐性酒狂中。",
            "華蓋何曾惜，金丹不致功。犹須自慚愧，得作白頭翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 68
    },
    {
        "title": "木芙蓉花下招客飲",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "晚涼思飲两三杯，召得江頭酒客來。",
            "莫怕秋无伴醉物，水蓮花盡木蓮開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 69
    },
    {
        "title": "悲歌",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "白頭新洗鏡新磨，老逼身來不奈何。耳裏频闻故人死，",
            "独有衰顏留不得，醉來无计但悲歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 70
    },
    {
        "title": "江樓晚眺，景物鮮奇，吟玩成篇，寄水部张員外",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "澹煙疏雨間斜阳，江色鮮明海氣涼。蜃散雲收破樓閣，",
            "好著丹青圖画取，題诗寄与水曹郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 71
    },
    {
        "title": "夜招周協律，兼答所贈",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "滿眼雖多客，開眉複向谁。少年非我伴，秋夜与君期。",
            "落魄俱耽酒，殷勤共愛诗。相怜別有意，彼此老无兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 72
    },
    {
        "title": "重酬周判官",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "秋愛冷吟春愛醉，诗家眷屬酒家仙。",
            "若教早被浮名系，可得闲遊三十年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 73
    },
    {
        "title": "飲後夜醒",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "黃昏飲散归來臥，夜半人扶強起行。枕上酒容和睡醒，",
            "直至曉來犹妄想，耳中如有管弦聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 74
    },
    {
        "title": "代賣薪女贈諸妓",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "乱蓬為鬢布為巾，曉蹋寒山自負薪。",
            "一種錢唐江畔女，著紅騎馬是何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 75
    },
    {
        "title": "奉和李大夫題新诗二首各六韵：因嚴亭",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "箕潁人窮独，蓬壺路阻難。何如兼吏隱，複得事躋攀。",
            "岩樹羅階下，江雲貯棟間。似移天目石，疑入武丘山。",
            "清景徒堪賞，皇恩肯放閑。遙知興未足，即被詔征還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 76
    },
    {
        "title": "奉和李大夫題新诗二首各六韵：忘筌亭",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "翠巘公門對，朱軒野徑連。只開新戶牖，不改舊风煙。",
            "虛室閑生白，高情澹入玄。酒容同座勸，诗借屬城傳。",
            "自笑滄江畔，遙思絳帳前。亭台隨處有，爭敢比忘筌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 77
    },
    {
        "title": "予以長慶二年冬十月到杭州，明年秋九月始与范阳盧賈、汝南周元範、蘭陵蕭悅、清河崔求、東萊劉方輿同遊恩德寺之泉洞竹石，籍甚久矣，及茲目擊，果愜心期，因自嗟云：到郡周歲，方來入寺，半日復去，俯視朱綬，仰睇白雲，有愧於心，遂留絕句",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "雲水埋藏恩德洞，簪裾束縛使君身。",
            "暫來不宿归州去，應被山呼作俗人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 78
    },
    {
        "title": "早冬",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "十月江南天氣好，可怜冬景似春華。霜輕未殺萋萋草，",
            "此时卻羨闲人醉，五馬无由入酒家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 79
    },
    {
        "title": "歲假內命酒贈周判官、蕭協律",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "共知欲老流年急，且喜新正假日频。闻健此时相勸醉，",
            "歲酒先拈辭不得，被君推作少年人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 80
    },
    {
        "title": "与諸客攜酒尋去年梅花有感",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "馬上同攜今日杯，湖邊共覓去春梅。年年只是人空老，",
            "樽前百事皆依舊，點檢惟无薛秀才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 81
    },
    {
        "title": "醉送李協律赴湖南辟命，因寄沈八中丞",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "富阳山底樟亭畔，立馬停舟飛酒盂。曾共中丞情繾綣，",
            "不羨君官羨君幕，幕中收得阮元瑜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 82
    },
    {
        "title": "內道場永讙上人就郡見訪善说維摩經臨別請诗因以此贈",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "五夏登壇內殿師，水為心地玉為仪。正傳金粟如來偈，",
            "他生莫忘今朝會，虛白亭中法樂时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 83
    },
    {
        "title": "見李蘇州示男阿武诗，自感成詠",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "遙羨青雲裏，祥鸞正引雛。自怜滄海伴，老蚌不生珠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 84
    },
    {
        "title": "正月十五日夜月",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "歲熟人心樂，朝遊複夜遊。春风來海上，明月在江頭。",
            "燈火家家市，笙歌處處樓。无妨思帝裏，不合厭杭州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 85
    },
    {
        "title": "題州北路傍老柳樹",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "皮枯緣受风霜久，條短為應攀折频。但見半衰當此路，",
            "莫道老株芳意少，逢春犹勝不逢春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 86
    },
    {
        "title": "題清頭陀",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "頭陀独宿寺西峰，百尺禪庵半夜鐘。",
            "煙月蒼蒼风瑟瑟，更无雜樹對山松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 87
    },
    {
        "title": "自歎二首",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "形羸自覺朝餐減，睡少偏知夜漏長。",
            "實事漸消虛事在，銀魚金帶繞腰光。",
            "二毛曉落梳頭懶，两眼春昏點药频。",
            "唯有閑行犹得在，心情未到不如人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 88
    },
    {
        "title": "湖上醉中代諸妓寄嚴郎中",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "笙歌杯酒正歡娛，忽憶仙郎望帝都。借问連宵直南省，",
            "還有些些惆悵事，春來山路見蘼蕪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 89
    },
    {
        "title": "自詠",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "悶發每吟诗引興，興來兼酌酒開顏。欲逢假日先招客，",
            "谁能頭白勞心力，人道无才也是閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 90
    },
    {
        "title": "晚興",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "草淺馬翩翩，新晴薄暮天。柳條春拂面，衫袖醉垂鞭。",
            "立语花堤上，行吟水寺前。等闲消一日，不覺過三年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 91
    },
    {
        "title": "早興",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "晨光出照屋樑明，初打開門鼓一聲。犬上階眠知地濕，",
            "睡覺心空思想盡，近來鄉夢不多成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 92
    },
    {
        "title": "竹樓宿",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "小书樓下千竿竹，深火爐前一醆燈。",
            "此處与谁相伴宿，燒丹道士坐禪僧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 93
    },
    {
        "title": "湖上招客送春泛舟",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "欲送残春招酒伴，客中谁最有风情。两瓶箬下新開得，",
            "慢牽好向湖心去，恰似菱花鏡上行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 94
    },
    {
        "title": "戲醉客",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "莫言魯國书生懦，莫把杭州刺史欺。",
            "醉客請君開眼望，綠楊风下有紅旗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 95
    },
    {
        "title": "紫阳花",
        "author": "白居易",
        "biography": "",
        "paragraphs": [
            "何年植向仙壇上，早晚移栽到梵家。",
            "雖在人間人不识，与君名作紫阳花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百四十三",
        "no#": 96
    }
]