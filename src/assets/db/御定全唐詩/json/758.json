[
    {
        "title": "宿山寺",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "溪山盡日行，方聽遠鐘聲。入院逢僧定，登樓見月生。",
            "露垂群木潤，泉落一岩清。此景關吾事，通宵寐不成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 1
    },
    {
        "title": "贈棲隱洞譚先生",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "先生雙鬢華，深谷臥雲霞。不伐有巢樹，多移无主花。",
            "石泉春釀酒，松火夜煎茶。因问山中事，如君有幾家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 2
    },
    {
        "title": "归雁",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "春至衡阳雁，思归塞路長。汀洲齊奮翼，霄漢共成行。",
            "雪盡翻风暖，寒收度月涼。直應到秋日，依舊返瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 3
    },
    {
        "title": "春江送人",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "春江多去情，相去枕長汀。数雁別湓浦，片帆離洞庭。",
            "雨餘沙草綠，雲散岸峰青。谁共觀明月，漁歌夜好聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 4
    },
    {
        "title": "過秦嶺",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "古今傳此嶺，高下勢崢嶸。安得青山路，化為平地行。",
            "蒼苔留虎跡，碧樹障溪聲。欲過一回首，踟躕无限情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 5
    },
    {
        "title": "送吳夢誾归閩",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "甌閩在天末，此去整行衣。久客逢春盡，思家冒暑归。",
            "海雲添晚景，山瘴滅晴暉。相憶吟偏苦，不堪书信稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 6
    },
    {
        "title": "山中夏日",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "深山宜避暑，門戶映嵐光。夏木蔭溪路，晝雲埋石床。",
            "心源澄道靜，衣葛蘸泉涼。算得紅塵裏，谁知此興長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 7
    },
    {
        "title": "宿故人江居",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "渡口樹冥冥，南山漸隱青。漁舟归舊浦，鸥鳥宿前汀。",
            "靜榻懸燈坐，閑門对浪扃。相思频到此，幾番醉還醒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 8
    },
    {
        "title": "寄伍喬",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "蹉跎春又晚，天末信來迟。長憶分攜日，正當搖落时。",
            "独游饒旅恨，多事失归期。君看前溪樹，山禽巢幾枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 9
    },
    {
        "title": "山中訪人不遇",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "負琴兼杖藜，特地過岩西。已見竹軒閉，又闻山鳥啼。",
            "長松寒倚谷，細草暗連溪。久立无人事，煙霞归路迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 10
    },
    {
        "title": "贈隱者",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "世路爭名利，深山独結茅。安情自得所，非道豈相交。",
            "百尺松當戶，千年鶴在巢。知君于此景，未欲等闲拋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 11
    },
    {
        "title": "寄暹上人",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "闻罷城中講，來安頂上禪。夜燈明石室，清磬出岩泉。",
            "欲訪慚多事，相思恨來年。終期息塵慮，接話虎溪邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 12
    },
    {
        "title": "江邊闲步",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "閑來南渡口，迤邐看江楓。一路波濤畔，数家蘆葦中。",
            "遠汀排晚樹，深浦漾寒鴻。吟罷慵回首，此情谁与同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 13
    },
    {
        "title": "過王逸人園林",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "谷口何时住，煙霞一徑深。水聲離遠洞，山色出疏林。",
            "雪彩從沾鬢，年光不计心。自言人少到，犹喜我來尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 14
    },
    {
        "title": "寄李处士",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "僧話磻溪叟，平生重赤松。夜堂悲蟋蟀，秋水老芙蓉。",
            "吟坐倦垂釣，閑行多倚筇。闻名來已久，未得一相逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 15
    },
    {
        "title": "夏日寄史处士",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "掩關苔滿地，終日坐騰騰。暑气冷衣葛，暮雲催燭燈。",
            "寂寥知得趣，疏懶似无能。還憶舊游否，何年別杜陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 16
    },
    {
        "title": "夏日登瀑頂寺，因寄諸知己",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "曾於塵裏望，此景在煙霄。岩靜水聲近，山深暑气遙。",
            "杖藜青石路，煮茗白雲樵。寄语為郎者，谁能訪寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 17
    },
    {
        "title": "懷果上人",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "擁錫南遊去，名香幾处焚。別來无遠信，多恐在深雲。",
            "好月曾同步，幽香省共闻。相思不相見，林下葉紛紛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 18
    },
    {
        "title": "寄故園兄弟",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "久与鄉關阻，风塵損舊衣。水思和月泛，山憶共僧归。",
            "林想添鄰舍，溪應改釣磯。弟兄无苦事，不用別庭闈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 19
    },
    {
        "title": "早秋吟眺",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "新秋初雨后，独立对遙山。去鳥望中沒，好雲吟裏還。",
            "長年慚道薄，明代取身閑。從有西征思，園林懶閉關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 20
    },
    {
        "title": "送江為归嶺南",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "舊山臨海色，归路到天涯。此別各多事，重逢是幾时。",
            "江行晴望遠，嶺宿夜吟迟。珍重南方客，清风失所思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 21
    },
    {
        "title": "山中答友人",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "偶愛春山住，因循值暑时。风塵非所愿，泉石本相宜。",
            "坐久松阴轉，吟餘蟬韵移。自慚疏野甚，多失故人期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 22
    },
    {
        "title": "山齋早秋雨中",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "深居少往還，卷箔早秋間。雨灑吟蟬樹，雲藏嘯狖山。",
            "炎蒸如便退，衣葛亦堪閑。靜坐得无事，酒卮聊暢顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 23
    },
    {
        "title": "送人游南越",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "孑然南越去，替爾畏前程。見说路岐嶮，不通車馬行。",
            "瘴煙迷海色，嶺樹帶猿聲。独向山家宿，多應鄉思生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 24
    },
    {
        "title": "酬東溪史处士",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "咫尺東溪路，年來偶訪迟。泉聲迷夜雨，花片落空枝。",
            "石徑逢僧出，山床見鶴移。貧齋有琴酒，曾许月圓期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 25
    },
    {
        "title": "秋江送客",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "秋风楚江上，送子話遊遨。遠水宿何处，孤舟春夜濤。",
            "浦雲沈雁影，山月照猿嗥。莫為饑寒苦，便成名利勞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 26
    },
    {
        "title": "寄山中高逸人",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "煙霞多放曠，吟嘯是尋常。猿共摘山果，僧鄰住石房。",
            "躡雲雙屐冷，采药一身香。我憶相逢夜，松潭月色涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 27
    },
    {
        "title": "懷友人",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "浮世況多事，飄流每歎君。路岐何处去，消息幾时闻。",
            "吟裏落秋葉，望中生暮雲。孤懷谁慰我，夕鳥自成群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 28
    },
    {
        "title": "送人归別业",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "別业五湖上，春残去路賒。還尋舊山水，重到故人家。",
            "門徑掩芳草，園林落異花。君知釣磯在，犹喜有生涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 29
    },
    {
        "title": "冬日登江樓",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "高樓臨古岸，野步晚來登。江水因寒落，山雲為雪凝。",
            "遠村雖入望，危檻不堪凭。親老未归去，鄉愁徒自興。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 30
    },
    {
        "title": "寄张山人",
        "author": "孟貫",
        "biography": "",
        "paragraphs": [
            "草堂南澗邊，有客嘯雲煙。掃葉林风后，拾薪山雨前。",
            "野橋通竹徑，流水入芝田。琴月相親夜，更深戀不眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十八",
        "no#": 31
    }
]