[
    {
        "title": "书邊事",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "朔野煙塵起，天军又舉戈。阴风向晚急，殺氣入秋多。",
            "樹盡禽棲草，冰堅路在河。汾阳无繼者，羌虜肯先和。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 1
    },
    {
        "title": "遠归別墅",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "馬省曾行處，連嘶渡晚河。忽驚鄉樹出，漸识路人多。",
            "細徑穿禾黍，頹垣壓薜蘿。乍归犹似客，鄰叟亦相過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 2
    },
    {
        "title": "題友人屋",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "松底诗人宅，閑門遠岫孤。數家分小徑，一水截平蕪。",
            "竹節偶相對，鳥名多自呼。愛君真靜者，欲去又踟躕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 3
    },
    {
        "title": "贈同游",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "此來风雨後，已覺減年華。若待皆无事，應難更有花。",
            "管弦臨夜急，榆柳向江斜。且莫看归路，同須醉酒家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 4
    },
    {
        "title": "送人出塞",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "北风吹雨雪，舉目已淒淒。戰鬼秋频哭，征鴻夜不棲。",
            "沙平關路直，磧廣郡樓低。此去非東魯，人多事鼓鼙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 5
    },
    {
        "title": "尋僧元皎因贈",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "此生迷有著，因病得尋師。話盡山中事，归當月上时。",
            "高松連寺影，亞竹入窗枝。閑憶草堂路，相逢非素期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 6
    },
    {
        "title": "下第後蒙侍郎示意指于新先輩宣恩感謝",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "才薄命如此，自嗟兼自疑。遭逢好文日，黜落至公时。",
            "倚玉甘无路，穿楊卻未期。更慚君侍坐，问许可言诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 7
    },
    {
        "title": "夜泊渭津",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "漂漂東去客，一宿渭城邊。遠處星垂岸，中流月滿船。",
            "涼归夜深簟，秋入雨餘天。漸覺家山小，残程尚幾年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 8
    },
    {
        "title": "晚夏逢友人",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "一別同袍友，相思已十年。長安多在客，久病忽闻蟬。",
            "驟雨才沾地，阴雲不遍天。微涼堪話舊，移榻晚风前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 9
    },
    {
        "title": "秋中夜坐",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "空庭吟坐久，爽氣入荷衣。病葉先秋落，驚禽背月飛。",
            "瘴雲晴未散，戍客老将依。為應金門策，多應说戰机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 10
    },
    {
        "title": "旅遊傷春",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "酒醒鄉關遠，迢迢聽漏終。曙分林影外，春盡雨聲中。",
            "鳥思江村路，花残野岸风。十年成底事，羸馬倦西東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 11
    },
    {
        "title": "得遠书",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "故人居謫宦，今日一书來。良久驚兼喜，殷勤卷更開。",
            "瘴雲沉去雁，江雨促新梅。滿紙殊鄉淚，非冤不可哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 12
    },
    {
        "title": "贈同席",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "四座列吾友，滿園花照衣。一生知幾度，後到擬先归。",
            "急管侵諸樂，嚴城送落暉。當歡莫離席，離席卻歡稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 13
    },
    {
        "title": "贈供奉僧玄觀",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "自得曹溪法，諸經更不看。已降禪侶久，兼作帝師難。",
            "夜木侵簷黑，秋燈照雨寒。如何嫌有著，一念在林巒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 14
    },
    {
        "title": "送琴客",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "楚客抱離思，蜀琴留恨聲。坐來新月上，聽久覺秋生。",
            "夜靜騷人语，天高別鶴鳴。因君興一歎，竟夕意難平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 15
    },
    {
        "title": "別謫者",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "此地闻犹惡，人言是所之。一家书絕久，孤驛夢成迟。",
            "八月三湘道，闻猿冒雨时。不須祠楚相，臣節轉堪疑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 16
    },
    {
        "title": "行思",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "千里豈雲去，欲归如路窮。人間无暇日，馬上又秋风。",
            "破月銜高嶽，流星拂曉空。此时皆在夢，行色独匆匆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 17
    },
    {
        "title": "感懷題從舅宅",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "郗家庭樹下，幾度醉春风。今日花還發，當时事不同。",
            "流言應未息，直道竟難通。徒遣相思者，悲歌向暮空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 18
    },
    {
        "title": "与友人會",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "蟬吟槐蕊落，的的是愁端。病覺離家遠，貧知處事難。",
            "真交无所隱，深语有餘歡。未必闻歌吹，羈心得暫寬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 19
    },
    {
        "title": "贈春遊侶",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "密林多暗香，輕吹送餘芳。啼鳥愁春盡，遊人喜日長。",
            "浮雲橫暮色，新雨洗韶光。欲散垂□恨，應須入醉鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 20
    },
    {
        "title": "送人游邊",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "愁指蕭關外，风沙入遠程。馬行初有跡，雨落竟无聲。",
            "地理全归漢，天威不在兵。西京逢故老，暗喜複时平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 21
    },
    {
        "title": "寄棲白上人",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "剪發兼成隱，将心更屬文。无憀對豪客，不拜謁吾君。",
            "画壁惟泉石，經窗半典墳。归林幽鳥狎，乞食病僧分。",
            "默坐終清夜，凝思念碧雲。相逢應未卜，餘正走囂氛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 22
    },
    {
        "title": "送人入新羅使",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "雞林君欲去，立冊付星軺。越海程難计，征帆影自飄。",
            "望鄉當落日，懷闕羨回潮。宿霧蒙青嶂，驚波蕩碧霄。",
            "春生阳氣早，天接祖州遙。愁約三年外，相迎上石橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 23
    },
    {
        "title": "詠鐵馬鞭",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "漢将臨流得鐵鞭，鄂侯名字舊雕鐫。須為聖代无雙物，",
            "时來終薦明君用，莫歎沉埋二百年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 24
    },
    {
        "title": "送友人",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "舉世谁能与事期，解攜多是正歡时。人間不遣有名利，",
            "我今漂泊還如此，江劍相逢亦未知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 25
    },
    {
        "title": "南潭",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "匝岸青蕪掩古苔，面山亭樹枕潭開。有时弦管收筵促，",
            "人傳郭惲多遊此，谁見當初泛玉杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 26
    },
    {
        "title": "秋夜作",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "數畝池塘近杜陵，秋天寂寞夜雲凝。芙蓉葉上三更雨，",
            "既逢上國陳诗日，長守林泉亦未能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 27
    },
    {
        "title": "客恨",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "古原南北舊蕭疏，高木风多小雪餘。半夜病吟人寢後，",
            "肥馬王孫定相笑，不知岐路厭樵漁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 28
    },
    {
        "title": "三月盡日",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "江頭從此管弦稀，散盡遊人独未归。",
            "落日已将春色去，残花應逐夜风飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 29
    },
    {
        "title": "綠珠詠",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "洛阳佳麗与芳華，金谷園中見百花。",
            "谁遣當年墜樓死，无人巧笑破孫家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 30
    },
    {
        "title": "贈別",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "又将书劍出孤舟，盡日停橈結遠愁。",
            "莫道江波話離別，江波一去不回流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 31
    },
    {
        "title": "悶书",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "病來難處早秋天，一徑无人樹有蟬。",
            "归计未成书半卷，中宵多夢晝多眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 32
    },
    {
        "title": "傷春",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "即是春风盡，仍沾夜雨归。明朝更來此，兼恐落花稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 33
    },
    {
        "title": "登臨洮望蕭關",
        "author": "李昌符",
        "biography": "",
        "paragraphs": [
            "漸覺风沙暗，蕭關欲到时。兒童能探火，婦女解縫旗。",
            "川少銜魚鹭，林多帶箭麋。暫來戎馬地，不敢苦吟诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零一",
        "no#": 34
    }
]