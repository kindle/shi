[
    {
        "title": "閿鄉寓居十首：阿對泉",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "六载抽毫侍禁闈，可堪多病決然归。",
            "五陵年少如相问，阿對泉頭一布衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 1
    },
    {
        "title": "閿鄉寓居十首：蛙聲",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "稚圭倫鑒未精通，只把蛙聲鼓吹同。",
            "君聽月明人靜夜，肯饒天籟与松风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 2
    },
    {
        "title": "閿鄉寓居十首：茆堂",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "結得茆簷瞰碧溪，閑雲之外不同棲。",
            "犹嫌未遠函關道，正睡剛闻報曉雞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 3
    },
    {
        "title": "閿鄉寓居十首：清溪",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "清溪見底露蒼苔，密竹垂藤鎖不開。",
            "應是仙家在深處，愛流花片引人來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 4
    },
    {
        "title": "閿鄉寓居十首：釣竿",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "曾拋釣渚入秦關，今卻持竿傍碧灘。",
            "認得舊溪兼舊意，恰如羊祜识金環。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 5
    },
    {
        "title": "閿鄉寓居十首：山僧",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "石臼山頭有一僧，朝无香積夜无燈。",
            "近嫌俗客知蹤跡，擬向中方斷石層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 6
    },
    {
        "title": "閿鄉寓居十首：小徑",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "礙竹妨花一徑幽，攀援可到玉峰頭。",
            "若教須作康莊好，更有高車駟馬憂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 7
    },
    {
        "title": "閿鄉寓居十首：闻提壺鳥",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "早於批鵊巧於鶯，故國春林足此聲。",
            "今在天涯別館裏，為君沽酒複何情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 8
    },
    {
        "title": "閿鄉寓居十首：木塔偶題",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "西南古刹近芳林，偶得高秋試一吟。",
            "无限黃花襯黃葉，可須春月始傷心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 9
    },
    {
        "title": "閿鄉寓居十首：山禽",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "碧嶂為家煙外棲，銜紅啄翠入芳蹊。",
            "可能知我心无定，频嫋花枝拂面啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 10
    },
    {
        "title": "闻歌",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "貫珠一夜奏累累，儘是荀家舊教詞。",
            "落盡梁塵腸不斷，九原谁報小怜知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 11
    },
    {
        "title": "即席",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "竹引絲隨嫋翠樓，滿筵驚動玉關秋。",
            "何人借与丹青筆，画取當时八字愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 12
    },
    {
        "title": "便殿候對",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "宣呼晝入蕊珠宮，玉女窗扉薄霧籠。",
            "待得華胥春夢覺，半竿斜日下廂风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 13
    },
    {
        "title": "南遷途中作七首：登七盤嶺二首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "才非賈傅亦遷官，五月驅羸上七盤。",
            "從此自知身计定，不能回首望長安。",
            "七盤嶺上一長號，将謂青天鑒郁陶。",
            "近日青天都不鑒，七盤應是未高高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 14
    },
    {
        "title": "南遷途中作七首：渡漢江初嘗鯿魚有作",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "嘯父知机先憶魚，季鷹无事已思鱸。",
            "自慚初识查頭味，正是棲棲哭阮塗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 15
    },
    {
        "title": "南遷途中作七首：溪翁",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "飯稻羹菰曉複昏，碧灘聲裏長諸孫。",
            "應嗟独上涔阳客，排比椒漿奠楚魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 16
    },
    {
        "title": "南遷途中作七首：寄友人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "驚魂往往坐疑飄，便好為文慰寂寥。",
            "若待清湘葬魚了，縱然招得不堪招。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 17
    },
    {
        "title": "南遷途中作七首：途中偶懷",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "无路能酬國士恩，短亭寂寂到黃昏。",
            "回腸一寸危如線，賴得商山未有猿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 18
    },
    {
        "title": "南遷途中作七首：訪貫休上人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "休公為我設蘭湯，方便教人學洗腸。",
            "自覺塵纓頓瀟灑，南行不復问滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 19
    },
    {
        "title": "鴛鴦",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "翠翹紅頸覆金衣，灘上雙雙去又归。",
            "長短死生无两處，可怜黃鵠愛分飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 20
    },
    {
        "title": "野步",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一曲两曲澗邊草，千枝万枝村落花。",
            "攜筇深去不知處，幾歎山阿隔酒家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 21
    },
    {
        "title": "酬僧",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "玉堂全不限常朝，臥待重城宿霧銷。",
            "翻憶故山深雪裏，滿爐枯柏帶煙燒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 22
    },
    {
        "title": "買帶花櫻桃",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "粉紅輕淺靚妝新，和露和煙別近鄰。",
            "万一有情應有恨，一年榮落两家春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 23
    },
    {
        "title": "海棠二首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "太尉園林两樹春，年年奔走探花人。",
            "今來独倚荊山看，回首長安落戰塵。",
            "雲綻霞鋪錦水頭，占春顏色最风流。",
            "若教更近天街種，馬上多逢醉五侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 24
    },
    {
        "title": "送僧上峽归東蜀",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "巴字江流一棹回，紫袈裟是禁中裁。",
            "如從十二峰前過，莫賦佳人殊未來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 25
    },
    {
        "title": "杏花",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "春物競相妒，杏花應最嬌。紅輕欲愁殺，粉薄似啼銷。",
            "愿作南華蝶，翩翩繞此條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 26
    },
    {
        "title": "草",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "染亦不可成，画亦不可得。萇弘未死时，應无此顏色。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 27
    },
    {
        "title": "和楊侍郎",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "目極家山遠，身拘禁苑深。煙霄慚暮齒，麋鹿愧初心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 28
    },
    {
        "title": "山居喜友人相訪",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "秋雨空山夜，非君不此來。高於剡溪雪，一棹到門回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 29
    },
    {
        "title": "遠山",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "隱隱隔千里，巍巍知幾重。平时未能去，夢斷一聲鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 30
    },
    {
        "title": "江樹",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "終日沖奔浪，何年墜乱风。謝公堪入詠，目極在雲中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 31
    },
    {
        "title": "薔薇",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "万卉春风度，繁花夏景長。館娃人盡醉，西子始新妝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 32
    },
    {
        "title": "梅雨",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "渾開又密望中迷，乳燕归迟粉竹低。撲地暗來飛野馬，",
            "少傍海邊飄泊處，中庭自有两犁泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 33
    },
    {
        "title": "登途懷友人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "日落野原秀，雨餘雲物閑。清时正愁絕，高處正躋攀。",
            "京洛遙天外，江河戰鼓間。孤懷欲谁寄，應望塞鴻還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 34
    },
    {
        "title": "闻蟬",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "夏在先催過，秋賒已被迎。自應人不會，莫道物无情。",
            "木葉縱未落，鬢絲還易生。西风正相乱，休上夕阳城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 35
    },
    {
        "title": "秋色",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "染不成幹画未銷，霏霏拂拂又迢迢。",
            "曾從建业城邊路，蔓草寒煙鎖六朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 36
    },
    {
        "title": "自諷",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "本是滄洲把釣人，无端三署接清塵。",
            "從來不解長流涕，也渡湘漓作逐臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 37
    },
    {
        "title": "宿青雲驛",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "蒼黃負譴走商顏，保得微躬出武關。",
            "今夜青雲驛前月，伴吟應到落西山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 38
    },
    {
        "title": "秋闻子規",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "年年春恨化冤魂，血染枝紅壓疊繁。",
            "正是西风花落盡，不知何處認啼痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 39
    },
    {
        "title": "荊南席上闻歌",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "迎愁斂黛一聲分，吊屈江邊日暮闻。",
            "何事遏雲翻不定，自緣蹤跡愛行雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 40
    },
    {
        "title": "武關",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "时來时去若回圈，雙闔平雲謾鎖山。只地道教秦設險，",
            "爭得便如岩下水，從他興廢自潺潺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 41
    },
    {
        "title": "月夕追事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "曾聽豪家碧玉歌，雲床冰簟落秋河。月臨高閣簾无影，",
            "此时空見清涼影，來伴蛩聲咽砌莎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 42
    },
    {
        "title": "上阳宮辭",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "苑路青青半是苔，翠華西去未知回。景阳春漏无人報，",
            "谁能賦得長門事，不惜千金奉酒杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 43
    },
    {
        "title": "送于員外归隱藍田",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "曾吟工部两峰寒，今日星郎得掛冠。吾道不行归始是，",
            "若遇秦时雪髯客，紫芝兼可備朝餐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 44
    },
    {
        "title": "廢宅",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "风飄碧瓦雨摧垣，卻有鄰人与鎖門。幾樹好花閑白晝，",
            "不独淒涼眼前事，咸阳一火便成原。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 45
    },
    {
        "title": "湖州晚望",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "鼓角迎秋晚韵長，斷虹疏雨間微阳。两條溪水分頭碧，",
            "他年若得壺中術，一簇汀洲盡貯将。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 46
    },
    {
        "title": "宋玉宅",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "草白煙寒半野陂，臨江舊宅指遺基。已懷湘浦招魂事，",
            "今朝送別還經此，吟斷當年幾许悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 47
    },
    {
        "title": "春晚书懷",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "落盡紅芳春意闌，綠蕪空鎖辟疆園。嫦娥斷影霜輪冷，",
            "晚來雖共残鶯約，爭奈风淒又雨昏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 48
    },
    {
        "title": "寄楊侍郎",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "雲情鶴態莫誇慵，正上仙樓十二重。吟逸易沈鳷鵲月，",
            "何事春來待归隱，探知溪畔有风松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 49
    },
    {
        "title": "杏花",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "粉薄紅輕掩斂羞，花中占斷得风流。軟非因醉都无力，",
            "裴回盡日難成別，更待黃昏對酒樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 50
    },
    {
        "title": "憲丞裴公上洛退居有寄二首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "鴻在冥冥已自由，紫芝峰下更高秋。拋來簪紱都如夢，",
            "自嗟不得從公去，共上仙家十二樓。",
            "瘦如仙鶴爽风篁，外卻塵囂興緒長。偶坐幾回沈皓月，",
            "目斷瓊林攀不得，一重丹水抵三湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 51
    },
    {
        "title": "叢祠",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "叢祠一炬照秦川，雨散雲飛二十年。長路未归萍逐水，",
            "何必向來曾识面，拂塵看字也淒然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 52
    },
    {
        "title": "分水嶺",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "两派潺湲不暫停，嶺頭長瀉別離情。南隨去馬通巴棧，",
            "紫溪舊隱還如此，清夜梁山月更明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 53
    },
    {
        "title": "赴職西川過便橋书懷寄同年",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "平門橋下水東馳，万里從军一望时。鄉思旋生芳草見，",
            "不是傷春愛回首，杏壇恩重馬迟迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 54
    },
    {
        "title": "太保中书令军前新樓",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "十二闌幹壓錦城，半空人语落灘聲。风流近接平津閣，",
            "不知捧詔朝天后，谁此登臨看月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 55
    },
    {
        "title": "玉女廟",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "九清何日降仙霓，掩映荒祠路欲迷。愁黛不開山淺淺，",
            "若得洗頭盆置此，靚妝无複碧蓮西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 56
    },
    {
        "title": "坤維军前寄江南弟兄",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "二年征戰劍山秋，家在松江白浪頭。關月幾时幹客淚，",
            "独羨一聲南去雁，滿天风雨到汀州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 57
    },
    {
        "title": "滻水席上獻座主侍郎",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "暖泉宮裏告虔回，略避紅塵小宴開。落絮已隨流水去，",
            "莫訝諸生中独醉，感恩傷別正難裁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 58
    },
    {
        "title": "送知古上人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "昔年離別浙河東，多難相逢舊楚宮。振錫才尋三徑草，",
            "不似投荒憔悴客，滄浪无際问漁翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 59
    },
    {
        "title": "和座主尚书登布善寺樓",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "往事何时不系腸，更堪凝睇白雲鄉。楚王城壘空秋色，",
            "谁知此日凭軒處，一筆工夫勝七襄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 60
    },
    {
        "title": "金橋感事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "太行和雪疊晴空，二月春郊尚朔风。飲馬早闻臨渭北，",
            "日暮長亭正愁絕，哀笳一曲戍煙中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 61
    },
    {
        "title": "蕭縣道中",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "戍火三籠滯晚程，枯桑系馬上寒城。滿川落照无人過，",
            "草堂舊隱終归去，寄语岩猿莫曉驚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 62
    },
    {
        "title": "題袞州泗河中石床",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一片苔床水漱痕，何人清賞動乾坤。謫仙醉後雲為態，",
            "邇來多少登臨客，千载谁将勝事論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 63
    },
    {
        "title": "禁直偶书",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "玉皇新複五城居，仙館詞臣在碧虛。錦砌漸看翻芍药，",
            "爭奈滄洲频入夢，白波无際落紅蕖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 64
    },
    {
        "title": "送弟東归",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "偶持麟筆侍金閨，夢想三年在故溪。祖竹定欺簷雪折，",
            "此別更无闲事囑，北山高處謝猿啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 65
    },
    {
        "title": "和座主尚书春日郊居",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "海燕初归朔雁回，靜眠深掩百花台。春蔬已為高僧掇，",
            "謝公難避蒼生意，自古风流必上臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 66
    },
    {
        "title": "僧舍白牡丹二首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "膩若裁雲薄綴霜，春残独自殿群芳。梅妝向日霏霏暖，",
            "天生潔白宜清淨，何必殷紅映洞房。",
            "侯家万朵簇霞丹，若並霜林素豔難。合影只應天際月，",
            "想得惠林凭此檻，肯将榮落意來看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 67
    },
    {
        "title": "八月十五夜禁直寄同僚",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "中秋月滿盡相尋，独入非煙宿禁林。曾恨人間千里隔，",
            "目斷枚皋何處在，闌幹十二憶登臨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 68
    },
    {
        "title": "上巳日花下閑看",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "十裏香塵撲馬飛，碧蓮峰下踏青时。雲鬟照水和花重，",
            "如煙如夢爭尋得，溪柳回頭万万絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 69
    },
    {
        "title": "禪院弈棋偶題",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "裛塵絲雨送微涼，偶出樊籠入道場。半偈已能消万事，",
            "更約西风搖落後，醉來終日臥禪房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 70
    },
    {
        "title": "和张舍人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "玉女盆邊雪未銷，正多春事莫无憀。杏花向日紅勻臉，",
            "陵遷谷變如須问，控鶴山人字子喬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 71
    },
    {
        "title": "送友赴闕",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "故人归去指翔鸞，樂帶離聲可有歡。驛路两行秋吹急，",
            "遙羨從公无一事，探花先醉曲江幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 72
    },
    {
        "title": "過鄧城縣作",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "不用登臨足感傷，古來今往盡茫茫。未知堯桀谁臧否，",
            "到頭一切皆身外，只覺關身是醉鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 73
    },
    {
        "title": "文德初闻車駕東游",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "龍旆叢叢下劍門，還将瑞氣入中原。鼇頭一蕩山雖沒，",
            "自怜閑坐漁磯石，万級雲台落夢魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 74
    },
    {
        "title": "子規",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "舉國繁華委逝川，羽毛飄蕩一年年。他山叫處花成血，",
            "湘江日暮聲淒切，愁殺行人归去船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 75
    },
    {
        "title": "簡州归降賀京兆公",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "分棟山前曙色開，三千鐵騎簡州回。雲間墮箭飛书去，",
            "功名一似淮西事，只是元臣不姓裴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 76
    },
    {
        "title": "登漢州城樓",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "雨餘秋色拂孤城，遠目凝时万象清。疊翠北來千嶂盡，",
            "欲下闌幹一回首，烏归帆沒戍煙明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 77
    },
    {
        "title": "岐下寓居見槐花落因寄從事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "才開便落不勝黃，覆著庭莎襯夕阳。只共蟬催雙鬢老，",
            "蜀國馬卿看從獵，肯将闲事入淒涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 78
    },
    {
        "title": "和人有感",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "莫愁家住石城西，月墜星沈客到迷。一院无人春寂寂，",
            "蘭棹一移风雨急，流鶯千万莫長啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十六",
        "no#": 79
    }
]