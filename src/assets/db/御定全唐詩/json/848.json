[
    {
        "title": "言興",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "矻矻被吟牽，因師賈浪仙。江山风月处，一十二三年。",
            "雅頌在於此，浮華致那邊。犹慚功未至，謾道近千篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 1
    },
    {
        "title": "江上秋思",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "到來江上久，谁念旅遊心。故國无秋信，鄰家有夜砧。",
            "坐遙翻不睡，愁极卻成吟。即恐髭連鬢，還為白所侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 2
    },
    {
        "title": "匡山居",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "无才加性拙，道理合藏蹤。是处非深遠，其山已万重。",
            "經时鄰境戰，独夜隔雲舂。昨日泉中見，常魚亦化龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 3
    },
    {
        "title": "夷陵即事",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "不難饒白发，相续是灘波。避世嫌身晚，思家乞夢多。",
            "暑衣經雪著，凍硯向阳呵。豈謂臨岐路，還闻圣主過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 4
    },
    {
        "title": "紫閣隱者",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "天高紫閣侵，隱者信沉沉。道長年兼長，雲深草複深。",
            "如非禪客見，即是獵人尋。北笑長安道，埃塵古到今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 5
    },
    {
        "title": "与陳陶处士",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "鐘陵城外住，喻似玉沈泥。道直貧嫌殺，神清语亦低。",
            "雪深加酒債，春盡減诗題。記得曾邀宿，山茶独自攜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 6
    },
    {
        "title": "与王嵩隱",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "一生吟興僻，方見业精微。事若終難得，鄉應不易归。",
            "乱收西日葉，雙掩北风扉。合國諸卿相，皆曾著布衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 7
    },
    {
        "title": "懷陸龜蒙处士",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "布褐東南隱，相傳繼謝敷。高譚夫子道，靜看海山图。",
            "事免傷心否，棋逢敵手无。關中花数內，独不見菖蒲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 8
    },
    {
        "title": "寄華阴司空侍郎",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "劍佩已深扃，茅為嶽面亭。诗犹少綺美，画肯愛丹青。",
            "换筆修僧史，焚香閱道經。相邀來未得，但想鶴仪形。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 9
    },
    {
        "title": "送陸肱入關",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "舟行複陸行，始得到咸京。准擬何人口，吹噓六義名。",
            "乱山遙減翠，叢菊早含英。衣錦還鄉日，他时有此榮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 10
    },
    {
        "title": "送劉必先",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "力進凭诗业，心焦闕问安。遠行无处易，孤立本來難。",
            "楚月船中沒，秦星馬上残。明年有公道，更以命推看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 11
    },
    {
        "title": "寄方幹处士",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "格外綴清诗，诗名独得知。闲居公道日，醉臥牡丹时。",
            "海鳥和濤望，山僧帶雪期。仍闻稱处士，圣主肯相違。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 12
    },
    {
        "title": "寄劉逸士",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "无愁无累者，偶向市朝遊。此后乘孤艇，依前入乱流。",
            "高眠歌圣日，下釣坐清秋。道不離方寸，而能混俗求。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 13
    },
    {
        "title": "送独孤处士",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "万里去非忙，惟攜貯药囊。山家宵夜景，酒肆過年光。",
            "立鶴洲侵浪，喧蛩壁近床。谁人臨上路，乞得變髭方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 14
    },
    {
        "title": "早春送人归岳阳",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "久食主人魚，春來復舊居。遠无千里浪，輕有半船书。",
            "過片晴雲淡，消残暮雪虛。岳阳多異境，搜思勿令疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 15
    },
    {
        "title": "冬暮送人",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "長安冬欲盡，又送一遺賢。醉后情渾可，言休理不然。",
            "射衣秦嶺雪，搖月漢江船。亦過春兼夏，回期信有蟬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 16
    },
    {
        "title": "送徐道人東游",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "長安人擾擾，独自有闲心。海上山中去，风前月下吟。",
            "引猿秋果熟，藏鶴曉雲深。易姓更名数，難教弟子尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 17
    },
    {
        "title": "自紀",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "諸机忘盡未忘诗，似向诗中有所依。遠境等闲支枕覓，",
            "欲画淨名居士像，焚香愿見陸探微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 18
    },
    {
        "title": "懷智棲上人",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "臨水登山自有期，不同遊子暮何之。閑眠默坐身堪賞，",
            "思君最易令人老，倚檻空吟所寄诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 19
    },
    {
        "title": "峽中酬荊南鄭准",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "山齋西向蜀江濆，四载安居複有群。风雁勢高犹可見，",
            "每喜溯流賓客说，元瑜刀筆潤雄军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 20
    },
    {
        "title": "寄荊門鄭准",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "傳衣傳缽理難論，綺靡銷磨二雅尊。不许姓名留月觀，",
            "珍重荊門鄭從事，十年同受景升恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 21
    },
    {
        "title": "将欲再游荊渚留辭岐下司徒",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "竹錫銅瓶配衲衣，殷公樓畔偶然離。白蓮幾看從開日，",
            "今朝回去精神別，為得頭廳宰相诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 22
    },
    {
        "title": "贈村公",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "綢衣木突此鄉尊，白盡鬚眉眼未昏。醉舞神筵隨鼓笛，",
            "也笑長安名利处，紅塵半是馬蹄翻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 23
    },
    {
        "title": "秋夜吟",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "梧桐雨畔夜愁吟，抖擻衣裾蘚色侵。",
            "枉道一生无系著，湘南山水別人尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 24
    },
    {
        "title": "讀齊己上人集",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "诗為儒者禪，此格的惟仙。古雅如周頌，清和甚舜弦。",
            "冰生聽瀑句，香發早梅篇。想得吟成夜，文星照楚天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 25
    },
    {
        "title": "除夜",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "九冬三十夜，寒与暖分開。坐到四更后，身添一歲來。",
            "魚燈延臘火，獸炭化春灰。青帝今應老，迎新見幾回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 26
    },
    {
        "title": "送人归鄉",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "多才与命違，末路憶柴扉。白发何人问，青山一劍归。",
            "晴煙独鳥沒，野渡乱花飛。寂寞長亭外，依然空落暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 27
    },
    {
        "title": "述懷",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "青門聊极望，何事久離群。芳草失归路，故鄉空暮雲。",
            "信回陵樹老，夢斷灞流分。兄弟正南北，鴻聲堪独闻。",
            "五城初罷構，海上憶閑行。觸雪麻衣靜，登山竹錫輕。",
            "天寒嶽寺出，日晚島泉清。坐与幽期遇，何湖心渺冥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 28
    },
    {
        "title": "宿壽安甘棠館",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "行人方倦役，到此似還鄉。流水來關外，青山近洛阳。",
            "溪雲归洞鶴，松月半軒霜。坐恐晨鐘動，天涯道路長。",
            "山空蕙气香，乳管折雲房。愿值壺中客，親傳肘后方。",
            "三更禮星斗，寸匕服丹霜。默坐樹阴下，仙經橫石床。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 29
    },
    {
        "title": "送樸山人归新羅",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "浩渺行无极，揚帆但信风。雲山過海半，鄉樹入舟中。",
            "波定遙天出，沙平遠岸窮。離心寄何处，目擊曙霞東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 30
    },
    {
        "title": "宿清遠峽山寺",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "寺近朝天路，多闻玉佩音。鑒人開慧眼，归鳥息禪心。",
            "磬接星河曙，窗連夏木深。此中能宴坐，何必在雲林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 31
    },
    {
        "title": "松山嶺",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "平生閑放久，野鹿许為群。居止鄰西嶽，軒窗度白雲。",
            "齋心飯松子，話道接茅君。漢主恩情去，空山起夕氛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 32
    },
    {
        "title": "句",
        "author": "尚顏",
        "biography": "",
        "paragraphs": [
            "浸浸三楚白，渺渺九江寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 33
    },
    {
        "title": "泊洞庭",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "槐柳未知秋，依依館驛頭。客心俱念遠，时雨自相留。",
            "浪沒貨魚市，帆高賣酒樓。夜來思輾轉，故里在南州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 34
    },
    {
        "title": "善卷壇",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "耕荒鑿原时，高趣在希夷。大舜欲遜國，先生空斂眉。",
            "五溪清不足，千古美无虧。縱遣亡淳者，何人投所思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 35
    },
    {
        "title": "石城金谷",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "晉祚一傾摧，驕奢去不回。只應荊棘地，犹作綺羅灰。",
            "狐兔閑生長，樵蘇靜往來。踟躕意无盡，寒日又西頹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 36
    },
    {
        "title": "庾樓",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "郡樓名甚遠，幾换見樓人。庾亮魂應在，清风到白蘋。",
            "晴軒分楚漢，夜酒揖星辰。何必匡山上，独言无世塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 37
    },
    {
        "title": "經賀監舊居",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "不戀明皇寵，归來鏡水隅。道裝汀鶴识，春醉釣人扶。",
            "逐朵雲如吐，成行雁侶驅。蘭亭名景在，蹤跡未為孤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 38
    },
    {
        "title": "獻鄭都官",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "早晚辭班列，归尋舊隱峰。代移家集在，身老詔书重。",
            "药秘仙都訣，茶開蜀國封。何當答群望，高躡傅岩蹤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 39
    },
    {
        "title": "寄華山司空图二首",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "門徑放莎垂，往來投刺稀。有时開禦劄，特地掛朝衣。",
            "嶽信僧傳去，仙香鶴帶归。他年二南化，无複更衰微。",
            "逍遙短褐成，一劍動精靈。白晝夢仙島，清晨禮道經。",
            "黍苗侵野徑，桑椹汙闲庭。肯要為鄰者，西南太華青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 40
    },
    {
        "title": "贈屏风岩棲蟾上人",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "岩房高且靜，住此幾寒暄。鹿嗅安禪石，猿啼乞食村。",
            "朝阳生樹罅，古路透雲根。独我閑相覓，淒涼碧洞門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 41
    },
    {
        "title": "贈秀才",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "筠阳多勝致，夫子縱游遨。鳳鳥瑞不見，鱸魚價轉高。",
            "門開沙觜靜，船系樹根牢。谁解伊人趣，村沽对郁陶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 42
    },
    {
        "title": "送遷客",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "倏忽墮鵷行，天南去路長。片言曾不諂，獲罪亦何傷。",
            "象戀藏牙浦，人貪賣子鄉。此心終合雪，去已莫思量。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 43
    },
    {
        "title": "哭悼朝賢",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "前昨回私第，旋闻寢疾終。四鄰方響絕，二月牡丹空。",
            "塚已遷名境，碑仍待至公。只應遺愛理，長在楚南风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 44
    },
    {
        "title": "悼方幹处士",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "先生在世日，只向鏡湖居。明主未巡狩，白頭閑釣魚。",
            "煙莎一徑小，洲島四鄰疏。独有為儒者，时來吊舊廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 45
    },
    {
        "title": "聽軒轅先生琴",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "訣妙与功精，通宵膝上橫。一堂风冷淡，千古意分明。",
            "坐客神魂凝，巢禽耳目傾。酷哉商紂世，曾不遇先生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 46
    },
    {
        "title": "芳草",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "綿綿芳草綠，何处動深思。金谷人亡后，沙場日暖时。",
            "龍鱗藏有瑞，风雨灑无私。欲采蘭兼蕙，清香可贈谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 47
    },
    {
        "title": "句",
        "author": "虛中",
        "biography": "",
        "paragraphs": [
            "喜魚在深处，幽鳥立多时。",
            "菖蒲花不豔，鴝鵒性多靈。",
            "盤中是祥瑞，天下恰炎蒸。",
            "待暖還須去，門前有路岐。",
            "春雨无高下，花枝有短長。",
            "老負峨眉月，閑看雲水心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 48
    },
    {
        "title": "短歌行",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "蟾光堪自笑，浮世懶思量。身得幾时活，眼開終日忙。",
            "千門无壽药，一鏡有愁霜。早向塵埃外，光阴任短長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 49
    },
    {
        "title": "除夜",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "九冬三十夜，寒与暖分開。坐到四更后，身添一歲來。",
            "魚燈延臘火，獸炭化春灰。青帝今應老，迎新見幾回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 50
    },
    {
        "title": "宿巴江",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "江聲五十裏，瀉碧急於弦。不觉日又夜，爭教人少年。",
            "一汀巫峽月，两岸子規天。山影似相伴，濃遮到曉船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 51
    },
    {
        "title": "游邊",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "邊雲四顧濃，饑馬嗅枯叢。万里八九月，一身西北风。",
            "偷營天正黑，戰地雪多紅。昨夜東归夢，桃花暖色中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 52
    },
    {
        "title": "居南嶽懷沈彬",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "石房開竹扉，茗外独支頤。万木還无葉，百年能幾时。",
            "隔雲闻狖過，截雨見虹垂。因憶岳南客，晏眠吟好诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 53
    },
    {
        "title": "南中懷友生",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "荔枝江上立，望北幾思量。隔海无书劄，前年在漢阳。",
            "瘴村人起早，銅柱象揩光。居此成何事，尋君過碧湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 54
    },
    {
        "title": "贈南嶽玄泰布衲",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "曹溪入室人，終老甚難群。四十餘年內，青山与白雲。",
            "松和巢鶴看，果共野猿分。海外僧來说，名高自小闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 55
    },
    {
        "title": "寄问政山聶威仪",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "先生臥碧岑，諸祖是知音。得道无一法，孤雲同寸心。",
            "嵐光熏鶴詔，茶味敵人參。苦向壺中去，他年许我尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 56
    },
    {
        "title": "送遷客",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "諫频甘得罪，一騎入南深。若顺吾皇意，即无臣子心。",
            "織花蠻市布，搗月象州砧。蒙雪知何日，凭樓望北吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 57
    },
    {
        "title": "讀齊己上人集",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "诗為儒者禪，此格的惟仙。古雅如周頌，清和甚舜弦。",
            "冰生聽瀑句，香發早梅篇。想得吟成夜，文星照楚天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 58
    },
    {
        "title": "牧童",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "牛得自由騎，春风細雨飛。青山青草裏，一笛一蓑衣。",
            "日出唱歌去，月明撫掌归。何人得似爾，无是亦无非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 59
    },
    {
        "title": "再宿京口禪院",
        "author": "棲蟾",
        "biography": "",
        "paragraphs": [
            "灘聲依舊水溶溶，岸影參差对梵宮。楚樹七回凋舊葉，",
            "多病支郎念行止，晚年生计轉如蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十八",
        "no#": 60
    }
]