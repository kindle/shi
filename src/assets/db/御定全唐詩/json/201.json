[
    {
        "title": "奉和中书舍人賈至早朝大明宮",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "雞鳴紫陌曙光寒，鶯囀皇州春色闌。金闕曉鐘開万戶，",
            "独有鳳凰池上客，阳春一曲和皆難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 1
    },
    {
        "title": "和祠部王員外雪后早朝即事",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "長安雪后似春归，積素凝華連曙暉。色借玉珂迷曉騎，",
            "闻道仙郎歌白雪，由來此曲和人稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 2
    },
    {
        "title": "奉和相公發益昌",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "相國臨戎別帝京，擁麾持節遠橫行。朝登劍閣雲隨馬，",
            "暫到蜀城應计日，須知明主待持衡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 3
    },
    {
        "title": "秋夕讀书幽興，獻兵部李侍郎",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "年紀蹉跎四十強，自怜頭白始為郎。雨滋苔蘚侵階綠，",
            "覽卷試穿鄰舍壁，明燈何惜借餘光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 4
    },
    {
        "title": "使君席夜送嚴河南赴長水",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "嬌歌急管雜青絲，銀燭金杯映翠眉。使君地主能相送，",
            "寄聲報爾山翁道，今日河南勝昔时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 5
    },
    {
        "title": "暮春虢州東亭送李司馬归扶风別廬",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "柳嚲鶯嬌花複殷，紅亭綠酒送君還。到來函谷愁中月，",
            "西望鄉關腸欲斷，对君衫袖淚痕斑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 6
    },
    {
        "title": "九日使君席奉餞衛中丞赴長水",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "節使橫行西出師，鳴弓擐甲羽林兒。臺上霜风淩草木，",
            "為報使君多泛菊，更将弦管醉東籬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 7
    },
    {
        "title": "西掖省即事",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "西掖重雲開曙暉，北山疏雨點朝衣。千門柳色連青瑣，",
            "官拙自悲頭白盡，不如岩下偃荊扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 8
    },
    {
        "title": "首春渭西郊行，呈藍田张二主簿",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "回风度雨渭城西，細草新花踏作泥。秦女峰頭雪未盡，",
            "闻道輞川多勝事，玉壺春酒正堪攜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 9
    },
    {
        "title": "赴嘉州過城固縣，尋永安超禪師房",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "滿寺枇杷冬著花，老僧相見具袈裟。漢王城北雪初霽，",
            "豈料巴川多勝事，為君书此報京華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 10
    },
    {
        "title": "酬暢當嵩山尋麻道士見寄",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "闻逐樵夫閑看棋，忽逢人世是秦时。開雲種玉嫌山淺，",
            "煩君遠示青囊錄，愿得相從一问師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 11
    },
    {
        "title": "和刑部成員外秋夜寓直寄台省知己",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "列宿光三署，仙郎直五宵。时衣天子賜，廚膳大官調。",
            "長樂鐘應近，明光漏不遙。黃門持被覆，侍女捧香燒。",
            "筆為題诗點，燈緣起草挑。竹喧交砌葉，柳嚲拂窗條。",
            "粉署榮新命，霜台憶舊僚。名香播蘭蕙，重價蘊瓊瑤。",
            "擊水翻滄海，摶风透赤霄。微才喜同舍，何幸忽闻韶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 12
    },
    {
        "title": "送盧郎中除杭州赴任",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "罷起郎官草，初分刺史符。海雲迎過楚，江月引归吳。",
            "城底濤聲震，樓端蜃气孤。千家窺驛舫，五馬飲春湖。",
            "柳色供诗用，鶯聲送酒須。知君望鄉处，枉道上姑蘇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 13
    },
    {
        "title": "奉送李賓客荊南迎親",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "迎親辭舊苑，恩詔下儲闈。昨見雙魚去，今看駟馬归。",
            "驛帆湘水闊，客舍楚山稀。手把黃香扇，身披萊子衣。",
            "鵲隨金印喜，烏傍板輿飛。勝作東征賦，還家滿路輝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 14
    },
    {
        "title": "送嚴維下第還江東",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "勿歎今不第，似君殊未迟。且归滄洲去，相送青門时。",
            "望鳥指鄉遠，问人愁路疑。敝裘沾暮雪，归棹帶流澌。",
            "嚴子灘複在，謝公文可追。江皋如有信，莫不寄新诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 15
    },
    {
        "title": "六月三十日水亭送華阴王少府還縣",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "亭晚人将別，池涼酒未酣。關門勞夕夢，仙掌引归驂。",
            "荷葉藏魚艇，藤花罥客簪。残雲收夏暑，新雨帶秋嵐。",
            "失路情无適，離懷思不堪。賴茲庭戶裏，別有小江潭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 16
    },
    {
        "title": "餞王岑判官赴襄阳道",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "故人漢阳使，走馬向南荊。不厭楚山路，只怜襄水清。",
            "津頭習氏宅，江上夫人城。夜入橘花宿，朝穿桐葉行。",
            "害群應自懾，持法固須平。暫得青門醉，斜光速去程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 17
    },
    {
        "title": "送薛弁归河東",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "薛侯故鄉处，五老峰西頭。归路秦樹滅，到鄉河水流。",
            "看君馬首去，滿耳蟬聲愁。獻賦今未售，讀书凡幾秋。",
            "應過伯夷廟，為上關城樓。樓上能相憶，西南指雍州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 18
    },
    {
        "title": "送薛播擢第归河東",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "归去新戰勝，盛名人共闻。鄉連渭川樹，家近條山雲。",
            "夫子能好學，圣朝全用文。弟兄負世譽，詞賦超人群。",
            "雨气醒別酒，城阴低暮曛。遙知出關后，更有一終军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 19
    },
    {
        "title": "送陶銑棄舉荊南覲省",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "明时不愛璧，浪跡東南遊。何必世人识，知君輕五侯。",
            "采蘭度漢水，问絹過荊州。異國有归興，去鄉无客愁。",
            "天寒楚塞雨，月淨襄阳秋。坐見吾道遠，令人看白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 20
    },
    {
        "title": "送史司馬赴崔相公幕",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "崢嶸丞相府，清切鳳凰池。羨爾瑤台鶴，高棲瓊樹枝。",
            "归飛晴日好，吟弄惠风吹。正有乘軒樂，初當學舞时。",
            "珍禽在羅網，微命若遊絲。愿托周南羽，相銜溪水湄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 21
    },
    {
        "title": "送嚴黃門拜御史大夫再鎮蜀川兼覲省",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "授鉞辭金殿，承恩戀玉墀。登壇漢主用，講德蜀人思。",
            "副相韓安國，黃門向子期。刀州重入夢，劍閣再題詞。",
            "春草連青綬，晴花間赤旗。山鶯朝送酒，江月夜供诗。",
            "许國分憂日，榮親色養时。蒼生望已久，來去不應迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 22
    },
    {
        "title": "送郭僕射節制劍南",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "鐵馬擐紅纓，幡旗出禁城。明王親授鉞，丞相欲專征。",
            "玉饌天廚送，金杯禦酒傾。劍門乘嶮過，閣道踏空行。",
            "山鳥驚吹笛，江猿看洗兵。曉雲隨去陣，夜月逐行營。",
            "南仲今时往，西戎计日平。将心感知己，万里寄懸旌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 23
    },
    {
        "title": "早秋与諸子登虢州西亭觀眺",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "亭高出鳥外，客到与雲齊。樹點千家小，天圍万嶺低。",
            "残虹掛陝北，急雨過關西。酒榼緣青壁，瓜田傍綠溪。",
            "微官何足道，愛客且相攜。唯有鄉園处，依依望不迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 24
    },
    {
        "title": "佐郡思舊游",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "幸得趨紫殿，卻憶侍丹墀。史筆眾推直，諫书人莫窺。",
            "平生恒自負，垂老此安卑。同類皆先達，非才独后时。",
            "庭槐宿鳥乱，階草夜蟲悲。白发今无数，青雲未有期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 25
    },
    {
        "title": "滅胡曲",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "都護新滅胡，士馬气亦粗。蕭條虜塵淨，突兀天山孤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 26
    },
    {
        "title": "尚书念舊，垂賜袍衣，率題絕句獻上，以申感謝",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "富貴情還在，相逢豈間然。綈袍更有贈，犹荷故人怜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 27
    },
    {
        "title": "憶長安曲二章寄龐cc",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "東望望長安，正值日初出。長安不可見，喜見長安日。",
            "長安何处在，只在馬蹄下。明日归長安，為君急走馬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 28
    },
    {
        "title": "寄韓樽",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "夫子素多疾，別來未得书。北庭苦寒地，體內今何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 29
    },
    {
        "title": "醉裏送裴子赴鎮西",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "醉后未能別，待醒方送君。看君走馬去，直上天山雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 30
    },
    {
        "title": "題井陘雙溪李道士所居",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "五粒松花酒，雙溪道士家。唯求縮卻地，鄉路莫教賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 31
    },
    {
        "title": "題雲際南峰眼上人讀經堂",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "結宇題三藏，焚香老一峰。雲間独坐臥，只是对山松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 32
    },
    {
        "title": "題梁鍠城中高居",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "高住最高处，千家恒眼前。題诗飲酒后，只对諸峰眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 33
    },
    {
        "title": "題三會寺蒼頡造字台",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "野寺荒台晚，寒天古木悲。空階有鳥跡，犹似造书时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 34
    },
    {
        "title": "日沒賀延磧作",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "沙上見日出，沙上見日沒。悔向万里來，功名是何物。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 35
    },
    {
        "title": "西過渭州，見渭水思秦川",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "渭水東流去，何时到雍州。凭添两行淚，寄向故園流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 36
    },
    {
        "title": "經隴頭分水",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "隴水何年有，潺潺逼路傍。東西流不歇，曾斷幾人腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 37
    },
    {
        "title": "秋思",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "那知芳歲晚，坐見寒葉墮。吾不如腐草，翻飛作螢火。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 38
    },
    {
        "title": "行军九日思長安故園",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "強欲登高去，无人送酒來。遙怜故園菊，應傍戰場開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 39
    },
    {
        "title": "戲題關門",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "來亦一布衣，去亦一布衣。羞見關城吏，還從舊路归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 40
    },
    {
        "title": "歎白发",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "白发生偏速，交人不奈何。今朝两鬢上，更較数莖多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 41
    },
    {
        "title": "題平阳郡汾橋邊柳樹",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "此地曾居住，今來宛似归。可怜汾上柳，相見也依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 42
    },
    {
        "title": "失題",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "帝鄉北近日，瀘口南連蠻。何當遇長房，縮地到京關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 43
    },
    {
        "title": "獻封大夫破播仙凱歌六首",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "漢将承恩西破戎，捷书先奏未央宮。",
            "天子預開麟閣待，只今谁数貳師功。",
            "官军西出過樓蘭，營幕傍臨月窟寒。",
            "蒲海曉霜凝馬尾，蔥山夜雪撲旌竿。",
            "鳴笳疊鼓擁回军，破國平蕃昔未闻。",
            "丈夫鵲印搖邊月，大将龍旗掣海雲。",
            "日落轅門鼓角鳴，千群面縛出蕃城。",
            "洗兵魚海雲迎陣，秣馬龍堆月照營。",
            "蕃军遙見漢家營，滿谷連山遍哭聲。",
            "万箭千刀一夜殺，平明流血浸空城。",
            "暮雨旌旗濕未幹，胡煙白草日光寒。",
            "昨夜将军連曉戰，蕃军只見馬空鞍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 44
    },
    {
        "title": "春興戲題贈李侯",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "黃雀始欲銜花來，君家種桃花未開。",
            "長安二月眼看盡，寄報春风早為催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 45
    },
    {
        "title": "過燕支寄杜位",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "燕支山西酒泉道，北风吹沙卷白草。",
            "長安遙在日光邊，憶君不見令人老。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 46
    },
    {
        "title": "題苜蓿峰寄家人",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "苜蓿峰邊逢立春，胡蘆河上淚沾巾。",
            "閨中只是空相憶，不見沙場愁殺人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 47
    },
    {
        "title": "玉關寄長安李主簿",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "東去長安万里餘，故人何惜一行书。",
            "玉關西望堪腸斷，況複明朝是歲除。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 48
    },
    {
        "title": "武威送劉判官赴磧西行军",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "火山五月行人少，看君馬去疾如鳥。",
            "都護行營太白西，角聲一動胡天曉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 49
    },
    {
        "title": "虢州后亭送李判官使赴晉絳",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "西原驛路掛城頭，客散紅亭雨未收。",
            "君去試看汾水上，白雲犹似漢时秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 50
    },
    {
        "title": "五月四日送王少府归華阴",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "仙掌分明引馬頭，西看一點是關樓。",
            "五月也須應到舍，知君不肯更淹留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 51
    },
    {
        "title": "原頭送範侍禦",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "百尺原頭酒色殷，路傍驄馬汗斑斑。",
            "別君只有相思夢，遮莫千山与万山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 52
    },
    {
        "title": "送李明府赴睦州，便拜覲太夫人",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "手把銅章望海雲，夫人江上泣羅裙。",
            "嚴灘一點舟中月，万里煙波也夢君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 53
    },
    {
        "title": "虢州西山亭子送範端公",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "百尺紅亭对万峰，平明相送到齋鐘。",
            "驄馬勸君皆卸卻，使君家醞舊來濃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 54
    },
    {
        "title": "奉送賈侍禦使江外",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "新騎驄馬複承恩，使出金陵過海門。",
            "荊南渭北難相見，莫惜衫襟著酒痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 55
    },
    {
        "title": "崔倉曹席上送殷寅充石相判官赴淮南",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "清淮无底綠江深，宿处津亭楓樹林。",
            "駟馬欲辭丞相府，一樽須盡故人心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 56
    },
    {
        "title": "送崔子還京",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "匹馬西從天外归，揚鞭只共鳥爭飛。",
            "送君九月交河北，雪裏題诗淚滿衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 57
    },
    {
        "title": "酒泉太守席上醉后作",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "酒泉太守能劍舞，高堂置酒夜擊鼓。",
            "胡笳一曲斷人腸，座上相看淚如雨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 58
    },
    {
        "title": "題觀樓",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "荒樓荒井閉空山，關令乘雲去不還。",
            "羽蓋霓旌何处在，空留药臼向人間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 59
    },
    {
        "title": "草堂村尋羅生不遇",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "数株溪柳色依依，深巷斜阳暮鳥飛。",
            "門前雪滿无人跡，應是先生出未归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 60
    },
    {
        "title": "山房春事二首",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "风恬日暖蕩春光，戲蝶遊蜂乱入房。",
            "数枝門柳低衣桁，一片山花落筆床。",
            "梁園日暮乱飛鴉，极目蕭條三两家。",
            "庭樹不知人死盡，春來還發舊时花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 61
    },
    {
        "title": "逢入京使",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "故園東望路漫漫，雙袖龍鍾淚不幹。",
            "馬上相逢无紙筆，凭君傳语報平安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 62
    },
    {
        "title": "過磧",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "黃沙磧裏客行迷，四望雲天直下低。",
            "為言地盡天還盡，行到安西更向西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 63
    },
    {
        "title": "磧中作",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "走馬西來欲到天，辭家見月两回圓。",
            "今夜不知何处宿，平沙万里絕人煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 64
    },
    {
        "title": "赴北庭度隴思家",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "西向輪台万里餘，也知鄉信日應疏。",
            "隴山鸚鵡能言语，為報家人数寄书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 65
    },
    {
        "title": "胡歌",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "黑姓蕃王貂鼠裘，葡萄宮錦醉纏頭。",
            "關西老将能苦戰，七十行兵仍未休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 66
    },
    {
        "title": "趙将军歌",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "九月天山风似刀，城南獵馬縮寒毛。",
            "将军縱博場場勝，賭得單于貂鼠袍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 67
    },
    {
        "title": "醉戲竇子美人",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "朱唇一點桃花殷，宿妝嬌羞偏髻鬟。",
            "細看只似阳臺女，醉著莫许归巫山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 68
    },
    {
        "title": "秋夜闻笛",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "天門街西闻搗帛，一夜愁殺湘南客。",
            "長安城中百万家，不知何人吹夜笛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 69
    },
    {
        "title": "戲问花門酒家翁",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "老人七十仍沽酒，千壺百甕花門口。",
            "道傍榆莢仍似錢，摘來沽酒君肯否。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 70
    },
    {
        "title": "春夢",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "洞房昨夜春风起，故人尚隔湘江水。",
            "枕上片时春夢中，行盡江南数千里。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 71
    },
    {
        "title": "冬夕",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "浩汗霜风刮天地，溫泉火井无生意。",
            "澤國龍蛇凍不伸，南山瘦柏消残翠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 72
    },
    {
        "title": "句",
        "author": "岑參",
        "biography": "",
        "paragraphs": [
            "初程莫早發，且宿灞橋頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百零一",
        "no#": 73
    }
]