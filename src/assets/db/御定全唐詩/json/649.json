[
    {
        "title": "送崔拾遺出使江東",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "九門思諫諍，万里采风謠。關外逢秋月，天涯過晚潮。",
            "雁飛雲杳杳，木落浦蕭蕭。空怨他鄉別，回舟暮寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 1
    },
    {
        "title": "重阳日送洛阳李丞之任",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "為文通絕境，從宦及良辰。洛下知名早，腰邊結綬新。",
            "且傾浮菊酒，聊拂染衣塵。独恨滄州侶，愁來別故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 2
    },
    {
        "title": "江州送李侍禦归東洛",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "独乘驄馬去，不並旅人還。中外名卿貴，田園高步閑。",
            "暮春經楚縣，新月上淮山。道路空瞻望，軒車不敢攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 3
    },
    {
        "title": "送郭太祝归江東",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "鄉人去欲盡，北雁又南飛。京洛风塵久，江淮音信稀。",
            "舊山知独往，一醉莫相違。未得解羈旅，无勞问是非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 4
    },
    {
        "title": "送李恬及第後還貝州",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "成名年少日，就业聖人书。擢桂谁相比，籝金已不如。",
            "東城送归客，秋日待征車。若到清潭畔，儒风變裏閭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 5
    },
    {
        "title": "收两京後還上都兼訪一二親故",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "離堂千里客，归騎五陵人。路轉函關晚，煙開上苑新。",
            "天涯将野服，闕下見鄉親。问得存亡事，裁诗寄海濱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 6
    },
    {
        "title": "送汶上王明府之任",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "何时到故鄉，归去佩銅章。親友移家盡，閭閻百戰傷。",
            "背關餘草木，出塞足风霜。遺老應相賀，知君不下堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 7
    },
    {
        "title": "湖南使院遣情送江夏賀侍郎",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "雲雨一消散，悠悠關複河。俱從泛舟役，遂隔洞庭波。",
            "楚水去不盡，秋风今更過。无由得相見，卻恨寄书多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 8
    },
    {
        "title": "過申州作",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "万人曾死戰，幾戶免刀兵。井邑初安堵，兒童未長成。",
            "涼风吹古木，野火燒残營。寥落千餘裏，山高水複清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 9
    },
    {
        "title": "汝南過訪田評事",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "移家近漢阴，不復问華簪。買酒宜城遠，燒田夢澤深。",
            "暮山逢鳥入，寒水見魚沈。与物皆无累，終年愜本心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 10
    },
    {
        "title": "送道上人游方",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "律仪通外學，诗思入玄關。煙景隨人別，风姿与物閑。",
            "貫花留靜室，咒水度空山。谁识浮雲意，悠悠天地間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 11
    },
    {
        "title": "送饒州王司法之任兼寄朱處士",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "莫辭還作吏，且喜速回車。留醉悲残歲，含情寄遠书。",
            "共看衰老近，轉覺宦名虛。遙想清溪畔，幽人得自如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 12
    },
    {
        "title": "詹碏山居",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "愛此棲心靜，风塵路已賒。十餘莖野竹，一两樹山花。",
            "繞石開泉細，穿羅引徑斜。无人會幽意，來往在煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 13
    },
    {
        "title": "曉角",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "画角吹残月，寒聲發戍樓。立霜嘶馬怨，攢磧泣兵愁。",
            "燕雁鳴雲畔，胡风冷草頭。罷闻三會後，天迥曉星流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 14
    },
    {
        "title": "冬日",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "燒火掩關坐，窮居客訪稀。凍雲愁暮色，寒日淡斜暉。",
            "穿牖竹风滿，繞庭雲葉飛。已嗟週一歲，羈寓尚何依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 15
    },
    {
        "title": "残秋送友",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "早為千里別，況複是秋残。木葉怨先老，江雲愁暮寒。",
            "交情如水淡，離酒泛杯寬。料想還家後，休吟行路難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 16
    },
    {
        "title": "客行",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "藕葉綴為衣，東西泣路岐。鄉心日落後，身计酒醒时。",
            "觸目多添感，凝情足所思。羈愁難盡遣，行坐一低眉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 17
    },
    {
        "title": "秋夜",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "度鴻驚睡醒，欹枕已三更。夢破寂寥思，燈残零落明。",
            "空窗閑月色，幽壁靜蟲聲。況是離鄉久，依然无限情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 18
    },
    {
        "title": "新月",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "入夜天西見，蛾眉冷素光。潭魚驚釣落，雲雁怯弓张。",
            "隱隱臨珠箔，微微上粉牆。更怜三五夕，仙桂滿輪芳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 19
    },
    {
        "title": "滁上懷周賀",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "就枕忽不寐，孤懷興歎初。南譙收舊曆，上苑絕來书。",
            "暝雪細聲積，晨鐘寒韵疏。侯門昔彈鋏，曾共食江魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 20
    },
    {
        "title": "寄石湓清越上人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "寺處唯高僻，雲生石枕前。靜吟因得句，独夜不妨禪。",
            "窗接停猿樹，岩飛浴鶴泉。相思有书劄，俱倩獵人傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 21
    },
    {
        "title": "陳式水墨山水",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "造化有功力，平分归筆端。溪如冰後聽，山似燒來看。",
            "立意雪髯出，支頤煙汗幹。世間從爾後，應覺致名難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 22
    },
    {
        "title": "陳秀才亭際木蘭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "昔見初栽日，今逢成樹时。存思心更感，繞看步還迟。",
            "蝶舞搖风蕊，鶯啼含露枝。裴回不忍去，應与醉相宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 23
    },
    {
        "title": "贈鏡公",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "幽独度遙夜，夜清神更閑。高风吹越樹，細露濕湖山。",
            "月皎微吟後，鐘鳴不寐間。如教累簪組，此興豈相關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 24
    },
    {
        "title": "登雪竇僧家",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "登寺尋盤道，人煙遠更微。石窗秋見海，山靄暮侵衣。",
            "眾木隨僧老，高泉盡日飛。谁能厭軒冕，來此便忘机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 25
    },
    {
        "title": "途中逢進士许巢",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "聲望去已遠，門人无不知。義行相识處，貧過少年时。",
            "妨寐夜吟苦，愛閑身達迟。難求似君者，我去更逢谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 26
    },
    {
        "title": "贈瑪瑙山禪者",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "芿草不停獸，因師山更靈。村林朝乞食，风雨夜開扃。",
            "井味兼松粉，雲根著淨瓶。塵勞如醉夢，對此暫能醒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 27
    },
    {
        "title": "酬故人陳乂都",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "遠別那无夢，重遊自有期。半年鄉信到，两地赤心知。",
            "坐久吟移調，更長硯結凘。文人才力薄，終怕阿戎欺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 28
    },
    {
        "title": "閏春",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "冪冪複蒼蒼，微和傍早阳。前春寒已盡，待閏日犹長。",
            "柳變雖因雨，花迟豈為霜。自茲延聖曆，谁不駐年光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 29
    },
    {
        "title": "方著作画竹",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "疊葉与高節，俱從毫末生。流傳千古譽，研煉十年情。",
            "向月本无影，臨风疑有聲。吾家釣台畔，似此两三莖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 30
    },
    {
        "title": "題友人山花",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "平明方發盡，為待好风吹。不見移來日，先愁落去时。",
            "濃香熏疊葉，繁朵壓卑枝。坐看皆終夕，遊蜂似有期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 31
    },
    {
        "title": "贈诗僧懷靜",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "幾生餘習在，时複作微吟。坐夏莓苔合，行禪檜柏深。",
            "入山成白首，學道是初心。心地不移變，徒雲寒暑侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 32
    },
    {
        "title": "贈许牘秀才",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "理論与妙用，皆從人外來。山河澄正氣，雪月助宏才。",
            "傲世寄漁艇，藏名归酒杯。升沈在方寸，即恐起风雷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 33
    },
    {
        "title": "送于丹",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "至业是至寶，莫過心自知。时情如甚暢，天道即无私。",
            "入洛霜霰苦，離家蘭菊衰。焚舟不回顧，薄暮又何之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 34
    },
    {
        "title": "送人游日本國",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "蒼茫大荒外，风教即難知。連夜揚帆去，經年到岸迟。",
            "波濤含左界，星斗定東維。或有归风便，當為相見期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 35
    },
    {
        "title": "東溪言事寄于丹",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "日月晝夜轉，年光難駐留。軒窗才過雨，枕簟即知秋。",
            "草際鳥行出，溪中虹影收。唯君壯心在，應笑臥滄洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 36
    },
    {
        "title": "暮發七裏灘夜泊嚴光台下",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "一瞬即七裏，箭馳犹是難。檣邊走嵐翠，枕底失风湍。",
            "但訝猿鳥定，不知霜月寒。前賢竟何益，此地誤垂竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 37
    },
    {
        "title": "處州洞溪",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "氣象四时清，无人画得成。眾山寒疊翠，两派綠分聲。",
            "坐月何曾夜，聽松不似晴。混元融結後，便有此溪名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 38
    },
    {
        "title": "稱心寺中島",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "水木深不極，似将星漢連。中州唯此地，上界別无天。",
            "雪折停猿樹，花藏浴鶴泉。師為終老意，日日複年年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 39
    },
    {
        "title": "歲晚苦寒",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "地氣寒不暢，嚴风无定时。挑燈青燼少，呵筆尺书迟。",
            "白兔沒已久，晨雞僵未知。佇看開聖曆，喧煦立為期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 40
    },
    {
        "title": "杜鵑花",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "未问移栽日，先愁落地时。疏中從間葉，密處莫燒枝。",
            "郢客教谁探，胡蜂是自知。周回两三步，常有醉鄉期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 41
    },
    {
        "title": "山中",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "散拙亦自遂，粗将猿鳥同。飛泉高瀉月，独樹迥含风。",
            "果落盤盂上，雲生篋笥中。未甘明聖日，終作釣漁翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 42
    },
    {
        "title": "路支使小池",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "兒童戲穿鑿，咫尺見津涯。蘚岸和纖草，松泉濺淺沙。",
            "光含半床月，影入一枝花。到此无醒日，當时有習家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 43
    },
    {
        "title": "清源標公",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "師為眾人重，始得眾人師。年到白頭日，行如新戒时。",
            "瓶添放魚澗，窗迥嫋猿枝。此地堪終老，迷癡自不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 44
    },
    {
        "title": "題雪竇禪師壁",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "飛泉濺禪石，瓶注亦生苔。海上山不淺，天邊人自來。",
            "長年隨檜柏，独夜任风雷。獵者闻疏磬，知師入定回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 45
    },
    {
        "title": "重寄金山寺僧",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "风濤匝山寺，磬韵達漁船。此處別師久，遠懷无信傳。",
            "月華妨靜燭，鳥语答幽禪。已見如如理，灰心應不然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 46
    },
    {
        "title": "哭胡珪",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "才高登上第，孝極歿廬塋。一命何无定，片言徒有聲。",
            "故園花自發，新塚月初明。寂寞重泉裏，豈知春物榮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 47
    },
    {
        "title": "与清溪趙明府",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "清規暫趨府，独立与谁親。遂性无非酒，求閑卻愛貧。",
            "林泉應入夢，印綬莫留人。王事闻多暇，吟來幾首新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 48
    },
    {
        "title": "送剡縣陳永秩滿归越",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "俸祿三年後，程途一月間。舟中非客路，鏡裏是家山。",
            "密雪沾行袂，離杯變別顏。古人唯賀滿，今挈解由還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 49
    },
    {
        "title": "示鄉叟",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "暮齒甘衰謝，逢人惜別離。青山前代业，老樹此身移。",
            "買药将衣盡，尋方見字迟。如何鑷残鬢，覽鏡變成絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 50
    },
    {
        "title": "游竹林寺",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "得路到深寺，幽虛曾识名。蘚濃阴砌古，煙起暮香生。",
            "曙月落松翠，石泉流梵聲。闻僧说真理，煩惱自然輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 51
    },
    {
        "title": "陸處士別业",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "问道遠相訪，无人覺路長。夜深回釣楫，月影出书床。",
            "蟬噪蓼花發，禽來山果香。多时欲归去，西望又斜阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 52
    },
    {
        "title": "贈中嶽僧",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "坐來叢木大，谁見入岩年。多病長留药，无憂亦是禪。",
            "支床移片石，舂粟引高泉。盡愿求心法，逢谁即擬傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 53
    },
    {
        "title": "寄普州賈司倉島",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "乱山重複疊，何路訪先生。豈料多才者，空垂不世名。",
            "閑曹犹得醉，薄俸亦勝耕。莫问吟诗石，年年芳草平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 54
    },
    {
        "title": "送鏡空上人游江南",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "去住如雲鶴，飄然不可留。何山逢後夏，一食在孤舟。",
            "細雨蓮塘晚，疏蟬橘岸秋。應懷舊溪月，夜過石窗流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 55
    },
    {
        "title": "新正",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "蓽門惆悵內，时節暗來频。每見新正雪，長思故國春。",
            "雲西斜去雁，江上未归人。又一年為客，何媒得到秦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 56
    },
    {
        "title": "夜聽步虛",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "寂寂永宮裏，天師朝禮聲。步虛闻一曲，渾欲到三清。",
            "瑞草秋风起，仙階夜月明。多年遠塵意，此地欲鋪平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 57
    },
    {
        "title": "題碧溪山禪老",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "師步有雲隨，師情唯鶴知。蘿迷收朮路，雪隔出溪时。",
            "竹狖窺沙井，岩禽停檜枝。由來傲卿相，臥穩答书迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 58
    },
    {
        "title": "寒食宿先天寺无可上人房",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "雙扉檜下開，寄宿石房苔。幡北燈花動，城西雪霰來。",
            "收棋想雲夢，罷茗議天臺。同憶前年臘，師初白閣回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 59
    },
    {
        "title": "中秋月",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "涼霄煙靄外，三五玉蟾秋。列野星辰正，當空鬼魅愁。",
            "泉澄寒魄瑩，露滴冷光浮。未折青青桂，吟看不忍休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 60
    },
    {
        "title": "暮冬书懷呈友人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "空為梁甫吟，谁竟是知音。风雪生寒夜，鄉園來舊心。",
            "滄江孤棹迥，白閣一鐘深。君子久忘我，此懷甘自沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 61
    },
    {
        "title": "贈江南僧",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "忘机室亦空，禪与沃州同。唯有半庭竹，能生竟日风。",
            "思山海月上，出定印香終。繼後傳衣者，還須立雪中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 62
    },
    {
        "title": "柳",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "搖曳惹风吹，臨堤軟勝絲。態濃谁為识，力弱自難持。",
            "學舞枝翻袖，呈妝葉展眉。如何一攀折，懷友又題诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 63
    },
    {
        "title": "送姚合員外赴金州",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "受詔從華省，開旗發帝州。野煙新驛曙，残照古山秋。",
            "樹勢連巴沒，江聲入楚流。唯應化行後，吟句上閑樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 64
    },
    {
        "title": "送江阴霍明府之任",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "遙遙去舸新，浸郭葦兼蘋。樹列巢灘鶴，鄉多釣浦人。",
            "虹分阳羨雨，浪隔廣陵春。知竟三年秩，琴书外是貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 65
    },
    {
        "title": "送友及第归浙東",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "南行无俗侶，秋雁与寒雲。野趣自多愜，鄉名人共闻。",
            "吳山中路斷，浙水半江分。此地登臨慣，攄情一送君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 66
    },
    {
        "title": "山中即事",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "趨世非身事，山中適性情。野花多異色，幽鳥少凡聲。",
            "樹影搜涼臥，苔光破碧行。閑尋采药處，仙路漸分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 67
    },
    {
        "title": "過黃州作",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "弭節齊安郡，孤城百戰残。傍村林有虎，帶郭縣无官。",
            "暮角梅花怨，清江桂影寒。黍離緣底事，撩我起長歎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百四十九",
        "no#": 68
    }
]