[
    {
        "title": "送水部张郎中彥回宰洛阳",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "何遜蘭休握，陶潛柳正垂。官清真塞詔，事簡好吟诗。",
            "春漏懷丹闕，涼船泛碧伊。已虛西閣位，朝夕鳳书追。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 1
    },
    {
        "title": "贈咸阳王主簿",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "可愛咸阳王主簿，窮經盡到昔賢心。登科未足酬多學，",
            "我來賒酒相留宿，聽我披衣看雪吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 2
    },
    {
        "title": "松",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "下視垂楊拂路塵，雙峰石上覆苔文。濃霜滿徑无紅葉，",
            "那堪寂寞悲风起，千樹深藏李白墳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 3
    },
    {
        "title": "梅",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "江國正寒春信穩，嶺頭枝上雪飄飄。何言落处堪惆悵，",
            "離人南去腸應斷，片片隨鞭過楚橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 4
    },
    {
        "title": "鶴",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "一自王喬放自由，俗人行处懶回頭。睡輕旋觉松花墮，",
            "應嫌白鹭无仙骨，長伴漁翁宿葦洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 5
    },
    {
        "title": "重阳夜旅懷",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "強插黃花三两枝，還图一醉浸愁眉。",
            "半床斜月醉醒后，惆悵多於未醉时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 6
    },
    {
        "title": "壬戌西幸后",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "武德門前顥气新，雪融鴛瓦土膏春。",
            "夜來夢到宣麻处，草沒龍墀不見人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 7
    },
    {
        "title": "多虞",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "多虞難住人稀处，近耗渾无戰罷棋。",
            "向闕归山俱未得，且沽春酒且吟诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 8
    },
    {
        "title": "短褐",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "閑披短褐杖山藤，頭不是僧心是僧。",
            "坐睡觉來清夜半，芭蕉影動道場燈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 9
    },
    {
        "title": "曲江紅杏",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "遮莫江頭柳色遮，日濃鶯睡一枝斜。",
            "女郎折得殷勤看，道是春风及第花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 10
    },
    {
        "title": "折得梅",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "寒步江村折得梅，孤香不肯待春催。",
            "滿枝儘是愁人淚，莫殢朝來露濕來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 11
    },
    {
        "title": "牡丹",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "画堂簾卷张清宴，含香帶霧情无限。",
            "春风愛惜未放開，柘枝鼓振紅英綻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 12
    },
    {
        "title": "寂寞",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "江郡人稀便是村，踏青天气欲黃昏。",
            "春愁不破還成醉，衣上淚痕和酒痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 13
    },
    {
        "title": "乱后灞上",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "柳絲牽水杏房紅，煙岸人稀草色中。",
            "日暮一行高鳥处，依稀合是望春宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 14
    },
    {
        "title": "長門怨二首",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "閑把羅衣泣鳳凰，先朝曾教舞霓裳。",
            "春來卻羨庭花落，得逐晴风出禁牆。",
            "流水君恩共不回，杏花爭忍掃成堆。",
            "残春未必多煙雨，淚滴閑階長綠苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 15
    },
    {
        "title": "郊野戲題",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "竹巷溪橋天气涼，荷開稻熟村酒香。",
            "唯憂野叟相回避，莫道儂家是漢郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 16
    },
    {
        "title": "宗人惠四药",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "宗人忽惠西山药，四味清新香助茶。",
            "爽得心神便騎鶴，何須燒得白朱砂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 17
    },
    {
        "title": "題张衡廟",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "遠俗只凭淫祀切，多年平子固悠悠。",
            "江煙日午无簫鼓，直到如今詠四愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 18
    },
    {
        "title": "山鳥",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "驚飛失勢粉牆高，好個聲音好羽毛。",
            "小婢不須催柘彈，且從枝上吃櫻桃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 19
    },
    {
        "title": "黯然",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "搢紳奔避複淪亡，消息春來到水鄉。",
            "屈指故人能幾许，月明花好更悲涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 20
    },
    {
        "title": "借薛尚书集",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "江天冬暖似花时，上國音塵杳未知。",
            "正被蟲聲喧老耳，今君又借薛能诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 21
    },
    {
        "title": "小北廳閑題",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "冷曹孤宦本相宜，山在牆南落照时。",
            "洗竹澆莎足公事，一來贏写一聯诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 22
    },
    {
        "title": "菊",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "日日池邊载酒行，黃昏犹自繞黃英。",
            "重阳過后频來此，甚觉多情勝薄情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 23
    },
    {
        "title": "贈楊夔二首",
        "author": "鄭谷",
        "biography": "",
        "paragraphs": [
            "散賦冗书高且奇，百篇仍有百篇诗。",
            "江湖休灑春风淚，十軸香于一桂枝。",
            "时无韓柳道難窮，也觉天公不至公。",
            "看取年年金榜上，幾人才气似揚雄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十七",
        "no#": 24
    }
]