[
    {
        "title": "山中寄吳磻十韵",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "莫问終休否，林中事已成。盤餐怜火種，歲计付刀耕。",
            "掬水皆花气，聽松似雨聲。书空翹足臥，避險側身行。",
            "果傍閑軒落，蒲連濕岸生。禪生知見理，妻子笑无名。",
            "更擬教诗苦，何曾待酒清。石溪魚不大，月樹鵲多驚。",
            "砌下通樵路，窗間見縣城。雲山任重疊，難隔故交情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 1
    },
    {
        "title": "嘉興縣內池閣",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "指画應心成，周回气象清。床前沙鳥语，案下錦鱗驚。",
            "細柳风吹旋，新荷露壓傾。微芳緣岸落，迸筍入波生。",
            "舴艋舟中醉，莓苔徑上行。高人莫归去，此处勝蓬瀛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 2
    },
    {
        "title": "鏡湖西島言事寄陶校书",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "樵獵两三戶，凋疏是近鄰。风雷前壑雨，花木后岩春。",
            "文字不得力，桑麻難救貧。山禽欺稚子，夜犬吠漁人。",
            "未必圣明代，長将雲水親。知音不延薦，何路出泥塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 3
    },
    {
        "title": "贈趙崇侍禦",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "貴達合逢明圣日，风流又及少年时。才因出眾人皆嫉，",
            "卻教鸚鵡呼桃葉，便遣嬋娟唱竹枝。闲話篇章停燭久，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 4
    },
    {
        "title": "敘龍瑞觀勝異寄于尊師",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "混元融結致功難，山下平湖湖上山。万傾涵虛寒瀲灩，",
            "但有五雲依鶴嶺，曾无陸路向人寰。夜溪漱玉常堪聽，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 5
    },
    {
        "title": "侯郎中新置西湖",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "遠近利民因智力，周回潤物像心源。菰蒲縱感生成惠，",
            "砂泉繞石通山脈，岸木黏萍是浪痕。已見澄來連鏡底，",
            "煙霧未應藏島嶼，鳧鷖亦解避旌幡。雖雲桃葉歌還醉，",
            "能将盛事添元化，一夕机謨万古存。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 6
    },
    {
        "title": "许員外新阳別业",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "蘭汀橘島映亭台，不是經心即手栽。滿閣白雲隨雨去，",
            "柳絮风前欹枕臥，荷花香裏棹舟回。園中認葉封林草，",
            "若因螢火終残卷，便把漁歌送幾杯。多謝郢中賢太守，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 7
    },
    {
        "title": "李侍禦上虞別业",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "滿目亭台嘉木繁，燕蟬吟语不為喧。晝潮勢急吞諸島，",
            "若将明月為儔侶，應把清风遺子孫。繡羽驚弓離果上，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 8
    },
    {
        "title": "題懸溜岩隱者居",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "世人如要问生涯，滿架堆床是五車。谷鳥暮蟬聲四散，",
            "卻用水荷苞綠李，兼将寒井浸甘瓜。慣緣嶮峭收松粉，",
            "坐雲独酌杯盤濕，穿竹微吟路徑斜。見说公卿訪遺逸，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 9
    },
    {
        "title": "山中言事八韵寄李支使",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "豈知經史深相誤，两鬢垂絲百事休。受业幾多為弟子，",
            "竹裏斷雲來枕上，岩邊片月在床頭。過庭急雨和花落，",
            "舊诗改处空留韵，新醞嘗來不滿篘。阮瑀如能问寒餒，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 10
    },
    {
        "title": "山中言事寄贈蘇判官",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "寸心似火频求薦，两鬢如霜始息机。隔岸雞鳴春耨去，",
            "執爨縱曾炊橡實，紉針曾解補荷衣。常凭早月來张燭，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 11
    },
    {
        "title": "獻王大夫",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "高情不与俗人知，恥學諸生取桂枝。荀宋五言行世早，",
            "一鶚難成燕雀伍，非熊本是帝王師。賢臣雖蘊經邦術，",
            "直緣材力頭頭贍，專被文星步步隨。不信重言通造化，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 12
    },
    {
        "title": "淺井",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "夜入明河星似少，曙搖澄碧扇风翻。",
            "細泉細脈難來到，應觉添瓶耗舊痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 13
    },
    {
        "title": "与徐溫話別",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "去去何时卻見君，悠悠煙水似天津。",
            "明年今夜有明月，不是今年看月人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 14
    },
    {
        "title": "出東阳道中作",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "馬首寒山黛色濃，一重重盡一重重。",
            "醉醒已在他人界，犹憶東阳昨夜鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 15
    },
    {
        "title": "酬孫發",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "錦價轉高花更巧，能将舊手弄新梭。",
            "從來一字為褒貶，二十八言犹太多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 16
    },
    {
        "title": "送鄉中故人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "少小与君情不疏，聽君細話勝家书。",
            "如今若到鄉中去，道我垂鉤不釣魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 17
    },
    {
        "title": "思江南",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "昨日草枯今日青，羈人又動望鄉情。",
            "夜來有夢登归路，不到桐廬已及明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 18
    },
    {
        "title": "題寶林寺禪者壁",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "邃岩喬木夏藏寒，床下雲溪枕上看。",
            "台殿漸多山更重，卻令飛去即應難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 19
    },
    {
        "title": "過李群玉故居",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "訐直上书難遇主，銜冤下世未成翁。",
            "琴尊劍鶴谁将去，惟鎖山齋一樹风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 20
    },
    {
        "title": "題玉笥山強处士",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "酒裏藏身岩裏居，刪繁自是一家书。",
            "世人呼爾為漁叟，爾學釣璜非釣魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 21
    },
    {
        "title": "君不來",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "遠路東西欲问谁，寒來无处寄寒衣。",
            "去时初種庭前樹，樹已勝巢人未归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 22
    },
    {
        "title": "經曠禪師舊院",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "谷鳥散啼如有恨，庭花含笑似无情。",
            "更名變貌難休息，去去來來第幾生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 23
    },
    {
        "title": "江南闻新曲",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "席上新聲花下杯，一聲聲被拍聲摧。",
            "樂工不识長安道，儘是书中寄曲來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 24
    },
    {
        "title": "經故侯郎中舊居",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "一朝寂寂与冥冥，壟樹未長墳草青。",
            "高節雄才向何处，夜闌空鎖滿池星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 25
    },
    {
        "title": "越中逢孫百篇",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "上才乘酒到山阴，日日成篇字字金。",
            "鏡水周回千万頃，波瀾倒瀉入君心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 26
    },
    {
        "title": "寄謝麟",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "越國雲溪秀发时，蔣京詞賦謝麟诗。",
            "后來若要知優劣，學圃无過老圃知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 27
    },
    {
        "title": "与長洲陳子美長官",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "枕上愁多百緒牽，常时睡觉在溪前。",
            "人前儘是交親力，莫道升沈總信天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 28
    },
    {
        "title": "新安殷明府家樂方響",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "葛溪鐵片梨園調，耳底丁東十六聲。",
            "彭澤主人怜妙樂，玉杯春暖许同傾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 29
    },
    {
        "title": "別殷明府",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "许教門館久踟躕，仲叔懷恩对玉壺。",
            "唯有離心欲銷客，空垂雙淚不成珠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 30
    },
    {
        "title": "送水墨項处士归天臺",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "仙嶠倍分元化功，揉藍翠色一重重。",
            "還家莫更尋山水，自有雲山在筆峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 31
    },
    {
        "title": "贈會稽楊長官",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "直鉤終日竟无魚，鐘鼓聲中与世疏。",
            "若向湖邊訪幽拙，蕭條四壁是闲居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 32
    },
    {
        "title": "贈申長官",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "言下隨机見物情，看看獄路草還生。",
            "旅人莫怪无魚食，直為寒江水至清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 33
    },
    {
        "title": "将归湖上留別陳宰",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "归去春山逗晚晴，縈回樹石罅中行。",
            "明时不是无知己，自憶湖邊釣与耕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 34
    },
    {
        "title": "貽亮上人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "秋水一泓常見底，澗松千尺不生枝。",
            "人間學佛知多少，淨盡心花只有師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 35
    },
    {
        "title": "貽曦上人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "四十年來多少人，一分零落九成塵。",
            "与師犹得重相見，亦是枯株勉強春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 36
    },
    {
        "title": "书原上鮑处士屋壁",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "水闊坐看千万里，青蕪蓋地接天津。",
            "禰衡莫愛山中靜，繞舍山多卻礙人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 37
    },
    {
        "title": "別孫蜀",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "吳越思君意易傷，別君添我鬢邊霜。",
            "由來浙水偏堪恨，截斷千山作两鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 38
    },
    {
        "title": "贈江上老人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "潭底錦鱗多识釣，未投香餌即先知。",
            "欲教魚目无分別，須學揉藍染釣絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 39
    },
    {
        "title": "贈東溪貧道",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "非唯劍鶴独難留，觸事皆闻被債收。",
            "賴是豪家念寒餒，卻還漁島与漁舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 40
    },
    {
        "title": "詠花",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "狂心醉眼共裴回，一半先開笑未開。",
            "此日不能偷折去，胡蜂直恐趁人來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 41
    },
    {
        "title": "路入金州江中作",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "棹尋椒岸縈回去，数裏时逢一两家。",
            "知是從來貢金处，江邊牧豎亦披沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 42
    },
    {
        "title": "夜會鄭氏昆季林亭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "捲簾圓月照方塘，坐久尊空竹有霜。",
            "白犬吠风驚雁起，犹能一一旋成行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 43
    },
    {
        "title": "題黃山人庭前孤桂",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "映窗孤桂非手植，子落月中闻落时。",
            "仙客此时頭不白，看來看去有枯枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 44
    },
    {
        "title": "送僧南游",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "三秋万里五溪行，风裏孤雲不计程。",
            "若念猩猩解言语，放生先合放猩猩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 45
    },
    {
        "title": "惜花",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "可怜妍豔正當时，剛被狂风一夜吹。",
            "今日流鶯來舊处，百般言语殢空枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 46
    },
    {
        "title": "題天柱觀魚尊師舊院",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "早识吾師频到此，芝童药犬亦相迎。",
            "今師一去无來日，花洞石壇空月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 47
    },
    {
        "title": "東阳道中作",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "百花香气傍行人，花底垂鞭日易醺。",
            "野父不知寒食節，穿林轉壑自燒雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 48
    },
    {
        "title": "題画建溪图",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "六幅輕綃画建溪，刺桐花下路高低。",
            "分明記得曾行处，只欠猿聲与鳥啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 49
    },
    {
        "title": "蜀中",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "遊子去游多不归，春风酒味勝餘时。",
            "閑來卻伴巴兒醉，豆蔻花邊唱竹枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 50
    },
    {
        "title": "衢州別李秀才",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "千山紅樹万山雲，把酒相看日又曛。",
            "一曲驪歌两行淚，更知何处再逢君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 51
    },
    {
        "title": "題君山",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "曾于方外見麻姑，闻说君山自古无。",
            "元是昆侖山頂石，海风吹落洞庭湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 52
    },
    {
        "title": "題嚴子陵祠二首",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "物色旁求至漢庭，一宵同寢見交情。",
            "先生不入雲台像，贏得桐江万古名。",
            "蒼翠雲峰開俗眼，泓澄煙水浸塵心。",
            "惟将道业為芳餌，釣得高名直到今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 53
    },
    {
        "title": "失題",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "十六聲中运手輕，一聲聲似自然聲。",
            "不緣精妙過流輩，爭得江南別有名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 54
    },
    {
        "title": "句",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "弟子已攀桂，先生犹臥雲。",
            "把得新诗草裏論。（幹師徐凝，常刺凝云云，",
            "枯井夜闻鄰果落，廢巢寒見別禽來。（貽天目中峰客，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十三",
        "no#": 55
    }
]