[
    {
        "title": "早春山行",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "江草暖初綠，雁行皆北飛。異鄉那久客，野鳥尚思归。",
            "十载過如夢，素心應已違。行行家漸遠，更苦得书稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 1
    },
    {
        "title": "宿友生林居因懷賈區",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "繞屋樹森森，多棲紫閣禽。暫過當永夜，微得話前心。",
            "入楚行應遠，經湘恨必深。那堪對寒燭，更賦別離吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 2
    },
    {
        "title": "贈賣松人",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "入市雖求利，怜君意独真。劚将寒澗樹，賣与翠樓人。",
            "瘦葉幾經雪，淡花應少春。長安重桃李，徒染六街塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 3
    },
    {
        "title": "友人南游不回因而有寄",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "相思春樹綠，千里亦依依。鄠杜月频滿，瀟湘人未归。",
            "桂花风半落，煙草蝶雙飛。一別无消息，水南車跡稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 4
    },
    {
        "title": "送酂縣董明府之任",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "南北行已久，怜君知苦辛。万家同草木，三载得阳春。",
            "東道聽遊子，夷門歌主人。空持语相送，應怪不沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 5
    },
    {
        "title": "山上樹",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "日暖上山路，鳥啼知已春。忽逢幽隱處，如見独醒人。",
            "石冷開常晚，风多落亦频。樵夫應不识，歲久伐為薪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 6
    },
    {
        "title": "長信宮二首",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "簟涼秋氣初，長信恨何如。拂黛月生指，解鬟雲滿梳。",
            "一從悲画扇，幾度泣前魚。坐聽南宮樂，涼风搖翠裾。",
            "一失輦前恩，綺羅生暗塵。惟應深夜月，独伴向隅人。",
            "長信翠蛾老，昭阳紅粉新。君心似秋節，不使草長春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 7
    },
    {
        "title": "洛阳道",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "浮世若浮雲，千回故複新。旋添青草塚，更有白頭人。",
            "歲暮容将老，雪晴山欲春。行行車与馬，不盡洛阳塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 8
    },
    {
        "title": "東門路",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "東門車馬路，此路在浮沉。白日若不落，紅塵應更深。",
            "從來名利地，皆起是非心。所以青青草，年年生漢阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 9
    },
    {
        "title": "江樓春望",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "樓下長江路，舟車晝不閑。鳥聲非故國，春色是他山。",
            "一望雲複水，幾重河与關。愁心隨落日，万里各西還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 10
    },
    {
        "title": "洛中晴望",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "九陌盡风塵，囂囂晝複昏。古今人不斷，南北路長存。",
            "葉落上阳樹，草衰金谷園。乱鴉归未已，残日半前軒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 11
    },
    {
        "title": "西归",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "不系与舟閑，悠悠吳楚間。羞将新白发，卻到舊青山。",
            "一葉忽離樹，幾人同入關。長安家尚在，秋至又西還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 12
    },
    {
        "title": "南游",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "窮秋幾日雨，處處生蒼苔。舊國寄书後，涼天方雁來。",
            "露繁山草濕，洲暖水花開。去盡同行客，一帆犹未回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 13
    },
    {
        "title": "南遊有感",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "杜陵无厚业，不得駐車輪。重到曾遊處，多非舊主人。",
            "東风千嶺樹，西日一洲蘋。又渡湘江去，湘江水複春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 14
    },
    {
        "title": "夜泊湘江",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "北风吹楚樹，此地独先秋。何事屈原恨，不隨湘水流。",
            "涼天生片月，竟夕伴孤舟。一作南行客，无成空白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 15
    },
    {
        "title": "客中",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "楚人歌竹枝，遊子淚沾衣。異國久為客，寒宵频夢归。",
            "一封书未返，千樹葉皆飛。南過洞庭水，更應消息稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 16
    },
    {
        "title": "夜尋僧不遇",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "數歇度煙水，漸非塵俗間。泉聲入秋寺，月色遍寒山。",
            "石路幾回雪，竹房犹閉關。不知雙樹客，何處与雲閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 17
    },
    {
        "title": "訪道者不遇",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "人間惟此路，長得綠苔衣。及戶无行跡，游方應未归。",
            "平生无限事，到此盡知非。独倚松門久，阴雲昏翠微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 18
    },
    {
        "title": "贈王隱者山居",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "石室掃无塵，人寰与此分。飛來南浦樹，半是華山雲。",
            "浮世幾多事，先生應不闻。寒山滿西日，空照雁成群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 19
    },
    {
        "title": "寄北客",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "窮邊足风慘，何處醉樓臺。家去幾千里，月圓十二回。",
            "寒阡隨日遠，雪路向城開。遊子久无信，年年空雁來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 20
    },
    {
        "title": "寄友人",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "長安清渭東，遊子跡重重。此去紅塵路，難尋君馬蹤。",
            "昔时輕一別，漸老貴相逢。應戀嵩阳住，嵩阳饒古松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 21
    },
    {
        "title": "夜与故人別",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "白日去難駐，故人非舊容。今宵一別後，何處更相逢。",
            "過楚水千里，到秦山幾重。语來天又曉，月落滿城鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 22
    },
    {
        "title": "別故人",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "行子与秋葉，各隨南北风。雖非千里別，還阻一宵同。",
            "過盡少年日，尚如長轉蓬。犹為布衣客，羞入故關中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 23
    },
    {
        "title": "送客東归",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "一聽遊子歌，秋计覺蹉跎。四海少平地，百川无定波。",
            "共驚年已暮，俱向客中多。又駕征輪去，東归事若何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 24
    },
    {
        "title": "過侯王故第",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "過此一酸辛，行人淚有痕。独残新碧樹，犹擁舊朱門。",
            "歌歇雲初散，簷空燕尚存。不知彈鋏客，何處感新恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 25
    },
    {
        "title": "孤雲",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "南北各万里，有雲心更閑。因风離海上，伴月到人間。",
            "洛浦少高樹，長安无舊山。裴回不可駐，漠漠又空還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 26
    },
    {
        "title": "遠水",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "悔作望南浦，望中生遠愁。因知人易老，為有水東流。",
            "欲附故鄉信，不逢归客舟。萋萋两岸草，又度一年秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 27
    },
    {
        "title": "詠蟬",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "江頭一聲起，芳歲已難留。聽此高林上，遙知故國秋。",
            "應催风落葉，似勸客回舟。不是新蟬苦，年年自有愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 28
    },
    {
        "title": "感情",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "青山長寂寞，南望独高歌。四海故人盡，九原新壟多。",
            "西沉浮世日，東注逝川波。不使年華駐，此生能幾何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 29
    },
    {
        "title": "早春日山居寄城郭知己",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "阳和潛發蕩寒阴，便使川原景象新。入戶风泉聲瀝瀝，",
            "雖有眼前诗酒興，遨遊爭得稱闲心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 30
    },
    {
        "title": "勸酒",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "勸君金屈卮，滿酌不須辭。花發多风雨，人生足別離。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 31
    },
    {
        "title": "感懷",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "東风吹草色，空使客蹉跎。不設太平險，更應遊子多。",
            "幾傷行處淚，一曲醉中歌。盡向青門外，東隨渭水波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 32
    },
    {
        "title": "友人亭松",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "俯仰不能去，如逢舊友同。曾因春雪散，見在華山中。",
            "何處有明月，訪君聽遠风。相将归未得，各占石岩東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 33
    },
    {
        "title": "遊中梁山",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "僻地好泉石，何人曾陸沈。不知青嶂外，更有白雲深。",
            "因此見喬木，幾回思舊林。殷勤猿与鳥，惟我独何心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 34
    },
    {
        "title": "尋山",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "到此絕車輪，萋萋草樹春。青山如有利，白石亦成塵。",
            "水闊應无路，松深不見人。如知巢与许，千载跡犹新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 35
    },
    {
        "title": "宿江口",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "南渡人來絕，喧喧雁滿沙。自生江上月，長有客思家。",
            "半夜下霜岸，北风吹荻花。自驚归夢斷，不得到天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 36
    },
    {
        "title": "秋夜達蕭關",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "擾擾浮梁路，人忙月自閑。去年為塞客，今夜宿蕭關。",
            "辭國幾經歲，望鄉空見山。不知江葉下，又作布衣還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 37
    },
    {
        "title": "斜谷道",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "乱峰連疊嶂，千里綠峨峨。蜀國路如此，遊人車亦過。",
            "遠煙當葉斂，驟雨逐风多。独憶紫芝叟，臨风歌舊歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 38
    },
    {
        "title": "過百牢關貽舟中者",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "蜀國少平地，方思京洛間。遠為千里客，來度百牢關。",
            "帆影清江水，鈴聲碧草山。不因名与利，爾我各應閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 39
    },
    {
        "title": "客中覽鏡",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "何當開此鏡，即見發如絲。白日急於水，一年能幾时。",
            "每逢芳草處，長返故園迟。所以多為客，蹉跎欲怨谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 40
    },
    {
        "title": "長安逢隱者",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "征車千里至，碾遍六街塵。向此有營地，忽逢无事人。",
            "昔时顏未改，浮世路多新。且脫衣沽酒，終南山欲春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 41
    },
    {
        "title": "与僧話舊",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "草堂前有山，一見一相寬。處世貴僧靜，青松因歲寒。",
            "他山逢舊侶，盡日話長安。所以閑行跡，千回繞药欄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 42
    },
    {
        "title": "贈王道士",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "日日市朝路，何时无苦辛。不隨丹灶客，終作白頭人。",
            "浮世度千载，桃源方一春。归來華表上，應笑北邙塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十五",
        "no#": 43
    },
    {
        "title": "匣中琴",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "世人无正心，蟲網匣中琴。何以經时廢，非為娛耳音。",
            "独令高韵在，谁感隙塵深。應是南风曲，聲聲不合今。"
        ],
