[
    {
        "title": "秦門：胡亥",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "鹿馬何難辨是非，甯勞蔔筮问安危。",
            "權臣為乱多如此，亡國时君不自知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 1
    },
    {
        "title": "秦門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "盜賊縱橫主惡闻，遂為流矢犯君軒。",
            "怪言何不早言者，若使早言還不存。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 2
    },
    {
        "title": "秦門：趙高",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "趙高胡亥速天誅，率土興兵怨毒痡。豐沛見机群小吏，功成兒戲亦何殊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 3
    },
    {
        "title": "秦門：陳涉",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "秦法煩苛霸业隳，一夫攘臂万夫隨。",
            "王侯无種英雄志，燕雀喧喧安得知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 4
    },
    {
        "title": "秦門：項籍",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "九垓垂定棄謀臣，一陣无功便殺身。",
            "壯士誠知輕性命，不思辜負八千人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 5
    },
    {
        "title": "秦門：范增",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "智士寧為暗主謨，范公曾不讀兵书。",
            "平生心力為谁盡，一事无成空背疽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 6
    },
    {
        "title": "前漢門：高祖",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "愛子從烹報主时，安知強啜不含悲。",
            "太公懸命臨刀幾，忍取杯羹欲為谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 7
    },
    {
        "title": "前漢門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "北伐匈奴事可悲，當时将相是其谁。",
            "君臣束手平城裏，三十万兵能忍饑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 8
    },
    {
        "title": "前漢門：周苛紀信",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "為主堅能不顧身，赴湯蹈火見忠臣。",
            "后來邦國論心義，谁是君王出熱人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 9
    },
    {
        "title": "前漢門：酂侯",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "共怪酂侯第一功，咸稱得地合先封。",
            "韓生不是蕭君薦，獵犬何人為指蹤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 10
    },
    {
        "title": "前漢門：曲逆侯",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "社肉分平未足奇，須觀大用展无私。",
            "一朝如得宰天下，必使還如宰社时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 11
    },
    {
        "title": "前漢門：薛公",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "黥布稱兵孰敢當，薛公三计為斟量。",
            "上中良策知非用，南取長沙是死鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 12
    },
    {
        "title": "前漢門：條侯",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "上将风戈賞罰明，矛鋋嚴閉亞夫營。",
            "人君卻稟将军令，按轡垂鞭為緩行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 13
    },
    {
        "title": "前漢門：平津侯",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "儒素逢时得自媒，忽從徒步列公台。",
            "北辰如不延吾輩，東閣何由逐汝開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 14
    },
    {
        "title": "前漢門：博陸侯",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "棟樑徒自保堅貞，毀穴難防雀鼠爭。",
            "不是主人知詐偽，如何柱石免欹傾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 15
    },
    {
        "title": "前漢門：夏賀良",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "漢代中微亦再昌，忠臣憂國冀修禳。",
            "赤精符讖誠非妄，枉殺无辜夏賀良。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 16
    },
    {
        "title": "前漢門：王莽",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "權归諸呂牝雞鳴，殷鑒昭然詎可輕。",
            "新室不因崇外戚，水中安敢寄生營。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 17
    },
    {
        "title": "前漢門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "重賦嚴刑作禍胎，豈知由此乱離媒。",
            "家傳揖讓亦難濟，況是身從傾篡來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 18
    },
    {
        "title": "前漢門：又吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "銅馬朱眉滿四方，總緣居攝乱天常。",
            "因君多少布衣士，不是公卿即帝王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 19
    },
    {
        "title": "前漢門：毛延壽",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "不拔金釵賂漢臣，徒嗟玉豔委胡塵。",
            "能知貨賄移妍醜，豈独丹青画美人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 20
    },
    {
        "title": "前漢門：劉圣公",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "不納良謀劉演言，胡為銜璧向崇宣。",
            "傷哉乱帝途窮处，何必當时譖福先。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 21
    },
    {
        "title": "前漢門：樊崇徐宣",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "庸中佼佼鐵錚錚，百万長驅入帝京。",
            "首事縱隳三善在，归仁何慮不全生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 22
    },
    {
        "title": "前漢門：僭號公孫述",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "劍蜀金湯孰敢爭，子阳才业匪雄英。",
            "方知在德不在險，危棧何曾阻漢兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 23
    },
    {
        "title": "后漢門：光武",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "成敗非儒孰可量，儒生何指指蕭王。",
            "蕭王得眾能寬裕，吳漢归來帝业昌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 24
    },
    {
        "title": "后漢門：明帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "朝臣咸佞孰知非，张佚公忠语独奇。",
            "博士一言除太傅，諡為明帝信其宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 25
    },
    {
        "title": "后漢門：桓帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "能嫌跋扈斬梁王，甯便榮枯信段张。",
            "襄楷忠言谁佞惑，忍教奸禍起蕭牆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 26
    },
    {
        "title": "后漢門：靈帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "榜懸金價鬻官榮，千万為公五百卿。",
            "公瑾孔明窮退者，安知高臥遇雄英。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 27
    },
    {
        "title": "后漢門：廢帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "乱兵如蝟走王師，社稷顛危孰為持。",
            "夜逐螢光尋道路，漢家天子步归时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 28
    },
    {
        "title": "后漢門：獻帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "只為曹侯数貴人，普天黔首盡黃巾。",
            "漢靈早聽侍中諫，安得獻生稱不辰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 29
    },
    {
        "title": "后漢門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "咸怨刑科有黨偏，耕夫无不事戎旃。",
            "是时老幼饑號处，一斛黃禾五百千。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 30
    },
    {
        "title": "后漢門：子密",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "子密封侯豈所宜，能高德義必无為。",
            "當时若縛還彭氏，率土何憂不自归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 31
    },
    {
        "title": "后漢門：羊续",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "魚懸潔白振清风，祿散親賓歲自窮。",
            "單席寒廳慚使者，葛衣何以至三公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 32
    },
    {
        "title": "后漢門：楊震",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "為國推賢匪惠私，十金為報遽相危。",
            "无言暗室何人見，咫尺斯須已四知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 33
    },
    {
        "title": "后漢門：趙孝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "綠林清旦正朝饑，豈计行人瘦与肥。",
            "為感在原哀叫切，鶺鴒休報聽雙飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 34
    },
    {
        "title": "后漢門：馬后",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "粗衣閑寂閱群书，薦達嬪妃廣帝居。",
            "再實傷根嫌貴寵，惠慈勞悴育皇儲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 35
    },
    {
        "title": "后漢門：魏博妻",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "蘿掛青松是所依，松凋蘿更改何枝。",
            "操刀必割腕可斷，磐石徒堅心不移。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 36
    },
    {
        "title": "后漢門：曹娥",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "心摧目斷哭江濆，窺浪无蹤日又昏。",
            "不入重泉尋水底，此生安得見沈魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 37
    },
    {
        "title": "后漢門：周都妻",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "綠水雙鴛一已沈，皇天更欲配何禽。",
            "不将血涕隨霜刃，谁見朱殷未死心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 38
    },
    {
        "title": "后漢門：鮑宣妻",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "君惡奢華意不歡，一言從儉亦何難。",
            "但能和樂同琴瑟，未必恩情在綺紈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 39
    },
    {
        "title": "后漢門：呂母",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "獄无良吏雪无由，处处戈鋋自執仇。",
            "呂母銜冤窮老婦，亦能為帥複私讎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 40
    },
    {
        "title": "三國門：蜀先主",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "豫州军敗信途窮，徐庶推能薦臥龍。",
            "不是卑詞三訪謁，谁令玄德主巴邛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 41
    },
    {
        "title": "三國門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "一家區宇忽三分，齷齪車书曷足論。",
            "定有伊姜為佐輔，忍教鴻雁各乾坤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 42
    },
    {
        "title": "三國門：后主",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "万峰如劍载前來，危閣橫空信險哉。",
            "对此玄休長歎息，方知劉禪是庸才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 43
    },
    {
        "title": "三國門：吳后主",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "吳宮季主恣驕奢，移盡江南百媚花。",
            "一旦狂风江上起，花隨风散落谁家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 44
    },
    {
        "title": "三國門：王表",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "王表闻聲莫見身，吳中敬事甚君親。",
            "是知邦國将亡滅，不聽人臣聽鬼神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 45
    },
    {
        "title": "三國門：魯肅",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "輕財重義見英奇，圣主賢臣是所依。",
            "公瑾窘饑求子敬，一言才起数船归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 46
    },
    {
        "title": "晉門：晉武帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "漢貪金帛鬻公卿，財贍羸军冀國寧。",
            "晉武鬻官私室富，是知犹不及桓靈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 47
    },
    {
        "title": "晉門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "君人為理在安民，論道求賢德自新。",
            "經國遠图无所问，何曾言指一何神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 48
    },
    {
        "title": "晉門：惠帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "蛙鳴堪笑问官私，更勸饑人食肉糜。",
            "蒙昧万机犹婦女，寇戎安得不紛披。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 49
    },
    {
        "title": "晉門：賈后",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "賈后甘為廢戮人，齊王還殺趙王倫。",
            "一從天下无真主，瓜割中原四百春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 50
    },
    {
        "title": "晉門：懷帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "蕃漢戈矛遍九垓，两京簪紱走黃埃。",
            "劉聰大會平阳日，遣帝行觴事可哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 51
    },
    {
        "title": "晉門：湣帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "耕牛吃盡大田荒，二两黃金糴鬥糧。",
            "禦粥又闻无曲屑，不降胡虜奈饑腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 52
    },
    {
        "title": "晉門：郭欽",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "谁疑忠諫郭欽言，不逐戎夷出塞垣。",
            "晉室既无明圣主，果為胡虜乱中原。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 53
    },
    {
        "title": "晉門：王夷甫",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "六合谁為輔弼臣，八风昏处盡胡塵。",
            "是知濟弱扶傾術，不屬高談虛論人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 54
    },
    {
        "title": "晉門：王茂弘",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "韓魏荊揚日豈堪，胡风看欲過江南。",
            "中原一片生靈血，谁秉王綱色不慚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 55
    },
    {
        "title": "晉門：吳隱之",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "闻说貪泉近郁林，隱之今日得深斟。",
            "徒言滴水能穿石，其那堅貞匪石心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 56
    },
    {
        "title": "晉門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "貪泉何处是泉源，只在靈台一點間。",
            "必也心源元自有，此泉何必在江山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 57
    },
    {
        "title": "六朝門：前趙劉聰",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "戎羯谁令识善言，刑将不舍遽能原。",
            "垂成卻罷鳳仪殿，仍改逍遙納諫園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 58
    },
    {
        "title": "六朝門：前涼张軌",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "官從主簿至專征，谁遣涼王破趙名。",
            "益信用賢由拔擢，穰苴不是将家生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 59
    },
    {
        "title": "六朝門：后魏武帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "太武南征似卷蓬，徐阳兗蔡殺皆空。",
            "從來吊伐寧如此，千里无煙血草紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 60
    },
    {
        "title": "六朝門：三廢帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "明莊節閔並罹殃，命在朱高二悖王。",
            "已歎一年三易换，更嗟毆辱下東廊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 61
    },
    {
        "title": "六朝門：苻堅",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "百万南征幾馬归，叛亡如蝟亦何悲。",
            "賓擒敵國諸戎主，更遣權兵過在谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 62
    },
    {
        "title": "六朝門：再呤",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "空知勇銳不知兵，困獸孤军未可輕。",
            "安有長驅百餘万，身馳幾旅欲先征。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 63
    },
    {
        "title": "六朝門：又吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "水影星光怪異多，不思修德事干戈。",
            "无謀拒諫仍輕敵，國破身擒将奈何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 64
    },
    {
        "title": "六朝門：宋武帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "棲棲老楚未遭时，債主凭陵似迫危。",
            "人傑既為王謐识，刁逵誅斬独何悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 65
    },
    {
        "title": "六朝門：二廢帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "肆意荒狂殺不辜，方嗟廢帝又蒼梧。",
            "自言威震為英武，肯慮湘東与玉夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 66
    },
    {
        "title": "六朝門：齊廢帝東昏侯",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "定策谁扶捕鼠兒，不憂蕭衍畏潘妃。",
            "長圍既合刀臨項，犹惜金錢对落暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 67
    },
    {
        "title": "六朝門：梁武帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "梁武年高厭六龍，繁華聲色盡归空。",
            "不求賢德追堯舜，翻作憂囚一病翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 68
    },
    {
        "title": "六朝門：再吟",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "興亡何故遽環回，湯紂身為事可哀。",
            "莫是自長嫌勝己，蔽賢犹執匹夫才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 69
    },
    {
        "title": "六朝門：簡文帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "救兵方至強抽军，与賊開城是簡文。",
            "曲項琵琶催酒处，不图為樂向谁雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 70
    },
    {
        "title": "六朝門：元帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "木柵江城困魏军，王褒橫議遏謀臣。",
            "賓降未免俱為戮，一死安能謝益仁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 71
    },
    {
        "title": "六朝門：謝舉",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "叛奴逃数豈堪留，忠節曾无肯到頭。",
            "朱異早能同遠見，青衫寧假帝登樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 72
    },
    {
        "title": "六朝門：朱異",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "徒覽儒书不學兵，彥和虛得不廉名。",
            "四郊多壘犹相罪，國破将何謝太清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 73
    },
    {
        "title": "六朝門：傅昭",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "為政残苛獸亦饑，除饑机在養疲羸。",
            "人能善政獸何暴，焉用勞人以檻為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 74
    },
    {
        "title": "六朝門：宣帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "宣帝驕奢恣所為，后宮升降略无时。",
            "乘危自有妻公在，安许鸞凰是尉迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 75
    },
    {
        "title": "六朝門：李集",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "忠諫能堅信正臣，三沈三屈竟何雲。",
            "每沈良久方能语，及语還呼桀紂君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 76
    },
    {
        "title": "隋門：隋文帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "孤兒寡婦忍同欺，輔政剛教篡奪為。",
            "矯詔必能疏昉譯，直臣誠合重顏仪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 77
    },
    {
        "title": "隋門：独孤后",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "腹生奚強有親疏，怜者為賢棄者愚。",
            "儲貳不遭讒構死，隋亡甯便在江都。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 78
    },
    {
        "title": "隋門：煬帝",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "拒諫勞兵作禍基，窮奢极武向戎夷。",
            "兆人疲弊不堪命，天下嗷嗷新主資。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 79
    },
    {
        "title": "隋門：賀若弼",
        "author": "周曇",
        "biography": "",
        "paragraphs": [
            "破敵将军意气豪，請除傾國斬妖嬈。",
            "紅綃忍染嬌春雪，瞪目看行切玉刀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十九",
        "no#": 80
    }
]