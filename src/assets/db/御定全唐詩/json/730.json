[
    {
        "title": "上清辭五首",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "入海浮生汗漫秋，紫皇高宴五雲樓。",
            "霓裳曲罷天风起，吹散仙香滿十洲。",
            "樓鎖彤霞地絕塵，碧桃花發九天春。",
            "東皇近日慵遊宴，閑煞瑤池五色麟。",
            "上清仙路有丹梯，影響行人到即迷。",
            "不會无端個漁父，阿谁教入武陵溪。",
            "本來方朔是真仙，偶別丹台未得還。",
            "何事玉皇消息晚，忍教憔悴向人間。",
            "新拜天官上玉都，紫皇親授五靈符。",
            "群仙個個來相问，人世风光似此无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 1
    },
    {
        "title": "讀三國志",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "有國由來在得賢，莫言興廢是回圈。",
            "武侯星落周瑜死，平蜀降吳似等闲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 2
    },
    {
        "title": "山舍南溪小桃花",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "一樹繁英奪眼紅，開时先合占東风。",
            "可怜地僻无人賞，拋擲深山乱木中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 3
    },
    {
        "title": "春行遇雨",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "夾路輕风撼柳條，雨侵春態動无憀。采香陌上谁家女，濕損釵頭翡翠翹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 4
    },
    {
        "title": "登樓寄遠",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "滿城春色花如雪，极目煙光月似鉤。",
            "總是動人鄉思处，更堪容易上高樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 5
    },
    {
        "title": "望思台",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "漢武年高慢帝图，任人曾不问賢愚。",
            "直饒四老依前出，消得江充寵佞无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 6
    },
    {
        "title": "山舍偶題",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "門掩松蘿一徑深，偶攜藜杖出前林。",
            "谁知盡日看山坐，万古興亡總在心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 7
    },
    {
        "title": "荊溪夜泊",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "點點漁燈照浪清，水煙疏碧月朧明。",
            "小灘驚起鴛鴦处，一雙採蓮船過聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 8
    },
    {
        "title": "旅舍臥病",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "家隔西秦无遠信，身隨東洛度流年。",
            "病來旅館谁相问，牢落闲庭一樹蟬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 9
    },
    {
        "title": "登昭福寺樓",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "旅懷秋興正无涯，独倚危樓四望賒。",
            "谷變陵遷何处问，滿川空有舊煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 10
    },
    {
        "title": "代邊将",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "雪凍阴河半夜风，戰回狂虜血漂紅。",
            "據鞍遙指長安路，須刻麟台第一功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 11
    },
    {
        "title": "夜与张舒話別",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "愁聽南樓角又吹，曉雞啼后更分離。",
            "如何銷得淒涼思，更勸燈前酒一卮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 12
    },
    {
        "title": "寒梅詞",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "霜梅先拆嶺頭枝，万卉千花凍不知。",
            "留得和羹滋味在，任他风雪苦相欺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 13
    },
    {
        "title": "題靈泉寺",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "入谷先生一陣香，異花奇木簇禪堂。",
            "可怜門外高低路，万轂千蹄日日忙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 14
    },
    {
        "title": "宿张正字別业",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "茅屋蕭寥煙暗后，松窗寂曆月明初。",
            "此时谁念孤吟客，唯有黃公一帙书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 15
    },
    {
        "title": "鶴",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "天上瑤池覆五雲，玉麟金鳳好為群。",
            "不須更飲人間水，直是清流也汗君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 16
    },
    {
        "title": "過相思谷",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "悠悠信馬春山曲，芳草和煙鋪嫩綠。",
            "正被離愁著莫人，那堪更過相思谷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 17
    },
    {
        "title": "写莊子",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "圣澤安排當散地，賢侯優貸借新居。",
            "閑中亦有閑生计，写得南華一部书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 18
    },
    {
        "title": "山中寄友人",
        "author": "李九齡",
        "biography": "",
        "paragraphs": [
            "乱雲堆裏結茅廬，已共紅塵跡漸疏。",
            "莫问野人生计事，窗前流水枕前书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十",
        "no#": 19
    }
]