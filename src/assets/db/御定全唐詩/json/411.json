[
    {
        "title": "杏園",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "浩浩長安車馬塵，狂风吹送每年春。",
            "門前本是虛空界，何事栽花誤世人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 1
    },
    {
        "title": "酬哥舒大少府寄同年科第",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "前年科第偏年少，未解知羞最愛狂。九陌爭馳好鞍馬，",
            "賴得官閑且疏散，到君花下憶諸郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 3
    },
    {
        "title": "幽棲",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "野人自愛幽棲所，近对長松遠是山。盡日望雲心不系，",
            "遼海若思千歲鶴，且留城市會飛還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 4
    },
    {
        "title": "清都春霽，寄胡三、吳十一",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "蕊珠宮殿經微雨，草樹无塵耀眼光。白日當空天气暖，",
            "时節催年春不住，武陵花謝憶諸郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 5
    },
    {
        "title": "華嶽寺",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "山前古寺臨長道，來往淹留為愛山。雙燕營巢始西別，",
            "羞見竇師无外役，竹窗依舊老身閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 6
    },
    {
        "title": "天壇上境",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "野人性僻窮深僻，芸署官閑不似官。万里洞中朝玉帝，",
            "因為南昌檢仙籍，馬君家世奉還丹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 7
    },
    {
        "title": "尋西明寺僧不在",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "春來日日到西林，飛錫經行不可尋。",
            "蓮池舊是无波水，莫逐狂风起浪心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 8
    },
    {
        "title": "与吳侍禦春遊",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "蒼龍闕下陪驄馬，紫閣峰頭見白雲。",
            "滿眼流光隨日度，今朝花落更紛紛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 9
    },
    {
        "title": "晚春",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "晝靜簾疏燕语频，雙雙鬥雀動階塵。",
            "柴扉日暮隨风掩，落盡閑花不見人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 10
    },
    {
        "title": "先醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "今日樽前敗飲名，三杯未盡不能傾。",
            "怪來花下長先醉，半是春风蕩酒情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 11
    },
    {
        "title": "独醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "一樹芳菲也當春，漫隨車馬擁行塵。",
            "桃花解笑鶯能语，自醉自眠那藉人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 12
    },
    {
        "title": "宿醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "风引春心不自由，等闲沖席飲多籌。",
            "朝來始向花前觉，度卻醒时一夜愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 13
    },
    {
        "title": "懼醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "闻道秋來怯夜寒，不辭泥水為杯盤。",
            "殷勤懼醉有深意，愁到醒时燈火闌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 14
    },
    {
        "title": "羨醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "綺陌高樓競醉眠，共期憔悴不相怜。",
            "也應自有尋春日，虛度而今正少年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 15
    },
    {
        "title": "憶醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "自歎旅人行意速，每嫌杯酒緩归期。",
            "今朝偏遇醒时別，淚落风前憶醉时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 16
    },
    {
        "title": "病醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "醉伴見儂因病酒，道儂无酒不相窺。",
            "那知下药還沽底，人去人來剩一卮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 17
    },
    {
        "title": "《擬醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "九月閑宵初向火，一尊清酒始行杯。",
            "怜君城外遙相憶，冒雨沖泥黑地來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 18
    },
    {
        "title": "勸醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "竇家能釀銷愁酒，但是愁人便与銷。",
            "愿我共君俱寂寞，只應連夜複連朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 19
    },
    {
        "title": "任醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "本怕酒醒渾不飲，因君相勸觉情來。",
            "殷勤滿酌從聽醉，乍可欲醒還一杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 20
    },
    {
        "title": "同醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "柏樹台中推事人，杏花壇上煉形真。",
            "心源一種閑如水，同醉櫻桃林下春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 21
    },
    {
        "title": "狂醉",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "一自柏台為禦史，二年辜負两京春。",
            "峴亭今日顛狂醉，舞引紅娘乱打人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 22
    },
    {
        "title": "伴僧行",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "春來求事百无成，因向愁中识道情。",
            "花滿杏園千万樹，幾人能伴老僧行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 23
    },
    {
        "title": "古寺",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "古寺春餘日半斜，竹风蕭爽勝人家。",
            "花时不到有花院，意在尋僧不在花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 24
    },
    {
        "title": "定僧",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "落魄閑行不著家，遍尋春寺賞年華。",
            "野僧偶向花前定，滿樹狂风滿樹花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 25
    },
    {
        "title": "觀心处",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "滿坐喧喧笑语频，独怜方丈了无塵。",
            "燈前便是觀心处，要似觀心有幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 26
    },
    {
        "title": "智度師二首",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "四十年前馬上飛，功名藏盡擁禪衣。",
            "石榴園下擒生处，独自閑行独自归。",
            "三陷思明三突圍，鐵衣拋盡衲禪衣。",
            "天津橋上无人识，閑凭欄幹望落暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 27
    },
    {
        "title": "西明寺牡丹",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "花向琉璃地上生，光风炫轉紫雲英。",
            "自從天女盤中見，直至今朝眼更明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 28
    },
    {
        "title": "憶楊十二",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "去时芍药才堪贈，看卻残花已度春。",
            "只為情深偏愴別，等闲相見莫相親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 29
    },
    {
        "title": "送複夢赴韋令幕",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "世上於今重檢身，吾徒耽酒作狂人。",
            "西曹舊事多持法，慎莫吐他丞相茵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 30
    },
    {
        "title": "送劉太白",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "洛阳大底居人少，從善坊西最寂寥。",
            "想得劉君独騎馬，古堤愁樹隔中橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 31
    },
    {
        "title": "奉誠園",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "蕭相深誠奉至尊，舊居求作奉誠園。",
            "秋來古巷无人掃，樹滿空牆閉戟門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 32
    },
    {
        "title": "与太白同之東洛至櫟阳太白染疾駐行予九月二十五日至華嶽寺雪后望山",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "共作洛阳千里伴，老劉因疾駐行軒。",
            "今朝独自山前立，雪滿三峰倚寺門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 33
    },
    {
        "title": "野狐泉柳林",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "去日野狐泉上柳，紫牙初綻拂眉低。",
            "秋來寥落驚风雨，葉滿空林踏作泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 34
    },
    {
        "title": "酬胡三凭人问牡丹",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "竊見胡三问牡丹，為言依舊滿西欄。",
            "花时何处偏相憶，寥落衰紅雨后看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 35
    },
    {
        "title": "酬樂天秋興見贈本句云莫怪独吟秋興苦比君校近二毛年",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "勸君休作悲秋賦，白发如星也任垂。",
            "畢竟百年同是夢，長年何異少何為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十一",
        "no#": 36
    }
]