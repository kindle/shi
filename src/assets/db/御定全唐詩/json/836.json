[
    {
        "title": "春",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "自來自去動洪爐，无象无私无处无。回雁不多消气力，",
            "莫訝相逢只添睡，伊余心不在榮枯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 1
    },
    {
        "title": "闻迎真身",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "四海无波八表臣，恭闻今歲禮真身。七重鎖未開金鑰，",
            "可怜優缽羅花樹，三十年來一度春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 2
    },
    {
        "title": "灞陵戰叟",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "劍刓秋水鬢梳霜，回首胡天与恨長。官竟不封右校尉，",
            "今日灞陵陵畔見，春风花霧共茫茫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 3
    },
    {
        "title": "遇道者",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "鶴骨松筋风貌殊，不言名姓絕榮枯。尋常藜杖九衢裏，",
            "只應张果支公輩，时複相逢醉海隅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 4
    },
    {
        "title": "贈鐘陵陳处士",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "否极方生社稷才，唯譚帝道鄙梯媒。高吟千首精怪動，",
            "吾皇仄席求賢久，莫待征书两度來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 5
    },
    {
        "title": "懷鄰叟",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "常思東溪龐眉翁，是非不解两頰紅。桔槔打水聲嘎嘎，",
            "千門万戶皆車馬，谁愛如斯太古风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 6
    },
    {
        "title": "贈軒轅先生",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "曾親文景上金鑾，语共容城语一般。久向紅霞居不出，",
            "略问先生真甲子，只言弟子是劉安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 7
    },
    {
        "title": "偶作因懷山中道侶",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "是是非非竟不真，桃花流水送青春。姓劉姓項今何在，",
            "深雲道者相思否，归去來兮湘水濱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 8
    },
    {
        "title": "送新羅人及第归",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "捧桂香和紫禁煙，遠鄉程徹巨鼇邊。莫言掛席飛連夜，",
            "到鄉必遇來王使，与作唐书寄一篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 9
    },
    {
        "title": "送新羅衲僧",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "扶桑枝西真气奇，古人呼為師子兒。六環金錫輕擺撼，",
            "多慚不便隨高步，正是风清无事时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 10
    },
    {
        "title": "春晚桐江上閑望作",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "江上車聲落日催，紛紛擾擾起紅埃。更无人望青山立，",
            "可怜瀟灑鴟夷子，散發扁舟去不回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 11
    },
    {
        "title": "商山道者",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "五千言外得玄音，石屋寒棲隔雪林。多傍松风梳綠發，",
            "曾夢先生非此处，碧桃溪上紫煙深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 12
    },
    {
        "title": "闻许棠及第因寄桂雍",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "时清道合出塵埃，清苦為诗不仗媒。今日桂枝平折得，",
            "更有平人居蟄屋，還應為作一聲雷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 13
    },
    {
        "title": "瀔江秋居作",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "无事相關性自攄，庭前拾葉等闲书。青山万里竟不足，",
            "面前小沼清如鏡，終養琴高赤鯉魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 14
    },
    {
        "title": "上縉雲段使君",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "清畏人知人盡知，縉雲三载得宣尼。活民刀尺雖无象，",
            "今朝暫到金臺上，頗觉心如太古时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 15
    },
    {
        "title": "春末蘭溪道中作",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "山花零落紅与緋，汀煙蒙茸江水肥。人擔犁鋤細雨歇，",
            "清平时節何时是，轉觉人心与道違。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 16
    },
    {
        "title": "野居偶作",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "高淡清虛即是家，何須須占好煙霞。无心於道道自得，",
            "但令如此還如此，谁羨前程未可涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 17
    },
    {
        "title": "再游東林寺作五首",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "台殿參差聳瑞煙，桂花飄雪水潺潺。",
            "莫疑遠去无消息，七万餘年始半年。",
            "桓玄舊輦残雲濕，耶舍孤墳落照迟。",
            "有個山僧倚松睡，恐人來取白猿兒。",
            "玉像珠龕香陣橫，錦霞多傍石牆生。",
            "辟蛇行者今何在，花裏唯闻鳩鳥聲。",
            "愛陶長官醉兀兀，送陸道士行迟迟。",
            "買酒過溪皆破戒，斯何人斯師如斯。",
            "白薝蔔花露滴滴，紅苾芻草香濛濛。",
            "田地更无塵一點，是何人合住其中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 18
    },
    {
        "title": "題蘭江言上人院二首",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "一生只著一麻衣，道业還欺習彥威。",
            "手把新诗说山夢，石橋天柱雪霏霏。",
            "只是危吟坐翠層，門前岐路自崩騰。",
            "青雲名士时相訪，茶煮西峰瀑布冰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 19
    },
    {
        "title": "中秋十五夜月",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "噀雪噴霜滿碧虛，王孫公子玩相呼。從來天匠為輪足，",
            "坐來惟觉情无极，何況三湘与五湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 20
    },
    {
        "title": "鹭鷥有懷",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "粉魄霜華為爾枯，鴛鴦相伴更堪图。愛來沙島遺銀屋，",
            "今朝不觉频回首，曾伴瑤花近玉壺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 21
    },
    {
        "title": "東阳罹乱后懷王慥使君五首",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "昨來隻对漢諸侯，勝事消磨不自由。裂地鼓鼙军□急，",
            "谁為今朝奉明主，使君司戶在隋州。",
            "只報精兵過大河，東西南北殺人多。可怜白日渾如此，",
            "不勝惆悵還惆悵，一曲東风月胯歌。",
            "為郡无如王使君，一家清冷似雲根。貨財不入崔洪口，",
            "不堪西望西风起，縱火昆侖谁為論。",
            "魄懾魂飛骨亦銷，此魂此魄亦難招。黃金白玉家家盡，",
            "恭闻國有英雄将，擬把何心答圣朝。",
            "不是龔黃覆育才，即須清苦遠塵埃。无人与奏吾皇去，",
            "令人轉憶王夫子，一片真风去不回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 22
    },
    {
        "title": "秋夜懷嵩少因寄洛中舊知",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "爐爇旃檀不稱貧，霏霏玉露濕禪巾。紫金地上三更月，",
            "如今憔悴頭成雪，空想嵯峨羨故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 23
    },
    {
        "title": "避地毗陵，寒月上孫徽使君兼寄東阳王使君三首",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "一到毗陵心更勞，冷吟闲步擁雲袍。豈緣思妙塵埃少，",
            "終須愚谷中安致，不是人間好羽毛。",
            "常憶雙溪八詠前，講诗論道接清賢。文欺白鳳真難及，",
            "自怜不是悠悠者，吟嚼真风二十年。",
            "□雷車雨滴階聲，寂寞焚香独閉扃。錦繡文章无路達，",
            "唯有孤高江太守，不忘病客在禪靈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 24
    },
    {
        "title": "秋末寄上桐江馮使君",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "山東山色勝諸山，謝守清高不可攀。薄俗盡於言下泰，",
            "野客沾恩归未得，蕭蕭霜葉滿柴關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 25
    },
    {
        "title": "禪師",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "擊鼓求亡益是非，木中生火更何為。",
            "吾師別是醍醐味，不是知心人不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 26
    },
    {
        "title": "道士",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "花島相逢滿袖雲，藉花論道過金巾。",
            "騰騰又入仙山去，只恐是青城丈人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 27
    },
    {
        "title": "风琴",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "至境心為造化功，一枝青竹四弦风。",
            "寥寥雙耳更深后，如在緱山明月中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 28
    },
    {
        "title": "庭橘",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "蟻踏金苞四五株，洞庭山上味何殊。",
            "不緣松樹稱君子，肯便甘人喚木奴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 29
    },
    {
        "title": "落花",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "蝶醉蜂癡一簇香，繡葩紅蒂墮残芳。",
            "因嗟好德人難得，公子王孫盡斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 30
    },
    {
        "title": "孤雲",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "将比鹭鷥還恐屈，始思残雪不如多。",
            "清风相引去更遠，皎潔孤高奈爾何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 31
    },
    {
        "title": "苦吟",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "河薄星疏雪月孤，松枝清气入肌膚。",
            "因知好句勝金玉，心极神勞特地无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 32
    },
    {
        "title": "古戰处",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "鬼气蒼黃棘葉紅，昔时人血此时风。",
            "相怜极目无疆地，曾落将军一陣中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 33
    },
    {
        "title": "偶然作",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "蟬聲引出石中蛩，寂寞門扃葉数重。",
            "谁道思山心不切，等闲盡出两三峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 34
    },
    {
        "title": "招友人宿",
        "author": "貫休",
        "biography": "",
        "paragraphs": [
            "銀地无塵金菊開，紫梨紅枣墮莓苔。",
            "一泓秋水一輪月，今夜故人來不來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百三十六",
        "no#": 35
    }
]