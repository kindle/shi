[
    {
        "title": "奉和禦制",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "嶽寺清秋霽，宸遊永日閑。霓旌森物外，鳳吹落人間。",
            "玉漱穿城水，屏開对闕山。皆知圣情悅，麗藻灑芳蘭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 1
    },
    {
        "title": "和集賢相公西溪侍宴觀競渡",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "片水聳層橋，祥煙靄慶霄。晝花鋪廣宴，晴電閃飛橈。",
            "浪疊搖仙仗，风微定彩標。都人同盛觀，不觉在行朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 2
    },
    {
        "title": "山居即事四首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "桂樹秋來风滿枝，碧岩归日免乖期。",
            "故人盡向蟾宮折，独我攀條欲寄谁。",
            "不傲南窗且采樵，乾鬆每帶濕雲燒。",
            "庖廚卻得長兼味，三秀芝根五朮苗。",
            "万事翛然只有棋，小軒高淨簟涼时。",
            "闌珊半局和微醉，花落中庭樹影移。",
            "无鄰无裏不成村，水曲雲重掩石門。",
            "何用深求避秦客，吾家便是武陵源。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 3
    },
    {
        "title": "紅白牡丹",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "不必繁弦不必歌，靜中相对更情多。殷鮮一半霞分綺，",
            "重來應共今來別，风墮香残襯綠莎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 4
    },
    {
        "title": "中秋陪熙用學士禁中玩月",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "月圓年十二，秋半每多阴。此夕无纖靄，同君宿禁林。",
            "未高知海闊，當午見宮深。衣似繁霜透，身疑積水沈。",
            "遭逢陪侍輦，归去憶抽簪。太液池南岸，相期到曉吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 5
    },
    {
        "title": "題豪家故池",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "歲久无泉引，春來仰雨流。萍枯黏朽檻，沙淺露沉舟。",
            "照影人何在，持竿客寄遊。翛然興廢外，回首謝眠鸥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 6
    },
    {
        "title": "偶題",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "賤子曾塵國士知，登門倒屣憶當时。西州酌盡看花酒，",
            "烏衣舊宅犹能認，粉竹金松一两枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 7
    },
    {
        "title": "渚宮立春书懷",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "春候侵残臘，江蕪綠已齊。风高鶯囀澀，雨密雁飛低。",
            "向日心須在，归朝路欲迷。近闻驚禦火，犹及灞陵西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 8
    },
    {
        "title": "闻李翰林游池上有寄",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "花飛絮落水和流，玉署詞臣奉詔遊。四面看人隨画鷁，",
            "不為禁鐘催入宿，前峰月上未回舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 9
    },
    {
        "title": "谷口寓居偶題",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "涔涔病骨怯朝天，谷口归來取性眠。峭壁削成開画障，",
            "已熟前峰采芝徑，更於何处養残年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 10
    },
    {
        "title": "无題",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "万態千端一瞬中，沁園蕪沒佇秋风。鵁鶄夜警池塘冷，",
            "今朝陌上相非者，曾此歌鐘幾醉同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 11
    },
    {
        "title": "賦雪",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一夜阴风度，平明顥气交。未知融結判，唯見混茫包。",
            "路莫藏行跡，林難出樹梢。气應封獸穴，險必墮禽巢。",
            "影密燈回照，聲繁竹送敲。玩宜蘇讓點，餐稱蜜勻抄。",
            "結凍防魚躍，黏沙費馬跑。爐寒資爇荻，屋暖賴編茅。",
            "遠不分山疊，低宜失地坳。闌幹高百尺，新霽若為拋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 12
    },
    {
        "title": "寄僧",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "柳拂池光一點清，紫方袍袖杖藜行。偶傳新句來中禁，",
            "應怜正視淮王詔，不识東林物外情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 13
    },
    {
        "title": "酬僧",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "吾師既续惠休才，況值高秋万象開。吟处遠峰橫落照，",
            "闻说近郊寒尚綠，登臨應待一追陪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 14
    },
    {
        "title": "題延壽坊東南角古池",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "蔓草蕭森曲岸摧，水籠沙淺露莓苔。更无蔟蔟紅妝點，",
            "繁華自古皆相似，金谷荒園土一堆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 15
    },
    {
        "title": "登鸛雀樓",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "鳥在林梢腳底看，夕阳无際戍煙残。凍開河水奔渾急，",
            "祖鞭掉折徒為爾，贏得雲溪負釣竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 16
    },
    {
        "title": "和峽州馮使君題所居",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "三年拔薤成仁政，一日誅茅葺所居。曉岫近排吟閣冷，",
            "記得街西鄰舍否，投荒南去五千餘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 17
    },
    {
        "title": "秋日感事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一葉飄然夕照沈，世間何事不經心。幾人欲話雲台峻，",
            "自怜情為多憂動，不為西风白露吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 18
    },
    {
        "title": "鶯",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "日落林西鳥未知，自先飛上最高枝。千啼万语不離恨，",
            "謝家園裏成吟久，只欠池塘一句诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 19
    },
    {
        "title": "次韵和王員外雜游四韵",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一分難減亦難加，得似溪頭浣越紗。两槳慣邀催去艇，",
            "谁見玉郎腸斷处，露床风簟半欹斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 20
    },
    {
        "title": "秋事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "江天暑气自涼清，物候須知一雨成。松竹健來唯欠语，",
            "更欲輕橈放煙浪，葦花深处睡秋聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 21
    },
    {
        "title": "和陸拾遺題諫院松",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "落落孤松何处尋，月華西畔結根深。曉含仙掌三清露，",
            "碧岩秋澗休相望，捧日元須在禁林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 22
    },
    {
        "title": "題揚子津亭",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "揚子江津十四經，紀行文字遍長亭。驚人旅鬢斬新白，",
            "可怜不识生離者，数點漁帆落暮汀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 23
    },
    {
        "title": "閑望",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "三點五點映山雨，一枝两枝臨水花。蛺蝶狂飛掠芳草，",
            "東遷西去俱无计，卻羨暝归林上鴉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 24
    },
    {
        "title": "雪后過昭應",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "路過章台气象寬，九重城闕在雲端。煙含上苑沉沉紫，",
            "灞川南北真图画，更待残阳一望看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 25
    },
    {
        "title": "商人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "百尺竿頭五两斜，此生何处不為家。北拋衡岳南過雁，",
            "隨风逐浪年年別，卻笑如期八月槎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 26
    },
    {
        "title": "岐下闻杜鵑",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "化去蠻鄉北，飛來渭水西。為多亡國恨，不忍故山啼。",
            "怨已驚秦鳳，靈應识漢雞。数聲煙漠漠，餘思草萋萋。",
            "樓迥波无際，林昏日又低。如何不腸斷，家近五雲溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 27
    },
    {
        "title": "雨后闻思归樂二首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "山禽連夜叫，兼雨未嘗休。盡道思归樂，應多離別愁。",
            "我家方旅食，故國在滄洲。闻此不能寐，青燈茆屋幽。",
            "一夜鳥飛鳴，關關徹五更。似因归路隔，長使別魂驚。",
            "未省愁雨暗，就中傷月明。須知越吟客，欹枕不勝情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 28
    },
    {
        "title": "中夜闻啼禽",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "漠漠蒼蒼未五更，宿禽何处两三聲。若非西澗回波觸，",
            "此时归夢隨腸斷，半壁残燈閃閃明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 29
    },
    {
        "title": "靈池縣見早梅",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "小園晴日見寒梅，一寸鄉心万里回。春日暖时拋笠澤，",
            "待勒燕然归未得，雪枝南畔少徘徊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 30
    },
    {
        "title": "野廟",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "古原荒廟掩莓苔，何处喧喧鼓笛來。",
            "日暮鳥归人散盡，野风吹起紙錢灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 31
    },
    {
        "title": "闲书",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "接鹭陪鸞漫得群，未如高臥紫溪雲。晉阳起義尋常見，",
            "回看帶礪山河者，濟得危时沒舊勳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 32
    },
    {
        "title": "寄貫休上人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "別來如夢亦如雲，八字微言不復闻。世上浮沈應念我，",
            "見擬沃州尋舊約，且教丹頂许為鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 33
    },
    {
        "title": "书懷",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "傍岩依樹結簷楹，夏物蕭疏景更清。灘響忽高何处雨，",
            "爭得便誇饒勝事，九衢塵裏免勞生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 34
    },
    {
        "title": "重阳日荊州作",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "万里投荒已自哀，高秋寓目更徘徊。濁醪任冷難辭醉，",
            "驚时感事俱无奈，不待残阳下楚台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 35
    },
    {
        "title": "寄貫休",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "休公何处在，知我宦情无。已似馮唐老，方知武子愚。",
            "一身仍更病，雙闕又須趨。若得重相見，冥心學半銖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 36
    },
    {
        "title": "秋日渚宮即事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "漠漠澹雲煙，秋归澤國天。风高還促燕，雨細未妨蟬。",
            "靜引荒城望，涼驚旅枕眠。更堪憔悴裏，欲泛洞庭船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 37
    },
    {
        "title": "荊州寓居书懷",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一室四无鄰，荒郊接古津。幽闲消俗態，搖落露家貧。",
            "絕跡思浮海，修书懶寄秦。東西不復问，翻笑泣岐人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 38
    },
    {
        "title": "和嚴諫議蕭山廟十韵",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "澤國瞻遺廟，雲韶仰舊名。一隅連障影，千仞落泉聲。",
            "老狖尋危棟，秋蛇束画楹。路長資稅駕，歲儉絕豐盛。",
            "默默雖難測，昭昭本至平。豈知遷去客，自有複來兵。",
            "美舜歌徒作，欺堯犬正獰。近兼闻顺動，敢複怨徂征。",
            "日出天須霽，风休海自清。肺腸无处说，一為啟聰明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 39
    },
    {
        "title": "松江晚泊",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "樹遠天疑盡，江奔地欲隨。孤帆落何处，残日更新離。",
            "客是淒涼本，情為系滯枝。寸腸无计免，應只楚猿知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 40
    },
    {
        "title": "湖州溪樓书獻鄭員外",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "危檻等飛檣，閑追晚際涼。青林上雨色，白鳥破溪光。",
            "目以高須极，心因靜更傷。唯公舊相许，早晚侍長楊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 41
    },
    {
        "title": "秋興",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "微雨過菰葦，野居生早涼。襟期漸蕭灑，精爽欲飛揚。",
            "魚買罾頭活，酒沽船上香。不緣人不用，始道靜勝忙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 42
    },
    {
        "title": "端居",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "片雨過前汀，端居枕簟清。病魔隨暑退，诗思傍涼生。",
            "別燕殷勤语，残蟬仿佛鳴。古來悲不盡，況我本多情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 43
    },
    {
        "title": "途中",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一棹归何处，蒼茫落照昏。无人應失路，有樹始知春。",
            "湖岸春耕廢，江城戰鼓喧。儒冠解相誤，學劍盡乘軒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 44
    },
    {
        "title": "西陵夜居",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "寒潮落遠汀，暝色入柴扃。漏永沉沉靜，燈孤的的清。",
            "林风移宿鳥，池雨定流螢。盡夜成愁絕，啼蛩莫近庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 45
    },
    {
        "title": "燕雛",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "掠水身犹重，偎风力尚微。瓦苔難定立，簷雨忽喧归。",
            "未识重溟遠，先愁一葉飛。銜泥在他日，两两占春暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 46
    },
    {
        "title": "新秋",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "白发又經秋，端居海上洲。无机因事發，有涕為时流。",
            "新酒乘涼壓，残棋隔夜收。公車无路入，同拜老閑侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 47
    },
    {
        "title": "題越州法華寺",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "寺在五峰阴，穿緣一徑尋。雲藏古殿暗，石護小房深。",
            "宿鳥連僧定，寒猿應客吟。上方應見海，月出試登臨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 48
    },
    {
        "title": "寒食洛阳道",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "路岐无樂处，时節倍思家。彩索颺輕吹，黃鸝啼落花。",
            "連幹馳寶馬，曆祿鬥香車。行客勝回首，看看春日斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 49
    },
    {
        "title": "憶事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "去年花下把金卮，曾賦楊花数句诗。",
            "回首朱門閉荒草，如今愁到牡丹时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 50
    },
    {
        "title": "金陵遇悟空上人",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "東閣无人事渺茫，老僧持缽過丹阳。",
            "十年棲止如何報，好与南譙剩炷香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 51
    },
    {
        "title": "途中",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "柳弱风長在，雲輕雨易休。不勞芳草色，更惹夕阳愁。",
            "万里独归去，五陵无与遊。春心漸傷盡，何处有高樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 52
    },
    {
        "title": "秋園",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "始怜春草細霏霏，不觉秋來綠漸稀。",
            "惆悵擷芳人散盡，滿園煙露蝶高飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 53
    },
    {
        "title": "富春",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "天下有水亦有山，富春山水非人寰。",
            "長川不是春來綠，千峰倒影落其間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 54
    },
    {
        "title": "山居即事",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "小亭前面接青崖，白石交加襯綠苔。",
            "日暮松聲滿階砌，不關风雨鶴归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 55
    },
    {
        "title": "寓言",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "非明非暗朦朦月，不暖不寒慢慢风。",
            "独臥空床好天气，平生闲事到心中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 56
    },
    {
        "title": "華清宮二首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "四郊飛雪暗雲端，唯此宮中落旋幹。",
            "綠樹碧簷相掩映，无人知道外邊寒。",
            "長生秘殿倚青蒼，擬敵金庭不死鄉。",
            "无奈逝川東去急，秦陵松柏滿残阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 57
    },
    {
        "title": "過九成宮",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "鳳輦東归二百年，九成宮殿半荒阡。魏公碑字封蒼蘚，",
            "升平舊事无人说，万疊青山但一川。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 58
    },
    {
        "title": "出潼關",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "重門隨地險，一徑入天開。華岳眼前盡，黃河腳底來。",
            "飛軒何滿路，丹陛正求才。独我疏慵質，飄然又此回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 59
    },
    {
        "title": "過丹阳",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "雲阳縣郭半郊坰，风雨蕭條万古情。山帶梁朝陵路斷，",
            "遺事滿懷兼滿目，不堪孤棹艤荒城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 60
    },
    {
        "title": "和人題武城寺",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "神清已觉三清近，目斷仍勞万象牽。渭水遠含秋草渡，",
            "別有闌幹壓行路，看人塵土竟流年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 61
    },
    {
        "title": "長安裏中闻猿",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "夾巷重門似海深，楚猿爭得此中吟。一聲紫陌才回首，",
            "无因永夜闻清嘯，禁路人归月自沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 62
    },
    {
        "title": "岐下闻子規",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "劍閣西南遠鳳台，蜀魂何事此飛來。偶因隴樹相迷至，",
            "谁怜越客曾闻处，月落江平曉霧開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 63
    },
    {
        "title": "敷水有丐者雲是馬侍中諸孫，憫而有贈",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "天地塵昏九鼎危，大貂曾出武侯師。一心忠赤山河見，",
            "而今不要教人识，正藉将军死鬥时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 64
    },
    {
        "title": "還俗尼",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "柳眉梅額倩妝新，笑脫袈裟得舊身。三峽卻為行雨客，",
            "寄语江南徐孝克，一生長短托清塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 65
    },
    {
        "title": "彭門用兵后經汴路三首",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "長亭一望一徘徊，千里關河百戰來。細柳舊營犹鎖月，",
            "若比江南更牢落，子山詞賦莫興哀。",
            "隋堤风物已淒涼，堤下仍多舊戰場。金鏃有苔人拾得，",
            "独上寒城正愁絕，戍鼙驚起雁行行。",
            "鐵馬雲旗夢渺茫，東來无处不堪傷。风吹白草人行少，",
            "曾為塞北闲遊客，遼水天山未斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 66
    },
    {
        "title": "寄殿院高侍禦",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "黃梅雨細冪長洲，柳密花疏水慢流。釣艇正尋逋客去，",
            "一夜自怜无羽翼，独當何遜滴階愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 67
    },
    {
        "title": "新安道中玩流水",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "一渠春碧弄潺潺，密竹繁花掩映間。看处便須終日住，",
            "上卻征車再回首，了然塵土不相關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 68
    },
    {
        "title": "憶釣舟",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "青山小隱枕潺湲，一葉垂綸幾溯沿。后浦春风隨興去，",
            "回首无人寄惆悵，九衢塵土困揚鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 69
    },
    {
        "title": "靈寶縣西側津",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "碧溪瀲瀲流残阳，晴沙两两眠鴛鴦。柳花无賴苦多暇，",
            "高歌一曲垂鞭去，盡日无人识楚狂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 70
    },
    {
        "title": "即席",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "家住叢台舊，名參絳圃新。醉波疑奪燭，嬌態欲沈春。",
            "伴雨聊過楚，归雲定占秦。桃花正濃暖，爭不浪迷人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 71
    },
    {
        "title": "出迟",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "園密花藏易，樓深月到難。酒虛留客盡，燈暗遠更残。",
            "麝想眉間印，鴉知頂上盤。文王之囿小，莫惜借人看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 72
    },
    {
        "title": "送僧归日本國",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "滄溟分故國，渺渺泛杯归。天盡終期到，人生此別稀。",
            "无风亦駭浪，未午已斜暉。系帛何須雁，金烏日日飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 73
    },
    {
        "title": "送僧归破山寺",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "万里指吳山，高秋杖錫還。別來雙闕老，归去片雲閑。",
            "師在有无外，我嬰塵土間。居然本相別，不要慘離顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 74
    },
    {
        "title": "夏夜有寄",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "月上簟如水，軒高簾在鉤。竹聲寒不夏，蛩思靜先秋。",
            "偶得清宵興，方知白日愁。所思何处遠，斜漢欲低流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 75
    },
    {
        "title": "春詞",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "鸞鏡長侵夜，鴛衾不识寒。羞多轉面语，妒极定睛看。",
            "金市舊居近，鈿車新造寬。春期莫相誤，一日百花残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 76
    },
    {
        "title": "汴上晚泊",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "亭上风犹急，橋邊月已斜。柳寒難吐絮，浪濁不成花。",
            "岐路春三月，園林海一涯。蕭然正无寐，夜櫓莫咿啞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 77
    },
    {
        "title": "送僧南游",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "戰鼙鳴未已，瓶屨抵何鄉。偶別塵中易，貪归物外忙。",
            "后蟬拋鄠杜，先雁下瀟湘。不得從師去，殷勤謝草堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 78
    },
    {
        "title": "戲",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "恨极同填海，情長抵導江。丁香從小結，蓮子徹枝雙。",
            "整髻花當檻，吹燈月在窗。秦台非久计，早晚降霓幢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 79
    },
    {
        "title": "雪中寄盧延讓秀才",
        "author": "吳融",
        "biography": "",
        "paragraphs": [
            "苦貧皆共雪，吾子豈同悲。永日應无食，經宵必有诗。",
            "渚宮寒過節，華省試臨期。努力图西去，休将凍餒辭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百八十四",
        "no#": 80
    }
]