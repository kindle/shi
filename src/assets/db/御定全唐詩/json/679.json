[
    {
        "title": "秋夕送友人归吳",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "離心醉豈歡，把酒強相寬。世路須求達，還家亦未安。",
            "旅程愁算遠，江月坐吟残。莫羨扁舟興，功成去不難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 1
    },
    {
        "title": "長安逢江南僧",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "孤雲无定蹤，忽到又相逢。说盡天涯事，聽残上國鐘。",
            "问人尋寺僻，乞食過街慵。憶到曾棲處，開門對數峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 2
    },
    {
        "title": "晚次修路僧",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "平盡不平處，尚嫌功未深。應難将世路，便得稱師心。",
            "高鳥下残照，白煙生遠林。更闻清磬發，聊喜緩塵襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 3
    },
    {
        "title": "湖外送友人游邊",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "我泛瀟湘浦，君行指塞雲。两鄉天外隔，一徑渡頭分。",
            "雨暗江花老，笳愁隴月曛。不堪來去雁，迢遞思離群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 4
    },
    {
        "title": "讀段太尉碑",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "憤激计潛成，臨危豈顧生。只空持一笏，便欲碎長鯨。",
            "國已酬徽烈，家犹聳義聲。不知青史上，谁可计功名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 5
    },
    {
        "title": "夕次洛阳道中",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "秋风吹故城，城下独吟行。高樹鳥已息，古原人尚耕。",
            "流年川暗度，往事月空明。不復歎岐路，馬前塵夜生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 6
    },
    {
        "title": "讀方幹诗因懷別业",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "把君诗一吟，万里見君心。華发新知少，滄洲舊隱深。",
            "潮沖虛閣上，山入暮窗沈。憶宿高齋夜，庭枝识海禽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 7
    },
    {
        "title": "題嵩阳隱者",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "四十年高夢，生涯指一丘。无人同久住，有鶴對冥修。",
            "草雜芝田出，泉和石髓流。更嫌庭樹老，疑是世間秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 8
    },
    {
        "title": "友人问卜見招",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "何必问蓍龜，行藏自可期。但逢公道日，即是命通时。",
            "樂善知无厭，操心幸不欺。豈能花下淚，長似去年垂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 9
    },
    {
        "title": "江行晚望",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "木落曙江晴，寒郊極望平。孤舟三楚去，万里独吟行。",
            "鳥占橫查立，人當故里耕。十年來複去，不覺二毛生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 10
    },
    {
        "title": "巫山廟",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "雙黛儼如嚬，應傷故國春。江山非舊主，雲雨是前身。",
            "夢覺傳詞客，靈犹福楚人。不知千载後，何處又為神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 11
    },
    {
        "title": "秋夕与友人話別",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "懷君非一夕，此夕倍堪悲。華发犹漂泊，滄洲又別離。",
            "冷禽棲不定，衰葉墮无时。況值干戈隔，相逢未可期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 12
    },
    {
        "title": "与友人同懷江南別业",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "因君話故國，此夕倍依依。舊业臨秋水，何人在釣磯。",
            "浮名如縱得，滄海亦終归。卻是风塵裏，如何便息机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 13
    },
    {
        "title": "苦吟",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "朝吟複暮吟，只此望知音。舉世輕孤立，何人念苦心。",
            "他鄉无舊识，落日羨归禽。況住寒江上，漁家似故林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 14
    },
    {
        "title": "春日郊居酬友人見貽",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "荒齋原上掩，不出動經旬。忽覺草木變，始知天地春。",
            "方期五字達，未厭一簞貧。麗句勞相勉，余非樂釣綸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 15
    },
    {
        "title": "问卜",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "承家望一名，幾欲问君平。自小非无志，何年即有成。",
            "豈能長失路，爭忍學归耕。不擬逢昭代，悠悠過此生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 16
    },
    {
        "title": "蜀城春",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "天涯憔悴身，一望一沾巾。在處有芳草，滿城无故人。",
            "懷才皆得路，失计自傷春。清鏡不能照，鬢毛愁更新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 17
    },
    {
        "title": "送道士于千齡游南嶽",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "物外与谁期，人間又別離。四方多事日，高岳独游时。",
            "猿狖瀟湘樹，煙波屈宋祠。无因陪此去，空惜鬢将衰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 18
    },
    {
        "title": "入蜀赴舉秋夜与先生話別",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "欲愴峨嵋別，中宵寢不能。聽残池上雨，吟盡枕前燈。",
            "失计方期隱，修心未到僧。雲門一万里，應笑又擔簦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 19
    },
    {
        "title": "春晚懷進士韋澹",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "故里花應盡，江樓夢尚残。半生吟欲過，一命達何難。",
            "特立珪无玷，相思草有蘭。二年春悵望，不似在長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 20
    },
    {
        "title": "言懷",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "幹时雖苦節，趨世且无机。及覺知音少，翻疑所业非。",
            "青雲如不到，白首亦難归。所以滄江上，年年別釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 21
    },
    {
        "title": "秋夜興上人別",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "常时豈不別，此別異常情。南國初闻雁，中原未息兵。",
            "暗蛩侵语歇，疏磬入吟清。曾聽无生说，辭師話此行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 22
    },
    {
        "title": "感花",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "繡軛香韉夜不归，少年爭惜最紅枝。",
            "東风一陣黃昏雨，又到繁華夢覺时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 23
    },
    {
        "title": "秋宿天彭僧舍",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "身世两相惜，秋雲每独興。難将塵界事，話向雪山僧。",
            "力善知谁许，归耕又未能。此懷平不得，挑盡草堂燈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 24
    },
    {
        "title": "秋夜僧舍闻猿",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "哀猿聽未休，禪景夜方幽。暫得同僧靜，那能免客愁。",
            "影搖雲外樹，聲褭月中秋。曾向巴江宿，當时淚亦流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 25
    },
    {
        "title": "過昭君故宅",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "以色靜胡塵，名還異眾嬪。免勞征戰力，无愧綺羅身。",
            "骨竟埋青塚，魂應怨画人。不堪逢舊宅，寥落對江濱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 26
    },
    {
        "title": "過洛阳故城",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "三十世皇都，蕭條是霸圖。片牆看破盡，遺跡漸應无。",
            "野徑通荒苑，高槐映遠衢。独吟人不问，清冷自嗚嗚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 27
    },
    {
        "title": "秋夕与友人同會",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "章句積微功，星霜二十空。僻應如我少，吟喜得君同。",
            "月上僧归後，诗成客夢中。更闻棲鶴警，清露滴青松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 28
    },
    {
        "title": "春日登吳門",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "故國望不見，愁襟難暫開。春潮映楊柳，細雨入樓臺。",
            "靜少人同到，晴逢雁正來。長安遠於日，搔首独徘徊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 29
    },
    {
        "title": "湘中秋懷遷客",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "蘭杜曉香薄，汀洲夕露繁。並闻燕塞雁，独立楚人村。",
            "霧散孤城上，灘回曙枕喧。不堪逢賈傅，還欲吊湘沅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 30
    },
    {
        "title": "南山旅舍与故人別",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "一日又将暮，一年看即残。病知新事少，老別舊交難。",
            "山盡路犹險，雨餘春卻寒。那堪試回首，烽火是長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 31
    },
    {
        "title": "東林愿禪師院",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "与世漸无緣，身心独了然。講銷林下日，臘長定中年。",
            "磬絕朝齋後，香焚古寺前。非因送小朗，不到虎溪邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 32
    },
    {
        "title": "孤雁",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "湘浦離應晚，邊城去已孤。如何万里计，只在一枝蘆。",
            "迥起波搖楚，寒棲月映蒲。不知天畔侶，何處下平蕪。",
            "幾行归去盡，片影独何之。暮雨相呼失，寒塘独下迟。",
            "渚雲低暗度，關月冷遙隨。未必逢矰繳，孤飛自可疑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 33
    },
    {
        "title": "寄青城山顥禪師",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "懷師不可攀，師往杳冥間。林下谁闻法，塵中只見山。",
            "終年人不到，盡日鳥空還。曾聽无生说，應怜独未還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 34
    },
    {
        "title": "秋夕与王處士話別",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "微燈照寂寥，此夕正迢迢。丹桂得已晚，故山归尚遙。",
            "蟲聲移暗壁，月色動寒條。此去如真隱，期君試一瓢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 35
    },
    {
        "title": "秋日犍為道中",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "久客厭岐路，出門吟且悲。平生未到處，落日独行时。",
            "芳草不長綠，故人无重期。那堪更南渡，鄉國已天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 36
    },
    {
        "title": "送僧归江東",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "坐徹秦城夏，行登越客船。去留那有著，语默不離禪。",
            "葉擁臨關路，霞明近海天。更尋同社侶，應得虎溪邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 37
    },
    {
        "title": "喜友人及第",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "孤吟望至公，已老半生中。不有同人達，兼疑此道窮。",
            "只應才自薄，豈是命難通。尚激摶溟勢，期君借北风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 38
    },
    {
        "title": "上巳日永崇裏言懷",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "未敢分明賞物華，十年如見夢中花。",
            "遊人過盡衡門掩，独自凭欄到日斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 39
    },
    {
        "title": "送僧归天竺",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "忽憶曾棲處，千峰近沃州。別來秦樹老，归去海門秋。",
            "汲帶寒汀月，禪鄰賈客舟。遙思清興愜，不厭石林幽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 40
    },
    {
        "title": "牛渚夜泊",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "煙老石磯平，袁郎夜泛情。數吟人不遇，千古月空明。",
            "人事年年別，春潮日日生。无因逢謝尚，风物自淒清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 41
    },
    {
        "title": "送友人归江南",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "渚田芳草遍，共憶故山春。独往滄洲暮，相看白发新。",
            "定過林下寺，應見社中人。只恐東归後，難将鸥鳥親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 42
    },
    {
        "title": "過陶征君隱居",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "陶令昔居此，弄琴遺世榮。田園三畝綠，軒冕一銖輕。",
            "衰柳自无主，白雲犹可耕。不隨陵谷變，應只有高名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 43
    },
    {
        "title": "江上旅泊",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "汀洲一夜泊，久客半連檣。盡说逢秋色，多同憶故鄉。",
            "孤岡生晚燒，独樹隱回塘。欲问東归路，遙知隔渺茫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 44
    },
    {
        "title": "灞上",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "長安名利路，役役古由今。征騎少閑日，綠楊无舊阴。",
            "水侵秦甸闊，草接漢陵深。紫閣曾過處，依稀白鳥沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 45
    },
    {
        "title": "寄舅",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "中朝軒冕內，久絕寧家親。白社同孤立，青雲独並伸。",
            "致君期折檻，舉職在埋輪。須信堯庭草，犹能指佞人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 46
    },
    {
        "title": "贈休糧僧",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "闻鐘独不齋，何事更關懷。靜少人過院，閑從草上階。",
            "生台无鳥下，石路有雲埋。為憶禪中舊，时犹夢百崖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 47
    },
    {
        "title": "題絕島山寺",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "絕島跨危欄，登臨到此難。夕阳高鳥過，疏雨一鐘残。",
            "駭浪搖空闊，靈山厭渺漫。那堪更回首，鄉樹隔雲端。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 48
    },
    {
        "title": "讀侯道華真人傳",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "漢皇輕万乘，方士说三丹。不得修心要，翻知出世難。",
            "茂陵春竟綠，金掌曙空寒。何似先生去，翩翩逐彩鸞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 49
    },
    {
        "title": "残花",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "迟迟傍曉阴，昨夜色犹深。畢竟終須落，堪悲古与今。",
            "明年何處見，盡日此时心。蜂蝶无情極，残香更不尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 50
    },
    {
        "title": "題興善寺隋松院与人期不至",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "青青伊澗松，移植在蓮宮。蘚色前朝雨，秋聲半夜风。",
            "長閑應未得，暫賞亦難同。不及禪棲者，相看老此中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 51
    },
    {
        "title": "樵者",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "行山行采薇，閑翦蕙為衣。避世嫌山淺，逢人说姓稀。",
            "有时還独醉，何處掩衡扉。莫看棋終局，溪风晚待归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 52
    },
    {
        "title": "南澗耕叟",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "年年南澗濱，力盡志犹存。雨雪朝耕苦，桑麻歲计貧。",
            "戰添丁壯役，老憶太平春。見说經荒後，田園半屬人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 53
    },
    {
        "title": "春日闲居憶江南舊业",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "杜門朝複夕，豈是解謀身。夢不離泉石，林唯稱隱淪。",
            "漸諳浮世事，轉憶故山春。南國水风暖，又應生白蘋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 54
    },
    {
        "title": "屈原廟",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "讒勝禍難防，沈冤信可傷。本圖安楚國，不是怨懷王。",
            "廟古碑无字，洲晴蕙有香。独醒人尚笑，谁与奠椒漿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 55
    },
    {
        "title": "宿廬山絕頂山舍",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "一磴出林端，千峰次第看。長閑如未遂，暫到亦應難。",
            "谷樹雲埋老，僧窗瀑影寒。自嫌心不達，向此夢長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 56
    },
    {
        "title": "王逸人隱居",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "一徑入千岑，幽人许重尋。不逢秦世乱，未覺武陵深。",
            "石轉生寒色，雲归帶夕阴。卻愁危坐久，看盡暝棲禽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 57
    },
    {
        "title": "申州道中",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "风緊日淒淒，鄉心向此迷。水分平楚闊，山接故關低。",
            "客路緣烽火，人家厭鼓鼙。那堪独馳馬，江樹穆陵西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 58
    },
    {
        "title": "江上懷翠微寺空上人",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "旅泛本无定，相逢那可期。空懷白閣夜，未答碧雲诗。",
            "暮雨潮生早，春寒雁到迟。所思今不見，鄉國正天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 59
    },
    {
        "title": "秋宿鶴林寺",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "步步入林中，山窮意未窮。偏逢僧話久，轉与鶴棲同。",
            "燭焰风銷盡，蘭條露濕空。又須從此別，江上正秋鴻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 60
    },
    {
        "title": "遠望",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "長為鄉思侵，望極即沾襟。不是前山色，能傷愁客心。",
            "平蕪連海盡，独樹隱雲深。況複斜阳外，分明有去禽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 61
    },
    {
        "title": "秋晚书懷",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "看看秋色晚，又是出門时。白发生非早，青雲去自迟。",
            "夢唯懷上國，跡不到他岐。以此堅吾道，還无愧已知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 62
    },
    {
        "title": "途中秋晚送友人归江南",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "又指煙波算路岐，此生多是厭羈離。正逢搖落仍須別，",
            "扁舟未得如君去，空向滄江夢所思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 63
    },
    {
        "title": "己亥歲感事",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "正闻青犢起葭萌，又報黃巾犯漢營。豈是将皆无上略，",
            "見说聖君能仄席，不知谁是請長纓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 64
    },
    {
        "title": "金陵晚眺",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "葦聲騷屑水天秋，吟對金陵古渡頭。千古是非輸蝶夢，",
            "何必登臨更惆悵，比來身世只如浮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 65
    },
    {
        "title": "過長江賈島主簿舊廳",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "雕琢文章字字精，我經此處倍傷情。身從謫宦方沾祿，",
            "長江一曲年年水，應為先生万古清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 66
    },
    {
        "title": "途中感懷寄青城李明府",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "鱗鬣催残志未休，壯心翻是此身讎。並闻寒雨多因夜，",
            "如何只是三年別，君著朱衣我白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 67
    },
    {
        "title": "夏日书懷寄道友",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "達即匡邦退即耕，是非何足撓平生。終期道向希夷得，",
            "十年惟悟吟诗句，待得中原欲鑄兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 68
    },
    {
        "title": "和進士张曙闻雁見寄",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "斷行哀響遞相催，爭趁高秋作恨媒。雲外關山闻独去，",
            "試向富春江畔過，故園犹合有池台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 69
    },
    {
        "title": "鸚鵡洲即事",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "悵望春襟鬱未開，重吟鸚鵡益堪哀。曹瞞尚不能容物，",
            "何人正得风濤便，一點輕帆万里回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 70
    },
    {
        "title": "讀留侯傳",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "覆楚讎韓勢有餘，男兒遭遇更難如。偶成漢室千年业，",
            "若能終始匡天子，何必□□□□□。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 71
    },
    {
        "title": "赤壁懷古",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "漢室河山鼎勢分，勤王谁肯顧元勳。不知征伐由天子，",
            "分明勝敗无尋處，空聽漁歌到夕曛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 72
    },
    {
        "title": "東晉",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "五陵豪俠笑為儒，将為儒生只讀书。",
            "看取不成投筆後，謝安功业複何如。",
            "秦國金陵王氣全，一龍正道始東遷。",
            "興亡竟不關人事，虛倚長淮五百年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 73
    },
    {
        "title": "春夕",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "水流花謝两无情，送盡東风過楚城。蝴蝶夢中家万里，",
            "自是不归归便得，五湖煙景有谁爭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 74
    },
    {
        "title": "澗松",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "寸寸淩霜長勁條，路人犹笑未幹霄。",
            "南園桃李雖堪羨，爭奈春残又寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 75
    },
    {
        "title": "湘中弦",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "蒼山遙遙江潾潾，路傍老盡沒闲人。",
            "王孫不見草空綠，惆悵渡頭春複春。",
            "煙愁雨細雲冥冥，杜蘭香老三湘清。",
            "故山望斷不知處，鶗鴂隔花时一聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 76
    },
    {
        "title": "续紀漢武",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "分明三鳥下儲胥，一覺鈞天夢不如。",
            "爭那白頭方士到，茂陵紅葉已蕭疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 77
    },
    {
        "title": "隴上逢江南故人",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "三聲戍角邊城暮，万里鄉心塞草春。",
            "莫學少年輕遠別，隴關西少向東人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 78
    },
    {
        "title": "夷陵夜泊",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "家依楚塞窮秋別，身逐孤舟万里行。",
            "一曲巴歌半江月，便應消得二毛生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 79
    },
    {
        "title": "櫓聲",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "煙外橈聲遠，天涯幽夢回。爭知江上客，不是故鄉來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 80
    },
    {
        "title": "海棠圖",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "海棠花底三年客，不見海棠花盛開。",
            "卻向江南看圖画，始慚虛到蜀城來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 81
    },
    {
        "title": "雲",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "得路直為霖濟物，不然閑共鶴忘机。",
            "无端卻向阳臺畔，長送襄王暮雨归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 82
    },
    {
        "title": "過二妃廟",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "残阳楚水畔，独吊舜时人。不及廟前草，至今江上春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 83
    },
    {
        "title": "送友人",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "登高迎送遠，春恨並依依。不得滄洲信，空看白鶴归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 84
    },
    {
        "title": "聲",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "歡戚犹來恨不平，此中高下本无情。",
            "韓娥絕唱唐衢哭，儘是人間第一聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 85
    },
    {
        "title": "放鷓鴣",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "秋入池塘风露微，曉開籠檻看初飛。",
            "滿身金翠画不得，无限煙波何處归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 86
    },
    {
        "title": "泉",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "遠辭岩竇瀉潺潺，靜拂雲根別故山。",
            "可惜寒聲留不得，旋添波浪向人間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 87
    },
    {
        "title": "巫山旅別",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "五千裏外三年客，十二峰前一望秋。",
            "无限別魂招不得，夕阳西下水東流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 88
    },
    {
        "title": "幽蘭",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "幽植眾甯知，芬芳只暗持。自无君子佩，未是國香衰。",
            "白露沾長早，春风到每迟。不如當路草，芬馥欲何為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 89
    },
    {
        "title": "讀庾信集",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "四朝十帝盡风流，建业長安两醉遊。",
            "唯有一篇楊柳曲，江南江北為君愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 90
    },
    {
        "title": "過繡嶺宮",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "古殿春残綠野阴，上皇曾此駐泥金。三城帳屬升平夢，",
            "前朝舊物東流在，犹為年年下翠岑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 91
    },
    {
        "title": "巴山道中除夜书懷",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "迢遞三巴路，羈危万里身。乱山残雪夜，孤燭異鄉春。",
            "漸与骨肉遠，轉於僮僕親。那堪正漂泊，明日歲華新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 92
    },
    {
        "title": "題淨眾寺古松",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "百尺森疏倚梵台，昔人谁見此初栽。故園未有偏堪戀，",
            "清阴可惜不駐得，归去暮城空首回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 93
    },
    {
        "title": "折楊柳",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "朝朝車馬如蓬轉，處處江山待客归。",
            "若使人間少離別，楊花應合過春飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 94
    },
    {
        "title": "七夕",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "年年七夕渡瑤軒，谁道秋期有淚痕。",
            "自是人間一周歲，何妨天上只黃昏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 95
    },
    {
        "title": "泛楚江",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "九重城外家书遠，百里洲前客棹還。",
            "金印碧幢如見问，一生安穩是長閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 96
    },
    {
        "title": "初過漢江",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "襄阳好向峴亭看，人物蕭條值歲闌。",
            "為報習家多置酒，夜來风雪過江寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 97
    },
    {
        "title": "題授阳鎮路",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "越鳥巢邊溪路斷，秦人耕處洞門開。",
            "小桃花發春风起，千里江山一夢回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 98
    },
    {
        "title": "初识梅花",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "江北不如南地暖，江南好斷北人腸。",
            "燕脂桃頰梨花粉，共作寒梅一面妝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 99
    },
    {
        "title": "江雨望花",
        "author": "崔塗",
        "biography": "",
        "paragraphs": [
            "細雨滿江春水漲，好风留客野梅香。",
            "避秦不是无归意，一度逢花一斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十九",
        "no#": 100
    }
]