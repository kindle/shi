[
    {
        "title": "班婕妤",
        "author": "嚴识玄",
        "biography": "",
        "paragraphs": [
            "賤妾如桃李，君王若歲时。秋风一已勁，搖落不勝悲。",
            "寂寂蒼苔滿，沉沉綠草滋。繁華非此日，指輦競何辭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 1
    },
    {
        "title": "賦得禦制句朔野陣雲飛",
        "author": "何象",
        "biography": "",
        "paragraphs": [
            "塞日穿痕斷，邊鴻背影飛。縹緲浮黃屋，阴沈護禦衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 2
    },
    {
        "title": "宿金河戍",
        "author": "张震",
        "biography": "",
        "paragraphs": [
            "朝發鐵麟驛，夕宿金河戍。奔波急王程，一日千里路。",
            "但見容鬢改，不知歲華暮。悠悠沙漠行，王事彌多故。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 3
    },
    {
        "title": "補新宮",
        "author": "丘光庭",
        "biography": "",
        "paragraphs": [
            "奐奐新宮，禮樂其融。爾德惟賢，爾□維忠。",
            "為忠以公，斯筵是同。人之醉我，与我延賓。",
            "奐奐新宮，既奐而輪。其固如山，其儼如雲。",
            "其寢斯安，□□□分。我既考落，以燕群臣。",
            "奐奐新宮，既祭既延。我□□鏞，於以醉賢。",
            "有禮无愆，我有斯宮。斯宮以安，康后万年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 4
    },
    {
        "title": "補茅鴟",
        "author": "丘光庭",
        "biography": "",
        "paragraphs": [
            "茅鴟茅鴟，无集我岡。汝食汝飽，莫我為祥。",
            "愿彈去汝，來彼鳳凰。來彼鳳凰，其仪有章。",
            "茅鴟茅鴟，无啄我雀。汝食汝飽，莫我肯略。",
            "愿彈去汝，來彼瑞鵲。來彼瑞鵲，其音可樂。",
            "茅鴟茅鴟，无搏鷅鶹。汝食汝飽，莫我為休。",
            "愿彈去汝，來彼鳲鳩。來彼鳲鳩，食子其周。",
            "茅鴟茅鴟，无ew我陵。汝食汝飽，莫我好聲。",
            "愿彈去汝，來彼蒼鷹。來彼蒼鷹，祭鳥是征。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 5
    },
    {
        "title": "瑕瑜不相掩",
        "author": "武翊黃",
        "biography": "",
        "paragraphs": [
            "抱璞應難辨，妍媸每自融。貞姿偏特達，微玷遇磨礱。",
            "涇渭流終異，瑕瑜自不同。半曾光透石，未掩气如虹。",
            "縝密誠為智，包藏豈謂忠。停看分美惡，今得值良工。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 6
    },
    {
        "title": "袁江口懷王司勳王吏部",
        "author": "李祜",
        "biography": "",
        "paragraphs": [
            "京華不啻三千里，客淚如今一万雙。",
            "若個最為相憶处，青楓黃竹入袁江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 7
    },
    {
        "title": "贈進士李守微",
        "author": "韓嶼",
        "biography": "",
        "paragraphs": [
            "一定童顏老歲華，貧寒遊歷貴人家。煉成正气功應大，",
            "如何蓬閬不归去，落盡蟠桃幾度花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 8
    },
    {
        "title": "馬上有見",
        "author": "李茂複",
        "biography": "",
        "paragraphs": [
            "行盡疏林見小橋，綠楊深处有紅蕉。",
            "无端眼界无分別，安置心頭不肯銷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 9
    },
    {
        "title": "自歎",
        "author": "李茂複",
        "biography": "",
        "paragraphs": [
            "落日西山近一竿，世間恩愛极難yR。近來不作顛狂事，免被冤家惡眼看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 10
    },
    {
        "title": "贈吳圓",
        "author": "李曜",
        "biography": "",
        "paragraphs": [
            "經年理郡少歡娛，為習干戈間飲徒。",
            "今日臨行盡交割，分明收取媚川珠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 11
    },
    {
        "title": "答李曜",
        "author": "吳圓",
        "biography": "",
        "paragraphs": [
            "曳履優容日日歡，須言達德倍汍瀾。",
            "韶光今已輸先手，領得蠙珠掌上看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 12
    },
    {
        "title": "和訾家洲宴游",
        "author": "陸弘休",
        "biography": "",
        "paragraphs": [
            "新春蕊綻訾家洲，信是南方最勝遊。酒滿百分殊不怕，",
            "莫惜今朝同酩酊，任他龜鶴与蜉蝣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 13
    },
    {
        "title": "題賈島墓",
        "author": "安錡",
        "biography": "",
        "paragraphs": [
            "倚恃才難繼，昂藏貌不恭。騎驢沖大尹，奪卷忤宣宗。",
            "馳譽超先輩，居官下我儂。司倉舊曹署，一見一心忡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 14
    },
    {
        "title": "贈別營妓卿卿",
        "author": "油蔚",
        "biography": "",
        "paragraphs": [
            "怜君无那是多情，枕上相看直到明。日照綠窗人去住，",
            "為報花时少惆悵，此生終不負卿卿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 15
    },
    {
        "title": "巢燕",
        "author": "胡玢",
        "biography": "",
        "paragraphs": [
            "燕來巢我簷，我屋非高大。所貴兒童善，保爾无殃禍。",
            "莫巢孀婦家，孀婦怨孤坐。妒爾長雙飛，打爾危巢破。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 16
    },
    {
        "title": "廬山桑落洲",
        "author": "胡玢",
        "biography": "",
        "paragraphs": [
            "莫问桑田事，但看桑落洲。数家新住处，昔日大江流。",
            "古岸崩欲盡，平沙長未休。想應百年后，人世更悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 17
    },
    {
        "title": "石楠樹",
        "author": "胡玢",
        "biography": "",
        "paragraphs": [
            "本自清江石上生，移栽此处稱闲情。青雲士盡识珍木，",
            "餘今一日千回看，每度看來眼益明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 18
    },
    {
        "title": "句",
        "author": "胡玢",
        "biography": "",
        "paragraphs": [
            "輪中別有物，光外更无空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 19
    },
    {
        "title": "酒鬍子",
        "author": "盧注",
        "biography": "",
        "paragraphs": [
            "同心相遇思同歡，擎出酒胡當玉盤。盤中臲卼不自定，",
            "爾不耕，亦不饑。爾不蠶，亦有衣。有眼不能分黼黻，",
            "雕鐫匠意苦多端，翠帽朱衫巧妝飾。長安鬥酒十千酤，",
            "酒胡一滴不入眼，空令酒胡名酒胡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 20
    },
    {
        "title": "西施",
        "author": "盧注",
        "biography": "",
        "paragraphs": [
            "惆悵興亡系綺羅，世人犹自選青娥。",
            "越王解破夫差國，一個西施已是多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 21
    },
    {
        "title": "題西施浣紗石",
        "author": "胡幽貞",
        "biography": "",
        "paragraphs": [
            "一朝入紫宮，万古遺芳塵。至今溪邊花，不敢嬌青春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 22
    },
    {
        "title": "归四明",
        "author": "胡幽貞",
        "biography": "",
        "paragraphs": [
            "海色連四明，仙舟去容易。天籍豈輒问，不是卑朝士。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 23
    },
    {
        "title": "送人游邵州",
        "author": "狄焕",
        "biography": "",
        "paragraphs": [
            "春江正渺渺，送別两依依。煙裏棹将遠，渡頭人未归。",
            "漁家侵疊浪，島樹掛残暉。況入湖湘路，那堪花乱飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 24
    },
    {
        "title": "題柳",
        "author": "狄焕",
        "biography": "",
        "paragraphs": [
            "天南与天北，此处影婆娑。翠色折不盡，離情生更多。",
            "雨餘籠灞岸，煙暝夾隋河。自有佳名在，秦松繼得麼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 25
    },
    {
        "title": "詠南嶽徑松",
        "author": "狄焕",
        "biography": "",
        "paragraphs": [
            "一陣雨聲归嶽嶠，两條寒色下瀟湘。",
            "客吟晚景停孤棹，僧踏清阴徹上方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 26
    },
    {
        "title": "句",
        "author": "狄焕",
        "biography": "",
        "paragraphs": [
            "数點當秋霽，不知何处峰。",
            "更无聲接续，空有影相隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 27
    },
    {
        "title": "潯阳觀水",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "朝宗漢水接阳臺，唅呀填坑吼作雷。莫見九江平穩去，",
            "直至滄溟涵貯盡，沈深不動浸昭回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 28
    },
    {
        "title": "水",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "方圓不定性空求，東注滄溟早晚休。高截碧塘長耿耿，",
            "別有嶺頭嗚咽处，為君分作斷腸流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 29
    },
    {
        "title": "松",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "倚空高檻冷无塵，往事閑征夢欲分。翠色本宜霜后見，",
            "莫向東園競桃李，春光還是不容君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 30
    },
    {
        "title": "柳",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "雪盡青門弄影微，暖风迟日早鶯归。如凭細葉留春色，",
            "世間惹恨偏饒此，可是行人折贈稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 31
    },
    {
        "title": "竹",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "樹色連雲万葉開，王孫不厭滿庭栽。淩霜盡節无人見，",
            "朱門处处多閑地，正好移阴覆翠苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 32
    },
    {
        "title": "鵲",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "才見離巢羽翼開，盡能輕颺出塵埃。人間樹好紛紛占，",
            "若教顏色如霜雪，應与清平作瑞來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 33
    },
    {
        "title": "燈",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "分影由來恨不同，綠窗孤館两何窮。熒煌短焰長疑暗，",
            "莫言明滅无多重，曾比人生一世中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 34
    },
    {
        "title": "句",
        "author": "韓溉",
        "biography": "",
        "paragraphs": [
            "門掩落花人別后，窗含残月酒醒时。（《愁诗》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 35
    },
    {
        "title": "春怨",
        "author": "金昌緒",
        "biography": "",
        "paragraphs": [
            "打起黃鶯兒，莫教枝上啼。啼时驚妾夢，不得到遼西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 36
    },
    {
        "title": "放猿",
        "author": "曾麻幾",
        "biography": "",
        "paragraphs": [
            "孤猿鎖檻歲年深，放出城南百丈林。",
            "綠水任從聯臂飲，青山不用斷腸吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百六十八",
        "no#": 37
    }
]