[
    {
        "title": "奉和登會昌山應制",
        "author": "趙起",
        "biography": "",
        "paragraphs": [
            "睿想入希夷，真遊到具茨。玉鸞登嶂遠，雲輅出花迟。",
            "泉壑凝神处，阳和布澤时。六龍多顺動，四海正雍熙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 1
    },
    {
        "title": "冬日与群公泛舟焦山",
        "author": "王瓚",
        "biography": "",
        "paragraphs": [
            "江外水不凍，今年寒複迟。眾芳且未歇，近臘仍袷衣。",
            "载酒適我情，興來趣漸微。方舟大川上，環酌对落暉。",
            "两片青石棱，波際无因依。三山安可到，欲到风引归。",
            "滄溟壯觀多，心目豁暫时。況得窮日夕，乘槎何所之。",
            "縱步不知遠，夕阳犹未回。好花隨处發，流水趁人來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 2
    },
    {
        "title": "度揭鴻嶺",
        "author": "慕容韋",
        "biography": "",
        "paragraphs": [
            "閩越曾為塞，将军舊置營。我歌空感慨，西北望神京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 3
    },
    {
        "title": "湘江",
        "author": "黃文",
        "biography": "",
        "paragraphs": [
            "瀟湘江頭三月春，柳條弄日搖黃金。鷓鴣一聲在何许，",
            "馬蹄不為行客留，心掛長林屡回首。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 4
    },
    {
        "title": "題龍阳縣青草湖",
        "author": "唐溫如",
        "biography": "",
        "paragraphs": [
            "西风吹老洞庭波，一夜湘君白发多。",
            "醉后不知天在水，滿船清夢壓星河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 5
    },
    {
        "title": "訾家洲",
        "author": "歐阳賓",
        "biography": "",
        "paragraphs": [
            "舊业分明桂水頭，人归业盡水東流。",
            "春风日暮江頭立，不及漁人有釣舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 6
    },
    {
        "title": "題吉州龍溪",
        "author": "何敬",
        "biography": "",
        "paragraphs": [
            "龍溪之山秀而峙，龍溪之水清无底。狂风激烈翻春濤，",
            "四时佳境不可窮，仿佛直与桃源通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 7
    },
    {
        "title": "過睦州青溪渡",
        "author": "楊彝",
        "biography": "",
        "paragraphs": [
            "天闊銜江雨，冥冥上客衣。潭清魚可数，沙晚雁爭飛。",
            "川谷留雲气，鵜鶘傍釣磯。飄零江海客，欹側一帆归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 8
    },
    {
        "title": "闔閭城懷古",
        "author": "裴瑤",
        "biography": "",
        "paragraphs": [
            "五湖春水接遙天，國破君亡不記年。",
            "惟有妖娥曾舞处，古台寂寞起愁煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 9
    },
    {
        "title": "葦谷",
        "author": "鄭玉",
        "biography": "",
        "paragraphs": [
            "水會三川漾碧波，雕阴人唱采花歌。",
            "舊时白翟今荒壤，葦谷淒淒风雨多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 10
    },
    {
        "title": "登岳阳樓",
        "author": "麻溫其",
        "biography": "",
        "paragraphs": [
            "湖邊景物屬秋天，樓上风光似去年。仙侶緱生留福地，",
            "极目江山何处是，一帆万里信归船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 11
    },
    {
        "title": "經望湖驛",
        "author": "韋鎰",
        "biography": "",
        "paragraphs": [
            "大漠无屯雲，孤峰出乱柳。前驅白登道，顧失飛狐口。",
            "遙憶代王城，俯臨恒山后。累累多古墓，寂寞為墟久。",
            "豈不固金湯，終闻擊銅鬥。交歡初仗信，接宴翻貽咎。",
            "埋寶賊夫人，磨笄傷彼婦。功成行且薄，義立名不朽。",
            "莫慎纖微端，其何社稷守。身歿國遂亡，此立人君醜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 12
    },
    {
        "title": "杪秋洞庭懷王道士",
        "author": "謝太虛",
        "biography": "",
        "paragraphs": [
            "漂泊日複日，洞庭今更秋。青桃亦何意，此夜催人愁。",
            "惆悵客中月，裴回江上樓。心知楚天遠，目送滄波流。",
            "謝客久已滅，微言无处求。空餘白雲在，客興隨孤舟。",
            "千里杳難盡，一身常独遊。故園複何许，江漢徒迟留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 13
    },
    {
        "title": "君山祠",
        "author": "周岳秀",
        "biography": "",
        "paragraphs": [
            "万頃湖波浸碧天，旌封香火幾千年。风濤澎湃魚龍舞，",
            "江河愿借吹噓便，應有神功在目前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 14
    },
    {
        "title": "新樂府",
        "author": "馬逢",
        "biography": "",
        "paragraphs": [
            "溫谷春生至，宸游近甸榮。雲隨天上轉，风入禦筵輕。",
            "翠蓋浮佳气，朱樓依太清。朝臣冠劍退，宮女管弦迎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 15
    },
    {
        "title": "部落曲",
        "author": "馬逢",
        "biography": "",
        "paragraphs": [
            "蕃军傍塞游，代馬噴风秋。老将垂金甲，閼支著錦裘。",
            "雕戈蒙豹尾，紅旆插狼頭。日暮天山下，鳴笳漢使愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 16
    },
    {
        "title": "從军",
        "author": "馬逢",
        "biography": "",
        "paragraphs": [
            "漢馬千蹄合一群，單于鼓角隔山闻。",
            "沙塠风起紅樓下，飛上胡天作陣雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 17
    },
    {
        "title": "宮詞二首",
        "author": "馬逢",
        "biography": "",
        "paragraphs": [
            "金吾持戟護軒簷，天樂傳教万姓瞻。",
            "樓上美人相倚看，紅妝透出水晶簾。",
            "玉樓天半起笙歌，风送宮人笑语和。",
            "月影殿開闻曉漏，水晶簾卷近秋河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百七十二",
        "no#": 18
    }
]