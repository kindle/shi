[
    {
        "title": "喜韓少府見訪",
        "author": "胡令能",
        "biography": "",
        "paragraphs": [
            "忽闻梅福來相訪，笑著荷衣出草堂。",
            "兒童不慣見車馬，走入蘆花深处藏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 1
    },
    {
        "title": "觀鄭州崔郎中諸妓繡樣",
        "author": "胡令能",
        "biography": "",
        "paragraphs": [
            "日暮堂前花蕊嬌，爭拈小筆上床描。",
            "繡成安向春園裏，引得黃鶯下柳條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 2
    },
    {
        "title": "小兒垂釣",
        "author": "胡令能",
        "biography": "",
        "paragraphs": [
            "蓬頭稚子學垂綸，側坐莓苔草映身。",
            "路人借问遙招手，怕得魚驚不應人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 3
    },
    {
        "title": "王昭君",
        "author": "胡令能",
        "biography": "",
        "paragraphs": [
            "胡风似劍鎪人骨，漢月如鉤釣胃腸。",
            "魂夢不知身在路，夜來犹自到昭阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 4
    },
    {
        "title": "望夫石",
        "author": "嚴郾",
        "biography": "",
        "paragraphs": [
            "何代提戈去不還，独留形影白雲間。肌膚銷盡雪霜色，",
            "近來豈少征人婦，笑采蘼蕪上北山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 5
    },
    {
        "title": "賦百舌鳥",
        "author": "嚴郾",
        "biography": "",
        "paragraphs": [
            "此禽輕巧少同倫，我聽長疑舌滿身。星未沒河先報曉，",
            "莫倚春风便多事，玉樓還有晏眠人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 6
    },
    {
        "title": "永州陪鄭太守登舟夜宴，席上各賦诗",
        "author": "蔣肱",
        "biography": "",
        "paragraphs": [
            "江頭朱紱間青衿，豈是仙舟不可尋。谁敢強登徐稚榻，",
            "剪盡蠟紅人未觉，归时城郭曉煙深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 7
    },
    {
        "title": "寄遠",
        "author": "张迥1",
        "biography": "",
        "paragraphs": [
            "錦字凭谁達，闲庭草又枯。夜長燈影滅，天遠雁聲孤。",
            "蟬鬢凋将盡，虯髯白也无。幾回愁不语，因看朔方图。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 8
    },
    {
        "title": "春草凝露",
        "author": "张友正",
        "biography": "",
        "paragraphs": [
            "蒼蒼芳草色，含露对青春。已賴阳和長，仍慚潤澤频。",
            "日臨残未滴，风度欲成津。蕙葉垂偏重，蘭叢洗轉新。",
            "将行愁裛徑，欲采畏濡身。独愛池塘畔，清華遠襲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 9
    },
    {
        "title": "錦帶佩吳鉤",
        "author": "张友正",
        "biography": "",
        "paragraphs": [
            "帶劍谁家子，春朝紫陌遊。結邊霞聚錦，懸处月隨鉤。",
            "彩縷回文出，雄芒練影浮。葉依花裏豔，霜向鍔中秋。",
            "的皪宜驄馬，斕斒映綺裘。應須待報國，一刎月支頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 10
    },
    {
        "title": "山中臥病寄盧郎中",
        "author": "伍唐珪",
        "biography": "",
        "paragraphs": [
            "十年耕釣水雲間，住僻家貧少往還。一徑綠苔凝曉露，",
            "空戀舊时恩獎地，无因匍匐出柴關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 11
    },
    {
        "title": "寒食日獻郡守",
        "author": "伍唐珪",
        "biography": "",
        "paragraphs": [
            "入門堪笑複堪怜，三徑苔荒一釣船。",
            "慚愧四鄰教斷火，不知廚裏久无煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 12
    },
    {
        "title": "上蘇使君",
        "author": "伍唐珪",
        "biography": "",
        "paragraphs": [
            "江西昔日推韓注，袁水今朝数趙祥。",
            "縱使文翁能待客，終栽桃李不成行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 13
    },
    {
        "title": "贈妓人王福娘",
        "author": "孫棨",
        "biography": "",
        "paragraphs": [
            "彩翠仙衣紅玉膚，輕盈年在破瓜初。霞杯醉勸劉郎賭，",
            "謾图西子晨妝樣，西子元來未得如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 14
    },
    {
        "title": "題妓王福娘牆",
        "author": "孫棨",
        "biography": "",
        "paragraphs": [
            "移壁回窗費幾朝，指鐶偷解博紅椒。",
            "无端鬥草輸鄰女，更被拈将玉步搖。",
            "寒繡衣裳餉阿嬌，新團香獸不禁燒。",
            "東鄰起樣裙腰闊，剩蹙黃金線幾條。",
            "試共卿卿语笑初，画堂連遣侍兒呼。",
            "寒肌不耐金如意，白獺為膏郎有无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 15
    },
    {
        "title": "戲李文遠",
        "author": "孫棨",
        "biography": "",
        "paragraphs": [
            "引君來訪洞中仙，新月如眉拂戶前。",
            "領取嫦娥攀取桂，便從陵谷一时遷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 16
    },
    {
        "title": "題劉泰娘舍",
        "author": "孫棨",
        "biography": "",
        "paragraphs": [
            "尋常凡木最輕樗，今日尋樗桂不如。",
            "漢高新破咸阳后，英俊奔波遂吃虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 17
    },
    {
        "title": "戲张道人不飲酒",
        "author": "顏蕘",
        "biography": "",
        "paragraphs": [
            "言自雲山訪我來，每闻奇秘觉叨陪。",
            "吾師不飲人間酒，應待流霞即舉杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 18
    },
    {
        "title": "句",
        "author": "顏蕘",
        "biography": "",
        "paragraphs": [
            "爽籟盡成鳴鳳曲，遊人多是弄珠仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 19
    },
    {
        "title": "秋醉歌",
        "author": "张為",
        "biography": "",
        "paragraphs": [
            "金风颯已起，還是招漁翁。攜酒天姥岑，自彈嶧阳桐。",
            "脫卻登山履，赤腳翹青筇。泉聲掃残暑，猿臂攀長松。",
            "翠微泛樽綠，苔蘚分煙紅。造化处術內，相对数壺空。",
            "醉眠嶺上草，不觉夜露濃。一夢到天曉，始觉一醉中。",
            "皎然夢中路，直到瀛洲東。初平把我臂，相与騎白龍。",
            "三留对上帝，玉樓十二重。上帝賜我酒，送我敲金鐘。",
            "寶閣香斂苒，琪樹寒玲瓏。動葉如笙篁，音律相怡融。",
            "珍重此一醉，百骸出天地。長如此夢魂，永謝名与利。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 20
    },
    {
        "title": "謝別毛仙翁",
        "author": "张為",
        "biography": "",
        "paragraphs": [
            "羸形感神药，削骨生豐肌。蘭炷飄靈煙，妖怪立誅夷。",
            "重睹日月光，何報父母慈。黃河濁袞袞，別淚流澌澌。",
            "黃河清有时，別淚无收期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 21
    },
    {
        "title": "漁阳将军",
        "author": "张為",
        "biography": "",
        "paragraphs": [
            "霜髭擁頷对窮秋，著白貂裘独上樓。",
            "向北望星提劍立，一生長為國家憂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 22
    },
    {
        "title": "句",
        "author": "张為",
        "biography": "",
        "paragraphs": [
            "到处即閉戶，逢君方展眉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 23
    },
    {
        "title": "岑公岩",
        "author": "馬冉",
        "biography": "",
        "paragraphs": [
            "南溪有仙澗，咫尺非人間。泠泠松风下，日暮空蒼山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 24
    },
    {
        "title": "諸暨五泄山",
        "author": "周鏞",
        "biography": "",
        "paragraphs": [
            "路入蒼煙九過溪，九穿岩曲到招提。天分五溜寒傾北，",
            "當年老默无消息，犹有詞堂一杖藜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 25
    },
    {
        "title": "贈羅隱",
        "author": "劉贊",
        "biography": "",
        "paragraphs": [
            "人皆言子屈，独我謂君非。明主既難謁，青山何不归。",
            "年虛侵雪鬢，塵枉汙麻衣。自古逃名者，至今名豈微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 26
    },
    {
        "title": "句",
        "author": "劉贊",
        "biography": "",
        "paragraphs": [
            "絮花飛起雪漫漫，長得宮娥帶笑看。（《柳枝詞》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 27
    },
    {
        "title": "洛阳道",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "憧憧洛阳道，塵下生春草。行者豈无家，无人在家老。",
            "雞鳴前結束，爭去恐不早。百年路傍盡，白日車中曉。",
            "求富江海狹，取貴山嶽小。二端立在途，奔走无由了。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 28
    },
    {
        "title": "春晴",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "楚國多春雨，柴門喜晚晴。幽人臨水坐，好鳥隔花鳴。",
            "野色臨空闊，江流接海平。門前到溪路，今夜月分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 29
    },
    {
        "title": "秋晚郊居",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "遠聲霜后樹，秋色水邊村。野徑无來客，寒风自動門。",
            "海山藏日影，江月落潮痕。惆悵高飛晚，年年別故園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 30
    },
    {
        "title": "秋晚途次",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "秋色滿行路，此时心不閑。孤貧游上國，少壯有衰顏。",
            "眾鳥已归樹，旅人犹過山。蕭條遠林外，风急水潺潺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 31
    },
    {
        "title": "葛仙井",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "古井碧沉沉，分明見百尋。味甘傳邑內，脈冷應山心。",
            "圓入月輪淨，直涵峰影深。自從仙去后，汲引到如今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 32
    },
    {
        "title": "桐柏觀",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "飄飄雲外者，暫宿聚仙堂。半夜人无语，中宵月送涼。",
            "鶴归高樹靜，螢過小池光。不得多时住，門開是事忙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 33
    },
    {
        "title": "冬暮野寺",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "江東寒近臘，野寺水天昏。无酒可銷夜，隨僧早閉門。",
            "照牆燈影短，著瓦雪聲繁。飄泊仍千里，清吟欲斷魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 34
    },
    {
        "title": "贈濟禪師",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "碧峰秋寺內，禪客已无情。半頂發根白，一生心地清。",
            "竹房侵月靜，石徑到門平。山下塵囂路，終年誓不行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 35
    },
    {
        "title": "經墮淚碑",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "羊公傳化地，千古事空存。碑已无文字，人犹敬子孫。",
            "峴山長閉恨，漢水自流恩。数处煙嵐色，分明是淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 36
    },
    {
        "title": "長安冬夜书事",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "憂來長不寐，往事重思量。清渭幾年客，故衣今夜霜。",
            "春风谁识面，水國但牽腸。十二門車馬，昏明各自忙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 37
    },
    {
        "title": "越江漁父",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "借问釣魚者，持竿多少年。眼明汀島畔，頭白子孫前。",
            "棹入花时浪，燈留雨夜船。越江深見底，谁识此心堅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 38
    },
    {
        "title": "哭友人",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "逢著南州史，江邊哭问君。送終时有雪，归葬处无雲。",
            "官庫惟留劍，鄰僧共結墳。兒孫未成立，谁与集遺文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 39
    },
    {
        "title": "送李衡",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "羈棲親故少，遠別惜清才。天畔出相送，路長知未回。",
            "欲銷今日恨，強把異鄉杯。君去南堂后，應无客到來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 40
    },
    {
        "title": "宮怨",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "淚幹紅落臉，心盡白垂頭。自此方知怨，從來豈信愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 41
    },
    {
        "title": "惜花",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "无语与花別，細看枝上紅。明年又相見，還恐是愁中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 42
    },
    {
        "title": "宿巾子山禪寺",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "絕頂新秋生夜涼，鶴翻松露滴衣裳。",
            "前峰月映半江水，僧在翠微開竹房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 43
    },
    {
        "title": "再遊巾子山寺",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "靈江江上幘峰寺，三十年來两度登。",
            "野鶴尚巢松樹遍，竹房不見舊时僧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十七",
        "no#": 44
    },
    {
        "title": "三遊巾子山寺感述",
        "author": "任翻",
        "biography": "",
        "paragraphs": [
            "清秋絕頂竹房開，松鶴何年去不回。",
            "惟有前峰明月在，夜深犹過半江來。"
