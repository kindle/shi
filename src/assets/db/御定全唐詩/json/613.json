[
    {
        "title": "過雲居院玄福上人舊居",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "重到雲居独悄然，隔窗窺影尚疑禪。不逢野老來聽法，",
            "南宗弟子时时到，泣把山花奠幾筵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 1
    },
    {
        "title": "陪江西裴公遊襄州延慶寺",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "丹霄路上歇征輪，勝地偷闲一日身。不署前驅驚野鳥，",
            "更向碧山深處问，不妨犹有草茅臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 2
    },
    {
        "title": "西塞山泊漁家",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "白綸巾下發如絲，靜倚楓根坐釣磯。中婦桑村挑葉去，",
            "西塞山前終日客，隔波相羨盡依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 3
    },
    {
        "title": "襄州春遊",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "信馬騰騰觸處行，春风相引与诗情。等闲遇事成歌詠，",
            "岑牟單絞何曾著，莫道倡狂似禰衡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 4
    },
    {
        "title": "送從弟皮崇归複州",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "羨爾優遊正少年，竟陵煙月似吳天。車螯近岸无妨取，",
            "殷勤莫笑襄阳住，為愛南溪縮項鯿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 5
    },
    {
        "title": "題潼關蘭若",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "潼津罷警有招提，近百年无戰馬嘶。壯士不言三尺劍，",
            "關吏不勞重借问，棄繻生擬入耶溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 6
    },
    {
        "title": "襄阳闲居与友生夜會",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "習隱悠悠世不知，林園幽事遞相期。舊絲再上琴調晚，",
            "草玄寂淡无人愛，不遇劉歆更语谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 7
    },
    {
        "title": "習池晨起",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "清曙蕭森载酒來，涼风相引繞亭台。數聲翡翠背人去，",
            "竹屏风下登山屐，十宿高阳忘卻回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 8
    },
    {
        "title": "秋晚自洞庭湖別业寄穆秀才",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "破村寥落過重阳，独自攖寧葺草房。风撦紅蕉仍换葉，",
            "他日若修耆舊傳，為予添取此书堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 9
    },
    {
        "title": "華山李煉師所居",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "麻姑古貌上仙才，謫向蓮峰管玉台。瑞氣染衣金液啟，",
            "深夜寂寥存想歇，月天时下草堂來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 10
    },
    {
        "title": "宏詞下第感恩獻兵部侍郎",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "分明仙籍列清虛，自是還丹九轉疏。画虎已成翻類狗，",
            "犹有報恩方寸在，不知通塞竟何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 11
    },
    {
        "title": "襄州漢阳王故宅",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "碑字依稀廟已荒，犹闻耆舊憶賢王。園林一半為他主，",
            "柱天功业緣何事，不得終身似霍光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 12
    },
    {
        "title": "《傷盧獻秀才",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "湣征新價欲淩空，一首堪欺左太沖。只為白衣聲過重，",
            "手弄桂枝嫌不折，直教身歿負春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 13
    },
    {
        "title": "南阳",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "昆阳王氣已蕭疏，依舊山河捧帝居。廢路塌平残瓦礫，",
            "二百年來霸王业，可知今日是丘墟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 14
    },
    {
        "title": "秋晚訪李處士所居",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "門前襄水碧潺潺，靜釣归來不掩關。书閣鼠穿廚簏破，",
            "莫為愛诗偏念我，訪君多得醉中還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 15
    },
    {
        "title": "李處士郊居",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "石衣如發小溪清，溪上柴門架樹成。園裏水流澆竹響，",
            "滿引紅螺诗一首，劉楨失卻病心情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 16
    },
    {
        "title": "送令狐補闕归朝",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "文如日月氣如虹，舉國重生正始风。且愿仲山居左掖，",
            "為说明年今日事，晉廷新拜黑頭公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 17
    },
    {
        "title": "洛中寒食二首",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "千門万戶掩斜暉，繡幰金銜晚未归。擊鞠王孫如錦地，",
            "唯有路傍无意者，獻书未納问淮肥。",
            "遠近垂楊映鈿車，天津橋影壓神霞。弄春公子正回首，",
            "欲知豪貴堪愁處，請看邙山晚照斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 18
    },
    {
        "title": "登第後寒食杏園有宴，因寄錄事宋垂文同年",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "雨洗清明万象鮮，滿城車馬簇紅筵。恩榮雖得陪高會，",
            "縱來恐被青娥笑，未納春风一宴錢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 19
    },
    {
        "title": "陳先輩故居",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "杉桂交阴一裏餘，逢人渾似洞天居。千株橘樹唯沽酒，",
            "襄阳无限煙霞地，難覓幽奇似此殊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 20
    },
    {
        "title": "奉和魯望寒夜訪寂上人次韵",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "院寒青靄正沉沉，霜棧幹鳴入古林。數葉貝书松火暗，",
            "何事欲攀塵外契，除君皆有利名心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 21
    },
    {
        "title": "江南道中懷茅山廣文南阳博士三首",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "寒嵐依約認華阳，遙想高人臥草堂。半日始齋青z3飯，",
            "谁道夫君无伴侶，不離窗下見羲皇。",
            "住在華阳第八天，望君唯欲結良緣。堂扃洞裏千秋燕，",
            "不知何事迎新歲，烏納裘中一覺眠。",
            "五色香煙惹內文，石飴初熟酒初醺。将開丹灶那防鶴，",
            "如何世外无交者，一臥金壇只有君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 22
    },
    {
        "title": "奉和魯望早春雪中作吳體見寄",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "威仰噤死不敢语，瓊花雲魄清珊珊。溪光冷射觸鸀鳿，",
            "全吳縹瓦十万戶，惟君与我如袁安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 23
    },
    {
        "title": "吳中言情寄魯望",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "古來傖父愛吳鄉，一上胥台不可忘。愛酒有情如手足，",
            "為说松江堪老處，滿船煙月濕莎裳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 24
    },
    {
        "title": "行次野梅",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "蔦拂蘿捎一樹梅，玉妃无侶独裴回。好臨王母瑤池發，",
            "不堪便向多情道，万片霜華雨損來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 25
    },
    {
        "title": "揚州看辛夷花",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "臘前千朵亞芳叢，細膩偏勝素柰功。螓首不言披曉雪，",
            "應為當时天女服，至今犹未放全紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 26
    },
    {
        "title": "暇日独處寄魯望",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "幽慵不覺耗年光，犀柄金徽乱一床。野客共為賒酒计，",
            "无限高情好风月，不妨犹得事吾王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 27
    },
    {
        "title": "屣步訪魯望不遇",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "雪晴墟裏竹欹斜，蠟屐徐吟到陸家。荒徑掃稀堆柏子，",
            "擬受太玄今不遇，可怜遺恨似侯芭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 28
    },
    {
        "title": "開元寺客省早景即事",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "客省蕭條柿葉紅，樓臺如画倚霜空。銅池數滴桂上雨，",
            "如何塵外虛為契，不得支公此會同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 29
    },
    {
        "title": "奉和魯望独夜有懷吳體見寄",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "病鶴帶霧傍独屋，破巢含雪傾孤梧。濯足将加漢光腹，",
            "此时枉欠高散物，楠瘤作樽石作壚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 30
    },
    {
        "title": "病中有人惠海蟹轉寄魯望",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "紺甲青筐染菭衣，島夷初寄北人时。離居定有石帆覺，",
            "病中无用霜螯處，寄与夫君左手持。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 31
    },
    {
        "title": "病中美景頗阻追游因寄魯望",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "癭床閑臥晝迢迢，唯把真如慰寂寥。南國不須收薏苡，",
            "看取病來多少日，早梅零落玉華焦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 32
    },
    {
        "title": "魯望以花翁之什見招因次韵酬之",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "九十攜鋤傴僂翁，小園幽事盡能通。劚煙栽药為身计，",
            "不知家道能多少，只在句芒一夜风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 33
    },
    {
        "title": "病中庭際海石榴花盛發，感而有寄",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "一夜春光綻絳囊，碧油枝上晝煌煌。风勻只似調紅露，",
            "不知桂樹知情否，无限同游阻陸郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 34
    },
    {
        "title": "早春以橘子寄魯望",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "個個和枝葉捧鮮，彩凝犹帶洞庭煙。不為韓嫣金丸重，",
            "知君多病仍中聖，盡送寒苞向枕邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 35
    },
    {
        "title": "病中书情寄上崔諫議",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "十日來來曠奉公，閉門无事忌春风。蟲絲度日縈琴薦，",
            "殷勤莫怪求醫切，只為山櫻欲放紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 36
    },
    {
        "title": "病孔雀",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "煙花雖媚思沈冥，犹自抬頭護翠翎。強聽紫簫如欲舞，",
            "盡日春风吹不起，鈿毫金縷一星星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 37
    },
    {
        "title": "奉和魯望上元日道室焚修",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "明真臺上下仙官，玄藻初吟万籟寒。飆禦有聲时杳杳，",
            "端簡不知清景暮，靈蕪香燼落金壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 38
    },
    {
        "title": "奉酬魯望惜春見寄",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "十五日中春日好，可怜沉痼冷如灰。以前雖被愁将去，",
            "病中无限花番次，為約東风且住開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 39
    },
    {
        "title": "闻魯望游顏家林園病中有寄",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "一夜韶姿著水光，謝家春草滿池塘。細挑泉眼尋新脈，",
            "分明不得同君賞，盡日傾心羨索郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 40
    },
    {
        "title": "奉和魯望春雨即事次韵",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "織恨凝愁映鳥飛，半旬飄灑掩韶暉。山容洗得如煙瘦，",
            "何年細濕華阳道，两乘巾車相並归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 41
    },
    {
        "title": "魯望春日多尋野景日休抱疾杜門因有是寄",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "野侶相逢不待期，半緣幽事半緣诗。烏紗任岸穿筋竹，",
            "病中不用君相憶，折取山櫻寄一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 42
    },
    {
        "title": "魯望以躬掇野蔬兼示雅什，用以酬謝",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "杖擿春煙暖向阳，煩君為我致盈筐。深挑乍見牛唇液，",
            "雕胡飯熟bu餬軟，不是高人不合嘗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 43
    },
    {
        "title": "臥病感春寄魯望",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "烏皮幾上困騰騰，玉柄清羸愧不能。昨夜眠时稀似鶴，",
            "任是雨多遊未得，也須收在探花朋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 44
    },
    {
        "title": "奉和魯望徐方平後闻赦次韵",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "金雞煙外上臨軒，紫誥新垂作解恩。涿鹿未銷初敗血，",
            "未遣蒲車问幽隱，共君應老抱桐孫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 45
    },
    {
        "title": "奉酬魯望見答魚箋之什",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "輕如隱起膩如飴，除卻鮫工解制稀。欲写恐成河伯詔，",
            "若用莫将閑處去，好題春思贈江妃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 46
    },
    {
        "title": "病後春思",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "連錢錦暗麝氛氳，荊思多才詠鄂君。孔雀鈿寒窺沼見，",
            "應笑病來慚滿愿，花箋好作斷腸文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 47
    },
    {
        "title": "偶成小酌招魯望不至，以诗為解，因次韵酬之",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "醉侶相邀愛早阳，小筵催辦不勝忙。沖深柳駐吳娃幰，",
            "如何共是忘形者，不見漁阳摻一場。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 48
    },
    {
        "title": "以紗巾寄魯望因而有作",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "周家新樣替三梁。裹發偏宜白麵郎。掩斂乍疑裁黑霧，",
            "更有一般君未识，虎文巾在絳霄房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 49
    },
    {
        "title": "臨頓宅将有归於之日魯望以诗見貺，因抒懷酬之",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "共老林泉忍暫分，此生應不识回文。幾枚竹笥送德曜，",
            "居然自是幽人事，輒莫教他孫壽闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 50
    },
    {
        "title": "奉和魯望謝惠巨魚之半",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "釣公來信自松江，三尺春魚撥剌霜。腹內舊鉤苔染澀，",
            "何事貺君偏得所，只緣同是越航郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 51
    },
    {
        "title": "館娃宮懷古",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "豔骨已成蘭麝土，宮牆依舊壓層崖。弩台雨壞逢金鏃，",
            "姑蘇麋鹿真闲事，須為當时一愴懷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 52
    },
    {
        "title": "以紫石硯寄魯望兼酬見贈",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "樣如金蹙小能輕，微潤将融紫玉英。石墨一研為鳳尾，",
            "两地有期皆好用，不須空把洗溪聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 53
    },
    {
        "title": "奉和魯望同遊北禪院",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "戚曆杉阴入草堂，老僧相見似相忘。吟多幾轉蓮花漏，",
            "雲林滿眼空羈滯，欲對彌天卻自傷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 54
    },
    {
        "title": "孫發百篇将遊天臺請诗贈行，因以送之",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "孫子荊家思有餘，元戎曾薦入公車。百篇宮體喧金屋，",
            "因逢二老如相问，正滯江南為eE魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 55
    },
    {
        "title": "奉和魯望薔薇次韵",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "谁繡連延滿戶陳，暫應遮得陸郎貧。紅芳掩斂将迷蝶，",
            "只應是董雙成戲，剪得神霞寸寸新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 56
    },
    {
        "title": "闻開元寺開筍園寄章上人",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "園鎖開聲駭鹿群，滿林鮮籜水犀文。森森競泫林梢雨，",
            "折煙束露如相遺，何胤明朝不茹葷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 57
    },
    {
        "title": "開元寺佛缽诗",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "帝青石作綠冰姿，曾得金人手自持。拘律樹邊齋散後，",
            "從此共君新頂戴，斜风應不等闲吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 58
    },
    {
        "title": "夏首病癒因招魯望",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "曉入清和尚袷衣，夏阴初合掩雙扉。一聲撥谷桑柘晚，",
            "明朝早起非无事，買得蓴絲待陸机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 59
    },
    {
        "title": "奉和魯望新夏東郊閑泛",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "水物輕明淡似秋，多情才子倚蘭舟。碧莎裳下攜诗草，",
            "共君莫问當时事，一點沙禽勝五侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 60
    },
    {
        "title": "奉和魯望四月十五日道室书事",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "望朝齋戒是尋常，靜啟金根第幾章。竹葉飲為甘露色，",
            "剩欲与君終此志，頑仙唯恐鬢成霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 61
    },
    {
        "title": "奉和魯望看壓新醅",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "一簀松花細有聲，旋将渠碗撇寒清。秦吳只恐篘來近，",
            "五湖煙水郎山月，合向樽前问底名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 62
    },
    {
        "title": "登初阳樓寄懷北平郎中",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "危樓新制號初阳，白粉青葌射沼光。避酒幾浮輕舴艋，",
            "莫怪重登频有恨，二年曾侍舊吳王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 63
    },
    {
        "title": "夏初訪魯望偶題小齋",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "半裏芳阴到陸家，藜床相勸飯胡麻。林間度宿拋棋局，",
            "踟躕未放闲人去，半岸紗帩待月華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 64
    },
    {
        "title": "所居首夏，水木尤清，適然有作",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "病來无事草堂空，晝水休闻十二筒。桂靜似逢青眼客，",
            "盡日枕书慵起得，被君犹自笑從公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 65
    },
    {
        "title": "重玄寺元達年逾八十，好種名药，凡所植者多至自天台四明包山句曲，叢翠紛糅，各可指名，余奇而訪之，因題二章",
        "author": "皮日休",
        "biography": "",
        "paragraphs": [
            "雨滌煙鋤傴僂齎，紺牙紅甲两三畦。药名卻笑桐君少，",
            "怪來昨日休持缽，一尺雕胡似掌齊。",
            "香蔓蒙蘢覆昔邪，桂煙杉露濕袈裟。石盆换水撈松葉，",
            "支公謾道怜神駿，不及今朝種一麻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百一十三",
        "no#": 66
    }
]