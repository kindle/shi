[
    {
        "title": "金陵懷古",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "玉樹歌残王氣終，景阳兵合戍樓空。松楸遠近千官塚，",
            "英雄一去豪華盡，唯有青山似洛中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 1
    },
    {
        "title": "姑蘇懷古",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "宮館餘基輟棹過，黍苗无限独悲歌。荒台麋鹿爭新草，",
            "可怜國破忠臣死，日日東流生白波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 2
    },
    {
        "title": "淩歊台",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "宋祖淩高樂未回，三千歌舞宿層台。湘潭雲盡暮山出，",
            "百年便作万年计，岩畔古碑空綠苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 3
    },
    {
        "title": "驪山",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "闻说先皇醉碧桃，日華浮動郁金袍。风隨玉輦笙歌迥，",
            "貴妃沒後巡遊少，瓦落宮牆見野蒿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 4
    },
    {
        "title": "咸阳城東樓",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "一上高城万里愁，蒹葭楊柳似汀洲。溪雲初起日沈閣，",
            "行人莫问當年事，故國東來渭水流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 5
    },
    {
        "title": "京口闲居寄京洛友人",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "吳門煙月昔同遊，楓葉蘆花並客舟。聚散有期雲北去，",
            "何處相思不相見，鳳城龍闕楚江頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 6
    },
    {
        "title": "冬日登越王台懷归",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "月沉高岫宿雲開，万里归心独上來。河畔雪飛揚子宅，",
            "鄉信漸稀人漸老，只應频看一枝梅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 7
    },
    {
        "title": "對雪",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雲度龍山暗倚城，先飛淅瀝引輕盈。素娥冉冉拜瑤闕，",
            "剡溪一醉十年事，忽憶棹回天未明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 8
    },
    {
        "title": "送蕭處士归緱嶺別业",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "醉斜烏帽發如絲，曾看仙人一局棋。賓館有魚為客久，",
            "今夜月明何處宿，九疑雲盡碧參差。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 9
    },
    {
        "title": "与鄭二秀才同舟東下洛中，親朋送至景雲寺",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "三十六峰橫一川，綠波无路草芊芊。牛羊晚食鋪平地，",
            "東西未有相逢日，更把繁華共醉眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 10
    },
    {
        "title": "長安歲暮",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "独望天門倚劍歌，幹时无计老關河。東归万里慚张翰，",
            "三山歲歲有人去，唯恐海风生白波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 11
    },
    {
        "title": "贈茅山高拾遺",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "諫獵归來綺季歌，大茅峰影滿秋波。山齋留客掃紅葉，",
            "雲中黃鵠日千里，自宿自飛无網羅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 12
    },
    {
        "title": "李秀才近自塗口遷居新安適枉緘书見寬悲戚因以此答",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "遠书開罷更依依，晨坐高臺竟落暉。顏巷雪深人已去，",
            "今日勞君犹问訊，一官唯長故山薇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 13
    },
    {
        "title": "贈蕭兵曹先輩",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "廣陵堤上昔離居，帆轉瀟湘万里餘。楚客病时无鵩鳥，",
            "闻说攜琴兼载酒，邑人爭识馬相如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 14
    },
    {
        "title": "題舒女廟",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "山樂來迎去不言，廟前高柳水禽喧。綺羅无色雨侵帳，",
            "孤舟夢斷行雲散，何限離心寄曉猿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 15
    },
    {
        "title": "姑孰官舍",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "草生宮舍似闲居，雪照南窗滿素书。貧後始知為吏拙，",
            "不待秋风便归去，紫阳山下是吾廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 16
    },
    {
        "title": "淩歊台送韋秀才",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雲起高臺日未沉，數村残照半岩阴，野蠶成繭桑柘盡，",
            "故山迢遞故人去，一夜月明千里心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 17
    },
    {
        "title": "送嶺南盧判官罷職归華阴山居",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "曾事劉琨雁塞空，十年书劍任飄蓬。東堂舊屈移山志，",
            "關西舊友如相问，已许滄浪伴釣翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 18
    },
    {
        "title": "将度故城湖阻风夜泊永阳戍",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "行盡青溪日已蹉，雲容山影水嵯峨。樓前归客怨清夢，",
            "終期一艇载樵去，來往使帆淩白波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 19
    },
    {
        "title": "鄭侍禦廳玩鶴",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "碧天飛舞下晴莎，金閣瑤池絕網羅。岩響數聲风滿樹，",
            "雙翅一開千万里，只應棲隱戀喬柯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 20
    },
    {
        "title": "南亭夜坐，貽開元禪定二道者",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "暮暮焚香何處宿，西岩一室映疏藤。光阴難駐跡如客，",
            "身閑境靜日為樂，若问其餘非我能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 21
    },
    {
        "title": "朱坡故少保杜公池亭",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "杜陵池榭綺城東，孤島回汀路不窮。高岫乍疑三峽近，",
            "還有昔时巢燕在，飛來飛去画堂中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 22
    },
    {
        "title": "秋日早朝",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "宵衣應待絕更籌，環佩鏘鏘月下樓。井轉轆轤千樹曉，",
            "虛戴鐵冠无一事，滄江归去老漁舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 23
    },
    {
        "title": "滄浪峽",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "纓帶流塵發半霜，独尋残月下滄浪。一聲溪鳥暗雲散，",
            "紅蝦青鯽紫芹脆，归去不辭來路長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 24
    },
    {
        "title": "故洛城",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "禾黍離離半野蒿，昔人城此豈知勞。水聲東去市朝變，",
            "可怜緱嶺登仙子，犹自吹笙醉碧桃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 25
    },
    {
        "title": "闻釋子棲玄欲奉道因寄",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "欲求真訣戀禪扃，羽帔方袍盡有情。仙骨本微靈鶴遠，",
            "今日勸師師莫惑，長生難學證无生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 26
    },
    {
        "title": "南海府罷南康阻淺行侶稍稍登陸而邁主人燕餞至频暮宿東溪",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "暗灘水落漲虛沙，灘去秦吳万里賒。馬上折残江北柳，",
            "山鳥一聲人未起，半床春月在天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 27
    },
    {
        "title": "秋晚雲阳驛西亭蓮池",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "心憶蓮池秉燭游，葉残花敗尚維舟。煙開翠扇清风曉，",
            "空懷遠道難持贈，醉倚闌幹盡日愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 28
    },
    {
        "title": "題勤尊師曆阳山居",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "二十知兵在羽林，中年潛识子房心。蒼鷹出塞胡塵滅。",
            "白鶴還鄉楚水深。春坼酒瓶浮药氣，晚攜棋局帶松阴。",
            "雞籠山上雲多處，自劚黃精不可尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 29
    },
    {
        "title": "懷舊居",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "兵书一篋老无功，故國郊扉在夢中。藤蔓覆梨张谷暗。",
            "草花侵菊庾園空。朱門跡忝登龍客，白屋心期失馬翁。",
            "楚水吳山何處是，北窗残月照屏风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 30
    },
    {
        "title": "祗命许昌自郊居，移就公館秋日寄茅山高拾遺",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "一笛迎风万葉飛，強攜刀筆换荷衣。潮寒水國秋砧早，",
            "中年未识從军樂，虛近三茅望少微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 31
    },
    {
        "title": "傷虞将军",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "白首從军未有名，近将孤劍到江城。巴童戍久能番语，",
            "可怜身死家犹遠，汴水東流无哭聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 32
    },
    {
        "title": "晚自朝台津至韋隱居郊園",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "秋來鳧雁下方塘，系馬朝臺步夕阳。村徑繞山松葉暗，",
            "西下磻溪犹万里，可能垂白待文王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 33
    },
    {
        "title": "寓居開元精舍，酬薛秀才見貽",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "知己蕭條信陸沉，茂陵扶疾臥西林。芰荷风起客堂靜，",
            "怜君诗句犹相憶，題在空齋夜夜吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 34
    },
    {
        "title": "別劉秀才",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "三獻无功玉有瑕，更攜书劍客天涯。孤帆夜別瀟湘雨，",
            "關河万里秋风急，望見鄉山不到家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 35
    },
    {
        "title": "早發天臺中岩寺度關嶺次天姥岑",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "來往天臺天姥間，欲求真訣駐衰顏。星河半落岩前寺，",
            "可知劉阮逢人處，行盡深山又是山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 36
    },
    {
        "title": "游錢塘青山李隱居西齋",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "小隱西亭為客開，翠蘿深處遍蒼苔。林間掃石安棋局，",
            "雲山繞屋犹嫌淺，欲棹漁舟近釣台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 37
    },
    {
        "title": "春日郊園戲贈楊嘏評事",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "十裏蒹葭入薜蘿，春风谁许暫鳴珂。相如渴後狂還減，",
            "野橋沽酒茅簷醉，谁羨紅樓一曲歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 38
    },
    {
        "title": "晚自東郭回留一二游侶",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "鄉心迢遞宦情微，吏散尋幽竟落暉。林下草腥巢鹭宿，",
            "今夜西齋好风月，一瓢春酒莫相違。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 39
    },
    {
        "title": "与鄭秀才叔侄會送楊秀才昆仲東归",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "书劍功迟白发新，異鄉仍送故鄉人。阮公留客竹林晚，",
            "洞庭煙月如終老，谁是長楊諫獵臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 40
    },
    {
        "title": "送郭秀才游天臺",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雲埋阴壑雪凝峰，半壁天臺已万重。人度碧溪疑輟棹，",
            "曾約共遊今独去，赤城西面水溶溶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 41
    },
    {
        "title": "送张尊師归洞庭",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "能琴道士洞庭西，风滿归帆路不迷。對岸水花霜後淺，",
            "他日相思两行字，无人知處武陵溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 42
    },
    {
        "title": "移攝太平寄前李明府",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "病移岩邑稱閑身，何處风光貰酒频。溪柳繞門彭澤令，",
            "早晚高臺更同醉，綠蘿如帳草如茵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十三",
        "no#": 43
    }
]