[
    {
        "title": "斑竹筒簟",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "血染斑斑成錦紋，昔年遺恨至今存。",
            "分明知是湘妃泣，何忍将身臥淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 1
    },
    {
        "title": "和嚴惲秀才落花",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "共惜流年留不得，且環流水醉流杯。",
            "无情紅豔年年盛，不恨凋零卻恨開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 2
    },
    {
        "title": "倡樓戲贈",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "細柳橋邊深半春，纈衣簾裏動香塵。",
            "无端有寄閑消息，背插金釵笑向人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 3
    },
    {
        "title": "初上船留寄",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "煙水本好尚，親交何慘淒。況為珠履客，即泊錦帆堤。",
            "沙雁同船去，田鴉繞岸啼。此时還有味，必臥日從西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 4
    },
    {
        "title": "秋岸",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "河岸微退落，柳影微凋疏。船上聽呼稚，堤南趁漉魚。",
            "数帆旗去疾，一艇箭回初。曾入相思夢，因凭附遠书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 5
    },
    {
        "title": "過大樑闻河亭方宴贈孫子端",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "梁園縱玩归應少，賦雪搜才去必频。",
            "板落豈緣无罰酒，不教客右更添人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 6
    },
    {
        "title": "題吳興消暑樓十二韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "晴日登攀好，危樓物象饒。一溪通四境，万岫饒層霄。",
            "鳥翼舒華屋，魚鱗棹短橈。浪花机乍織，雲葉匠新雕。",
            "台榭羅嘉卉，城池敞麗譙。蟾蜍來作鑒，螮蝀引成橋。",
            "燕任隨秋葉，人空集早潮。楚鴻行盡直，沙鹭立偏翹。",
            "暮角淒遊旅，清歌慘泬寥。景牽遊目困，愁托酒腸銷。",
            "遠吹流松韵，残阳渡柳橋。时陪庾公賞，還悟脫煩囂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 7
    },
    {
        "title": "奉送中丞姊夫儔自大理卿出鎮江西敘事书懷因成十二韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "惟帝憂南紀，搜賢与大藩。梅仙調步驟，庾亮拂櫜鞬。",
            "一室何勞掃，三章自不冤。精明如定國，孤峻似陳蕃。",
            "灞岸秋犹嫩，藍橋水始喧。紅旓掛石壁，黑槊斷雲根。",
            "滕閣丹霄倚，章江碧玉奔。一聲仙妓唱，千里暮江痕。",
            "私好初童稚，官榮見子孫。流年休掛念，万事至无言。",
            "玉輦君频過，馮唐将未論。庸书酬万債，竹塢问樊村。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 8
    },
    {
        "title": "中丞业深韜略，志在功名，再奉長句一篇兼有諮勸",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "檣似鄧林江拍天，越香巴錦万千千。滕王閣上柘枝鼓，",
            "要君嚴重疏歡樂，犹有河湟可下鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 9
    },
    {
        "title": "和裴傑秀才新櫻桃",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "新果真瓊液，人應宴紫蘭。圓疑竊龍頷，色已奪雞冠。",
            "遠火微微辨，繁星歷歷看。茂先知味好，曼倩恨偷難。",
            "忍用烹酥酪，從将玩玉盤。流年如可駐，何必九華丹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 10
    },
    {
        "title": "春思",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "豈君心的的，嗟我淚涓涓。綿羽啼來久，錦鱗书未傳。",
            "獸壚凝冷焰，羅幕蔽晴煙。自是求佳夢，何須訝晝眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 11
    },
    {
        "title": "代人作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "樓高春日早，屏束麝煙堆。盼眄凝魂別，依稀夢雨來。",
            "綠鬟羞妥麼，紅頰思天偎。鬥草怜香蕙，簪花間雪梅。",
            "戍遼雖咽切，游蜀亦迟回。錦字梭懸壁，琴心月滿台。",
            "笑筵凝貝啟，眠箔曉珠開。臘破征車動，袍襟对淚裁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 12
    },
    {
        "title": "偶題二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "勞勞千里身，襟袂滿行塵。深夜懸雙淚，短亭思遠人。",
            "蒼江程未息，黑水夢何频。明月輕橈去，唯應釣赤鱗。",
            "有恨秋來极，无端別后知。夜闌終耿耿，明發竟迟迟。",
            "信已凭鴻去，归唯与燕期。只因明月見，千里两相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 13
    },
    {
        "title": "冬至日遇京使發寄舍弟",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "遠信初凭雙鯉去，他鄉正遇一阳生。尊前豈解愁家國，",
            "竹門风過還惆悵，疑是松窗雪打聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 14
    },
    {
        "title": "洛下送张曼容赴上党召",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "歌闋樽残恨卻偏，凭君不用設離筵。未趨雉尾隨元老，",
            "羽书正急徵兵地，須遣頭风处处痊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 15
    },
    {
        "title": "宣州留贈",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "紅鉛濕盡半羅裙，洞府人間手欲分。滿面风流雖似玉，",
            "為報眼波須穩當，五陵游宕莫知闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 16
    },
    {
        "title": "寄題宣州開元寺",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "松寺曾同一鶴棲，夜深台殿月高低。",
            "何人為倚東樓柱，正是千山雪漲溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 17
    },
    {
        "title": "贈张祜",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "诗韵一逢君，平生稱所闻。粉毫唯画月，瓊尺只裁雲。",
            "黥陣人人懾，秋星歷歷分。数篇留別我，羞殺李将军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 18
    },
    {
        "title": "残春独來南亭因寄张祜",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "暖雲如粉草如茵，独步長堤不見人。一嶺桃花紅錦黦，",
            "仲蔚欲知何处在，苦吟林下拂诗塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 19
    },
    {
        "title": "宣州開元寺南樓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "小樓才受一床橫，終日看山酒滿傾。",
            "可惜和风夜來雨，醉中虛度打窗聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 20
    },
    {
        "title": "寄遠人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "終日求人蔔，回回道好音。那时離別后，入夢到如今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 21
    },
    {
        "title": "別沈处士",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "舊事參差夢，新程邐迤秋。故人如見憶，时到寺東樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 22
    },
    {
        "title": "留贈",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "舞靴應任闲人看，笑臉還須待我開。",
            "不用鏡前空有淚，薔薇花謝即归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 23
    },
    {
        "title": "奉和僕射相公春澤稍愆圣君軫慮嘉雪忽降品彙昭蘇即事书成四韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "飄來雞樹鳳池邊，漸壓瓊枝凍碧漣。銀闕雙高銀漢裏，",
            "上相抽毫歌帝德，一篇风雅美豐年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 24
    },
    {
        "title": "寄李播評事",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "子列光殊價，明时忍自高。寧无好舟楫，不泛惡风濤。",
            "大翼終難戢，奇鋒且自韜。春來煙渚上，幾淨雪霜毫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 25
    },
    {
        "title": "送牛相出鎮襄州",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "盛时常注意，南雍暫分茅。紫殿辭明主，岩廊別舊交。",
            "危幢侵碧霧，寒旆獵紅旓。德业懸秦鏡，威聲隱楚郊。",
            "拜塵先灑淚，成廈昔容巢。遙仰沈碑會，鴛鴦玉佩敲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 26
    },
    {
        "title": "送薛邽二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "可怜走馬騎驢漢，豈有风光肯占伊。",
            "只有三张最惆悵，下山回馬尚迟迟。",
            "小捷风流已俊才，便将紅粉作金台。",
            "明年未去池阳郡，更乞春时卻重來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 27
    },
    {
        "title": "見穆三十宅中庭海榴花謝",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "矜紅掩素似多才，不待櫻桃不逐梅。春到未曾逢宴賞，",
            "堪恨王孫浪遊去，落英狼藉始归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 28
    },
    {
        "title": "留誨曹師等诗",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "万物有醜好，各一姿狀分。唯人即不爾，學与不學論。",
            "學非探其花，要自撥其根。孝友与誠實，而不忘爾言。",
            "根本既深實，柯葉自滋繁。念爾无忽此，期以慶吾門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 29
    },
    {
        "title": "洛阳",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "文爭武戰就神功，时似開元天寶中。已建玄戈收相土，",
            "疑有女娥西望处，上阳煙樹正秋风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 30
    },
    {
        "title": "寄唐州李玭尚书",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "累代功勳照世光，奚胡闻道死心降。书功筆禿三千管，",
            "时人欲识胸襟否，彭蠡秋連万里江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 31
    },
    {
        "title": "南陵道中",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "南陵水面漫悠悠，风緊雲輕欲變秋。",
            "正是客心孤回处，谁家紅袖凭江樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 32
    },
    {
        "title": "登九峰樓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "晴江灩灩含淺沙，高低繞郭滯秋花。牛歌魚笛山月上，",
            "白頭搔殺倚柱遍，归棹何时闻軋鴉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 33
    },
    {
        "title": "別家",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "初歲嬌兒未识爺，別爺不拜手吒叉。",
            "拊頭一別三千里，何日迎門卻到家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 34
    },
    {
        "title": "归家",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "稚子牽衣问，归來何太迟。共谁爭歲月，贏得鬢邊絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 35
    },
    {
        "title": "雨",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "連雲接塞添迢遞，灑幕侵燈送寂寥。",
            "一夜不眠孤客耳，主人窗外有芭蕉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 36
    },
    {
        "title": "送人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "鴛鴦帳裏暖芙蓉，低泣關山幾万重。",
            "明鏡半邊釵一股，此生何处不相逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 37
    },
    {
        "title": "遣懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "道泰时還泰，时來命不來。何當離城市，高臥博山隈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 38
    },
    {
        "title": "醉贈薛道封",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "飲酒論文四百刻，水分雲隔二三年。",
            "男兒事业知公有，賣与明君直幾錢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 39
    },
    {
        "title": "歙州盧中丞見惠名醞",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "谁怜賤子啟窮途，太守封來酒一壺。攻破是非渾似夢，",
            "犹念悲秋更分賜，夾溪紅蓼映风蒲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 40
    },
    {
        "title": "詠襪",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "鈿尺裁量減四分，纖纖玉筍裹輕雲。",
            "五陵年少欺他醉，笑把花前出画裙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 41
    },
    {
        "title": "宮祠二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "蟬翼輕綃傅體紅，玉膚如醉向春风。",
            "深宮鎖閉犹疑惑，更取丹沙試辟宮。",
            "監宮引出暫開門，隨例須朝不是恩。",
            "銀鑰卻收金鎖合，月明花落又黃昏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 42
    },
    {
        "title": "月",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "三十六宮秋夜深，昭阳歌斷信沉沉。",
            "唯應独伴陳皇后，照見長門望幸心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 43
    },
    {
        "title": "忍死留別獻鹽鐵裴相公二十叔",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "賢相輔明主，蒼生壽域開。青春辭白日，幽壤作黃埃。",
            "豈是无多士，偏蒙不棄才。孤墳三尺土，谁可為培栽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 44
    },
    {
        "title": "悲吳王城",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "二月春风江上來，水精波動碎樓臺。吳王宮殿柳含翠，",
            "千秋万古无消息，國作荒原人作灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 45
    },
    {
        "title": "閨情代作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "梧桐葉落雁初归，迢遞无因寄遠衣。月照石泉金點冷，",
            "遙望戍樓天欲曉，滿城冬鼓白雲飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 46
    },
    {
        "title": "寄沈褒秀才",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "晴河万里色如刀，处处浮雲臥碧桃。仙桂茂时金鏡曉，",
            "他日憶君何处望，九天香滿碧蕭騷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 47
    },
    {
        "title": "入關",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "東西南北数衢通，曾取江西徑過東。",
            "今日更尋南去路，未秋應有北归鴻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 48
    },
    {
        "title": "及第后寄長安故人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "東都放榜未花開，三十三人走馬回。",
            "秦地少年多釀酒，已将春色入關來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 49
    },
    {
        "title": "偶作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "才子风流詠曉霞，倚樓吟住日初斜。",
            "驚殺東鄰繡床女，錯将黃暈壓檀花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 50
    },
    {
        "title": "贈終南蘭若僧",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "北闕南山是故鄉，两枝仙桂一时芳。",
            "休公都不知名姓，始觉禪門气味長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 51
    },
    {
        "title": "遣懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "落魄江南载酒行，楚腰腸斷掌中輕。",
            "十年一觉揚州夢，贏得青樓薄幸名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 52
    },
    {
        "title": "秋感",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "金风万里思何盡，玉樹一窗秋影寒。",
            "独掩柴門明月下，淚流香袂倚闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 53
    },
    {
        "title": "贈漁父",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "蘆花深澤靜垂綸，月夕煙朝幾十春。",
            "自说孤舟寒水畔，不曾逢著独醒人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 54
    },
    {
        "title": "歎花",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "自恨尋芳到已迟，往年曾見未開时。",
            "如今风擺花狼藉，綠葉成阴子滿枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 55
    },
    {
        "title": "題劉秀才新竹",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "数莖幽玉色，曉夕翠煙分。聲破寒窗夢，根穿綠蘚紋。",
            "漸籠當檻日，欲礙入簾雲。不是山阴客，何人愛此君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 56
    },
    {
        "title": "山行",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "遠上寒山石徑斜，白雲生处有人家。",
            "停車坐愛楓林晚，霜葉紅於二月花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 57
    },
    {
        "title": "书懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "滿眼青山未得過，鏡中无那鬢絲何。",
            "只言旋老轉无事，欲到中年事更多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 58
    },
    {
        "title": "紫薇花",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "曉迎秋露一枝新，不占園中最上春。",
            "桃李无言又何在，向风偏笑豔阳人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 59
    },
    {
        "title": "醉后呈崔大夫",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "謝傅秋涼閱管弦，徒教賤子侍華筵。",
            "溪頭正雨归不得，辜負東窗一觉眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 60
    },
    {
        "title": "和宣州沈大夫登北樓书懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "兵符嚴重辭金馬，星劍光芒射鬥牛。筆落青山飄古韵，",
            "可惜登臨佳麗地，羽仪須去鳳池遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 61
    },
    {
        "title": "夜雨",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "九月三十日，雨聲如別秋。无端滿階葉，共白幾人頭。",
            "點滴侵寒夢，蕭騷著淡愁。漁歌聽不唱，蓑濕棹回舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 62
    },
    {
        "title": "方響",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "数條秋水掛琅玕，玉手丁當怕夜寒。",
            "曲盡連敲三四下，恐驚珠淚落金盤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 63
    },
    {
        "title": "将出關宿層峰驛，卻寄李諫議",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "孤驛在重阻，雲根掩柴扉。数聲暮禽切，万壑秋意归。",
            "心馳碧泉澗，目斷青瑣闈。明日武關外，夢魂勞遠飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 64
    },
    {
        "title": "使回枉唐州崔司馬书，兼寄四韵因和",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "清晨候吏把书來，十载離憂得暫開。癡叔去时還讀易，",
            "莫為霜台愁歲暮，潛龍須待一聲雷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 65
    },
    {
        "title": "郡齋秋夜即事，寄斛斯处士许秀才",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "有客谁人肯夜過，独怜风景奈愁何。邊鴻怨处迷霜久，",
            "馳心只待城烏曉，幾对虛簷望白河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 66
    },
    {
        "title": "早春題真上人院",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "清羸已近百年身，古寺风煙又一春。",
            "寰海自成戎馬地，唯師曾是太平人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 67
    },
    {
        "title": "对花微疾不飲，呈坐中諸公",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "花前雖病亦提壺，数調持觴興有无。",
            "盡日臨风羨人醉，雪香空伴白髭須。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 68
    },
    {
        "title": "酬王秀才桃花園見寄",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "桃滿西園淑景催，幾多紅豔淺深開。",
            "此花不逐溪流出，晉客无因入洞來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 69
    },
    {
        "title": "走筆送杜十三归京",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "煙鴻上漢聲聲遠，逸驥尋雲步步高。",
            "應笑內兄年六十，郡城閑坐養霜毛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 70
    },
    {
        "title": "送王十至褒中因寄尚书",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "闕下經年別，人間两地情。壇場新漢将，煙月古隋城。",
            "雁去梁山遠，雲高楚岫明。君家荷藕好，緘恨寄遙程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 71
    },
    {
        "title": "后池泛舟送王十",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "相送西郊暮景和，青蒼竹外繞寒波。",
            "為君蘸甲十分飲，應見離心一倍多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 72
    },
    {
        "title": "重送王十",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "執袂還應立馬看，向來離思始知難。",
            "雁飛不見行塵滅，景下山遙极目寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 73
    },
    {
        "title": "洛阳秋夕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "泠泠寒水帶霜风，更在天橋夜景中。",
            "清禁漏閑煙樹寂，月輪移在上阳宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 74
    },
    {
        "title": "贈獵騎",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "已落雙雕血尚新，鳴鞭走馬又翻身。",
            "凭君莫射南來雁，恐有家书寄遠人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 75
    },
    {
        "title": "懷吳中馮秀才",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "長洲苑外草蕭蕭，卻算游程歲月遙。",
            "唯有別时今不忘，暮煙秋雨過楓橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 76
    },
    {
        "title": "寄東塔僧",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "初月微明漏白煙，碧松梢外掛青天。",
            "西风靜起傳深夜，應送愁吟入夜禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 77
    },
    {
        "title": "秋夕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "紅燭秋光冷画屏，輕羅小扇撲流螢。",
            "天階夜色涼如水，坐看牽牛織女星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 78
    },
    {
        "title": "瑤瑟",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "玉仙瑤瑟夜珊珊，月過樓西桂燭残。",
            "风景人間不如此，動搖湘水徹明寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 79
    },
    {
        "title": "送故人归山",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "三清洞裏无端別，又拂塵衣欲臥雲。",
            "看著掛冠迷处所，北山蘿月在移文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 80
    },
    {
        "title": "闻角",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "曉樓煙檻出雲霄，景下林塘已寂寥。",
            "城角為秋悲更遠，護霜雲破海天遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 81
    },
    {
        "title": "押兵甲發谷口寄諸公",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "曉澗青青桂色孤，楚人隨玉上天衢。",
            "水辭谷口山寒少，今日风頭校暖无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 82
    },
    {
        "title": "和令狐侍禦賞蕙草",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "尋常诗思巧如春，又喜幽亭蕙草新。",
            "本是馨香比君子，繞欄今更為何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 83
    },
    {
        "title": "偶題",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "道在人間或可傳，小還輕變已多年。",
            "今來海上升高望，不到蓬萊不是仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 84
    },
    {
        "title": "三川驛伏覽座主舍人留題",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "舊跡依然已十秋，雪山當面照銀鉤。",
            "懷恩淚盡霜天曉，一片餘霞映驛樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 85
    },
    {
        "title": "陝州醉贈裴四同年",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "淒风洛下同羈思，迟日棠阴得醉歌。",
            "自笑与君三歲別，頭銜依舊鬢絲多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 86
    },
    {
        "title": "破鏡",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "佳人失手鏡初分，何日團圓再會君。",
            "今朝万里秋风起，山北山南一片雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 87
    },
    {
        "title": "長安雪后",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "秦陵漢苑參差雪，北闕南山次第春。",
            "車馬滿城原上去，豈知惆悵有闲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 88
    },
    {
        "title": "華清宮",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "零葉翻紅万樹霜，玉蓮開蕊暖泉香。",
            "行雲不下朝元閣，一曲淋鈴淚数行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 89
    },
    {
        "title": "冬日題智門寺北樓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "滿懷多少是恩酬，未見功名已白頭。",
            "不為尋山試筋力，豈能寒上背雲樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 90
    },
    {
        "title": "別王十后遣京使累路附书",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "重關曉度宿雲寒，羸馬緣知步步難。",
            "此信的應中路見，乱山何处拆书看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 91
    },
    {
        "title": "许秀才至辱李蘄州絕句，问斷酒之情因寄",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "有客南來話所思，故人遙枉醉中诗。",
            "暫因微疾須防酒，不是歡情減舊时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 92
    },
    {
        "title": "送张判官归兼謁鄂州大夫",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "处士闻名早，游秦獻疏回。腹中书万卷，身外酒千杯。",
            "江雨春波闊，園林客夢催。今君拜旌戟，凜凜近霜台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 93
    },
    {
        "title": "宿長慶寺",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "南行步步遠浮塵，更近青山昨夜鄰。高鐸数聲秋撼玉，",
            "終日官閑无一事，不妨長醉是遊人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 94
    },
    {
        "title": "望少華三首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "身隨白日看将老，心与青雲自有期。",
            "今对晴峰无十裏，世緣多累暗生悲。",
            "文字波中去不還，物情初与是非閑。",
            "时名竟是无端事，羞对靈山道愛山。",
            "眼看雲鶴不相隨，何況塵中事作為。",
            "好伴羽人深洞去，月前秋聽玉參差。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 95
    },
    {
        "title": "登澧州驛樓寄京兆韋尹",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "一話涔阳舊使君，郡人回首望青雲。",
            "政聲長与江聲在，自到津樓日夜闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 96
    },
    {
        "title": "長安晴望",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "翠屏山对鳳城開，碧落搖光霽后來。",
            "回识六龍巡幸处，飛煙閑繞望春台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 97
    },
    {
        "title": "歲旦朝回口號",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "星河犹在整朝衣，遠望天門再拜归。",
            "笑向春风初五十，敢言知命且知非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 98
    },
    {
        "title": "驌驦駿",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "瑤池罷遊宴，良樂委塵沙。遭遇不遭遇，鹽車与鼓車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 99
    },
    {
        "title": "龍丘途中二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "漢苑残花別，吳江盛夏來。唯看万樹合，不見一枝開。",
            "水色饒湘浦，灘聲怯建溪。淚流回月上，可得更猿啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 100
    },
    {
        "title": "宮人塚",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "儘是離宮院中女，苑牆城外塚累累。",
            "少年入內教歌舞，不识君王到老时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 101
    },
    {
        "title": "寄浙西李判官",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "燕臺上客意何如，四五年來漸漸疏。直道莫拋男子业，",
            "唯念賢哉崔大讓，可怜无事不歌魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 102
    },
    {
        "title": "寄杜子二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "不识長楊事北胡，且教紅袖醉來扶。",
            "狂风烈焰雖千尺，豁得平生俊气无。",
            "武牢關吏應相笑，個裏年年往復來。",
            "若问使君何处去，為言相憶首長回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 103
    },
    {
        "title": "盧秀才将出王屋，高步名場，江南相逢贈別",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "王屋山人有古文，欲攀青桂弄氛氳。将攜健筆幹明主，",
            "交遊話我凭君道，除卻鱸魚更不闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 104
    },
    {
        "title": "送劉三複郎中赴闕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "橫溪辭寂寞，金馬去追遊。好是鴛鴦侶，正逢霄漢秋。",
            "玉珂聲瑣瑣，錦帳夢悠悠。微笑知今是，因风謝釣舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 105
    },
    {
        "title": "羊欄浦夜陪宴會",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "戈檻營中夜未央，雨沾雲惹侍襄王。球來香袖依稀暖，",
            "自比諸生最无取，不知何处亦升堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 106
    },
    {
        "title": "送杜顗赴潤州幕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "少年才俊赴知音，丞相門欄不觉深。直道事人男子业，",
            "若去上元懷古去，謝安墳下与沉吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 107
    },
    {
        "title": "有感",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "宛溪垂柳最長枝，曾被春风盡日吹。",
            "不堪攀折犹堪看，陌上少年來自迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 108
    },
    {
        "title": "书懷寄盧州",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "謝山南畔州，风物最宜秋。太守懸金印，佳人敞画樓。",
            "凝缸暗醉夕，残月上汀州。可惜當年鬢，朱門不得遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 109
    },
    {
        "title": "賀崔大夫崔正字",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "內舉无慚古所難，燕台遙想拂塵冠。登龍有路水不峻，",
            "謝公樓下潺湲響，離恨诗情添幾般。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 110
    },
    {
        "title": "江南送左師",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "江南為客正悲秋，更送吾師古渡頭。",
            "惆悵不同塵土別，水雲蹤跡去悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 111
    },
    {
        "title": "寢夜",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "蛩唱如波咽，更深似水寒。露華驚弊褐，燈影掛塵冠。",
            "故國初離夢，前溪更下灘。紛紛毫发事，多少宦遊難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 112
    },
    {
        "title": "十九兄郡樓有宴，病不赴",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "十二層樓敞画簷，連去歌盡草纖纖。",
            "空堂病怯階前月，燕子嗔垂一竹簾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 113
    },
    {
        "title": "愁",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "聚散竟无形，回腸自結成。古今留不得，離別又潛生。",
            "降虜将军思，窮秋遠客情。何人更憔悴，落第泣秦京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 114
    },
    {
        "title": "隋苑",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "紅霞一抹廣陵春，定子當筵睡臉新。",
            "卻笑吃虧隋煬帝，破家亡國為谁人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 115
    },
    {
        "title": "芭蕉",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "芭蕉為雨移，故向窗前種。怜渠點滴聲，留得归鄉夢。",
            "夢遠莫归鄉，觉來一翻動。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 116
    },
    {
        "title": "汴人舟行答张祜",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "千万長河共使船，聽君诗句倍愴然。",
            "春风野岸名花發，一道帆檣画柳煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 117
    },
    {
        "title": "牧陪昭應盧郎中在江西宣州佐今吏部沈公幕罷府周歲公宰昭應牧在淮南縻職敘舊成二十二韵用以投寄",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "燕雁下揚州，涼风柳陌愁。可怜千里夢，還是一年秋。",
            "宛水環朱檻，章江敞碧流。謬陪吾益友，只事我賢侯。",
            "印組縈光馬，鋒鋩看解牛。井閭安樂易，冠蓋愜依投。",
            "政簡稀開閣，功成每运籌。送春經野塢，迟日上高樓。",
            "玉裂歌聲斷，霞飄舞帶收。泥情斜拂印，別臉小低頭。",
            "日晚花枝爛，釭凝粉彩稠。未曾孤酩酊，剩肯只淹留。",
            "重德俄征寵，諸生苦宦遊。分途之絕國，灑淚拜行輈。",
            "聚散真漂梗，光阴极轉郵。銘心徒歷歷，屈指盡悠悠。",
            "君作烹鮮用，谁膺仄席求。卷懷能憤悱，卒歲且優遊。",
            "去矣时難遇，沽哉價莫酬。滿枝為鼓吹，衷甲避戈矛。",
            "隋帝宮荒草，秦王土一丘。相逢好大笑，除此總雲浮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十四",
        "no#": 118
    }
]