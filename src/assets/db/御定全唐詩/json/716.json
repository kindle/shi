[
    {
        "title": "長安春日",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "浩浩看花晨，六街揚遠塵。塵中一丈日，谁是晏眠人。",
            "禦柳舞著水，野鶯啼破春。徒雲多失意，犹自惜離秦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 1
    },
    {
        "title": "慈恩寺貽楚霄上人",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "在秦生楚思，波浪接禪關。塔礙高林鳥，窗開白日山。",
            "樹阴移草上，岸色透庭間。入內談經徹，空攜講疏還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 2
    },
    {
        "title": "崇義裏言懷",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "馬蹄京洛岐，複此少闲时。老積滄洲夢，秋乖白閣期。",
            "平生五字句，一夕滿頭絲。把向侯門去，侯門未可知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 3
    },
    {
        "title": "僧院松",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "此木韵彌全，秋霄學瑟弦。空知百餘尺，未定幾多年。",
            "古甲磨雲拆，孤根捉地堅。何當拋一干，作蓋道場前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 4
    },
    {
        "title": "貽世",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "富者非義取，樸风爭肯還。紅塵不待曉，白首有谁閑。",
            "淺度四溟水，平看諸國山。只消年作劫，俱到總无間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 5
    },
    {
        "title": "南游",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "直到南箕下，方諳漲海頭。君恩過銅柱，戎節限交州。",
            "犀占花阴臥，波沖瘴色流。遠夷非不樂，自是北人愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 6
    },
    {
        "title": "送胡中丞使日東",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "辭天理玉簪，指日使雞林。犹有中華戀，方同積浪深。",
            "张帆度鯨口，銜命見臣心。渥澤遐宣後，归期抵万金。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 7
    },
    {
        "title": "哭陳陶處士",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "園裏先生塚，鳥啼春更傷。空餘八封樹，尚對一茅堂。",
            "白日埋杜甫，皇天无耒阳。如何稽古力，報答甚茫茫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 8
    },
    {
        "title": "言懷",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "冥心坐似癡，寢食亦如遺。為覓出人句，只求當路知。",
            "豈能窮到老，未信達无时。此道須天付，三光幸不私。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 9
    },
    {
        "title": "月",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "寥寥天地內，夜魄爽何輕。频見此輪滿，即應華發生。",
            "不圓爭得破，才正又須傾。人事還如此，因知倚伏情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 10
    },
    {
        "title": "答匡山僧贈榔栗杖",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "栗杖出匡頂，百中无一枝。雖因野僧得，犹畏嶽神知。",
            "画月冷光在，指雲秋片移。宜留引蹇步，他日訪峨嵋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 11
    },
    {
        "title": "商山夜闻泉",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "瀉月聲不斷，坐來心益閑。无人知落處，万木冷空山。",
            "遠憶雲容外，幽疑石縫間。那辭通曙聽，明日度藍關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 12
    },
    {
        "title": "书懷",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "默默守吾道，望榮來替愁。吟诗應有罪，當路卻如讎。",
            "陸海儻難溺，九霄爭便休。敢言名譽出，天未白吾頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 13
    },
    {
        "title": "道中",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "出門嗟世路，何日樸风归。是處太行險，□□應解飛。",
            "主人厚薄禮，客子新故衣。所以澆浮態，多令行者違。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 14
    },
    {
        "title": "夏雲",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "勢能成嶽仞，頃刻長崔嵬。暝鳥飛不到，野风吹得開。",
            "一天分万態，立地看忘回。欲結暑宵雨，先闻江上雷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 15
    },
    {
        "title": "塞上行",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "上将擁黃須，安西逐指呼。離鄉俱少壯，到磧減肌膚。",
            "风雪夜防塞，腥膻朝系胡。為君樂戰死，谁喜作征夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 16
    },
    {
        "title": "晨起",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "曉色教不睡，捲簾清氣中。林残數枝月，發冷一梳风。",
            "並鳥含鐘语，欹荷隔霧空。莫疑營白日，道路本无窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 17
    },
    {
        "title": "感世",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "觸目盡如幻，幻中能幾时。愁來舍行樂，事去莫吞悲。",
            "白发不由己，黃金留待谁。耕煙得銘志，翻為古人思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 18
    },
    {
        "title": "觀華夷圖",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "落筆勝縮地，展圖當晏寧。中華屬貴分，遠裔占何星。",
            "分寸辨諸嶽，鬥升觀四溟。長疑未到處，一一似曾經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 19
    },
    {
        "title": "山中寒夜呈進士许棠",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "山寒草堂暖，寂夜有良朋。讀易分高燭，煎茶取折冰。",
            "庭垂河半形，窗露月微棱。俱入論心地，爭无俗者憎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 20
    },
    {
        "title": "滕王閣春日晚眺",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "淩春帝子閣，偶眺日移西。浪勢平花塢，帆阴上柳堤。",
            "凝嵐藏宿翼，疊鼓碎归蹄。只此長吟詠，因高思不迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 21
    },
    {
        "title": "鐘陵野步",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "岡扉聊自啟，信步出波邊。野火风吹闊，春冰鶴啄穿。",
            "渚檣齊驛樹，山鳥入公田。未創孤雲勢，空思白閣年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 22
    },
    {
        "title": "哭胡處士",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "故人江閣在，重到事悠悠。无爾向潭上，為吾傾甕頭。",
            "空餘赤楓葉，墮落釣魚舟。疑是沖虛去，不為天地囚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 23
    },
    {
        "title": "青龍寺贈雲顥法師",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "紫檀衣且香，春殿日尤長。此地開新講，何山鎖舊房。",
            "僧名喧北闕，師印续南方。莫惜青蓮喻，秦人聽未忘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 24
    },
    {
        "title": "薦福寺贈應制白公",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "才子紫檀衣，明君寵顧时。講升高座懶，书答重臣迟。",
            "瓶勢傾圓頂，刀聲落碎髭。還闻穿內去，隨駕進新诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 25
    },
    {
        "title": "觀山寺僧穿井",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "雲僧鑿山井，寒碧在中庭。況是分岩眼，同來下石瓶。",
            "旁痕終變蘚，圓影即澄星。異夜天龍蟄，應闻说葉經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 26
    },
    {
        "title": "送德光禪師",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "天涯緣事了，又造石霜微。不以千峰險，唯将独影归。",
            "有為嫌假佛，无境是真机。到後流沙錫，何时更有飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 27
    },
    {
        "title": "贈南陵李主簿",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "外邑官同隱，甯勞短吏趨。看雲情自足，愛酒逸應无。",
            "簟席彈棋子，衣裳惹印朱。仍闻陂水近，亦擬掉菰蒲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 28
    },
    {
        "title": "慈恩寺東樓",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "寺樓涼出竹，非与曲江賒。野火流穿苑，秦山疊入巴。",
            "风梢離眾葉，岸角積虛沙。此地鐘聲近，令人思未涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 29
    },
    {
        "title": "古塚",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "代遠已難问，累累次古城。民田侵不盡，客路踏還平。",
            "作穴蛇分蟄，依岡鹿繞行。唯應风雨夕，鬼火出林明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 30
    },
    {
        "title": "訪山友",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "一徑通高屋，重雲翳两原。山寒初宿頂，泉落未知根。",
            "急雨洗荒壁，驚风開靜門。聽君吟廢夜，苦卻建溪猿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 31
    },
    {
        "title": "林下书懷寄建州李频員外",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "一從諸事懶，海上跡宜沉。吾道不當路，鄙人甘入林。",
            "雲垂方覓鶴，月濕始收琴。水石南州好，谁陪刻骨吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 32
    },
    {
        "title": "猿",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "曾宿三巴路，今來不愿聽。雲根啼片白，峰頂擲尖青。",
            "護果憎禽啄，棲霜覷葉零。唯應臥嵐客，怜爾傍岩扃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 33
    },
    {
        "title": "秋日送方幹遊上元",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "天高淮泗白，料子趨修程。汲水疑山動，揚帆覺岸行。",
            "雲離京口樹，雁入石頭城。後夜分遙念，諸峰霜露生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 34
    },
    {
        "title": "哭李频員外",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "出麾臨建水，下世在公堂。苦集休開篋，清資罷轉郎。",
            "瘴中无子奠，嶺外一妻孀。定是浮香骨，東归就故鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 35
    },
    {
        "title": "山中言事",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "嵐靄潤窗櫺，吟诗得冷症。教餐有效药，多愧独行僧。",
            "雲濕煎茶火，冰封汲井繩。片扉深著掩，經國自无能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 36
    },
    {
        "title": "送左協律京西從事",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "辟书來幾日，遂喜就嘉招。犹向风沙淺，非於甸服遙。",
            "时平无探騎，秋靜見盤雕。若遣關中使，煩君问寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 37
    },
    {
        "title": "望九華寄池阳太守",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "造華峰峰異，宜教嶽德謙。靈蹤载籍古，怪刃刺雲尖。",
            "盤蹙陵阳壯，孤標建鄴瞻。霽餘堪洗目，青出謝家簷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 38
    },
    {
        "title": "上廣州支使王拾遺",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "明时應不諫，天幕稱仙才。聘入關中去，人從帝側來。",
            "诗窗盛島嶼，檄盾照风雷。幾度陪旄節，營巡海色回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 39
    },
    {
        "title": "題僧松禪",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "空山澗畔枯松樹，禪老堂頭甲乙身。",
            "傳是昔朝僧種著，下頭應有茯苓神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 40
    },
    {
        "title": "贈華阴李明府",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "佩墨縣兼清，約關西近城。三峰豈不重，厚地戴犹輕。",
            "雪筱欹難直，风泉噴易橫。須知高枕外，長是勸民耕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 41
    },
    {
        "title": "送人庭鶴",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "度歲休籠閉，身輕好羽仪。白雲□是伴，滄海得因谁。",
            "唳起遺残食，盤餘在迥枝。條风频雨去，只恐更相隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 42
    },
    {
        "title": "信州闻通寺題僧砌下泉",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "細聲從嶠足，幽淡浸香墀。此境未開日，何人初見时。",
            "耗痕延黑蘚，淨罅吐微澌。應有喬梢鶴，下來當飲之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 43
    },
    {
        "title": "山中",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "此地似商嶺，雲霞空往還。衰條難定鳥，缺月易依山。",
            "野色耕不盡，溪容釣自閑。分因多臥退，百计少相關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 44
    },
    {
        "title": "寄崇聖寺僧",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "不醉長安酒，冥心只似師。望山吟過日，伴鶴立多时。",
            "溝遠流聲細，林寒綠色迟。庵西蘿月夕，重約语空期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 45
    },
    {
        "title": "金陵道中寄",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "忍苦待知音，无时省廢吟。始為分路客，莫问向隅心。",
            "嶠翠藏幽瀑，枝风下曉禽。憶君秋欲盡，馬上秣陵砧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 46
    },
    {
        "title": "都門送许棠東归",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "舊客東归遠，長安诗少朋。去愁分磧雁，行计逐鄉僧。",
            "華岳无时雪，黃河漫處冰。知辭國門路，片席認西陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 47
    },
    {
        "title": "送進士喻坦之游太原",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "北鄙征難盡，诗愁滿去程。廢巢侵燒色，荒塚入鋤聲。",
            "逗野河流濁，離雲磧日明。並州戎壘地，角動引风生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 48
    },
    {
        "title": "九江暮春书事",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "楊柳城初鎖，輪蹄息去蹤。春流无舊岸，夜色失諸峰。",
            "影動漁邊火，聲迟話後鐘。明朝回去雁，谁向北郊逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 49
    },
    {
        "title": "再到洪州望西山",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "洪州向西顧，不忍暫忘君。記得瀑泉落，省同幽鳥闻。",
            "一回經雨雹，長有剩风雲。未定卻棲息，前頭江海分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 50
    },
    {
        "title": "与胡汾坐月期貫休上人不至",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "掃庭秋漏滴，接話貴忘眠。靜夜人相语，低枝鳥暗遷。",
            "星圍南極定，月照斷河連。後會花宮子，應開石上禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 51
    },
    {
        "title": "贈胡處士",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "年光離嶽色，帶疾臥南原。白日与无事，俗人嗔閉門。",
            "樵魚臨片水，野鹿入荒園。莫问榮華事，清霜點發根。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 52
    },
    {
        "title": "鉛山写懷",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "天涯兵火後，风景畏臨門。骨肉到时節，團圓因夢魂。",
            "池塘營水眼，嶺嶠結花根。耳縱聽歌吹，中心不可論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 53
    },
    {
        "title": "书翠岩寺壁",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "何年話尊宿，瞻禮此堂中。入郭非无路，归林自學空。",
            "濺瓶雲嶠水，逆磬雪川风。时说南廬事，知師用意同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 54
    },
    {
        "title": "江西題東湖",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "鑿出江湖思，涼多□□間。无风觸微浪，半日□秋山。",
            "客袖沙光滿，船窗荻影閑。时人見黃綬，應笑狎鸥還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 55
    },
    {
        "title": "題湖南嶽麓寺",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "海雲山上寺，每到每開襟。万木長不住，細泉聽更深。",
            "蜩沾高雨斷，鳥遇夕嵐沈。此地良宵月，秋懷隔楚砧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 56
    },
    {
        "title": "贈衡山麋明府",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "為縣瀟湘水，門前樹配苔。晚吟公籍少，春醉積林開。",
            "滌硯松香起，擎茶嶽影來。任官當此境，更莫夢天臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 57
    },
    {
        "title": "塞上",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "邊寒來所闊，今日複明朝。河淩堅通馬，胡雲缺見雕。",
            "砂中程独泣，鄉外隱谁招。回首若經歲，靈州生柳條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 58
    },
    {
        "title": "送邵安石及第归連州覲省",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "及第兼归覲，宜忘涉驛勞。青雲重慶少，白日一飛高。",
            "轉楚闻啼狖，臨湘見疊濤。海阳沈飲罷，何地佐旌旄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 59
    },
    {
        "title": "邊上送友人归甯",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "鄉路穿京過，寧心去少同。日斜尋闊磧，春盡逐归鴻。",
            "独樹河聲外，凝笳塞色中。怜君到此處，卻背老萊风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 60
    },
    {
        "title": "除夜",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "残臘即又盡，東风應漸闻。一宵犹幾许，两歲欲平分。",
            "燎暗傾时鬥，春通綻處芬。明朝遙捧酒，先合祝堯君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 61
    },
    {
        "title": "題甘露寺",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "香門接巨壘，画角間清鐘。北固一何峭，西僧多此逢。",
            "天垂无際海，雲白久晴峰。旦暮然燈外，濤頭振蟄龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 62
    },
    {
        "title": "貽住山僧",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "罷講巡岩塢，无窮得野情。臘高犹伴鹿，夏滿不归城。",
            "雲朵緣崖發，峰阴截水清。自然雙洗耳，唯任白毫生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 63
    },
    {
        "title": "題鶴鳴泉",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "仙鶴曾鳴處，泉兼半井苔。直峰拋影入，片月瀉光來。",
            "瀲灩侵顏冷，深沉慰眼開。何因值舟頂，滿汲石瓶回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 64
    },
    {
        "title": "吊賈島二首",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "先生不折桂，謫去抱何冤。已葬離燕骨，難招入劍魂。",
            "旅墳低卻草，稚子哭勝猿。冥寞如搜句，宜邀賀監論。",
            "青旆低寒水，清笳出曉风。鳥為傷賈傅，馬立葬滕公。",
            "松柏青山上，城池白日中。一朝今古隔，惟有月明同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 65
    },
    {
        "title": "憶江西並悼亡友",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "前心奈兵阻，悔作豫章分。芳草未归日，故人多是墳。",
            "帆行出岫雨，馬踐過江雲。此地一樽酒，當时皆以文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十六",
        "no#": 66
    }
]