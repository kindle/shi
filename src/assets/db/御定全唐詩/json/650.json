[
    {
        "title": "元日",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "晨雞两遍報更闌，刁鬥无聲曉漏幹。暖日映山調正气，",
            "才酌屠蘇定年齒，坐中惟笑鬢毛斑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 1
    },
    {
        "title": "別從兄郜",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "展翅開帆只待风，吹噓成事古今同。已呼斷雁归行裏，",
            "臨岐再拜无餘事，愿取文章達圣聰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 2
    },
    {
        "title": "寄江陵王少府",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "分手频曾變寒暑，迢迢遠意各何如。波濤一阻两鄉夢，",
            "此來俗輩皆疏我，唯有故人心不疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 3
    },
    {
        "title": "題睦州烏龍山禪居",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "曙后月華犹冷濕，自知坐臥逼天宮。晨雞未暇鳴山底，",
            "伴師長住應難住，归去仍須入俗籠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 4
    },
    {
        "title": "寄杭州于郎中",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "雖雲圣代识賢明，自是山河應数生。大雅篇章无弟子，",
            "白屋青雲至懸闊，愚儒肝膽若為傾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 5
    },
    {
        "title": "寄靈武胡常侍",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "青雲直上路初通，已在明君倚注中。欲遣為霖安九有，",
            "最是何人感恩德，謝敷星下釣漁翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 6
    },
    {
        "title": "上张舍人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "海內芳聲谁可並，承家三代相門深。剖符已副東人望，",
            "他年莫學鴟夷子，遠泛扁舟用鑄金。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 7
    },
    {
        "title": "題慈溪张丞壁",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "因君貳邑藍溪上，遣我維舟紅葉时。共向鄉中非半面，",
            "貌似故人心尚喜，相逢況是舊相知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 8
    },
    {
        "title": "贈鄰居袁明府",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "隔竹每呼皆得應，二心親熟更如何。文章鍛煉犹相似，",
            "朝昏幸得同醒醉，遮莫光阴自下坡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 9
    },
    {
        "title": "孫氏林亭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "池亭才有二三畝，风景勝於千万家。瑟瑟林排全巷竹，",
            "丱角相知成白首，而今歡笑莫咨嗟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 10
    },
    {
        "title": "漳州阳亭言事寄於使君",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "謝守登城对遠峰，金英泛泛滿金鐘。樓頭风景八九月，",
            "鯉魚縱是凡鱗鬣，得在膺門合作龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 11
    },
    {
        "title": "別胡中丞",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "二年朝夜見雙旌，心魄知恩夢亦驚。幽賤粗能分菽麥，",
            "卻恨此身唯一死，空将一死報犹輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 12
    },
    {
        "title": "游张公洞寄陶校书",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "步步勢穿江底去，此中危滑轉身難。下蒸阴气松蘿濕，",
            "由來委曲尋仙路，不似先生换骨丹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 13
    },
    {
        "title": "題睦州郡中千峰榭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "豈知平地似天臺，朱戶深沈別徑開。曳響露蟬穿樹去，",
            "何事此中如世外，應緣羊祜是仙才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 14
    },
    {
        "title": "登新城縣樓贈蔡明府",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "楊震東來是宦游，政成登此自消憂。草中白道穿村去，",
            "不知縣籍添新戶，但見川原桑柘稠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 15
    },
    {
        "title": "和於中丞登扶风亭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "避石攀蘿去不迷，行时舉步似丹梯。東軒海日已先照，",
            "謝公吟望多來此，此地應将峴首齊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 16
    },
    {
        "title": "贈信州高員外",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "溪勢盤回繞郡流，饒阳春色滿溪樓。豈唯啼鳥催人醉，",
            "膺門若感深恩去，終殺微軀未足酬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 17
    },
    {
        "title": "漳州于使君罷郡如之任漳南去上國二十四州使君无非親故",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "漳南罷郡如之任，二十四州相次迎。泊岸旗幡郵吏拜，",
            "圣主此时思共理，又應何处救蒼生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 18
    },
    {
        "title": "送弟子伍秀才赴舉",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "天遣相門延積慶，今同太廟薦嘉賓。柳條此日同谁折，",
            "由來不要文章得，要且文章出眾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 19
    },
    {
        "title": "貽高讜",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "都緣相府有宗兄，卻恐妨君正路行。石上長松自森秀，",
            "幸有清才与洪筆，何愁高節不公卿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 20
    },
    {
        "title": "題長洲陳明府小亭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "坐看孤峭卻勞神，還是微吟到日曛。松鶴認名呼得下，",
            "便此消遙應不易，朱衣紅旆未容君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 21
    },
    {
        "title": "送朱二十赴漣水",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "到縣卻應嫌水闊，離家終是見山疏。笙歌不駐難辭酒，",
            "鸞凰取便多如此，掠地斜飛上太虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 22
    },
    {
        "title": "德政上睦州胡中丞",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "上德由來合動天，旌旗到日是豐年。群书已熟无人似，",
            "豈唯裏巷皆蘇息，犹有恩波及釣船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 23
    },
    {
        "title": "袁明府以家醞寄余余以山梅答贈非唯四韵兼亦雙關",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "封匏寄酒提攜遠，織籠盛梅答贈迟。九度攪和谁用法，",
            "畢卓醉狂潘氏少，傾來擲去恰相宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 24
    },
    {
        "title": "上杭州姚郎中",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "能除疾瘼似良醫，一郡鄉风當日移。身貴久離行药伴，",
            "借问公方与文道，而今中夏更傳谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 25
    },
    {
        "title": "送葉秀才赴舉兼呈呂少監",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "君辭舊裏一年期，藝至心身亦自知。尊盡離人看北斗，",
            "与爾相逢終不遠，昨闻秘監在台墀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 26
    },
    {
        "title": "自縉雲赴郡溪流百里輕棹一發曾不崇朝敘事四韵寄獻段郎中",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "激箭溪湍勢莫凭，飄然一葉若為乘。仰瞻青壁開天罅，",
            "此中明日尋知己，恐似龍門不易登。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 27
    },
    {
        "title": "胡中丞早梅",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "不独閑花不共时，一株寒豔尚參差。淩晨未噴含霜朵，",
            "謝公吟賞愁飄落，可得更拈長笛吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 28
    },
    {
        "title": "牡丹",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "借问庭芳早晚栽，座中疑展画屏開。花分淺淺胭脂臉，",
            "殷勤為報看花客，莫學遊蜂日日來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 29
    },
    {
        "title": "觀項信水墨",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "險峭雖從筆下成，精能皆自意中生。倚雲孤檜知无朽，",
            "小年師祖過今祖，異域應傳項信名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 30
    },
    {
        "title": "书桃花塢周处士壁",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "醉吟雪月思深苦，思苦神勞華發生。自學古賢修靜節，",
            "何事懶于嵇叔夜，更无书劄答公卿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 31
    },
    {
        "title": "題桐廬謝逸人江居",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "少小高眠无一事，五侯勳盛欲如何。湖邊倚杖寒吟苦，",
            "由來朝市為真隱，可要棲身向薜蘿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 32
    },
    {
        "title": "敘雪寄喻鳧",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "密片无聲急複迟，紛紛犹勝落花时。從容不觉藏苔徑，",
            "高人坐臥才方逸，援筆應成六出詞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 33
    },
    {
        "title": "敘雪寄喻鳧",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "密片繁聲旋不銷，縈风雜霰轉飄颻。澄江莫蔽長流色，",
            "此时明徑无行跡，唯望徽之问寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 34
    },
    {
        "title": "哭秘书姚少監",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "寒空此夜落文星，星落文留万古名。入室幾人成弟子，",
            "曉向平原陳葬禮，悲风吹雨濕銘旌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 35
    },
    {
        "title": "送人宰永泰",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "北人雖泛南流水，稱意南行莫恨賒。道路先經毛竹嶺，",
            "下馬政聲王事少，應容閑吏日高衙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 36
    },
    {
        "title": "旅次洋州寓居郝氏林亭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "舉目縱然非我有，思量似在故山时。鶴盤遠勢投孤嶼，",
            "青雲未得平行去，夢到江南身旅羈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 37
    },
    {
        "title": "茅山贈洪拾遺",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "圣代諫臣停諫舌，求归故里傲雲霞。溪頭講樹纜漁艇，",
            "我來幸与諸生異，问答时容近絳紗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 38
    },
    {
        "title": "睦州呂郎中郡中環溪亭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "為是仙才登望处，风光便似武陵春。閑花半落犹迷蝶，",
            "暫來此地非多日，明主那容借寇恂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 39
    },
    {
        "title": "贈華阴隱者",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "少微夜夜當仙掌，更有何人在此居。花月舊應看浴鶴，",
            "故國多年归未遂，因逢此地憶吾廬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 40
    },
    {
        "title": "上杭州杜中丞",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "昔用雄才登上第，今将重德合明君。苦心多為安民術，",
            "掠天逸勢應非久，一鶚那棲眾鳥群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 41
    },
    {
        "title": "贈处州段郎中",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "幸見仙才領郡初，郡城孤峭似仙居。杉蘿色裏遊亭榭，",
            "寒潭是处清連底，賓席何心望食魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 42
    },
    {
        "title": "书法華寺上方禪壁",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "砌下松巔有鶴棲，孤猿亦在鶴邊啼。臥闻雷雨归岩早，",
            "是非生死多憂惱，此日蒙師為破迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 43
    },
    {
        "title": "书吳道隱林亭",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "蘚榭莎亭蘿筱阴，依稀气象似山林。橘枝亞路黃苞重，",
            "四鄰不見孤高处，翻笑騰騰只醉吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 44
    },
    {
        "title": "陪王大夫泛湖",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "去去淩晨回見星，木蘭舟穩画橈輕。白波潭上魚龍气，",
            "此时檢點諸名士，卻是漁翁无姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 45
    },
    {
        "title": "贈會稽张少府",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "高節何曾似任官，药苗香潔備常餐。一分酒戶添犹得，",
            "明年莫便還家去，鏡裏雲山且共看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 46
    },
    {
        "title": "送鄭台处士归絳岩",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "榮啟先生挾琴去，厭尋靈勝憶岩棲。白猿垂樹窗邊月，",
            "古賢犹愴河梁別，未可匆匆便解攜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 47
    },
    {
        "title": "因話天臺勝異仍送羅道士",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "積翠千層一徑開，遙盤山腹到瓊台。藕花飄落前岩去，",
            "縱雲孤鶴无留滯，定恐煙蘿不放回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 48
    },
    {
        "title": "哭喻鳧先輩",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "日夜役神多損壽，先生下世未中年。撰碑縱托登龍伴，",
            "人間別更无冤事，到此谁能与问天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 49
    },
    {
        "title": "湖北有茅齋湖西有松島輕棹往返頗諧素心因成四韵",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "湖北湖西往復還，朝昏只处自由間。暑天移榻就深竹，",
            "古賢暮齒方如此，多笑愚儒鬢未斑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 50
    },
    {
        "title": "鑒湖西島言事",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "慵拙幸便荒僻地，縱聽猿鳥亦何愁。偶斟药酒欺梅雨，",
            "世人若便无知己，應向此溪成白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 51
    },
    {
        "title": "山中言事",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "欹枕亦吟行亦醉，臥吟行醉更何營。貧來犹有故琴在，",
            "潛夫自有孤雲侶，可要王侯知姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 52
    },
    {
        "title": "贈蕭山彭少府",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "作尉孜孜更寒苦，操心至癖不為清。雖将劍鶴支残債，",
            "与君相识因儒術，歲月彌多別有情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 53
    },
    {
        "title": "贈式上人",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "縱居鼙角喧闐处，亦共雲溪邃僻同。万慮全離方寸內，",
            "莫笑旅人終日醉，吾将大醉与禪通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 54
    },
    {
        "title": "贈錢塘湖上唐处士",
        "author": "方幹",
        "biography": "",
        "paragraphs": [
            "我愛君家似洞庭，沖灣潑岸夜波聲。蟾蜍影裏清吟苦，",
            "莫言舉世无知己，自有孤雲识此情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十",
        "no#": 55
    }
]