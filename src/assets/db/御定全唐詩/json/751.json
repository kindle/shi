[
    {
        "title": "早春左省寓直",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "旭景鸞臺上，微雲象闕間。时清政事少，日永直官閑。",
            "遠籟飛簫管，零冰響佩環。終军年二十，默坐叩玄關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 1
    },
    {
        "title": "寒食宿陳公塘上",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "垂楊界官道，茅屋倚高坡。月下春塘水，风中牧豎歌。",
            "折花閑立久，對酒遠情多。今夜孤亭夢，悠揚奈爾何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 2
    },
    {
        "title": "将去廣陵別史員外南齋",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "家聲曾与金张輩，官署今居何宋間。起得高齋臨靜曲，",
            "賤子今朝独南去，不堪回首望清闲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 3
    },
    {
        "title": "将過江題白沙館",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "少長在維揚，依然認故鄉。金陵佳麗地，不道少风光。",
            "稍望吳台遠，行登楚塞長。殷勤语江嶺，归夢莫相妨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 4
    },
    {
        "title": "登甘露寺北望",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "京口潮來曲岸平，海門风起浪花生。人行沙上見日影，",
            "遊人鄉思應如橘，相望須含两地情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 5
    },
    {
        "title": "山路花",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "不共垂楊映綺寮，倚山臨路自嬌饒。遊人過去知香遠，",
            "城中春色還如此，幾處笙歌按舞腰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 6
    },
    {
        "title": "京口江際弄水",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "退公求靜独臨川，揚子江南二月天。百尺翠屏甘露閣，",
            "安得乘槎更東去，十洲风外弄潺湲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 7
    },
    {
        "title": "早春旬假独直寄江舍人",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "省署皆归沐，西垣公事稀。詠诗前砌立，聽漏向申归。",
            "遠思风醒酒，餘寒雨濕衣。春光已堪探，芝蓋共谁飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 8
    },
    {
        "title": "從駕東幸呈諸公",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "吳公台下舊京城，曾掩衡門過十春。別後不知新景象，",
            "今日喜為華表鶴，況陪鵷鹭免迷津。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 9
    },
    {
        "title": "重遊木蘭亭",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "繚繞長堤帶碧潯，昔年游此尚青衿。蘭橈破浪城阴直，",
            "那知年長多情後，重凭欄幹一独吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 10
    },
    {
        "title": "賦得彩燕",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "縷彩成飛燕，迎和啟蟄时。翠翹生玉指，繡羽拂文楣。",
            "詎費銜泥力，无勞剪爪期。化工今在此，翻怪社來迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 11
    },
    {
        "title": "送魏舍人仲甫為蘄州判官",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "從事蘄春興自長，蘄人應识紫薇郎。山資足後拋名路，",
            "如闻郡閣吹橫笛，时望青溪憶野王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 12
    },
    {
        "title": "題殷舍人宅木芙蓉",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "怜君庭下木芙蓉，嫋嫋纖枝淡淡紅。曉吐芳心零宿露，",
            "默飲數杯應未稱，不知歌管与谁同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 13
    },
    {
        "title": "送史館高員外使嶺南",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "東觀时闲暇，還修喻蜀书。雙旌馳縣道，百越從軺車。",
            "桂蠹晨餐罷，貪泉訪古初。春江多好景，莫使醉吟疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 14
    },
    {
        "title": "春日紫岩山期客不至",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "郊外春華好，人家帶碧溪。淺莎藏鴨戲，輕靄隔雞啼。",
            "掩映紅桃谷，夤緣翠柳堤。王孫竟不至，芳草自萋萋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 15
    },
    {
        "title": "宿蔣帝廟，明日游山南諸寺",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "便返城闉尚未甘，更從山北到山南。花枝似雪春雖半，",
            "登臨莫怪偏留戀，遊宦多年事事諳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 16
    },
    {
        "title": "賦得有所思",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "所思何在杳難尋，路遠山長水複深。衰草滿庭空佇立，",
            "落日鮮雲偏聚散，可能知我独傷心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 17
    },
    {
        "title": "贈王貞素先生",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "先生嘗已佩真形，紺發朱顏骨氣清。道秘未傳鴻寶術，",
            "三十六天皆有籍，他年何處问归程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 18
    },
    {
        "title": "春夜月",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "幽人春望本多情，況是花繁月正明。",
            "竟夕无言亦无寐，繞階芳草影隨行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 19
    },
    {
        "title": "愛敬寺有老僧嘗游長安言秦雍間事歷歷可聽…示同行客",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "白首棲禪者，嘗談灞滻遊。能令過江客，偏起失鄉愁。",
            "室倚桃花崦，門臨杜若洲。城中无此景，将子剩淹留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 20
    },
    {
        "title": "游蔣山題辛夷花寄陳奉禮",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "今歲遊山已恨迟，山中仍喜見辛夷。簪纓且免全為累，",
            "山郎不作同行伴，折得何由寄所思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 21
    },
    {
        "title": "和殷舍人蕭員外春雪",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "万里春阴乍履端，廣庭风起玉塵幹。梅花嶺上連天白，",
            "此时鴛侶皆闲暇，贈答诗成禁漏残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 22
    },
    {
        "title": "寄蘄州高郎中",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "賈傅棲迟楚澤東，蘭皋三度换秋风。紛紛世事來无盡，",
            "知君多少思鄉恨，並在山城一笛中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 23
    },
    {
        "title": "寄和州韓舍人",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "急景駸駸度，遙懷處處生。风頭乍寒暖，天色半阴晴。",
            "久別魂空斷，終年道不行。殷勤雲上雁，為過曆阳城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 24
    },
    {
        "title": "從兄龍武将军沒于邊戍，過舊營宅作",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "前年都尉沒邊城，帳下何人領舊兵。徼外瘴煙沉鼓角，",
            "今日園林過寒食，馬蹄犹擬入門行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 25
    },
    {
        "title": "景阳臺懷古",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "後主忘家不悔，江南異代長春。",
            "今日景阳臺上，闲人何用傷神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 26
    },
    {
        "title": "春分日",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "仲春初四日，春色正中分。綠野徘徊月，晴天斷续雲。",
            "燕飛犹個個，花落已紛紛。思婦高樓晚，歌聲不可闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 27
    },
    {
        "title": "寄駕部郎中",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "賤子乖慵性，频為省直牽。交親每相見，多在相門前。",
            "君独疏名路，為郎過十年。炎风久成別，南望思悠然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 28
    },
    {
        "title": "和王庶子寄題兄長建州廉使新亭",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "謝守高齋結構新，一方风景万家情。群賢詎減山阴會，",
            "阿連诗句偏多思，遙想池塘晝夢成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 29
    },
    {
        "title": "謝文靖墓下作",
        "author": "徐鉉",
        "biography": "",
        "paragraphs": [
            "越徼稽天討，周京乱虜塵。蒼生何可奈，江表更无人。",
            "豈憚尋荒壟，犹思認後身。春风白楊裏，独步淚沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十一",
        "no#": 30
    }
]