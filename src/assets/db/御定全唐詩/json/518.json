[
    {
        "title": "明月照高樓",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "朗月何高高，樓中簾影寒。一婦独含歎，四坐谁成歡。",
            "时節屡已移，遊旅杳不還。滄溟倘未涸，妾淚終不幹。",
            "君若无定雲，妾若不動山。雲行出山易，山逐雲去難。",
            "愿為邊塞塵，因风委君顏。君顏良洗多，蕩妾濁水間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 1
    },
    {
        "title": "酬秘书王丞見寄",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "朝下有閑思，南溝邊水行。因來見寥落，轉自歎平生。",
            "白首丈夫氣，赤心知己情。留诗本相慰，卻憶苦吟聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 2
    },
    {
        "title": "僧金河戍客",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "慣獵金河路，曾逢雪不迷。射雕青塚北，走馬黑山西。",
            "戍遠旌幡少，年深帳幕低。酬恩須盡敵，休说夢中閨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 3
    },
    {
        "title": "孤桐",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "疏桐餘一干，风雨日蕭條。歲晚琴材老，天寒桂葉凋。",
            "已悲根半死，複恐尾全焦。幸在龍門下，知音肯寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 4
    },
    {
        "title": "秋露",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "白露曖秋色，月明清漏中。痕沾珠箔重，點落玉盤空。",
            "竹動时驚鳥，莎寒暗滴蟲。滿園生永夜，漸欲与霜同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 5
    },
    {
        "title": "送徐使君赴嶽州",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "渺渺楚江上，风旗搖去舟。馬归雲夢晚，猿叫洞庭秋。",
            "別思滿南渡，鄉心生北樓。巴陵山水郡，應稱謝公遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 6
    },
    {
        "title": "送裴璋還蜀因亦懷归",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "客在劍門外，新年音信稀。自為千里別，已送幾人归。",
            "陌上月初落，馬前花正飛。離言殊未盡，春雨滿行衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 7
    },
    {
        "title": "送前鄠縣李少府",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "近出圭峰下，還期又不賒。身閑多宿寺，官滿未移家。",
            "罷釣臨秋水，開尊對月華。自當蓬閣選，豈得臥煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 8
    },
    {
        "title": "送宜春裴明府之任",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "南行春已滿，路半水茫然。楚望花當渡，湘阴橘滿川。",
            "山橫湖色上，帆出鳥行前。此任无辭遠，親人貴用還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 9
    },
    {
        "title": "贈宗靜上人",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "世上方傳教，山中未得归。閑花飄講席，馴鴿汙禪衣。",
            "積雨谁過寺，残鐘自掩扉。寒來垂頂帽，白发剃應稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 10
    },
    {
        "title": "同賈島宿无可上人院",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "何處銷愁宿，攜囊就遠僧。中宵吟有雪，空屋语无燈。",
            "靜境唯闻鐸，寒床但枕肱。還因愛閑客，始得見南能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 11
    },
    {
        "title": "和劉補闕秋園寓興六首",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "水木夕阴冷，池塘秋意多。庭风吹故葉，階露淨寒莎。",
            "愁燕窺燈语，情人見月過。砧聲聽已別，蟲響複相和。",
            "閉門无事後，此地即山中。但覺鳥聲異，不知人境同。",
            "晚花開為雨，残果落因风。独坐還吟酌，诗成酒已空。",
            "自得家林趣，常时在外稀。對僧餐野食，迎客著山衣。",
            "雀鬥翻簷散，蟬驚出樹飛。功成他日後，何必五湖归。",
            "秋色庭蕪上，清朝見露華。疏篁抽晚筍，幽药吐寒芽。",
            "引水新渠淨，登臺小徑斜。人來多愛此，蕭爽似仙家。",
            "禁掖朝回後，林園勝賞时。野人來辨药，庭鶴往看棋。",
            "晚日明丹枣，朝霜潤紫梨。還因重风景，犹自有秋诗。",
            "聖代少封事，闲居方屏喧。漏寒雲外闕，木落月中園。",
            "山鳥宿簷樹，水螢流洞門。无人見清景，林下自開尊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 12
    },
    {
        "title": "岳阳晚景",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "漢阳无遠寺，見说過汾城。雲雨經春客，江山幾日程。",
            "終隨鸥鳥去，只在海潮生。前路逢漁父，多愁问姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 13
    },
    {
        "title": "塞上宿野寺",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "塞上蕃僧老，天寒疾上關。遠煙平似水，高樹暗如山。",
            "去馬朝常急，行人夜始閑。更深聽刁鬥，时到磬聲間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 14
    },
    {
        "title": "寒食夜池上對月懷友",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "人間多別離，處處是相思。海內无煙夜，天涯有月时。",
            "跳魚翻荇葉，驚鵲出花枝。親友皆千里，三更独繞池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 15
    },
    {
        "title": "自述",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "万事谁能问，一名犹未知。貧當多累日，閑過少年时。",
            "燈下和愁睡，花前帶酒悲。无謀常委命，轉覺命堪疑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 16
    },
    {
        "title": "送契玄上人南游",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "紅葉落湘川，楓明映水天。尋鐘過楚寺，擁錫上瀧船。",
            "病客思留药，迷人待说禪。南中多古跡，應訪虎溪泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 17
    },
    {
        "title": "少年行",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "不倚军功有俠名，可怜球獵少年情。戴鈴健鶻隨聲下，",
            "豈知儒者心偏苦，吟向秋风白发生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 18
    },
    {
        "title": "詠雙白鹭",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "雙鹭應怜水滿池，风飄不動頂絲垂。立當青草人先見，",
            "林塘得爾須增價，況与诗家物色宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 19
    },
    {
        "title": "晴诗",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "晚虹斜日塞天昏，一半山川帶雨痕。新水乱侵青草路，",
            "行子喜闻无戰伐，閑看遊騎獵秋原。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 20
    },
    {
        "title": "送徐山人归睦州舊隱",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "君在桐廬何處住，草堂應与戴家鄰。初归山犬翻驚主，",
            "秋风釣艇遙相憶，七裏灘西片月新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 21
    },
    {
        "title": "到蜀後記途中經歷",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "劍峰重疊雪雲漫，憶昨來时處處難。大散嶺頭春足雨，",
            "自到成都燒酒熟，不思身更入長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 22
    },
    {
        "title": "憶山寄僧",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "塵路谁知蹋雪蹤，到來空認出雲峰。天晴遠見月中樹，",
            "新愁舊恨多難说，半在眉間半在胸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 23
    },
    {
        "title": "贈玉芝觀王尊師",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "處處煙霞尋總遍，卻來城市喜逢師。时流見说无人在，",
            "長憂一日归天去，未授靈方遣问谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 24
    },
    {
        "title": "哭饒州吳諫議使君",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "忽闻身謝滿朝驚，俄感鄱阳罷市情。遺愛永存今似古，",
            "授館曾為門下客，幾回垂淚過宣平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 25
    },
    {
        "title": "經杜甫舊宅",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "浣花溪裏花多處，為憶先生在蜀时。万古只應留舊宅，",
            "山月不知人事變，夜來江上与谁期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 26
    },
    {
        "title": "河阴新城",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "高城新築壓長川，虎踞龍盤氣色全。五裏似雲根不動，",
            "自有此來當汴口，武牢何用鎖风煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 27
    },
    {
        "title": "秋居病中",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "幽居悄悄何人到，落日清涼滿樹梢。新句有时愁裏得，",
            "独臥南窗秋色晚，一庭紅葉掩衡茅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 28
    },
    {
        "title": "罷還邊将",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "白須虜将話邊事，自失公權怨语多。漢主豈勞思李牧，",
            "百戰无功身老去，羨他年少渡黃河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 29
    },
    {
        "title": "永樂殷堯藩明府縣池嘉蓮詠",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "青蘋白石匝蓮塘，水裏蓮開帶瑞光。露濕紅芳雙朵重，",
            "不独豐祥先有應，更宜花縣對潘郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 30
    },
    {
        "title": "酬李紺歲除送酒",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "歲盡貧生事事須，就中深恨酒錢无。故人充壽能分送，",
            "已供时節深珍重，況许今朝更挈壺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 31
    },
    {
        "title": "蜀路倦行因有所感",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "乱峰碎石金牛路，過客應騎鐵馬行。白日欲斜催後乘，",
            "蹇步不唯傷旅思，此中兼見宦途情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 32
    },
    {
        "title": "寄永樂殷堯藩明府",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "古縣蕭條秋景晚，昔年陶令亦如君。頭巾漉酒臨黃菊，",
            "相思不恨书來少，佳句多從闕下闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 33
    },
    {
        "title": "蜀中戰後感事",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "蜀道英靈地，山重水又回。文章四子盛，道路五丁開。",
            "詞客題橋去，忠臣叱馭來。臥龍同駭浪，躍馬比浮埃。",
            "已謂无妖土，那知有禍胎。蕃兵依濮柳，蠻旆指江梅。",
            "戰後悲逢血，燒餘恨見灰。空留犀厭怪，无複酒除災。",
            "歲積萇弘怨，春深杜宇哀。家貧移未得，愁上望鄉台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 34
    },
    {
        "title": "答蜀中經蠻後友人馬艾見寄",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "茜馬渡瀘水，北來如鳥輕。幾年朝鳳闕，一日破龜城。",
            "此地有征戰，谁家无死生。人悲還舊裏，鳥喜下空營。",
            "弟侄意初定，交朋心尚驚。自從經難後，吟苦似猿聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 35
    },
    {
        "title": "盧嶽闲居十韵",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "擾擾走人寰，爭如占得闲。防愁心付酒，求靜力登山。",
            "見药芳时采，逢花好處攀。望雲開病眼，臨澗洗愁顏。",
            "春色流岩下，秋聲碎竹間。錦文苔點點，錢樣菊斑斑。",
            "路遠朝无客，門深夜不關。鶴飛高縹緲，鶯语巧綿蠻。",
            "養拙甘沉默，忘懷絕險艱。更怜雲外路，空去又空還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 36
    },
    {
        "title": "送於中丞使北蕃",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "朔将引雙旌，山遙磧雪平。經年通國信，计日得蕃情。",
            "野次依泉宿，沙中望火行。遠雕秋有力，寒馬夜无聲。",
            "看獵臨胡帳，思鄉見漢城。來春擁邊騎，新草滿归程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 37
    },
    {
        "title": "和河南白尹西池北新葺水齋招賞十二韵",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "二室峰前水，三川府右亭。乱流深竹徑，分繞小花汀。",
            "池角通泉脈，堂心豁地形。坐中寒瑟瑟，床下細泠泠。",
            "雨夜思巫峽，秋朝想洞庭。千年孤鏡碧，一片遠天青。",
            "魚戲搖紅尾，鸥閑退白翎。荷傾瀉珠露，沙乱動金星。",
            "藤架如紗帳，苔牆似錦屏。龍門人少到，仙棹自多停。",
            "游憶高僧伴，吟招野客聽。餘波不能惜，便欲養浮萍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 38
    },
    {
        "title": "感興",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "貧女貌非醜，要須緣嫁迟。還似求名客，无媒不及时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 39
    },
    {
        "title": "長安客感",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "日過千万家，一家非所依。不及行塵影，犹隨馬蹄归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 40
    },
    {
        "title": "春懷舊游",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "吟想舊經過，花时奈遠何。別來長似見，春夢入關多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 41
    },
    {
        "title": "離京城宿商山作",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "山月吟聲苦，春风引思長。无由及塵土，犹帶杏花香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 42
    },
    {
        "title": "秋館雨夜",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "夜雨空館靜，幽人起裴回。長安醉眠客，豈知新雁來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 43
    },
    {
        "title": "闻子規",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "百鳥有啼时，子規聲不歇。春寒四鄰靜，独叫三更月。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 44
    },
    {
        "title": "懷无可上人",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "山寺秋时後，僧家夏滿时。清涼多古跡，幾處有新诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 45
    },
    {
        "title": "長安客感",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "客淚如危葉，長懸零落心。況是悲秋日，臨风制不禁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 46
    },
    {
        "title": "送客遙望",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "別遠心更苦，遙将目送君。光華不可見，孤鶴沒秋雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 47
    },
    {
        "title": "傷靡草",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "靡草似客心，年年亦先死。无由伴花落，暫得因风起。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 48
    },
    {
        "title": "放鶴",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "從今一去不須低，見说遼東好去棲。",
            "努力莫辭仙路遠，白雲飛處免群雞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 49
    },
    {
        "title": "早秋月夜",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "身閑伴月夜深行，风觸衣裳四體輕。",
            "為見近來天氣好，幾篇诗興入秋成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 50
    },
    {
        "title": "蟬",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "高樹蟬聲入晚雲，不唯愁我亦愁君。",
            "何时各得身无事，每到闻时似不闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 51
    },
    {
        "title": "公子行",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "公子风流嫌錦繡，新裁白紵作春衣。",
            "金鞭留當谁家酒，拂柳穿花信馬归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 52
    },
    {
        "title": "題情盡橋",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "從來只有情難盡，何事名為情盡橋。",
            "自此改名為折柳，任他離恨一條條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 53
    },
    {
        "title": "峽中行",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "两崖開盡水回環，一葉才通石罅間。",
            "楚客莫言山勢險，世人心更險於山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 54
    },
    {
        "title": "韋處士郊居",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "滿庭诗境飄紅葉，繞砌琴聲滴暗泉。",
            "門外晚晴秋色老，万條寒玉一溪煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 55
    },
    {
        "title": "秋懷",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "古槐煙薄晚鴉愁，独向黃昏立禦溝。",
            "南國望中生遠思，一行新雁去汀洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 56
    },
    {
        "title": "再下第将归荊楚上白舍人",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "窮通應计一时間，今日甘從刖足還。",
            "長倚玉人心自醉，不辭归去哭荊山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 57
    },
    {
        "title": "春行武關作",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "风香春暖展归程，全勝遊仙入洞情。",
            "一路緣溪花覆水，不妨閑看不妨行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 58
    },
    {
        "title": "恨別二首",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "知君餞酒深深意，圖使行人涕不流。",
            "如今卻恨酒中別，不得一言千里愁。",
            "人言日遠還疏索，別後都非未別心。",
            "唯我憶君千里意，一年不見一重深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 59
    },
    {
        "title": "送人归吳",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "遠愛春波正滿湖，羨君東去是归途。",
            "吟诗好向月中宿，一叫水天沙鶴孤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 60
    },
    {
        "title": "喜夢归",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "旅館歲闌频有夢，分明最似此宵希。",
            "覺來莫道還无益，未得归时且當归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 61
    },
    {
        "title": "路中问程知欲達青雲驛",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "行愁驛路问來人，西去經過愿一闻。",
            "落日回鞭相指點，前程從此是青雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 62
    },
    {
        "title": "題君山",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "风波不動影沉沉，翠色全微碧色深。",
            "應是水仙梳洗處，一螺青黛鏡中心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 63
    },
    {
        "title": "離家後作",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "世上无媒似我希，一身惟有影相隨。",
            "出門便作焚舟计，生不成名死不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 64
    },
    {
        "title": "寄題峴亭",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "峴亭留恨為傷杯，未得醒醒看便回。",
            "卻想醉遊如夢見，直疑元本不曾來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 65
    },
    {
        "title": "病鶴",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "憶得當时病未遭，身為仙馭雪為毛。",
            "今來沙上飛无力，羞見檣烏立處高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 66
    },
    {
        "title": "狀春",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "含春笑日花心豔，帶雨牽风柳態妖。",
            "珍重两般堪比處，醉时紅臉舞时腰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 67
    },
    {
        "title": "春詠",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "风惱花枝不耐频，等闲飛落易愁人。",
            "殷勤最是章台柳，一樹千條管帶春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 68
    },
    {
        "title": "非酒",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "人人慢说酒消憂，我道翻為引恨由。",
            "一夜醒來燈火暗，不應愁事亦成愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 69
    },
    {
        "title": "苦寒",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "今年无異去年寒，何事朝來独忍難。",
            "應是漸為貧客久，錦衣著盡布衣單。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 70
    },
    {
        "title": "送客",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "若論秋思人人苦，最覺愁多客又深。",
            "何況病來惆悵盡，不知爭作送君心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 71
    },
    {
        "title": "人问應舉",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "莫驚西上独迟回，只為衡門未有媒。",
            "惆悵賦成身不去，一名闲事逐秋回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 72
    },
    {
        "title": "送客不及",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "水闊江天两不分，行人两處更相闻。",
            "遙遙已失风帆影，半日虛銷指點雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 73
    },
    {
        "title": "闻杜鵑二首",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "碧竿微露月玲瓏，謝豹傷心独叫风。",
            "高處已應闻滴血，山榴一夜幾枝紅。",
            "蜀客春城闻蜀鳥，思归聲引未归心。",
            "卻知夜夜愁相似，爾正啼时我正吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 74
    },
    {
        "title": "西归出斜谷",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "行過險棧出褒斜，出盡平川似到家。",
            "万里客愁今日散，馬前初見米囊花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 75
    },
    {
        "title": "宿嘉陵驛",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "離思茫茫正值秋，每因风景卻生愁。",
            "今宵難作刀州夢，月色江聲共一樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 76
    },
    {
        "title": "旅懷",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "舊裏已悲无產业，故山犹戀有煙霞。",
            "自從為客归时少，旅館僧房卻是家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 77
    },
    {
        "title": "貧居春怨",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "貧居盡日冷风煙，独向簷床看雨眠。",
            "寂寞春风花落盡，滿庭榆莢似秋天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 78
    },
    {
        "title": "憶江南舊居",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "閑思往事在湖亭，亭上秋燈照月明。",
            "宿客盡眠眠不得，半窗残月帶潮聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 79
    },
    {
        "title": "夷陵城",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "世家曾覽楚英雄，國破城荒万事空。",
            "唯有郵亭階下柳，春來犹似細腰宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 80
    },
    {
        "title": "訪友人幽居二首",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "落花門外春将盡，飛絮庭前日欲高。",
            "深院客來人未起，黃鸝枝上啄櫻桃。",
            "莎深苔滑地无塵，竹冷花迟剩駐春。",
            "盡日弄琴谁共聽，与君兼鶴是三人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 81
    },
    {
        "title": "宿大徹禪師故院",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "竹房谁繼生前事，松月空懸過去心。",
            "秋磬數聲天欲曉，影堂斜掩一燈深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 82
    },
    {
        "title": "送蜀客",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "劍南风景臘前春，山鳥江风得雨新。",
            "莫怪送君行較遠，自緣身是憶归人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 83
    },
    {
        "title": "題寶應縣",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "雪樓當日動晴寒，渭水梁山鳥外看。",
            "闻说德宗曾到此，吟诗不敢倚闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 84
    },
    {
        "title": "和孫明府懷舊山",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "五柳先生本在山，偶然為客落人間。",
            "秋來見月多归思，自起開籠放白鷳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 85
    },
    {
        "title": "城西訪友人別墅",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "澧水橋西小路斜，日高犹未到君家。",
            "村園門巷多相似，處處春风枳殼花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 86
    },
    {
        "title": "題大安池亭",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "幽島曲池相隱映，小橋虛閣半高低。",
            "好风好月无人宿，夜夜水禽船上棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 87
    },
    {
        "title": "送春",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "勿言春盡春還至，少壯看花複幾回。",
            "今日已從愁裏去，明年更莫共愁來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 88
    },
    {
        "title": "武侯廟古柏",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "密葉四时同一色，高枝千歲對孤峰。",
            "此中疑有精靈在，為見盤根似臥龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 89
    },
    {
        "title": "哀蜀人為南蠻俘虜五章：初出成都闻哭聲",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "但見城池還漢将，豈知佳麗屬蠻兵。",
            "錦江南度遙闻哭，儘是離家別國聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 90
    },
    {
        "title": "哀蜀人為南蠻俘虜五章：過大渡河蠻使许之泣望鄉國",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "大渡河邊蠻亦愁，漢人将渡盡回頭。",
            "此中剩寄思鄉淚，南去應无水北流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 91
    },
    {
        "title": "哀蜀人為南蠻俘虜五章：出青溪關有迟留之意",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "欲出鄉關行步迟，此生无複卻回时。",
            "千冤万恨何人見，唯有空山鳥獸知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 92
    },
    {
        "title": "哀蜀人為南蠻俘虜五章：別巂州一时慟哭雲日為之變色",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "越巂城南无漢地，傷心從此便為蠻。",
            "冤聲一慟悲风起，雲暗青天日下山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 93
    },
    {
        "title": "哀蜀人為南蠻俘虜五章：入蠻界不许有悲泣之聲",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "雲南路出陷河西，毒草長青瘴色低。",
            "漸近蠻城谁敢哭，一时收淚羨猿啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 94
    },
    {
        "title": "宿石門山居",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "窗燈欲滅夜愁生，螢火飛來促織鳴。",
            "宿客幾回眠又起，一溪秋水枕邊聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 95
    },
    {
        "title": "過舊宅看花",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "山桃野杏两三栽，樹樹繁花去複開。",
            "今日主人相引看，谁知曾是客移來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 96
    },
    {
        "title": "寄襄阳章孝標",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "青油幕下白雲邊，日日空山夜夜泉。",
            "闻说小齋多野意，枳花阴裏麝香眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 97
    },
    {
        "title": "洛中感事",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "洛城今古足繁華，最恨喬家似石家。",
            "行到窈娘身沒處，水邊愁見亞枝花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 98
    },
    {
        "title": "阴地關見入蕃公主石上手跡",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "漢家公主昔和蕃，石上今餘手跡存。",
            "风雨幾年侵不滅，分明纖指印苔痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 99
    },
    {
        "title": "美人春风怨",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "澹蕩春风滿眼來，落花飛蝶共裴回。",
            "偏能飄散同心蒂，无那愁眉吹不開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 100
    },
    {
        "title": "過南鄰花園",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "莫怪频過有酒家，多情長是惜年華。",
            "春风堪賞還堪恨，才見開花又落花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 101
    },
    {
        "title": "勸行樂",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "老去风光不屬身，黃金莫惜買青春。",
            "白頭縱作花園主，醉折花枝是別人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 102
    },
    {
        "title": "渡桑乾河",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "南客豈曾諳塞北，年年唯見雁飛回。",
            "今朝忽渡桑幹水，不似身來似夢來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 103
    },
    {
        "title": "月下喜呂郎中除兵部",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "北闕雲間見碧天，南宮月似舊时圓。",
            "喜看列宿今朝正，休歎參差十四年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 104
    },
    {
        "title": "天津橋望春",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "津橋春水浸紅霞，煙柳风絲拂岸斜。",
            "翠輦不來金殿閉，宮鶯銜出上阳花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 105
    },
    {
        "title": "自蔚州南入真谷有似劍門，因有归思",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "我家蜀地身離久，忽見胡山似劍門。",
            "馬上欲垂千里淚，耳邊唯欠一聲猿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 106
    },
    {
        "title": "再經天涯地角山",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "每憶雲山養短才，悔緣名利入塵埃。",
            "十年馬足行多少，两度天涯地角來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 107
    },
    {
        "title": "題等界寺二首",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "吳蜀千年等界村，英雄无主豈長存。",
            "思量往事今何在，万里山中一寺門。",
            "两國道塗都万里，來從此地等平分。",
            "行人競说東西利，事不關心耳不闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 108
    },
    {
        "title": "洛源驛戲題",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "柳阴春嶺鳥新啼，暖色濃煙深處迷。",
            "如恨往來人不見，水聲呦咽出花溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 109
    },
    {
        "title": "遣愁",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "拋擲泥中一聽沈，不能三歎引愁深。",
            "莫言客子无愁易，須识愁多暗損心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 110
    },
    {
        "title": "送友人棄官归山居",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "不愛人間紫与緋，卻思松下著山衣。",
            "春郊雨盡多新草，一路青青蹋雨归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 111
    },
    {
        "title": "山行",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "野花幽鳥幾千般，頭白山僧遍识難。",
            "世上遊人无複見，一生唯向画圖看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 112
    },
    {
        "title": "送客二首",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "与君同在少年場，知己蕭條壯士傷。",
            "可惜報恩无處所，卻提孤劍過咸阳。",
            "行人立馬強盤回，別字犹含未忍開。",
            "好去出門休落淚，不如前路早归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 113
    },
    {
        "title": "安國寺贈廣宣上人",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "馬急人忙塵路喧，幾從朝出到黃昏。",
            "今來合掌聽師语，一似敲冰清耳根。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 114
    },
    {
        "title": "初醒",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "心中得勝暫拋愁，醉臥京风拂簟秋。",
            "半夜覺來新酒醒，一條斜月到床頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 115
    },
    {
        "title": "送客归襄阳舊居",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "襄阳耆舊別來稀，此去何人共掩扉。",
            "唯有白銅鞮上月，水樓閑處待君归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 116
    },
    {
        "title": "夜闻方響",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "方響闻时夜已深，聲聲敲著客愁心。",
            "不知正在谁家樂，月下犹疑是遠砧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 117
    },
    {
        "title": "路逢有似亡友者，惻然賦此",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "吾友今生不可逢，风流空想舊仪容。",
            "朝來馬上频回首，惆悵他人似蔡邕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 118
    },
    {
        "title": "望月懷江上舊游",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "往歲曾隨江客船，秋风明月洞庭邊。",
            "為看今夜天如水，憶得當时水似天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 119
    },
    {
        "title": "途中西望",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "行行何處散離愁，長路无因暫上樓。",
            "唯到高原即西望，馬知人意亦回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 120
    },
    {
        "title": "題友人所居",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "亞尹故居經幾主，只因君住有诗情。",
            "夜吟鄰叟闻惆悵，七八年來无此聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 121
    },
    {
        "title": "蔚州晏內遇新雪",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "胡盧河畔逢秋雪，疑是风飄白鶴毛。",
            "坐客停杯看未定，将军已濕褐花袍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 122
    },
    {
        "title": "句",
        "author": "雍陶",
        "biography": "",
        "paragraphs": [
            "古木閩州道，驅羸落照間。投村礙野水，问店隔荒山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十八",
        "no#": 123
    }
]