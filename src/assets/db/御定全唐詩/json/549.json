[
    {
        "title": "汾上宴別",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雲物如故鄉，山川知異路。年來未归客，馬上春色暮。",
            "一尊花下酒，残日水西樹。不待管弦終，搖鞭背花去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 1
    },
    {
        "title": "书齋雪后",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "擁褐坐茅簷，春晴喜初日。微风入桃徑，爽气归縹帙。",
            "频时苦风雪，就景理巾櫛。樹暖高鳥來，窗閑曙雲出。",
            "鄉遙路難越，道蹇时易失。欲靜又不能，東山負芝朮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 2
    },
    {
        "title": "寄道者",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "洞庭先生归路長，海雲望极春茫茫。",
            "別來幾度向蓬島，自傍瑤台折靈草。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 3
    },
    {
        "title": "虎丘寺贈漁处士",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "蘭若雲深处，前年客重過。岩空秋色動，水闊夕阳多。",
            "早負江湖志，今如鬢发何。唯思閑勝我，釣艇在煙波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 4
    },
    {
        "title": "陪崔璞侍禦和崔gC春日有懷",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "诗家本多感，況值廣陵春。暖駐含窗日，香餘醉袖塵。",
            "浮名皆有分，一笑最關身。自此容依託，清才两故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 5
    },
    {
        "title": "昔昔鹽二十首：垂柳覆金堤",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "新年垂柳色，嫋嫋对空閨。不畏芳菲好，自緣離別啼。",
            "因风飄玉戶，向日映金堤。驛使何时度，還将贈隴西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 6
    },
    {
        "title": "昔昔鹽二十首：蘼蕪葉複齊",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "提筐紅葉下，度日采蘼蕪。掬翠香盈袖，看花憶故夫。",
            "葉齊谁複見，风暖恨偏孤。一被春光累，容顏与昔殊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 7
    },
    {
        "title": "昔昔鹽二十首：水溢芙蓉沼",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "淥沼春光后，青青草色濃。綺羅驚翡翠，暗粉妒芙蓉。",
            "雲遍窗前見，荷翻鏡裏逢。将心托流水，終日渺无從。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 8
    },
    {
        "title": "昔昔鹽二十首：花飛桃李蹊",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "遠期難可托，桃李自依依。花徑无容跡，戎裘未下机。",
            "隨风開又落，度日掃還飛。欲折枝枝贈，那知归不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 9
    },
    {
        "title": "昔昔鹽二十首：采桑秦氏女",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "南陌采桑出，谁知妾姓秦。独怜傾國貌，不負早鶯春。",
            "珠履蕩花濕，龍鉤折桂新。使君那駐馬，自有侍中人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 10
    },
    {
        "title": "昔昔鹽二十首：織錦竇家妻",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "當年谁不羨，分作竇家妻。錦字行行苦，羅幃日日啼。",
            "豈知登隴遠，只恨下机迷。直候阳關使，殷勤寄海西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 11
    },
    {
        "title": "昔昔鹽二十首：關山別蕩子",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "那堪闻蕩子，迢遞涉關山。腸為馬嘶斷，衣從淚滴斑。",
            "愁看塞上路，詎惜鏡中顏。儻見征西雁，應傳一字還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 12
    },
    {
        "title": "昔昔鹽二十首：风月守空閨",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "良人犹遠戍，耿耿夜閨空。繡戶流宵月，羅幃坐晚风。",
            "魂飛沙帳北，腸斷玉關中。尚自无消息，錦衾那得同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 13
    },
    {
        "title": "昔昔鹽二十首：恒斂千金笑",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "玉顏恒自斂，羞出鏡臺前。早惑阳城客，今悲華錦筵。",
            "從军人更遠，投喜鵲空傳。夫婿交河北，迢迢路幾千。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 14
    },
    {
        "title": "昔昔鹽二十首：長垂雙玉啼",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雙雙紅淚墮，度日暗中啼。雁出居延北，人犹遼海西。",
            "向燈垂玉枕，对月灑金閨。不惜羅衣濕，惟愁归意迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 15
    },
    {
        "title": "昔昔鹽二十首：蟠龍隨鏡隱",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "鸞鏡无由照，蛾眉豈忍看。不知愁發换，空見隱龍蟠。",
            "那愜紅顏改，偏傷白日残。今朝窺玉匣，雙淚落闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 16
    },
    {
        "title": "昔昔鹽二十首：彩鳳逐帷低",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "巧繡雙飛鳳，朝朝伴下帷。春花那見照，暮色已频欺。",
            "欲卷思君处，将啼裛淚时。何年征戍客，傳语報佳期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 17
    },
    {
        "title": "昔昔鹽二十首：驚魂同夜鵲",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "万里无人見，眾情難与論。思君常入夢，同鵲屡驚魂。",
            "孤寢紅羅帳，雙啼玉箸痕。妾心甘自保，豈複暫忘恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 18
    },
    {
        "title": "昔昔鹽二十首：倦寢聽晨雞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "去去邊城騎，愁眠掩夜閨。披衣窺落月，拭淚待鳴雞。",
            "不憤連年別，那看長夜啼。功成應自恨，早晚發遼西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 19
    },
    {
        "title": "昔昔鹽二十首：暗牖懸蛛網",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "暗中蛛網織，曆乱綺窗前。万里終无信，一條徒自懸。",
            "分從珠露滴，愁見隙风牽。妾意何聊賴，看看劇斷弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 20
    },
    {
        "title": "昔昔鹽二十首：空梁落燕泥",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "春至今朝燕，花时伴独啼。飛斜珠箔隔，语近画梁低。",
            "帷卷閑窺戶，床空暗落泥。谁能長对此，雙去複雙棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 21
    },
    {
        "title": "昔昔鹽二十首：前年過代北",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "代北幾千里，前年又複經。燕山雲自合，胡塞草應青。",
            "鐵馬喧鼙鼓，蛾眉怨錦屏。不知羌笛曲，掩淚若為聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 22
    },
    {
        "title": "昔昔鹽二十首：今歲往遼西",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "万里飛书至，闻君已渡遼。只諳新別苦，忘卻舊时嬌。",
            "烽戍年将老，紅顏日向凋。胡沙兼漢苑，相望幾迢迢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 23
    },
    {
        "title": "昔昔鹽二十首：一去无還意",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "良人征絕域，一去不言還。百戰攻胡虜，三冬阻玉關。",
            "蕭蕭邊馬思，獵獵戍旗閑。独抱千重恨，連年未解顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 24
    },
    {
        "title": "昔昔鹽二十首：那能惜馬蹄",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雲中路杳杳，江畔草淒淒。妾久垂珠淚，君何惜馬蹄。",
            "邊风悲曉角，營月怨春鼙。未道休征戰，愁眉又複低。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 25
    },
    {
        "title": "送韋处士归省朔方",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "映柳見行色，故山當落暉。青雲知已歿，白首一身归。",
            "滿袖蕭關雨，連沙塞雁飛。到家翻有喜，借取老萊衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 26
    },
    {
        "title": "送權先輩归覲信安",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "衣彩独归去，一枝蘭更香。馬嘶芳草渡，門掩百花塘。",
            "野色亭台晚，灘聲枕簟涼。小齋松島上，重葉覆书堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 27
    },
    {
        "title": "风蟬",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "风蟬旦夕鳴，伴夜送秋聲。故里客归盡，水邊身独行。",
            "噪軒高樹合，驚枕暮山橫。聽处无人見，塵埃滿甑生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 28
    },
    {
        "title": "重寄盧中丞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "賤子來還去，何人伴使君。放歌迎晚醉，指路上高雲。",
            "此夜雁初至，空山雨独闻。別多頭欲白，惆悵惜餘醺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 29
    },
    {
        "title": "曉發",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "旅行宜早發，況複是南归。月影緣山盡，鐘聲隔浦微。",
            "星残螢共映，葉落鳥驚飛。去去渡南渚，村深人出稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 30
    },
    {
        "title": "送友人鄭州归覲",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "為有趨庭戀，應忘道路賒。风消滎澤凍，雨靜圃田沙。",
            "古陌人來遠，遙天雁勢斜。園林新到日，春酒酌梨花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 31
    },
    {
        "title": "洛中逢盧郢石归覲",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "不堪俱失意，相送出東周。緣切倚門戀，倍添為客愁。",
            "春山和雪靜，寒水帶冰流。別后期君处，靈源紫閣秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 32
    },
    {
        "title": "贈越客",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "故國波濤隔，明时心久留。獻书雙闕晚，看月五陵秋。",
            "南棹何當返，長江憶共遊。定知釣魚伴，相望在汀州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 33
    },
    {
        "title": "經无錫縣醉后吟",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "客過无名姓，扁舟系柳阴。窮秋南國淚，残日故鄉心。",
            "京洛衣塵在，江湖酒病深。何須覓陶令，乘醉自橫琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 34
    },
    {
        "title": "東归道中二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "平生事行役，今日始知非。歲月老将至，江湖春未归。",
            "傳家有天爵，主祭用儒衣。何必勞知己，无名亦息机。",
            "未明喚僮僕，江上憶残春。风雨落花夜，山川驅馬人。",
            "星星一鏡發，草草百年身。此日念前事，滄洲情更親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 35
    },
    {
        "title": "旅次商山",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "役役依山水，何曾似问津。斷崖如避馬，芳樹欲留人。",
            "日夕猿鳥伴，古今京洛塵。一枝甘已失，辜負故園春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 36
    },
    {
        "title": "長洲",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "扁舟殊不系，浩蕩路才分。范蠡湖中樹，吳王苑外雲。",
            "悲心人望月，独夜雁離群。明發還驅馬，關城見日曛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 37
    },
    {
        "title": "江邊",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "終日勞車馬，江邊款行扉。残花春浪闊，小酒故人稀。",
            "戍鼓客帆遠，津雲夕照微。何由兄与弟，俱及暮春归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 38
    },
    {
        "title": "宿靈岩寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "明月溪頭寺，蟲聲滿橘洲。倚欄香徑晚，移石太湖秋。",
            "古樹雲归盡，荒台水更流。无人見惆悵，独上最高樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 39
    },
    {
        "title": "越中寺居",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "迟客疏林下，斜溪小艇通。野橋連寺月，高竹半樓风。",
            "水靜魚吹浪，枝閑鳥下空。数峰相向綠，日夕郡城東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 40
    },
    {
        "title": "贈金剛三藏",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "心法雲无住，流沙归複來。錫隨山鳥動，經附海船回。",
            "洗足柳遮寺，坐禪花委苔。惟将一童子，又欲過天臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 41
    },
    {
        "title": "長安晚秋",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雲物淒涼拂曙流，漢家宮闕動高秋。残星幾點雁橫塞，",
            "鱸魚正美不归去，空戴南冠學楚囚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 42
    },
    {
        "title": "齊安早秋",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "流年堪惜又堪驚，砧杵风來滿郡城。高鳥過时秋色動，",
            "此日沾襟念岐路，不知何处是前程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 43
    },
    {
        "title": "東望",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "楚江橫在草堂前，楊柳洲西载酒船。两見梨花归不得，",
            "同郡故人攀桂盡，把诗吟向泬寥天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 44
    },
    {
        "title": "長安月夜与友人話故山",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "宅邊秋水浸苔磯，日日持竿去不归。楊柳风多潮未落，",
            "今夜秦城滿樓月，故人相見一沾衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 45
    },
    {
        "title": "題橫水驛雙峰院松",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "故園溪上雪中別，野館門前雲外逢。白发漸多何事苦，",
            "更憶葛洪丹井畔，数株臨水欲成龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 46
    },
    {
        "title": "發剡中",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "正懷何謝俯長流，更覽餘封识嵊州。樹色老依官舍晚，",
            "日暮不堪還上馬，蓼花风起路悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 47
    },
    {
        "title": "登安陸西樓",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "樓上華筵日日開，眼前人事只堪哀。征車自入紅塵去，",
            "无由並写春风恨，欲下鄖城首重回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 48
    },
    {
        "title": "九日陪越州元相燕龜山寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "佳晨何处泛花游，丞相筵開水上頭。雙影旆搖山雨霽，",
            "共賀万家逢此節，可怜风物似荊州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 49
    },
    {
        "title": "經漢武泉",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "芙蓉苑裏起清秋，漢武泉聲落禦溝。他日江山映蓬鬢，",
            "盡把归心付紅葉，晚來隨水向東流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 50
    },
    {
        "title": "曲江春望懷江南故人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "杜若洲邊人未归，水寒煙暖想柴扉。故園何处风吹柳，",
            "此时愁望情多少，万里春流繞釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 51
    },
    {
        "title": "上令狐相公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "鶚在卿雲冰在壺，代天才业奉籲謨。榮同伊陟傳朱戶，",
            "不知机務时多暇，犹许诗家屬和无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 52
    },
    {
        "title": "憶山阳",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "家在枚皋舊宅邊，竹軒晴与楚坡連。芰荷香繞垂鞭袖，",
            "可怜时節堪归去，花落猿啼又一年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 53
    },
    {
        "title": "二",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "折柳城邊起暮愁，可怜春色独懷憂。傷心正歎人間事，",
            "凭高滿眼送清渭，去傍故山山下流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 54
    },
    {
        "title": "送僧归廬山",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "禪棲忽憶五峰遊，去著方袍謝列侯。經啟樓臺千葉曙，",
            "卻憶前年別師处，馬嘶残月虎溪頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 55
    },
    {
        "title": "贈天卿寺神亮上人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "五看春盡此江濆，花自飄零日自曛。空有慈悲隨物念，",
            "笑指白蓮心自得，世間煩惱是浮雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 56
    },
    {
        "title": "降虜",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "廣武溪頭降虜稀，一聲寒角怨金微。河湟不在春风地，",
            "揚雄尚白相如吃，今日何人從獵归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 57
    },
    {
        "title": "平戎",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "邊聲一夜殷秋鼙，牙帳連烽擁万蹄。武帝未能忘塞北，",
            "自古平戎有良策，将军不用倚雲梯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 58
    },
    {
        "title": "宿楚國寺有懷",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "风動衰荷寂寞香，斷煙残月共蒼蒼。寒生晚寺波搖壁，",
            "江邊松菊荒應盡，八月長安夜正長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 59
    },
    {
        "title": "早發剡中石城寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "暫息勞生樹色間，平明机慮又相關。吟辭宿处煙霞去，",
            "明朝一倍堪惆悵，回首塵中見此山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 60
    },
    {
        "title": "寄归",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "三年踏盡化衣塵，只見長安不見春。馬過雪街天未曙，",
            "早晚相酬身事了，水邊归去一闲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 61
    },
    {
        "title": "獻淮南李相公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "傅岩高靜見台星，廟略當时討不庭。万里有雲归碧落，",
            "闻道國人思再入，熔金新鑄鶴仪形。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 62
    },
    {
        "title": "宛陵寓居上沈大夫二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "滿耳歌謠滿眼山，宛陵城郭翠微間。人情已觉春長在，",
            "幽雲高鳥俱无事，晚伴西风醉客還。",
            "溪樹參差綠可攀，謝家雲水滿東山。能忘天上他年貴，",
            "觥籌不盡須归去，路在春风縹緲間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 63
    },
    {
        "title": "淮信賀滕邁台州",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "凋瘵民思太古风，上賢綏輯副宸衷。舟移清鏡禹祠北，",
            "遙知到郡滄波晏，三島離離一望中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 64
    },
    {
        "title": "下第寄宣城幕中諸公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "一醉曾将万事齊，暫陪歡去便如泥。黃花李白墓前路，",
            "莫言春盡不惆悵，自有閑眠到日西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 65
    },
    {
        "title": "送令狐郎中赴郢州",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "佐幕才多始拜侯，一門清貴動神州。霜蹄曉駐秦雲斷，",
            "大馮罷相吟诗地，莫惜频登白雪樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 66
    },
    {
        "title": "送盧緘归揚州",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "曾向雷塘寄掩扉，荀家燈火有餘輝。關河日暮望空极，",
            "今年春色還相誤，為我江邊謝釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 67
    },
    {
        "title": "送李裴評事",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "塞垣從事识兵机，只擬平戎不擬归。入夜笳聲含白发，",
            "此別不應书斷絕，滿天霜雪有鴻飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 68
    },
    {
        "title": "別麻氏",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "曉哭呱呱動四鄰，於君我作負心人。出門便涉東西路，",
            "分離況值花时節，從此東风不似春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 69
    },
    {
        "title": "代人贈別",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "月自斜窗夢自驚，衷腸中有万愁生。清猿处处三聲盡，",
            "會須攜手乘鸞去，簫史樓臺在玉京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 70
    },
    {
        "title": "寒食新豐別友人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "一百五日家未归，新豐雞犬独依依。滿樓春色傍人醉，",
            "東风吹淚对花落，憔悴故交相見稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 71
    },
    {
        "title": "李侍禦归山同宿華嚴寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "家有青山近玉京，风流柱史早知名。園林手植自含綠，",
            "相逢一宿最高寺，夜夜翠微泉落聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 72
    },
    {
        "title": "今年新先輩以遏密之際每有宴集必資清談书此奉賀",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "天上高高月桂叢，分明三十一枝风。滿懷春色向人動，",
            "居然自是前賢事，何必青樓倚翠空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 73
    },
    {
        "title": "自遣",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "晚樹疏蟬起別愁，遠人回首憶滄洲。江連故國无窮恨，",
            "到頭生長煙霞者，須向煙霞老始休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 74
    },
    {
        "title": "浙東陪元相公游雲門寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "松下山前一徑通，燭迎千騎滿山紅。溪雲乍斂幽岩雨，",
            "归來吹盡岩城角，路轉橫塘乱水東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 75
    },
    {
        "title": "陪韋中丞宴扈都頭花園",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "門下煙橫载酒船，謝家攜客醉華筵。尋花偶坐将军樹，",
            "分明聽得輿人语，愿及行春更一年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 76
    },
    {
        "title": "花園即事呈常",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "煙暖池塘柳覆台，百花園裏看花來。燒衣焰席三千樹，",
            "山公仰爾延賓客，好傍春风次第開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 77
    },
    {
        "title": "宿何书記先輩延福新居",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "松下有琴閑未收，一燈高為石叢留。诗情似到山家夜，",
            "因君撫掌问时俗，紫閣堆簷不舉頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 78
    },
    {
        "title": "秦中逢王处士",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "万水東流去不回，先生独自負仙才。蕊宮橫浪海邊別，",
            "春风正好分瓊液，乞取當时白玉杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 79
    },
    {
        "title": "江上逢许逸人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "是非处处生塵埃，唯君襟抱无嫌猜。收帆依雁湓浦宿，",
            "清秋華发好相似，卻把釣竿归去來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 80
    },
    {
        "title": "和令狐補闕春日独遊西街",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "左掖初辭近侍班，馬嘶尋得過街閑。映鞭柳色微遮水，",
            "此时失意哀吟客，更觉风流不可攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 81
    },
    {
        "title": "廣陵答崔琛",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "棹倚隋家舊院牆，柳金梅雪撲簷香。朱樓映日重重晚，",
            "聲名官職應前定，且把旌麾入醉鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 82
    },
    {
        "title": "答友人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "诗家才子酒家仙，游宦曾依積水邊。窗戶動搖三島樹，",
            "今日相逢朗吟罷，滿城砧杵一燈前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 83
    },
    {
        "title": "送张又新除溫州",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "東晉江山稱永嘉，莫辭紅旆向天涯。凝弦夜醉松亭月，",
            "卻愁明詔征非晚，不得秋來見海槎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 84
    },
    {
        "title": "送滕邁郎中赴睦州",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "郡齋秋盡一江橫，频命郎官地更清。星月去隨新詔動，",
            "想到釣台逢竹馬，只應歌詠伴猿聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 85
    },
    {
        "title": "送剡客",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "两重江外片帆斜，数裏林塘繞一家。門掩右军餘水石，",
            "若到天臺洞阳觀，葛洪丹井在雲涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 86
    },
    {
        "title": "李先輩擢第東归有贈送",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "金榜前頭无是非，平人分得一枝归。正怜日暖雲飄路，",
            "茂陵自笑犹多病，空有书齋在翠微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 87
    },
    {
        "title": "送同年鄭祥先輩归漢南",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "年來驚喜两心知，高处同攀次第枝。人倚繡屏閑賞夜，",
            "家去恩門四千里，只應從此夢旌旗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 88
    },
    {
        "title": "送沈單作尉江都",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "煬帝都城春水邊，笙歌夜上木蘭船。三千宮女自塗地，",
            "少年作尉須矜慎，莫向樓前墜馬鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 89
    },
    {
        "title": "送李蘊赴鄭州因獻盧郎中俶",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "僕射陂西想到时，滿川晴色見旌旗。馬融閑臥笛聲遠，",
            "唯君此去人多羨，卻是恩深自不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 90
    },
    {
        "title": "送韓絳归淮南寄韓綽先輩",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "島上花枝系釣船，隋家宮畔水連天。江帆自落鳥飛外，",
            "相逢且问昭州事，曾鼓莊盆对逝川。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 91
    },
    {
        "title": "送薛耽先輩归謁漢南",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雪繞千峰驛路長，謝家聯句待檀郎。手持碧落新攀桂，",
            "孔門多少风流处，不遣顏回识醉鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 92
    },
    {
        "title": "送陳嘏登第作尉归覲",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "千峰归去舊林塘，溪縣門前即故鄉。曾把桂誇春裏巷，",
            "就養舉朝人共羨，清資讓卻校书郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 93
    },
    {
        "title": "送裴延翰下第归覲滁州",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "失意何曾恨解攜，问安归去秣陵西。郡斜楊柳春风岸，",
            "一枝攀折回頭是，莫向清秋惜馬蹄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 94
    },
    {
        "title": "題崇圣寺簡雲端僧錄",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "暮塵飄盡客愁長，來扣禪關月滿廊。宋玉逢秋空雪涕，",
            "回首故園紅葉外，只将多病告醫王。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 95
    },
    {
        "title": "越中寺居寄上主人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "野寺初容訪靜來，晚晴江上見樓臺。中林有路到花盡，",
            "苦心若是酬恩事，不敢吟春憶酒杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 96
    },
    {
        "title": "早出洞仙觀",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "露濃如水灑蒼苔，洞口煙蘿密不開。残月色低當戶后，",
            "愁是独尋归路去，人間步步是塵埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 97
    },
    {
        "title": "題昭應王明府溪亭",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "靖節何須彭澤逢，菊洲松島水悠溶。行人自折門前柳，",
            "軒車過盡无公事，枕上一聲長樂鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 98
    },
    {
        "title": "贈王先生",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "太一真人隱翠霞，早年曾降蔡經家。羽衣使者峭于鶴，",
            "时因弟子偷靈药，散落人間駐物華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 99
    },
    {
        "title": "贈道者",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "華蓋飄飄綠鬢翁，往來朝謁蕊珠宮。幾年山下阴阳鼎，",
            "應怜有客外妻子，思在長生一顧中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 100
    },
    {
        "title": "王先生不別而去",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "仙翁归袖拂煙霓，一卷素书還独攜。劚药滿囊身不病，",
            "樹樹白雲幽徑絕，短船空倚武陵溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 101
    },
    {
        "title": "山阳盧明府以雙鶴寄遺，白氏以诗回答，因寄和",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "緱山雙去羽翰輕，應為仙家好弟兄。茅固枕前秋对舞，",
            "自笑滄江一漁叟，何由似爾到層城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 102
    },
    {
        "title": "贈李秘书",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "束帶臨风气調新，孔門才业独谁倫。杉松韵冷雪溪暗，",
            "莫将芸閣輕科第，須作人間第一人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 103
    },
    {
        "title": "回於道中寄舒州李玨相公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "都无鄙吝隔塵埃，昨日丘門避席來。靜语乍臨清廟瑟，",
            "從此微塵知感戀，七真臺上望三台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 104
    },
    {
        "title": "舒州獻李相公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "野人留得五湖船，丞相興歌郡國年。醉筆倚风飄澗雪，",
            "闻说万方思舊德，一时傾望重陶甄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 105
    },
    {
        "title": "成名年獻座主僕射兼呈同年",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "拂煙披月羽毛新，千里初辭九陌塵。曾失玄珠求象罔，",
            "除卻今年仙侶外，堂堂又見两三春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 106
    },
    {
        "title": "抒懷上歙州盧中丞宣州杜侍郎",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "東來珠履与旌旗，前者登朝亦一时。竹馬迎呼逢稚子，",
            "独有賤夫懷感激，十年两地負恩知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 107
    },
    {
        "title": "山阳韋中丞罷郡因獻",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "笙歌只是舊笙歌，腸斷风流奈別何。照物二年春色在，",
            "今日尊前无限思，万重雲月隔煙波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 108
    },
    {
        "title": "山阳即席獻裴中丞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "早年天上見清塵，今日樓中醉一春。暫肯剖符臨水石，",
            "好是仙家羽衣使，欲教垂涕问何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 109
    },
    {
        "title": "西峰即事獻沈大夫",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "松竹闲遊道路身，衣襟落盡往來塵。山連謝宅餘霞在，",
            "安知不及屠沽者，曾对青萍淚滿巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 110
    },
    {
        "title": "杜陵貽杜牧侍禦",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "紫陌塵多不可尋，南溪酒熟一披襟。山高晝枕石床隱，",
            "唯君懷抱安如水，他日門牆许醉吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 111
    },
    {
        "title": "下第后上李中丞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "落第逢人慟哭初，平生志业欲何如。鬢毛灑盡一枝桂，",
            "唯應感激知恩地，不待功成死有餘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 112
    },
    {
        "title": "浙東贈李副使員外",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "妙盡戎机佐上臺，少年清苦自霜台。馬嘶深竹閑宜貴，",
            "名高漸少翻飛伴，幾度煙霄独去來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 113
    },
    {
        "title": "寄淮南幕中劉員外",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "郎官何遜最风流，愛月怜山不下樓。三佐戎旃换朱紱，",
            "休向西齋久閑臥，滿朝傾蓋是依劉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 114
    },
    {
        "title": "薛廷范從事自宣城至因贈",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "少年從事霍嫖姚，來自楓林度柳橋。金管別筵樓灼灼，",
            "独有故人愁欲死，晚簷疏雨動空瓢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 115
    },
    {
        "title": "寄潯阳趙校书",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "簾下秋江夜影空，倚樓人在月明中。不将行止问朝列，",
            "那應更結廬山社，見说心閑勝遠公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 116
    },
    {
        "title": "贈李從貴",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "白馬嘶风何处還，鞭梢拂地看南山。珠簾卷盡不回首，",
            "知君舊隱嵩雲下，岩桂從今幾更攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 117
    },
    {
        "title": "贈陳正字",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "魯儒今日意何如，名掛春官選籍初。野艇幾曾尋水去，",
            "闻说晚心心更靜，竹間依舊臥看书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 118
    },
    {
        "title": "洞庭寄所思",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "日斷蘭台空望归，錦衾香冷夢來稀。书中自報刀頭約，",
            "遙知不语坐相憶，寂寞洞房寒燭微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 119
    },
    {
        "title": "代人贈杜牧侍禦",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "郎作東台禦史时，妾長西望斂雙眉。一從詔下人皆羨，",
            "坐來情態犹无限，更向樓前舞柘枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 120
    },
    {
        "title": "旅館闻雁別友人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "路繞秋塘首独搔，背群燕雁正呼號。故關何处重相失，",
            "行衣濕盡千山雪，腸斷金籠好羽毛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 121
    },
    {
        "title": "泊鳧磯江館",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "风雪晴來歲欲除，孤舟晚下意何如。月當軒色湖平后，",
            "三間茅屋東溪上，归去生涯竹与书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 122
    },
    {
        "title": "春盡独遊慈恩寺南池",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "竹外池塘煙雨收，送春无伴亦迟留。秦城馬上半年客，",
            "杏園花落遊人盡，独為圭峰一舉頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 123
    },
    {
        "title": "重游楚國寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "往事飄然去不回，空餘山色在樓臺。池塘风暖雁尋去，",
            "老僧心地閑于水，犹被流年日日催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 124
    },
    {
        "title": "三像寺酬元秘书",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "官總芸香閣署崇，可怜诗句落春风。偶然侍坐水聲裏，",
            "不因高寺閑回首，谁识飄飄一寒翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 125
    },
    {
        "title": "獻淮南李僕射",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "早年曾謁富民侯，今日難甘失鵠羞。新諾似山无力負，",
            "功德万重知不惜，一言拋得百生愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 126
    },
    {
        "title": "江亭晚望",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "碧江涼冷雁來疏，閑望江雲思有餘。秋館池亭荷葉歇，",
            "闻说故園香稻熟，片帆归去就鱸魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 127
    },
    {
        "title": "贈曹处士幽居",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "勾漏先生冰玉然，曾将八石问群仙。中山暫醉一千日，",
            "何須更學鴟夷子，頭白江湖一短船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 128
    },
    {
        "title": "重阳日示舍弟",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "多少鄉心入酒杯，野塘今日菊花開。新霜何处雁初下，",
            "侯門无路提攜爾，虛共扁舟万里來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百四十九",
        "no#": 129
    },
    {
        "title": "客至",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "得路逢津更俊才，可怜鞍馬照春來。残花幾日小齋閉，",
            "相逢少別更堪恨，何必秋风江上臺。"
        ],
        "notes": [
            ""
        ],
