[
    {
        "title": "耕田鼓诗",
        "author": "可朋",
        "biography": "",
        "paragraphs": [
            "農舍田頭鼓，王孫筵上鼓。擊鼓兮皆為鼓，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 1
    },
    {
        "title": "賦洞庭",
        "author": "可朋",
        "biography": "",
        "paragraphs": [
            "周极八百里，凝眸望則勞。水涵天影闊，山拔地形高。",
            "賈客停非久，漁翁轉幾遭。颯然风起处，又是鼓波濤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 2
    },
    {
        "title": "贈方幹",
        "author": "可朋",
        "biography": "",
        "paragraphs": [
            "盛名傳出自皇州，一舉參差便縮頭。月裏豈无攀桂分，",
            "独泛短舟何限景，波濤西接洞庭秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 3
    },
    {
        "title": "桐花鳥",
        "author": "可朋",
        "biography": "",
        "paragraphs": [
            "五色毛衣比鳳雛，深花叢裏只如无。",
            "美人買得偏怜惜，移向金釵重幾銖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 4
    },
    {
        "title": "句",
        "author": "可朋",
        "biography": "",
        "paragraphs": [
            "來多不似客，坐久卻垂簾。",
            "虹收千嶂雨，潮展半江天。",
            "诗因試客分題僻，棋為饒人下著低。",
            "傷心盡日有啼鳥，独步残春空落花。",
            "唯陪北楚三千客，多話東林十八賢。",
            "乍當暖景飛仍慢，欲就芳叢舞更高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 5
    },
    {
        "title": "宿鄭諫議山居",
        "author": "曇域",
        "biography": "",
        "paragraphs": [
            "堂開星斗邊，大諫采薇還。禽隱石中樹，月生池上山。",
            "涼风吹詠思，幽语隔禪關。莫擬归城计，終妨此地閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 6
    },
    {
        "title": "懷齊己",
        "author": "曇域",
        "biography": "",
        "paragraphs": [
            "鬢髯秋景两蒼蒼，靜对茅齋一炷香。病后身心俱澹泊，",
            "犹喜深交有支遁，时时音信到松房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 7
    },
    {
        "title": "贈島雲禪師",
        "author": "曇域",
        "biography": "",
        "paragraphs": [
            "遠庵枯葉滿，群鹿亦相隨。頂骨生新發，庭松長舊枝。",
            "禪高太白月，行出祖師碑。乱后潛來此，南人總不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 8
    },
    {
        "title": "垓下懷古",
        "author": "棲一",
        "biography": "",
        "paragraphs": [
            "緬想咸阳事可嗟，楚歌哀怨思无涯。八千子弟归何处，",
            "拔山力盡烏江水，今古悠悠空浪花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 9
    },
    {
        "title": "武昌懷古",
        "author": "棲一",
        "biography": "",
        "paragraphs": [
            "戰國城池盡悄然，昔人遺跡遍山川。笙歌罷吹幾多日，",
            "堪嗟世事如流水，空見蘆花一釣船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 10
    },
    {
        "title": "圣果寺",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "路自中峰上，盤回出薜蘿。到江吳地盡，隔岸越山多。",
            "古木叢青靄，遙天浸白波。下方城郭近，鐘磬雜笙歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 11
    },
    {
        "title": "送僧遊西域",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "一盂兼一錫，只此度流沙。野性雖為客，禪心即是家。",
            "寺披雲嶠雪，路入曉天霞。自说游諸國，回應歲月賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 12
    },
    {
        "title": "遠煙",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "靄靄前山上，凝光滿薜蘿。高风吹不盡，遠樹得偏多。",
            "翠与晴雲合，輕将淑气和。正堪流野目，朱閣意如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 13
    },
    {
        "title": "螢",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "熠熠与娟娟，池塘竹樹邊。乱飛如拽火，成聚卻无煙。",
            "微雨灑不滅，輕风吹欲燃。昔时书案上，频把作囊懸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 14
    },
    {
        "title": "憶廬山舊居",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "粗衣糲食老煙霞，勉把衰顏惜歲華。独鶴只為山客伴，",
            "明月清风舊相得，十年归恨可能賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 15
    },
    {
        "title": "題棲霞寺僧房",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "名山不取買山錢，任構花宮近碧巔。松檜老依雲裏寺，",
            "欲結茅庵共師住，肯饒多少薜蘿煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 16
    },
    {
        "title": "山中作",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "席簾高卷枕高欹，門掩垂蘿蘸碧溪。",
            "閑把史书眠一觉，起來山日過松西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 17
    },
    {
        "title": "織婦",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "蓬鬢蓬門積恨多，夜闌燈下不停梭。",
            "成縑犹自陪錢納，未直青樓一曲歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 18
    },
    {
        "title": "句",
        "author": "处默",
        "biography": "",
        "paragraphs": [
            "太平时節无人看，雪刃閑封滿匣塵。（《劍》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 19
    },
    {
        "title": "秋日闲居",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "是事不相關，谁人似此閑。捲簾當白晝，移榻对青山。",
            "野鶴眠松上，秋苔長雨間。嶽僧频有信，昨日得书還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 20
    },
    {
        "title": "宿岳阳開元寺",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "竟夕凭虛檻，何當興歎频。往來人自老，今古月常新。",
            "风逆沈魚唱，松疏露鶴身。无眠鐘又動，幾客在迷津。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 21
    },
    {
        "title": "送邊将",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "人盡有離別，而君独可嗟。言将身報國，敢望祿榮家。",
            "戰思风吹野，鄉心月照沙。归期定何日，塞北樹无花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 22
    },
    {
        "title": "雪中送人北游",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "然知心去速，其奈雪飛频。莫喜无危道，雖平更陷人。",
            "遠郊光接漢，曠野色通秦。此去迢遙极，卻回應過春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 23
    },
    {
        "title": "落葉",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "雨過闲田地，重重落葉紅。翻思向春日，肯信有秋风。",
            "幾处隨流水，河邊乱暮空。只應松自立，而不与君同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 24
    },
    {
        "title": "落花",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "一片又一片，等闲苔面紅。不能延数日，開亦是春风。",
            "公子歌聲歇，诗人眼界空。遙思故山下，經雨两三叢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 25
    },
    {
        "title": "題田道者院",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "入門空寂寂，真個出家兒。有行鬼不見，无心人謂癡。",
            "古岩寒柏对，流水落花隨。欲別一何懶，相從所恨迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 26
    },
    {
        "title": "東林寺",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "欲去不忍去，徘徊吟繞廊。水光秋澹蕩，僧好语尋常。",
            "碑古苔文疊，山晴鐘韵長。翻思南嶽上，欠此白蓮香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 27
    },
    {
        "title": "寄貫休上人",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "常语亦關诗，常流安得知。楚郊來未久，吳地住多时。",
            "立月无人近，归林有鶴隨。所居渾不遠，相识偶然迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 28
    },
    {
        "title": "喜僧友到",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "十年消息斷，空使夢煙蘿。嵩嶽幾时下，洞庭何日過。",
            "瓶幹離澗久，衲壞臥雲多。意欲相留住，游方肯舍麼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 29
    },
    {
        "title": "懷虛中上人",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "簷雨滴更残，思君安未安。湘川闻不遠，道路去尋難。",
            "吟鬢霜應蝕，禪衣雪漸寒。倚松因独立，一鳥下江幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 30
    },
    {
        "title": "簡寂觀",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "正同高士坐煙霞，思著閑忙又是嗟。碧岫觀中人似鶴，",
            "莫道此間无我分，遺民長在惠持家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 31
    },
    {
        "title": "睡起作",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "長空秋雨歇，睡起觉精神。看水看山坐，无名无利身。",
            "偈吟諸祖意，茶碾去年春。此外谁相识，孤雲到砌频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 32
    },
    {
        "title": "賣松者",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "求利有何限，将松入市來。直饒人買去，也向柳邊栽。",
            "細葉犹粘雪，孤根尚惹苔。知君用心錯，舉世重花開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 33
    },
    {
        "title": "思齊己上人",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "同人与流俗，相謂好襟靈。有口不他说，長年自誦經。",
            "水聲秋后石，山色晚來庭。客问修何法，指松千歲青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 34
    },
    {
        "title": "送玄泰禪師",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "去去去何住，一盂兼一瓶。水邊寒草白，島外晚峰青。",
            "宿处林闻虎，行时天有星。回期谁可定，浮世重看經。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 35
    },
    {
        "title": "三生石",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "圣跡谁會得，每到亦徘徊。一尚不可得，三從何处來。",
            "清宵寒露滴，白晝野雲隈。應是表靈異，凡情安可猜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 36
    },
    {
        "title": "題僧夢微房",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "東海日未出，九衢人已行。吾師无事坐，苔蘚入門生。",
            "雨過閑花落，风來古木聲。天臺频说法，石壁欠題名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 37
    },
    {
        "title": "秋台作",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "独上高樓上，客情何物同。孤雲无定处，長日信秋风。",
            "兄弟多年別，關河此夕中。到頭归去是，免使歎洪蒙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 38
    },
    {
        "title": "懷故園",
        "author": "修睦",
        "biography": "",
        "paragraphs": [
            "故園归未得，此日意何傷。独坐水邊草，水流春日長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 39
    },
    {
        "title": "謝武肅王",
        "author": "无作",
        "biography": "",
        "paragraphs": [
            "雲鶴性孤單，爭堪名利關。銜恩雖入國，辭命卻归山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 40
    },
    {
        "title": "哭僧",
        "author": "清尚",
        "biography": "",
        "paragraphs": [
            "道力自超然，身亡同坐禪。水流元在海，月落不離天。",
            "溪白葬时雪，风香焚处煙。世人频下淚，不見我師玄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 41
    },
    {
        "title": "投謁齊己",
        "author": "幹康",
        "biography": "",
        "paragraphs": [
            "隔岸紅塵忙似火，當軒青嶂冷如冰。",
            "烹茶童子休相问，報導門前是衲僧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 42
    },
    {
        "title": "賦残雪",
        "author": "幹康",
        "biography": "",
        "paragraphs": [
            "六出奇花已住開，郡城相次見樓臺。",
            "时人莫把和泥看，一片飛從天上來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 43
    },
    {
        "title": "句",
        "author": "幹康",
        "biography": "",
        "paragraphs": [
            "鏡湖中有月，处士后无人。荻筍抽高節，鱸魚躍老鱗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十九",
        "no#": 44
    }
]