[
    {
        "title": "杜鵑花",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "杜鵑花与鳥，怨豔两何賒。疑是口中血，滴成枝上花。",
            "一聲寒食夜，数朵野僧家。謝豹出不出，日迟迟又斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 1
    },
    {
        "title": "江上楓",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "江楓自蓊鬱，不競松筠力。一葉落漁家，残阳帶秋色。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 2
    },
    {
        "title": "夜夜曲",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "自從君去夜，錦幌孤蘭麝。欹枕对銀缸，秦箏綠窗下。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 3
    },
    {
        "title": "村行",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "曖曖村煙暮，牧童出深塢。騎牛不顧人，吹笛尋山去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 4
    },
    {
        "title": "煎茶",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "嶽寺春深睡起时，虎跑泉畔思迟迟。",
            "蜀茶倩個雲僧碾，自拾枯松三四枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 5
    },
    {
        "title": "松",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "大夫名價古今闻，盤屈孤貞更出群。",
            "将謂嶺頭閑得了，夕阳犹掛数枝雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 6
    },
    {
        "title": "新燕",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "才離海島宿江濱，應夢笙歌作近鄰。",
            "減省雕梁並頭语，画堂中有未归人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 7
    },
    {
        "title": "會友不至",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "王孫還是負佳期，玉馬追遊日漸西。",
            "独上郊原人不見，鷓鴣飛過落花溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 8
    },
    {
        "title": "惜花",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "忘餐為戀滿枝紅，錦障频移護晚风。",
            "客散酒酣归未得，欄邊独立月明中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 9
    },
    {
        "title": "中秋月",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "王母妝成鏡未收，倚欄人在水精樓。",
            "笙歌莫占清光盡，留与溪翁一釣舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 10
    },
    {
        "title": "暮春日宴溪亭",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "寒食尋芳遊不足，溪亭還醉綠楊煙。",
            "谁家花落臨流樹，数片残紅到檻前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 11
    },
    {
        "title": "曉",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "列宿回元朝北极，爽神晞露滴樓臺。",
            "佳人卷箔臨階砌，笑指庭花昨夜開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 12
    },
    {
        "title": "夕",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "台榭沉沉禁漏初，麝煙紅蠟透蝦須。",
            "雕籠鸚鵡将棲宿，不许鴉鬟轉轆轤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 13
    },
    {
        "title": "露",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "銀河昨夜降醍醐，灑遍坤維万象蘇。",
            "疑是鮫人曾泣处，滿池荷葉捧真珠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 14
    },
    {
        "title": "游紫阳宮",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "古殿煙霞簇画屏，直疑蹤跡到蓬瀛。",
            "碧桃滿地眠花鹿，深院松窗搗药聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 15
    },
    {
        "title": "除夜",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "銅龍看卻送春來，莫惜顛狂酒百杯。",
            "吟鬢就中專擬白，那堪更被二更催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 16
    },
    {
        "title": "元日",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "戴星先捧祝堯觴，鏡裏堪驚两鬢霜。",
            "好是燈前偷失笑，屠蘇應不得先嘗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 17
    },
    {
        "title": "寒夜吟",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "洞房脈脈寒宵永，燭影香消金鳳冷。",
            "猧兒睡魘喚不醒，滿窗撲落銀蟾影。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 18
    },
    {
        "title": "柳枝辭九首",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "輕籠小徑近谁家，玉馬追风翠影斜。",
            "愛把長條惱公子，惹他頭上海棠花。",
            "鵝黃剪出小花鈿，綴上芳枝色轉鮮。",
            "飲散无人收拾得，月明階下伴秋千。",
            "東君愛惜与先春，草澤无人处也新。",
            "委囑露華並細雨，莫教迟日惹风塵。",
            "句踐初迎西子年，琉璃為帚掃溪煙。",
            "至今不改當时色，留与王孫系酒船。",
            "綠楊移傍小亭栽，便擁穠煙撥不開。",
            "谁把金刀為刪掠，放教明月入窗來。",
            "遠接關河高接雲，雨餘洗出半天津。",
            "牡丹不用相輕薄，自有清阴覆得人。",
            "掩映鶯花媚有餘，风流才調比應无。",
            "朝朝奉禦臨池上，不羨青松拜大夫。",
            "王孫宴罷曲江池，折取春光伴醉归。",
            "怪得美人爭鬥乞，要他穠翠染羅衣。",
            "残照林梢嫋数枝，能招醉客上金堤。",
            "馬嬌如練纓如火，瑟瑟阴中步步嘶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 19
    },
    {
        "title": "句",
        "author": "成彥雄",
        "biography": "",
        "paragraphs": [
            "莎草放茵深護砌，海榴噴火巧橫牆。",
            "紋鱗引子跳銀海，紫燕呼雛语画梁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百五十九",
        "no#": 20
    }
]