[
    {
        "title": "僻居謝何明府見訪",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "公退琴堂動逸懷，閑披煙靄訪微才。馬嘶窮巷蛙聲息，",
            "滿齋塵土一床蘚，多謝從容水飯回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 1
    },
    {
        "title": "冬日道中",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "去去天涯无定期，瘦童羸馬共依依。暮煙江口客來絕，",
            "釣台吟閣滄洲在，應為初心未得归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 2
    },
    {
        "title": "僻居酬友人",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "僻居雖愛近林泉，幽徑闲居碧蘚連。向竹掩扉隨鶴息，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 3
    },
    {
        "title": "游西山龍泉禪寺",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "疊巘層峰坐可觀，枕門流水更潺湲。曉鐘聲徹洞溪遠，",
            "因嗟城郭營營事，不得長遊空鬢残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 4
    },
    {
        "title": "宿灊山",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "一入仙山万慮寬，夜深寧厭倚虛欄。鶴和雲影宿高木，",
            "更陪羽客論真理，不觉初鐘叩曉残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 5
    },
    {
        "title": "遊西禪",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "遠岫當軒列翠光，高僧一衲万緣忘。碧松影裏地長潤，",
            "遊人戀此吟終日，盛暑樓臺早有涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 6
    },
    {
        "title": "寄史处士",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "長羨闲居一水湄，吟情高古有谁知。石樓待月橫琴久，",
            "松門別后无消息，早晚重應躡屐隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 7
    },
    {
        "title": "僻居秋思寄友人",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "門巷秋归更寂寥，雨餘閑砌委蘭苗。夢回月夜蟲吟壁，",
            "身名未立犹辛苦，何许流年晚鬢凋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 8
    },
    {
        "title": "寄落星史虛白处士",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "白雲峰下古溪頭，曾与提壺爛熳遊。登閣共看彭蠡水，",
            "別后相思时一望，暮山空碧水空流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 9
    },
    {
        "title": "九江旅夜寄山中故人",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "弱柳风高遠漏沈，坐來難便息愁吟。江城雪盡寒犹在，",
            "此时遙羨閑眠侶，靜掩雲扉臥一林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 10
    },
    {
        "title": "闻杜牧赴闕",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "舊隱匡廬一草堂，今闻攜策謁吾皇。峽雲難卷從龍勢，",
            "他时得意交知仰，莫忘裁诗寄釣鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 11
    },
    {
        "title": "題西林寺水閣",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "竹翠苔花繞檻濃，此亭幽致詎曾逢。水分林下清泠派，",
            "不知來往留題客，谁約重尋蓮社蹤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 12
    },
    {
        "title": "林居喜崔三博遠至",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "幾日區區在遠程，晚煙林徑喜相迎。姿容雖有塵中色，",
            "留連話与方經宿，又欲攜书別我行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 13
    },
    {
        "title": "觀華夷图",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "別手應難及此精，須知攢簇自心靈。始于毫末分諸國，",
            "筆端盡現寰區事，堪把長懸在戶庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 14
    },
    {
        "title": "廬山书堂送祝秀才還鄉",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "束书辭我下重巔，相送同臨楚岸邊。归思幾隨千里水，",
            "莫使蹉跎戀疏野，男兒酬志在當年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 15
    },
    {
        "title": "暮冬送何秀才毗陵",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "匹馬嘶风去思長，素琴孤劍稱戎裝。路塗多是過残歲，",
            "毗陵城下饒嘉景，回日新诗應滿堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 16
    },
    {
        "title": "龍潭张道者",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "碧洞幽岩独息心，时人何路得相尋。養生不说凭諸药，",
            "他年功就期飛去，應笑吾徒多苦吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 17
    },
    {
        "title": "晚秋同何秀才溪上",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "闲步秋光思杳然，荷藜因共過林煙。期收野药尋幽路，",
            "倒尊盡日忘归处，山磬数聲敲暝天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 18
    },
    {
        "title": "送江少府授延陵后寄",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "五老雲中勤學者，遇时能不困风塵。束书西上謁明主，",
            "莫因官小慵之任，自古鸞棲有異人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 19
    },
    {
        "title": "觀山水障子",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "功績精妍世少倫，图时應倍用心神。不知草木承何異，",
            "更疑独泛漁舟者，便是其中舊隱人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 20
    },
    {
        "title": "寄张學士洎",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "不知何处好消憂，公退攜壺即上樓。職事久參侯伯幕，",
            "遙想玉堂多暇日，花时谁伴出城遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 21
    },
    {
        "title": "句",
        "author": "伍喬",
        "biography": "",
        "paragraphs": [
            "積靄沈諸壑，微阳在半峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百四十四",
        "no#": 22
    }
]