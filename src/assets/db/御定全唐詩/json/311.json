[
    {
        "title": "寶劍篇",
        "author": "劉長川",
        "biography": "",
        "paragraphs": [
            "寶劍不可得，相逢幾许難。今朝一度見，赤色照人寒。",
            "匣裏星文動，環邊月影残。自然神鬼伏，无事莫空彈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 1
    },
    {
        "title": "将赴東都上李相公",
        "author": "劉長川",
        "biography": "",
        "paragraphs": [
            "四海兵初偃，平津閣正開。谁知大爐下，還有不然灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 2
    },
    {
        "title": "寄邢逸人",
        "author": "鄭常",
        "biography": "",
        "paragraphs": [
            "羨君无外事，日与世情違。地僻人難到，溪深鳥自飛。",
            "儒衣荷葉老，野飯药苗肥。疇昔江湖意，而今憶共归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 3
    },
    {
        "title": "送頭陀上人赴廬山寺",
        "author": "鄭常",
        "biography": "",
        "paragraphs": [
            "僧家无住著，早晚出東林。得道非真相，頭陀是苦心。",
            "持齋山果熟，倚錫野雲深。溪寺谁相待，香花与梵音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 4
    },
    {
        "title": "謫居漢阳白沙口阻雨，因題驛亭",
        "author": "鄭常",
        "biography": "",
        "paragraphs": [
            "漢阳无遠近，見说過湓城。雲雨經春客，江山幾日程。",
            "終隨鸥鳥去，只待海潮生。前路逢漁父，多慚问姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 5
    },
    {
        "title": "穆陵路",
        "author": "陳存",
        "biography": "",
        "paragraphs": [
            "西遊匣長劍，日暮湘楚間。歇馬上秋草，逢人问故關。",
            "孤村綠塘水，曠野白雲山。方念此中去，何时此路還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 6
    },
    {
        "title": "清溪館作",
        "author": "陳存",
        "biography": "",
        "paragraphs": [
            "指途清溪裏，左右唯深林。雲蔽望鄉处，雨愁為客心。",
            "遇人多物役，聽鳥时幽音。何必滄浪水，庶茲浣塵襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 7
    },
    {
        "title": "寓居武丁館",
        "author": "陳存",
        "biography": "",
        "paragraphs": [
            "暑雨飄已過，涼飆觸幽衿。虛館无喧塵，綠槐多晝阴。",
            "俯視古苔積，仰聆早蟬吟。放卷一長想，閉門千里心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 8
    },
    {
        "title": "楚州贈別周愿侍禦",
        "author": "陳存",
        "biography": "",
        "paragraphs": [
            "漂泊楚水來，舍舟坐高館。途窮在中路，孤征慕前伴。",
            "风雨一留宿，關山去欲懶。淮南木葉飛，夜闻廣陵散。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 9
    },
    {
        "title": "送劉秀才南归",
        "author": "陳存",
        "biography": "",
        "paragraphs": [
            "鳥啼楊柳垂，此別千万里。古路入商山，春风去灞水。",
            "停車落日在，罷酒離人起。蓬戶寄龍沙，送归情詎已。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 10
    },
    {
        "title": "丹阳作",
        "author": "陳存",
        "biography": "",
        "paragraphs": [
            "暫入新豐市，犹闻舊酒香。抱琴沽一醉，盡日臥垂楊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 11
    },
    {
        "title": "早行",
        "author": "王觀",
        "biography": "",
        "paragraphs": [
            "雞唱催人起，又生前去愁。路明残月在，山露宿雲收。",
            "村店煙火動，漁家燈燭幽。趨名与趨利，行役幾时休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 12
    },
    {
        "title": "贈營妓",
        "author": "崔瓘",
        "biography": "",
        "paragraphs": [
            "寒簷寂寂雨霏霏，候館蕭條燭燼微。",
            "只有今宵同此宴，翠娥佯醉欲先归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 13
    },
    {
        "title": "酒席賦得匏瓢",
        "author": "鄭審",
        "biography": "",
        "paragraphs": [
            "華閣与賢開，仙瓢自遠來。幽林嘗伴许，陋巷亦隨回。",
            "掛影怜紅壁，傾心向綠杯。何曾斟酌处，不使玉山頹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 14
    },
    {
        "title": "奉使巡檢两京路種果樹事畢入秦因詠",
        "author": "鄭審",
        "biography": "",
        "paragraphs": [
            "圣德周天壤，韶華滿帝畿。九重承渙汗，千里樹芳菲。",
            "陝塞餘阴薄，關河舊色微。發生和气動，封植眾心归。",
            "春露條應弱，秋霜果定肥。影移行子蓋，香撲使臣衣。",
            "入徑迷馳道，分行接禁闈。何當扈仙蹕，攀折奉恩輝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 15
    },
    {
        "title": "丹阳作",
        "author": "朱彬",
        "biography": "",
        "paragraphs": [
            "暫入新豐市，犹闻舊酒香。抱琴沽一醉，盡日臥垂楊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 16
    },
    {
        "title": "采桑",
        "author": "李彥遠",
        "biography": "",
        "paragraphs": [
            "采桑畏日高，不待春眠足。攀條有餘態，那矜貌如玉。",
            "千金豈不贈，五馬空躑躅。何以變真性，幽篁雪中綠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 17
    },
    {
        "title": "章仇公席上詠真珠姬",
        "author": "范元凱",
        "biography": "",
        "paragraphs": [
            "神女初離碧玉階，彤雲犹擁牡丹鞋。",
            "應知子建怜羅襪，顧步裴回拾翠釵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十一",
        "no#": 18
    }
]