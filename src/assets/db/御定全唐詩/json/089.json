[
    {
        "title": "奉和圣制潼關口號應制",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "天德平无外，關門東複西。不将千里隔，何用一丸泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 1
    },
    {
        "title": "奉蕭令嵩酒並诗",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "樂奏天恩滿，杯來秋興高。更蒙蕭相國，对席飲醇醪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 2
    },
    {
        "title": "奉宇文黃門融酒",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "圣德垂甘露，天章下大风。又乘黃閣賞，愿作黑頭公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 3
    },
    {
        "title": "奉裴中书光庭酒",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "西掖恩華降，南宮命席闌。詎知雞樹后，更接鳳池歡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 4
    },
    {
        "title": "清夜酌",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "秋阴士多感，雨息夜无塵。清樽宜明月，複有平生人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 5
    },
    {
        "title": "醉中作",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "醉后樂无极，彌勝未醉时。動容皆是舞，出语總成诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 6
    },
    {
        "title": "送梁知微渡海東",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "今日此相送，明年此相待。天上客星回，知君渡東海。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 7
    },
    {
        "title": "寄劉道士舄",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "真人降紫气，邀我丹田宮。遠寄雙飛舄，飛飛不礙空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 8
    },
    {
        "title": "书香能和尚塔",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "大師捐世去，空餘法力在。遠寄无礙香，心隨到南海。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 9
    },
    {
        "title": "被使在蜀",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "即今三伏盡，尚自在臨邛。归途千裏外，秋月定相逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 10
    },
    {
        "title": "正朝摘梅",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "蜀地寒犹暖，正朝發早梅。偏驚万里客，已複一年來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 11
    },
    {
        "title": "蜀道后期",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "客心爭日月，來往預期程。秋风不相待，先至洛阳城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 12
    },
    {
        "title": "廣州江中作",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "去國年方晏，愁心轉不堪。離人与江水，終日向西南。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 13
    },
    {
        "title": "江中誦經",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "實相归懸解，虛心暗在通。澄江明月內，應是色成空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 14
    },
    {
        "title": "江中遇黃領子劉隆",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "危石江中起，孤雲嶺上還。相逢皆得意，何处是鄉關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 15
    },
    {
        "title": "欽州守歲",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "故歲今宵盡，新年明旦來。愁心隨斗柄，東北望春回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 16
    },
    {
        "title": "嶽州守歲二首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "夜风吹醉舞，庭戶对酣歌。愁逐前年少，歡迎今歲多。",
            "桃枝堪辟惡，爆竹好驚眠。歌舞留今夕，犹言惜舊年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 17
    },
    {
        "title": "元朝",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "今歲元日樂，不謝往年春。知向來心道，谁為昨夜人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 18
    },
    {
        "title": "耗磨日飲二首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "耗磨傳茲日，縱橫道未宜。但令不忌醉，翻是樂无為。",
            "上月今朝減，流傳耗磨辰。還将不事事，同醉俗中人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 19
    },
    {
        "title": "又",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "春來半月度，俗忌一时閑。不酌他鄉酒，惟堪对楚山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 20
    },
    {
        "title": "九日進茱萸山诗五首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "家居洛阳下，舉目見嵩山。刻作茱萸節，情生造化間。",
            "黃花宜泛酒，青岳好登高。稽首明廷內，心為天下勞。",
            "菊酒攜山客，萸囊系牧童。路疑隨大隗，心似问鴻蒙。",
            "九日重阳数，三秋万實成。时來謁軒后，罷去坐蓬瀛。",
            "晚節歡重九，高山上五千。醉中知遇圣，夢裏見尋仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 21
    },
    {
        "title": "岳州看黃葉",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "白首看黃葉，徂顏複幾何。空慚棠樹下，不見政成歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 22
    },
    {
        "title": "嶺南送使二首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "獄中生白发，嶺外罷紅顏。古來相送处，凡得幾人還。",
            "万里投荒裔，來时不見親。一朝成白首，看取報家人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 23
    },
    {
        "title": "傷妓人董氏四首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "董氏嬌嬈性，多為窈窕名。人隨秋月落，韵入擣衣聲。",
            "粉蕊粘妝簏，金花竭翠條。夜台无戲伴，魂影向谁嬌。",
            "舊亭紅粉閣，宿处白雲關。春日雙飛去，秋风独不還。",
            "舞席沾残粉，歌梁委舊塵。独傷窗裏月，不見帳中人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 24
    },
    {
        "title": "三月閨怨",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "三月时将盡，空房妾独居。蛾眉愁自結，鬢发沒情梳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 25
    },
    {
        "title": "破陳樂詞二首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "漢兵出頓金微，照日光明鐵衣。百里火幡焰焰，",
            "正屬四方朝賀，端知万舞皇威。",
            "少年膽气淩雲，共许驍雄出群。匹馬城西挑戰，",
            "誓欲成名報國，羞将開閣論勳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 26
    },
    {
        "title": "舞馬詞六首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "万玉朝宗鳳扆，千金率領龍媒。眄鼓凝驕躞蹀，",
            "天鹿遙征衛叔，日龍上借羲和。将共两驂爭舞，",
            "彩旄八佾成行，时龍五色因方。屈膝銜杯赴節，",
            "帝皂龍駒沛艾，星蘭驥子權奇。騰倚驤洋應節，",
            "二圣先天合德，群靈率土可封。擊石驂驔紫燕，",
            "圣君出震應籙，神馬浮河獻图。足踏天庭鼓舞，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 27
    },
    {
        "title": "奉和三日祓禊渭濱應制",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "青郊上巳豔阳年，紫禁皇遊祓渭川。",
            "幸得歡娛承湛露，心同草樹樂春天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 28
    },
    {
        "title": "桃花園馬上應制",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "林間豔色驕天馬，苑裏穠華伴麗人。",
            "愿逐南风飛帝席，年年含笑舞青春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 29
    },
    {
        "title": "奉和圣制幸韋嗣立山莊應制",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "西京上相出扶阳，東郊別业好池塘。",
            "自非仁智符天賞，安能日月共回光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 30
    },
    {
        "title": "奉和圣制同玉真公主游大哥山池題石壁",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "池如明鏡月華開，山學香爐雲气來。",
            "神藻飛為鶺鴒賦，仙聲颺出鳳凰台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 31
    },
    {
        "title": "十五日夜御前口號踏歌詞二首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "花萼樓前雨露新，長安城裏太平人。",
            "龍銜火樹千重焰，雞踏蓮花万歲春。",
            "帝宮三五戲春台，行雨流风莫妒來。",
            "西域燈輪千影合，東華金闕万重開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 32
    },
    {
        "title": "蘇摩遮五首",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "摩遮本出海西胡，琉璃寶服紫髯胡。",
            "闻道皇恩遍宇宙，來将歌舞助歡娛。",
            "繡裝帕額寶花冠，夷歌騎舞借人看。",
            "自能激水成阴气，不慮今年寒不寒。",
            "臘月凝阴積帝台，豪歌急鼓送寒來。",
            "油囊取得天河水，将添上壽万年杯。",
            "寒气宜人最可怜，故将寒水散庭前。",
            "惟愿圣君无限壽，長取新年续舊年。",
            "昭成皇后帝家親，榮樂諸人不比倫。",
            "往日霜前花委地，今年雪后樹逢春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 33
    },
    {
        "title": "三月三日定昆池奉和蕭令得潭字韵",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "暮春三月日重三，春水桃花滿禊潭。",
            "廣樂逶迤天上下，仙舟搖衍鏡中酣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 34
    },
    {
        "title": "和尹從事懋泛洞庭",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "平湖一望上連天，林景千尋下洞泉。",
            "忽驚水上光華滿，疑是乘舟到日邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 35
    },
    {
        "title": "送梁六自洞庭山作",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "巴陵一望洞庭秋，日見孤峰水上浮。",
            "闻道神仙不可接，心隨湖水共悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 36
    },
    {
        "title": "同趙侍禦望归舟",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "山庭迥迥面長川，江樹重重极遠煙。",
            "形影相追高翥鳥，心腸並斷北风船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 37
    },
    {
        "title": "襄阳路逢寒食",
        "author": "张说",
        "biography": "",
        "paragraphs": [
            "去年寒食洞庭波，今年寒食襄阳路。",
            "不辭著处尋山水，只畏還家落春暮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八十九",
        "no#": 38
    }
]