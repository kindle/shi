[
    {
        "title": "九江送方幹归鏡湖",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "一檣懸五两，此日動归风。客路拋湓口，家林入鏡中。",
            "譚餘雲出嶠，詠苦月欹空。更若看鳷鵲，何人夜坐同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 1
    },
    {
        "title": "廬山訪賈匡",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "西城疾病日，此地少尋君。古跡春犹在，遙泉夜盡闻。",
            "片时三處雨，九疊幾重雲。到者皆忘寐，神精与俗分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 2
    },
    {
        "title": "顧少府池上",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "池上分行種，公庭覺少塵。根離潮水岸，韵爽判曹人。",
            "正午回魚影，方昏息鹭身。无时不動詠，滄島思方频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 3
    },
    {
        "title": "喜友人归上元別业",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "一檣千裏外，隱者興宜孤。落日長邊海，秋风滿故都。",
            "掩關苔色老，盤徑葉聲枯。匡岳來时過，迟回絕頂无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 4
    },
    {
        "title": "曲江暮春雪霽",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "霽動江池色，春残一去遊。菰风生馬足，槐雪滴人頭。",
            "北闕塵未起，南山青欲流。如何多別地，卻得醉汀洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 5
    },
    {
        "title": "立春日",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "春飲一杯酒，便吟春日诗。木梢寒未覺，地脈暖先知。",
            "鳥囀星沈後，山分雪薄时。賞心无處说，悵望曲江池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 6
    },
    {
        "title": "宿溪僧院",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "少年雲溪裏，禪心夜更閑。煎茶留靜者，靠月坐蒼山。",
            "露白鐘尋定，螢多戶未關。嵩阳大石室，何日譯經還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 7
    },
    {
        "title": "石頭懷古",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "日月出又沒，台城空白雲。雖寬百姓土，漸缺六朝墳。",
            "禾黍是亡國，山河归聖君。松聲驟雨足，幾寺晚鐘闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 8
    },
    {
        "title": "浙右贈陸處士",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "靜節灌園餘，得非成隱居。長當庚子日，独拜五經书。",
            "白浪吹亡國，秋霜洗大虛。門前是京口，身外不營儲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 9
    },
    {
        "title": "哭胡處士",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "丘中久不起，将謂詔书來。及見淩雲说，方知掩夜台。",
            "白衣归北路，玄造亦遺才。世上亡君後，诗聲更大哉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 10
    },
    {
        "title": "贈餘幹袁明府",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "一雨西城色，陶家心自清。山銜中郭分，雲卷下湖程。",
            "公署闻流木，人煙入廢城。難忘楚盡處，新有越吟生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 11
    },
    {
        "title": "贈雷鄉张明府",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "任官征戰後，度日寄閑身。封卷還高客，飛书问野人。",
            "廢田教種谷，生路遣尋薪。若起柴桑興，无先漉酒巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 12
    },
    {
        "title": "岳阳晚泊",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "輕帆下闊流，便泊此沙洲。湖影撼山朵，日阳燒野愁。",
            "白波爭起倒，青嶼或沈浮。是際船中望，東南仞仞秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 13
    },
    {
        "title": "覽春榜喜孫鄠成名",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "門外報春榜，喜君天子知。舊愁渾似雪，見日總消时。",
            "塔下牡丹氣，江頭楊柳絲。风光若有分，无處不相宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 14
    },
    {
        "title": "己亥歲二首",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "澤國江山入戰圖，生民何计樂樵蘇。",
            "凭君莫話封侯事，一将功成万骨枯。",
            "傳闻一戰百神愁，两岸強兵過未休。",
            "谁道滄江總无事，近來長共血爭流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 15
    },
    {
        "title": "乱後入洪州西山",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "寂寂阴溪水漱苔，塵中将得苦吟來。",
            "東峰道士如相问，縣令而今不姓梅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 16
    },
    {
        "title": "送僧入廬山",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "若到江州二林寺，遍游應未出雲霞。",
            "廬山瀑布三千仞，画破青霄始落斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 17
    },
    {
        "title": "送僧入蜀過夏",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "師言結夏入巴峰，雲水回頭幾万重。",
            "五月峨眉須近火，木皮領重只如冬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 18
    },
    {
        "title": "江西逢僧省文",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "閩地高僧楚地逢，僧遊蠻錫掛垂松。",
            "白雲逸性都无定，才出雙峰愛五峰。",
            "高僧不負雪峰期，卻伴青霞入翠微。百葉岩前霜欲降，",
            "想得白蓮花上月，滿山犹帶舊光輝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 19
    },
    {
        "title": "水精念珠",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "等量紅縷貫晶熒，盡道勻圓別未勝。鑿斷玉潭盈尺水，",
            "幾度夜深尋不著，琉璃為殿月為燈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 20
    },
    {
        "title": "南海旅次",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "憶归休上越王台，归思臨高不易裁。為客正當无雁處，",
            "心似百花開未得，年年爭發被春催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 21
    },
    {
        "title": "春草",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "不独滿池塘，夢中佳句香。春风有餘力，引上古城牆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 22
    },
    {
        "title": "金谷園",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "當年歌舞时，不说草離離。今日歌舞盡，滿園秋露垂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 23
    },
    {
        "title": "夏日東齋",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "三庚到秋伏，偶來松檻立。熱少清风多，開門放山入。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 24
    },
    {
        "title": "南朝",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "三籬蓋馳道，风烈一无取。时見牧牛童，嗔牛吃禾黍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 25
    },
    {
        "title": "言懷",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "出山不得意，謁帝值戈鋋。豈料為文日，翻成用武年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 26
    },
    {
        "title": "寒食日題杜鵑花",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "一朵又一朵，並開寒食时。谁家不禁火，總在此花枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 27
    },
    {
        "title": "鐘陵寒食日郊外闲遊",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "可怜时節足风情，杏子粥香如冷餳。",
            "无奈春风輸舊火，遍教人喚作山櫻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 28
    },
    {
        "title": "中秋對月",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "无雲世界秋三五，共看蟾盤上海涯。",
            "直到天頭天盡處，不曾私照一人家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 29
    },
    {
        "title": "陪湖南李中丞宴隱溪",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "竹林啼鳥不知休，羅列飛橋水乱流。觸散柳絲回玉勒，",
            "若值主人嫌晝短，應陪秉燭夜深遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 30
    },
    {
        "title": "別湖上主人",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "門系釣舟雲滿岸，借君幽致坐移旬。湖村夜叫白蕪雁，",
            "不辭更住醒還醉，太一東峰归夢频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 31
    },
    {
        "title": "贈廣宣大師",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "憶昔同遊紫閣雲，別來三十二回春。",
            "白頭相見雙林下，犹是清朝未退人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 32
    },
    {
        "title": "鐘陵寒食日与同年裴顏李先輩、鄭校书郊外闲遊",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "寒節鐘陵香騎隨，同年相命楚江湄。雲間影過秋千女，",
            "銀瓶冷酒皆傾盡，半臥垂楊自不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 33
    },
    {
        "title": "江外除夜",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "千門庭燎照樓臺，總為年光急急催。半夜臘因风卷去，",
            "不是多岐漸平穩，谁能呼酒祝昭回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 34
    },
    {
        "title": "七夕",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "牛女相期七夕秋，相逢俱喜鵲橫流。彤雲縹緲回金輅，",
            "更残便是分襟處，曉箭東來射翠樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 35
    },
    {
        "title": "羅浮山下书逸人壁",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "海上亭臺山下煙，買时幽邃不爭錢。莫言白日催華发，",
            "可中更踐无人境，知是羅浮第幾天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 36
    },
    {
        "title": "天臺瀑布",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "万仞得名雲瀑布，遠看如織掛天臺。休疑寶尺難量度，",
            "欲知便是銀河水，墮落人間合卻回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 37
    },
    {
        "title": "桂江",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "未识佳人尋桂水，水雲先解傍壺觴。筍林次第添斑竹，",
            "如飛似墮皆青壁，画手不強元化強。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 38
    },
    {
        "title": "南海",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "傾騰界漢沃諸蠻，立望何如画此看。无地不同方覺遠，",
            "万狀千形皆得意，長鯨独自轉身難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 39
    },
    {
        "title": "洞庭湖",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "東西南北各連空，波上唯留小朵峰。長与岳阳翻鼓角，",
            "直到劫餘還作陸，是时應有羽人逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 40
    },
    {
        "title": "霍山",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "七千七百七十丈，丈丈藤蘿勢入天。未必展來空似翅，",
            "直是画工須閣筆，況无名画可流傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 41
    },
    {
        "title": "巫峽",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "巫山蒼翠峽通津，下有仙宮楚女真。不逐彩雲归碧落，",
            "應是荊山留不住，至今犹得睹芳塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 42
    },
    {
        "title": "送陳樵校书归泉州",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "巨塔列名題，诗心亦罕齊。除官京下闕，乞假海門西。",
            "別席侵残漏，归程避戰鼙。關遙秦雁斷，家近瘴雲低。",
            "候馬春风館，迎船曉月溪。帝京須早入，莫被刺桐迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 43
    },
    {
        "title": "贈鏡湖處士方幹二首",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "包含教化剩搜羅，句出東甌奈峭何。世路不妨平處少，",
            "後輩難為措机杼，先生織字得龍梭。",
            "只擬應星眠越絕，唯将麗什當高勳。磨礱清濁人難會，",
            "他时莫為三征起，門外沙鸥解笑君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 44
    },
    {
        "title": "拜訪陸處士",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "万卷书邊人半白，再來惟恐降玄纁。性靈比鶴爭多少，",
            "将知谷口耕煙者，低視齊梁楚趙君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 45
    },
    {
        "title": "嶺南道中",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "百花成實未成归，未必归心与志違。但有壺觴資逸詠，",
            "遊子馬前芳草合，鷓鴣啼歇又南飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 46
    },
    {
        "title": "春日自吳門之阳羨道中书事",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "勝異恣游應未遍，路岐犹去幾时還。浪花湖闊虹蜺斷，",
            "眼前便是神仙事，何必須言洞府間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 47
    },
    {
        "title": "将入關行次湘阴",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "背顧秦城在何處，圖书作伴過湘東。神鴉乱噪黃陵近，",
            "也知漸老岩棲穩，爭奈文闈有至公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 48
    },
    {
        "title": "題昭州山寺常寂上人水閣",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "常寂常居常寂裏，年年月月是空空。階前未放岩根斷，",
            "他时憶著堪圖画，一朵雲山二水中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 49
    },
    {
        "title": "廣州貽匡緒法師",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "口宣微密不思議，不是除貪即誡癡。只待外方緣了日，",
            "必竟懶過高坐寺，未能全讓法雲師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 50
    },
    {
        "title": "贈道人",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "住山因以福為庭，便向山中隱姓名。閬苑駕将雕羽去，",
            "顧我從來斷浮濁，擬驅雞犬上三清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 51
    },
    {
        "title": "送乞雨禪師臨遇南游",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "活得枯樵耕者知，巡方又欲向天涯。珠穿閩國菩提子，",
            "生緣在地南浮去，自此孤雲不可期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 52
    },
    {
        "title": "南海陪鄭司空遊荔園",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "荔枝时節出旌斿，南國名園盡興遊。乱結羅紋照襟袖，",
            "他日為霖不将去，也須圖画取风流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 53
    },
    {
        "title": "李郎中林亭",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "只向砌邊流野水，樽前上下看魚兒。筍蹊已長過人竹，",
            "大才必擬逍遙去，更遣何人佐盛时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 54
    },
    {
        "title": "夜飲",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "良宵公子宴蘭堂，濃麝熏人獸吐香。雲帶金龍銜画燭，",
            "席上未知簾幕曉，青娥低语指東方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 55
    },
    {
        "title": "駙馬宅宴罷",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "粉牆残月照宮祠，宴闋銀瓶一半欹。",
            "學语鶯兒飛未穩，放身斜墜綠楊枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 56
    },
    {
        "title": "吊建州李員外",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "銘旌归故里，猿鳥亦淒然。已葬桐江月，空回建水船。",
            "客傳為郡日，僧说讀书年。恐有吟魂在，深山古木邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 57
    },
    {
        "title": "吊李翰林",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "李白雖然成異物，逸名犹与万方傳。昔朝曾侍玄宗側，",
            "投金渚畔春楊柳，自此何人系酒船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 58
    },
    {
        "title": "山中",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "要路豪家非往還，岩門先有不曾關。眾心惟恐地无剩，",
            "樵夫豈解營生业，貴欲自安麋鹿間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 59
    },
    {
        "title": "山寺引泉",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "劈碎琅玕意有餘，細泉高引入香廚。",
            "山僧未肯言根本，莫是銀河漏泄无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 60
    },
    {
        "title": "友人池上詠蘆",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "秋聲谁種得，蕭瑟在池欄。葉澀棲蟬穩，叢疏宿鹭難。",
            "斂煙宜下□，颯吹省先寒。此物生蒼島，令人憶釣竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 61
    },
    {
        "title": "商山",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "垂白商于原下住，兒孫共死一身忙。",
            "木弓未得長離手，犹与官家射麝香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 62
    },
    {
        "title": "荊南道中",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "十月荒郊雪氣催，依稀愁色認阳臺。游秦分系三條燭，",
            "如何住在猿聲裏，卻被蟬吟引下來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 63
    },
    {
        "title": "武德殿朝退望九衢春色",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "玉殿朝初退，天街一看春。南山初過雨，北闕淨无塵。",
            "夾道夭桃滿，連溝禦柳新。蘇舒同舜澤，煦嫗並堯仁。",
            "佳氣浮軒蓋，和风襲縉紳。自茲怜万物，同入發生辰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 64
    },
    {
        "title": "吊北邙",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "山下望山上，夕阳看又曛。无人醫白发，少地著新墳。",
            "歲代殊相遠，賢愚旋不分。東归聊一吊，乱木倚寒雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 65
    },
    {
        "title": "及第敕下，宴中獻座主杜侍郎",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "得召丘牆淚卻频，若无公道也无因。門前送敕朱衣吏，",
            "南山雖有归溪路，爭那酬恩未殺身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 66
    },
    {
        "title": "梢雲",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "殊質資靈貺，陵空發瑞雲。梢梢含樹影，鬱鬱動霞文。",
            "不比因风起，全非觸石分。葉光閑泛灩，枝彩靜氛氳。",
            "隱見心无宰，裴回慶自君。翻飛如可托，長愿在橫汾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 67
    },
    {
        "title": "白角簟",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "角簟工夫已到頭，夏來全占滿床秋。若言保惜归華屋，",
            "蒲桃錦是瀟湘底，曾得王孫價倍酬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 68
    },
    {
        "title": "碧角簟",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "細皮重疊織霜紋，滑膩鋪床勝錦茵。八尺碧天无點翳，",
            "五月不教炎氣入，滿堂秋色冷龍鱗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 69
    },
    {
        "title": "滕王閣春日晚望",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "淩春帝子閣，偶眺日移西。浪勢平花塢，帆阴上柳堤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 70
    },
    {
        "title": "句",
        "author": "曹松",
        "biography": "",
        "paragraphs": [
            "追遊若遇三清樂，行從應妨一日春。（李肇《國史補》",
            "雲：曲江大會，先牒教坊，請奏上禦紫雲樓觀焉。",
            "时或擬作樂，則為之移日，故曹松诗云云）",
            "石脈水流泉滴沙，鬼燈然點松柏花。",
            "鹿眠荒圃寒蕪白，鴉噪残阳敗葉飛。",
            "華嶽影寒清露掌，海門风急白潮頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百一十七",
        "no#": 71
    }
]