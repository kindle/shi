[
    {
        "title": "百子池",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "舊闻百子漢家池，漢家淥水今逶迤。宮女厭鏡笑窺池，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 1
    },
    {
        "title": "東封山下宴群臣",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "万里扈封巒，群公遇此歡。幔城連夜靜，霜仗滿空寒。",
            "輦路宵煙合，旌門曉月残。明朝陪圣主，山下禮圓壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 2
    },
    {
        "title": "三日岐王宅",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "玉女貴妃生，嫛婗始發聲。金盆浴未了，繃子繡初成。",
            "翡翠雕芳縟，真珠帖小纓。何时學健步，鬥取落花輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 3
    },
    {
        "title": "滿月",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "社金流茂祉，庭玉表奇才。竹似因談植，蘭疑入夢栽。",
            "烏将八子去，鳳逐九雛來。今夜明珠色，當隨滿月開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 4
    },
    {
        "title": "岐王山亭",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "王家傍綠池，春色正相宜。豈有樓臺好，兼看草樹奇。",
            "石榴天上葉，椰子日南枝。出入千門裏，年年樂未移。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 5
    },
    {
        "title": "岐王席上詠美人",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "半額画雙蛾，盈盈燭下歌。玉杯寒意少，金屋夜情多。",
            "香豔王分帖，裙嬌敕賜羅。平阳莫相妒，喚出不如他。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 6
    },
    {
        "title": "還京",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "朱紱臨秦望，皇華赴洛橋。文章南渡越，书奏北归朝。",
            "樹入江雲盡，城銜海月遙。秋风将客思，川上晚蕭蕭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 7
    },
    {
        "title": "贈吏部孫員外濟",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "天子愛賢才，星郎入拜來。明光朝半下，建禮直初回。",
            "名帶含香發，文隨綺幕開。披雲自有鏡，從此照仙台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 8
    },
    {
        "title": "送李著作倅杭州",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "輟史空三署，題輿佐一方。祖筵開霽景，征陌直朝光。",
            "水陸风煙隔，秦吳道路長。佇闻敷善政，邦國詠惟康。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 9
    },
    {
        "title": "九日",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "秋來林下不知春，一種佳遊事也均。絳葉從朝飛著夜，",
            "城遠登高並九日，茱萸凡作幾年新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 10
    },
    {
        "title": "延平門高齋亭子應岐王教",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "花源药嶼鳳城西，翠幕紗窗鶯乱啼。昨夜蒲萄初上架，",
            "請语東风催后騎，並将歌舞向前溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 11
    },
    {
        "title": "九日宴",
        "author": "张諤",
        "biography": "",
        "paragraphs": [
            "秋葉风吹黃颯颯，晴雲日照白鱗鱗。",
            "归來得问茱萸女，今日登高醉幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 12
    },
    {
        "title": "從军",
        "author": "劉庭琦",
        "biography": "",
        "paragraphs": [
            "朔风吹寒塞，胡沙千万里。陳雲出岱山，孤月生海水。",
            "決勝方求敵，銜恩本輕死。蕭蕭牧馬鳴，中夜拔劍起。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 13
    },
    {
        "title": "奉和圣制瑞雪篇",
        "author": "劉庭琦",
        "biography": "",
        "paragraphs": [
            "紫宸飛雪曉裴回，層閣重門雪照開。九衢皛耀浮埃盡，",
            "埋雲翳景无窮已，因风落地吹還起。先過翡翠寶房中，",
            "羅衣點著渾是花，玉手摶來半成水。奕奕紛紛何所如，",
            "姑射山中符圣壽，芙蓉闕下降神車。愿隨睿澤流无限，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 14
    },
    {
        "title": "詠木槿樹題武進文明府廳",
        "author": "劉庭琦",
        "biography": "",
        "paragraphs": [
            "物情良可見，人事不勝悲。莫恃朝榮好，君看暮落时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 15
    },
    {
        "title": "銅雀台",
        "author": "劉庭琦",
        "biography": "",
        "paragraphs": [
            "銅台宮觀委灰塵，魏主園林漳水濱。",
            "即今西望犹堪思，況複當时歌舞人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 16
    },
    {
        "title": "失白鷹",
        "author": "鄭繇",
        "biography": "",
        "paragraphs": [
            "白錦文章乱，丹霄羽翮齊。雲中呼暫下，雪裏放還迷。",
            "梁苑驚池鶩，陳倉拂野雞。不知寥廓外，何处独依棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 17
    },
    {
        "title": "經慈澗題",
        "author": "鄭繇",
        "biography": "",
        "paragraphs": [
            "岸与恩同廣，波将慈共深。涓涓勞日夜，長似下流心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百一十",
        "no#": 18
    }
]