[
    {
        "title": "新妝诗",
        "author": "楊容華",
        "biography": "",
        "paragraphs": [
            "啼鳥驚眠罷，房櫳乘曉開。鳳釵金作縷，鸞鏡玉為台。",
            "妝似臨池出，人疑向月來。自怜終不見，欲去複裴回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 1
    },
    {
        "title": "贈外",
        "author": "魏氏",
        "biography": "",
        "paragraphs": [
            "浮萍依綠水，弱蔦寄青松。与君結大義，移天得所從。",
            "翰林无雙鳥，劍水不分龍。諧和類琴瑟，堅固同膠漆。",
            "義重恩欲深，夷險貴如一。本自身不令，積多嬰痛疾。",
            "朝夕倦床枕，形體恥巾櫛。遊子倦风塵，從官初解巾。",
            "束裝赴南郢，脂駕出西秦。比翼終難遂，銜雌苦未因。",
            "徒悲楓岸遠，空对柳園春。男兒不重舊，丈夫多好新。",
            "新人喜新聘，朝朝臨粉鏡。两鴛固无比，雙蛾谁与競。",
            "詎怜愁思人，銜啼嗟薄命。蕣華不足恃，松枝有餘勁。",
            "所愿好九思，勿令虧百行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 2
    },
    {
        "title": "詠破簾",
        "author": "喬氏",
        "biography": "",
        "paragraphs": [
            "已漏风聲罷，繩持也不禁。一從經落后，无複有貞心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 3
    },
    {
        "title": "送兄",
        "author": "七歲女子",
        "biography": "",
        "paragraphs": [
            "別路雲初起，離亭葉正飛。所嗟人異雁，不作一行归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 4
    },
    {
        "title": "送男左貶诗",
        "author": "林氏",
        "biography": "",
        "paragraphs": [
            "他日初投杼，勤王在飲冰。有辭期不罰，積毀竟相仍。",
            "謫宦今何在，銜冤犹未勝。天涯分越徼，驛騎速毗陵。",
            "腸斷腹非苦，书傳写豈能。淚添江水遠，心劇海雲蒸。",
            "明月珠難识，甘泉賦可稱。但将忠報主，何懼點青蠅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 5
    },
    {
        "title": "古興",
        "author": "趙氏1",
        "biography": "",
        "paragraphs": [
            "郁蒸夏将半，暑气扇飛閣。驟雨滿空來，當軒卷羅幕。",
            "度雲開夕霽，宇宙何清廓。明月流素光，輕风换炎鑠。",
            "孤鸞傷对影，寶瑟悲別鶴。君子去不還，遙心欲何托。",
            "金菊延清霜，玉壺多美酒。良人犹不归，芳菲豈常有。",
            "不惜芳菲歇，但傷別離久。含情罷斟酌，凝怨对窗牖。",
            "霽雪舒長野，寒雲半幽谷。嚴风振枯條，猿啼抱冰木。",
            "所嗟遊宦子，少小荷天祿。前程未雲至，悽愴对車僕。",
            "歲寒成詠歌，日暮棲林樸。不憚行險道，空悲年运促。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 6
    },
    {
        "title": "寄夫",
        "author": "郭紹蘭",
        "biography": "",
        "paragraphs": [
            "我婿去重湖，臨窗泣血书。殷勤凭燕翼，寄与薄情夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 7
    },
    {
        "title": "同夫游秦",
        "author": "王韞秀",
        "biography": "",
        "paragraphs": [
            "路掃饑寒跡，天哀志气人。休零離別淚，攜手入西秦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 8
    },
    {
        "title": "夫入相寄姨妹",
        "author": "王韞秀",
        "biography": "",
        "paragraphs": [
            "相國已隨麟閣貴，家风第一右丞诗。",
            "笄年解笑鳴机婦，恥見蘇秦富貴时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 9
    },
    {
        "title": "喻夫阻客",
        "author": "王韞秀",
        "biography": "",
        "paragraphs": [
            "楚竹燕歌動画梁，春蘭重换舞衣裳。",
            "公孫開閣招嘉客，知道浮榮不久長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 10
    },
    {
        "title": "古意",
        "author": "张夫人",
        "biography": "",
        "paragraphs": [
            "轆轤曉轉素絲綆，桐聲夜落蒼苔磚。涓涓吹溜若时雨，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 11
    },
    {
        "title": "拜新月",
        "author": "张夫人",
        "biography": "",
        "paragraphs": [
            "拜新月，拜月出堂前。暗魄初籠桂，虛弓未引弦。拜新月，",
            "東家阿母亦拜月，一拜一悲聲斷絕。昔年拜月逞容輝，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 12
    },
    {
        "title": "柳絮",
        "author": "张夫人",
        "biography": "",
        "paragraphs": [
            "靄靄芳春朝，雪絮起青條。或值花同舞，不因风自飄。",
            "過尊浮綠醑，拂幌綴紅綃。那用持愁玩，春懷不自聊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 13
    },
    {
        "title": "拾得韋氏花鈿以诗寄贈",
        "author": "张夫人",
        "biography": "",
        "paragraphs": [
            "今朝妝閣前，拾得舊花鈿。粉污痕犹在，塵侵色尚鮮。",
            "曾經纖手裏，拈向翠眉邊。能助千金笑，如何忍棄捐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 14
    },
    {
        "title": "誚喜鵲",
        "author": "张夫人",
        "biography": "",
        "paragraphs": [
            "疇昔鴛鴦侶，朱門賀客多。如今无此事，好去莫相過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 15
    },
    {
        "title": "句",
        "author": "张夫人",
        "biography": "",
        "paragraphs": [
            "游蜂乍起驚落墀，黃鳥銜來卻上枝。",
            "臨风重回首，掩淚向庭花。",
            "鏡中春色老，枕前秋夜長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 16
    },
    {
        "title": "书石壁",
        "author": "王氏",
        "biography": "",
        "paragraphs": [
            "何事潘郎戀別筵，歡情未斷妾心懸。",
            "汰王灘下相思处，猿叫山山月滿船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 17
    },
    {
        "title": "答微之",
        "author": "裴淑",
        "biography": "",
        "paragraphs": [
            "侯門初擁節，御苑柳絲新。不是悲殊命，唯愁別近親。",
            "黃鶯遷古木，朱履從清塵。想到千山外，滄江正暮春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 18
    },
    {
        "title": "夫下第",
        "author": "趙氏2",
        "biography": "",
        "paragraphs": [
            "良人的的有奇才，何事年年被放回。",
            "如今妾面羞君面，君若來时近夜來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 19
    },
    {
        "title": "雜言寄杜羔",
        "author": "趙氏2",
        "biography": "",
        "paragraphs": [
            "君從淮海遊，再過蘭杜秋。归來未須臾，又欲向梁州。",
            "梁州秦嶺西，棧道与雲齊。羌蠻万餘落，矛戟自高低。",
            "已念寡儔侶，複慮勞攀躋。丈夫重志气，兒女空悲啼。",
            "臨邛滯遊地，肯顧濁水泥。人生賦命有厚薄，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 20
    },
    {
        "title": "闻夫杜羔登第",
        "author": "趙氏2",
        "biography": "",
        "paragraphs": [
            "長安此去无多地，鬱鬱蔥蔥佳气浮。",
            "良人得意正年少，今夜醉眠何处樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 21
    },
    {
        "title": "雜言",
        "author": "趙氏2",
        "biography": "",
        "paragraphs": [
            "上林園中青青桂，折得一枝好夫婿。",
            "杏花如雪柳垂絲，春风蕩颺不同枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 22
    },
    {
        "title": "寄夫",
        "author": "张氏",
        "biography": "",
        "paragraphs": [
            "久无音信到羅幃，路遠迢迢遣问谁。",
            "闻君折得東堂桂，折罷那能不暫归。",
            "驛使今朝過五湖，殷勤為我報狂夫。",
            "從來誇有龍泉劍，試割相思得斷无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 23
    },
    {
        "title": "贈鄭女郎",
        "author": "薛馧",
        "biography": "",
        "paragraphs": [
            "豔阳灼灼河洛神，珠簾繡戶青樓春。能彈箜篌弄纖指，",
            "朝理曲，暮理曲，独坐窗前一片玉。行也嬌，坐也嬌，",
            "解佩时时歇歌管，芙蓉帳裏蘭麝滿。晚起羅衣香不斷，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 24
    },
    {
        "title": "古意",
        "author": "薛馧",
        "biography": "",
        "paragraphs": [
            "昨夜巫山中，失卻阳臺女。朝來香閣裏，独伴楚王语。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 25
    },
    {
        "title": "贈故人",
        "author": "薛馧",
        "biography": "",
        "paragraphs": [
            "昔別容如玉，今來鬢若絲。淚痕應共見，腸斷阿谁知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 26
    },
    {
        "title": "句",
        "author": "薛馧",
        "biography": "",
        "paragraphs": [
            "寂寞相思处，雕梁落燕泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 27
    },
    {
        "title": "題奉慈寺",
        "author": "楊德麟",
        "biography": "",
        "paragraphs": [
            "日月金輪動，旃檀碧樹秋。塔分鴻雁翅，鐘掛鳳凰樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 28
    },
    {
        "title": "述懷",
        "author": "崔氏",
        "biography": "",
        "paragraphs": [
            "不怨盧郎年紀大，不怨盧郎官職卑。",
            "自恨妾身生較晚，不及盧郎年少时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 29
    },
    {
        "title": "寄夫",
        "author": "陳玉蘭",
        "biography": "",
        "paragraphs": [
            "夫戍邊關妾在吳，西风吹妾妾憂夫。",
            "一行书信千行淚，寒到君邊衣到无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 30
    },
    {
        "title": "写真寄夫",
        "author": "薛媛",
        "biography": "",
        "paragraphs": [
            "欲下丹青筆，先拈寶鏡寒。已經顏索寞，漸觉鬢凋残。",
            "淚眼描将易，愁腸写出難。恐君渾忘卻，时展画图看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 31
    },
    {
        "title": "闻琴",
        "author": "孫氏",
        "biography": "",
        "paragraphs": [
            "玉指朱弦軋複清，湘妃愁怨最難聽。初疑颯颯涼风勁，",
            "夜深彈罷堪惆悵，露濕叢蘭月滿庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 32
    },
    {
        "title": "白蠟燭诗",
        "author": "孫氏",
        "biography": "",
        "paragraphs": [
            "景勝銀釭香比蘭，一條白玉偪人寒。",
            "他时紫禁春风夜，醉草天书仔細看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 33
    },
    {
        "title": "謝人送酒",
        "author": "孫氏",
        "biography": "",
        "paragraphs": [
            "謝将清酒寄愁人，澄澈甘香气味真。",
            "好是綠窗风月夜，一杯搖盪滿懷春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 34
    },
    {
        "title": "诗",
        "author": "张立本女",
        "biography": "",
        "paragraphs": [
            "危冠廣袖楚宮妝，独步闲庭逐夜涼。",
            "自把玉簪敲砌竹，清歌一曲月如霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 35
    },
    {
        "title": "繡龜形诗",
        "author": "侯氏",
        "biography": "",
        "paragraphs": [
            "暌離已是十秋強，对鏡那堪重理妝。闻雁幾回修尺素，",
            "繡作龜形獻天子，愿教征客早還鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 36
    },
    {
        "title": "感夫诗",
        "author": "慎氏",
        "biography": "",
        "paragraphs": [
            "當时心事已相關，雨散雲飛一餉間。",
            "便是孤帆從此去，不堪重上望夫山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 37
    },
    {
        "title": "謠",
        "author": "薛瑤",
        "biography": "",
        "paragraphs": [
            "化雲心兮思淑貞，洞寂滅兮不見人。瑤草芳兮思芬蒀，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 38
    },
    {
        "title": "題唐安寺閣壁",
        "author": "王霞卿",
        "biography": "",
        "paragraphs": [
            "春來引步暫尋遊，愁見风光倚寺樓。",
            "正好開懷对煙月，雙眉不觉自如鉤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 39
    },
    {
        "title": "答鄭殷彝",
        "author": "王霞卿",
        "biography": "",
        "paragraphs": [
            "君是煙霄折桂身，圣朝方切用儒珍。",
            "正堪西上文場戰，空向途中泥婦人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 40
    },
    {
        "title": "喜盧郎及第",
        "author": "竇梁賓",
        "biography": "",
        "paragraphs": [
            "曉妝初罷眼初瞤，小玉驚人踏破裙。",
            "手把紅箋书一紙，上頭名字有郎君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 41
    },
    {
        "title": "雨中看牡丹",
        "author": "竇梁賓",
        "biography": "",
        "paragraphs": [
            "東风未放曉泥幹，紅药花開不奈寒。",
            "待得天晴花已老，不如攜手雨中看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 42
    },
    {
        "title": "书桐葉",
        "author": "任氏",
        "biography": "",
        "paragraphs": [
            "拭翠斂蛾眉，鬱鬱心中事。搦管下庭除，书成相思字。",
            "此字不书石，此字不书紙。书在桐葉上，愿逐秋风起。",
            "天下有心人，盡解相思死。天下負心人，不识相思字。",
            "有心与負心，不知落何地。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 43
    },
    {
        "title": "下獄貢诗",
        "author": "黃崇嘏",
        "biography": "",
        "paragraphs": [
            "偶辭幽隱在臨邛，行止堅貞比澗松。",
            "何事政清如水鏡，絆他野鶴在深籠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 44
    },
    {
        "title": "辭蜀相妻女诗",
        "author": "黃崇嘏",
        "biography": "",
        "paragraphs": [
            "一辭拾翠碧江湄，貧守蓬茅但賦诗。自服藍衫居郡掾，",
            "幕府若容為坦腹，愿天速變作男兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 45
    },
    {
        "title": "答諸姊妹戒飲",
        "author": "蔣氏",
        "biography": "",
        "paragraphs": [
            "平生偏好酒，勞爾勸吾餐。但得杯中滿，时光度不難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 46
    },
    {
        "title": "书壁",
        "author": "周仲美",
        "biography": "",
        "paragraphs": [
            "愛妾不愛子，為问此何理。棄官更棄妻，人情寧可已。",
            "永訣泗之濱，遺言空在耳。三载无朝昏，孤幃淚如洗。",
            "婦人義從夫，一節誓生死。江鄉感残春，腸斷晚煙起。",
            "西望太華峰，不知幾千里。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 47
    },
    {
        "title": "溪口雲",
        "author": "张文姬",
        "biography": "",
        "paragraphs": [
            "溶溶溪口雲，才向溪中吐。不復归溪中，還作溪中雨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 48
    },
    {
        "title": "池上竹",
        "author": "张文姬",
        "biography": "",
        "paragraphs": [
            "此君臨此池，枝低水相近。碧色綠波中，日日流不盡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 49
    },
    {
        "title": "沙上鹭",
        "author": "张文姬",
        "biography": "",
        "paragraphs": [
            "沙頭一水禽，鼓翼揚清音。只待高风便，非无雲漢心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 50
    },
    {
        "title": "雙槿樹",
        "author": "张文姬",
        "biography": "",
        "paragraphs": [
            "綠影競扶疏，紅姿相照灼。不學桃李花，乱向春风落。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 51
    },
    {
        "title": "獄中书情上使君",
        "author": "程長文",
        "biography": "",
        "paragraphs": [
            "妾家本住鄱阳曲，一片貞心比孤竹。當年二八盛容仪。",
            "紅箋草隸恰如飛。盡日閑窗刺繡坐，有时极浦採蓮归。",
            "谁道居貧守都邑，幽閨寂寞无人识。海燕朝归衾枕寒，",
            "一命任從刀下死，千金豈受暗中欺。我心匪石情難轉，",
            "縣僚曾未知情緒，即便教人縶囹圄。朱唇滴瀝独銜冤，",
            "高髻不梳雲已散，蛾眉罷掃月仍新。三尺嚴章難可越，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 52
    },
    {
        "title": "銅雀台怨",
        "author": "程長文",
        "biography": "",
        "paragraphs": [
            "君王去后行人絕，簫箏不響歌喉咽。雄劍无威光彩沈，",
            "當时歌舞人不回，化為今日西陵灰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 53
    },
    {
        "title": "春閨怨",
        "author": "程長文",
        "biography": "",
        "paragraphs": [
            "綺陌香飄柳如線，时光瞬息如流電。",
            "良人何处事功名，十载相思不相見。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百九十九",
        "no#": 54
    }
