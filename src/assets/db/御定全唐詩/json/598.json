[
    {
        "title": "言懷",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "恨乏平戎策，慚登拜将壇。手持金鉞冷，身掛鐵衣寒。",
            "主聖扶持易，恩深報效難。三邊犹未靜，何敢便休官。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 1
    },
    {
        "title": "寄鄠杜李遂良處士",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "小隱堪忘世上情，可能休夢入重城。池邊写字師前輩，",
            "春來不得山中信，盡日无人傍水行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 2
    },
    {
        "title": "和王昭符進士贈洞庭趙先生",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "為愛君山景最靈，角冠秋禮一壇星。药将雞犬雲間試，",
            "煙霞淡泊无人到，唯有漁翁過洞庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 3
    },
    {
        "title": "依韵奉酬李迪",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "柳下官資顏子居，闲情入骨若為除。诗成斬将奇難敵，",
            "而今共飲醇滋味，消得揶揄勢利疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 4
    },
    {
        "title": "留別彰德军從事範校书",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "无金寄与白頭親，節概犹誇似古人。未出塵埃真落魄，",
            "匹馬東归羨知己，燕王臺上結交新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 5
    },
    {
        "title": "途次內黃馬病，寄僧舍呈諸友人",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "官閑馬病客深秋，肯學张衡詠四愁。紅葉寺多诗景致，",
            "好与高阳結吟社，況无名跡達珠旒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 6
    },
    {
        "title": "遣興",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "浮世忙忙蟻子群，莫嗔頭上雪紛紛。沈憂万種与千種，",
            "醉鄉日月終須覓，去作先生號白雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 7
    },
    {
        "title": "南海神祠",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "滄溟八千里，今古畏波濤。此日征南将，安然渡万艘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 8
    },
    {
        "title": "送春",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "水淺魚爭躍，花深鳥競啼。春光看欲盡，判卻醉如泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 9
    },
    {
        "title": "海翻",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "幾經人事變，又見海濤翻。徒起如山浪，何曾洗至冤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 10
    },
    {
        "title": "筇竹杖寄僧",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "堅輕筇竹杖，一枝有九節。寄与沃洲人，闲步青山月。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 11
    },
    {
        "title": "遣興",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "把盞非怜酒，持竿不為魚。唯應嵇叔夜，似我性慵疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 12
    },
    {
        "title": "歎征人",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "心堅膽壯箭頭親，十载沙場受苦辛。",
            "力盡路傍行不得，廣张紅旆是何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 13
    },
    {
        "title": "湘妃廟",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "帝舜南巡去不還，二妃幽怨水雲間。",
            "當时珠淚垂多少，直到如今竹尚斑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 14
    },
    {
        "title": "赴安南卻寄台司",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "曾驅万馬上天山，风去雲回頃刻間。",
            "今日海門南面事，莫教還似鳳林關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 15
    },
    {
        "title": "閨怨",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "人世悲歡不可知，夫君初破黑山归。",
            "如今又獻征南策，早晚催縫帶號衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 16
    },
    {
        "title": "馬嵬驛",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "玉顏雖掩馬嵬塵，冤氣和煙鎖渭津。",
            "蟬鬢不隨鑾駕去，至今空感往來人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 17
    },
    {
        "title": "宴犒蕃军有感",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "蜀地恩留馬嵬哭，煙雨濛濛春草綠。",
            "滿眼由來是舊人，那堪更奏梁州曲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 18
    },
    {
        "title": "寓懷",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "關山万里恨難銷，鐵馬金鞭出塞遙。",
            "為问昔时青海畔，幾人归到鳳林橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 19
    },
    {
        "title": "步虛詞",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "青溪道士人不识，上天下天鶴一隻。",
            "洞門深鎖碧窗寒，滴露研朱點周易。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 20
    },
    {
        "title": "贈歌者二首",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "酒滿金船花滿枝，佳人立唱慘愁眉。",
            "一聲直入青雲去，多少悲歡起此时。",
            "公子邀歡月滿樓，雙成揭調唱伊州。",
            "便從席上风沙起，直到阳關水盡頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 21
    },
    {
        "title": "入蜀",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "万水千山音信希，空勞魂夢到京畿。",
            "漫天嶺上频回首，不見虞封淚滿衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 22
    },
    {
        "title": "邊城聽角",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "席箕风起雁聲秋，隴水邊沙滿目愁。",
            "三會五更欲吹盡，不知凡白幾人頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 23
    },
    {
        "title": "渭川秋望寄右军王特進",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "長川終日碧潺湲，知道天河与地連。",
            "凭寄两行朝闕淚，愿隨流入禦溝泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 24
    },
    {
        "title": "山亭夏日",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "綠樹阴濃夏日長，樓臺倒影入池塘。",
            "水精簾動微风起，滿架薔薇一院香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 25
    },
    {
        "title": "蜀路感懷",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "蜀山蒼翠隴雲愁，鑾駕西巡陷幾州。",
            "唯有縈回深澗水，潺湲不改舊时流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 26
    },
    {
        "title": "残春遣興",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "画舸輕橈柳色新，摩訶池上醉青春。",
            "不辭不為青春醉，只恐鶯花也怪人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 27
    },
    {
        "title": "春日招賓",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "花枝如火酒如餳，正好狂歌醉複醒。",
            "對酒看花何處好，延和閣下碧筠亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 28
    },
    {
        "title": "過天威徑",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "豺狼坑盡卻朝天，戰馬休嘶瘴嶺煙。",
            "归路嶮巇今坦蕩，一條千里直如弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 29
    },
    {
        "title": "對花呈幕中",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "海棠初發去春枝，首唱曾題七字诗。",
            "今日能來花下飲，不辭频把使頭旗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 30
    },
    {
        "title": "寄題羅浮別业",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "不将真性染埃塵，為有煙霞伴此身。",
            "帶日長江好归信，博羅山下碧桃春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 31
    },
    {
        "title": "塞上曲二首",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "二年邊戍絕煙塵，一曲河灣万恨新。",
            "從此鳳林關外事，不知谁是苦心人。",
            "隴上征夫隴下魂，死生同恨漢将军。",
            "不知万里沙場苦，空舉平安火入雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 32
    },
    {
        "title": "廣陵宴次戲簡幕賓",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "一曲狂歌酒百分，蛾眉画出月爭新。",
            "将军醉罷无餘事，乱把花枝折贈人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 33
    },
    {
        "title": "安南送曹別敕归朝",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "雲水蒼茫日欲收，野煙深處鷓鴣愁。",
            "知君万里朝天去，為说征南已五秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 34
    },
    {
        "title": "對雪",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "六出飛花入戶时，坐看青竹變瓊枝。",
            "如今好上高樓望，蓋盡人間惡路岐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 35
    },
    {
        "title": "訪隱者不遇",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "落花流水認天臺，半醉閑吟独自來。",
            "惆悵仙翁何處去，滿庭紅杏碧桃開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 36
    },
    {
        "title": "赴西川途經虢縣作",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "亞夫重過柳營門，路指岷峨隔暮雲。",
            "紅額少年遮道拜，殷勤認得舊将军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 37
    },
    {
        "title": "錦城写望",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "蜀江波影碧悠悠，四望煙花匝郡樓。",
            "不會人家多少錦，春來盡掛樹梢頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 38
    },
    {
        "title": "太公廟",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "青山長在境長新，寂寞持竿一水濱。",
            "及得王師身已老，不知辛苦為何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 39
    },
    {
        "title": "邊方春興",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "草色青青柳色濃，玉壺傾酒滿金鐘。",
            "笙歌嘹亮隨风去，知盡關山第幾重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 40
    },
    {
        "title": "塞上寄家兄",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "棣萼分张信使希，幾多鄉淚濕征衣。",
            "笳聲未斷腸先斷，万里胡天鳥不飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 41
    },
    {
        "title": "写懷二首",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "漁竿消日酒消愁，一醉忘情万事休。",
            "卻恨韓彭興漢室，功成不向五湖遊。",
            "花滿西園月滿池，笙歌搖曳画船移。",
            "如今暗与心相約，不動征旗動酒旗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 42
    },
    {
        "title": "池上送春",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "持竿閑坐思沉吟，釣得江鱗出碧潯。",
            "回首看花花欲盡，可怜寥落送春心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 43
    },
    {
        "title": "南征敘懷",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "万里驅兵過海門，此生今日報君恩。",
            "回期直待烽煙靜，不遣征衣有淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 44
    },
    {
        "title": "风箏",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "夜靜弦聲響碧空，宮商信任往來风。",
            "依稀似曲才堪聽，又被移将別調中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 45
    },
    {
        "title": "平流園席上",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "画舸搖煙水滿塘，柳絲輕軟小桃香。",
            "卻緣龍節為縈絆，好是狂时不得狂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 46
    },
    {
        "title": "闻河中王鐸加都統",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "煉汞燒鉛四十年，至今犹在药爐前。",
            "不知子晉緣何事，只學吹簫便得仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 47
    },
    {
        "title": "句",
        "author": "高駢",
        "biography": "",
        "paragraphs": [
            "人間无限傷心事，不得尊前折一枝。",
            "滿宮多少承恩者，似有容華妾也无。",
            "滿身珠翠将何用，唯与豪家拂象床。",
            "何人種得西施花，千古春风開不盡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百九十八",
        "no#": 48
    }
]