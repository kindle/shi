[
    {
        "title": "夢丹书",
        "author": "李亨",
        "biography": "",
        "paragraphs": [
            "厥不雲乎，惟其惟时。上天所保，福祿不虧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 1
    },
    {
        "title": "夢黃衣童子歌",
        "author": "李豫",
        "biography": "",
        "paragraphs": [
            "中五之德方峨峨，胡胡呼呼何奈何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 2
    },
    {
        "title": "夢揚州樂妓和诗",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "花作嬋娟玉作妝，风流爭似舊徐娘。",
            "夜深曲曲灣灣月，万里隨君一寸腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 3
    },
    {
        "title": "夢中美人歌",
        "author": "邢鳳",
        "biography": "",
        "paragraphs": [
            "長安少女踏春阳，何處春阳不斷腸。",
            "舞袖弓彎渾忘卻，羅衣空换九秋霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 4
    },
    {
        "title": "夢中诗",
        "author": "石季武",
        "biography": "",
        "paragraphs": [
            "聳轡排金闕，乘軒上漢槎。浮名何足戀，高舉入煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 5
    },
    {
        "title": "葬西施挽歌",
        "author": "王炎",
        "biography": "",
        "paragraphs": [
            "西望吳王國，雲书鳳字牌。連江起珠帳，擇地葬金釵。",
            "滿地紅心草，三層碧玉階。春风无處所，淒恨不勝懷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 6
    },
    {
        "title": "秦夢诗三首：挽公主",
        "author": "沈亞之",
        "biography": "",
        "paragraphs": [
            "泣葬一枝紅，生同死不同。金鈿墜芳草，香繡滿春风。",
            "舊日闻簫處，高樓當月中。梨花寒食夜，深閉翠微宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 7
    },
    {
        "title": "秦夢诗三首：別穆公",
        "author": "沈亞之",
        "biography": "",
        "paragraphs": [
            "擊髆舞，恨滿煙光无處所。淚如雨，欲擬著辭不成语。",
            "金鳳銜紅舊繡衣，幾度宮中同看舞。人間春日正歡樂，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 8
    },
    {
        "title": "秦夢诗三首：題宮門",
        "author": "沈亞之",
        "biography": "",
        "paragraphs": [
            "君王多感放東归，從此秦宮不復期。",
            "春景似傷秦喪主，落花如雨淚燕脂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 9
    },
    {
        "title": "夢中诗",
        "author": "盧獻卿",
        "biography": "",
        "paragraphs": [
            "卜築郊原古，青山无四鄰。扶疏繞屋樹，寂寞独归人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 10
    },
    {
        "title": "夢為吳泰伯作勝兒歌",
        "author": "劉景複",
        "biography": "",
        "paragraphs": [
            "繁弦已停雜吹歇，勝兒調弄邏娑撥。四弦攏撚三五聲，",
            "小弦切切怨颸颸，鬼哭神悲秋窸窣。倒腕斜挑掣流電，",
            "我闻天寶十年前，涼州未作西戎窟。麻衣右衽皆漢民，",
            "玄宗未到万里橋，東洛西京一时沒。漢土民皆沒為虜，",
            "國門之西八九鎮，高城深壘閉閑卒。河湟咫尺不能收，",
            "勝兒若向邊塞彈，征人淚血應闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 11
    },
    {
        "title": "夢中辭",
        "author": "郭仁表",
        "biography": "",
        "paragraphs": [
            "飄风暴雨可思惟，鶴望巢門斂翅飛。吾道之宗正可依，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 12
    },
    {
        "title": "夢崔嘏妻诗",
        "author": "國邵南",
        "biography": "",
        "paragraphs": [
            "莫以真留妾，從他理管弦。容華難久駐，知得幾多年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 13
    },
    {
        "title": "夢白衣婦人歌詞",
        "author": "盧絳",
        "biography": "",
        "paragraphs": [
            "玉京人去秋蕭索，画簷鵲起梧桐落。欹枕悄无言，",
            "清风明月夜深时，箕帚盧郎恨已迟。",
            "他日孟家坡上約，再來相見是佳期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 14
    },
    {
        "title": "夢舜撫琴歌",
        "author": "张生",
        "biography": "",
        "paragraphs": [
            "南风熏熏兮草芊芊，妙有之音兮归清弦。",
            "蕩蕩之教兮由自然，熙熙之化兮吾道全，熏熏兮思何傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 15
    },
    {
        "title": "夢康仙示诗",
        "author": "漳郡守",
        "biography": "",
        "paragraphs": [
            "賣药因循未得還，卻因耽酒到人間。",
            "有心只戀琵琶阪，无意更登山上山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 16
    },
    {
        "title": "夢中歌",
        "author": "白氏",
        "biography": "",
        "paragraphs": [
            "今夕何夕，存耶沒耶？良人去兮天之涯，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 17
    },
    {
        "title": "夢中歌",
        "author": "张生妻",
        "biography": "",
        "paragraphs": [
            "歎衰草，絡緯聲切切。良人一去不復還，",
            "勸君酒，君莫辭。落花徒繞枝，流水无返期。",
            "莫恃少年时，少年能幾时。",
            "怨空閨，秋日亦難暮。夫婿斷音书，遙天雁空度。",
            "切切夕风急，露滋庭草濕。良人去不回，焉知掩閨泣。",
            "螢火穿白楊，悲风入荒草。疑是夢中游，愁迷故園道。",
            "花前始相見，花下又相送。何必言夢中，人生盡如夢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 18
    },
    {
        "title": "夢王尚书口授吟",
        "author": "张氏女",
        "biography": "",
        "paragraphs": [
            "鬟梳鬧掃學宮妝，独立闲庭納夜涼。",
            "手把玉簪敲砌竹，清歌一曲月如霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 19
    },
    {
        "title": "歌",
        "author": "病狂人",
        "biography": "",
        "paragraphs": [
            "踏阳春，人間三月雨和塵。阳春踏，秋风起，",
            "五靈華，曉玲瓏，天府由來汝府中。惆悵此情言不盡，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 20
    },
    {
        "title": "題禪窟蘭若",
        "author": "陳季卿",
        "biography": "",
        "paragraphs": [
            "霜鐘鳴时夕风急，乱鴉又望寒林集。",
            "此时輟棹悲且吟，独向蓮華一峰立。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 21
    },
    {
        "title": "題潼關普通院門",
        "author": "陳季卿",
        "biography": "",
        "paragraphs": [
            "度關悲失志，万緒乱心机。下阪馬无力，掃門塵滿衣。",
            "计謀多不就，心口自相違。已作羞归计，還勝羞不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 22
    },
    {
        "title": "江亭晚望題书齋",
        "author": "陳季卿",
        "biography": "",
        "paragraphs": [
            "立向江亭滿目愁，十年前事信悠悠。田園已逐浮雲散，",
            "不緣齒發未迟暮，吟對遠山堪白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 23
    },
    {
        "title": "別妻",
        "author": "陳季卿",
        "biography": "",
        "paragraphs": [
            "月斜寒露白，此夕去留心。酒至添愁飲，诗成和淚吟。",
            "離歌淒鳳管，別鶴怨瑤琴。明夜相思處，秋风吹半衾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 24
    },
    {
        "title": "別兄弟",
        "author": "陳季卿",
        "biography": "",
        "paragraphs": [
            "謀身非不早，其奈命來迟。舊友皆霄漢，此身犹路岐。",
            "北风微雪後，晚景有雲时。惆悵清江上，區區趁試期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 25
    },
    {
        "title": "夢中句",
        "author": "周延翰",
        "biography": "",
        "paragraphs": [
            "紫髯之伴有丹砂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 26
    },
    {
        "title": "夢中和句",
        "author": "任玠",
        "biography": "",
        "paragraphs": [
            "故國路遙归去來，春风天遠望不盡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 27
    },
    {
        "title": "夢中语",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "辭春不及秋，昆腳与皆頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 28
    },
    {
        "title": "夢中诗",
        "author": "胥偃",
        "biography": "",
        "paragraphs": [
            "昔作樹頭花，今為塚中骨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 29
    },
    {
        "title": "夢中语",
        "author": "曾崇范妻",
        "biography": "",
        "paragraphs": [
            "田頭有鹿跡，由尾著日炙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 30
    },
    {
        "title": "紀夢句",
        "author": "张孜",
        "biography": "",
        "paragraphs": [
            "上天知我憶其人，使向人間夢中見。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百六十八",
        "no#": 31
    }
]