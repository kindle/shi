[
    {
        "title": "立春日",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "暖日傍簾曉，濃春開篋紅。釵斜穿彩燕，羅薄剪春蟲。",
            "巧著金刀力，寒侵玉指风。娉婷何处戴，山鬢綠成叢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 1
    },
    {
        "title": "翦彩",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "翦彩贈相親，銀釵綴鳳真。雙雙銜綬鳥，两两度橋人。",
            "葉逐金刀出，花隨玉指新。愿君千万歲，无歲不逢春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 2
    },
    {
        "title": "題僧院",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "不用问湯休，何人免白頭。百年如過鳥，万事盡浮漚。",
            "別緒長牽夢，情由乱種愁。卻嫌风景麗，窗外碧雲秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 3
    },
    {
        "title": "觀廉女真葬",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "玉窗拋翠管，輕袖掩銀鸞。錯落雲車斷，丁泠金磬寒。",
            "鶴尋深院宿，人借舊书看。寂寞焚香处，紅花滿石壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 4
    },
    {
        "title": "闲居",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "塵事久相棄，沈浮皆不知。牛羊归古巷，燕雀繞疏籬。",
            "買药經年曬，留僧盡日棋。唯憂釣魚伴，秋水隔波时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 5
    },
    {
        "title": "及第后送家兄游蜀",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "人谁无遠別，此別意多違。正鵠雖言中，冥鴻不共飛。",
            "玉京煙雨斷，巴國夢魂归。若過嚴家瀨，殷勤看釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 6
    },
    {
        "title": "送人入蜀",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "蜀客本多愁，君今是勝遊。碧藏雲外樹，紅露驛邊樓。",
            "杜魄呼名语，巴江作字流。不知煙雨夜，何处夢刀州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 7
    },
    {
        "title": "游故王駙馬池亭",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "花樹杳玲瓏，漁舟处处通。醉銷羅綺豔，香暖芰荷风。",
            "野鳥翻萍綠，斜橋印水紅。子猷簫管絕，谁愛碧鮮濃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 8
    },
    {
        "title": "悲銅雀台",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "西陵樹已盡，銅雀思偏多。雪密疑樓閣，花開想綺羅。",
            "影銷堂上舞，聲斷帳前歌。唯有漳河水，年年舊綠波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 9
    },
    {
        "title": "陪新及第赴同年會",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "曾攀芳桂英，处处共君行。今日杏園宴，當时天樂聲。",
            "柳濃堪系馬，花上未藏鶯。滿座皆仙侶，同年別有情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 10
    },
    {
        "title": "詠雁",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "早晚辭沙漠，南來处处飛。關山多雨雪，风水損毛衣。",
            "碧海魂應斷，紅樓信自稀。不知矰繳外，留得幾行归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 11
    },
    {
        "title": "与碧溪上人別",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "欲入鳳城遊，西溪別惠休。色隨花旋落，年共水爭流。",
            "客思偏來夜，蟬聲觉送秋。明朝逢舊侶，唯擬上歌樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 12
    },
    {
        "title": "贈殷山人",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "有客抱琴宿，值予多怨懷。啼烏弦易斷，嘯鶴調難諧。",
            "曲罷月移幌，韵清风滿齋。谁能将此妙，一為奏金階。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 13
    },
    {
        "title": "詠壁魚",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "鱗細粉光鮮，開书乱眼前。透窗疑漏網，落硯似流泉。",
            "潛穴河图內，吞鉤乙字邊。莫言鬐鬣小，食盡白蘋篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 14
    },
    {
        "title": "聽話叢台",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "有客新從趙地回，自言曾上古叢台。雲遮襄國天邊去，",
            "金輿玉輦无行跡，风雨惟知長綠苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 15
    },
    {
        "title": "失鶴",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "秋风吹卻九皋禽，一片閑雲万里心。碧落有情應悵望，",
            "華表柱頭留语后，更无消息到如今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 16
    },
    {
        "title": "贈写禦容李長史",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "玉座塵消硯水清，龍髯不動彩毫輕。初分隆准山河秀，",
            "三朝供奉无人敵，始觉僧繇浪得名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 17
    },
    {
        "title": "贈潼關不下山僧",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "与君同在苦空間，君得空門我愛閑。禁足已教修雁塔，",
            "香茗一甌從此別，轉蓬流水幾时還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 18
    },
    {
        "title": "過舊遊見雙鶴愴然有懷",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "謝公何歲掩松楸，雙鶴依然傍玉樓。朱頂巑岏荒草上，",
            "他日若來華表上，更添多少令威愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 19
    },
    {
        "title": "贈友人",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "鳳城煙靄思偏多，曾向劉郎住处過。銀燭焰前貪勸酒，",
            "今日重來門巷改，出牆桐樹綠婆娑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 20
    },
    {
        "title": "贈南嶽僧",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "曾住衡阳岳寺邊，門開江水与雲連。数州城郭藏寒樹，",
            "今朝惆悵紅塵裏，惟憶閑陪盡日眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 21
    },
    {
        "title": "贈弘文杜校书",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "高倚霞梯万丈餘，共看移步入宸居。曉隨鵷鹭排金鎖，",
            "還闻漢帝親詞賦，好為從容奏子虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 22
    },
    {
        "title": "聽王氏話归州昭君廟",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "獻之閑坐说归州，曾到昭君廟裏遊。自古行人多怨恨，",
            "河畔犹残翠眉樣，有时新月傍簾鉤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 23
    },
    {
        "title": "過馬嵬山",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "金甲雲旗盡日回，倉皇羅袖滿塵埃。濃香犹自飄鑾輅，",
            "唯餘坡上彎環月，时送残蛾入帝台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 24
    },
    {
        "title": "吳越懷古",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "吳越千年奈怨何，两宮清吹作樵歌。姑蘇一敗雲无色，",
            "行人欲问西施館，江鳥寒飛碧草多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 25
    },
    {
        "title": "長安即事寄友人",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "綺陌千年思斷蓬，今來還宿鳳城東。瑤台鐘鼓長依舊，",
            "何时更伴劉郎去，卻見夭桃滿樹紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 26
    },
    {
        "title": "闻明上人逝寄友人",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "蕭寺曾過最上方，碧桐濃葉覆西廊。遊人縹緲紅衣乱，",
            "他时若更相隨去，只是含酸对影堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 27
    },
    {
        "title": "贈咸阳李少府",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "美貌雄才已少齊，寶书仙簡两看題。金刀片片裁新錦，",
            "蓬瀛宴罷試回首，一望塵中路正迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 28
    },
    {
        "title": "鄰人自金仙觀移竹",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "移居新竹已堪看，劚破莓苔得幾竿。圓節不教傷粉籜，",
            "第一莫教漁父見，且從蕭颯滿朱欄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 29
    },
    {
        "title": "慈恩寺避暑",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "香荷疑散麝，风鐸似調琴。不觉清涼晚，归人滿柳阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 30
    },
    {
        "title": "讀田光傳",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "秦滅燕丹怨正深，古來豪客盡沾襟。",
            "荊卿不了真闲事，辜負田光一片心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 31
    },
    {
        "title": "友人下第因以贈之",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "劉毅雖然不擲盧，谁人不道解樗蒲。",
            "黃金百万終須得，只有挼莎更一呼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 32
    },
    {
        "title": "詠鴛鴦",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "鴛鴦離別傷，人意似鴛鴦。試取鴛鴦看，多應斷寸腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 33
    },
    {
        "title": "贈箏妓伍卿",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "輕輕沒后更无箏，玉腕紅紗到伍卿。",
            "座客滿筵都不语，一行哀雁十三聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 34
    },
    {
        "title": "黃陵廟詞",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "黃陵廟前莎草春，黃陵女兒蒨裙新。",
            "輕舟小楫唱歌去，水遠山長愁殺人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 35
    },
    {
        "title": "句",
        "author": "李遠",
        "biography": "",
        "paragraphs": [
            "人事三杯酒，流年一局棋。。",
            "青山不厭三杯酒，長日惟消一局棋。。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百一十九",
        "no#": 36
    }
]