[
    {
        "title": "歲暮江軒寄盧端公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "積水生高浪，長风自北时。万艘俱擁棹，上客独吟诗。",
            "路以重湖阻，心将小謝期。渚雲愁正斷，江雁重驚悲。",
            "笑憶遊星子，歌尋罷貴池。夢來孤島在，醉醒百憂隨。",
            "戍迥煙生晚，江寒鳥過迟。问山樵者對，經雨釣船移。",
            "敢歎今留滯，犹勝曩別離。醉從陶令得，善必丈人知。",
            "道蹇才何取，恩深劍不疑。此身同岸柳，只待變寒枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 1
    },
    {
        "title": "秋日吳中觀貢藕",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "野艇幾西東，清泠映碧空。褰衣來水上，捧玉出泥中。",
            "葉乱田田綠，蓮餘片片紅。激波才入選，就日已生风。",
            "禦潔玲瓏膳，人懷拔擢功。梯山謾多品，不与世流同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 2
    },
    {
        "title": "華清宮和杜舍人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "五十年天子，離宮仰峻牆。登封时正泰，禦宇日何長。",
            "上位先名實，中興事憲章。起戎輕甲胄，餘地複河湟。",
            "道帝玄元祖，儒封孔子王。因緣百司署，叢會一人湯。",
            "渭水波搖綠，秦郊草半黃。馬馴金勒細，鷹健玉鈴鏘。",
            "下箭朱弓滿，鳴鞭皓腕攘。畋思獲呂望，諫只避周昌。",
            "兔跡貪前逐，梟心不早防。幾添鸚鵡勸，先賜荔枝嘗。",
            "月鎖千門靜，天吹一笛涼。細音搖羽佩，輕步宛霓裳。",
            "禍乱基潛結，升平意遽忘。衣冠逃犬虜，鼙鼓動漁阳。",
            "外戚心殊迫，中途事可量。血埋妃子豔，創斷祿兒腸。",
            "近侍煙塵隔，前蹤輦路荒。益知迷寵佞，遺恨喪賢良。",
            "北闕尊明主，南宮遜上皇。禁清餘鳳吹，池冷睡龍光。",
            "祝壽山犹在，流年水共傷。杜鵑魂厭蜀，蝴蝶夢悲莊。",
            "雀卵遺雕栱，蟲絲罥画梁。紫苔侵壁潤，紅樹閉門芳。",
            "守吏齊鴛瓦，耕民得翠璫。登年齊酺樂，講武舊兵場。",
            "暮草深岩翠，幽花墜徑香。不堪垂白叟，行折禦溝楊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 3
    },
    {
        "title": "下第",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "南溪抱甕客，失意自懷羞。晚路谁攜手，残春自白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 4
    },
    {
        "title": "到家",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "童稚苦相问，归來何太迟。共谁爭歲月，贏得鬢邊絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 5
    },
    {
        "title": "春釀",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "春釀正风流，梨花莫问愁。馬卿思一醉，不惜鷫鸘裘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 6
    },
    {
        "title": "寒塘",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "曉發梳臨水，寒塘坐見秋。鄉心正无限，一雁度南樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 7
    },
    {
        "title": "寄前黃州竇使君",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "池上笙歌寂不闻，樓中愁殺碧虛雲。",
            "玉壺凝盡重重淚，寄与风流舊使君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 8
    },
    {
        "title": "八月二十九日宿懷",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "秋天睛日菊還香，独坐书齋思已長。",
            "无奈风光易流轉，強須傾酒一杯觴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 9
    },
    {
        "title": "泗上奉送相公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "语堪銘座默含春，西漢公卿絕比倫。",
            "今日抱轅留不得，欲揮雙涕學舒人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 10
    },
    {
        "title": "贈桐鄉丞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "舟觸長松岸勢回，潺湲一夜繞亭台。",
            "若教靖節先生見，不肯更吟归去來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 11
    },
    {
        "title": "哭李進士",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "牽馬街中哭送君，靈車輾雪隔城闻。",
            "唯有山僧与樵客，共舁孤櫬入幽墳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 12
    },
    {
        "title": "重阳",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "節逢重九海門外，家在五湖煙水東。",
            "還向秋山覓诗句，伴僧吟對菊花风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 13
    },
    {
        "title": "重阳日即事",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "病酒堅辭綺席春，菊花空伴水邊身。",
            "由來舉止非闲雅，不是龍山落帽人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 14
    },
    {
        "title": "十无诗寄桂府楊中丞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "琴酒曾将风月須，謝公名跡滿江湖。",
            "不知貴擁旌旗後，犹暇怜诗愛酒无。",
            "東省南宮興不孤，幾因诗酒謬招呼。",
            "一從開署芙蓉幕，曾向风前記得无。",
            "遙闻桂水繞城隅，城上江山滿画圖。",
            "為问訾家洲畔月，清秋擬许醉狂无。",
            "日暮江邊一小儒，空怜未有白髭須。",
            "馬融已貴諸生老，犹自容窺絳帳无。",
            "一種吟诗號孔徒，滄江有客独疏愚。",
            "初筵盡辟知名士，许到风前月下无。",
            "望斷南雲日已晡，便應凭夢過重湖。",
            "不知自古登龍者，曾有因诗泥得无。",
            "早游門館一樵夫，只愛吟诗傍药爐。",
            "旌旆滿江身不見，思言記得潁川无。",
            "孔融襟抱稱名儒，愛物怜才与世殊。",
            "今日賓階忘姓字，當时省記薦雄无。",
            "僻愛江山俯坐隅，人間不是便為圖。",
            "尊前為问神仙伴，肯向三清慰薦无。",
            "膺門不避額逢珠，絕境由來卷軸須。",
            "早忝阿戎诗友契，趨庭曾薦禰生无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 15
    },
    {
        "title": "寄山僧",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雲裏幽僧不置房，橡花藤葉蓋禪床。",
            "朝來逢著山中伴，闻说新移最上方。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 16
    },
    {
        "title": "喜张濆及第",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "九轉丹成最上仙，青天暖日踏雲軒。",
            "春风賀喜无言语，排比花枝滿杏園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 17
    },
    {
        "title": "贈张濆榜頭被駁落",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "莫向花前泣酒杯，謫仙依舊是仙才。",
            "犹堪与世為祥瑞，曾到蓬山頂上來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 18
    },
    {
        "title": "悼亡二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "一燭從风到奈何，二年衾枕逐流波。",
            "雖知不得公然淚，时泣闌幹恨更多。",
            "明月蕭蕭海上风，君归泉路我飄蓬。",
            "門前雖有如花貌，爭奈如花心不同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 19
    },
    {
        "title": "宮烏棲",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "宮烏棲處玉樓深，微月生簷夜夜心。",
            "香輦不回花自落，春來空佩辟寒金。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 20
    },
    {
        "title": "長信宮",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "君恩已盡欲何归，犹有残香在舞衣。",
            "自恨身輕不如燕，春來長繞禦簾飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 21
    },
    {
        "title": "廣陵城",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "紅映高臺綠繞城，城邊春草傍牆生。",
            "隋家不向此中盡，汴水應无東去聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 22
    },
    {
        "title": "冷日過驪山",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "冷日微煙渭水愁，翠華宮樹不勝秋。",
            "霓裳一曲千門鎖，白盡梨園弟子頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 23
    },
    {
        "title": "下第後归永樂裏自題二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "无地无媒只一身，归來空拂滿床塵。",
            "尊前盡日谁相對，唯有南山似故人。",
            "玄發侵愁忽似翁，暖塵寒袖共東风。",
            "公卿門戶不知處，立馬九衢春影中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 24
    },
    {
        "title": "出試日独游曲江",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "江莎漸映花邊綠，樓日自開池上春。",
            "雙鶴繞空來又去，不知臨水有愁人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 25
    },
    {
        "title": "題曹娥廟",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "青娥埋沒此江濱，江樹颼飀慘暮雲。",
            "文字在碑碑已墮，波濤辜負色絲文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 26
    },
    {
        "title": "題段氏中台",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "看山台下水无塵，碧筱前頭曲水春。",
            "独對一尊风雨夜，不知家有早朝人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 27
    },
    {
        "title": "華州座中獻盧給事",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "送迎皆到三峰下，滿面煙霜滿馬塵。",
            "自是追攀認知己，青雲不假送迎人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 28
    },
    {
        "title": "商山道中",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "和如春色淨如秋，五月商山是勝遊。",
            "當晝火雲生不得，一溪縈作万重愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 29
    },
    {
        "title": "贈歙州妓",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "灩灩橫波思有餘，庾樓明月墮雲初。",
            "揚州寒食春风寺，看遍花枝盡不如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 30
    },
    {
        "title": "贈王明府",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "五柳逢秋影漸微，陶潛戀酒不知归。",
            "但存物外醉鄉在，谁向人間问是非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 31
    },
    {
        "title": "呂校书雨中見訪",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "竹閣斜溪小檻明，惟君來賞見山情。",
            "馬嘶风雨又归去，独聽子規千万聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 32
    },
    {
        "title": "千秋嶺下",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "知有岩前万樹桃，未逢搖落思空勞。",
            "年年盛發无人見，三十六溪春水高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 33
    },
    {
        "title": "歙州道中僕逃",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "去跳风雨幾奔波，曾共辛勤奈若何。",
            "莫遣窮归不知處，秋山重疊戍旗多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 34
    },
    {
        "title": "重阳日寄韋舍人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "節過重阳菊委塵，江邊病起杖扶身。",
            "不知此日龍山會，谁是风流落帽人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 35
    },
    {
        "title": "贈薛勳下第",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "一擲雖然未得盧，驚人不用繞床呼。",
            "牢之坐被青雲逼，只问君能酷似无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 36
    },
    {
        "title": "宛陵望月寄沈學士",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "一川如画敬亭東，待詔闲遊處處同。",
            "天竺山前鏡湖畔，何如今日庾樓中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 37
    },
    {
        "title": "翡翠岩",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "芙蓉幕裏千場醉，翡翠岩前半日閑。",
            "惆悵晉朝人不到，謝公拋力上東山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 38
    },
    {
        "title": "發新安後途中寄盧中丞二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "樓上风流庾使君，笙歌曾醉此中闻。",
            "目前已是陵阳路，回首叢山滿眼雲。",
            "晚樹蕭蕭促織愁，风簾似水滿床秋。",
            "千山不礙笙歌月，谁伴羊公上夜樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 39
    },
    {
        "title": "留題興唐寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "滿水樓臺滿寺山，七年今日共躋攀。",
            "月高對菊问行客，去折芳枝早晚還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 40
    },
    {
        "title": "廣陵道",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "鬥雞台邊花照塵，煬帝陵下水含春。",
            "青雲回翅北归雁，白首哭途何處人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 41
    },
    {
        "title": "茅山道中",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "溪樹重重水乱流，馬嘶残雨晚程秋。",
            "門前便是仙山路，目送归雲不得遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 42
    },
    {
        "title": "江上与兄別",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "楚國湘江两渺彌，暖川晴雁背帆飛。",
            "人間離別盡堪哭，何況不知何日归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 43
    },
    {
        "title": "落第",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "九陌初晴處處春，不能回避看花塵。",
            "由來得喪非吾事，本是釣魚船上人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 44
    },
    {
        "title": "宛陵館冬青樹",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "碧樹如煙覆晚波，清秋欲盡客重過。",
            "故園亦有如煙樹，鴻雁不來风雨多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 45
    },
    {
        "title": "贈五老韓尊師",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "有客齋心事玉晨，對山須鬢綠无塵。",
            "住山道士年如鶴，應识當时五老人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 46
    },
    {
        "title": "經汾阳舊宅",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "門前不改舊山河，破虜曾輕馬伏波。",
            "今日独經歌舞地，古槐疏冷夕阳多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 47
    },
    {
        "title": "寄盧中丞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "葉覆清溪灩灩紅，路橫秋色馬嘶风。",
            "独攜一榼郡齋酒，吟對青山憶謝公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 48
    },
    {
        "title": "途中",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "故園回首雁初來，馬上千愁付一杯。",
            "惟有新诗似相识，暮山吟處共徘徊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 49
    },
    {
        "title": "寄裴瀾",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "綺雲初墮亭亭月，錦席惟橫灩灩波。",
            "宋玉逢秋正高臥，一篇吟盡奈情何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 50
    },
    {
        "title": "淮南丞相坐贈歌者虞姹",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "綺筵无處避梁塵，虞姹清歌日日新。",
            "來值渚亭花欲盡，一聲留得滿城春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 51
    },
    {
        "title": "酬段侍禦",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "蓮花上客思閑閑，數首新诗到篳關。",
            "吟得楚天风雨霽，一條江水两三山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 52
    },
    {
        "title": "尋僧二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "台殿參差日墮塵，塢西归去一庵雲。",
            "寒泉何處夜深落，聲隔半岩疏葉闻。",
            "溪戶无人谷鳥飛，石橋橫木掛禪衣。",
            "看雲日暮倚松立，野水乱鳴僧未归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 53
    },
    {
        "title": "發柏梯寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "一泓秋水千竿竹，靜得勞生半日身。",
            "犹有向西无限地，別僧騎馬入紅塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 54
    },
    {
        "title": "西江晚泊",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "茫茫靄靄失西東，柳浦桑村處處同。",
            "戍鼓一聲帆影盡，水禽飛起夕阳中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 55
    },
    {
        "title": "南池",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "照影池邊多少愁，往來重見此塘秋。",
            "芙蓉苑外新經雨，紅葉相隨何處流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 56
    },
    {
        "title": "南園",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雨過郊園綠尚微，落花惆悵滿塵衣。",
            "芳尊有酒无人共，日暮看山還独归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 58
    },
    {
        "title": "南亭",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "孤亭影在乱花中，悵望无人此醉同。",
            "聽盡暮鐘犹独坐，水邊襟袖起春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 59
    },
    {
        "title": "贈女仙",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "水思雲情小鳳仙，月涵花態语如弦。",
            "不因金骨三清客，谁识吳州有洞天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 60
    },
    {
        "title": "宣州送判官",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "來时健筆佐嫖姚，去折槐花度野橋。",
            "谁見尊前此惆悵，一聲歌盡路迢迢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 61
    },
    {
        "title": "宿僧院",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "月滿長空樹滿霜，度雲低拂近簷床。",
            "林中夜半一聲磬，臥見高僧入道場。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 62
    },
    {
        "title": "尋僧",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "斜日橫窗起暗塵，水邊門戶閉閑春。",
            "千竿竹裏花枝動，只道无人似有人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 63
    },
    {
        "title": "經王先生故居",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "晚波東去海茫茫，谁识蓬山不死鄉。",
            "弄玉已归蕭史去，碧樓紅樹倚斜阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 64
    },
    {
        "title": "送從翁中丞奉使黠戛斯六首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "揚雄詞賦舉天闻，万里油幢照塞雲。",
            "僕射峰西幾千騎，一时迎著漢将军。",
            "旌旗杳杳雁蕭蕭，春盡窮沙雪未消。",
            "料得堅昆受宣後，始知公主已归朝。",
            "雖言窮北海雲中，屬國當时事不同。",
            "九姓如今盡臣妾，归期那肯待秋风。",
            "牢山望斷絕塵氛，灩灩河西拂地雲。",
            "谁見魯儒持漢節，玉關降盡可汗军。",
            "山川險易接胡塵，秦漢圖來或未真。",
            "自此盡知邊塞事，河湟更欲托何人。",
            "秦皇无策建長城，劉氏仍窮北路兵。",
            "若遇單于舊牙帳，卻應傷歎漢公卿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 65
    },
    {
        "title": "東亭柳",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "拂水斜煙一万條，幾隨春色倚河橋。",
            "不知別後谁攀折，犹自风流勝舞腰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 66
    },
    {
        "title": "僧舍二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "只言雙鬢未蹉跎，独奈牛羊送日何。",
            "禪客不归車馬去，晚簷山色為谁多。",
            "溪上禪關水木間，水南山色与僧閑。",
            "春风盡日无來客，幽磬一聲高鳥還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 67
    },
    {
        "title": "新月",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "玉鉤斜傍画簷生，雲匣初開一寸明。",
            "何事最能悲少婦，夜來依約落邊城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 68
    },
    {
        "title": "贈皇甫垣",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "養由弓箭已无功，牢落生涯事事同。",
            "相勸一杯寒食酒，幾多辛苦到春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 69
    },
    {
        "title": "四祖寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "千株松下雙峰寺，一盞燈前万里身。",
            "自為心猿不調伏，祖師元是世間人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 70
    },
    {
        "title": "聽蟬",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "噪蟬聲乱日初曛，弦管樓中永不闻。",
            "独奈愁人數莖發，故園秋隔五湖雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 71
    },
    {
        "title": "寄遠",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "禁鐘聲盡見棲禽，關塞迢迢故國心。",
            "无限春愁莫相问，落花流水洞房深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 72
    },
    {
        "title": "池上",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "正怜佳月夜深坐，池上暖回燕雁聲。",
            "犹有漁舟系江岸，故人归盡独何情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 73
    },
    {
        "title": "春日书懷",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "暖鶯春日舌難窮，枕上愁生曉聽中。",
            "應嫋綠窗残夢斷，杏園零落滿枝风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 74
    },
    {
        "title": "贈別",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "水邊秋草暮萋萋，欲駐残阳恨馬蹄。",
            "曾是管弦同醉伴，一聲歌盡各東西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 75
    },
    {
        "title": "靈岩寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "館娃宮伴千年寺，水闊雲多客到稀。",
            "闻说春來更惆悵，百花深處一僧归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 76
    },
    {
        "title": "代人聽琴二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "抱琴花夜不勝春，独奏相思淚滿巾。",
            "第五指中心最恨，數聲嗚咽為何人。",
            "湘娥不葬九疑雲，楚水連天坐憶君。",
            "惟有啼烏舊名在，忍教嗚咽夜長闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 77
    },
    {
        "title": "訪沈舍人不遇",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "溪翁強訪紫微郎，曉鼓聲中滿鬢霜。",
            "知在禁闈人不見，好风飄下九天香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 78
    },
    {
        "title": "座上獻元相公",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "寂寞堂前日又曛，阳臺去作不归雲。",
            "從來闻说沙吒利，今日青娥屬使君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 79
    },
    {
        "title": "遣興二首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "溪花入夏漸稀疏，雨氣如秋麥熟初。",
            "終日苦吟人不會，海邊兄弟久无书。",
            "讀徹残书弄水回，暮天何處笛聲哀。",
            "花前独立无人會，依舊去年雙燕來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 80
    },
    {
        "title": "送李給事",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "眼前軒冕是鴻毛，天上人間漫自勞。",
            "脫卻朝衣独归去，青雲不及白雲高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 81
    },
    {
        "title": "宿僧舍",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "高僧夜滴芙蓉漏，遠客窗含楊柳风。",
            "何處相逢話心地，月明身在磬聲中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 82
    },
    {
        "title": "吳門夢故山",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "心熟家山夢不迷，孤峰寒繞一條溪。",
            "秋窗覺後情无限，月墮館娃宮樹西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 83
    },
    {
        "title": "別李譜",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "尊前路映暮塵紅，池上琴橫醉席风。",
            "今日別君如別鶴，聲容長在楚弦中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 84
    },
    {
        "title": "和杜侍郎題禪智寺南樓",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "樓畔花枝拂檻紅，露天香動滿簾风。",
            "谁知野寺遺鈿處，盡在相如春思中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 85
    },
    {
        "title": "發青山",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "鳧鷖聲暖野塘春，鞍馬嘶风驛路塵。",
            "一宿青山又前去，古來難得是闲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 86
    },
    {
        "title": "入藍關",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "微煙已辨秦中樹，遠夢更依江上臺。",
            "看落晚花還悵望，鯉魚时節入關來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 87
    },
    {
        "title": "落第寄沈詢",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "穿楊力盡独无功，華发相期一夜中。",
            "別到江頭舊吟處，為将雙淚问春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 88
    },
    {
        "title": "送韋中丞",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "二年恩意是春輝，清淨胸襟似者希。",
            "泣盡楚人多少淚，滿船唯载酒西归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 89
    },
    {
        "title": "詠端正春樹",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "一樹繁阴先著名，異花奇葉儼天成。",
            "馬嵬此去无多地，只合楊妃墓上生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 90
    },
    {
        "title": "敘事獻同州侍禦三首",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "青雲席中羅襪塵，白首江上吟诗人。",
            "登龍不及三千士，虛度膺門二十春。",
            "平生望斷雲層層，紫府杳是他人登。",
            "卻應归訪溪邊寺，说向當时同社僧。",
            "尊前谁伴謝公游，蓮嶽晴來翠滿樓。",
            "坐見一方金變化，独吟紅药對残秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 91
    },
    {
        "title": "婺州宴上留別",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雙溪樓影向雲橫，歌舞高臺晚更清。",
            "独自下樓騎瘦馬，搖鞭重入乱蟬聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 92
    },
    {
        "title": "別牛郎中門館",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "整襟收淚別朱門，自料難酬顧念恩。",
            "招得片魂騎匹馬，西风斜日入秋原。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 93
    },
    {
        "title": "山中寄盧簡求",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "竹西池上有花開，日日幽吟看又回。",
            "心憶郡中蕭記室，何时暫別醉鄉來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 94
    },
    {
        "title": "寄梁佾兄弟",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "桃李春多翠影重，竹樓當月夜无风。",
            "荀家兄弟來還去，独倚欄幹花露中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 95
    },
    {
        "title": "同州南亭陪劉侍郎送劉先輩",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "處處雲隨晚望開，洞庭秋水管弦來。",
            "謝公待醉消離恨，莫惜臨川酒一杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 96
    },
    {
        "title": "贈館驛劉巡官",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "雲別青山馬踏塵，負才難覓作闲人。",
            "莫言館驛无公事，诗酒能消一半春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 97
    },
    {
        "title": "贈解頭賈嵩",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "賈生名跡忽无倫，十月長安看盡春。",
            "顧我先鳴還自笑，空沾一第是何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 98
    },
    {
        "title": "題僧壁",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "曉望疏林露滿巾，碧山秋寺屬闲人。",
            "溪頭盡日看紅葉，卻笑高僧衣有塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 99
    },
    {
        "title": "沙溪館",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "翠濕衣襟山滿樓，竹間溪水繞床流。",
            "行人莫羨郵亭吏，生向此中今白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 100
    },
    {
        "title": "李侍禦归炭谷山居，同宿華嚴寺",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "家在青山近玉京，日雲紅樹滿归程。",
            "相逢一宿最高寺，半夜翠微泉落聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 101
    },
    {
        "title": "過噴玉泉",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "平生半為山淹留，馬上欲去還回頭。",
            "两京塵路一雙鬢，不見玉泉千万秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 102
    },
    {
        "title": "漢阴庭樹",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "掘溝引水澆蔬圃，插竹為籬護药苗。",
            "楊柳如絲风易乱，梅花似雪日難消。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 103
    },
    {
        "title": "送王龜拾遺謝官後归滻水山居",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "水邊残雪照亭台，台上风襟向雪開。",
            "還似當时姓丁鶴，羽毛成後一归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 104
    },
    {
        "title": "宿長水主人",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "白雲溪北叢岩東，樹石夜与潺湲通。",
            "行人一宿翠微月，二十五弦聲滿风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 105
    },
    {
        "title": "寒食離白沙",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "莫驚客路已經年，尚有青春一半妍。",
            "試上方坦望春野，万條楊柳拂青天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 106
    },
    {
        "title": "将發循州社日于所居館宴送",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "浪花如雪疊江风，社過高秋万恨中。",
            "明日便隨江燕去，依依俱是故巢空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 107
    },
    {
        "title": "句",
        "author": "趙嘏",
        "biography": "",
        "paragraphs": [
            "浮雲悲晚翠，落日泣秋风。。",
            "语风雙燕立，嫋樹百勞飛。",
            "松島鶴归书信絕，橘洲风起夢魂香。",
            "徒知六國隨斤斧，莫有群儒定是非。（題秦皇句，",
            "一千里色中秋月，十万军聲半夜潮。。",
            "梁王舊館已秋色，珠履少年輕繡衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十",
        "no#": 108
    }
]