[
    {
        "title": "山居",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "雪消春力展，花漫洞門垂。果長纖枝曲，岩崩直道移。",
            "重猿圍淺井，鬥鼠下疏籬。寒食微燈在，高风勢徹陂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 1
    },
    {
        "title": "贈樊川長老",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "瘦顏顴骨見，滿面雪毫垂。坐石鳥疑死，出門人謂癡。",
            "照身潭入楚，浸影檜生隋。太白曾經夏，清风涼四肢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 2
    },
    {
        "title": "寄積麥山會如長老",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "默然如大道，塵世不相關。青檜行时靜，白雲禪处閑。",
            "貧高一生行，病長十年顏。夏滿期遊寺，尋山又下山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 3
    },
    {
        "title": "送僧",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "四海无拘系，行心興自濃。百年三事衲，万里一枝筇。",
            "夜減當晴影，春消過雪蹤。白雲深处去，知宿在何峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 4
    },
    {
        "title": "哭賈島",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "燕生松雪地，蜀死葬山根。诗僻降今古，官卑誤子孫。",
            "塚欄寒月色，人哭苦吟魂。墓雨滴碑字，年年添蘚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 5
    },
    {
        "title": "雪十二韵",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "落处咸過尺，翛然物象淒。瑞凝金殿上，寒甚玉關西。",
            "潤比江河普，明将日月齊。淩雲花頂膩，鎖徑竹梢低。",
            "出谷樵童怯，归林野鳥迷。煮茶融破練，磨墨染成黳。",
            "陷兔埋平澤，和魚凍合溪。入樓消酒力，當檻写诗題。",
            "道路依凭馬，朝昏委託雞。洞深猿作族，松亞鶴移棲。",
            "及夏清岩穴，經春溜石梯。豐年兼泰國，天道育黔黎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 6
    },
    {
        "title": "精舍遇雨",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "空門寂寂淡吾身，溪雨微微洗客塵。",
            "臥向白雲情未盡，任他黃鳥醉芳春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 7
    },
    {
        "title": "小雪",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "落雪臨风不厭看，更多還恐蔽林巒。",
            "愁人正在书窗下，一片飛來一片寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 8
    },
    {
        "title": "送婆羅門僧",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "雪嶺金河独向東，吳山楚澤意无窮。",
            "如今白首鄉心盡，万里归程在夢中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 9
    },
    {
        "title": "句",
        "author": "可止",
        "biography": "",
        "paragraphs": [
            "不知谁會喃喃语，必向王前報太平。（中山節度王处直座",
            "詠白鵲，时諸侯兼併，王欲繼好息民，故雲。《高僧傳》）"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 10
    },
    {
        "title": "寒食日",
        "author": "雲表",
        "biography": "",
        "paragraphs": [
            "寒食悲看郭外春，野田无处不傷神。",
            "平原累累添新塚，半是去年來哭人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 11
    },
    {
        "title": "自遣",
        "author": "归仁",
        "biography": "",
        "paragraphs": [
            "日日為诗苦，谁論春与秋。一聯如得意，万事總忘憂。",
            "雨墮花臨砌，风吹竹近樓。不吟頭也白，任白此生頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 12
    },
    {
        "title": "酬沈先輩卷",
        "author": "归仁",
        "biography": "",
        "paragraphs": [
            "一百八十首，清泠韵可敲。任從人不愛，終是我難拋。",
            "桂魄吟來滿，蒲團坐得凹。先生聲價在，寰宇幾人抄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 13
    },
    {
        "title": "題賈島吟诗台",
        "author": "归仁",
        "biography": "",
        "paragraphs": [
            "此台如可廢，此恨有谁平。縱使迷青草，終難沒舊名。",
            "天悲朝雨色，嶽哭夜猿聲。不是心偏苦，應關自古情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 14
    },
    {
        "title": "悼羅隱",
        "author": "归仁",
        "biography": "",
        "paragraphs": [
            "一著讒书未快心，幾抽胸臆縱狂吟。管中窺豹我犹在，",
            "長安冠蓋皆塗地，仍喜先生葬碧岑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 15
    },
    {
        "title": "題楚廟",
        "author": "归仁",
        "biography": "",
        "paragraphs": [
            "羞容難更返江東，谁问從來百戰功。天地有心归道德，",
            "也是男兒成敗事，不須惆悵对西风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 16
    },
    {
        "title": "牡丹",
        "author": "归仁",
        "biography": "",
        "paragraphs": [
            "三春堪惜牡丹奇，半倚朱欄欲綻时。天下更无花勝此，",
            "除卻解禪心不動，算應狂殺五陵兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 17
    },
    {
        "title": "舊國裏",
        "author": "卿雲",
        "biography": "",
        "paragraphs": [
            "舊居梨嶺下，风景近炎方。地暖生春早，家貧觉歲長。",
            "石房雲過濕，杉徑雨餘香。日夕竟无事，诗书聊自強。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 18
    },
    {
        "title": "秋日江居閑詠",
        "author": "卿雲",
        "biography": "",
        "paragraphs": [
            "寄居江島邊，閑詠見秋残。草白牛羊瘦，风高猿鳥寒。",
            "檢方醫故疾，挑薺備中餐。时複停书卷，鉏莎種木蘭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 19
    },
    {
        "title": "長安言懷寄沈彬侍郎",
        "author": "卿雲",
        "biography": "",
        "paragraphs": [
            "故園梨嶺下，归路接天涯。生作長安草，勝為邊地花。",
            "雁南飛不到，书北寄來賒。堪羨神仙客，青雲早致家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 20
    },
    {
        "title": "送人遊塞",
        "author": "卿雲",
        "biography": "",
        "paragraphs": [
            "去去玉關路，省君曾未行。塞深多伏寇，时靜亦屯兵。",
            "雪每先秋降，花嘗近夏生。閑陪射雕将，應到受降城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 21
    },
    {
        "title": "逢老人",
        "author": "隱巒",
        "biography": "",
        "paragraphs": [
            "路逢一老翁，两鬢白如雪。一裏二裏行，四回五回歇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 22
    },
    {
        "title": "牧童",
        "author": "隱巒",
        "biography": "",
        "paragraphs": [
            "牧童見人俱不识，盡著芒鞋戴箬笠。朝阳未出眾山晴，",
            "三個五個騎羸牛，前村后村來放牧。笛聲才一舉，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 23
    },
    {
        "title": "蜀中送人遊廬山",
        "author": "隱巒",
        "biography": "",
        "paragraphs": [
            "居遊正值芳春月，蜀道千山皆秀发。溪邊十裏五裏花，",
            "君行試到山前问，山鳥只今相憶无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 24
    },
    {
        "title": "琴",
        "author": "隱巒",
        "biography": "",
        "paragraphs": [
            "七條絲上寄深意，澗水松风生十指。",
            "自乃知音犹尚稀，欲教更入何人耳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 25
    },
    {
        "title": "浮橋",
        "author": "隱巒",
        "biography": "",
        "paragraphs": [
            "橫壓驚波防沒溺，當初元創是军机。",
            "行人到此全无滯，一片江雲踏欲飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 26
    },
    {
        "title": "宿九華化成寺莊",
        "author": "泠然",
        "biography": "",
        "paragraphs": [
            "佛寺孤莊千嶂間，我來诗境強相關。岩邊樹動猿下澗，",
            "明朝更躡層霄去，誓共煙霞到老閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 27
    },
    {
        "title": "乞荊浩画",
        "author": "大愚",
        "biography": "",
        "paragraphs": [
            "六幅故牢健，知君恣筆蹤。不求千澗水，止要两株松。",
            "樹下留磐石，天邊縱遠峰。近岩幽濕处，惟藉墨煙濃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 28
    },
    {
        "title": "上归州刺史代通狀二首",
        "author": "懷浚",
        "biography": "",
        "paragraphs": [
            "家在閩山西複西，其中歲歲有鶯啼。",
            "如今不在鶯啼处，鶯在舊时啼处啼。",
            "家在閩山東複東，其中歲歲有花紅。",
            "而今不在花紅处，花在舊时紅处紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 29
    },
    {
        "title": "辭郡守李公恩命",
        "author": "恒超",
        "biography": "",
        "paragraphs": [
            "虛著褐衣老，浮杯道不成。誓傳經論死，不染利名生。",
            "厭樹遮山色，怜窗向月明。他时隨範蠡，一棹五湖清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 30
    },
    {
        "title": "題廣愛寺楞伽山",
        "author": "淨顯",
        "biography": "",
        "paragraphs": [
            "靈異不能棲鳥雀，幽奇終不著猿猱。為經巢賊應无損，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 31
    },
    {
        "title": "《闻誦法華經》歌",
        "author": "修雅",
        "biography": "",
        "paragraphs": [
            "山色沉沉，松煙冪冪。空林之下，盤陀之石。石上有僧，",
            "十片五片，異花狼藉。偶然相見，未深相识。知是古之人，",
            "佛之意兮祖之髓，我之心兮經之旨。可怜彈指及舉手，",
            "光輝一万八千土，土土皆作黃金色。四生六道一光中，",
            "今日親闻誦此經，始觉驢乘匪端的。我亦當年不出戶，",
            "我亦當年愛吟詠，将謂冥搜乱神定。今日親闻誦此經，",
            "今日親闻誦此經，始觉聚沙非小事。我昔曾游山与水，",
            "我昔心猿未調伏，常将金鎖虛拘束。今日親闻誦此經，",
            "醍醐之味珍且美，不在唇，不在齒，只在勞生方寸裏。",
            "師誦此經經一句，句句白牛親動步。白牛之步疾如风，",
            "世人縱识師之形，谁人能识師之名。師名醫王行佛令，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 32
    },
    {
        "title": "歌",
        "author": "元寂",
        "biography": "",
        "paragraphs": [
            "酒禿酒禿，何榮何辱。但見衣冠成古丘，不見江河變陵谷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 33
    },
    {
        "title": "懷廬山舊隱",
        "author": "若虛",
        "biography": "",
        "paragraphs": [
            "九疊嵯峨倚著天，悔隨寒瀑下岩煙。深秋猿鳥來心上，",
            "一枝筇竹遊江北，不見爐峰二十年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 34
    },
    {
        "title": "樂仙觀",
        "author": "若虛",
        "biography": "",
        "paragraphs": [
            "樂氏騎龍上碧天，東吳遺宅尚依然。悟來大道无多事，",
            "松傾鶴死桑田變，華表归鄉未有年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 35
    },
    {
        "title": "古鏡",
        "author": "若虛",
        "biography": "",
        "paragraphs": [
            "軒后紅爐独鑄成，蘚痕磨落月輪呈。万般物象皆能鑒，",
            "百年肝膽堪将比，只怕看频素發生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 36
    },
    {
        "title": "睹木平和尚",
        "author": "文益",
        "biography": "",
        "paragraphs": [
            "木平山裏人，貌古年複少。相看陌路同，論心秋月皎。",
            "懷衲線非蠶，助歌聲有鳥。城闕今日來，一謳曾已曉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 37
    },
    {
        "title": "鹭鷥",
        "author": "无則",
        "biography": "",
        "paragraphs": [
            "白蘋紅蓼碧江涯，日暖雙雙立睡时。",
            "愿揭金籠放归去，卻隨沙鶴鬥輕絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 38
    },
    {
        "title": "百舌鳥二首",
        "author": "无則",
        "biography": "",
        "paragraphs": [
            "千愁万恨過花时，似向春风怨別離。",
            "若使眾禽俱解语，一生懷抱有谁知。",
            "長截鄰雞叫五更，数般名字百般聲。",
            "饒伊搖舌先知曉，也待青天明即鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 39
    },
    {
        "title": "賞牡丹應教",
        "author": "謙光",
        "biography": "",
        "paragraphs": [
            "擁衲对芳叢，由來事不同。鬢從今日白，花似去年紅。",
            "豔異隨朝露，馨香逐曉风。何須对零落，然后始知空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十五",
        "no#": 40
    }
]