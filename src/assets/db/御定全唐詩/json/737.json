[
    {
        "title": "天道",
        "author": "馮道",
        "biography": "",
        "paragraphs": [
            "窮達皆由命，何勞發歎聲。但知行好事，莫要问前程。",
            "冬去冰須泮，春來草自生。請君觀此理，天道甚分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 1
    },
    {
        "title": "偶作",
        "author": "馮道",
        "biography": "",
        "paragraphs": [
            "莫為危时便愴神，前程往往有期因。須知海嶽归明主，",
            "但教方寸无諸惡，狼虎叢中也立身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 2
    },
    {
        "title": "北使還京作",
        "author": "馮道",
        "biography": "",
        "paragraphs": [
            "去年今日奉皇華，只為朝廷不為家。殿上一杯天子泣，",
            "上下一行如骨肉，幾人身死掩风沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 3
    },
    {
        "title": "贈竇十",
        "author": "馮道",
        "biography": "",
        "paragraphs": [
            "燕山竇十郎，教子有義方。靈椿一株老，丹桂五枝芳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 4
    },
    {
        "title": "放魚书所鑰戶",
        "author": "馮道",
        "biography": "",
        "paragraphs": [
            "高卻垣牆鑰卻門，監丞從此罷垂綸。",
            "池中魚鱉應相賀，從此方知有主人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 5
    },
    {
        "title": "句",
        "author": "馮道",
        "biography": "",
        "paragraphs": [
            "朝披四襖專藏手，夜覆三衾怕露頭。（虜中大寒，",
            "牛頭偏得賜，象笏更容持。（虜以道有重名，欲留之，",
            "牛頭，皆殊禮也，道皆得之，以诗謝。以上見《叢苑》）",
            "已落地花方遣掃，未經霜草莫教鋤。（《吟治圃》，",
            "視草北來唐學士，擁旄西去漢将军。（《同光中承旨盧",
            "質節制河中贈》，見《续翰林志》）"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 6
    },
    {
        "title": "后唐宗廟樂舞辭",
        "author": "盧文紀",
        "biography": "",
        "paragraphs": [
            "仁君禦宇，寰海謐清。运符武德，道協文明。",
            "九成式敘，百度惟成。金門積慶，玉葉傳榮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 7
    },
    {
        "title": "后唐宗廟樂舞辭",
        "author": "崔居儉",
        "biography": "",
        "paragraphs": [
            "艱難王业，返正皇唐。先天再造，卻日重光。",
            "漢紹世祖，夏資少康。功成德茂，率祀无疆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 8
    },
    {
        "title": "春社從李昉乞酒",
        "author": "李濤1",
        "biography": "",
        "paragraphs": [
            "社公今日沒心情，為乞治聾酒一瓶。",
            "惱乱玉堂将欲遍，依稀巡到第三廳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 9
    },
    {
        "title": "句",
        "author": "李濤1",
        "biography": "",
        "paragraphs": [
            "溪聲長在耳，山色不離門。",
            "掃地樹留影，拂床琴有聲。",
            "一言寤主寧複聽，三諫不從归去來。（《諫晉主不從作》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 10
    },
    {
        "title": "靈溪老松歌",
        "author": "盧士衡",
        "biography": "",
        "paragraphs": [
            "靈溪古觀壇西角，千尺鱗皴棟樑樸。橫出一枝戛樓閣，",
            "有时风雨晦暝，擺撼若黑龍之騰躍。合生於象外峰巒，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 11
    },
    {
        "title": "遊靈溪觀",
        "author": "盧士衡",
        "biography": "",
        "paragraphs": [
            "雲藏寶殿风塵外，粉壁松軒入看初。話久仙童顏色老，",
            "不為壯心降未得，便堪從此玩清虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 12
    },
    {
        "title": "寄天臺道友",
        "author": "盧士衡",
        "biography": "",
        "paragraphs": [
            "相思遙指玉霄峰，悵望江山阻万重。會隔曉窗闻法鼓，",
            "且住人間行圣教，莫思天路便登龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 13
    },
    {
        "title": "花落",
        "author": "盧士衡",
        "biography": "",
        "paragraphs": [
            "迎风嘯未已，和雨落谷谷。千枝与万枝，不如一竿竹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 14
    },
    {
        "title": "鐘陵鐵柱",
        "author": "盧士衡",
        "biography": "",
        "paragraphs": [
            "千年埋沒竟何為，變化宜将万物齊。",
            "安得风胡借方便，鑄成神劍斬鯨鯢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 15
    },
    {
        "title": "僧房聽雨",
        "author": "盧士衡",
        "biography": "",
        "paragraphs": [
            "古寺松軒雨聲別，寒窗聽久诗魔發。",
            "記得年前在赤城，石樓夢觉三更雪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 16
    },
    {
        "title": "題牡丹",
        "author": "盧士衡",
        "biography": "",
        "paragraphs": [
            "万葉紅綃剪盡春，丹青任写不如真。",
            "风光九十无多日，難惜尊前折贈人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 17
    },
    {
        "title": "祖龍詞",
        "author": "熊皦",
        "biography": "",
        "paragraphs": [
            "平吞六國更何求，童女童男问十洲。",
            "滄海不回應悵望，始知徐福解风流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 18
    },
    {
        "title": "謫居海上",
        "author": "熊皦",
        "biography": "",
        "paragraphs": [
            "家臨涇水隔秦川，來往關河路八千。",
            "堪恨此身何处老，始皇橋畔又經年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 19
    },
    {
        "title": "冬日原居酬光上人見訪",
        "author": "熊皎",
        "biography": "",
        "paragraphs": [
            "吾道喪已久，吾師何此來。門无塵事閉，卷有國风開。",
            "野迥霜先白，庭荒葉自堆。寒暄吟罷后，犹喜話天臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 20
    },
    {
        "title": "早梅",
        "author": "熊皎",
        "biography": "",
        "paragraphs": [
            "江南近臘时，已亞雪中枝。一夜欲開盡，百花犹未知。",
            "人情皆共惜，天意欲教迟。莫訝无濃豔，芳筵正好吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 21
    },
    {
        "title": "懷三茅道友",
        "author": "熊皎",
        "biography": "",
        "paragraphs": [
            "塵事何年解客嘲，十年容易到三茅。長思碧洞雲窗下，",
            "杏壇仙侶應相笑，只為浮名未肯拋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 22
    },
    {
        "title": "贈胥尊師",
        "author": "熊皎",
        "biography": "",
        "paragraphs": [
            "綠發童顏羽服輕，天臺王屋幾經行。雲程去速因风起，",
            "他年華表重归日，卻恐桑田已變更。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 23
    },
    {
        "title": "句",
        "author": "熊皎",
        "biography": "",
        "paragraphs": [
            "山前犹見月，陌上未逢人。",
            "果熟秋先落，禽寒夜未棲。",
            "深逢野草皆為药，靜見樵人恐是仙。",
            "厭聽啼鳥夢醒后，慵掃落花春盡时。",
            "廢土有人耕不畏，古廳无訟醉何妨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 24
    },
    {
        "title": "塞上",
        "author": "趙延壽",
        "biography": "",
        "paragraphs": [
            "黃沙风卷半空拋，雲動阴山雪滿郊。探水人回移帳就，",
            "占得高原肥草地，夜深生火折林梢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 25
    },
    {
        "title": "棋",
        "author": "高輦",
        "biography": "",
        "paragraphs": [
            "野客圍棋坐，支頤向暮秋。不言如守默，設计似平讎。",
            "決勝雖關勇，防危亦合憂。看他終一局，白卻少年頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 26
    },
    {
        "title": "句",
        "author": "高輦",
        "biography": "",
        "paragraphs": [
            "飄飄送下遙天雪，颯颯吹幹旅舍煙。（《冬风》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 27
    },
    {
        "title": "与李專美",
        "author": "韓昭裔",
        "biography": "",
        "paragraphs": [
            "昭裔登庸汝未登，鳳池雞樹冷如冰。",
            "何如且作宣徽使，免被人呼粥飯僧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 28
    },
    {
        "title": "題龍窩洞",
        "author": "张仁溥",
        "biography": "",
        "paragraphs": [
            "折花攜酒看龍窩，鏤玉長旌俊彥過。",
            "他日各為雲外客，碧紗籠卻又如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 29
    },
    {
        "title": "留題座主和凝舊閣",
        "author": "李瀚1",
        "biography": "",
        "paragraphs": [
            "座主登庸归鳳闕，門生批詔立鼇頭。",
            "玉堂舊閣多珍玩，可作西齋潤筆不。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 30
    },
    {
        "title": "題家園",
        "author": "楊昭儉",
        "biography": "",
        "paragraphs": [
            "池蓮憔悴无顏色，園竹低垂減翠阴。",
            "園竹池蓮莫惆悵，相看恰似主人心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 31
    },
    {
        "title": "书從事廳屏上",
        "author": "劉坦",
        "biography": "",
        "paragraphs": [
            "金殿試回新折桂，将军留辟向江城。",
            "思量一醉犹難得，辜負揚州管記名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 32
    },
    {
        "title": "題施璘画竹图",
        "author": "韋遵",
        "biography": "",
        "paragraphs": [
            "枯籜危根繳石頭，千竿交映近清流。",
            "堪珍仲寶窮幽筆，留得荊湘一片秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十七",
        "no#": 33
    }
]