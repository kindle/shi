[
    {
        "title": "送李員外频之建州",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "勾踐江頭月，客星台畔松。為郎久不見，出守暫相逢。",
            "鳥泊牽灘索，花空押號鐘。遠人思化切，休上武夷峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 1
    },
    {
        "title": "送许棠先輩归宣州",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "發枯窮律韵，字字合塤篪。日月所到处，姓名无不知。",
            "鶯啼謝守壘，苔老謫仙碑。诗道喪來久，東归為吊之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 2
    },
    {
        "title": "窮冬太學",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "投跡依槐館，荒亭草合时。雪深鳶嘯急，薪濕鼎吟迟。",
            "默坐同谁話，非僧不我知。匡廬瀑布畔，何日副心期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 3
    },
    {
        "title": "陪鄭諴郎中假日省中寓直",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "憲廳名最重，假日许從容。床滿諸司印，庭高五粒松。",
            "井尋芸吏汲，茶拆岳僧封。鳥度簾旌暮，犹吟隔苑鐘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 4
    },
    {
        "title": "送謝石先輩归宣州",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "名隨春色遠，湖外已先知。花盡方辭醉，鶯残是放时。",
            "天寒千尺岳，頷白半聯诗。筍蕨犹堪采，榮归及養期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 5
    },
    {
        "title": "下第寄歐阳瓚",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "诗人道僻命多奇，更值干戈乱起时。",
            "莫作江甯王少府，一生吟苦竟谁知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 6
    },
    {
        "title": "寄何紹餘",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "雁過君犹未入城，清賢門下舊知名。风波凍馬遙逢見，",
            "芙蓉苑北曲江岸，期看終南新雪晴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 7
    },
    {
        "title": "送人宰浦城",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "東南犹阻寇，梨嶺更谁登。作宰應无俸，归船必有僧。",
            "灘平眠獺石，燒斷飲猿藤。歲盡校殊最，方當見異能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 8
    },
    {
        "title": "省試臘后望春宮",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "皇都初度臘，鳳輦出深宮。高凭樓臺上，遙瞻灞滻中。",
            "仗凝霜彩白，袍映日華紅。柳眼方開凍，鶯聲漸轉风。",
            "禦溝穿斷靄，驪岫照斜空。时見宸遊興，因觀稼穡功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 9
    },
    {
        "title": "寄省中知己",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "門掩清曹晚，靜将烏府鄰。花開封印早，雪下典衣频。",
            "怪木风吹閣，廢巢时落薪。每怜吾道苦，長说向同人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 10
    },
    {
        "title": "朱坡",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "朱坡坡上望，不似在秦京。漸觉溪山秀，更高魚鳥情。",
            "夜吟禪子室，曉爨獵人鐺。恃此偷佳賞，九衢蜩未鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 11
    },
    {
        "title": "酬陳樵見寄",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "失意閑眠起更迟，又将羈薄謝深知。囊书旋入酒家盡，",
            "元和才子多如此，除卻清吟何所為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 12
    },
    {
        "title": "華清宮",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "殿角鐘残立宿鴉，朝元归駕望无涯。",
            "香泉空浸宮前草，未到春时爭發花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 13
    },
    {
        "title": "終南山",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "標奇聳峻壯長安，影入千門万戶寒。",
            "徒自倚天生气色，塵中谁為舉頭看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 14
    },
    {
        "title": "歌风台",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "蒿棘空存百尺基，酒酣曾唱大风詞。",
            "莫言馬上得天下，自古英雄盡解诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 15
    },
    {
        "title": "送人归日東",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "滄溟西畔望，一望一心摧。地即同正朔，天教阻往來。",
            "波翻夜作電，鯨吼晝為雷。門外人參徑，到时花幾開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 16
    },
    {
        "title": "寓興",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "西母一杯酒，空言浩劫春。英雄归厚土，日月照闲人。",
            "衰草珠璣塚，冷灰龍鳳身。茂陵驪岫晚，過者暗傷神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 17
    },
    {
        "title": "少年行",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "柳煙侵禦道，門映夾城開。白日莫空過，青春不再來。",
            "報仇沖雪去，乘醉臂鷹回。看取歌鐘地，残阳滿壞台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 18
    },
    {
        "title": "塞上還答友人",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "无端遊絕塞，归鬢已蒼然。戎羯圍中過，风沙馬上眠。",
            "草衰频過燒，耳冷不闻蟬。從此甘貧坐，休言更到邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 19
    },
    {
        "title": "哭棲白供奉",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "侍輦才難得，三朝有上人。琢诗方到骨，至死不離貧。",
            "风帳孤螢入，霜階積葉频。夕阳門半掩，過此亦无因。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 20
    },
    {
        "title": "送升道靖恭相公分司",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "東风时不遇，果見致君難。海嶽影犹動，鶤鵬勢未安。",
            "星沉關鎖冷，雞唱驛燈残。谁似二賓客，門閑嵩洛寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 21
    },
    {
        "title": "關下早行",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "軋軋推危轍，聽雞独早行。风吹宿靄散，月照華山明。",
            "白首東西客，黃河晝夜清。相逢皆有事，唯我是闲情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 22
    },
    {
        "title": "曲江",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "曲江初碧草初青，万轂千蹄匝岸行。傾國妖姬雲鬢重，",
            "柳絮杏花留不得，隨风处处逐歌聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 23
    },
    {
        "title": "長安遣懷",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "醉下高樓醒複登，任從浮薄笑才能。",
            "青龍寺裏三門上，立為南山不為僧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 24
    },
    {
        "title": "送僧游太白峰",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "雲深游太白，莫惜遍探奇。頂上多靈跡，塵中少客知。",
            "懸崖倚凍瀑，飛狖過孤枝。出定更何事，相逢必有诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 25
    },
    {
        "title": "哭造微禪師",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "神遷不火葬，新塔露疏檉。是物皆磨滅，唯師出死生。",
            "虛堂散釣叟，怪木哭山精。林下路長在，无因更此行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 26
    },
    {
        "title": "獻同年孔郎中",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "炊瓊爇桂帝關居，賣盡寒衣典盡书。驅馬每尋霜影裏，",
            "一顧深恩身未殺，爭期皎日負吹噓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 27
    },
    {
        "title": "闻雁",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "接影橫空背雪飛，聲聲寒出玉關迟。",
            "上阳宮裏三千夢，月冷风清闻過时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 28
    },
    {
        "title": "送惠補闕",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "詔下搜岩野，高人入竹林。長因抗疏日，便作去官心。",
            "清俸供僧盡，滄洲寄跡深。東門有归路，徒自棄華簪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 29
    },
    {
        "title": "和友人賊后",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "帶號乞兵急，英雄陷賊圍。江山犹未靜，魚鳥欲何归。",
            "城露桑榆盡，时平老幼稀。书從戰后得，讀徹血盈衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 30
    },
    {
        "title": "長安即事",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "暝鼓才終複曉雞，九門何计出沉迷，樵童乱打金吾鼓，",
            "須知不是诗人事，空憶泉聲菊畔畦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 31
    },
    {
        "title": "和周繇校书先輩省中寓直",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "古木重門掩，幽深只欠溪。此中真吏隱，何必更岩棲。",
            "名姓鐫幢記，經书逐庫題。字隨飛蠹缺，階与落星齊。",
            "伴直僧談靜，侵霜蛩韵低。粘塵賀草沒，剝粉薛禽迷。",
            "衰蘚牆千堵，微阳菊半畦。鼓残鴉去北，漏在月沉西。",
            "每憶終南雪，幾登雲閣梯。时因搜句次，那惜一招攜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 32
    },
    {
        "title": "苦雨",
        "author": "林寬",
        "biography": "",
        "paragraphs": [
            "霪霖翳日月，窮巷變溝坑。驟灑纖枝折，奔傾壞堵平。",
            "蒙簦來客絕，躍甃噪蛙獰。敗屐阴苔積，摧簷濕菌生。",
            "斜飛穿裂瓦，迸落打空鐺。葉底迟归蝶，林中滯出鶯。",
            "潤侵书縫黑，冷浸鬢絲明。牖暗參差影，階寒斷续聲。",
            "尺薪功比桂，寸粒價高瓊。遙想管弦裏，无因识此情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百零六",
        "no#": 33
    }
]