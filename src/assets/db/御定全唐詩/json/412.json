[
    {
        "title": "雪后宿同軌店，上法護寺鐘樓望月",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "滿山残雪滿山风，野寺无門院院空。",
            "煙火漸稀孤店靜，月明深夜古樓中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 1
    },
    {
        "title": "陪韋尚书丈归履信宅，因贈韋氏兄弟",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "紫垣騶騎入華居，公子文衣護錦輿。",
            "眠閣书生複何事，也騎羸馬從尚书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 2
    },
    {
        "title": "永貞二年正月二日上御丹鳳樓赦天下予与李公垂庾顺之闲行曲江不及盛觀",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "春來饒夢慵朝起，不看千官擁禦樓。",
            "卻著閑行是忙事，数人同傍曲江頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 3
    },
    {
        "title": "韋居守晚歲常言退休之志因署其居曰大隱洞命予賦诗因贈絕句",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "謝公潛有東山意，已向朱門啟洞門。",
            "大隱犹疑戀朝市，不知名作罷归園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 4
    },
    {
        "title": "贈李十二牡丹花片，因以餞行",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "鶯澀餘聲絮墮风，牡丹花盡葉成叢。",
            "可怜顏色經年別，收取朱闌一片紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 5
    },
    {
        "title": "題李十一修行裏居壁",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "雲闕朝回塵騎合，杏花春盡曲江閑。",
            "怜君雖在城中住，不隔人家便是山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 6
    },
    {
        "title": "靖安窮居",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "喧靜不由居遠近，大都車馬就權門。",
            "野人住处无名利，草滿空階樹滿園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 7
    },
    {
        "title": "贈樂天",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "等闲相見銷長日，也有闲时更學琴。",
            "不是眼前无外物，不關心事不經心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 8
    },
    {
        "title": "使東川：駱口驛二首",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "郵亭壁上数行字，崔李題名王白诗。",
            "盡日无人共言语，不離牆下至行时。",
            "二星徼外通蠻服，五夜燈前草禦文。",
            "我到東川恰相半，向南看月北看雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 9
    },
    {
        "title": "使東川：清明日",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "常年寒食好风輕，觸处相隨取次行。",
            "今日清明漢江上，一身騎馬縣官迎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 10
    },
    {
        "title": "使東川：亞枝紅",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "平阳池上亞枝紅，悵望山郵事事同。",
            "還向万竿深竹裏，一枝渾臥碧流中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 11
    },
    {
        "title": "使東川：梁州夢",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "夢君同繞曲江頭，也向慈恩院院遊。",
            "亭吏呼人排去馬，所驚身在古梁州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 12
    },
    {
        "title": "使東川：南秦雪",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "帝城寒盡臨寒食，駱谷春深未有春。才見嶺頭雲似蓋，",
            "飛鳥不飛猿不動，青驄禦史上南秦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 13
    },
    {
        "title": "使東川：江樓月",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "嘉陵江岸驛樓中，江在樓前月在空。月色滿床兼滿地，",
            "万一帝鄉還潔白，幾人潛傍杏園東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 14
    },
    {
        "title": "使東川：慚问囚",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "司馬子微壇上頭，与君深結白雲儔。尚平村落擬連買，",
            "那知今日蜀門路，帶月夜行緣问囚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 15
    },
    {
        "title": "使東川：江上行",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "悶見漢江流不息，悠悠漫漫竟何成。",
            "江流不语意相问，何事遠來江上行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 16
    },
    {
        "title": "使東川：漢江上笛",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "小年為写游梁賦，最说漢江闻笛愁。",
            "今夜聽时在何处，月明西縣驛南樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 17
    },
    {
        "title": "使東川：郵亭月",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "君多務實我多情，大抵偏嗔步月明。",
            "今夜山郵与蠻嶂，君應堅臥我還行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 18
    },
    {
        "title": "使東川：嘉陵驛二首",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "嘉陵驛上空床客，一夜嘉陵江水聲。",
            "仍对牆南滿山樹，野花撩乱月朧明。",
            "牆外花枝壓短牆，月明還照半张床。",
            "无人會得此时意，一夜独眠西畔廊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 19
    },
    {
        "title": "使東川：百牢關",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "嘉陵江上万重山，何事臨江一破顏。",
            "自笑只緣任敬仲，等闲身度百牢關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 20
    },
    {
        "title": "使東川：江花落",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "日暮嘉陵江水東，梨花万片逐江风。",
            "江花何处最腸斷，半落江流半在空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 21
    },
    {
        "title": "使東川：嘉陵江二首",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "秦人惟识秦中水，長想吳江与蜀江。",
            "今日嘉川驛樓下，可怜如練繞明窗。",
            "千里嘉陵江水聲，何年重繞此江行。",
            "只應添得清宵夢，时見滿江流月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 22
    },
    {
        "title": "使東川：西縣驛",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "去时樓上清明夜，月照樓前撩乱花。",
            "今日成阴複成子，可怜春盡未還家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 23
    },
    {
        "title": "使東川：望喜驛",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "滿眼文书堆案邊，眼昏偷得暫时眠。",
            "子規驚觉燈又滅，一道月光橫枕前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 24
    },
    {
        "title": "使東川：好时節",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "身騎驄馬峨眉下，面帶霜威卓氏前。",
            "虛度東川好时節，酒樓元被蜀兒眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 25
    },
    {
        "title": "使東川：夜深行",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "夜深犹自繞江行，震地江聲似鼓聲。",
            "漸見戍樓疑近驛，百牢關吏火前迎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 26
    },
    {
        "title": "使東川：望驛台",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "可怜三月三旬足，悵望江邊望驛台。",
            "料得孟光今日语，不曾春盡不归來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 27
    },
    {
        "title": "贈咸阳少府蕭郎",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "莫怪逢君淚每盈，仲由多感有深情。陸家幼女托良婿，",
            "別时何处最腸斷，日暮渭阳驅馬行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 28
    },
    {
        "title": "贈呂三校书",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "同年同拜校书郎，觸处潛行爛熳狂。共占花園爭趙辟，",
            "语到欲明歡又泣，傍人相笑两相傷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 29
    },
    {
        "title": "封书",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "鶴台南望白雲關，城市犹存暫一還。",
            "书出步虛三百韵，蕊珠文字在人間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 30
    },
    {
        "title": "仁风李著作園醉后寄李十",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "朧明春月照花枝，花下音聲是管兒。",
            "卻笑西京李員外，五更騎馬趁朝时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 31
    },
    {
        "title": "燈影",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "洛阳晝夜无車馬，漫掛紅紗滿樹頭。",
            "見说平时燈影裏，玄宗潛伴太真遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 32
    },
    {
        "title": "貶江陵途中寄樂天杓直杓直以員外郎判鹽鐵樂天以拾遺在翰林",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "想到江陵无一事，酒杯书卷綴新文。紫芽嫩茗和枝采，",
            "算緡草詔終須解，不敢将心遠羨君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 33
    },
    {
        "title": "渡漢江",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "嶓塚去年尋漾水，襄阳今日渡江濆。山遙遠樹才成點，",
            "鯢鯨归穴東溟溢，又作波濤隨伍員。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 34
    },
    {
        "title": "哀病驄呈致用",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "櫪上病驄啼褭褭，江邊廢宅路迢迢。自經梅雨長垂耳，",
            "曾聽禁漏驚衙鼓，慣蹋康衢怕小橋。半夜雄嘶心不死，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 35
    },
    {
        "title": "送嶺南崔侍禦",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "我是北人長北望，每嗟南雁更南飛。君今又作嶺南別，",
            "黃家賊用鑹刀利，白水郎行旱地稀。蜃吐朝光樓隱隱，",
            "火布垢塵須火浣，木綿溫軟當綿衣。桄榔面磣檳榔澀，",
            "此中无限相憂事，請為殷勤事事依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 36
    },
    {
        "title": "酬樂天八月十五夜禁中独直玩月見寄",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "一年秋半月偏深，況就煙霄极賞心。金鳳台前波漾漾，",
            "何意枚皋正承詔，瞥然塵念到江阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 37
    },
    {
        "title": "予病瘴樂天寄通中散碧腴垂雲膏仍題四韵以慰遠懷開坼之間因有酬答",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "紫河變煉紅霞散，翠液煎研碧玉英。金籍真人天上合，",
            "唯有思君治不得，膏銷雪盡意還生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十二",
        "no#": 38
    }
]