[
    {
        "title": "酬友生早秋",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "彤雲将欲罷，蟬柳響如秋。霧散九霄近，日程三伏愁。",
            "残阳宿雨霽，高浪碎沙漚。袪足餘旬后，分襟任自由。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 1
    },
    {
        "title": "曉發",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "旅館候天曙，整車趨遠程。幾处曉鐘斷，半橋残月明。",
            "沙上鳥犹在，渡頭人未行。去去古时道，馬嘶三两聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 2
    },
    {
        "title": "客行",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "上山下山去，千里万里愁。樹色野橋暝，雨聲孤館秋。",
            "南北眼前道，東西江畔舟。世人重金玉，无金徒遠遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 3
    },
    {
        "title": "題鄭处士隱居",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "不信最清曠，及來愁已空。数點石泉雨，一溪霜葉风。",
            "业在有山处，道成无事中。酌盡一尊酒，病夫顏亦紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 4
    },
    {
        "title": "古寺",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "路傍古时寺，寥落藏金容。破塔有寒草，壞樓无曉鐘。",
            "乱紙失經偈，斷碑分篆蹤。日暮月光吐，繞門千樹松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 5
    },
    {
        "title": "贈著上人",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "掩門江上住，盡日更无為。古木坐禪处，残星鳴磬时。",
            "水澆冰滴滴，珠数落累累。自有閑行伴，青藤杖一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 6
    },
    {
        "title": "馬嵬感事",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "冷气生深殿，狼星渡遠關。九城鼙鼓內，千騎道途間。",
            "鳳髻隨秋草，鸞輿入暮山。恨多留不得，悲淚滿龍顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 7
    },
    {
        "title": "贈行如上人",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "不知名利苦，念佛老岷峨。衲補雲千片，香燒印一窠。",
            "戀山人事少，怜客道心多。日日齋鐘后，高懸濾水羅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 8
    },
    {
        "title": "送友人归邛州",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "鶴鳴山下去，滿篋荷瑤琨。放馬荒田草，看碑古寺門。",
            "漸寒沙上雨，欲暝水邊村。莫忘分襟处，梅花撲酒尊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 9
    },
    {
        "title": "和舒上人山居即事",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "敗葉填溪路，残阳過野亭。仍彈一滴水，更讀两张經。",
            "暝鳥煙中見，寒鐘竹裏聽。不多山下去，人世盡膻腥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 10
    },
    {
        "title": "發邛州寄友人",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "茫茫驅一馬，自歎又何之。出郭見山处，待船逢雨时。",
            "曉雞鳴野店，寒葉墮秋枝。寂寞前程去，閑吟欲共谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 11
    },
    {
        "title": "舟行夜泊夔州",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "維舟鏡面中，迥对白鹽峰。夜靜沙堤月，天寒水寺鐘。",
            "故園何日到，舊友幾时逢。欲作還家夢，青山一万重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 12
    },
    {
        "title": "山東蘭若遇靜公夜归",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "松門一徑微，苔滑往來稀。半夜闻鐘后，渾身帶雪归。",
            "问寒僧接杖，辨语犬銜衣。又是安禪去，呼童閉竹扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 13
    },
    {
        "title": "邊将",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "三千護塞兒，独自滯邊陲。老向二毛見，秋從一葉知。",
            "地寒鄉思苦，天暮角聲悲。卻被交親笑，封侯未有期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 14
    },
    {
        "title": "秋寄□江舒公",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "故人何处望，秋色滿江濆。入水溪蟲乱，過橋山路分。",
            "鶴归松上月，僧入竹間雲。莫惜中宵磬，從教夢裏闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 15
    },
    {
        "title": "題楊山人隱居",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "深山道者家，門戶帶煙霞。綠綴沿岩草，紅飄落水花。",
            "半庭栽小樹，一徑掃平沙。往往溪邊坐，持竿到日斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 16
    },
    {
        "title": "夜上隱居寺",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "尋師擬學空，空住虎溪東。千里照山月，一枝驚鶴风。",
            "年如流去水，山似轉來蓬。盡日都无事，安禪石窟中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 17
    },
    {
        "title": "友人見訪不值因寄",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "門戶寒江近，籬牆野樹深。晚风搖竹影，斜日轉山阴。",
            "砌觉披秋草，床驚倒古琴。更闻鄰舍说，一隻鶴來尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 18
    },
    {
        "title": "塗次偶作",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "歲月客中銷，崎嶇力自招。问人尋野寺，牽馬渡危橋。",
            "為雨疑天晚，因山觉路遙。前程何处是，一望又迢迢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 19
    },
    {
        "title": "送友人江行之廬山肄业",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "蜀國初開棹，廬峰擬拾螢。獸皮裁褥暖，蓮葉制衣馨。",
            "楚水秋來碧，巫山雨后青。莫教銜鳳詔，三度到中庭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 20
    },
    {
        "title": "山居偶作",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "趨名逐利身，終日走风塵。還到水邊宅，卻為山下人。",
            "僧教開竹戶，客许戴紗巾。且喜琴书在，蘇生未厭貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 21
    },
    {
        "title": "贈道者",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "披霞戴鹿胎，歲月不能催。飯把琪花煮，衣将藕葉裁。",
            "鶴從归日養，松是小时栽。往往樵人見，溪邊洗药來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 22
    },
    {
        "title": "邛州水亭夜宴送顧非熊之官",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "寂寞邛城夜，寒塘对庾樓。蜀關蟬已噪，秦樹葉應秋。",
            "道路連天遠，笙歌到曉愁。不堪分袂后，残月正如鉤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 23
    },
    {
        "title": "題青城山範賢觀",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "数裏緣山不厭難，為尋真訣问黃冠。苔鋪翠點仙橋滑，",
            "鐘聲已斷泉聲在，风動茅花月滿壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 24
    },
    {
        "title": "送僧講罷归山",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "休将如意辯真空，吹盡天花任曉风。共看玉蟾三皎潔，",
            "依舊曹溪念經处，野泉聲在草堂東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 25
    },
    {
        "title": "題友人寓居",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "寓居无不在天涯，莫恨秦關道路賒。繚繞城邊山是蜀，",
            "何处一聲金磬發，古松南畔有僧家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 26
    },
    {
        "title": "傷张玖秀才",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "銅梁劍閣幾區區，十上探珠不見珠。卞玉影沈沙草暗，",
            "吳水楚山千万里，旅魂归到故鄉无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 27
    },
    {
        "title": "題李少府別业",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "尋得仙家不姓梅，馬嘶人语出塵埃。竹和庭上春煙動，",
            "何年亦作圍棋伴，一到松間醉一回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 28
    },
    {
        "title": "贈楚公",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "曾闻半偈雪山中，貝葉翻时理盡通。般若恒添持戒力，",
            "長说滿庭花色好，一枝紅是一枝空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 29
    },
    {
        "title": "贈王山人",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "紅藤一柱腳常輕，日日緣溪入谷行。山下有家身未老，",
            "知到蓬萊難再訪，问何方法得長生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 30
    },
    {
        "title": "庭竹",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "月籠翠葉秋承露，风亞繁梢暝掃煙。",
            "知道雪霜終不變，永留寒色在庭前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 31
    },
    {
        "title": "題常樂寺",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "桂冷香闻十里間，殿台渾不似人寰。",
            "日斜回首江頭望，一片晴雲落后山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 32
    },
    {
        "title": "題劉煉師归山",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "风急雲輕鶴背寒，洞天谁道卻归難。",
            "千山万水瀛洲路，何处煙飛是醮壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 33
    },
    {
        "title": "酬舒公見寄",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "无客不言雲外見，為文長遣世間知。",
            "一聲松徑寒吟后，正是前山雪下时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 34
    },
    {
        "title": "巫山下作",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "細腰宮盡舊城摧，神女归山更不來。",
            "唯有楚江斜日裏，至今犹自繞阳臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 35
    },
    {
        "title": "句",
        "author": "唐求",
        "biography": "",
        "paragraphs": [
            "恰似有龍深处臥，被人驚起黑雲生。（《臨池洗硯》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十四",
        "no#": 36
    }
]