[
    {
        "title": "冬末同友人泛瀟湘",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "残臘泛舟何處好，最多吟興是瀟湘。就船買得魚偏美，",
            "与君剩采江山景，裁取新诗入帝鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 1
    },
    {
        "title": "贈李鐔",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "君行君文天合知，見君如此我興悲。只残三口兵戈後，",
            "地爐不暖柴枝濕，犹把蒙求授小兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 2
    },
    {
        "title": "旅中臥病",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "秋來谁料病相縈，枕上心犹算去程。风射破窗燈易滅，",
            "我自与人无舊分，非幹人与我无情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 3
    },
    {
        "title": "旅泊遇郡中叛乱示同志",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "握手相看谁敢言，军家刀劍在腰邊。遍搜寶貨无藏處，",
            "郡侯逐出渾闲事，正是鑾輿幸蜀年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 4
    },
    {
        "title": "贈秋浦张明府",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "君為秋浦三年宰，万慮關心两鬢知。人事旋生當路縣，",
            "他日親知问官況，但教吟取杜家诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 5
    },
    {
        "title": "雪",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "风攪長空寒骨生，光於曉色報窗明。江湖不見飛禽影，",
            "擁袍公子休言冷，中有樵夫跣足行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 6
    },
    {
        "title": "題廬岳劉處士草堂",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "仙境閑尋采药翁，草堂留話一宵同。若看山下雲深處，",
            "求名心在閑難遂，明日馬蹄塵土中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 7
    },
    {
        "title": "山中寄诗友",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "山深長恨少同人，覽景无时不憶君。庭果自從霜後熟，",
            "仙桂算攀攀合得，平生心力盡于文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 8
    },
    {
        "title": "秋宿臨江驛",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "南來北去二三年，年去年來两鬢斑。舉世盡從愁裏老，",
            "身事未成归未得，聽猿鞭馬入長關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 9
    },
    {
        "title": "題瓦棺寺真上人院矮檜",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "天生仙檜是長材，栽檜希逢此最低。一自舊山來砌畔，",
            "今日偶題題似著，不知題後更谁題。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 10
    },
    {
        "title": "江下初秋寓泊",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "濛濛煙雨蔽江村，江館愁人好斷魂。自別家來生白发，",
            "兄弟无书雁归北，一聲聲覺苦於猿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 11
    },
    {
        "title": "投從叔補闕",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "吾宗不謁謁诗宗，常仰門风繼國风。空有篇章傳海內，",
            "三十年吟到今日，不妨私薦亦成公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 12
    },
    {
        "title": "贈张員外兒",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "张公一子才三歲，闻客吟聲便出來。喚物舌頭犹未穩，",
            "月裏桂枝知有分，不勞諸丈作梯媒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 13
    },
    {
        "title": "重阳日有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一為重阳上古台，乱时谁見菊花開。偷撏白发真堪笑，",
            "大家拍手高聲唱，日未沈山且莫回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 14
    },
    {
        "title": "入關寄九華友人",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "坐床難穩露蟬新，便作東西馬上身。醲酒卻輸耽睡客，",
            "篋裏篇章頭上雪，未知谁戀杏園春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 15
    },
    {
        "title": "送李鐔游新安",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "邯鄲李鐔才崢嶸，酒狂诗逸難幹名。氣直不与兒輩洽，",
            "一間茅屋住不穩，剛出為人平不平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 16
    },
    {
        "title": "冬末自長沙游桂嶺留獻所知",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "家隔重湖归未期，更堪南去別深知。前程笑到山多處，",
            "朱門只見朱門事，独把孤寒问阿谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 17
    },
    {
        "title": "送福昌周繇少府归寧兼謀隱",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "少見古人无遠慮，如君真得古人情。登科作尉官雖小，",
            "知君未作終焉计，要著文章待太平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 18
    },
    {
        "title": "賀顧雲侍禦府主与子弟奏官",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "青桂朱袍不賀兄，賀兄榮是見兒榮。孝經始向堂前徹，",
            "自慚乱世无知己，弟侄鞭牛傍隴耕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 19
    },
    {
        "title": "舟行即事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "年少髭須雪欲侵，別家三日幾般心。朝隨賈客憂风色，",
            "重阳酒熟茱萸紫，卻向江頭倚棹吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 20
    },
    {
        "title": "乱後山居",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "從乱移家擬傍山，今來方辦買山錢。九州有路休為客，",
            "他人似我還應少，如此安貧亦荷天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 21
    },
    {
        "title": "山居寄同志",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "茅齋深僻絕輪蹄，門徑緣莎細接溪。垂釣石台依竹壘，",
            "不是无端過时日，擬從窗下躡雲梯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 22
    },
    {
        "title": "将入關安陸遇兵寇",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "家貧无计早離家，離得家來蹇滯多。已是數程行雨雪，",
            "四面煙塵少无處，不知吾土自如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 23
    },
    {
        "title": "夏日登友人书齋林亭",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "暑天長似秋天冷，帶郭林亭画不如。蟬噪檻前遮日竹，",
            "眾惜君才堪上第，莫因居此与名疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 24
    },
    {
        "title": "寄臨海姚中丞",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "夏辭旌旆已秋深，永夕思量淚滿襟。风月易斑搜句鬢，",
            "雖有夢魂知處所，去來多被角聲侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 25
    },
    {
        "title": "秋日闲居寄先達",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "到頭身事欲何為，窗下工夫鬢上知。乍可百年无稱意，",
            "自古书生也如此，独堪惆悵是明时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 26
    },
    {
        "title": "題覺禪和",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "少見修行得似師，茅堂佛像亦隨时。禪衣衲後雲藏線，",
            "有时问著經中事，卻道山僧總不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 27
    },
    {
        "title": "感秋",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "年年名路謾辛勤，襟袖空多馬上塵。画戟門前難作客，",
            "自是儂家无住處，不關天地窄於人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 28
    },
    {
        "title": "題德玄上人院",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "刳得心來忙處閑，閑中方寸闊於天。浮生自是无空性，",
            "我雖未似師披衲，此理同師悟了然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 29
    },
    {
        "title": "春日山居寄友人",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "野吟何處最相宜，春景暄和好入诗。高下麥苗新雨後，",
            "倒载干戈是何日，近來麋鹿欲相隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 30
    },
    {
        "title": "懷廬嶽舊隱",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一別三年長在夢，夢中时躡石棱層。泉聲入夜方堪聽，",
            "人間有许多般事，求要身閑直未能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 31
    },
    {
        "title": "投長沙裴侍郎",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "此身雖賤道長存，非謁朱門謁孔門。只望至公将卷讀，",
            "男子受恩須有地，平生不受等闲恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 32
    },
    {
        "title": "和友人見題山居",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "避时多喜葺居成，七字君題万象清。開戶曉雲連地白，",
            "有景供吟且如此，算來何必躁於名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 33
    },
    {
        "title": "獻長沙王侍郎",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "文星漸見射台星，皆仰為霖沃眾情。天澤逼來逢聖主，",
            "美化事多難諷誦，未如耕釣口分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 34
    },
    {
        "title": "春日登樓遇雨",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "忽地晴天作雨天，全无暑氣似秋間。看看水沒來时路，",
            "一心准擬閑登眺，卻被诗情使不閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 35
    },
    {
        "title": "春日行次錢塘卻寄台州姚中丞",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "豈為无心求上第，難安帝裏為家貧。江南江北閑為客，",
            "花前不独垂鄉淚，曾是朱門寄食身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 36
    },
    {
        "title": "投江上崔尚书",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "此生何路出塵埃，犹把中才謁上才。閉戶十年專筆硯，",
            "若许登門换鬐鬣，必應辛苦事风雷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 37
    },
    {
        "title": "书事投所知",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "古陌寒风來去吹，馬蹄塵旋上麻衣。雖然幹祿无休意，",
            "肯将骨肉輕離別，未遇人知未得归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 38
    },
    {
        "title": "秋日湖外书事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "十五年來筆硯功，只今犹在苦貧中。三秋客路湖光外，",
            "朱門處處若相似，此命到頭通不通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 39
    },
    {
        "title": "題宗上人舊院",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "此院重來事事乖，半欹茅屋草侵階。啄生鴉憶啼松枿。",
            "接果猿思嘯石崖。壁上塵粘蒲葉扇，床前苔爛筍皮鞋。",
            "分明記得談空日，不向秋风更愴懷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 40
    },
    {
        "title": "乱後出山逢高員外",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "自從乱後別京關，一入煙蘿十五年。重出故山生白发，",
            "名姓暗投心暗祝，永期收拾向門前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 41
    },
    {
        "title": "贈友人罷舉赴交趾辟命",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "罷卻名場擬入秦，南行无罪似流人。縱經商嶺非馳驛，",
            "如何待取丹霄桂，別赴嘉招作上賓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 42
    },
    {
        "title": "山中寡婦",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "夫因兵死守蓬茅，麻苧衣衫鬢发焦。桑柘廢來犹納稅，",
            "任是深山更深處，也應无计避征徭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 43
    },
    {
        "title": "訪蔡融因題",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "杖藜时複過荒郊，來到君家不忍拋。每見苦心修好事，",
            "必若天工主人事，肯交吾子委衡茅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 44
    },
    {
        "title": "闲居书事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "竹門茅屋帶村居，數畝生涯自有餘。鬢白只應秋煉句，",
            "待得功成即西去，时清不问命何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 45
    },
    {
        "title": "友人贈舍弟依韵戲和",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "吾家此弟有何知，多愧君開道业基。不覺裹頭成大漢，",
            "及見和诗诗自好，eh公不到更何时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 46
    },
    {
        "title": "乱後逢村叟",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "經乱衰翁居破村，村中何事不傷魂。因供寨木无桑柘，",
            "至於雞犬皆星散，日落前山独倚門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 47
    },
    {
        "title": "贈元上人",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "多少僧中僧行高，偈成流落遍僧抄。經窗月靜灘聲到，",
            "煮茶童子閑勝我，犹得依时把磬敲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 48
    },
    {
        "title": "下第東归道中作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一回落第一寧親，多是途中過卻春。心火不銷雙鬢雪，",
            "馬壯金多有官者，榮归卻笑讀书人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 49
    },
    {
        "title": "夏日留題张山人林亭",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "此中偏稱夏中游，时有风來暑氣收。澗底松搖千尺雨，",
            "閑与先生話身事，浮名薄宦總悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 50
    },
    {
        "title": "傷病馬",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "此馬堪怜力壯时，細勻行步恐塵知。騎來未省将鞭觸，",
            "只今筋骨渾全在，春暖莎青放未迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 51
    },
    {
        "title": "館舍秋夕",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "寒雨蕭蕭燈焰青，燈前孤客難為情。兵戈鬧日別鄉國，",
            "出門便作還家计，直至如今计未成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 52
    },
    {
        "title": "送僧赴黃山沐湯泉兼參禪宗長老",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "闻有湯泉独去尋，一瓶一缽一无金。不愁乱世兵相害，",
            "患身是幻逢禪主，水洗皮膚语洗心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 53
    },
    {
        "title": "哭山友",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "十载同棲廬嶽雲，寒燒枯葉夜論文。在生未识公卿面，",
            "把君诗句高聲讀，想得天高也合闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 54
    },
    {
        "title": "獻池州牧",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "池阳今日似漁阳，大變凶年作小康。江路靜來通客貨，",
            "縱有逋民归未得，遠闻仁政旋還鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 55
    },
    {
        "title": "送韋书記归京",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "韋杜相逢眼自明，事連恩地倍牽情。闻归帝裏愁攀送，",
            "從來有淚非无淚，未似今朝淚滿纓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 56
    },
    {
        "title": "獻鄭給事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "化行邦域二年春，樵唱漁歌日日新。未降詔书酬善政，",
            "他日朱門恐難掃，沙堤新築必无塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 57
    },
    {
        "title": "贈休禪和",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "為僧難得不為僧，僧戒僧仪未是能。弟子自知心了了，",
            "只道诗人无佛性，長将二雅入三乘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 58
    },
    {
        "title": "送李先輩從知塞上",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "去草军书出帝鄉，便從城外學戎裝。好隨漢将收胡土，",
            "此行也是男兒事，莫向征人恃桂香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 59
    },
    {
        "title": "和友人送弟",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "君说无家只弟兄，此中言別若為情。干戈鬧日分頭去，",
            "我今骨肉雖饑凍，幸喜團圓過乱兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 60
    },
    {
        "title": "酬张員外見寄",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "分應天与吟诗老，如此兵戈不廢诗。生在世間人不识，",
            "今日逢君惜分手，一枝何校一年迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 61
    },
    {
        "title": "獻新安于尚书",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "九土雄師竟若何，未如良牧与天和。月留清俸資家少，",
            "行人耳滿新安事，儘是无愁父老歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 62
    },
    {
        "title": "乱後书事寄同志",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "九土如今盡用兵，短戈長戟困书生。思量在世頭堪白，",
            "到頭诗捲鬚藏卻，各向漁樵混姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 63
    },
    {
        "title": "中山臨上人院觀牡丹寄諸從事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "閑來吟繞牡丹叢，花豔人生事略同。半雨半风三月內，",
            "一境別无唯此有，忍教醒坐對支公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 64
    },
    {
        "title": "投宣諭张侍郎乱後遇毗陵",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "此生今日似前生，重著麻衣特地行。經乱後囊新卷軸，",
            "闻道中興重人物，不妨西去馬蹄輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 65
    },
    {
        "title": "下第投所知",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "落第愁生曉鼓初，地寒才薄欲何如。不辭更写公卿卷，",
            "擬離門館東归去，又恐重來事轉疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 66
    },
    {
        "title": "哭方幹",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "何言寸祿不沾身，身沒诗名万古存。況有數篇關教化，",
            "天下未寧吾道喪，更谁将酒酹吟魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 67
    },
    {
        "title": "秋日泊浦江",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一帆程歇九秋时，漠漠蘆花拂浪飛。寒浦更无船並宿，",
            "江月漸明汀露濕，靜驅吟魄入玄微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 68
    },
    {
        "title": "白发吟",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一莖两莖初似絲，不妨驚度少年时。幾人乱世得及此，",
            "家山蒼翠万餘尺，藜杖楮冠輸老兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 69
    },
    {
        "title": "下第寄池州鄭員外",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "省出蓬蒿修謁初，蒙知曾不見生疏。侯門數處将书薦，",
            "如今足得成持取，莫使江湖卻釣魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 70
    },
    {
        "title": "塞上",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "旌旗鬣鬣漢将军，閑出巡邊帝命新。沙塞旋收饒帳幕，",
            "独作书生疑不穩，軟弓輕劍也隨身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 71
    },
    {
        "title": "贈題兜率寺閑上人院",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "人間寺應諸天號，真行僧禪此寺中。百歲有涯頭上雪，",
            "畢竟浮生謾勞役，算來何事不成空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 72
    },
    {
        "title": "別四明鐘尚书",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "九華天際碧嵯峨，无奈春來入夢何。難与英雄論教化，",
            "都大人生有離別，且将诗句代離歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 73
    },
    {
        "title": "題護國大師塔",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "莫認雙林是佛林，禪棲无地亦无金。塔前盡禮灰來相，",
            "吾師覺路餘知處，大藏經門一夜吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 74
    },
    {
        "title": "春日山中對雪有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "竹樹无聲或有聲，霏霏漠漠散還凝。嶺梅謝後重妝蕊，",
            "好将膏雨同功力，松徑莓苔又一層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 75
    },
    {
        "title": "山中對雪有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一渾乾坤万象收，唯應不壅大江流。虎狼遇獵難藏跡，",
            "豈堪久蔽蒼蒼色，須放三光照九州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 76
    },
    {
        "title": "戲題王處士书齋",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "先生高興似樵漁，水鳥山猿一處居。石徑可行苔色厚，",
            "莫道无金空有壽，有金无壽欲何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 77
    },
    {
        "title": "早發",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "東窗未明塵夢蘇，呼童結束登征途。落葉鋪霜馬蹄滑，",
            "青雲快活一未見，爭得安闲釣五湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 78
    },
    {
        "title": "題仇處士郊居",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "江南景簇此林亭，手板藍裾自可輕。洞裏客來无俗話，",
            "笑我有诗三百首，馬蹄紅日急於名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 79
    },
    {
        "title": "依韵次同年张曙先輩見寄之什",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "天上诗名天下傳，引來齊列玉皇前。大仙錄後頭无雪，",
            "九華山叟驚凡骨，同到蓬萊豈偶然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 80
    },
    {
        "title": "乱後逢李昭象敘別",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "李生李生何所之，家山窣雲胡不归。兵戈到處弄性命，",
            "也知不是男兒事，爭奈时情賤布衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 81
    },
    {
        "title": "晚春寄同年张曙先輩",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "莫将时態破天真，只合高歌醉過春。易落好花三個月，",
            "恩地未酬閑未得，一回醒話一沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 82
    },
    {
        "title": "長安春感",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "出京无计住京難，深入東风轉索然。滿眼有花寒食下，",
            "公道算來終達去，更從今日望明年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 83
    },
    {
        "title": "登靈山水閣貽釣者",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "江上見僧谁是了，修齋補衲日勞身。未勝漁父閑垂釣，",
            "瓦瓶盛酒瓷甌酌，荻浦蘆灣是要津。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 84
    },
    {
        "title": "贈溧水崔少府",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "庭戶蕭條燕雀喧，日高窗下枕书眠。只闻留客教沽酒，",
            "九華山叟心相许，不计官卑贈一篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 85
    },
    {
        "title": "讀张僕射诗",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "秋吟一軸見心胸，万象搜羅詠欲空。才大卻嫌天上桂，",
            "雙美總輸张太守，二南章句六鈞弓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 86
    },
    {
        "title": "題所居村舍",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "家隨兵盡屋空存，稅額甯容減一分。衣食旋營犹可過，",
            "如此數州谁會得，殺民将盡更邀勳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 87
    },
    {
        "title": "獻錢塘縣羅著作判官",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "還鄉夫子遇賢侯，撫字情知不自由。莫把一名專懊惱，",
            "犹有九華知己在，羨君高臥早回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 88
    },
    {
        "title": "遣懷",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "驅馳岐路共營營，只為人間利与名。紅杏園中終擬醉，",
            "謾道強親堪倚賴，到頭須是有前程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 89
    },
    {
        "title": "長安道中有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "回頭不忍看羸僮，一路行人我最窮。馬跡蹇於槐影裏，",
            "子細尋思底模樣，騰騰又過玉關東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 90
    },
    {
        "title": "題開元寺門閣",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一登高閣眺清秋，滿目风光盡勝遊。何處画橈尋綠水，",
            "唯有禪居離塵俗，了无榮辱掛心頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 91
    },
    {
        "title": "出關投孫侍禦",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "東归還著舊麻衣，爭免花前有淚垂。每歲春光九十日，",
            "不為感恩酬未得，五湖閑作釣魚師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 92
    },
    {
        "title": "送項山人归天臺",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "因話天臺归思生，布囊藤杖笑離城。不教日月拘身事，",
            "此中是處堪終隱，何要世人知姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 93
    },
    {
        "title": "題衡阳隱士山居",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "闲居不问世如何，雲起山門日已斜。放鶴去尋三島客，",
            "畢竟金多也頭白，算來爭得似君家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 94
    },
    {
        "title": "題江寺禪和",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "江寺禪僧似悟禪，壞衣芒履住茅軒。懶求施主修真像，",
            "行人莫问師宗旨，眼不浮華耳不喧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 95
    },
    {
        "title": "題弟侄书堂",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "何事居窮道不窮，乱时還与靜时同。家山雖在干戈地，",
            "少年辛苦終身事，莫向光阴惰寸功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 96
    },
    {
        "title": "和友人寄長林孟明府",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "為政為人漸見心，長才聊屈宰長林。莫嫌月入无多俸，",
            "訟庭閑寂公书少，留客看山索酒斟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 97
    },
    {
        "title": "戲贈漁家",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "見君生计羨君閑，求食求衣有底難。養一箔蠶供釣線，",
            "卻笑儂家最辛苦，聽蟬鞭馬入長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 98
    },
    {
        "title": "登城有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "上得孤城向晚春，眼前何事不傷神。遍看原上累累塚，",
            "一名一宦平生事，不放愁侵易過身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 99
    },
    {
        "title": "秋日山中寄池州李常侍",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "近來參謁陡生疏，因向雲山僻處居。出為羈孤營糲食，",
            "但得中興知己在，算應身未老樵漁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 100
    },
    {
        "title": "辭楊侍郎",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "春在門闌秋未離，不因人薦只因诗。半年賓館成前事，",
            "西风万里東归去，更把愁心说向谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 101
    },
    {
        "title": "題汪氏茅亭",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "茅亭客到多稱奇，茅亭之上難題诗。出塵景物不可狀，",
            "君今酷愛人間事，爭得安闲老在茲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 102
    },
    {
        "title": "喜從弟雪中遠至有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "深山大雪懶開門，門徑行蹤自爾新。无酒禦寒雖寡況，",
            "晝短夜長須強學，學成貧亦勝他貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 103
    },
    {
        "title": "送僧归國清寺",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "吟送越僧归海涯，僧行渾不覺程賒。路沿山腳潮痕出，",
            "到參禪後知无事，看引秋泉灌藕花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 104
    },
    {
        "title": "題汪明府山居",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "不似當官只似閑，野情終日不離山。方知薄宦難拘束，",
            "羨君公退归欹枕，免向他門厚客顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 105
    },
    {
        "title": "下第東归将及故園有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "平生操立有天知，何事謀身与志違。上國獻诗還不遇，",
            "且把风寒作闲事，懶能和淚拜庭闈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 106
    },
    {
        "title": "宿東林寺題愿公院",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "古寺沉沉僧未眠，支頤将客说閑緣。一溪月色非塵世，",
            "无由住得吟相伴，心系青雲十五年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 107
    },
    {
        "title": "山居自遣",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "茅屋周回松竹阴，山翁时挈酒相尋。无人開口不言利，",
            "此中一日過一日，有底闲愁得到心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 108
    },
    {
        "title": "贈友人罷舉赴辟命",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "連天一水浸吳東，十幅帆飛二月风。好景采拋诗句裏，",
            "不是桂枝終不得，自緣年少好從戎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 109
    },
    {
        "title": "乱後旅中遇友人",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "念子為儒道未亨，依依心向十年兄。莫依乱世輕依託，",
            "不如自此同归去，帆掛秋风一信程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 110
    },
    {
        "title": "贈休糧僧",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "自言因病學休糧，本意非求不死方。徒有至人傳道術，",
            "爭似吾師无一事，穩披雲衲坐藤床。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 111
    },
    {
        "title": "維揚春日再遇孫侍禦",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "本為榮家不為身，讀书谁料轉家貧。三年行卻千山路，",
            "多情禦史應嗟見，未上青雲白发新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 112
    },
    {
        "title": "乱後宿南陵廢寺寄沈明府",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "只共寒燈坐到明，塞鴻沖雪一聲聲。乱时為客无人识，",
            "男兒仗劍酬恩在，未肯徒然過一生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 113
    },
    {
        "title": "投鄭先輩",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "匣中長劍未酬恩，不遇男兒不合論。悶向酒杯吞日月，",
            "两鬢欲斑三百首，更教裝写傍谁門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 114
    },
    {
        "title": "途中有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "无論南北与西東，名利牽人處處同。枕上事仍多馬上，",
            "百歲此身如且健，大家閑作臥雲翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 115
    },
    {
        "title": "和舍弟題书堂",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "兄弟将知大自強，乱时同葺讀书堂。岩泉遇雨多還鬧，",
            "團圓便是家肥事，何必盈倉与滿箱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 116
    },
    {
        "title": "送蜀客遊維揚",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "見说西川景物繁，維揚景物勝西川。青春花柳樹臨水，",
            "送君懶问君回日，才子风流正少年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 117
    },
    {
        "title": "旅寓",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "暗算鄉程隔數州，欲归无计淚空流。已違骨肉來时約，",
            "去年今日還如此，似与青春有舊仇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 118
    },
    {
        "title": "途中春",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "年光身事旋成空，畢竟何門遇至公。人世鶴归雙鬢上，",
            "一醉未醒花又落，故鄉回首楚關東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 119
    },
    {
        "title": "維揚冬末寄幕中二從事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "江上數株桑枣樹，自從離乱更荒涼。那堪旅館經残臘，",
            "故人多在芙蓉幕，應笑孜孜道未光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 120
    },
    {
        "title": "辭鄭員外入關",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "男兒三十尚蹉跎，未遂青雲一桂科。在客易為銷歲月，",
            "長把行藏信天道，不知天道竟如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 121
    },
    {
        "title": "书齋即事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "时清只合力為儒，不可家貧与善疏。賣卻屋邊三畝地，",
            "鄉里老農多見笑，不知稽古勝耕鋤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 122
    },
    {
        "title": "雋阳道中",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "客路客路何悠悠，蟬聲向背槐花愁。爭知百歲不百歲，",
            "輸他江上垂綸者，只在船中老便休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 123
    },
    {
        "title": "入關因別舍弟",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "吾今別汝汝聽言，去住人情足可安。百口度荒均食易，",
            "天道不欺心意是，帝鄉吾土一般般。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 124
    },
    {
        "title": "贈彭蠡釣者",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "偏坐漁舟出葦林，葦花零落向秋深。只将波上鸥為侶，",
            "若教我似君閑放，贏得湖山到老吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 125
    },
    {
        "title": "送友人入關",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "此去青雲莫更疑，出人才行足人知。況當朝野搜賢日，",
            "我今不得同君去，两鬢霜欺桂一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 126
    },
    {
        "title": "送友人宰潯阳",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "高興那言去路長，非君不解愛潯阳。有时猿鳥來公署，",
            "陶潛舊隱依稀在，好繼高蹤結草堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 127
    },
    {
        "title": "秋日臥病",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "浮世浮名能幾何，致身流落向天涯。少年心壯輕為客，",
            "不堪吟罷西风起，黃葉滿庭寒日斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 128
    },
    {
        "title": "敘吟",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "多慚到處有诗名，轉覺吟诗僻性成。度水卻嫌船著岸，",
            "未合白頭今已白，自知非為別愁生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 129
    },
    {
        "title": "行次滎阳卻寄諸弟",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "難把归书说遠情，奉親多闕拙為兄。早知寸祿榮家晚，",
            "如今已作長安计，只得辛勤取一名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 130
    },
    {
        "title": "登石壁禪師水閣有作",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "石壁早闻僧说好，今來偏与我相宜。有山有水堪吟處，",
            "画人画得從他画，六幅應輸八句诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 131
    },
    {
        "title": "贈袒肩和尚",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "山衣草屐染莓苔，雙眼犹慵向俗開。若比吾師居世上，",
            "乘醉吟诗问禪理，為谁須去為谁來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 132
    },
    {
        "title": "闲居即事",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "形覺清羸道覺肥，竹門前徑靜相宜。一壺村酒无求處，",
            "一枝仙桂如攀得，只此山前是老期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 133
    },
    {
        "title": "自敘",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "酒甕琴书伴病身，熟諳时事樂於貧。寧為宇宙閑吟客，",
            "平生肺腑无言處，白发吾唐一逸人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 134
    },
    {
        "title": "空闲二公遞以禪律相鄙因而解之",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "一教谁雲辟二途，律禪禪律智归愚。念珠在手隳禪衲，",
            "有无无有師窮取，山到平來海亦枯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 135
    },
    {
        "title": "寄溫州朱尚书並呈军倅崔太博",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "永嘉名郡昔推名，連屬荀家弟与兄。教化靜師龔渤海，",
            "今日老輸崔博士，不妨疏逸伴雙旌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百九十二",
        "no#": 136
    },
    {
        "title": "恩門致书遠及山居因獻之",
        "author": "杜荀鶴",
        "biography": "",
        "paragraphs": [
            "时難轉覺保身難，難向師門欲繼顏。若把白衣輕易脫，",
