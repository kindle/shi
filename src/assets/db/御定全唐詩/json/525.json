[
    {
        "title": "寓言",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "暖风迟日柳初含，顧影看身又自慚。",
            "何事明朝独惆悵，杏花时節在江南。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 1
    },
    {
        "title": "猿",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "月白煙青水暗流，孤猿銜恨叫中秋。",
            "三聲欲斷疑腸斷，饒是少年今白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 2
    },
    {
        "title": "懷归",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "塵埃終日滿窗前，水態雲容思浩然。",
            "爭得便归湘浦去，卻持竿上釣魚船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 3
    },
    {
        "title": "邊上晚秋",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "黑山南面更无州，馬放平沙夜不收。",
            "风送孤城臨晚角，一聲聲入客心愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 4
    },
    {
        "title": "傷友人悼吹簫妓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "玉簫聲斷沒流年，滿目春愁隴樹煙。",
            "豔質已隨雲雨散，鳳樓空鎖月明天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 5
    },
    {
        "title": "訪许顏",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "門近寒溪窗近山，枕山流水日潺潺。",
            "長嫌世上浮雲客，老向塵中不解顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 6
    },
    {
        "title": "春日古道傍作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "万古榮華旦暮齊，樓臺春盡草萋萋。",
            "君看陌上何人墓，旋化紅塵送馬蹄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 7
    },
    {
        "title": "青塚",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "青塚前頭隴水流，燕支山上暮雲秋。",
            "蛾眉一墜窮泉路，夜夜孤魂月下愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 8
    },
    {
        "title": "大夢上人自廬峰回",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "行腳尋常到寺稀，一枝藜杖一禪衣。",
            "開門滿院空秋色，新向廬峰過夏归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 9
    },
    {
        "title": "洛中二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "柳動晴风拂路塵，年年宮闕鎖濃春。",
            "一從翠輦无巡幸，老卻蛾眉幾许人。",
            "风吹柳帶搖晴綠，蝶繞花枝戀暖香。",
            "多把芳菲泛春酒，直教愁色对愁腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 10
    },
    {
        "title": "邊上闻笳三首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "何处吹笳薄暮天，塞垣高鳥沒狼煙。",
            "遊人一聽頭堪白，蘇武爭禁十九年。",
            "海路无塵邊草新，榮枯不見綠楊春。",
            "白沙日暮愁雲起，独感離鄉万里人。",
            "胡雛吹笛上高臺，寒雁驚飛去不回。",
            "盡日春风吹不散，只應分付客愁來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 11
    },
    {
        "title": "春日寄许渾先輩",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "薊北雁初去，湘南春又归。水流滄海急，人到白頭稀。",
            "塞路盡何处，我愁當落暉。終須接鴛鹭，霄漢共高飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 12
    },
    {
        "title": "經闔閭城",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "遺蹤委衰草，行客思悠悠。昔日人何处，終年水自流。",
            "孤煙村戍遠，乱雨海門秋。吟罷独归去，煙雲盡慘愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 13
    },
    {
        "title": "並州道中",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "行役我方倦，苦吟谁複闻。戍樓春帶雪，邊角暮吹雲。",
            "极目无人跡，回頭送雁群。如何遣公子，高臥醉醺醺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 14
    },
    {
        "title": "別懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "相別徒成泣，經過總是空。勞生慣離別，夜夢苦西東。",
            "去路三湘浪，归程一片风。他年寄消息，书在鯉魚中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 15
    },
    {
        "title": "漁父",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "白发滄浪上，全忘是与非。秋潭垂釣去，夜月叩船归。",
            "煙影侵蘆岸，潮痕在竹扉。終年狎鸥鳥，來去且无机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 16
    },
    {
        "title": "秋夢",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "寒空動高吹，月色滿清砧。残夢夜魂斷，美人邊思深。",
            "孤鴻秋出塞，一葉暗辭林。又寄征衣去，迢迢天外心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 17
    },
    {
        "title": "早秋客舍",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "风吹一片葉，万物已驚秋。独夜他鄉淚，年年為客愁。",
            "別離何处盡，搖落幾时休。不及磻溪叟，身閑長自由。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 18
    },
    {
        "title": "逢故人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "故交相見稀，相見倍依依。塵路事不盡，雲岩閑好归。",
            "投人銷壯志，徇俗變真机。又落他鄉淚，风前一滿衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 19
    },
    {
        "title": "秋晚江上遣懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "孤舟天際外，去路望中賒。貧病遠行客，夢魂多在家。",
            "蟬吟秋色樹，鴉噪夕阳沙。不擬徹雙鬢，他方擲歲華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 20
    },
    {
        "title": "長安夜月",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "寒光垂靜夜，皓彩滿重城。万國盡分照，谁家无此明。",
            "古槐疏影薄，仙桂動秋聲。独有長門裏，蛾眉对曉晴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 21
    },
    {
        "title": "雲",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "東西那有礙，出处豈虛心。曉入洞庭闊，暮归巫峽深。",
            "渡江隨鳥影，擁樹隔猿吟。莫隱高唐去，枯苗待作霖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 22
    },
    {
        "title": "春懷",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "年光何太急，倏忽又青春。明月谁為主，江山暗换人。",
            "鶯花潛运老，榮樂漸成塵。遙憶朱門柳，別離應更频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 23
    },
    {
        "title": "逢故人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "年年不相見，相見卻成悲。教我淚如霰，嗟君發似絲。",
            "正傷攜手处，況值落花时。莫惜今宵醉，人間忽忽期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 24
    },
    {
        "title": "閑題",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "男兒所在即為家，百鎰黃金一朵花。",
            "借问春风何处好，綠楊深巷馬頭斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 25
    },
    {
        "title": "金谷園",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "繁華事散逐香塵，流水无情草自春。",
            "日暮東风怨啼鳥，落花犹似墮樓人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 26
    },
    {
        "title": "重登科",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "星漢離宮月出輪，滿街含笑綺羅春。",
            "花前每被青蛾问，何事重來隻一人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 27
    },
    {
        "title": "游邊",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "黃沙連海路无塵，邊草長枯不見春。",
            "日暮拂雲堆下過，馬前逢著射雕人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 28
    },
    {
        "title": "将赴池州道中作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "青阳雲水去年尋，黃絹歌诗出翰林。投轄暫停留酒客，",
            "南去南來盡鄉國，月明秋水只沉沉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 29
    },
    {
        "title": "隋宮春",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "龍舟東下事成空，蔓草萋萋滿故宮。",
            "亡國亡家為顏色，露桃犹自恨春风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 30
    },
    {
        "title": "蠻中醉",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "瘴塞蠻江入洞流，人家多在竹棚頭。",
            "青山海上无城郭，唯見松牌出象州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 31
    },
    {
        "title": "寓題",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "把酒直須判酩酊，逢花莫惜暫淹留。",
            "假如三万六千日，半是悲哀半是愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 32
    },
    {
        "title": "送趙十二赴舉",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "省事卻因多事力，无心翻似有心來。",
            "秋风郡閣残花在，別后何人更一杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 33
    },
    {
        "title": "偶呈鄭先輩",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "不语亭亭儼薄妝，画裙雙鳳鬱金香。",
            "西京才子旁看取，何似喬家那窈娘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 34
    },
    {
        "title": "《子規",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "蜀地曾闻子規鳥，宣城又見杜鵑花。",
            "一叫一回腸一斷，三春三月憶三巴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 35
    },
    {
        "title": "江樓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "独酌芳春酒，登樓已半醺。谁驚一行雁，沖斷過江雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 36
    },
    {
        "title": "旅宿",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "旅館无良伴，凝情自悄然。寒燈思舊事，斷雁警愁眠。",
            "遠夢归侵曉，家书到來年。湘江好煙月，門系釣魚船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 37
    },
    {
        "title": "杜鵑",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "杜宇竟何冤，年年叫蜀門。至今銜積恨，終古吊残魂。",
            "芳草迷腸結，紅花染血痕。山川盡春色，嗚咽複谁論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 38
    },
    {
        "title": "闻蟬",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "火雲初似滅，曉角欲微清。故國行千里，新蟬忽数聲。",
            "时行仍仿佛，度日更分明。不敢频傾耳，唯憂白发生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 39
    },
    {
        "title": "送友人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "十载名兼利，人皆与命爭。青春留不住，白发自然生。",
            "夜雨滴鄉思，秋风從別情。都門五十裏，馳馬逐雞聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 40
    },
    {
        "title": "旅情",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "窗虛枕簟涼，寢倦憶瀟湘。山色幾时老，人心終日忙。",
            "松风半夜雨，簾月滿堂霜。匹馬好归去，江頭橘正香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 41
    },
    {
        "title": "曉望",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "独起望山色，水雞鳴蓼洲。房星隨月曉，楚木向雲秋。",
            "曲渚疑江盡，平沙似浪浮。秦原在何处，澤國碧悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 42
    },
    {
        "title": "貽友人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "自是東西客，逢人又送人。不應相見老，只是別離频。",
            "度日還知暮，平生未识春。儻无遷谷分，归去養天真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 43
    },
    {
        "title": "书事",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "自笑走紅塵，流年舊複新。東风半夜雨，南國万家春。",
            "失计拋魚艇，何門化涸鱗。是谁添歲月，老卻暗投人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 44
    },
    {
        "title": "別鶴",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "分飛共所從，六翮勢催风。聲斷碧雲外，影孤明月中。",
            "青田归路遠，丹桂舊巢空。矯翼知何处，天涯不可窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 45
    },
    {
        "title": "晚泊",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "帆濕去悠悠，停橈宿渡頭。乱煙迷野岸，独鳥出中流。",
            "篷雨延鄉夢，江风阻暮秋。儻无身外事，甘老向扁舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 46
    },
    {
        "title": "山寺",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "峭壁引行徑，截溪開石門。泉飛濺虛檻，雲起漲河軒。",
            "隔水看來路，疏籬見定猿。未閑難久住，归去複何言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 47
    },
    {
        "title": "早行",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "垂鞭信馬行，数裏未雞鳴。林下帶残夢，葉飛时忽驚。",
            "霜凝孤鶴迥，月曉遠山橫。僮僕休辭險，时平路複平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 48
    },
    {
        "title": "秋日偶題",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "荷花兼柳葉，彼此不勝秋。玉露滴初泣，金风吹更愁。",
            "綠眉甘棄墜，紅臉恨飄流。歎息是遊子，少年還白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 49
    },
    {
        "title": "憶归",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "新城非故里，終日想柴扃。興罷花還落，愁來酒欲醒。",
            "何人初發白，幾处乱山青。遠憶湘江上，漁歌对月聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 50
    },
    {
        "title": "偶見",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "朔风高緊掠河樓，白鼻騧郎白罽裘。",
            "有個當壚明似月，馬鞭斜揖笑回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 51
    },
    {
        "title": "醉倒",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "日晴空樂下仙雲，俱在涼亭送使君。",
            "莫辭一盞即相請，還是三年更不闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 52
    },
    {
        "title": "酬许十三秀才兼依來韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "多為裁诗步竹軒，有时凝思過朝昏。篇成敢道懷金璞，",
            "凭君把卷侵寒燭，麗句时傳画戟門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 53
    },
    {
        "title": "后池泛舟送王十秀才",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "城日晚悠悠，弦歌在碧流。夕风飄度曲，煙嶼隱行舟。",
            "问拍擬新令，怜香占彩球。當筵雖一醉，寧複緩離愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 54
    },
    {
        "title": "书情",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "谁家洛浦神，十四五來人。媚發輕垂額，香衫軟著身。",
            "摘蓮紅袖濕，窺淥翠蛾频。飛鵲徒來往，平阳公主親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 55
    },
    {
        "title": "兵部尚书席上作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "華堂今日綺筵開，谁喚分司禦史來。",
            "偶發狂言驚滿坐，三重粉面一时回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 56
    },
    {
        "title": "驌驦阪",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "荊州一万里，不如蒯易度。仰首望飛鳴，伊人何異趣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十五",
        "no#": 57
    }
]