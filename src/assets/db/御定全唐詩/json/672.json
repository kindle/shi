[
    {
        "title": "緋桃",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "短牆荒圃四无鄰，烈火緋桃照地春。坐久好风休掩袂，",
            "盡日更无鄉井念，此时何必見秦人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 1
    },
    {
        "title": "小院",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "小院无人夜，煙斜月轉明。清宵易惆悵，不必有離情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 2
    },
    {
        "title": "春雪初霽杏花正芳月上夜吟",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "霽景明如練，繁英杏正芳。姮娥應有语，悔共雪爭光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 3
    },
    {
        "title": "文惠宮人",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "認得前家令，宮人淚滿裾。不知梁佐命，全是沈尚书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 4
    },
    {
        "title": "贈竇尊師",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "我愛竇高士，棄官仍在家。為嫌句漏令，兼不要丹砂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 5
    },
    {
        "title": "穆天子傳",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "王母清歌玉管悲，瑤台應有再來期。",
            "穆王不得重相見，恐為无端哭盛姬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 6
    },
    {
        "title": "楚天",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "楚天遙望每長嚬，宋玉襄王盡作塵。",
            "不會瑤姬朝与暮，更為雲雨待何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 7
    },
    {
        "title": "寄徐山人",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "一室清羸鶴體孤，氣和神瑩爽冰壺。",
            "吳中高士雖求死，不那稽山有謝敷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 8
    },
    {
        "title": "題宗人故帖",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "所忠无處訪相如，风笈塵編跡尚餘。",
            "惟有孝標情最厚，一編遺在茂陵书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 9
    },
    {
        "title": "垂柳",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "絆惹春风別有情，世間谁敢鬥輕盈。",
            "楚王江畔无端種，餓損纖腰學不成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 10
    },
    {
        "title": "登興元城觀烽火",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "漢川城上角三呼，扈蹕防邊列万夫。",
            "褒姒塚前烽火起，不知泉下破顏无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 11
    },
    {
        "title": "鄧艾廟",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "昭烈遺黎死尚羞，揮刀斫石恨譙周。",
            "如何千载留遺廟，血食巴山伴武侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 12
    },
    {
        "title": "曲江春望",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "杏豔桃光奪晚霞，樂遊无廟有年華。",
            "漢朝冠蓋皆陵墓，十裏宜春漢苑花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 13
    },
    {
        "title": "漢殿",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "鳥去雲飛意不通，夜壇斜月轉松风。",
            "君王寂慮无消息，卻就闲人覓巨公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 14
    },
    {
        "title": "賀李昌时禁苑新命",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "振鹭翔鸞集禁闈，玉堂珠樹瑩风仪。",
            "不知新到靈和殿，张緒何如柳一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 15
    },
    {
        "title": "牡丹",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "顏色无因饒錦繡，馨香惟解掩蘭蓀。",
            "那堪更被煙蒙蔽，南國西施泣斷魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 16
    },
    {
        "title": "羅江驛",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "數枝高柳帶鳴鴉，一樹山榴自落花。",
            "已是向來多淚眼，短亭回首在天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 17
    },
    {
        "title": "奏捷西蜀題沱江驛",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "野客乘軺非所宜，況将儒懦報戎机。",
            "錦江不识臨邛酒，且免相如渴病归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 18
    },
    {
        "title": "春早落英",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "紛紛從此見花残，轉覺長繩系日難。",
            "樓上有愁春不淺，小桃风雪凭闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 19
    },
    {
        "title": "仲山",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "千载遺蹤寄薜蘿，沛中鄉里舊山河。",
            "長陵亦是閑丘隴，異日谁知与仲多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 20
    },
    {
        "title": "漢嗣",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "漢嗣安危係數君，高皇決意勢難分。",
            "张良口辨周昌吃，同建儲宮第一勳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 21
    },
    {
        "title": "四老廟",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "西漢儲宮定不傾，可能園綺勝良平。",
            "舉朝公将无全策，借請闲人羽翼成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 22
    },
    {
        "title": "南梁戲題漢高廟",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "數载從军似武夫，今隨戎捷氣偏粗。",
            "漢皇若问何為者，免道高阳舊酒徒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 23
    },
    {
        "title": "洛神",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "人世仙家本自殊，何須相見向中途。",
            "驚鴻瞥過游龍去，漫惱陳王一事无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 24
    },
    {
        "title": "初秋到慈州冬首换絳牧",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "秋杪方攀玉樹枝，來年无计待春暉。",
            "自嫌暫作仙城守，不逐鶯來共燕飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 25
    },
    {
        "title": "重經馮家舊裏",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "馮家舊宅閉柴關，修竹犹存潏水灣。",
            "應系星辰天上去，不留英骨葬人間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 26
    },
    {
        "title": "克復後登安國寺閣",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "千門万戶鞠蒿藜，斷燼遺垣一望迷。",
            "惆悵建章鴛瓦盡，夜來空見玉繩低。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 27
    },
    {
        "title": "題虔僧室",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "何緣春恨貯離憂，欲入空門万事休。",
            "水月定中何所謂，也嚬眉黛托腮愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 28
    },
    {
        "title": "見煬帝寶帳",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "漢文窮相作前王，慳惜明珠不鬥量。",
            "翡翠鮫鮹何所直，千裨万接上书囊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 29
    },
    {
        "title": "樓上偶題",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "塵土无因狎隱淪，青山一望每傷神。",
            "可能前嶺空喬木，應有懷才抱器人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 30
    },
    {
        "title": "親仁裏闻猿",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "朱雀街東半夜驚，楚魂湘夢两徒清。",
            "五更撩乱趨朝火，滿口塵埃亦數聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 31
    },
    {
        "title": "闻李瀆司勳下世",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "異鄉丹旐已飄揚，一顧深知實未亡。",
            "任被褚裒泉下笑，重将北面哭真長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 32
    },
    {
        "title": "試夜題省廊桂",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "麻衣穿穴两京塵，十見東堂綠桂春。",
            "今日競飛楊葉箭，魏舒休作画籌人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 33
    },
    {
        "title": "竹风",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "竹映风窗數陣斜，旅人愁坐思无涯。",
            "夜來留得江湖夢，全為幹聲似荻花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 34
    },
    {
        "title": "長溪秋望",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "柳短莎長溪水流，雨微煙暝立溪頭。",
            "寒鴉閃閃前山去，杜曲黃昏独自愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 35
    },
    {
        "title": "嚴子陵",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "嚴陵情性是真狂，抵觸三公傲帝王。",
            "不怕舊交嗔僭越，喚他侯霸作君房。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 36
    },
    {
        "title": "北齊",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "草草招提強據鞍，周師乘勝莫回看。",
            "背城肯戰知虛實，爭奈人前忍笑難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 37
    },
    {
        "title": "楚世家",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "偏信由來惑是非，一言邪佞脫危机。",
            "张仪重入懷王手，駟馬安車卻放归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 38
    },
    {
        "title": "驪山道中",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "月殿真妃下彩煙，漁阳追虜及湯泉。",
            "君王指點新豐樹，幾不親留七寶鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 39
    },
    {
        "title": "韋曲",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "欲写愁腸愧不才，多情練漉已低摧。",
            "窮郊二月初離別，独傍寒村嗅野梅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 40
    },
    {
        "title": "黃子陂荷花",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "十頃狂风撼曲塵，緣堤照水露紅新。",
            "世間花氣皆愁絕，恰是蓮香更惱人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 41
    },
    {
        "title": "野行",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "蝶戀晚花終不去，鸥逢春水固難飛。",
            "野人心地都无著，伴蝶隨鸥亦不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 42
    },
    {
        "title": "興元沈氏莊",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "清淺縈紆一水間，竹岡藤樹小躋攀。露沾荒草行人過，",
            "異鄉一笑因酣醉，忘卻愁來鬢发斑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 43
    },
    {
        "title": "乱後經表兄瓊華觀舊居",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "一去仙居似轉蓬，再經花謝倚春叢。醉中篇什金聲在，",
            "東风狼藉苔侵徑，蕙草香銷杏帶紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 44
    },
    {
        "title": "秋霽夜吟寄友人",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "槐柳蕭疏溽暑收，金商频伏火西流。塵衣歲晚緣身賤，",
            "惟思待月高梧下，更就東床訪惠休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 45
    },
    {
        "title": "賀李昌时禁苑新命",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "玉簡金文直上清，禁垣丹地閉嚴扃。黃扉議政參元化，",
            "塵中舊侶无音信，知道遼東鶴姓丁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 46
    },
    {
        "title": "寄蔣二十四",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "鳥囀蜂飛日漸長，旅人情味悔思量。禪門澹薄无心地，",
            "大知高士禁愁寂，試倚闌幹莫斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 47
    },
    {
        "title": "寄懷",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "有客傷春複怨離，夕阳亭畔草青时。淚從紅蠟无由制，",
            "雙溪未去饒归夢，夜夜孤眠枕独欹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 48
    },
    {
        "title": "送樊管司业归朝",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "近者蘇司业，文雄道最光。夫君居太學，妙譽繼中行。",
            "汲郡陵初發，汾阴篋久亡。寂寥方倚席，容易忽升堂。",
            "去日應懸榻，來时定裂裳。愜心频拾芥，應手屡穿楊。",
            "辯急如无敵，飛騰固自強。論心期舌在，问事畏頭長。",
            "駟馬終題柱，諸生悉面牆。啖螯譏爾雅，賣餅訴公羊。",
            "未見泥函谷，俄驚火建章。煙塵昏象魏，行在隔巴梁。",
            "紅粟填郿塢，青袍過壽阳。翦茅行殿濕，伐柏舊陵香。",
            "黌室青衿盡，渠門火旆揚。雲飛同去國，星散各殊方。",
            "賤子悲窮轍，當年亦擅場。齏辛尋幼婦，醴酒憶先王。",
            "聖域探姬孔，皇风樂禹湯。畏誅輕李喜，言命小臧倉。",
            "折樹休盤槊，沈鉤且釣璜。鴻都问詞客，他日莫相忘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 49
    },
    {
        "title": "奉使岐下闻唐弘夫行军為賊所擒，傷而有作",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "報國捐軀實壯夫，楚囚垂欲複神都。雲台画像皆何者，",
            "闻君敗績无归计，氣激星辰坐向隅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 50
    },
    {
        "title": "咸通中始闻褚河南归葬阳翟是歲上平徐方大肆慶賞又詔八品錫其裔孫追敘风概因成二十韵",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "冊府藏餘烈，皇綱正本朝。不聽還笏諫，幾覆綴旒祧。",
            "咫尺言終直，愴惶道已消。淚心傳位日，揮涕授遺朝。",
            "飛燕潛來趙，黃龍豈見譙。既迷秦帝鹿，難问賈生雕。",
            "穆卜緘縢秘，金根轍跡遙。北军那奪印，東海漫難橋。",
            "羅織黃門訟，笙簧白骨銷。炎方无信息，丹旐竟淪漂。",
            "邂逅江魚食，淒涼楚客招。文忠徒諡議，子卯但簫韶。",
            "未見公侯複，尋傷嗣续凋。流年隨水逝，高誼薄層霄。",
            "柱石林公遠，縑緗故國饒。奇蹤天驥活，遺軸錦鸞翹。",
            "近者淮夷戮，前年归馬調。始闻移北葬，兼議蔭山苗。",
            "聖澤覃将溥，貞魂喜定飄。異时窮巷客，懷古漫成謠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 51
    },
    {
        "title": "岐王宅",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "朱邸平臺隔禁闈，貴游陳跡尚依稀。雲低雍畤祈年去，",
            "承平舊物惟君盡，犹写雕鞍伴六飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 52
    },
    {
        "title": "東韋曲野思",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "淡霧輕雲匝四垂，綠塘秋望独顰眉。野蓮隨水无人見，",
            "孤燈夜夜愁欹枕，一覺滄洲似昔时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 53
    },
    {
        "title": "上巳",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "上巳接寒食，鶯花寥落晨。微微潑火雨，草草踏青人。",
            "涼似三秋景，清无九陌塵。与餘同病者，對此合傷神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 54
    },
    {
        "title": "移莎",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "移從杜城曲，置在小齋東。正是高秋裏，仍兼細雨中。",
            "結根方迸竹，疏蔭托高桐。苒苒齊芳草，飄飄笑斷蓬。",
            "片时留靜者，一夜響鳴蛩。野露通宵滴，溪煙盡日蒙。",
            "試才卑庾薤，求味笑周菘。只此霜栽好，他时贈伯翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 55
    },
    {
        "title": "西明寺威公盆池新稻",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "為笑江南種稻时，露蟬鳴後雨霏霏。蓮盆積潤分畦小，",
            "支公尚有三吳思，更使幽人憶釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 56
    },
    {
        "title": "紅葉",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "无處不飄揚，高樓臨道旁。素娥前夕月，青女夜來霜。",
            "宿雨隨时潤，秋晴著物光。幽懷長若此，病眼更相妨。",
            "蜀紙裁深色，燕脂落靚妝。低叢侵小閣，倒影入回塘。",
            "謝脁留霞綺，甘甯棄錦张。何人休遠道，是處有斜阳。",
            "薜荔垂书幌，梧桐墜井床。晚风生旅館，寒籟近僧房。",
            "桂綠明淮甸，楓丹照楚鄉。雁疏臨鄠杜，蟬急傍瀟湘。",
            "樹異桓宣武，園非顧辟疆。茂陵愁臥客，不自保危腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 57
    },
    {
        "title": "鸂鶒",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "一宿南塘煙雨时，好风搖動綠波微。驚離曉岸沖花去，",
            "画屏見後長回首，爭得雕籠莫放归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 58
    },
    {
        "title": "螢",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "日下蕪城莽蒼中，濕螢撩乱起衰叢。寒煙陳後長門閉，",
            "羈人此夕方愁緒，心似寒灰首似蓬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 59
    },
    {
        "title": "夜蟬",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "翠竹高梧夾後溪，勁风危露雨淒淒。那知北牖残燈暗，",
            "羈人此夕如三歲，不整寒衾待曙雞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 60
    },
    {
        "title": "七夕",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "露白风清夜向晨，小星垂佩月埋輪。絳河浪淺休相隔，",
            "倚闌殿北斜樓上，多少通宵不寐人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 61
    },
    {
        "title": "中秋夜玩月",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "一夜高樓万景奇，碧天无際水无涯。只留皎月當層漢，",
            "坐來離思憂将曉，爭得嫦娥仔細知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 62
    },
    {
        "title": "八月十六日夜月",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "斷腸佳賞固難期，昨夜銷魂更不疑。丹桂影空蟾有露，",
            "堪恨賈生曾慟哭，不緣清景為憂时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 63
    },
    {
        "title": "送韋向之睦州謁使君",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "才子南游多遠情，閑舟蕩漾任春行。",
            "新安江上長如此，何似新安太守清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 64
    },
    {
        "title": "春残",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "景為春时短，愁隨別夜長。暫棋寧號隱，輕醉不成鄉。",
            "风雨曾通夕，莓苔有眾芳。落花如便去，樓上即河梁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 65
    },
    {
        "title": "玫瑰",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "麝炷騰清燎，鮫紗覆綠蒙。宮妝臨曉日，錦段落東风。",
            "无力春煙裏，多愁暮雨中。不知何事意，深淺两般紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 66
    },
    {
        "title": "牡丹",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "真宰多情巧思新，固将能事送残春。為雲為雨徒虛语，",
            "嫦娥婺女曾相送，留下鴉黃作蕊塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 67
    },
    {
        "title": "秋晚高樓",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "松拂疏窗竹映闌，素琴幽怨不成彈。清宵霽極雲離岫，",
            "高樓瞪目归鴻遠，如信嵇康欲画難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 68
    },
    {
        "title": "離鸞",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "闻道離鸞思故鄉，也知情愿嫁王昌。塵埃一別楊朱路，",
            "庭前佳樹名梔子，試結同心寄謝娘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 69
    },
    {
        "title": "柳",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "春思春愁一万枝，遠村遙岸寄相思。西園有雨和苔長，",
            "晚來飛絮如霜鬢，恐為多情管別離。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 70
    },
    {
        "title": "春阴",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "一寸回腸百慮侵，旅愁危涕两爭禁。天涯已有銷魂別，",
            "春雲更覺愁於我，閑蓋低村作暝阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 71
    },
    {
        "title": "春深独行馬上有作",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "日烈风高野草香，百花狼藉柳披猖。連天瑞靄千門遠，",
            "年來与问闲遊者，若個傷春向路旁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 72
    },
    {
        "title": "春雨",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "綺陌夜來雨，春樓寒望迷。遠容迎燕戲，乱響隔鶯啼。",
            "有恨開蘭室，无言對李蹊。花欹渾拂檻，柳重欲垂堤。",
            "燈檠昏魚目，熏爐咽麝臍。別輕天北鶴，夢怯汝南雞。",
            "入戶侵羅幌，捎簷潤繡題。新豐樹已失，長信草初齊。",
            "乱蝶寒犹舞，驚烏暝不棲。庾郎盤馬地，卻怕有春泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 73
    },
    {
        "title": "漢代",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "漢代金為屋，吳宮綺作寮。豔詞傳靜婉，新曲定妖嬈。",
            "箭響犹残夢，簽聲報早朝。鮮明臨曉日，回轉度春宵。",
            "半袖籠清鏡，前絲壓翠翹。靜多如有待，閑極似无憀。",
            "梓澤花犹滿，靈和柳未凋。障昏巫峽雨，屏掩浙江潮。",
            "未信潘名岳，應疑史姓蕭。漏因歌暫斷，燈為雨频挑。",
            "飲酒闌三雅，投壺賽百嬌。鈿蟬新翅重，金鴨舊香焦。",
            "水淨疑澄練，霞孤欲建標。別隨秦柱促，愁為蜀弦麼。",
            "玄晏難瘳痹，臨邛但發痟。聯诗征弱絮，思友詠甘蕉。",
            "王氏怜諸謝，周郎定小喬。黼幃翹彩雉，波扇画文鰩。",
            "荇密妨垂釣，荷欹欲度橋。不因衣帶水，谁覺路迢迢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 74
    },
    {
        "title": "牡丹",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "青帝於君事分偏，穠堆浮豔倚朱門。",
            "雖然占得笙歌地，将甚酬他雨露恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 75
    },
    {
        "title": "湘妃廟",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "劉表荒碑斷水濱，廟前幽草閉残春。已将愁淚留斑竹，",
            "九峰相似堪疑處，望見蒼梧不見人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 76
    },
    {
        "title": "句",
        "author": "唐彥謙",
        "biography": "",
        "paragraphs": [
            "独來成悵望，不去泥欄幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百七十二",
        "no#": 77
    }
]