[
    {
        "title": "送馬向入蜀",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "遊子出咸京，巴山万里程。白雲連鳥道，青壁遰猿聲。",
            "雨雪經泥阪，煙花望錦城。工文人共许，應紀蜀中行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 1
    },
    {
        "title": "送李補闕归朝",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "駟馬归咸秦，雙鳧出海門。還從清切禁，再沐圣明恩。",
            "禮樂中朝貴，文章大雅存。江湖多放逸，獻替欲谁論。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 2
    },
    {
        "title": "送日本使還",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "絕國将无外，扶桑更有東。來朝逢圣日，归去及秋风。",
            "夜泛潮回際，晨征蒼莽中。鯨波騰水府，蜃气壯仙宮。",
            "天眷何期遠，王文久已同。相望杳不見，離恨托飛鴻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 3
    },
    {
        "title": "題開元寺牡丹",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "此花南地知難種，慚愧僧閑用意栽。海燕解怜频睥睨，",
            "惟有数苞紅萼在，含芳只待舍人來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 4
    },
    {
        "title": "香爐峰",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "香爐一峰絕，頂在寺門前。儘是玲瓏石，时生旦暮煙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 5
    },
    {
        "title": "白銅鞮",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "騕褭錦障泥，樓頭日又西。留歡住不住，素齒白銅鞮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 6
    },
    {
        "title": "楊叛兒",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "哀怨楊叛兒，駘蕩郎知否。香死博山爐，煙生白門柳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 7
    },
    {
        "title": "春寒",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "乱雪從教舞，回风任聽吹。春寒能作底，已被柳條欺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 8
    },
    {
        "title": "廬山独夜",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "寒空五老雪，斜月九江雲。鐘聲知何处，蒼蒼樹裏闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 9
    },
    {
        "title": "天臺独夜",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "銀地秋月色，石樑夜溪聲。谁知屐齒盡，為破煙苔行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 10
    },
    {
        "title": "送寒岩归士",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "不掛絲纊衣，归向寒岩棲。寒岩风雪夜，又過岩前溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 11
    },
    {
        "title": "送陳司馬",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "家寄茅洞中，身遊越城下。甯知许長史，不憶陳司馬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 12
    },
    {
        "title": "武夷山仙城",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "武夷无上路，毛徑不通风。欲共麻姑住，仙城半在空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 13
    },
    {
        "title": "避暑二首",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "一株金染密，数畝碧鮮疏。避暑臨溪坐，何妨直釣魚。",
            "斑多筒簟冷，發少角冠清。避暑長林下，寒蟬又有聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 14
    },
    {
        "title": "浙西李尚书奏毀淫昏廟",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "傳闻廢淫祀，万里靜山陂。欲慰靈均恨，先燒靳尚祠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 15
    },
    {
        "title": "酬相公再游雲門寺",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "遠羨五雲路，逶迤千騎回。遺簪唯一去，貴賞不重來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 16
    },
    {
        "title": "杭州祝濤頭二首",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "不道沙堤盡，犹欺石棧頑。寄言飛白雪，休去打青山。",
            "倒打錢塘郭，長驅白浪花。吞吳休得也，輸卻五千家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 17
    },
    {
        "title": "问漁叟",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "生事同漂梗，机心在野船。如何臨逝水，白发未忘筌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 18
    },
    {
        "title": "雲封庵",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "登岩背山河，立石秋风裏。隱見浙江濤，一尺東溝水。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 19
    },
    {
        "title": "漢宮曲",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "水色簾前流玉霜，趙家飛燕侍昭阳。",
            "掌中舞罷簫聲絕，三十六宮秋夜長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 20
    },
    {
        "title": "和嵩阳客月夜憶上清人",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "独夜嵩阳憶上仙，月明三十六峰前。",
            "瑤池月勝嵩阳月，人在玉清眠不眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 21
    },
    {
        "title": "八月望夕雨",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "今年八月十五夜，寒雨蕭蕭不可闻。",
            "如練如霜在何处，吳山越水万重雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 22
    },
    {
        "title": "觀浙江濤",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "浙江悠悠海西綠，驚濤日夜两翻覆。",
            "錢塘郭裏看潮人，直至白頭看不足。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 23
    },
    {
        "title": "廬山瀑布",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "虛空落泉千仞直，雷奔入江不暫息。",
            "今古長如白練飛，一條界破青山色。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 24
    },
    {
        "title": "嘉興寒食",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "嘉興郭裏逢寒食，落日家家拜掃回。",
            "唯有縣前蘇小小，无人送与紙錢來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 25
    },
    {
        "title": "憶揚州",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "蕭娘臉下難勝淚，桃葉眉頭易得愁。",
            "天下三分明月夜，二分无賴是揚州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 26
    },
    {
        "title": "八月燈夕寄游越施秀才",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "四天淨色寒如水，八月清輝冷似霜。",
            "想得越人今夜見，孟家珠在鏡中央。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 27
    },
    {
        "title": "八月十五夜",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "皎皎秋空八月圓，常娥端正桂枝鮮。",
            "一年无似如今夜，十二峰前看不眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 28
    },
    {
        "title": "題伍員廟",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "千载空祠雲海頭，夫差亡國已千秋。",
            "浙波只有靈濤在，拜奠青山人不休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 29
    },
    {
        "title": "員嶠先生",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "員嶠先生无白发，海煙深处采青芝。",
            "逢人借问陶唐主，欲進冰蠶五色絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 30
    },
    {
        "title": "莫愁曲",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "玳瑁床頭刺戰袍，碧紗窗外葉騷騷。",
            "若為教作遼西夢，月冷如丁风似刀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 31
    },
    {
        "title": "寄白司馬",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "三條九陌花时節，万戶千車看牡丹。",
            "爭遣江州白司馬，五年风景憶長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 32
    },
    {
        "title": "相思林",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "遊客遠遊新過嶺，每逢芳樹问芳名。",
            "長林遍是相思樹，爭遣愁人独自行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 33
    },
    {
        "title": "寄海嶠丈人",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "万丈只愁滄海淺，一身谁測歲華遙。",
            "自言來此雲邊住，曾看秦王樹石橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 34
    },
    {
        "title": "寄潘先生",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "至人知姓不知名，闻道黃金骨節輕。",
            "世上仙方无覓处，欲來西嶽事先生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 35
    },
    {
        "title": "宮中曲二首",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "披香侍宴插山花，厭著龍綃著越紗。",
            "恃賴傾城人不及，檀妝唯約数條霞。",
            "身輕入寵盡恩私，腰細偏能舞柘枝。",
            "一日新妝拋舊樣，六宮爭画黑煙眉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 36
    },
    {
        "title": "七夕",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "一道鵲橋橫渺渺，千聲玉佩過玲玲。",
            "別離還有經年客，悵望不如河鼓星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 37
    },
    {
        "title": "八月九月望夕雨",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "八月繁雲連九月，两回三五晦漫漫。",
            "一年悵望秋将盡，不得常娥正面看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 38
    },
    {
        "title": "喜雪",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "長愛謝家能詠雪，今朝見雪亦狂歌。",
            "楊花道即偷人句，不那楊花似雪何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 39
    },
    {
        "title": "春飲",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "烏家若下蟻還浮，白玉尊前倒即休。",
            "不是春來偏愛酒，應須得酒遣春愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 40
    },
    {
        "title": "二月望日",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "長短一年相似夜，中秋未必勝中春。",
            "不寒不暖看明月，況是從來少睡人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 41
    },
    {
        "title": "讀遠书",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "两轉三回讀遠书，画簷愁見燕归初。",
            "百花时節教人懶，雲髻朝來不欲梳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 42
    },
    {
        "title": "古樹",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "古樹欹斜臨古道，枝不生花腹生草。",
            "行人不見樹少时，樹見行人幾番老。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 43
    },
    {
        "title": "独住僧",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "百補袈裟一比丘，数莖長睫覆青眸。",
            "多應独住山林慣，唯照寒泉自剃頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 44
    },
    {
        "title": "傷画松道芬上人",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "百法驅馳百年壽，五勞消瘦五株松。",
            "昨來闻道嚴陵死，画到青山第幾重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 45
    },
    {
        "title": "觀釣台画图",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "一水寂寥青靄合，两崖崔崒白雲残。",
            "画人心到啼猿破，欲作三聲出樹難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 46
    },
    {
        "title": "荊巫夢思",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "楚水白波风嫋嫋，荊門暮色雨蕭蕭。",
            "相思合眼夢何处，十二峰高巴字遙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 47
    },
    {
        "title": "浙東故孟尚书種柳",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "孟家種柳東城去，臨水逶迤思故人。",
            "不似當时大司馬，重來得見漢南春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 48
    },
    {
        "title": "長洲覽古",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "吳王上國長洲奢，翠黛寒江一道斜。",
            "傷見摧残舊宮樹，美人曾插九枝花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 49
    },
    {
        "title": "卻归舊山望月有寄",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "年年明月總相似，大抵人情自不同。",
            "今夜故山依舊見，班家扇樣碧峰東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 50
    },
    {
        "title": "再归松溪舊居宿西林",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "五粒松深溪水清，眾山搖落月偏明。",
            "西林靜夜重來宿，暗記人家犬吠聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 51
    },
    {
        "title": "玩花五首",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "一樹梨花春向暮，雪枝残处怨风來。",
            "明朝漸校无多去，看到黃昏不欲回。",
            "麹塵溪上素紅枝，影在溪流半落时。",
            "时人自惜花腸斷，春风卻是等闲吹。",
            "朱霞焰焰山枝動，綠野聲聲杜宇來。",
            "谁為蜀王身作鳥，自啼還自有花開。",
            "谁家躑躅青林裏，半見殷花焰焰枝。",
            "憶得倡樓人送客，深紅衫子影門时。",
            "花到薔薇明豔絕，燕支顆破麥风秋。",
            "一番弄色一番退，小婦輕妝大婦愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 52
    },
    {
        "title": "長慶春",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "山頭水色薄籠煙，久客新愁長慶年。",
            "身上五勞仍病酒，夭桃窗下背花眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 53
    },
    {
        "title": "山鷓鴣詞",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "南越嶺頭山鷓鴣，傳是當时守貞女。",
            "化為飛鳥怨何人，犹有啼聲帶蠻语。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 54
    },
    {
        "title": "鄭女出參丈人詞",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "鳳釵翠翹雙宛轉，出見丈人梳洗晚。",
            "掣曳羅綃跪拜时，柳條无力花枝軟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 55
    },
    {
        "title": "春雨",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "花时悶見聯綿雨，雲入人家水毀堤。",
            "昨日春风源上路，可怜紅錦枉拋泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 56
    },
    {
        "title": "和白使君木蘭花",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "枝枝轉勢雕弓動，片片搖光玉劍斜。",
            "見说木蘭征戍女，不知那作酒邊花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 57
    },
    {
        "title": "正月十五夜呈幕中諸公",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "宵游二万七千人，独坐重城圈一身。",
            "步月遊山俱不得，可怜辜負白頭春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 58
    },
    {
        "title": "樂府新诗",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "一聲盧女十三弦，早嫁城西好少年。",
            "不羨越溪歌者苦，採蓮归去綠窗眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 59
    },
    {
        "title": "春陪相公看花宴會二首",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "丞相邀歡事事同，玉簫金管咽東风。",
            "百分春酒莫辭醉，明日的无今日紅。",
            "木蘭花謝可怜條，遠道音书轉寂寥。",
            "春去一年春又盡，幾回空上望江橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 60
    },
    {
        "title": "牡丹",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "何人不愛牡丹花，占斷城中好物華。",
            "疑是洛川神女作，千嬌万態破朝霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 61
    },
    {
        "title": "過馬當",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "风波隱隱石蒼蒼，送客靈鴉拂去檣。",
            "三月盡頭雲葉秀，小姑新著好衣裳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 62
    },
    {
        "title": "金谷覽古",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "金谷園中数尺土，问人知是綠珠台。",
            "綠珠歌舞天下絕，唯与石家生禍胎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 63
    },
    {
        "title": "上阳紅葉",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "洛下三分紅葉秋，二分翻作上阳愁。",
            "千聲万片禦溝上，一片出宮何处流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 64
    },
    {
        "title": "洛城秋砧",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "三川水上秋砧發，五鳳樓前明月新。",
            "谁為秋砧明月夜，洛阳城裏更愁人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 65
    },
    {
        "title": "和川守侍郎緱山題仙廟",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "王子緱山石殿明，白家诗句詠吹笙。",
            "安知散席人間曲，不是寥天鶴上聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 66
    },
    {
        "title": "和夜題玉泉寺",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "歲歲雲山玉泉寺，年年車馬洛阳塵。",
            "风清月冷水邊宿，诗好官高能幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 67
    },
    {
        "title": "和秋游洛阳",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "洛阳自古多才子，唯愛春风爛漫遊。",
            "今到白家诗句出，无人不詠洛阳秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 68
    },
    {
        "title": "和嘲春风",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "源上拂桃燒水發，江邊吹杏暗園開。",
            "可怜半死龍門樹，懊惱春风作底來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 69
    },
    {
        "title": "侍郎宅泛池",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "蓮子花邊回竹岸，雞頭葉上蕩蘭舟。",
            "谁知洛北朱門裏，便到江南綠水遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 70
    },
    {
        "title": "和侍郎邀宿不至",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "蟾蜍有色門應鎖，街鼓无聲夜自深。",
            "料得白家诗思苦，一篇诗了一彈琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 71
    },
    {
        "title": "自鄂渚至河南将归江外留辭侍郎",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "一生所遇唯元白，天下无人重布衣。",
            "欲別朱門淚先盡，白頭遊子白身归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 72
    },
    {
        "title": "蠻入西川后",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "守隘一夫何处在，長橋万里只堪傷。",
            "紛紛塞外烏蠻賊，驅盡江頭濯錦娘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 73
    },
    {
        "title": "憶紫溪",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "長憶紫溪春欲盡，千岩交映水回斜。",
            "岩空水滿溪自紫，水態更籠南燭花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 74
    },
    {
        "title": "誇紅槿",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "谁道槿花生感促，可怜相计半年紅。",
            "何如桃李无多少，並打千枝一夜风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 75
    },
    {
        "title": "題縉雲山鼎池二首",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "黃帝旌旗去不回，空餘片石碧崔嵬。",
            "有时风卷鼎湖浪，散作晴天雨點來。",
            "天地茫茫成古今，仙都凡有幾人尋。",
            "到來唯見山高下，只是不知湖淺深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 76
    },
    {
        "title": "宿冽上人房",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "浮生不定若蓬飄，林下真僧偶見招。",
            "觉后始知身是夢，更闻寒雨滴芭蕉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 77
    },
    {
        "title": "汴河覽古",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "煬帝龍舟向此行，三千宮女采橈輕。",
            "渡河不似如今唱，為是楊家怨思聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 78
    },
    {
        "title": "柬白丈人",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "昔时丈人鬢发白，千年松下鋤茯苓。",
            "今來見此松樹死，丈人斬新鬢发青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 79
    },
    {
        "title": "覽鏡詞",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "寶鏡磨來寒水清，青衣把就綠窗明。",
            "潘郎懊惱新秋發，拔卻一莖生两莖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 80
    },
    {
        "title": "寄玄阳先生",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "不能相見見人傳，rv岸山中岱岸邊。",
            "顏貌只如三二十，道年三百亦藏年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 81
    },
    {
        "title": "白人",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "暖风入煙花漠漠，白人梳洗尋常薄。",
            "泥郎為插瓏璁釵，爭教一朵牙雲落。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 82
    },
    {
        "title": "奉酬元相公上元",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "出擁樓船千万人，入為台輔九霄身。",
            "如何更羨看燈夜，曾見宮花拂面春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 83
    },
    {
        "title": "奉和鸚鵡",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "毛羽曾經翦处残，學人言语道暄寒。",
            "任饒長被金籠闔，也免棲飛雨雪難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 84
    },
    {
        "title": "将至妙喜寺",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "清风嫋嫋越水陂，遠樹蒼蒼妙喜寺。",
            "自有車輪与馬蹄，未曾到此波心地。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 85
    },
    {
        "title": "紅蕉",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "紅蕉曾到嶺南看，校小芭蕉幾一般。",
            "差是斜刀剪紅絹，卷來開去葉中安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 86
    },
    {
        "title": "見少室",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "適我一簞孤客性，问人三十六峰名。",
            "青雲无忘白雲在，便可嵩阳老此生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 87
    },
    {
        "title": "语兒見新月",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "幾处天邊見新月，經過草市憶西施。",
            "娟娟水宿初三夜，曾伴愁蛾到语兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 88
    },
    {
        "title": "回施先輩見寄新诗二首",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "九幽仙子西山卷，讀了絛繩系又開。",
            "此卷玉清宮裏少，曾尋真誥讀诗來。",
            "紫河車裏丹成也，皂莢枝頭早晚飛。",
            "料得仙宮列仙籍，如君進士出身稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 89
    },
    {
        "title": "送沈亞之赴郢掾",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "千万乘驄沈司戶，不須惆悵郢中游。",
            "幾年白雪无人唱，今日唯君上雪樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 90
    },
    {
        "title": "答白公",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "高景爭來草木頭，一生心事酒前休。",
            "山公自是仙人侶，攜手醉登城上樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 91
    },
    {
        "title": "句",
        "author": "徐凝",
        "biography": "",
        "paragraphs": [
            "青山舊路在，白首醉還鄉。",
            "試到第三橋，便入千頃花。",
            "乱后見淮水，归心忽迢遙。",
            "乍疑鯨噴浪，忽似鷁淩风。呀呷汀洲動，喧闐裏巷空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百七十四",
        "no#": 92
    }
]