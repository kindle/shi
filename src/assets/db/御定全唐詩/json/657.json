[
    {
        "title": "錢尚父生日",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "大昴分光降鬥牛，興唐宗社作諸侯。伊夔事业扶千载，",
            "錦衣玉食将何報，更俟莊椿一舉頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 1
    },
    {
        "title": "寄前戶部陸郎中",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "出馴桑雉入朝簪，簫灑清名映士林。近日篇章欺白雪，",
            "離乱事多人不會，酒濃花暖且閑吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 2
    },
    {
        "title": "登瓦棺寺閣",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "下盤空跡上雲浮，偶逐僧行步步愁。暫憩已知須用意，",
            "懶指台城更東望，鵲飛龍鬥盡荒丘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 3
    },
    {
        "title": "九華山費征君所居",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "草堂何處試徘徊，見说遺蹤向此開。蟾桂自归三徑後，",
            "盡夕為君思曩日，野泉嗚咽路莓苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 4
    },
    {
        "title": "途中寄懷",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "不知何處是前程，合眼騰騰信馬行。两鬢已衰时未遇，",
            "試哭军門看谁问，舊來還似禰先生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 5
    },
    {
        "title": "京口見李侍郎",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "傞傞江柳欲矜春，鐵甕城邊見故人。屈指不堪言甲子，",
            "還有杖頭沽酒物，待尋山寺話逡巡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 6
    },
    {
        "title": "秋日酬张特玄",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "病寄南徐两度秋，故人依約亦揚州。偶因雁足思闲事，",
            "平生意氣消磨盡，甘露軒前看水流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 7
    },
    {
        "title": "登高詠菊盡",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "籬畔霜前偶得存，苦教迟晚避蘭蓀。能銷造化幾多力，",
            "陶公沒後无知己，露滴幽叢見淚痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 8
    },
    {
        "title": "登夏州城樓",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "寒城獵獵戍旗风，独倚危樓悵望中。万里山河唐土地，",
            "好脫儒冠從校尉，一枝長戟六鈞弓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 9
    },
    {
        "title": "水邊偶題",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "野水无情去不回，水邊花好為谁開。只知事逐眼前去，",
            "思量此理何人會，蒙邑先生最有才。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 10
    },
    {
        "title": "故洛阳公鎮大梁时隱得遊門下今之經歷事往人非聊抒所懷以傷以謝",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "孤舟欲泊思何窮，曾憶西來值雪中。珠履少年初滿座，",
            "今日斯文向谁说，淚碑棠樹两成空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 11
    },
    {
        "title": "杜陵秋思",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "南望商於北帝都，两堪棲托两无圖。只闻斥逐张公子，",
            "一杯淥酒他年憶，瀝向清波寄五湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 12
    },
    {
        "title": "隱嘗在江陵忝故中令白公叨蒙知遇今復重過渚宮感事悲身遂成長句",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "往歲酂侯鎮渚宮，曾将清律暖孤蓬。才怜曼倩三冬後，",
            "鳳凰池涸台星拆，回首岐山憶至公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 13
    },
    {
        "title": "夜泊毗陵无錫縣有寄",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "草蟲幽咽樹初團，独系孤舟夜已闌。濁浪勢奔吳苑急，",
            "他日親朋應大笑，始知书劍是无端。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 14
    },
    {
        "title": "桃花",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "暖觸衣襟漠漠香，間梅遮柳不勝芳。數枝豔拂文君酒，",
            "舊山山下還如此，回首東风一斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 15
    },
    {
        "title": "籌筆驛",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "拋擲南阳為主憂，北征東討盡良籌。时來天地皆同力，",
            "唯餘岩下多情水，犹解年年傍驛流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 16
    },
    {
        "title": "重過隨州故兵部李侍郎恩知因抒長句",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "莊周高論伯牙琴，閑夜思量淚滿襟。四海共谁言近事，",
            "慚愧蒼生還有意，解歌襦袴至如今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 17
    },
    {
        "title": "商于驛樓東望有感",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "山川去接漢江東，曾伴隋侯醉此中。歌繞夜梁珠宛轉，",
            "惆悵知音竟難得，两行清淚白楊风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 18
    },
    {
        "title": "寄南城韋逸人",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "杜甫诗中韋曲花，至今无賴尚豪家。美人曉折露沾袖，",
            "羨他南澗高眠客，春去春來任物華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 19
    },
    {
        "title": "梅花",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "吳王醉處十餘裏，照野拂衣今正繁。經雨不隨山鳥散，",
            "欲寄所思无好信，為人惆悵又黃昏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 20
    },
    {
        "title": "淮南高駢所造迎仙樓",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "鸞音鶴信杳難回，鳳駕龍車早晚來。仙境是谁知處所，",
            "子細思量成底事，露凝风擺作塵埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 21
    },
    {
        "title": "和禪月大師見贈",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "高僧惠我七言诗，頓豁塵心展白眉。秀似谷中花媚日，",
            "漂蕩秦吳十餘载，因循犹恨识師迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 22
    },
    {
        "title": "謁文宣王廟",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "晚來乘興謁先師，松柏淒淒人不知。九仞蕭牆堆瓦礫，",
            "儻使小儒名稍立，豈教吾道受棲迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 23
    },
    {
        "title": "代文宣王答",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "三教之中儒最尊，止戈為武武尊文。吾今尚自披蓑笠，",
            "若教顏閔英靈在，終不羞他李老君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 24
    },
    {
        "title": "重送朗州张員外",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "朱輪此去正春风，且駐青雲聽斷蓬。一榻早年容孺子，",
            "酬德酬恩两无路，謾勞惆悵鳳城東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 25
    },
    {
        "title": "廣陵秋夜讀進士常修三篇因題",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "入蜀归吳三首诗，藏於笥篋重于師。劍關夜讀相如聽，",
            "明年二月春风裏，江島闲人慰所思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 26
    },
    {
        "title": "逼試投所知",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "桃在仙翁舊苑傍，暖煙輕靄撲人香。十年此地频偷眼，",
            "尋思仙骨終難得，始与回頭问玉皇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 27
    },
    {
        "title": "漢江上作",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "漢江波浪淥於苔，每到江邊病眼開。半雨半风終日恨，",
            "對此空慚聖明代，忍教纓上有塵埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 28
    },
    {
        "title": "秋夜寄進士顧榮",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "秋河耿耿夜沉沉，往事三更盡到心。多病謾勞窺聖代，",
            "空羨良朋盡高價，可怜東箭与南金。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 29
    },
    {
        "title": "寄渭北徐從事",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "暖雲慵墮柳垂條，驄馬徐郎過渭橋。官秩舊參荀秘監，",
            "莫恨東风促行李，不多时節卻归朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 30
    },
    {
        "title": "徐寇南逼感事獻江南知己次韵",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "酒闌離思浩无窮，西望維揚憶數公。万里飄零身未了，",
            "今日便成盧子諒，滿襟珠淚墮霜风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 31
    },
    {
        "title": "寄三衢孫員外",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "小敷文伯見何时，南望三衢渴複饑。天子未能崇典誥，",
            "儘是數旬陪奉處，使君爭肯不相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 32
    },
    {
        "title": "淮南送盧端公归台",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "鳳鸞勢逸九霄寬，北去南來任羽翰。朱紱两參王儉府，",
            "應笑张綱謾生事，埋輪不得在長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 33
    },
    {
        "title": "煬帝陵",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "入郭登橋出郭船，紅樓日日柳年年。",
            "君王忍把平陳业，只博雷塘數畝田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 34
    },
    {
        "title": "馬嵬坡",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "佛屋前頭野草春，貴妃輕骨此為塵。",
            "從來絕色知難得，不破中原未是人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 35
    },
    {
        "title": "柳",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "灞岸晴來送別频，相偎相倚不勝春。",
            "自家飛絮犹无定，爭解垂絲絆路人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 36
    },
    {
        "title": "隋堤柳",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "夾路依依千里遙，路人回首認隋朝。",
            "春风未借宣華意，犹費工夫長綠條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 37
    },
    {
        "title": "孟浩然墓",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "數步荒榛接舊蹊，寒江漠漠草淒淒。",
            "鹿門黃土无多少，恰到书生塚便低。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 38
    },
    {
        "title": "秦紀",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "長策東鞭及海隅，黿鼉奔走鬼神趨。",
            "怜君未到沙丘日，肯信人間有死无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 39
    },
    {
        "title": "仙掌",
        "author": "羅隱",
        "biography": "",
        "paragraphs": [
            "掌前流水駐无塵，掌下軒車日日新。",
            "謾向山頭高舉手，何曾招得路行人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百五十七",
        "no#": 40
    }
]