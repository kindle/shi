[
    {
        "title": "二遺诗",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "谁從毫末見參天，又到蒼蒼化石年。万古清风吹作籟，",
            "幸与野人俱散誕，不煩良匠更雕鐫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 1
    },
    {
        "title": "鵁鶄",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "詞賦曾誇鸀鳿流，果為名誤別滄洲。雖蒙靜置疏籠晚，",
            "防徽避繳无窮事，好与裁书謝白鸥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 2
    },
    {
        "title": "新秋月夕，客有自遠相尋者，作吳體二首以贈",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "风初寥寥月乍滿，杉篁左右供餘清。因君一話故山事，",
            "日闻羽檄日夜急，掉臂欲归岩下行。",
            "驚闻遠客訪良夜，扶病起坐綸巾欹。清談白紵思悄悄，",
            "林端片月落未落，強慰別情言后期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 3
    },
    {
        "title": "闲书",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "病學高僧置一床，披衣才暇即焚香。閑階雨過苔花潤，",
            "升平闻道无时節，試问中林亦不妨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 4
    },
    {
        "title": "独夜",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "新秋霽夜有清境，窮襜病客无佳期。生公把經向石说，",
            "古稱独坐与独立，若比群居終校奇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 5
    },
    {
        "title": "寄吳融",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "一夜秋聲入井桐，数枝危綠怕西风。霏霏晚砌煙華上，",
            "到頭江畔從漁事，織作中流万尺篊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 6
    },
    {
        "title": "中秋待月",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "轉缺霜輪上轉迟，好风偏似送佳期。簾斜樹隔情无限，",
            "何人為校清涼力，未似初圓欲午时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 7
    },
    {
        "title": "重憶白菊",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "我怜貞白重寒芳，前后叢生夾小堂。月朵暮開无絕豔，",
            "更憶幽窗凝一夢，夜來村落有微霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 8
    },
    {
        "title": "別墅懷归",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "水國初冬和暖天，南榮方好背阳眠。題诗朝憶複暮憶，",
            "何人授我黃金百，買取蘇君負郭田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 9
    },
    {
        "title": "寄淮南鄭寶书記",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "記室千年翰墨孤，唯君才學似應徐。五丁驅得神功盡，",
            "清詞醉草无因見，但釣寒江半尺鱸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 10
    },
    {
        "title": "小雪后书事",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "时候频過小雪天，江南寒色未曾偏。楓汀尚憶逢人別，",
            "鄰翁意緒相安慰，多说明年是稔年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 11
    },
    {
        "title": "寒夜同襲美訪北禪院寂上人",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "月樓风殿靜沉沉，披拂霜華訪道林。鳥在寒枝棲影動，",
            "自是海邊鸥伴侶，不勞金偈更降心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 12
    },
    {
        "title": "和襲美江南道中懷茅山廣文南阳博士三首次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "一片輕帆背夕阳，望三峰拜七真堂。天寒夜漱雲牙淨，",
            "莫言洞府能招隱，會輾飆輪見玉皇。",
            "壺中行坐可攜天，何況林間息万緣。組綬任垂三品石，",
            "想得雷平春色動，五芝煙甲又芊眠。",
            "良常應不動移文，金醴從酸亦自醺。桂父舊歌飛絳雪，",
            "珍重雙雙玉條脫，盡凭三島寄羊君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 13
    },
    {
        "title": "早春雪中作吳體寄襲美",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "迎春避臘不肯下，欺花凍草還飄然。光填馬窟蓋塞外，",
            "君披鶴氅独自立，何人解道真神仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 14
    },
    {
        "title": "奉和襲美吳中言情見寄次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "菰煙蘆雪是儂鄉，釣線隨身好坐忘。徒愛右军遺點画，",
            "莫问江邊漁艇子，玉皇看賜羽衣裳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 15
    },
    {
        "title": "和襲美揚州看辛夷花次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "柳疏梅墮少春叢，天遣花神別致功。高处朵稀難避日，",
            "不待群芳應有意，等闲桃杏即爭紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 16
    },
    {
        "title": "奉和襲美行次野梅次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "飛棹參差拂早梅，強欺寒色尚低徊。风怜薄媚留香与，",
            "不知謝客離腸醒，臨水應添万恨來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 17
    },
    {
        "title": "奉和襲美暇日独处見寄",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "謝府殷樓少暇时，又拋清宴入书帷。三千餘歲上下古，",
            "知君滿篋前朝事，鳳諾龍奴借与窺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 18
    },
    {
        "title": "奉和襲美見訪不遇",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "為愁煙岸老塵囂，扶病呼兒劚翠苕。只道府中持簡牘，",
            "倚仗遍吟春照午，一池冰段幾多消。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 19
    },
    {
        "title": "酬襲美見寄海蟹",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "药杯應阻蟹螯香，卻乞江邊採捕郎。自是揚雄知郭索，",
            "強作南朝风雅客，夜來偷醉早梅傍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 20
    },
    {
        "title": "奉和襲美開元寺客省早景即事次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "日上罘罳疊影紅，一聲清梵万緣空。褵褷滿地貝多雪，",
            "靈香散盡禪家接，谁共殷源小品同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 21
    },
    {
        "title": "独夜有懷因作吳體寄襲美",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "人吟側景抱凍竹，鶴夢缺月沈枯梧。清澗无波鹿无魄，",
            "不然快作燕市飲，笑撫肉枅眠酒壚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 22
    },
    {
        "title": "闔閭城北有賣花翁，討春之士往往造焉，因招襲美",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "故城邊有賣花翁，水曲舟輕去盡通。十畝芳菲為舊业，",
            "若要見春归处所，不過攜手问東风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 23
    },
    {
        "title": "奉和襲美病中庭際海石榴花盛發見寄次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "紫府真人餉露囊，猗蘭燈燭未熒煌。丹華乞曙先侵日，",
            "那堪謝氏庭前見，一段清香染郤郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 24
    },
    {
        "title": "襲美以春橘見惠兼之雅篇，因次韵酬謝",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "到春犹作九秋鮮，應是親封白帝煙。良玉有漿須讓味，",
            "珍重更過三十子，不堪分付野人邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 25
    },
    {
        "title": "奉和襲美病中书情寄上崔諫議次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "或偃虛齋或在公，藹然林下昔賢风。庭前有蝶爭煙蕊，",
            "西園夜燭偏堪憶，曾為題诗刻半紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 26
    },
    {
        "title": "奉酬襲美病中見寄",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "逢花逢月便相招，忽臥雲航隔野橋。春恨与谁同酩酊，",
            "早晚卻還岩下電，共尋芳徑結煙條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 27
    },
    {
        "title": "奉和襲美病孔雀",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "懶移金翠傍簷楹，斜倚芳叢舊態生。唯奈瘴煙籠飲啄，",
            "爭得鷓鴣來伴著，不妨還校有心情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 28
    },
    {
        "title": "上元日道室焚修寄襲美",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "三清今日聚靈官，玉刺齊抽謁廣寒。執蓋冒花香寂曆，",
            "唯有世塵中小兆，夜來心拜七星壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 29
    },
    {
        "title": "正月十五惜春寄襲美",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "六分春色一分休，滿眼東波儘是愁。花匠凝寒應束手，",
            "見織短篷裁小楫，拏煙閑弄個漁舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 30
    },
    {
        "title": "襲美病中闻余游顏家園見寄，次韵酬之",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "日華风蕙正交光，羯末相攜藉草塘。佳酒旋傾醽醁嫩，",
            "今日好為聯句會，不成剛為欠檀郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 31
    },
    {
        "title": "春雨即事寄襲美",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "小謝輕埃日日飛，城邊江上阻春暉。雖愁野岸花房凍，",
            "比鄰釣叟无塵事，灑笠鳴蓑夜半归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 32
    },
    {
        "title": "奉和襲美抱疾杜門見寄次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "雖失春城醉上期，下帷裁遍未裁诗。因吟郢岸百畝蕙，",
            "但醫沈約重瞳健，不怕江花不滿枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 33
    },
    {
        "title": "偶掇野蔬寄襲美有作",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "野園煙裏自幽尋，嫩甲香蕤引漸深。行歇每依鴉舅影，",
            "欲助春盤還愛否，不妨蕭灑似家林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 34
    },
    {
        "title": "奉和襲美臥疾感春見寄次韵",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "共尋花思极飛騰，疾帶春寒去未能。煙徑水涯多好鳥，",
            "除卻数函图籍外，更将何事結良朋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 35
    },
    {
        "title": "徐方平后闻赦因寄襲美",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "新春旒扆禦翬軒，海內初傳渙汗恩。秦獄已收為厲气，",
            "除卻数般傷痛外，不知何事及王孫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 36
    },
    {
        "title": "襲美以魚箋見寄，因謝成篇",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "搗成霜粒細鱗鱗，知作愁吟喜見分。向日乍驚新繭色，",
            "見倚小窗親襞染，盡图春色寄夫君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 37
    },
    {
        "title": "次和襲美病后春思",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "气和靈府漸氤氳，酒有賢人药有君。七字篇章看月得，",
            "早晚共搖孤艇去，紫屏风外碧波文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 38
    },
    {
        "title": "襲美以公齋小宴見招，因代书寄之",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "早雲才破漏春阳，野客晨興喜又忙。自与酌量煎药水，",
            "唯待数般幽事了，不妨還入少年場。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 39
    },
    {
        "title": "京口",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "江幹古渡傷離情，斷山零落春潮平。東风料峭客帆遠，",
            "可怜宋帝籌帷处，蒼翠无煙草自生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 40
    },
    {
        "title": "潤州送人往長洲",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "秋來频上向吳亭，每上思归意剩生。廢苑池台煙裏色，",
            "君住松江多少日，為嘗鱸鱠与蓴羹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十四",
        "no#": 41
    },
    {
        "title": "潤州江口送人謁池阳衛郎中",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
