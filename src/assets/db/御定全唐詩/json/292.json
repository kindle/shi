[
    {
        "title": "題玉真觀公主山池院",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "香殿留遺影，春朝玉戶開。羽衣重素幾，珠網儼輕埃。",
            "石自蓬山得，泉經太液來。柳絲遮綠浪，花粉落青苔。",
            "鏡掩鸞空在，霞消鳳不回。唯餘古桃樹，傳是上仙栽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 1
    },
    {
        "title": "送永阳崔明府",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "古國群舒地，前當桐柏關。連綿江上雨，稠疊楚南山。",
            "沙館行帆息，楓洲候吏還。乘籃若有暇，精舍在林間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 2
    },
    {
        "title": "送曹三同猗遊山寺",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "山蹋青蕪盡，涼秋古寺深。何时得連策，此夜更闻琴。",
            "窮水雲同穴，過僧虎共林。殷勤如念我，遺爾掛冠心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 3
    },
    {
        "title": "送崔校书赴梓幕",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "碧峰天柱下，鼓角鎮南军。管記催飛檄，蓬萊輟校文。",
            "棧霜朝似雪，江霧晚成雲。想出褒中望，巴庸方路分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 4
    },
    {
        "title": "送夔州班使君",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "魚國巴庸路，麾幢漢守過。曉檣爭市隘，夜鼓祭神多。",
            "雲白當山雨，风清滿峽波。夷陵舊人吏，犹誦两岐歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 5
    },
    {
        "title": "送菊潭王明府",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "业成洙泗客，皓發著儒衣。一与遊人別，仍闻帶印归。",
            "林多宛地古，雲盡漢山稀。莫愛潯阳隱，嫌官计亦非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 6
    },
    {
        "title": "送太易上人赴東洛",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "遙見登山处，青蕪雪后春。雲深嶽廟火，寺宿洛阳人。",
            "餌药将齋折，唯诗与道親。凡經幾回別，麈尾不離身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 7
    },
    {
        "title": "和王卿立秋即事",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "秋宜何处看，試问白雲官。暗入蟬鳴樹，微侵蝶繞蘭。",
            "向风涼稍動，近日暑犹残。九陌浮埃減，千峰爽气攢。",
            "换衣防竹暮，沈果訝泉寒。宮響傳花杵，天清出露盤。",
            "高禽當側弁，遊鮪对凭欄。一奏招商曲，空令繼唱難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 8
    },
    {
        "title": "和李員外与舍人詠玫瑰花寄徐侍郎",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "仙吏紫薇郎，奇花共玩芳。攢星排綠蒂，照眼發紅光。",
            "暗妒翻階药，遙連直署香。游枝蜂繞易，礙刺鳥銜妨。",
            "露濕凝衣粉，风吹散蕊黃。蒙蘢珠樹合，焕爛錦屏张。",
            "留客勝看竹，思人比愛棠。如傳采蘋詠，遠思滿瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 9
    },
    {
        "title": "冬夜耿拾遺王秀才就宿因傷故人",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "舊时闻笛淚，今夜重沾衣。方恨同人少，何堪相見稀。",
            "竹煙凝澗壑，林雪似芳菲。多謝勞車馬，應怜独掩扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 10
    },
    {
        "title": "早春遊慈恩南池",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "山寺臨池水，春愁望遠生。蹋橋逢鶴起，尋竹值泉橫。",
            "新柳絲犹短，輕蘋葉未成。還如虎溪上，日暮伴僧行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 11
    },
    {
        "title": "雨夜見投之作",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "出戶繁星盡，池塘暗不開。動衣涼气度，遰樹遠聲來。",
            "燈外初行電，城隅偶隱雷。因知謝文學，曉望比塵埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 12
    },
    {
        "title": "龍池寺望月寄韋使君閻別駕",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "清光此夜中，万古望應同。當野山沈霧，低城樹有风。",
            "花宮紛共邃，水府皓相空。遙想高樓上，唯君对庾公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 13
    },
    {
        "title": "秋夜憶興善院寄苗發",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "右军多住寺，此夜后池秋。自与山僧伴，那因洛客愁。",
            "捲簾霜靄靄，滿目水悠悠。若有诗相贈，期君憶惠休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 14
    },
    {
        "title": "病中寄鄭十六兄",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "倦枕欲徐行，開簾秋月明。手便筇杖冷，頭喜葛巾輕。",
            "綠草前侵水，黃花半上城。虛消此塵景，不見十年兄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 15
    },
    {
        "title": "衛明府寄枇杷葉以诗答",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "傾筐呈綠葉，重疊色何鮮。詎是秋风裏，犹如曉露前。",
            "仙方當見重，消疾本應便。全勝甘蕉贈，空投謝氏篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 16
    },
    {
        "title": "過慶寶寺",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "黃葉前朝寺，无僧寒殿開。池晴龜出曝，松暮鶴飛回。",
            "古井碑橫草，阴廊画雜苔。禪宮亦銷歇，塵世轉堪哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 17
    },
    {
        "title": "奉和张大夫酬高山人",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "野客居鈴閣，重門将校稀。豸冠親谷弁，龜印识荷衣。",
            "座右寒飆爽，談餘暮角微。蒼生須太傅，山在豈容归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 18
    },
    {
        "title": "送嚴使君游山",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "家楚依三戶，辭州選一錢。酒杯同寄世，客棹任銷年。",
            "赤燒兼山遠，青蕪与浪連。青春明月夜，知上鄂君船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 19
    },
    {
        "title": "送柳震归蜀",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "白日雙流靜，西看蜀國春。桐花能乳鳥，竹節競祠神。",
            "蹇步徒相望，先鞭不可親。知從江僕射，登榻更何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 20
    },
    {
        "title": "送樂平苗明府",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "天際山多处，東安古邑深。綠田通竹裏，白浪隔楓林。",
            "诗有江僧和，門唯越客尋。應将放魚化，一境表吾心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 21
    },
    {
        "title": "贈送鄭錢二郎中",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "梅含柳已動，昨日起東风。惆悵心徒壯，无如鬢作翁。",
            "百年飄若水，万緒盡归空。何可宗禪客，迟回岐路中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 22
    },
    {
        "title": "酬鄭十四望驛不得同宿見贈因寄张參军",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "逢君喜成淚，暫似故鄉中。謫宦犹多懼，清宵不得終。",
            "月煙高有鶴，宿草淨无蟲。明日郤超會，應思下客同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 23
    },
    {
        "title": "暮春野望寄錢起",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "草長花落樹，羸病強尋春。无複少年意，空餘華发新。",
            "青原高見水，白社靜逢人。寄謝南宮客，軒車不可親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 24
    },
    {
        "title": "送王使君小子孝廉登科归省",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "年少通經學，登科尚佩觿。张馮本名士，蔡廓是佳兒。",
            "鞍馬臨岐路，龍鍾对別離。寄书胡太守，請与故人知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 25
    },
    {
        "title": "雲阳寺石竹花",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "一自幽山別，相逢此寺中。高低俱出葉，深淺不分叢。",
            "野蝶難爭白，庭榴暗讓紅。谁怜芳最久，春露到秋风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 26
    },
    {
        "title": "送高勝重謁曹王",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "江上青楓岸，阴阴万里春。朝辭郢城酒，暮見洞庭人。",
            "興比乘舟訪，恩懷倒屣親。想君登舊榭，重喜掃芳塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 27
    },
    {
        "title": "閑園书事招暢當",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "闻蟬晝眠后，欹枕对蓬蒿。羸病懶尋戴，田園方詠陶。",
            "傍簷蟲掛靜，出樹蝶飛高。惆悵臨清鏡，思君見鬢毛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 28
    },
    {
        "title": "過錢員外",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "為郎頭已白，跡向市朝稀。移病居荒宅，安貧著敗衣。",
            "野園隨客醉，雪寺伴僧归。自说東峰下，松蘿滿故扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 29
    },
    {
        "title": "贈庾侍禦",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "年少身无累，相逢憶此时。雪過雲寺宿，酒向竹園期。",
            "白发今催老，清琴但起悲。唯應逐宗炳，內學愿為師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 30
    },
    {
        "title": "贈李端",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "共憶南浮日，登高望若何。楚田湖草遠，江寺海榴多。",
            "载酒尋山宿，思人帶雪過。東西幾回別，此會各蹉跎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 31
    },
    {
        "title": "送流人",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "闻说南中事，悲君重竄身。山村楓子鬼，江廟石郎神。",
            "童稚留荒宅，图书托故人。青門好风景，為爾一沾巾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 32
    },
    {
        "title": "過胡居士睹王右丞遺文",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "舊日相知盡，深居独一身。閉門空有雪，看竹永无人。",
            "每许前山隱，曾怜陋巷貧。題诗今尚在，暫為拂流塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 33
    },
    {
        "title": "送郎使君赴郢州",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "使君持節去，雲水滿前程。楚寺多連竹，江檣遠映城。",
            "登樓向月望，賽廟傍山行。若動思鄉詠，應貽謝步兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 34
    },
    {
        "title": "賊平后送人北归",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "世乱同南去，时清独北還。他鄉生白发，舊國見青山。",
            "曉月過残壘，繁星宿故關。寒禽与衰草，处处伴愁顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 35
    },
    {
        "title": "觀獵騎",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "纏臂繡綸巾，貂裘窄稱身。射禽风助箭，走馬雪翻塵。",
            "金埒爭開道，香車為駐輪。翩翩不知处，傳是霍家親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 36
    },
    {
        "title": "同苗員外宿薦福常師房",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "浮生共多故，聚宿喜君同。人息时闻磬，燈搖乍有风。",
            "霜階疑水際，夜木似山中。一愿持如意，長來事遠公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 37
    },
    {
        "title": "送喬廣下第归淮南",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "遙想長淮盡，荒堤楚路斜。戍旌標白浪，罟網入青葭。",
            "啼鳥仍臨水，愁人更見花。東堂一枝在，為子惜年華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 38
    },
    {
        "title": "风箏",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "高风吹玉柱，万籟忽齊飄。颯樹迟難度，縈空細漸銷。",
            "松泉鹿門夜，笙鶴洛濱朝。坐与真僧聽，支頤向寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 39
    },
    {
        "title": "闲居寄苗發",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "漸向浮生老，前期竟若何。独身居处靜，永夜坐时多。",
            "厭逐青林客，休吟白雪歌。支公有遺寺，重与謝安過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 40
    },
    {
        "title": "送王先生归南山",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "儒中年最老，独有濟南生。愛子方傳业，无官自耦耕。",
            "竹通山舍遠，雲接雪田平。愿作門人去，相隨隱姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 41
    },
    {
        "title": "寄天臺秀師",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "天臺瀑布寺，傳有白頭師。幻跡示羸病，空門无住持。",
            "雪晴看鶴去，海夜与龍期。永愿親瓶屨，呈功得问疑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 42
    },
    {
        "title": "送夏侯審赴甯國",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "青圻連白浪，曉日渡南津。山疊陵阳樹，舟多建业人。",
            "煙霞高占寺，楓竹暗停神。如接玄暉集，江丞独見親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 43
    },
    {
        "title": "雲阳館与韓紳宿別",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "故人江海別，幾度隔山川。乍見翻疑夢，相悲各问年。",
            "孤燈寒照雨，濕竹暗浮煙。更有明朝恨，離杯惜共傳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 44
    },
    {
        "title": "送盧使君赴夔州",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "鐃管隨旌旆，高秋遠上巴。白波連霧雨，青壁斷蒹葭。",
            "凭幾雙童靜，登樓万井斜。政成知變俗，當應画輪車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 45
    },
    {
        "title": "夜闻回雁",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "雁響天邊過，高高望不分。颼飀傳細雨，嘹唳隔長雲。",
            "散向谁家盡，归來幾客闻。還将今夜意，西海話蘇君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 46
    },
    {
        "title": "賦得的的帆向浦",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "向浦參差去，隨波遠近還。初移芳草裏，正在夕阳間。",
            "隱映回孤驛，微明出乱山。向空看不盡，归思滿江關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 47
    },
    {
        "title": "秋思呈尹植裴说",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "靜向懶相偶，年将衰共催。前途歡不集，往事恨空來。",
            "晝景委紅葉，月華銷綠苔。沈思竟何有，坐結玉琴哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 48
    },
    {
        "title": "閑園即事寄暕公",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "欲就東林寄一身，尚怜兒女未成人。柴門客去残阳在，",
            "深山蘭若何时到，羨与閑雲作四鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 49
    },
    {
        "title": "題暕上人院",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "閉門不出自焚香，擁褐看山歲月長。雨后綠苔生石井，",
            "更说本師同學在，幾时攜手見衡阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 50
    },
    {
        "title": "長安曉望寄程補闕",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "迢遞山河擁帝京，參差宮殿接雲平。风吹曉漏經長樂，",
            "独有淺才甘未達，多慚名在魯諸生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 51
    },
    {
        "title": "下第日书情寄上叔父",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "微才空觉滯京師，末學曾為叔父知。雪裏題诗偏見賞，",
            "欲归江海尋山去，愿報何人得桂枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 52
    },
    {
        "title": "南原望漢宮",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "荒原空有漢宮名，衰草茫茫雉堞平。連雁下时秋水在，",
            "故事悠悠不可问，寒禽野水自縱橫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 53
    },
    {
        "title": "早夏寄元校书",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "独遊野徑送芳菲，高竹林居接翠微。綠岸草深蟲入遍，",
            "蓬蓽永无車馬到，更當齋夜憶玄暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 54
    },
    {
        "title": "贈衡岳隱禪師",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "擁褐安居南嶽頭，白雲高寺見衡州。石窗湖水搖寒月，",
            "垂垂身老将傳法，因下人間遂北遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 55
    },
    {
        "title": "題淩雲寺",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "春山古寺繞滄波，石磴盤空鳥道過。百丈金身開翠壁，",
            "不与方袍同結社，下归塵世竟如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 56
    },
    {
        "title": "晦日益州北池陪宴",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "臨泛從公日，仙舟翠幕张。七橋通碧沼，雙樹接花塘。",
            "玉燭收寒气，金波隱夕光。野闻歌管思，水靜綺羅香。",
            "游騎縈林遠，飛橈截岸長。郊原懷灞滻，陂溠写江潢。",
            "常侍傳花詔，偏裨问羽觴。豈令南峴首，千载播餘芳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 57
    },
    {
        "title": "送曲山人之衡州",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "白石先生眉發光，已分甜雪飲紅漿。衣巾半染煙霞气，",
            "千年城郭如相问，華表峨峨有夜霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 58
    },
    {
        "title": "立秋日",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "律變新秋至，蕭條自此初。花酣蓮報謝，葉在柳呈疏。",
            "澹日非雲映，清风似雨餘。捲簾涼暗度，迎扇暑先除。",
            "草靜多翻燕，波澄乍露魚。今朝散騎省，作賦興何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 59
    },
    {
        "title": "詠古寺花",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "共愛芳菲此樹中，千跗万萼裹枝紅。",
            "迟迟欲去犹回望，覆地无人滿寺风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 60
    },
    {
        "title": "酬张芬有赦后見贈",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "紫鳳朝銜五色书，阳春忽布網羅除。已将心變寒灰后，",
            "勞君故有诗相贈，欲報瓊瑤恨不如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 61
    },
    {
        "title": "哭苗員外呈张參军",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "思君寧家宅，久接竹林期。嘗值偷琴处，親闻比玉时。",
            "高人不易合，弱冠早相知。試藝臨諸友，能文即我師。",
            "淩寒松未老，先暮槿何衰。季子生前別，羊曇醉后悲。",
            "壽堂乖一慟，奠席阻長辭。因瀝殊方淚，遙成墓下诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 62
    },
    {
        "title": "金陵懷古",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "輦路江楓暗，宮庭野草春。傷心庾開府，老作北朝臣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 63
    },
    {
        "title": "發渝州卻寄韋判官",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "紅燭津亭夜見君，繁弦急管两紛紛。",
            "平明分手空江轉，唯有猿聲滿水雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 64
    },
    {
        "title": "送盧徹之太原謁馬尚书",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "榆落雕飛關塞秋，黃雲画角見並州。",
            "翩翩羽騎雙旌后，上客親隨郭細侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 65
    },
    {
        "title": "峽口送友人",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "峽口花飛欲盡春，天涯去住淚沾巾。",
            "來时万里同為客，今日翻成送故人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 66
    },
    {
        "title": "故郭婉仪挽歌",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "一日辭秦鏡，千秋別漢宮。豈唯泉路掩，長使月輪空。",
            "苦色凝朝露，悲聲切暝风。婉仪餘舊德，仍载禮經中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 67
    },
    {
        "title": "送翰林张學士嶺南勒圣碑",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "漢恩天外洽，周頌日邊稱。文独司空羨，书兼太尉能。",
            "出關逢北雁，度嶺逐南鵬。使者翰林客，餘春归灞陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 68
    },
    {
        "title": "送吉校书東归",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "少年芸閣吏，罷直暫归休。独与親知別，行逢江海秋。",
            "聽猿看楚岫，隨雁到吳洲。处处園林好，何人待子猷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 69
    },
    {
        "title": "早春遊望",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "東风春未足，試望秦城曲。青草狀寒蕪，黃花似秋菊。",
            "壯将歡共去，老与悲相逐。独作遊社人，暮過威輦宿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 70
    },
    {
        "title": "秋日趨府上张大夫",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "重城洞啟肅秋煙，共说羊公在鎮年。鞞鼓暗驚林葉落，",
            "謫吏何能沐风化，空将歌頌拜車前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 71
    },
    {
        "title": "竹裏徑",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "幽徑行跡稀，清阴苔色古。蕭蕭风欲來，乍似蓬山雨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 72
    },
    {
        "title": "黃子陂",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "岸芳春色曉，水影夕阳微。寂寂深煙裏，漁舟夜不归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 73
    },
    {
        "title": "田鶴",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "散下渚田中，隱見菰蒲裏。哀鳴自相應，欲作淩风起。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 74
    },
    {
        "title": "药園",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "春園芳已遍，綠蔓雜紅英。独有深山客，时來辨药名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 75
    },
    {
        "title": "石井",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "苔色遍春石，桐阴入寒井。幽人独汲时，先樂残阳影。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 76
    },
    {
        "title": "板橋",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "橫遮野水石，前帶荒村道。來往見愁人，清风柳阴好。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 77
    },
    {
        "title": "石蓮花",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "今逢石上生，本自波中有。紅豔秋风裏，谁怜眾芳后。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 78
    },
    {
        "title": "遠寺鐘",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "杳杳疏鐘發，因风清複引。中宵独聽之，似与東林近。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 79
    },
    {
        "title": "松下雪",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "不隨晴野盡，独向深松積。落照入寒光，偏能伴幽寂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 80
    },
    {
        "title": "新柳",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "全欺芳蕙晚，似妒寒梅疾。撩乱發青條，春风來幾日。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 81
    },
    {
        "title": "唐昌公主院看花",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "遺殿空長閉，乘鸞自不回。至今荒草上，寥落舊花開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 82
    },
    {
        "title": "別张贊",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "今日山晴后，残蟬菊發时。登樓見秋色，何处最相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 83
    },
    {
        "title": "晚思",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "蛩餘窗下月，草濕階前露。晚景淒我衣，秋风入庭樹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 84
    },
    {
        "title": "留盧秦卿",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "知有前期在，難分此夜中。无将故人酒，不及石尤风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 85
    },
    {
        "title": "登峴亭",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "峴山回首望秦關，南向荊州幾日還。",
            "今日登臨唯有淚，不知风景在何山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 86
    },
    {
        "title": "哭麹山人",
        "author": "司空曙",
        "biography": "",
        "paragraphs": [
            "憶昔秋风起，君曾歎逐臣。何言芳草日，自作九泉人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十二",
        "no#": 87
    },
    {
        "title": "過堅上人故院与李端同賦",
        "author": "司空曙",
        "biography": "",
