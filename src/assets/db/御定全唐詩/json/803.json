[
    {
        "title": "酬人雨后玩竹",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "南天春雨时，那鑒雪霜姿。眾類亦雲茂，虛心能自持。",
            "多留晉賢醉，早伴舜妃悲。晚歲君能賞，蒼蒼勁節奇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 1
    },
    {
        "title": "春望詞四首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "花開不同賞，花落不同悲。欲问相思处，花開花落时。",
            "攬草結同心，将以遺知音。春愁正斷絕，春鳥複哀吟。",
            "风花日将老，佳期犹渺渺。不結同心人，空結同心草。",
            "那堪花滿枝，翻作两相思。玉箸垂朝鏡，春风知不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 2
    },
    {
        "title": "宣上人見示与諸公唱和",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "许廁高齋唱，涓泉定不如。可怜譙記室，流水滿禪居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 3
    },
    {
        "title": "风",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "獵蕙微风遠，飄弦唳一聲。林梢鳴淅瀝，松徑夜淒清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 4
    },
    {
        "title": "月",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "魄依鉤樣小，扇逐漢机團。細影将圓質，人間幾处看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 5
    },
    {
        "title": "蟬",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "露滌清音遠，风吹数葉齊。聲聲似相接，各在一枝棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 6
    },
    {
        "title": "池上雙鳥",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "雙棲綠池上，朝暮共飛還。更憶将雛日，同心蓮葉間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 7
    },
    {
        "title": "鴛鴦草",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "綠英滿香砌，两两鴛鴦小。但娛春日長，不管秋风早。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 8
    },
    {
        "title": "罰赴邊有懷上韋令公二首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "闻道邊城苦，今來到始知。羞将門下曲，唱与隴頭兒。",
            "黠虜犹違命，烽煙直北愁。卻教嚴譴妾，不敢向松州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 9
    },
    {
        "title": "詠八十一顆",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "色比丹霞朝日，形如合浦筼簹。",
            "開时九九如数，見处雙雙頡頏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 10
    },
    {
        "title": "謁巫山廟",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "乱猿啼处訪高唐，路入煙霞草木香。山色未能忘宋玉，",
            "惆悵廟前多少柳，春來空鬥画眉長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 11
    },
    {
        "title": "牡丹",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "去春零落暮春时，淚濕紅箋怨別離。常恐便同巫峽散，",
            "只欲欄邊安枕席，夜深閑共说相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 12
    },
    {
        "title": "賊平后上高相公",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "驚看天地白荒荒，瞥見青山舊夕阳。",
            "始信大威能照映，由來日月借生光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 13
    },
    {
        "title": "送友人",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "水國蒹葭夜有霜，月寒山色共蒼蒼。",
            "谁言千里自今夕，離夢杳如關塞長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 14
    },
    {
        "title": "聽僧吹蘆管",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "曉蟬嗚咽暮鶯愁，言语殷勤十指頭。",
            "罷閱梵书聊一弄，散隨金磬泥清秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 15
    },
    {
        "title": "酬郭簡州寄柑子",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "霜規不讓黃金色，圓質仍含禦史香。",
            "何处同聲情最異，臨川太守謝家郎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 16
    },
    {
        "title": "上川主武元衡相國二首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "落日重城夕霧收，玳筵雕俎薦諸侯。",
            "因令朗月當庭燎，不使珠簾下玉鉤。",
            "東閣移尊綺席陳，貂簪龍節更宜春。",
            "军城画角三聲歇，雲幕初垂紅燭新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 17
    },
    {
        "title": "憶荔枝",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "傳闻象郡隔南荒，絳實豐肌不可忘。",
            "近有青衣連楚水，素漿還得類瓊漿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 18
    },
    {
        "title": "斛石山曉望寄呂侍禦",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "曦輪初轉照仙扃，旋擘煙嵐上窅冥。",
            "不得玄暉同指點，天涯蒼翠漫青青。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 19
    },
    {
        "title": "寄詞",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "菌閣芝樓杳靄中，霞開深見玉皇宮。",
            "紫阳天上神仙客，稱在人間立世功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 20
    },
    {
        "title": "斛石山书事",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "王家山水画图中，意思都盧粉墨容。",
            "今日忽登虛境望，步搖冠翠一千峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 21
    },
    {
        "title": "送姚員外",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "万條江柳早秋枝，嫋地翻风色未衰。",
            "欲折爾來将贈別，莫教煙月两鄉悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 22
    },
    {
        "title": "酬祝十三秀才",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "浩思藍山玉彩寒，冰囊敲碎楚金盤。",
            "诗家利器馳聲久，何用春闈榜下看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 23
    },
    {
        "title": "別李郎中",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "花落梧桐鳳別凰，想登秦嶺更淒涼。",
            "安仁縱有诗将賦，一半音詞雜悼亡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 24
    },
    {
        "title": "送扶煉師",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "錦浦归舟巫峽雲，綠波迢遞雨紛紛。",
            "山阴妙術人傳久，也说将鵝与右军。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 25
    },
    {
        "title": "摩訶池贈蕭中丞",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "昔以多能佐碧油，今朝同泛舊仙舟。",
            "淒涼逝水頹波遠，惟有碑泉咽不流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 26
    },
    {
        "title": "鄉思",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "峨嵋山下水如油，怜我心同不系舟。",
            "何日片帆離錦浦，棹聲齊唱發中流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 27
    },
    {
        "title": "和李书記席上見贈",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "翩翩射策東堂秀，豈複相逢豁寸心。",
            "借问风光為谁麗，万條絲柳翠煙深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 28
    },
    {
        "title": "棠梨花和李太尉",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "吳均蕙圃移嘉木，正及東溪春雨时。",
            "日晚鶯啼何所為，淺深紅膩壓繁枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 29
    },
    {
        "title": "酬文使君",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "延英曉拜漢恩新，五馬騰驤九陌塵。",
            "今日謝庭飛白雪，巴歌不復舊阳春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 30
    },
    {
        "title": "酬吳隨君",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "支公別墅接花扃，買得前山總未經。",
            "入戶剡溪雲水滿，高齋咫尺躡青冥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 31
    },
    {
        "title": "酬李校书",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "才遊象外身雖遠，學茂區中事易闻。",
            "自顧漳濱多病后，空瞻逸翮舞青雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 32
    },
    {
        "title": "賦淩雲寺二首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "闻说淩雲寺裏苔，风高日近絕纖埃。",
            "橫雲點染芙蓉壁，似待诗人寶月來。",
            "闻说淩雲寺裏花，飛空繞磴逐江斜。",
            "有时鎖得嫦娥鏡，鏤出瑤台五色霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 33
    },
    {
        "title": "九日遇雨二首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "万里驚飆朔气深，江城蕭索晝阴阴。",
            "谁怜不得登山去，可惜寒芳色似金。",
            "茱萸秋節佳期阻，金菊寒花滿院香。",
            "神女欲來知有意，先令雲雨暗池塘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 34
    },
    {
        "title": "酬雍秀才貽巴峽图",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "千疊雲峰万頃湖，白波分去繞荊吳。",
            "感君识我枕流意，重示瞿塘峽口图。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 35
    },
    {
        "title": "上王尚书",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "碧玉雙幢白玉郎，初辭天帝下扶桑。",
            "手持雲篆題新榜，十万人家春日長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 36
    },
    {
        "title": "和劉賓客玉蕣",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "瓊枝的皪露珊珊，欲折如披玉彩寒。",
            "閑拂朱房何所似，緣山偏映月輪残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 37
    },
    {
        "title": "江邊",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "西风忽報雁雙雙，人世心形两自降。",
            "不為魚腸有真訣，谁能夢夢立清江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 38
    },
    {
        "title": "送盧員外",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "玉壘山前风雪夜，錦官城外別離魂。",
            "信陵公子如相问，長向夷門感舊恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 39
    },
    {
        "title": "題竹郎廟",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "竹郎廟前多古木，夕阳沉沉山更綠。",
            "何处江村有笛聲，聲聲儘是迎郎曲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 40
    },
    {
        "title": "贈蘇十三中丞",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "洛阳陌上埋輪气，欲逐秋空擊隼飛。",
            "今日芝泥檢征詔，別須台外振霜威。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 41
    },
    {
        "title": "和郭員外題万里橋",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "万里橋頭独越吟，知凭文字写愁心。",
            "細侯风韵兼前事，不止為舟也作霖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 42
    },
    {
        "title": "送鄭眉州",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "雨暗眉山江水流，離人掩袂立高樓。",
            "雙旌千騎駢東陌，独有羅敷望上頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 43
    },
    {
        "title": "江亭餞別",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "綠沼紅泥物象幽，范汪兼倅李並州。",
            "離亭急管四更后，不見公車心独愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 44
    },
    {
        "title": "海棠溪",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "春教风景駐仙霞，水面魚身總帶花。",
            "人世不思靈卉異，競将紅纈染輕沙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 45
    },
    {
        "title": "採蓮舟",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "风前一葉壓荷蕖，解報新秋又得魚。",
            "兔走烏馳人语靜，滿溪紅袂棹歌初。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 46
    },
    {
        "title": "菱荇沼",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "水荇斜牽綠藻浮，柳絲和葉臥清流。",
            "何时得向溪頭賞，旋摘菱花旋泛舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 47
    },
    {
        "title": "金燈花",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "闌邊不見蘘蘘葉，砌下惟翻豔豔叢。",
            "細視欲将何物比，曉霞初疊赤城宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 48
    },
    {
        "title": "春郊遊眺寄孫处士二首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "低頭久立向薔薇，愛似零陵香惹衣。",
            "何事碧溪孫处士，百勞東去燕西飛。",
            "今朝縱目玩芳菲，夾纈籠裙繡地衣。",
            "滿袖滿頭兼手把，教人识是看花归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 49
    },
    {
        "title": "酬楊供奉法師見招",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "遠水長流潔複清，雪窗高臥与雲平。",
            "不嫌袁室无煙火，惟笑商山有姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 50
    },
    {
        "title": "試新服裁制初成三首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "紫阳宮裏賜紅綃，仙霧朦朧隔海遙。",
            "霜兔毳寒冰繭淨，嫦娥笑指織星橋。",
            "九气分為九色霞，五靈仙馭五雲車。",
            "春风因過東君舍，偷樣人間染百花。",
            "長裾本是上清仪，曾逐群仙把玉芝。",
            "每到宮中歌舞會，折腰齊唱步虛詞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 51
    },
    {
        "title": "寄张元夫",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "前溪独立后溪行，鹭识朱衣自不驚。",
            "借问人間愁寂意，伯牙弦絕已无聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 52
    },
    {
        "title": "酬辛員外折花見遺",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "青鳥東飛正落梅，銜花滿口下瑤台。",
            "一枝為授殷勤意，把向风前旋旋開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 53
    },
    {
        "title": "贈遠二首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "芙蓉新落蜀山秋，錦字開緘到是愁。",
            "閨閣不知戎馬事，月高還上望夫樓。",
            "擾弱新蒲葉又齊，春深花落塞前溪。",
            "知君未轉秦關騎，月照千門掩袖啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 54
    },
    {
        "title": "秋泉",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "冷色初澄一帶煙，幽聲遙瀉十絲弦。",
            "長來枕上牽情思，不使愁人半夜眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 55
    },
    {
        "title": "柳絮",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "二月楊花輕複微，春风搖盪惹人衣。",
            "他家本是无情物，一任南飛又北飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 56
    },
    {
        "title": "续嘉陵驛诗獻武相國",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "蜀門西更上青天，強為公歌蜀國弦。",
            "卓氏長卿稱士女，錦江玉壘獻山川。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 57
    },
    {
        "title": "段相國游武擔寺，病不能從題寄",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "消瘦翻堪見令公，落花无那恨東风。",
            "儂心犹道青春在，羞看飛蓬石鏡中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 58
    },
    {
        "title": "贈段校书",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "公子翩翩说校书，玉弓金勒紫綃裾。",
            "玄成莫便驕名譽，文采风流定不如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 59
    },
    {
        "title": "十離诗：犬離主",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "馴擾朱門四五年，毛香足淨主人怜。",
            "无端咬著親情客，不得紅絲毯上眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 60
    },
    {
        "title": "十離诗：筆離手",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "越管宣毫始稱情，紅箋紙上撒花瓊。",
            "都緣用久鋒頭盡，不得羲之手裏擎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 61
    },
    {
        "title": "十離诗：馬離廄",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "雪耳紅毛淺碧蹄，追风曾到日東西。",
            "為驚玉貌郎君墜，不得華軒更一嘶。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 62
    },
    {
        "title": "十離诗：鸚鵡離籠",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "隴西独自一孤身，飛去飛來上錦茵。",
            "都緣出语无方便，不得籠中再喚人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 63
    },
    {
        "title": "十離诗：燕離巢",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "出入朱門未忍拋，主人常愛语交交。",
            "銜泥穢汙珊瑚枕，不得梁間更壘巢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 64
    },
    {
        "title": "十離诗：珠離掌",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "皎潔圓明內外通，清光似照水晶宮。",
            "只緣一點玷相穢，不得終宵在掌中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 65
    },
    {
        "title": "十離诗：魚離池",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "跳躍深池四五秋，常搖朱尾弄綸鉤。",
            "无端擺斷芙蓉朵，不得清波更一遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 66
    },
    {
        "title": "十離诗：鷹離鞲",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "爪利如鋒眼似鈴，平原捉兔稱高情。",
            "无端竄向青雲外，不得君王臂上擎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 67
    },
    {
        "title": "十離诗：竹離亭",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "蓊鬱新栽四五行，常将勁節負秋霜。",
            "為緣春筍鑽牆破，不得垂阴覆玉堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 68
    },
    {
        "title": "十離诗：鏡離台",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "鑄瀉黃金鏡始開，初生三五月裴回。",
            "為遭无限塵蒙蔽，不得華堂上玉台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 69
    },
    {
        "title": "酬杜舍人",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "雙魚底事到儂家，撲手新诗片片霞。",
            "唱到白蘋洲畔曲，芙蓉空老蜀江花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 70
    },
    {
        "title": "籌邊樓",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "平臨雲鳥八窗秋，壯壓西川四十州。",
            "諸将莫貪羌族馬，最高層处見邊頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 71
    },
    {
        "title": "贈韋校书",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "芸香誤比荊山玉，那似登科甲乙年。",
            "澹地鮮风将綺思，飄花散蕊媚青天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 72
    },
    {
        "title": "江月樓",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "秋风仿佛吳江冷，鸥路參差夕阳影。垂虹納納臥譙門，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 73
    },
    {
        "title": "西岩",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "凭闌卻憶騎鯨客，把酒臨风手自招。",
            "細雨聲中停去馬，夕阳影裏乱鳴蜩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 74
    },
    {
        "title": "罰赴邊上武相公二首",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "螢在荒蕪月在天，螢飛豈到月輪邊。",
            "重光万里應相照，目斷雲霄信不傳。",
            "按轡嶺頭寒複寒，微风細雨徹心肝。",
            "但得放兒归舍去，山水屏风永不看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 75
    },
    {
        "title": "寄舊诗与元微之",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "诗篇調態人皆有，細膩风光我独知。月下詠花怜暗澹，",
            "老大不能收拾得，与君開似教男兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 76
    },
    {
        "title": "句",
        "author": "薛濤",
        "biography": "",
        "paragraphs": [
            "枝迎南北鳥，葉送往來风。（濤八九歲知聲律。一日，",
            "聲云云，父愀然久之。后果入樂籍。別本载田洙遇薛濤，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零三",
        "no#": 77
    }
]