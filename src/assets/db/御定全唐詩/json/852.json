[
    {
        "title": "答宋之问",
        "author": "司馬承禎",
        "biography": "",
        "paragraphs": [
            "时既暮兮節欲春，山林寂兮懷幽人。登奇峰兮望白雲，",
            "不見其人谁与言，归坐彈琴思逾遠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 1
    },
    {
        "title": "醉吟三首",
        "author": "张氳",
        "biography": "",
        "paragraphs": [
            "去歲无田種，今春乏酒材。從他花鳥笑，佯醉臥樓臺。",
            "下調无人睬，高心又被瞋。不知时俗意，教我若為人。",
            "入市非求利，過朝不為名。有时隨俗物，相伴且營營。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 2
    },
    {
        "title": "洗心",
        "author": "司馬退之",
        "biography": "",
        "paragraphs": [
            "不踐名利道，始觉塵土腥。不味稻粱食，始觉精神清。",
            "羅浮奔走外，日月无短明。山瘦松亦勁，鶴老飛更輕。",
            "逍遙此中客，翠發皆長生。草木多古色，雞犬无新聲。",
            "君有出俗志，不貪英雄名。傲然脫冠帶，改换人間情。",
            "去矣丹霄路，向曉雲冥冥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 3
    },
    {
        "title": "夜醉臥街",
        "author": "裴翛然",
        "biography": "",
        "paragraphs": [
            "遮莫冬冬動，須傾滿滿杯。金吾如借问，但道玉山頹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 4
    },
    {
        "title": "謁堯帝廟",
        "author": "軒轅彌明",
        "biography": "",
        "paragraphs": [
            "祖龍開國盡遐荒，廟建唐堯鎮此邦。山卷白雲朝帝座，",
            "瞻仰威靈共回首，紫霞深处鎖軒窗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 5
    },
    {
        "title": "山居",
        "author": "陳寡言",
        "biography": "",
        "paragraphs": [
            "照水冰如鑒，掃雪玉為塵。何須问今古，便是上皇人。",
            "醉臥茅堂不閉關，觉來開眼見青山。",
            "松花落处宿猿在，麋鹿群群林際還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 6
    },
    {
        "title": "臨化示弟子",
        "author": "陳寡言",
        "biography": "",
        "paragraphs": [
            "我本无形暫有形，偶來人世逐營營。",
            "輪回債負今還畢，搔首翛然归上清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 7
    },
    {
        "title": "元白席上作",
        "author": "李升",
        "biography": "",
        "paragraphs": [
            "生在儒家遇太平，懸纓垂帶布衣輕。",
            "谁能世路趨名利，臣事玉皇归上清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 8
    },
    {
        "title": "一字至七字诗：书",
        "author": "範堯佐",
        "biography": "",
        "paragraphs": [
            "书。凭雁，寄魚。出王屋，入匡廬。文生益智，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 9
    },
    {
        "title": "言志獻浙東廉訪辭召",
        "author": "徐靈府",
        "biography": "",
        "paragraphs": [
            "野性歌三樂，皇恩出九重。那煩紫宸命，遠下白雲峰。",
            "多愧书傳鶴，深慚紙画龍。将何佐明主，甘老在岩松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 10
    },
    {
        "title": "自詠二首",
        "author": "徐靈府",
        "biography": "",
        "paragraphs": [
            "寂寂凝神太极初，无心應物等空虛。",
            "性修自性非求得，欲识真人只是渠。",
            "學道全真在此生，何須待死更求生。",
            "今生不了无生理，縱複生知那处生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 11
    },
    {
        "title": "留觀中诗二首",
        "author": "吳子來",
        "biography": "",
        "paragraphs": [
            "終日草堂間，清风常往還。耳无塵事擾，心有玩雲閑。",
            "对酒惟思月，餐松不厭山。时时吟內景，自合駐童顏。",
            "此生此物當生涯，白石青松便是家。",
            "对月臥雲如野鹿，时时買酒醉煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百五十二",
        "no#": 12
    }
]