[
    {
        "title": "书懷",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "長安多路岐，西去欲何依。浮世只如此，舊山長憶归。",
            "自離京國久，應已故人稀。好与孤雲住，孤雲无是非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 1
    },
    {
        "title": "书情",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "負郭有田在，年年長廢耕。欲磨秋鏡淨，恐見白頭生。",
            "未作一旬別，已過千里程。不知书与劍，十载两无成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 2
    },
    {
        "title": "塗中作",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "西南千里程，处处有車聲。若使地无利，始應人不營。",
            "天涯犹馬到，石跡尚塵生。如此未曾息，蜀山終冀平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 3
    },
    {
        "title": "春過函谷關",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "幾度作遊客，客行長苦辛。愁看函谷路，老盡布衣人。",
            "歲遠關犹固，时移草亦春。何當名利息，遣此絕征輪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 4
    },
    {
        "title": "褒中即事",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "风吹残雨歇，雲去有煙霞。南浦足遊女，綠蘋應發花。",
            "遠鐘當半夜，明月入千家。不作故鄉夢，始知京洛賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 5
    },
    {
        "title": "歲暮還家",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "東西流不駐，白日与車輪。残雪半成水，微风應欲春。",
            "幾經他國歲，已減故鄉人。回首長安道，十年空苦辛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 6
    },
    {
        "title": "還家",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "為客憶归舍，归來還寂寥。壯时看欲過，白首固非遙。",
            "独酌幾回醉，此愁終不銷。犹残雞与犬，驅去住山椒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 7
    },
    {
        "title": "題華山麻处士所居",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "貴賤各擾擾，皆逢朝市間。到此馬无跡，始知君独閑。",
            "冰破聽敷水，雪晴看華山。西风寂寥地，唯我坐忘還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 8
    },
    {
        "title": "天南懷故人",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "独行千里塵，軋軋轉征輪。一別已多日，總看成老人。",
            "洞庭雪不下，故國草應春。三月煙波暖，南风生綠蘋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 9
    },
    {
        "title": "路傍草",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "春至始青青，香車碾已平。不知山下处，來向路傍生。",
            "每歲有人在，何时无馬行。應隨塵与土，吹滿洛阳城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 10
    },
    {
        "title": "秋夕闻雁",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "星漢欲沈盡，谁家砧未休。忽闻涼雁至，如報杜陵秋。",
            "千樹又黃葉，幾人新白頭。洞庭今夜客，一半卻登舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 11
    },
    {
        "title": "洛中有懷",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "潺潺伊洛河，寂寞少恩波。鑾駕久不幸，洛阳春草多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 12
    },
    {
        "title": "送魏山韋处士",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "阴阴亭際間，相顧慘離顏。一片雲飛去，嵯峨空魏山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 13
    },
    {
        "title": "白櫻桃",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "王母階前種幾株，水晶簾內看如无。",
            "只應漢武金盤上，瀉得珊珊白露珠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 14
    },
    {
        "title": "白櫻樹",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "記得花開雪滿枝，和蜂和蝶帶花移。",
            "如今花落遊蜂去，空作主人惆悵诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 15
    },
    {
        "title": "下第不勝其忿題路左佛廟",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "雀兒未逐颺风高，下視鷹鸇意气豪。",
            "自謂能生千里足，黃昏依舊委蓬蒿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 16
    },
    {
        "title": "感懷",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "東风吹草色，空使客蹉跎。不設太平險，更應遊子多。",
            "幾傷行处淚，一曲醉中歌。盡向青門外，東隨渭水波。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 17
    },
    {
        "title": "遊中梁山",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "僻地好泉石，何人曾陸沈。不知青嶂外，更有白雲深。",
            "因此見喬木，幾回思舊林。殷勤猿与鳥，唯我独何心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 18
    },
    {
        "title": "尋山",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "到此絕車輪，萋萋草樹春。青山如有利，白石亦成塵。",
            "水闊應无路，松深不見人。如知巢与许，千载跡犹新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 19
    },
    {
        "title": "宿江口",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "南渡人來絕，喧喧雁滿沙。自生江上月，長有客思家。",
            "半夜下霜岸，北风吹荻花。自驚归夢斷，不得到天涯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 20
    },
    {
        "title": "秋夜達蕭關",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "擾擾浮梁路，人忙月自閑。去年為塞客，今夜宿蕭關。",
            "辭國幾經歲，望鄉空見山。不知江葉下，又作布衣還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 21
    },
    {
        "title": "斜谷道",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "乱峰連疊嶂，千里綠峨峨。蜀國路如此，遊人車亦過。",
            "遠煙當驛斂，驟雨逐风多。独憶紫芝叟，臨风歌舊歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 22
    },
    {
        "title": "過百牢關貽舟中者",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "蜀國少平地，方思京洛間。遠為千里客，來度百牢關。",
            "帆影清江水，鈴聲碧草山。不因名与利，爾我各應閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 23
    },
    {
        "title": "客中覽鏡",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "何當開此鏡，即見發如絲。白日急於水，少年能幾时。",
            "每逢芳草处，長返故園迟。所以多為客，蹉跎欲怨谁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 24
    },
    {
        "title": "長安逢隱者",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "征車千里至，碾遍六街塵。向此有營地，忽逢无事人。",
            "昔时顏未改，浮世路多新。且脫衣沽酒，終南山欲春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 25
    },
    {
        "title": "与僧話舊",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "草堂前有山，一見一相寬。处世貴僧靜，青松因歲寒。",
            "他山逢舊侶，盡日話長安。所以閑行跡，千回繞药欄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 26
    },
    {
        "title": "贈王道士",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "日日市朝路，何时无苦辛。不隨丹灶客，終作白頭人。",
            "浮世度千载，桃源方一春。归來華表上，應笑北邙塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 27
    },
    {
        "title": "匣中琴",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "世人无正心，蟲網匣中琴。何以經时廢，非為娛耳音。",
            "独令高韵在，谁感隙塵深。應是南风曲，聲聲不合今。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 28
    },
    {
        "title": "友人亭松",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "俯仰不能去，如逢舊友同。曾因春雪散，見在華山中。",
            "何处有明月，訪君聽遠风。相将归未得，各占石岩東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 29
    },
    {
        "title": "過洛阳城",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "古來利与名，俱在洛阳城。九陌鼓初起，万車輪已行。",
            "周秦时幾變，伊洛水犹清。二月中橋路，鳥啼春草生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 30
    },
    {
        "title": "客中月",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "離家凡幾宵，一望一寥寥。新魄又将滿，故鄉應漸遙。",
            "独臨彭蠡水，遠憶洛阳橋。更有乘舟客，淒然亦駐橈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 31
    },
    {
        "title": "王将军宅夜聽歌",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "朱檻滿明月，美人歌落梅。忽驚塵起处，疑有鳳飛來。",
            "一曲聽初徹，幾年愁暫開。東南正雲雨，不得見阳臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 32
    },
    {
        "title": "長信宮",
        "author": "于鄴",
        "biography": "",
        "paragraphs": [
            "莫问古宮名，古宮空有城。惟應東去水，不改舊时聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 33
    },
    {
        "title": "高樓",
        "author": "於鄴",
        "biography": "",
        "paragraphs": [
            "遠天明月出，照此谁家樓。上有羅衣裳，涼风吹不休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百二十五",
        "no#": 34
    }
]