[
    {
        "title": "短歌行",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "日月何忙忙，出沒住不得。使我勇壯心，少年如頃刻。",
            "人生石火光，通时少於塞。四季倏往來，寒暑變為賊。",
            "偷人面上花，奪人頭上黑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 1
    },
    {
        "title": "飲馬長城窟",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "遊客長城下，飲馬長城窟。馬嘶闻水腥，為浸征人骨。",
            "豈不是流泉，終不成潺湲。洗盡骨上土，不洗骨中冤。",
            "骨若比流水，四海有還魂。空流嗚咽聲，聲中疑是言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 2
    },
    {
        "title": "夜直",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "大內隔重牆，多闻樂未央。燈明宮樹色，茶煮禁泉香。",
            "鳳輦通門靜，雞歌入漏長。宴榮陪禦席，話密近龍章。",
            "吟步彤庭月，眠分玉署涼。欲黏朱紱重，频草白麻忙。",
            "筆力将群吏，人情在致唐。万方瞻仰处，晨夕面吾皇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 3
    },
    {
        "title": "贈行腳僧",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "世界曾行遍，全无行可修。炎涼三衲共，生死一身休。",
            "片斷雲隨體，稀疏雪滿頭。此門无所著，不肯暫淹留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 4
    },
    {
        "title": "秋日思舊山",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "咸言上國繁華，豈謂帝城羈旅。十點五點残螢，",
            "欲去不去迟迟，未展平生所佇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 5
    },
    {
        "title": "寄幹陵楊侍郎",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "冷落官資不畏貧，司曹且共內官分。步量野色成公案，",
            "碑寒樹古神門上，管得无窮空白雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 6
    },
    {
        "title": "登樓憶友",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "物象遠濛濛，周回极望中。帶煙千井樹，和磬一樓风。",
            "月色寒沈地，波聲夜颺空。登臨无限趣，恨不与君同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 7
    },
    {
        "title": "華嚴寺望樊川",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "万木葉初紅，人家樹色中。疏鐘搖雨腳，秋水浸雲容。",
            "雪磧回寒雁，村燈促夜舂。舊山归未得，生计欲何從。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 8
    },
    {
        "title": "与道侶同於水陸寺會宿",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "論道窮心少有朋，此时清話昔年曾。柿凋紅葉鋪寒井，",
            "出門儘是勞生者，只此長閑幾個能。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 9
    },
    {
        "title": "城上吟",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "古塚密於草，新墳侵官道。城外无閑地，城中人又老。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 10
    },
    {
        "title": "襄阳曲",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "為憶南遊人，移家大堤住。千帆万帆來，盡過門前去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 11
    },
    {
        "title": "誡貪",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "多求待心足，未足旋傾覆。明知貪者心，求榮不求辱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 12
    },
    {
        "title": "蟬二首",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "独蟬初唱古槐枝，委曲悲涼斷续迟。",
            "雨后忽闻谁最苦，異鄉孤館憶家时。",
            "衰柳蟬吟旁濁河，正當残日角聲和。",
            "尋常不足少愁思，此際闻时愁更多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 13
    },
    {
        "title": "太平坊尋裴郎中故宅",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "不语淒涼无限情，荒階行盡又重行。",
            "昔年住此何人在，滿地槐花秋草生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 14
    },
    {
        "title": "登樓",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "邊邑鴻聲一例秋，大波平日繞山流。",
            "故人千里同明月，盡夕无言空倚樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 15
    },
    {
        "title": "長安早秋",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "风舞槐花落禦溝，終南山色入城秋。",
            "門門走馬徵兵急，公子笙歌醉玉樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 16
    },
    {
        "title": "对雪",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "密密无聲墜碧空，霏霏有韵舞微风。",
            "幽人吟望搜辭处，飄入窗來落硯中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 17
    },
    {
        "title": "鸚鵡",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "翠毛丹觜乍教时，終日无寥似憶归。",
            "近來偷解人言语，乱向金籠说是非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 18
    },
    {
        "title": "晚景",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "池荷衰颯菊芬芳，策杖吟诗上草堂。",
            "滿目暮雲风卷盡，郡樓寒角数聲長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 19
    },
    {
        "title": "長安傷春",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "霜隕中春花半无，狂遊恣飲盡凶徒。",
            "年年賞玩公卿輩，今委溝塍骨漸枯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 20
    },
    {
        "title": "河梁晚望二首",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "水勢滔滔不可量，漁舟容易泛滄浪。",
            "連山翠靄籠沙漵，白鳥翩翩下夕阳。",
            "雨添一夜秋濤闊，极目茫茫似接天。",
            "不知龍物潛何处，魚躍蛙鳴滿檻前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 21
    },
    {
        "title": "悲長安",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "何事天时禍未回，生靈愁悴苦寒灰。",
            "豈知万頃繁華地，強半今為瓦礫堆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 22
    },
    {
        "title": "千葉石榴花",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "一朵花開千葉紅，開时又不藉春风。",
            "若教移在香閨畔，定与佳人豔態同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 23
    },
    {
        "title": "觀棋",
        "author": "子蘭",
        "biography": "",
        "paragraphs": [
            "拂局盡消时，能因長路迟。點頭初得计，格手待无疑。",
            "寂默親遺景，凝神入過思。共藏多少意，不语两相知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百二十四",
        "no#": 24
    }
]