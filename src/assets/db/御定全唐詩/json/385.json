[
    {
        "title": "送裴相公赴鎮太原",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "盛德雄名遠近知，功高先乞守藩維。銜恩暫遣分龍節，",
            "明年塞北清蕃落，應建生祠請立碑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 1
    },
    {
        "title": "寄元員外",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "外郎直罷无餘事，掃灑书堂試药爐。門巷不教當要鬧，",
            "朝省入频閑日少，可能同作舊遊无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 2
    },
    {
        "title": "贈梅處士",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "早闻聲價滿京城，頭白江湖放曠情。講易自傳新注義，",
            "天子如今議封禪，應将束帛請先生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 3
    },
    {
        "title": "贈王秘书",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "不曾浪出謁公侯，唯向花間水畔遊。每著新衣看药灶，",
            "自領閑司了无事，得來君處喜相留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 4
    },
    {
        "title": "謝裴司空寄馬",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "騄耳新駒駿得名，司空遠自寄书生。乍離華廄移蹄澀，",
            "長思歲旦沙堤上，得從鳴珂傍火城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 5
    },
    {
        "title": "酬秘书王丞見寄",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "相看頭白來城闕，卻憶漳溪舊往還。今體诗中偏出格，",
            "芸閣水曹雖最冷，与君長喜得身閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 6
    },
    {
        "title": "送李餘及第後归蜀",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "十年人詠好诗章，今日成名出舉場。归去唯将新誥牒，",
            "鄉里親情相見日，一时攜酒賀高堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 7
    },
    {
        "title": "早朝寄白舍人、嚴郎中",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "鼓聲初動未闻雞，羸馬街中踏凍泥。燭暗有时沖石柱，",
            "鳳闕星郎離去遠，合門開日入還齊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 8
    },
    {
        "title": "书懷寄元郎中",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "轉覺人間无氣味，常因身外省因緣。經過独愛遊山客，",
            "吟君釣客詞中说，便欲南归榜小船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 9
    },
    {
        "title": "贈道士宜師",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "自到王城得幾年，巴童蜀馬共隨緣。两朝侍從當时貴，",
            "闲房暫喜居相近，還得陪師坐竹邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 10
    },
    {
        "title": "书懷寄王秘书",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "白发如今欲滿頭，從來百事盡應休。只於觸目須防病，",
            "賴君同在京城住，每到花前免独遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 11
    },
    {
        "title": "題韋郎中新亭",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "起得幽亭景複新，碧莎地上更无塵。琴书著盡犹嫌少，",
            "成名同日官連署，此處經過有幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 12
    },
    {
        "title": "送楊州判官",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "應得煙霞出俗心，茅山道士共追尋。閑怜鶴貌偏能画，",
            "征南幕裏多賓客，君独相知最校深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 13
    },
    {
        "title": "喜王起侍郎放牒",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "東风節氣近清明，車馬爭來滿禁城。二十八人初上牒，",
            "共賀春司能鑒识，今年定合有公卿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 14
    },
    {
        "title": "贈王司馬",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "白笏朱衫年少时，久登班列會朝仪。貯財不省關身用，",
            "未曾相识多闻说，遙望長如白玉枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 15
    },
    {
        "title": "书懷",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "自小信成疏懶性，人間事事總无功。別從仙客求方法，",
            "未能即便休官去，慚愧南山采药翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 16
    },
    {
        "title": "贈令狐博士",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "頭白新年六十餘，近闻生计轉空虛。久為博士谁能识，",
            "古來賢哲皆如此，應是才高与眾疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 17
    },
    {
        "title": "送從弟刪東归",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "雲水東南两月程，貪归慶節馬蹄輕。春橋欲醉攀花別，",
            "舊山风月知應好，莫向秋时不到京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 18
    },
    {
        "title": "贈王秘书",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "早在山東聲價遠，曾将顺策佐嫖姚。賦來诗句无閑语，",
            "独從书閣归时晚，春水渠邊看柳條。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 19
    },
    {
        "title": "哭丘長史",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "曾是先皇殿上臣，丹砂久服不成真。常騎馬在嘶空櫪，",
            "最悲昨日同遊處，看卻春风樹樹新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 20
    },
    {
        "title": "送枝江劉明府",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "老著青衫為楚宰，平生志业有谁知。家僮從去愁行遠，",
            "向南漸漸雲山好，一路唯闻唱竹枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 21
    },
    {
        "title": "送從弟徹東归",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "緱山領印知公奏，才稱同时盡不如。奉使賀成登冊禮，",
            "早晚得為朝署拜，閑坊買宅作鄰居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 22
    },
    {
        "title": "哭胡十八遇",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "早得聲名年尚少，尋常志氣出风塵。文場繼续成三代，",
            "送君帳下衣裳白，數尺墳頭柏樹新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 23
    },
    {
        "title": "贈賈島",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "籬落荒涼僮僕饑，樂游原上住多时。蹇驢放飽騎将出，",
            "姓名未上登科記，身屈惟應內史知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 24
    },
    {
        "title": "逢王建有贈",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "年狀皆齊初有髭，鵲山漳水每追隨。使君座下朝聽易，",
            "經今三十餘年事，卻说還同昨日时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 25
    },
    {
        "title": "移居靜安坊，答元八郎中",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "長安寺裏多时住，雖守卑官不苦貧。作活每常嫌費力，",
            "更喜往還相去近，門前減卻送书人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 26
    },
    {
        "title": "送楊少尹赴鳳翔",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "诗名往日動長安，首首人家卷裏看。西學已行秦博士，",
            "今去岐州生计薄，移居偏近隴頭寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 27
    },
    {
        "title": "送韓侍禦归山",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "闻君久臥在雲間，為佐嫖姚未得還。新結茅廬招隱逸，",
            "明日珂聲出城去，家僮不復掃柴關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 28
    },
    {
        "title": "新除水曹郎，答白舍人見賀",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "年過五十到南宮，章句无名荷至公。黃紙開呈相府後，",
            "最幸紫薇郎見愛，独稱官与古人同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 29
    },
    {
        "title": "送楊少尹赴滿城",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "官為本府當身榮，因得還鄉任野情。自廢田園今作主，",
            "公事況閑诗更好，将隨相逐上山行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 30
    },
    {
        "title": "哭元九少府",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "平生志业独相知，早結雲山老去期。初作學官常共宿，",
            "今日春风花滿宅，入門行哭見靈帷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 31
    },
    {
        "title": "送侯判官赴廣州從军",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "年少才高求自展，将身万里赴军門。辟书遠到開呈客，",
            "海花蠻草連冬有，行處无家不滿園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 32
    },
    {
        "title": "答白杭州郡樓登望画圖見寄",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "画得江城登望處，寄來今日到長安。乍驚物色從诗出，",
            "見君向此閑吟意，肯恨當时作外官。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 33
    },
    {
        "title": "贈趙将军",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "當年膽略已縱橫，每見妖星氣不平。身貴早登龍尾道，",
            "會取安西将報國，淩煙閣上大书名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 34
    },
    {
        "title": "送和蕃公主",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "塞上如今无戰塵，漢家公主出和親。邑司犹屬宗卿寺，",
            "氈城南望无回日，空見沙蓬水柳春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 35
    },
    {
        "title": "寒食內宴二首",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "朝光瑞氣滿宮樓，彩纛魚龍四周稠。廊下禦廚分冷食，",
            "共喜拜恩侵夜出，金吾不敢问行由。",
            "城闕沉沉向曉寒，恩當令節賜餘歡，瑞煙深處開三殿，",
            "宮筵戲樂年年別，已得三回對禦看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 36
    },
    {
        "title": "朝日敕賜百官櫻桃",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "仙果人間都未有，今朝忽見下天門。捧盤小吏初宣敕，",
            "每年重此先偏待，愿得千春奉至尊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 37
    },
    {
        "title": "太白老人",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "日觀東峰幽客住，竹巾藤帶亦逢迎。暗修黃籙无人見，",
            "春泉四面繞茅屋，日日唯闻杵臼聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 38
    },
    {
        "title": "和裴司空酬滿城楊少尹",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "聖朝偏重大司空，人詠元和第一功。擁節高臨漢水上，",
            "谁不望归丞相府，江邊楊柳又秋风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 39
    },
    {
        "title": "寄和州劉使君",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "別離已久犹為郡，閑向春风倒酒瓶。送客特過沙口堰，",
            "到此诗情應更遠，醉中高詠有谁聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 40
    },
    {
        "title": "贈商州王使君",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "銜命南來會郡堂，卻思朝裏接班行。才雄犹是山城守，",
            "明朝從此辭君去，独出商關路漸長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 41
    },
    {
        "title": "寄令狐賓客",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "勳名盡得國家傳，退狎琴僧与酒仙。還帶郡符經幾處，",
            "秋日出城伊水好，領谁相逐上閑船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 42
    },
    {
        "title": "寄梅處士",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "擾擾人間是与非，官閑自覺省心机。六行班裏身常下，",
            "君今独得居山樂，應喜多时未辦归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 43
    },
    {
        "title": "送施肩吾東归",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "知君本是煙霞客，被薦因來城闕間。世业偏臨七裏瀨，",
            "惆悵灞亭相送去，雲中琪樹不同攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 44
    },
    {
        "title": "昆侖兒",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "昆侖家住海中州，蠻客将來漢地遊。言语解教秦吉了，",
            "自愛肌膚黑如漆，行时半脫木綿裘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 45
    },
    {
        "title": "贈李杭州",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "仙郎白首未归朝，應為蒼生領六條。惠化州人盡清淨，",
            "終日政聲長独坐，開門長望浙江潮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 46
    },
    {
        "title": "送鄭尚书赴廣州",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "聖朝選将持符節，內使宣时百辟聽。海北蠻夷來舞蹈，",
            "此處莫言多瘴癘，天邊看取老人星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 47
    },
    {
        "title": "賀秘书王丞南郊攝将军",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "正初天子親郊禮，詔攝将军領衛兵。斜帶銀刀入黃道，",
            "共喜与君逢此日，病中无计得隨行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 48
    },
    {
        "title": "送令狐尚书赴東都留守",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "朝廷重寄在關東，共说從前選上公。勳业新城大樑鎮，",
            "每領群臣拜章慶，半開門仗日曈曈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 49
    },
    {
        "title": "拜豐陵",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "歲朝園寢遣公卿，學省班中亦攝行。身逐陵官齊再拜，",
            "卻下龍門看漸遠，金峰高處日微明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 50
    },
    {
        "title": "贈孔尚书",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "能将直道曆榮班，事著元和實錄間。三表自陳辭北闕，",
            "宅近青山高靜處，时归林下暫開關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 51
    },
    {
        "title": "酬杭州白使君，兼寄浙東元大夫",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "相印暫離臨遠鎮，掖垣出守複同时。一行已作三年別，",
            "人間聚散真難料，莫歎平生信所之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 52
    },
    {
        "title": "寄蘇州白二十二使君",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "三朝出入紫微臣，頭白金章未在身。登第早年同座主，",
            "此處吟诗向山寺，知君忘卻曲江春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 53
    },
    {
        "title": "送白賓客分司東都",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "赫赫聲名三十春，高情人独出埃塵。病辭省闥归閑地，",
            "老人也擬休官去，便是君家池上人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 54
    },
    {
        "title": "贈閻少保",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "辭榮戀闕未還鄉，修養年多氣力強。半俸归燒伏火药，",
            "竹樹晴深寒院靜，長懸石磬在虛廊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 55
    },
    {
        "title": "贈別王侍禦赴任陝州司馬",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "京城在處闲人少，唯共君行並馬蹄。更和诗篇名最出，",
            "今日春明門外別，更无因得到街西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 56
    },
    {
        "title": "田司空入朝",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "西來将相位兼雄，不与諸君覲禮同。早變山東知顺命，",
            "閶闔曉開銅漏靜，身當受冊大明宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 57
    },
    {
        "title": "送浙西周判官",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "由來自是煙霞客，早已闻名诗酒間。天闕因将賀表到，",
            "吳越主人偏愛重，多應不肯放君閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 58
    },
    {
        "title": "送吳煉師归王屋",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "玉阳峰下學長生，玉洞仙中已有名。独戴熊須冠暫出，",
            "卻到瑤壇上頭宿，應闻空裏步虛聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 59
    },
    {
        "title": "送邵州林使君",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "詞客南行寵命新，瀟湘郡入曲江津。山幽自足探微處，",
            "知君不作家私计，遷日還同到日貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 60
    },
    {
        "title": "寄王六侍禦",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "漸覺近來筋力少，難堪今日在风塵。谁能借问功名事，",
            "洞庭已置新居處，归去安期与作鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 61
    },
    {
        "title": "送稽亭山寺僧",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "師住稽亭高處寺，斜廊曲閣倚雲開。山門十裏松間入，",
            "舊房到日閑吟後，林下還登说法台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 62
    },
    {
        "title": "送汀州源使君",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "曾成趙北归朝计，因拜王門最好官。為郡暫辭雙鳳闕，",
            "地僻尋常來客少，刺桐花發共谁看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 63
    },
    {
        "title": "寄孫洛阳格",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "久持刑憲聲名遠，好是中朝正直臣。赤縣上來應足事，",
            "遙愛南橋秋日晚，雨邊楊柳映天津。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 64
    },
    {
        "title": "胡山人归王屋，因有贈",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "轉轉无成到白頭，人間舉眼盡堪愁。此生已是蹉跎去，",
            "君归与訪移家處，若個峰頭最較幽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 65
    },
    {
        "title": "寄虔州韓使君",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "南康太守負才豪，五十如今未擁旄。早得一人知姓字，",
            "郡政已成秋思遠，閑吟應不问官曹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 66
    },
    {
        "title": "送從弟蒙赴饒州",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "京城南去鄱阳遠，风月悠悠別思勞。三領郡符新寄重，",
            "到日更行清靜化，春田應不見蓬蒿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 67
    },
    {
        "title": "羅道士",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "城裏无人得實年，衣襟常帶臭黃煙。樓中賒酒唯留药，",
            "尋常行處皆逢見，世上多疑是謫仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 68
    },
    {
        "title": "寄陸渾趙明府",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "与君學省同官處，常日相隨说道情。新作陸渾山縣長，",
            "公事稀疏來客少，无妨著屐独閑行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 69
    },
    {
        "title": "同将作韋二少監贈水部李郎中",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "舊年同是水曹郎，各罷魚符自楚鄉。重著青衫承詔命，",
            "憶得當时亦連步，如今独在讀书堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 70
    },
    {
        "title": "贈王侍禦",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "心同野鶴与塵遠，诗似冰壺見底清。府縣同趨昨日事，",
            "自歎独為折腰吏，可怜驄馬路傍行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 71
    },
    {
        "title": "送金少卿副使归新羅",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "雲島茫茫天畔微，向東万里一帆飛。久為侍子承恩重，",
            "從前此去人无數，光彩如君定是稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 72
    },
    {
        "title": "送李司空赴鎮襄阳",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "中外兼權社稷臣，千官齊出拜行塵。再調公鼎勳庸盛，",
            "襄阳风景由來好，重与江山作主人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 73
    },
    {
        "title": "送李僕射愬赴鎮鳳翔",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "由來勳业屬英雄，兄弟連營列位同。先入賊城擒首惡，",
            "天子新收秦隴地，故教移鎮古扶风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 74
    },
    {
        "title": "寄白二十二舍人",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "早知內詔過先輩，蹭蹬江南百事疏。湓浦城中為上佐，",
            "三省比來名望重，肯容君去樂樵漁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 75
    },
    {
        "title": "送友人盧處士游吳越",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "羨君東去見残梅，惟有王孫独未回。吳苑夕阳明古堞，",
            "試问漁舟看雪浪，幾多江燕荇花開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 76
    },
    {
        "title": "蘇州江岸留別樂天",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "銀泥裙映錦障泥，画舸停橈馬簇蹄。清管曲終鸚鵡语，",
            "莫忘使君吟詠處，女墳湖北武丘西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 77
    },
    {
        "title": "寒食看花",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "早入公門到夜归，不因寒食少闲时。顛狂繞樹猿離鎖，",
            "老來自喜常无事，仰面西園得詠诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 78
    },
    {
        "title": "酬浙東元尚书見寄綾素",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "越地繒紗紋樣新，遠封來寄學曹人。便令裁制為时服，",
            "三千裏外无由見，海上東风又一春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 79
    },
    {
        "title": "贈項斯",
        "author": "张籍",
        "biography": "",
        "paragraphs": [
            "端坐吟诗忘忍饑，万人中覓似君稀。門連野水风長到，",
            "曲江亭上频频見，為愛鸕鷀雨裏飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十五",
        "no#": 80
    }
]