[
    {
        "title": "猛虎行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "磨爾牙，錯爾爪。狐莫威，兔莫狡，饑來吞噬取腸飽。",
            "橫行不怕日月明，皇天產爾為生獰。前村半夜闻吼聲，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 1
    },
    {
        "title": "西山叟",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "西山中，多狼虎，去歲傷兒複傷婦。官家不问孤老身，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 2
    },
    {
        "title": "君子行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "圣人不生，麟龍何瑞。梧桐不高，鳳凰何止。",
            "吾闻古之有君子，行藏以时，進退求己。榮必為天下榮，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 3
    },
    {
        "title": "善哉行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "大鵬刷翮謝溟渤，青雲万層高突出。下視秋濤空渺彌，",
            "愿除嗜欲待身輕，攜手同尋列仙事。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 4
    },
    {
        "title": "日日曲",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "日日日東上，日日日西沒。任是神仙容，也須成朽骨。",
            "浮雲滅複生，芳草死還出。不知千古万古人，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 5
    },
    {
        "title": "耕叟",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "春风吹蓑衣，暮雨滴箬笠。夫婦耕共勞，兒孫饑对泣。",
            "田園高且瘦，賦稅重複急。官倉鼠雀群，共待新租入。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 6
    },
    {
        "title": "苦熱行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "離宮劃開赤帝怒，喝出六龍奔日馭。下土熬熬若煎煮，",
            "何當一雨蘇我苗，為君擊壤歌帝堯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 7
    },
    {
        "title": "苦寒行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "冰峰撐空寒矗矗，雲凝水凍埋海陸。殺物之性，傷人之欲。",
            "既不能斷絕蒺藜荊棘之根株，又不能展鳳凰麒麟之拳局。",
            "如此，則何如為和煦，為膏雨，自然天下之榮枯，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 8
    },
    {
        "title": "春风曲",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "春风有何情，旦暮來林園。不问桃李主，吹落紅无言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 9
    },
    {
        "title": "城中懷山友",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "春城來往桃李碧，暖豔紅香斷消息。",
            "吾徒自有山中鄰，白晝冥心坐嵐壁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 10
    },
    {
        "title": "讀李賀歌集",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "赤水无精華，荊山亦枯槁。玄珠与虹玉，璨璨李賀抱。",
            "清晨醉起臨春台，吳綾蜀錦胸襟開。狂多两手掀蓬萊，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 11
    },
    {
        "title": "风琴引",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "挪吳絲，雕楚竹，高托天风拂為曲。一一宮商在素空，",
            "愁魂傍枕不肯去，翻疑住处鄰湘娥。金风聲盡熏风發，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 12
    },
    {
        "title": "夏雲曲",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "紅嵯峨，爍晚波，乖龍慵臥旱鬼多。爞爞万里壓天塹，",
            "男巫女覡更走魂，焚香祝天天不闻。天若闻，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 13
    },
    {
        "title": "讀李白集",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "竭雲濤，刳巨鼇，搜括造化空牢牢。冥心入海海神怖，",
            "鏘金鏗玉千餘篇，膾吞炙嚼人口傳。須知一一丈夫气，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 14
    },
    {
        "title": "祈真壇",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "玉甕瑤壇二三級，學仙弟子參差入。霓旌隊仗下不下，",
            "茫茫俗骨醉更昏，樓臺十二遙昆侖。昆侖縱廣一万二千里，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 15
    },
    {
        "title": "黃雀行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "雙雙野田雀，上下同飲啄。暖去棲蓬蒿，寒归傍籬落。",
            "殷勤避羅網，乍可遇雕鶚。雕鶚雖不仁，分明在寥廓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 16
    },
    {
        "title": "石竹花",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "石竹花開照庭石，紅蘚自稟離宮色。一枝两枝初笑风，",
            "谁為根尋造化功，為君吐出淳元膽。白日當午方盛開，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 17
    },
    {
        "title": "寄南嶽白蓮道士能于長嘯",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "猿猱休啼月皎皎，蟋蟀不吟山悄悄。",
            "大耳仙人滿頷須，醉倚長松一聲嘯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 18
    },
    {
        "title": "古劍歌",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "古人手中鑄神物，百煉百淬始提出。今人不要強硎磨，",
            "何时得遇英雄主，用爾平治天下去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 19
    },
    {
        "title": "湘妃廟",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "湘煙濛濛湘水急，汀露凝紅裛蓮濕。蒼梧雲疊九嶷深，",
            "廟荒松朽啼飛猩，筍鞭迸出階基傾。黃昏一岸阴风起，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 20
    },
    {
        "title": "巫山高",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "巫山高，巫女妖，雨為暮兮雲為朝，楚王憔悴魂欲銷。",
            "秋猿嗥嗥日将夕，紅霞紫煙凝老壁。千岩万壑花皆坼，",
            "雲深廟遠不可覓，十二峰頭插天碧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 21
    },
    {
        "title": "《贈持法華經》僧",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "眾人有口，不说是，即说非。吾師有口何所為，",
            "我闻念經功德緣，舌根可算金剛堅。他时劫火洞燃后，",
            "魔王輪幢自摧折，何況更如理行如理说。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 22
    },
    {
        "title": "刳腸龜",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "爾既能于靈，應久存其生。爾既能于瑞，胡得迷其死。",
            "刳腸徒自屠，曳尾複何累。可怜濮水流，一葉泛莊子。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 23
    },
    {
        "title": "贈岩居僧",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "石如騏驎岩作室，秋苔漫壇淨於漆。",
            "袈裟蓋頭心在无，黃猿白猿啼日日。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 24
    },
    {
        "title": "觀李瓊处士画海濤",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "巨鼇轉側長鰍翻，狂濤顛浪高漫漫。李瓊奪得造化本，",
            "葉撲仙槎擺欲沉，下頭應是驪龍窟。昔年曾要涉蓬瀛，",
            "千尋万派功難測，海門山小濤頭白。令人錯認錢塘城，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 25
    },
    {
        "title": "升天行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "身不沉，骨不重。驅青鸞，駕白鳳。幢蓋飄搖入冷空，",
            "三五仙子乘龍車，堂前碾爛蟠桃花。回頭卻顧蓬萊頂，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 26
    },
    {
        "title": "還人卷",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "李白李賀遺机杼，散在人間不知处。闻君收在芙蓉江，",
            "鴛鴦浴煙鸞鳳飛，澄江曉映餘霞輝。仙人手持玉刀尺，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 27
    },
    {
        "title": "輕薄行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "玉鞭金鐙驊騮蹄，橫眉吐气如虹霓。五陵春暖芳草齊，",
            "伯阳道德何唾咦，仲尼禮樂徒卑棲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 28
    },
    {
        "title": "浮雲行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "大野有賢人，大朝有圣君。如何彼浮雲，掩蔽白日輪。",
            "安得東南风，吹散八表外。使之天下人，共見堯眉彩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 29
    },
    {
        "title": "煌煌京洛行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "圣君垂衣裳，蕩蕩若朝旭。大觀无遺物，四夷來率服。",
            "清晨回北极，紫气蓋黃屋。雙闕聳雙鼇，九門如川瀆。",
            "梯山航海至，晝夜車相续。我恐紅塵深，變為黃河曲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 30
    },
    {
        "title": "吊汨羅",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "落日倚闌幹，徘徊汨羅曲。冤魂如可吊，煙浪聲似哭。",
            "我欲考黿鼉之心，烹魚龍之腹。爾既啖大夫之血，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 31
    },
    {
        "title": "《贈念法華經》僧",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "念念念兮入惡易，念念念兮入善難。念經念佛能一般，",
            "心心緣經口緣字，一室寥寥燈照地。沈檀卷軸寶函盛，",
            "牙根舌根水滴寒，珊瑚捶打紅琅玕。但恐蓮花七朵一时折，",
            "況闻此經甚微妙，百千諸佛真秘要。靈山说后始傳來，",
            "舜弦和雅熏风吹，文王武王弦更悲。",
            "如此爭不遣碧空中有龍來聽，有鬼來聽。亦使人間闻者敬，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 32
    },
    {
        "title": "短歌寄鼓山長老",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "雪峰雪峰高且雄，峨峨堆積青冥中。六月赤日燒不熔，",
            "行圍坐繞同一色，森森影動旃檀香。於中一子最雄猛，",
            "我闻岷國民归依，前王后王皆師資。甯同梁武遇達磨，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 33
    },
    {
        "title": "漁父",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "夜釣洞庭月，朝醉巴陵市。卻归君山下，魚龍窟邊睡。",
            "生涯在何处，白浪千万里。曾笑楚臣迷，蒼黃汨羅水。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 34
    },
    {
        "title": "採蓮曲",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "越溪女，越江蓮。齊菡萏，雙嬋娟。嬉游向何处，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 35
    },
    {
        "title": "啄木",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "啄木啄啄，鳴林響壑。貪心既緣，利嘴斯鑿。",
            "有朽百尺，微蟲斯宅。以啄去害，啄更彌劇。",
            "層崖豫章，聳幹蒼蒼。无縱爾啄，摧我棟樑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 36
    },
    {
        "title": "靈松歌",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "靈松靈松，是何根株。盤擗枝幹，与群木殊。",
            "世眼爭知蒼翠容，薜蘿遮體深朦朧。先秋瑟瑟生谷风，",
            "唯有此松高下枝，一枝枝在无摧折。癡凍頑冰如鐵堅，",
            "有时深洞興雷雹，飛電繞身光閃爍。乍似蒼龍驚起时，",
            "千年朽枿魍魎出，一株寒韵鏘琉璃。安得良工妙图雘，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 37
    },
    {
        "title": "蠹",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "蠹不自蠹，而蠹於木。蠹极木心，以豐爾腹。",
            "偶或成之，胡為勖人。人而不真，繇爾乱神。",
            "蠹兮蠹兮，何全其生。无托爾形，霜松雪檉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 38
    },
    {
        "title": "行路難",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "行路難，君好看，驚波不在黤黮間，小人心裏藏崩湍。",
            "七盤九折寒崷崒，翻車倒蓋犹堪出。未似是非唇舌危，",
            "又不見李太白，一朝卻作江南客。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 39
    },
    {
        "title": "謝徽上人見惠二龍障子，以短歌酬之",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "我見蘇州昆山金城中，金城柱上有二龍。",
            "老僧相傳道是僧繇手，尋常入海共龍鬥。",
            "又闻蜀國玉局觀有孫遇跡，盤屈身長八十尺。",
            "遊人爭看不敢近，頭覷寒泉万丈碧。近有五羊徽上人，",
            "徽上人，真藝者。惠我雙龍不言價，等闲不敢将懸掛。",
            "恐是葉公好假龍，及見真龍卻驚怕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 40
    },
    {
        "title": "送人往長沙",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "荊門归路指湖南，千里风帆興可諳。",
            "好聽鷓鴣啼雨处，木蘭舟晚泊春潭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 41
    },
    {
        "title": "偶題",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "时事懶言多忌諱，野吟无主若縱橫。",
            "君看三百篇章首，何处分明著姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 42
    },
    {
        "title": "寄山中叟",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "青泉碧樹夏风涼，紫蕨紅粳午爨香。",
            "應笑晨持一盂苦，腥膻市里叫家常。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 43
    },
    {
        "title": "贈琴客",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "曾攜五老峰前過，幾向雙松石上彈。",
            "此境此身谁更愛，掀天羯鼓滿長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 44
    },
    {
        "title": "勉吟僧",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "千途万轍乱真源，白晝勞形夜斷魂。",
            "忍著袈裟把名紙，學他低折五侯門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 45
    },
    {
        "title": "送人归華下",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "蓮花峰翠濕凝秋，舊业園林在下頭。",
            "好束诗书且归去，而今不愛事风流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 46
    },
    {
        "title": "夏日城中作二首",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "三面僧鄰一面牆，更无风路可吹涼。",
            "他年舍此归何处，青壁紅霞裹石房。",
            "竹低莎淺雨濛濛，水檻幽窗暑月中。",
            "有境牽懷人不會，東林門外翠橫空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 47
    },
    {
        "title": "默坐",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "燈引飛蛾拂焰迷，露淋棲鶴壓枝低。",
            "冥心坐滿蒲團穩，夢到天臺過剡溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 48
    },
    {
        "title": "水邊行",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "身著袈裟手杖藤，水邊行止不妨僧。",
            "禽棲日落犹孤立，隔浪秋山千万層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 49
    },
    {
        "title": "寄鄭谷郎中",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "人間近遇风騷匠，鳥外曾逢心印師。",
            "除此二門无別妙，水邊松下独尋思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 50
    },
    {
        "title": "翡翠",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "水邊飛去青難辨，竹裏归來色一般。",
            "磨吻鷹鸇莫相害，白鸥鴻鶴滿沙灘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 51
    },
    {
        "title": "与節供奉大德遊京口寺留題",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "柳岸晴緣十裏來，水邊精舍絕塵埃。",
            "煮茶嘗摘興何极，直至残阳未欲回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 52
    },
    {
        "title": "《謝荊幕孫郎中見示樂府歌集》二十八字",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "長吉才狂太白顛，二公文陣勢橫前。",
            "谁言后代无高手，奪得秦皇鞭鬼鞭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 53
    },
    {
        "title": "《謝阴符經》勉送藏休上人二首",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "事遂鼎湖遺劍履，时來渭水擲魚竿。",
            "欲知賢圣存亡道，自向心机反復看。",
            "一林霜雪未沾頭，爭遣藏休肯便休。",
            "學盡世間難學事，始堪隨处任虛舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 54
    },
    {
        "title": "幽齋偶作",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "幽院才容個小庭，疏篁低短不堪情。",
            "春來犹賴鄰僧樹，时引流鶯送好聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 55
    },
    {
        "title": "《贈念法華經》僧",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "万境心隨一念平，紅芙蓉折愛河清。",
            "持經功力能如是，任駕白牛安穩行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 56
    },
    {
        "title": "对菊",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "无豔无妖別有香，栽多不為待重阳。",
            "莫嫌醒眼相看過，卻是真心愛澹黃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 57
    },
    {
        "title": "閉門",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "正是閉門爭合閉，大家開处不須開。",
            "還防朗月清风夜，有個诗人相訪來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 58
    },
    {
        "title": "勉送吳國三五新戒归",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "法王遺制付仁王，難得難持劫数長。",
            "努力只須堅守護，三千八万是垣牆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 59
    },
    {
        "title": "夏日寄清溪道者",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "老病不能求药餌，朝昏只是但焚燒。",
            "不知谁為收灰骨，壘石栽松傍寺橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 60
    },
    {
        "title": "送惠空北游",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "君向峴山遊圣境，我将何以記多才。",
            "叮嚀墮淚碑前過，写取斯文寄我來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 61
    },
    {
        "title": "寄懷归州馬判官",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "三年為倅興何長，归计應多事少忙。",
            "又見秋风霜裛樹，滿山椒熟水雲香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 62
    },
    {
        "title": "觀荷葉露珠",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "霏微曉露成珠顆，宛轉田田未有风。",
            "任器方圓性終在，不妨翻覆落池中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 63
    },
    {
        "title": "苦熱懷玉泉寺寄仁上人",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "火雲如燒接蒼梧，原野煙連大澤枯。",
            "謾費葛衫葵扇力，爭禁泉石潤肌膚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 64
    },
    {
        "title": "觀盆池白蓮",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "素萼金英噴露開，倚风凝立独徘徊。",
            "應思瀲灩秋池底，更有归天伴侶來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 65
    },
    {
        "title": "折楊柳詞四首",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "鳳樓高映綠阴阴，凝重多含雨露深。",
            "莫謂一枝柔軟力，幾曾牽破別離心。",
            "館娃宮畔響廊前，依託吳王養翠煙。",
            "劍去國亡台殿毀，卻隨紅樹噪秋蟬。",
            "穠低似中陶潛酒，軟极如傷宋玉风。",
            "多謝将军繞營種，翠中閑卓戰旗紅。",
            "高僧愛惜遮江寺，遊子傷残露野橋。",
            "爭似著行垂上苑，碧桃紅杏对搖搖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 66
    },
    {
        "title": "答長沙丁秀才书",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "月月便車奔帝闕，年年貢士過荊台。",
            "如何三度槐花落，未見故人攜卷來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 67
    },
    {
        "title": "戒小師",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "不肯吟诗不聽經，禪宗異嶽懶遊行。",
            "他年白首當人问，将底言談对后生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 68
    },
    {
        "title": "題舊拄杖",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "親采匡廬瀑布西，層崖懸壁更安梯。",
            "攜行三十年吟伴，未有诗人□□□。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 69
    },
    {
        "title": "酬歐阳秀才卷",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "三十篇多十九章，□聲风力撼疏篁。",
            "不堪更有精搜处，谁見蕭蕭雨夜堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 70
    },
    {
        "title": "闻雁",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "瀟湘浦暖全迷鶴，邏逤川寒只有雕。",
            "谁向孤舟憶兄弟，坐看連雁度橫橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 71
    },
    {
        "title": "送高麗二僧南游",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "日邊鄉井別年深，中國靈蹤欲遍尋。",
            "何处碧山逢長老，分明認取祖師心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 72
    },
    {
        "title": "謝猿皮",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "貴向獵師家買得，攜來乞与坐禪床。",
            "不知摘月秋潭畔，曾对何人啼斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 73
    },
    {
        "title": "酬光上人",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "禪言難后到诗言，坐石心同立月魂。",
            "應記前秋會吟处，五更犹在老松根。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 74
    },
    {
        "title": "送僧归日本",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "日東來向日西遊，一缽閑尋遍九州。",
            "卻憶雞林本師寺，欲归還待海风秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 75
    },
    {
        "title": "庚午歲十五夜对月",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "海澄空碧正團圓，吟想玄宗此夜寒。",
            "玉兔有情應記得，西邊不見舊長安。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 76
    },
    {
        "title": "紅薔薇花",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "晴日當樓曉香歇，錦帶盤空欲成結。",
            "鶯聲漸老柳飛时，狂风吹落猩猩血。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 77
    },
    {
        "title": "貽九華上人",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "一法傳闻繼老能，九華閑臥最高層。",
            "秋鐘盡后残阳暝，門掩松邊雨夜燈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 78
    },
    {
        "title": "寄賡匡图兄弟",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "僧外閑吟樂最清，年登八十喪南荊。",
            "风騷作者為商確，道去碧雲爭幾程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 79
    },
    {
        "title": "句",
        "author": "齊己",
        "biography": "",
        "paragraphs": [
            "春晴遊寺客，花落閉門僧。",
            "香傳天下口，□貴火前名。角開香滿室，爐動綠凝鐺。",
            "園林将向夕，风雨更吹花。",
            "相思坐溪石，□□□山风。",
            "夕照背高臺，残鐘残角催。",
            "五老峰前相見时，两无言语各揚眉。",
            "高人愛惜藏岩裏，白bv封題寄火前。（《詠茶》，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百四十七",
        "no#": 80
    }
]