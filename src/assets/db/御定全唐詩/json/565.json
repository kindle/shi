[
    {
        "title": "春愁",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "金烏長飛玉兔走，青鬢長青古无有。秦娥十六语如弦，",
            "勸君年少莫遊春，暖风迟日濃於酒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 1
    },
    {
        "title": "牡丹",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "残花何处藏，盡在牡丹房。嫩蕊包金粉，重葩結繡囊。",
            "雲凝巫峽夢，簾閉景阳妝。應恨年華促，迟迟待日長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 2
    },
    {
        "title": "興平縣野中得落星石移置縣齋",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "的的墮芊蒼，茫茫不記年。幾逢疑虎将，應逐犯牛仙。",
            "擇地依蘭畹，題诗間錦錢。何时成五色，卻上女媧天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 3
    },
    {
        "title": "題商山店",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "商山驛路幾經過，未到仙娥見謝娥。紅錦机頭拋皓腕，",
            "碧澗門前一條水，豈知平地有天河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 4
    },
    {
        "title": "风",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "競持飄忽意何窮，為盛為衰半不同。偃草喜逢新雨后，",
            "莫見東风便无定，滿帆還有濟川功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 5
    },
    {
        "title": "雲",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "深惹離情靄落暉，如車如蓋早依依。山頭觸石應常在，",
            "春风淡蕩无心后，見说襄王夢亦稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 6
    },
    {
        "title": "露",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "長隨圣澤墮堯天，濯遍幽蘭葉葉鮮。才喜輕塵銷陌上，",
            "幾处花枝抱離恨，曉风残月正潸然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 7
    },
    {
        "title": "霞",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "應是行雲未擬归，變成春態媚晴暉。深如綺色斜分閣，",
            "曉來何处低臨水，无限鴛鴦妒不飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 8
    },
    {
        "title": "潁亭",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "潁上新亭瞰一川，幾重舊址敞幽關。寒聲北下當軒水，",
            "知君久負巢由志，早晚相忘寂寞間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 9
    },
    {
        "title": "詠馬",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "曾經伯樂识長鳴，不似龍行不敢行。金埒未登嘶若是，",
            "早晚飛黃引同皂，碧雲天上作鸞鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 10
    },
    {
        "title": "題圭峰下長孫家林亭",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "趙國林亭二百年，綠苔如毯葛如煙。閑期竹色搖霜看，",
            "明知富貴非身物，莫為金章墮地仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 11
    },
    {
        "title": "牡丹",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "桃时杏日不爭濃，葉帳阴成始放紅。曉豔遠分金掌露，",
            "如夢如仙忽零落，暮霞何处綠屏空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 12
    },
    {
        "title": "雨",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "阴雲拂地散絲輕，長得為霖濟物名。夜浦漲归天塹闊，",
            "不及流他荷葉上，似珠无数轉分明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 13
    },
    {
        "title": "京西即事",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "秋草河蘭起陣雲，涼州唯向管弦闻。豺狼毳幕三千帳，",
            "昭阳亦待平安火，谁握旌旗不見勳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 14
    },
    {
        "title": "公子行",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "紫袖長衫色，銀蟬半臂花。帶裝盤水玉，鞍繡坐雲霞。",
            "別殿承恩澤，飛龍賜渥窪。控羅青褭轡，鏤象碧熏葩。",
            "意气傾歌舞，闌珊走鈿車。袖障雲縹緲，釵轉鳳欹斜。",
            "珠卷迎归箔，雕籠晃醉紗。唯无難夜日，不得似仙家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 15
    },
    {
        "title": "秋晚信州推院親友或責无书，即事寄答",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "官信安仁拙，书非叔夜慵。謬馳驄馬傳，難附鯉魚封。",
            "万里勞何補，千年运忝逢。不量橫草力，虛慕入雲蹤。",
            "潔水空澄鑒，持鉛亦礪鋒。月寒深夜桂，霜凜近秋松。",
            "憲摘无逃魏，冤申得夢馮。问狸将挾虎，殲蠆敢虞蜂。",
            "商吹移砧調，春華改鏡容。归期方畹積，愁思暮山重。",
            "仙鼠犹驚燕，莎雞欲變蛩。唯應碧湘浦，雲落及芙蓉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 16
    },
    {
        "title": "晚春江晴寄友人",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "晚日低霞綺，晴山遠画眉。春青河畔草，不是望鄉时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 17
    },
    {
        "title": "涼州詞",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "樹發花如錦，鶯啼柳若絲。更遊歡宴地，悲見別離时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 18
    },
    {
        "title": "暮春滻水送別",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "綠暗紅稀出鳳城，暮雲樓閣古今情。",
            "行人莫聽宮前水，流盡年光是此聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 19
    },
    {
        "title": "駱谷晚望",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "秦川如画渭如絲，去國還家一望时。",
            "公子王孫莫來好，嶺花多是斷腸枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 20
    },
    {
        "title": "二月二日遊洛源",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "舊苑新晴草似苔，人還香在踏青回。",
            "今朝此地成惆悵，已后逢春更莫來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 21
    },
    {
        "title": "柳",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "折柳歌中得翠條，遠移金殿種青霄。",
            "上阳宮女含聲送，不忿先归舞細腰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 22
    },
    {
        "title": "楊柳枝",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "梁苑隋堤事已空，万條犹舞舊春风。",
            "那堪更想千年后，谁見楊花入漢宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 23
    },
    {
        "title": "楊柳枝詞",
        "author": "韓琮",
        "biography": "",
        "paragraphs": [
            "枝鬥纖腰葉鬥眉，春來无处不如絲。",
            "霸陵原上多離別，少有長條拂地垂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百六十五",
        "no#": 24
    }
]