[
    {
        "title": "長洲懷古",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "野燒原空盡荻灰，吳王此地有樓臺。千年事往人何在，",
            "停車日晚薦蘋藻，风靜寒塘花正開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 1
    },
    {
        "title": "經煬帝行宮",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "此地曾經翠輦過，浮雲流水竟如何。香銷南國美人盡，",
            "行人遙起廣陵思，古渡月明闻棹歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 2
    },
    {
        "title": "春日游嘉陵江",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "独泛扁舟映綠楊，嘉陵江水色蒼蒼。行看芳草故鄉遠，",
            "今來谁识東归意，把酒閑吟思洛阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 3
    },
    {
        "title": "秋日山齋书懷",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "啟戶清风枕簟幽，蟲絲吹落掛簾鉤。蟬吟高樹雨初霽，",
            "空将方寸荷知己，身寄煙蘿恩未酬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 4
    },
    {
        "title": "晚秋洛阳客舍",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "清洛平分两岸沙，沙邊水色近人家。隋朝古陌銅駝柳，",
            "未成归计關河阻，空望白雲鄉路賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 5
    },
    {
        "title": "深愁喜友人至",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "不避驅羸道路長，青山同喜惜年光。燈前話舊階草夜，",
            "此身未遂归休计，一半生涯寄岳阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 6
    },
    {
        "title": "秋日望西阳",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "古木蒼苔墜幾層，行人一望旅情增。太行山下黃河水，",
            "野花似泣紅妝淚，寒露滿枝枝不勝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 7
    },
    {
        "title": "鄴都懷古",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "昔时霸业何蕭索，古木唯多鳥雀聲。芳草自生宮殿處，",
            "一望青山便惆悵，西陵无主月空明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 8
    },
    {
        "title": "題龍門僧房",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "靜室遙臨伊水東，寂寥谁与此身同。禹門山色度寒磬，",
            "偶将心地问高士，坐指浮生一夢中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 9
    },
    {
        "title": "秋夕山齋即事",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "衡門无事閉蒼苔，籬下蕭疏野菊開。半夜秋风江色動，",
            "独坐高窗此时節，一彈瑤瑟自成哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 10
    },
    {
        "title": "江行书事",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "遠渚蒹葭覆綠苔，姑蘇南望思裴徊。空江独樹楚山背，",
            "寒潮欲上泛萍藻，寄薦三閭情自哀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 11
    },
    {
        "title": "過鑄鼎原",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "黃帝修真万國朝，鼎成龍駕上丹霄。天风乍起鶴聲遠，",
            "唯留古跡寒原在，碧水蒼蒼空寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 12
    },
    {
        "title": "秋日寓懷",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "海上生涯一釣舟，偶因名利事淹留。旅塗谁見客青眼，",
            "如何未盡此行役，西入潼關雲木秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 13
    },
    {
        "title": "江城晚望",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "一望江城思有餘，遙分野徑入樵漁。青山經雨菊花盡，",
            "秋期又涉潼關路，不得年年向此居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 14
    },
    {
        "title": "宿蒼溪館",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "孤館門開對碧岑，竹窗燈下聽猿吟。巴山夜雨別離夢，",
            "空思知己隔雲嶺，鄉路独归春草深。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 15
    },
    {
        "title": "題王母廟",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "寂寥珠翠想遺聲，門掩煙微水殿清。拂曙紫霞生古壁，",
            "武帝无名在仙籍，玉壇星月夜空明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 16
    },
    {
        "title": "留別複本修古二上人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "二遠相知是昔年，此身長寄禮香煙。綠蕪风晚水邊寺，",
            "西峰話別又須去，終日關山在馬前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 17
    },
    {
        "title": "邊思",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "漢将邊方背轆轤，受降城北是單于。黃河晚凍雪风急，",
            "蛾眉一沒空留怨，青塚月明啼夜烏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 18
    },
    {
        "title": "登龍門敬善寺閣",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "独步危梯入杳冥，天风瀟灑拂簷楹。禹門煙樹正春色，",
            "瑣窗朱檻同仙界，半夜緱山有鶴聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 19
    },
    {
        "title": "題王校书山齋",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "猿鳥无聲晝掩扉，寒原隔水到人稀。雲晴古木月初上，",
            "棲迟慣得滄浪思，雲閣還應夢釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 20
    },
    {
        "title": "浙江晚渡懷古",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "蟬噪秋风滿古堤，荻花寒渡思萋萋。潮聲归海鳥初下，",
            "此來一見垂綸者，卻憶舊居明月溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 21
    },
    {
        "title": "及第後宴曲江",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "及第新春選勝遊，杏園初宴曲江頭。紫毫粉壁題仙籍，",
            "归时不省花間醉，綺陌香車似水流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 22
    },
    {
        "title": "秋日山寺懷友人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "蕭寺樓臺對夕阴，淡煙疏磬散空林。风生寒渚白蘋動，",
            "相思不見又經歲，坐向松窗彈玉琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 23
    },
    {
        "title": "八月十五日夜玩月",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "中秋朗月靜天河，烏鵲南飛客恨多。寒色滿窗明枕簟，",
            "此夜空亭闻木落，蒹葭霜磧雁初過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 24
    },
    {
        "title": "晚春宿僧院",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "蕭寺春风正落花，淹留數宿惠休家。碧空雲盡磬聲遠，",
            "微微一點寒燈在，鄉夢不成闻曙鴉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 25
    },
    {
        "title": "懷汶阳兄弟",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "回看雲嶺思茫茫，幾處關河隔汶阳。书信經年鄉國遠，",
            "終日路岐归未得，秋來空羨雁成行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 26
    },
    {
        "title": "題天宮寺閣",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "丹闕侵霄壯複危，排空霞影動簷扉。城連伊水禹門近，",
            "此來閑望更何有，无限清风生客衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 27
    },
    {
        "title": "游上方石窟寺",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "苔徑縈回景漸分，翛然空界靜埃氛。一聲疏磬過寒水，",
            "幾來吟嘯立朱檻，风起天香處處闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 28
    },
    {
        "title": "懷江南友人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "久絕音书隔塞塵，路岐谁与子相親。愁中独坐秦城夜，",
            "空勞两地望明月，多感斷蓬千里身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 29
    },
    {
        "title": "題敬亭山廟",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "森森古木列岩隈，迥壓寒原霽色開。雲雨只從山上起，",
            "花落空庭春晝晚，石床松殿滿青苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 30
    },
    {
        "title": "經麻姑山",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "麻姑此地煉神丹，寂寞煙霞古灶残。一自仙娥归碧落，",
            "山頂白雲千万片，时闻鸞鶴下仙壇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 31
    },
    {
        "title": "對残春",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "楊花漠漠暗長堤，春盡人愁鳥又啼。鬢发近來生處白，",
            "唯有年光堪自惜，不勝煙草日萋萋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 32
    },
    {
        "title": "過滄浪峽",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "山疊雲重一徑幽，蒼苔古石瀨清流。出岩樹色見來靜，",
            "如何地近東西路，馬足車輪不暫留。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 33
    },
    {
        "title": "經過建业",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "六代興衰曾此地，西风露泣白蘋花。煙波浩渺空亡國，",
            "淒涼處處漁樵路，鳥去人归山影斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 34
    },
    {
        "title": "贈道者",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "真趣淡然居物外，忘机多是隱天臺。停燈深夜看仙籙，",
            "无因朝市知名姓，地僻衡門對嶽開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 35
    },
    {
        "title": "題馬太尉華山莊",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "別開池館背山阴，近得幽奇物外心。竹色拂雲連嶽寺，",
            "自是功成閑劍履，西齋長臥對瑤琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 36
    },
    {
        "title": "秋日夜懷",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "砧杵寥寥秋色長，繞枝寒鵲客情傷。關山雲盡九秋月，",
            "如何節候變容發，明鏡一看愁異常。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 37
    },
    {
        "title": "題巫山廟",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "十二嵐峰掛夕暉，廟門深閉霧煙微。天高木落楚人思，",
            "嬋娟似恨襄王夢，猿叫斷岩秋蘚稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 38
    },
    {
        "title": "題吳宮苑",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "吳苑荒涼故國名，吳山月上照江明。残春碧樹自留影，",
            "經過此地千年恨，荏苒東风露色清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 39
    },
    {
        "title": "旅館书懷",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "秋看庭樹换风煙，兄弟飄零寄海邊。客计倦行分陝路，",
            "落葉蟲絲滿窗戶，秋堂独坐思悠然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 40
    },
    {
        "title": "贈天臺隱者",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "靜者多依猿鳥叢，衡門野色四郊通。天開宿霧海生日，",
            "看书飲酒餘无事，自樂樵漁狎釣翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 41
    },
    {
        "title": "洛阳月夜书懷",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "疏柳高槐古巷通，月明西照上阳宮。一聲邊雁塞門雪，",
            "孤吟此夕驚秋晚，落葉残花樹色中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 42
    },
    {
        "title": "江行夜泊",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "白浪連空極渺漫，孤舟此夜泊中灘。岳阳秋霽寺鐘遠，",
            "鄉遙楚國生归思，欲曙山光上木蘭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 43
    },
    {
        "title": "贈顓頊山人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "浩氣含真玉片輝，著书精義入玄微。洛阳紫陌幾曾醉，",
            "知君濟世有長策，莫问滄浪隱釣磯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 44
    },
    {
        "title": "長安冬夜书情",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "上國棲迟歲欲終，此情多寄寂寥中。鐘傳半夜旅人館，",
            "今來唯问心期事，独望青雲路未通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 45
    },
    {
        "title": "經古行宮",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "玉輦西归已至今，古原风景自沉沉。禦溝流水長芳草，",
            "路人不記當年事，台殿寂寥山影侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 46
    },
    {
        "title": "秋日登醴泉縣樓",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "閑上高樓时一望，綠蕪寒野靜中分。人行直路入秦樹，",
            "秋风高柳出危葉，独聽蟬聲日欲曛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 47
    },
    {
        "title": "春日旅遊",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "玄發辭家事遠遊，春风归雁一聲愁。花開忽憶故山樹，",
            "秦川楚塞煙波隔，怨別路岐何日休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 48
    },
    {
        "title": "送友人下第归吳",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "共惜年華未立名，路岐終日軫羈情。青春半是往來盡，",
            "東归自有故山約，花落石床苔蘚平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 49
    },
    {
        "title": "訪友人郊居",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "登原過水訪相如，竹塢莎庭似故居。空塞山當清晝晚，",
            "醉唱勞歌翻自歎，釣船漁浦夢難疏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 50
    },
    {
        "title": "匡城尋薛閔秀才不遇",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "音容一別近三年，往事空思意浩然。匹馬東西何處客，",
            "不見故人勞夢寐，独吟风月過南燕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 51
    },
    {
        "title": "与僧話舊",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "巾舄同时下翠微，舊遊因話事多違。南朝古寺幾僧在，",
            "此时相見又相別，即是關河朔雁飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 52
    },
    {
        "title": "寄遠",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "西園楊柳暗驚秋，寶瑟朱弦結遠愁。霜落雁聲來紫塞，",
            "錦字織成添別恨，關河万里路悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 53
    },
    {
        "title": "長安逢友人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "上國相逢塵滿襟，傾杯一話昔年心。荒台共望秋山立，",
            "終期白日青雲路，休感鬢毛霜雪侵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 54
    },
    {
        "title": "下第東归途中书事",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "峽路谁知倦此情，往來多是半年程。孤吟洛苑逢春盡，",
            "東归海上有餘业，牢落田園荒草平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 55
    },
    {
        "title": "經龍門廢寺",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "因思人事事无窮，幾度經過感此中。山色不移樓殿盡，",
            "楊柳覆灘清瀨響，暮天沙鳥自西東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 56
    },
    {
        "title": "下第後懷舊居",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "幾到青門未立名，芳时多負故鄉情。雨餘秦苑綠蕪合，",
            "蘋花覆水曲溪暮，独坐釣舟歌月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 57
    },
    {
        "title": "經无可舊居兼傷賈島",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "塵室寒窗我独看，別來人事幾凋残。书空蕭寺一僧去，",
            "碧雲迢遞長江遠，向夕苦吟归思難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 58
    },
    {
        "title": "贈隱者",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "何时止此幽棲處，独掩衡門長綠苔。臨水靜闻靈鶴语，",
            "谁识无机養真性，醉眠松石枕空杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 59
    },
    {
        "title": "題书齋",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "一日不曾離此處，风吹疏牖夕雲晴。氣淩霜色劍光動，",
            "西齋瑤瑟自為侶，門掩半春苔蘚生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 60
    },
    {
        "title": "題秦女樓",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "珠翠香銷鴛瓦墮，神仙曾向此中游。青樓月色桂花冷，",
            "一從鳳去千年後，迢遞岐山水石秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 61
    },
    {
        "title": "題桃源處士山居留寄",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "白雲深處葺茅廬，退隱衡門与俗疏。一洞曉煙留水上，",
            "窮達盡為身外事，浩然元氣樂樵漁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 62
    },
    {
        "title": "宿題天壇觀",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "沐發清齋宿洞宮，桂花松韵滿岩风。紫霞曉色秋山霽，",
            "冥心一悟虛无理，寂寞玄珠象罔中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 63
    },
    {
        "title": "洛神怨",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "子建東归恨思長，飄颻神女步池塘。雲鬟高動水宮影，",
            "停車綺陌傍楊柳，片月青樓落未央。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 64
    },
    {
        "title": "龍門留別道友",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "一顧恩深荷道安，独垂雙淚下層巒。飛鳴北雁塞雲暮，",
            "裴徊偏起舊枝戀，半夜独吟孤燭残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 65
    },
    {
        "title": "題四皓廟",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "石壁蒼苔翠靄濃，驅車商洛想遺蹤。天高猿叫向山月，",
            "雪髯仙侶何深隱，千古寂寥雲水重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 66
    },
    {
        "title": "望未央宮",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "西上秦原見未央，山嵐川色晚蒼蒼。雲樓欲動入清渭，",
            "香风吹落天人语，彩鳳五雲朝漢皇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 67
    },
    {
        "title": "秋日過昭陵",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "寢廟徒悲劍与冠，翠華龍馭杳漫漫。原分山勢入空塞，",
            "那堪独立斜阳裏，碧落秋光煙樹残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 68
    },
    {
        "title": "夏日登慈恩寺",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "金界时來一訪僧，天香飄翠瑣窗凝。碧池靜照寒松影，",
            "塵机消盡話玄理，暮磬出林疏韵澄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 69
    },
    {
        "title": "宿題金山寺",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "一點青山翠色危，雲岩不掩与星期。海門煙樹潮归後，",
            "蕭疏水木清鐘梵，顥氣寒光動石池。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 70
    },
    {
        "title": "送友人游蜀",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "北去西遊春未半，蜀山雲雪入诗情。青蘿拂水花流影，",
            "心期万里无勞倦，古石蒼苔峽路清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 71
    },
    {
        "title": "題鄭中丞東溪",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "一境新開雉堞西，綠苔微徑露淒淒。高軒夜靜竹聲遠，",
            "即隨鳳詔归清列，幾憶风花夢小溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 72
    },
    {
        "title": "代友人悼姬",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "羅帳香微冷錦裀，歌聲永絕想梁塵。蕭郎独宿落花夜，",
            "滿庭芳草坐成恨，迢遞蓬萊入夢频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 73
    },
    {
        "title": "夏日登西林白上人樓",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "幾到西林清淨境，層台高視有无間。寒光遠動天邊水，",
            "曠然多慊登樓意，永日重門深掩關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 74
    },
    {
        "title": "江樓月夜闻笛",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "南浦蒹葭疏雨後，寂寥橫笛怨江樓。思飄明月浪花白，",
            "發寒衣濕曲初罷，露色河光生釣舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 75
    },
    {
        "title": "送友人下第東归",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "漠漠楊花灞岸飛，幾回傾酒話東归。九衢春盡生鄉夢，",
            "金門自有西來約，莫待螢光照竹扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 76
    },
    {
        "title": "從鄭郎中高州游東潭",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "煙嵐晚入濕旌旗，高檻风清醉未归。夾路野花迎馬首，",
            "自是謝公心近得，登樓望月思依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 77
    },
    {
        "title": "罷華原尉上座主尚书",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "自怜生计事悠悠，浩渺滄浪一釣舟。千里夢归清洛近，",
            "白露黃花歲时晚，不堪霜鬢鏡前愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 78
    },
    {
        "title": "雨後游南門寺",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "郭南山寺雨初晴，上界尋僧竹裏行。半壁樓臺秋月過，",
            "木葉蕭蕭動归思，西风画角漢東城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 79
    },
    {
        "title": "題古寺",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "古寺蕭條偶宿期，更深霜壓竹枝低。長天月影高窗過，",
            "傷心可惜從前事，寥落朱廊墮粉泥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 80
    },
    {
        "title": "晚秋野望",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "秋盡郊原情自哀，菊花寂寞晚仍開。高风疏葉帶霜落，",
            "归途休问從前事，独唱勞歌醉數杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 81
    },
    {
        "title": "秋月望上阳宮",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "苔色輕塵鎖洞房，乱鴉群鴿集残阳。青山空出禁城日，",
            "此时独立意難盡，正值西风砧杵涼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 82
    },
    {
        "title": "入關留別主人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "此來多愧食魚心，東閣将辭強一吟。羸馬客程秋草合，",
            "對酒相看自无语，幾多離思入瑤琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 83
    },
    {
        "title": "留別山中友人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "欲辭松月戀知音，去住多同羈鳥心。秋盡书窗驚白发，",
            "別後寂寥无限意，野花門路草蟲吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 84
    },
    {
        "title": "春晚旅次有懷",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "晚出關河綠野平，依依雲樹動鄉情。残春花盡黃鶯语，",
            "東西未遂归田计，海上青山久廢耕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 85
    },
    {
        "title": "与重幽上人話舊",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "雲飛天末水空流，省与師同別異州。庭樹蟬聲初入夏，",
            "自喜他年接巾舄，滄浪地近虎溪頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 86
    },
    {
        "title": "月夜闻鶴唳",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "碧落风微月正明，霜毛似怨有離情。莓苔石冷想孤立，",
            "鳳凰樓閣知犹戀，終逐煙霞上玉京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 87
    },
    {
        "title": "過北邙山",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "散漫黃埃滿北原，折碑橫路碾苔痕。空山夜月來松影，",
            "白楊落日悲风起，蕭索寒巢鳥独奔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 88
    },
    {
        "title": "咸阳懷古",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "經過此地无窮事，一望淒然感廢興。渭水故都秦二世，",
            "风景蒼蒼多少恨，寒山半出白雲層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 89
    },
    {
        "title": "送友人罷舉赴薊門從事",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "人生行止在知己，遠佐諸侯重所依。綠綬便當身是貴，",
            "此去黃金臺上客，相思應羨雁南归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 90
    },
    {
        "title": "看榜日",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "禁漏初停蘭省開，列仙名目上清來。飛鳴曉日鶯聲遠，",
            "青雲已是酬恩處，莫惜芳时醉酒杯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 91
    },
    {
        "title": "送李休秀才归嶺中",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "南泛孤舟景自饒，蒹葭汀浦晚蕭蕭。秋风漢水旅愁起，",
            "故園新過重阳節，黃菊滿籬應未凋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 92
    },
    {
        "title": "寓居寄友人",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "雨餘虛館竹阴清，独坐书窗軫旅情。芳草衡門无馬跡，",
            "今夜南原賞佳景，月高风定苦吟生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 93
    },
    {
        "title": "經曲阜城",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "行經闕裏自堪傷，曾歎東流逝水長。蘿蔓幾凋荒隴樹，",
            "蕭索风高洙泗上，秋山明月夜蒼蒼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 94
    },
    {
        "title": "汶阳客舍",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "年光自感益蹉跎，岐路東西竟若何。窗外雨來山色近，",
            "迢遞舊山伊水畔，破齋荒徑閉煙蘿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 95
    },
    {
        "title": "留別崔澣秀才昆仲",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "汶阳離思水无窮，去住情深夢寐中。歲晚蟲鳴寒露草，",
            "對酒不能傷此別，尺书凭雁往來通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 96
    },
    {
        "title": "和友人憶洞庭舊居",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "客舍經时益苦吟，洞庭犹憶在前林。青山残月有归夢，",
            "因君話舊起愁思，隔水數聲何處砧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 97
    },
    {
        "title": "晚归山居",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "寥落霜空木葉稀，初行郊野思依依。秋深频憶故鄉事，",
            "娟娟唯有西林月，不惜清光照竹扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 98
    },
    {
        "title": "送元敘上人归上黨",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "太行關路戰塵收，白日思鄉別沃州。薄暮焚香臨野燒，",
            "此去寂寥尋舊跡，蒼苔滿徑竹齋秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 99
    },
    {
        "title": "秋日旅途即事",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "驅羸多自感，煙草遠郊平。鄉路幾时盡，旅人終日行。",
            "渡邊寒水驛，山下夕阳城。蕭索更何有，秋风两鬢生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 100
    },
    {
        "title": "早行",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "旅途乘早景，策馬独淒淒。残影郡樓月，一聲關樹雞。",
            "聽鐘煙柳外，问渡水雲西。當自勉行役，終期功业齊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 101
    },
    {
        "title": "句",
        "author": "劉滄",
        "biography": "",
        "paragraphs": [
            "海曙雲浮日，江遙水合天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百八十六",
        "no#": 102
    }
]