[
    {
        "title": "酬皇甫冉西陵見寄",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "西陵潮信滿，島嶼沒中流。越客依风水，相思南渡頭。",
            "寒光生极浦，落日映滄洲。何事揚帆去，空驚海上鸥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 1
    },
    {
        "title": "溪行即事",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "近夜山更碧，入林溪轉清。不知伏牛事，潭洞何從橫。",
            "野岸煙初合，平湖月未生。孤舟屡失道，但聽秋泉聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 2
    },
    {
        "title": "棲霞山夜坐",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "山頭戒壇路，幽映雪岩側。四面青石床，一峰苔蘚色。",
            "松风靜複起，月影開還黑。何独乘夜來，殊非晝所得。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 3
    },
    {
        "title": "宿天柱觀",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "石室初投宿，仙翁喜暫容。花源隔水見，洞府過山逢。",
            "泉湧階前地，雲生戶外峰。中宵自入定，非是欲降龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 4
    },
    {
        "title": "酬皇甫冉将赴无錫，於雲門寺贈別",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "湖南通古寺，來往意无涯。欲识雲門路，千峰到若耶。",
            "春山子敬宅，古木謝敷家。自可長偕隱，那言相去賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 5
    },
    {
        "title": "宜豐新泉",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "泉源新湧出，洞澈映纖雲。稍落芙蓉沼，初淹苔蘚文。",
            "素将空意合，淨与眾流分。每到清宵月，泠泠夢裏闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 6
    },
    {
        "title": "靜林精舍",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "靜林溪路遠，蕭帝有遺蹤。水擊羅浮磬，山鳴于闐鐘。",
            "燈傳三世火，樹老万株松。无数煙霞色，空闻昔臥龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 7
    },
    {
        "title": "江行寄张舍人",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "客程終日风塵苦，蓬轉還家未有期。林色曉分残雪后，",
            "流蕩此心難共说，千峰澄霽隔瓊枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 8
    },
    {
        "title": "送王穎悟归左綿",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "客意天南興已闌，不堪言別向仙官。夢搖玉佩隨旄節，",
            "想得故山青靄裏，泉聲入夜独潺潺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 9
    },
    {
        "title": "安公",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "彌天稱圣哲，象法初繄賴。弘道识行藏，匡时知進退。",
            "秦王輕与舉，習生重酬对。學文古篆中，義顯心經內。",
            "法服應華夏，金言流海岱。西方浮雲間，更陪龍華會。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 10
    },
    {
        "title": "林公",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "支公信高逸，久向山林住。时将孫许游，豈以形骸遇。",
            "幸辭天子詔，複覽名臣疏。西晉尚虛无，南朝久淪誤。",
            "因談老莊意，乃盡逍遙趣。谁為竹林賢，风流相比附。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 11
    },
    {
        "title": "遠公",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "遠公逢道安，一朝棄儒服。真机久消歇，世教空拘束。",
            "誓入羅浮中，遂棲廬山曲。禪經初纂定，佛语新名目。",
            "缽帽絕朝宗，簪裾翻拜伏。東林多隱士，為我辭榮祿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 12
    },
    {
        "title": "雨后欲尋天目山，问元、駱二公溪路",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "昨夜雲生天井東，春山一雨一回风。",
            "林花並逐溪流下，欲上龍池通不通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 13
    },
    {
        "title": "題僧院",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "虎溪閑月引相過，帶雪松枝掛薜蘿。",
            "无限青山行欲盡，白雲深处老僧多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 14
    },
    {
        "title": "宿靜林寺",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "山寺門前多古松，溪行欲到已闻鐘。",
            "中宵引領尋高頂，月照雲峰凡幾重。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 15
    },
    {
        "title": "再還宜豐寺",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "再尋招隱地，重會息心期。樵客问归日，山僧記別时。",
            "野雲阴遠甸，秋雨漲前陂。勿謂探形勝，吾今不好奇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 16
    },
    {
        "title": "春日山齋",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "野徑東风起，山扉度日開。晴光拆紅萼，流水長青苔。",
            "逋客殊未去，芳时已再來。非關戀春草，自是欲裴回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 17
    },
    {
        "title": "留別忠州故人",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "一身无定处，万里独銷魂。芳草迷归路，春流滴淚痕。",
            "幾时休旅食，何夜宿江村。欲识相思苦，空山啼暮猿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 18
    },
    {
        "title": "送別",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "凭高莫送遠，看欲斷归心。別恨啼猿苦，相思流水深。",
            "翠雲南澗影，丹桂晚山阴。若未來雙鵠，遼城何更尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 19
    },
    {
        "title": "送冽寺主之京迎禪和尚",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "禪門居此地，瞻望在虛空。水國月未上，蒼生如夢中。",
            "上人知机士，瓶錫慰樊籠。彼土諸梵眾，嗟君揚道风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 20
    },
    {
        "title": "送王法師之西川",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "旅遊无近遠，要自別魂銷。官柳鄉愁乱，春山客路遙。",
            "伴行芳草遠，緣興野花飄。计日功成后，還将輔圣朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 21
    },
    {
        "title": "送范律師往果州",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "終南千古后，独爾繼卿名。離障非今日，修因是幾生。",
            "乱峰寒影暮，深澗野流清。遠客归心苦，難為此別情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 22
    },
    {
        "title": "送明素上人归楚覲省",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "能将疏懶背时人，不厭孤萍任此身。江上昔年同出处，",
            "前路倍怜多勝事，到家知慶彩衣新。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 23
    },
    {
        "title": "項王廟",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "緬想咸阳事可嗟，楚歌哀怨思无涯。八千子弟归何处，",
            "拔山力盡烏江水，今日悠悠空浪花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 24
    },
    {
        "title": "酬陳明府舟中見贈",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "長溪通夜靜，素舸与人閑。月影沈秋水，风聲落暮山。",
            "稻花千頃外，蓮葉两河間。陶令多真意，相思一解顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 25
    },
    {
        "title": "題東蘭若",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "上人禪室路裴回，万木清阴向日開。寒竹影侵行徑石，",
            "更惜片阳談妙理，归时莫待暝鐘催。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 26
    },
    {
        "title": "送朱放",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "苦見人間世，思归洞裏天。縱令山鳥语，不廢野人眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 27
    },
    {
        "title": "归岑山過惟審上人別业",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "禪客无心憶薜蘿，自然行徑向山多。",
            "知君欲问人間事，始与浮雲共一過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 28
    },
    {
        "title": "於潛道中呈元八处士",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "苕水灘行淺，潛州路漸深。參差遠岫色，迢遞野人心。",
            "凍澗冰難釋，秋山日易阴。不知天目下，何处是雲林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 29
    },
    {
        "title": "送殷判官归上都",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "漾舟雲路客，來過夕阳时。向背堪遺恨，逢迎宿未期。",
            "水容愁暮急，花影動春迟。別后王孫草，青青入夢思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 30
    },
    {
        "title": "贈別皇甫曾",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "幽人從遠岳，過客愛春山。高駕能相送，孤遊且未還。",
            "紫苔封井石，綠竹掩柴關。若到雲峰外，齊心去住間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 31
    },
    {
        "title": "送陳允初卜居麻園",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "欲向麻源隱，能尋謝客蹤。空山幾千里，幽谷第三重。",
            "茅宇寧須葺，荷衣不待縫。因君見往事，為我謝喬松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 32
    },
    {
        "title": "秋題劉逸人林泉",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "涼飆乱黃葉，迟客橘阴清。蘿徑封行跡，雲門閉野情。",
            "零林秋露響，穿竹暮煙輕。莫戀幽棲地，懷安卻敗名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 33
    },
    {
        "title": "自大林与韓明府归郭中精舍",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "野客同舟楫，相攜複一归。孤煙生暮景，遠岫帶春暉。",
            "不道還山是，谁雲向郭非。禪門有通隱，喧寂共忘机。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 34
    },
    {
        "title": "同使君宿大樑驛",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "旌旗江上出，花外捲簾空。夜色臨城月，春寒度水风。",
            "雖然行李別，且喜语音同。若问匡廬事，終身愧遠公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 35
    },
    {
        "title": "題黃公陶翰別业",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "闻说花源堪避秦，幽尋数月不逢人。煙霞洞裏无雞犬，",
            "醉臥白雲閑入夢，不知何物是吾身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 36
    },
    {
        "title": "哭衛尚书",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "画戟重門楚水阴，天涯欲暮共傷心。南荊雙戟痕犹在，",
            "有路茫茫向谁问，感君空有淚沾襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 37
    },
    {
        "title": "贈靈澈禪師",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "禪師來往翠微間，万里千峰到剡山。",
            "何时共到天臺裏，身与浮雲处处閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 38
    },
    {
        "title": "将出宜豐寺留題山房",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "池上蓮荷不自開，山中流水偶然來。",
            "若言聚散定由我，未是回时那得回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 39
    },
    {
        "title": "妙樂觀",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "王喬所居空山觀，白雲至今凝不散。壇場月路幾千年，",
            "忽見一人檠茶碗，篸花昨夜风吹滿。自言家处在東坡，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 40
    },
    {
        "title": "与元居士青山潭飲茶",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "野泉煙火白雲間，坐飲香茶愛此山。",
            "岩下維舟不忍去，青溪流水暮潺潺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 41
    },
    {
        "title": "送人得蕩子归倡婦",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "垂涕凭回信，為语柳園人。情知独難守，又是一阳春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 42
    },
    {
        "title": "句",
        "author": "靈一",
        "biography": "",
        "paragraphs": [
            "濾泉侵月起，掃徑避蟲行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百零九",
        "no#": 43
    }
]