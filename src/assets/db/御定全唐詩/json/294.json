[
    {
        "title": "揚州選蒙相公賞判雪後呈上",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "自得山公许，休耕海上田。慚看長史傳，欲棄釣魚船。",
            "窮巷殷憂日，蕪城雨雪天。此时瞻相府，心事比旌懸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 1
    },
    {
        "title": "客舍书情寄趙中丞",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "東楚複西秦，浮雲類此身。關山勞策蹇，僮僕慣投人。",
            "孤客來千里，全家托四鄰。生涯難自料，中夜问情親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 2
    },
    {
        "title": "客舍有懷因呈諸在事",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "讀书常苦節，待詔豈辭貧。暮雪犹驅馬，晡餐又寄人。",
            "愁來占吉夢，老去惜良辰。延首平津閣，家山日已春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 3
    },
    {
        "title": "书懷寄楊郭李王判官",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "慣作雲林客，因成懶漫人。吏欺從政拙，妻笑理家貧。",
            "李郭應时望，王楊入幕频。從容丞相閣，知憶故園春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 4
    },
    {
        "title": "奉和給事寓直",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "桂枝家共折，雞樹代相傳。忝向鸞台下，仍看雁影連。",
            "夜閑方步月，漏盡欲朝天。知去丹墀近，明王许薦賢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 5
    },
    {
        "title": "初入集賢院贈李獻仁",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "燕代官初罷，江湖路便分。九遷從命薄，四十幸人闻。",
            "跡愧趨丹禁，身曾系白雲。何由返滄海，昨日謁明君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 6
    },
    {
        "title": "酬李補闕雨中寄贈",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "十年隨馬宿，幾度受人恩。白发還鄉井，微官有子孫。",
            "竹窗寒雨滴，苦砌夜蟲喧。独愧東垣友，新诗慰旅魂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 7
    },
    {
        "title": "初除拾遺酬丘二十二見寄",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "江海久垂綸，朝衣忽掛身。丹墀初謁帝，白发免羞人。",
            "才愧文章士，名當諫諍臣。空餘薦賢分，不敢負交親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 8
    },
    {
        "title": "劉展下判官相招以诗答之",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "國有非常寵，家承異姓勳。背恩慚皎日，不義若浮雲。",
            "但使忠貞在，甘從玉石焚。竄身如有地，夢寐見明君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 9
    },
    {
        "title": "送侯山人赴會稽",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "仙客辭蘿月，東來就一官。且归滄海住，犹向白雲看。",
            "猿叫江天暮，蟲聲野浦寒。时遊鏡湖裏，為我把魚竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 10
    },
    {
        "title": "宿禪智寺上方演大師院",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "石林高幾许，金刹在中峰。白日空山梵，清霜後夜鐘。",
            "竹窗回翠壁，苔徑入寒松。幸接无生法，疑心怯所從。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 11
    },
    {
        "title": "題空山人石室",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "早晚悟无生，頭陀不到城。雲山知夏臘，猿鳥見修行。",
            "地僻无溪路，人尋逐水聲。年年深谷裏，谁识遠公名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 12
    },
    {
        "title": "登蔣山開善寺",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "山殿秋雲裏，香煙出翠微。客尋朝磬至，僧背夕阳归。",
            "下界千門見，前朝万事非。看心兼送目，葭菼暮依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 13
    },
    {
        "title": "題崇福寺禪院",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "僧家竟何事，掃地与焚香。清磬度山翠，閑雲來竹房。",
            "身心塵外遠，歲月坐中長。向晚禪堂掩，无人空夕阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 14
    },
    {
        "title": "秋晚送丹徒许明府赴上國，因寄江南故人",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "秋暮之彭澤，籬花遠近逢。君书前日至，別後此时重。",
            "寒夜江邊月，晴天海上峰。還知南地客，招引住新豐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 15
    },
    {
        "title": "送薛仲方归揚州",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "佳句應无敵，貞心不有猜。慚為丈人行，怯見後生才。",
            "泛舸貪斜月，浮橈值早梅。綠楊新過雨，芳草待君來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 16
    },
    {
        "title": "送韋員外還京",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "十年離乱後，此去若為情。春晚香山綠，人稀豫水清。",
            "野陂看独樹，關路逐残鶯。前殿朝明主，應怜白发生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 17
    },
    {
        "title": "潤州送友人",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "見君還此地，灑淚向江邊。國士勞相问，家书无處傳。",
            "荒城胡馬跡，塞木戍人煙。一路堪愁思，孤舟何渺然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 18
    },
    {
        "title": "送张芬東归",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "喧喧五衢上，鞍馬自驅馳。落日臨阡陌，貧交欲別離。",
            "早知时事異，堪与世人隨。握手将何贈，君心我独知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 19
    },
    {
        "title": "送蘇修游上饒",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "愛爾无羈束，雲山恣意過。一身隨遠岫，孤棹任輕波。",
            "世事關情少，漁家寄宿多。蘆花淺淡處，江月奈人何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 20
    },
    {
        "title": "送陸明府之盱眙",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "陶令之官去，窮愁慘別魂。白煙橫海戍，紅葉下淮村。",
            "澹浪搖山郭，平蕪到縣門。政成堪吏隱，免負府公恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 21
    },
    {
        "title": "江南回逢趙曜，因送任十一赴交城主簿",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "江上長相憶，因高北望看。不知攜老幼，何處度艱難。",
            "屈指同人盡，傷心故里残。遙怜驅匹馬，白首到微官。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 22
    },
    {
        "title": "送薛良史往越州謁從叔",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "辭家年已久，与子分偏深。易得相思淚，難為欲別心。",
            "孤雲隨浦口，幾日到山阴。遙想蘭亭下，清风滿竹林。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 23
    },
    {
        "title": "送丘二十二之蘇州",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "積水与寒煙，嘉禾路幾千。孤猿啼海島，群雁起湖田。",
            "曾見長洲苑，嘗闻大雅篇。卻将封事去，知爾愛閑眠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 24
    },
    {
        "title": "登潤州芙蓉樓",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "上古人何在，東流水不归。往來潮有信，朝暮事成非。",
            "煙樹臨沙靜，雲帆入海稀。郡樓多逸興，良牧謝玄暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 25
    },
    {
        "title": "江上书懷",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "骨肉天涯別，江山日落时。淚流襟上血，發變鏡中絲。",
            "胡越书難到，存亡夢豈知。登高回首罷，形影自相隨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 26
    },
    {
        "title": "春日憶姚氏外甥",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "離乱人相失，春秋雁自飛。只緣行路遠，未必寄书稀。",
            "二月花无數，频年意有違。落暉看過後，独坐淚沾衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 27
    },
    {
        "title": "送真上人還蘭若",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "得道雲林久，年深暫一归。出山逢世乱，乞食覺人稀。",
            "半偈初傳法，中峰又掩扉。愛憎應不染，塵俗自依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 28
    },
    {
        "title": "潤州送師弟自江夏往台州",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "遠客乘流去，孤帆向夜開。春风江上使，前日漢阳來。",
            "別路犹千里，離心重一杯。剡溪木未落，羨爾過天臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 29
    },
    {
        "title": "送李道士归山",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "秋城臨古路，城上望君還。曠野入寒草，独行隨遠山。",
            "授人鴻寶內，将犬白雲間。早晚燒丹罷，遙知冰雪寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 30
    },
    {
        "title": "宿江西竇主簿廳",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "廣庭方緩步，星漢話中移。月滿關山道，烏啼霜樹枝。",
            "时艱難會合，年長重親知。前事成金石，淒然淚欲垂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 31
    },
    {
        "title": "喜逢妻弟鄭損因送入京",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "乱後自江城，相逢喜複驚。為經多载別，欲问小时名。",
            "對酒悲前事，論文畏後生。遙知盈卷軸，紙貴在江城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 32
    },
    {
        "title": "詠門下画小松上元王杜三相公",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "昔闻生澗底，今見起毫端。眾草此时沒，何人知歲寒。",
            "豈能裨棟宇，且貴出門闌。只在丹青意，淩雲也不難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 33
    },
    {
        "title": "寄上禮部李侍郎",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "吳楚相逢處，江湖共泛时。任风舟去遠，待月酒行迟。",
            "白发常同歎，青雲本要期。貴來君卻少，秋至老偏悲。",
            "玉佩明朝盛，蒼苔陋巷滋。追尋恨无路，唯有夢相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 34
    },
    {
        "title": "书情寄上蘇州韋使君兼呈吳縣李明府",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "數年湖上謝浮名，竹杖紗巾遂性情。雲外有时逢寺宿，",
            "谁念獻书來万里，君王深在九重城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 35
    },
    {
        "title": "題桐廬李明府官舍",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "訟堂寂寂對煙霞，五柳門前聚曉鴉。流水聲中視公事，",
            "可惜陶潛无限酒，不逢籬菊正開花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 36
    },
    {
        "title": "贈竇十九",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "靈台暮宿意多違，木落花開羨客归。江海幾时傳錦字，",
            "幸得漢皇容直諫，怜君未遇覺人非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 37
    },
    {
        "title": "虔州見鄭表新诗因以寄贈",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "梅花嶺裏見新诗，感激情深過楚詞。平子四愁今莫比，",
            "才子风流定難見，湖南春草但相思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 38
    },
    {
        "title": "贈元秘书",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "舊书稍稍出风塵，孤客逢秋感此身。秦地謬為門下客，",
            "幸有故人茅屋在，更将心事问情親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 39
    },
    {
        "title": "送韋八少府判官归東京",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "玄成世业紫真官，文似相如貌勝潘。鴻雁南飛人独去，",
            "瓊樹相思何日見，銀鉤數字莫為難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 40
    },
    {
        "title": "送馮八将军奏事畢归滑台幕府",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "王門別後到滄洲，帝裏相逢俱白頭。自歎馬卿常帶疾，",
            "想到滑台桑葉落，黃河東注杏園秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 41
    },
    {
        "title": "送王侍禦佐婺州",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "闻君作尉向江潭。吳越风煙到自諳。客路尋常經竹徑，",
            "惟有夜猿啼海樹，思鄉望北意難堪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 42
    },
    {
        "title": "越中送王使君赴江華",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "皂蓋春风自越溪，独尋芳樹桂阳西。遠水浮雲隨馬去，",
            "万里相思在何處，九疑残雪白猿啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 43
    },
    {
        "title": "送皇甫冉往白田",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "江邊盡日雉鳴飛，君向白田何日归。楚地蒹葭連海迥，",
            "試问疲人与征戰，使君雙淚定沾衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 44
    },
    {
        "title": "題蘭若",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "絕頂茅庵老此生，寒雲孤木独經行。",
            "世人那得知幽徑，遙向青峰禮磬聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 45
    },
    {
        "title": "送賀蘭廣赴選",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "而今用武爾攻文，流輩幹时独臥雲。",
            "白发青袍趨會府，定應衡鏡卻慚君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 46
    },
    {
        "title": "清江曲內一絕",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "八月長江去浪平，片帆一道帶风輕。",
            "極目不分天水色，南山南是岳阳城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 47
    },
    {
        "title": "武康郭外望许緯先生山居",
        "author": "崔峒",
        "biography": "",
        "paragraphs": [
            "湖上千峰帶落暉，白雲開處見柴扉。",
            "松門一徑仍生草，應是仙人向郭稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷二百九十四",
        "no#": 48
    }
]