[
    {
        "title": "人日代客子",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "人日兼春日，長懷複短懷。遙知雙彩勝，並在一金釵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 1
    },
    {
        "title": "築城詞二首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "城上一培土，手中千万杵。築城畏不堅，堅城在何处。",
            "莫歎将军逼，将军要卻敵。城高功亦高，爾命何勞惜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 2
    },
    {
        "title": "古意",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "君心莫淡薄，妾意正棲托。愿得雙車輪，一夜生四角。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 3
    },
    {
        "title": "春曉",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "春庭曉景別，清露花邐迤。黃蜂一過慵，夜夜棲香蕊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 4
    },
    {
        "title": "雜興",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "桃李傍簷楹，无人賞春華。时情重不見，卻憶菖蒲花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 5
    },
    {
        "title": "雁",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "南北路何長，中間万弋张。不知煙霧裏，幾隻到衡阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 6
    },
    {
        "title": "寄遠",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "鬢乱羞雲卷，眉空羨月生。中原犹将将，何日重卿卿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 7
    },
    {
        "title": "庭前",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "合歡能解恚，萱草信忘憂。盡向庭前種，萋萋特地愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 8
    },
    {
        "title": "洞房怨",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "玉鍤朝扶鬢，金梯晚下臺。春衫将別淚，一夜两難裁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 9
    },
    {
        "title": "江行",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "酒旗菰葉外，樓影浪花中。醉帆张数幅，唯待鯉魚风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 10
    },
    {
        "title": "巫峽",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "巫峽七百里，巫山十二重。年年自雲雨，環佩竟谁逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 11
    },
    {
        "title": "归路",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "漸入新豐路，衰紅映小橋。渾如七年病，初得一丸銷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 12
    },
    {
        "title": "南塘曲",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "妾住東湖下，郎居南浦邊。閑臨煙水望，認得采菱船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 13
    },
    {
        "title": "黃金二首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "自古黃金貴，犹沽駿与才。近來簪珥重，无可上高臺。",
            "平分從滿篋，醉擲任成堆。恰莫持千万，明明買禍胎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 14
    },
    {
        "title": "夕阳",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "渡口和帆落，城邊帶角收。如何茂陵客，江上倚危樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 15
    },
    {
        "title": "残雪",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "桂冷微停素，峰幹不遍嵐。何溪背林处，犹覆定僧庵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 16
    },
    {
        "title": "古態",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "古態日漸薄，新妝心更勞。城中皆一尺，非妾髻鬟高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 17
    },
    {
        "title": "大堤",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "大堤春日暮，驄馬解鏤衢。請君留上客，容妾薦雕胡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 18
    },
    {
        "title": "金陵道",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "北雁行行直，東流澹澹春。當时六朝客，還道帝鄉人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 19
    },
    {
        "title": "離騷",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "天问複招魂，无因徹帝閽。豈知千麗句，不敵一讒言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 20
    },
    {
        "title": "对酒",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "后代稱歡伯，前賢號圣人。且須謀日富，不要道家貧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 21
    },
    {
        "title": "寄南嶽客乞靈蕪香",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "闻说融峰下，靈香似反魂。春來正堪采，試為劚雲根。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 22
    },
    {
        "title": "山阳燕中郊樂錄",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "淮上能无雨，回頭總是情。蒲帆渾未織，爭得一歡成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 23
    },
    {
        "title": "偶作",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "雙眉初出繭，两鬢正藏鴉。自有王昌在，何勞近宋家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 24
    },
    {
        "title": "有示",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "相对莫辭貧，蓬蒿任塞門。无情是金玉，不報主人恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 25
    },
    {
        "title": "秋思三首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "桐露珪初落，蘭风佩欲衰。不知能賦客，何似枉刀兒。",
            "谁在嫖姚幕，能教霹靂車。至今思禿尾，无以代寒菹。",
            "未得同齏杵，何时減药囊。莫言天帝醉，秦暴不靈長。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 26
    },
    {
        "title": "早春",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "雨冷唯添暑，煙初不著春。数枝花纇小，愁殺扈芳人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 27
    },
    {
        "title": "懷仙三首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "闻道阳都女，連娟耳細長。自非黃犢客，不得到雲房。",
            "但服鐶剛子，兼吟曲素詞。須知臣漢客，還見布龍兒。",
            "神燭光華麗，靈祛羽翼生。已傳餐玉粒，犹自買雲英。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 28
    },
    {
        "title": "芙蓉",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "閑吟鮑照賦，更起屈平愁。莫引西风動，紅衣不耐秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 29
    },
    {
        "title": "春思",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "怨鶯新语澀，雙蝶鬥飛高。作個名春恨，浮生百倍勞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 30
    },
    {
        "title": "风人诗四首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "十万全師出，遙知正憶君。一心如瑞麥，長作两岐分。",
            "破檗供朝爨，須怜是苦辛。曉天窺落宿，谁识独醒人。",
            "旦日思雙屨，明时愿早諧。丹青傳四瀆，難写是秋懷。",
            "闻道更新幟，多應發舊旗。征衣无伴搗，独处自然悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 31
    },
    {
        "title": "樂府雜詠六首：雙吹管",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "長短裁浮筠，參差作飛鳳。高樓微月夜，吹出江南弄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 32
    },
    {
        "title": "樂府雜詠六首：東飛鳧",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "裁得尺錦书，欲寄東飛鳧。脛短翅亦短，雌雄戀菰蒲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 33
    },
    {
        "title": "樂府雜詠六首：花成子",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "春风等君意，亦解欺桃李。写得去时真，归來不相似。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 34
    },
    {
        "title": "樂府雜詠六首：月成弦",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "孤光照還沒，轉益傷離別。妾若是嫦娥，長圓不教缺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 35
    },
    {
        "title": "樂府雜詠六首：孤燭怨",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "前回邊使至，闻道交河戰。坐想鼓鞞聲，寸心攢百箭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 36
    },
    {
        "title": "樂府雜詠六首：金吾子",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "嫁得金吾子，常闻輕薄名。君心如不重，妾腰徒自輕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 37
    },
    {
        "title": "子夜四时歌：春",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "山連翠羽屏，草接煙華席。望盡南飛燕，佳人斷消息。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 38
    },
    {
        "title": "子夜四时歌：夏",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "蘭眼抬路斜，鶯唇映花老。金龍傾漏盡，玉井敲冰早。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 39
    },
    {
        "title": "子夜四时歌：秋",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "涼漢清泬寥，衰林怨风雨。愁聽絡緯唱，似与羈魂语。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 40
    },
    {
        "title": "子夜四时歌：冬",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "南雲走冷圭，北籟號空木。年年任霜霰，不減筼簹綠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 41
    },
    {
        "title": "大子夜歌二首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "歌謠数百種，子夜最可怜。慷慨吐清音，明轉出天然。",
            "絲竹發歌響，假器揚清音。不知歌謠妙，聲勢出口心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 42
    },
    {
        "title": "子夜警歌二首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "鏤碗傳綠酒，雕爐熏紫煙。谁知苦寒調，共作白雪弦。",
            "恃愛如欲進，含羞出不前。朱口發豔歌，玉指弄嬌弦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 43
    },
    {
        "title": "子夜變歌三首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "人傳歡負情，我自未嘗見。三更開門去，始知子夜變。",
            "歲月如流邁，春盡秋已至。熒熒條上花，零落何乃駛。",
            "歲月如流邁，行已及素秋。蟋蟀吟堂前，惆悵使儂愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 44
    },
    {
        "title": "江南曲五首",
        "author": "陸龜蒙",
        "biography": "",
        "paragraphs": [
            "魚戲蓮葉間，參差隱葉扇。鵁鶄鸀鳿窺，瀲灩无因見。",
            "魚戲蓮葉東，初霞射紅尾。旁臨謝山側，恰值清风起。",
            "魚戲蓮葉西，盤盤舞波急。潛依曲岸涼，正直斜光入。",
            "魚戲蓮葉南，欹危舞煙疊。光搖越鳥巢，影乱吳娃楫。",
            "魚戲蓮葉北，澄阳動微漣。回看帝子渚，稍背鄂君船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百二十七",
        "no#": 45
    }
]