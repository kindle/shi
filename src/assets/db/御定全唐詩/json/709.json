[
    {
        "title": "西華",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "五千仞有餘神秀，一一排雲上泬。疊嶂出關分二陝，",
            "拜祝金天乞阴德，為民求主降神堯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 1
    },
    {
        "title": "嵐似屏风",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "嵐似屏风草似茵，草邊时膾錦花鱗。山中宰相陶弘景，",
            "君看東洛平泉宅，只有年年百卉春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 2
    },
    {
        "title": "憶潼關",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "洞壑雙扉入到初，似從深阱睹高墟。天開白日臨军國，",
            "須知皇漢能扃鐍，延得年過四百餘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 3
    },
    {
        "title": "憶潼關早行",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "行客起看仙掌月，落星斜照濁河泥。故山遠处高飛雁，",
            "芻蕘十軸僮三尺，豈謂青雲便有梯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 4
    },
    {
        "title": "鴻門",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "耨月耕煙水國春，薄徒應笑作農人。皇王尚法三推禮，",
            "犹勝墮力求飧者，五鬥低腰走世塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 5
    },
    {
        "title": "憶長安行",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "舊曆關中憶廢興，僭奢須戒儉須凭。火光只是燒秦塚，",
            "不如坐釣清溪月，心共寒潭一片澄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 6
    },
    {
        "title": "憶長安上省年",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "忽憶關中逐计車，曆坊騎馬信空虛。三秋病起見新雁，",
            "如今说著犹堪泣，两宿都堂過歲除。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 7
    },
    {
        "title": "長安述懷",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "黃河冰合尚來遊，知命知时肯躁求。詞賦有名堪自負，",
            "十载公卿早言屈，何須課夏更冥搜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 8
    },
    {
        "title": "長安即事三首",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "拋擲清溪舊釣鉤，長安寒暑再環周。便隨鶯羽三春化，",
            "明时則待金門詔，肯羨班超万戶侯。",
            "无酒窮愁結自舒，飲河求滿不求餘。身登霄漢平时第，",
            "明时用即匡君去，不用何妨卻釣魚。",
            "拖紫腰金不要論，便堪归隱白雲村。更无名籍強金榜，",
            "高眠亦是前賢事，爭報春闈莫大恩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 9
    },
    {
        "title": "東京次新安道中",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "賊去兵來歲月長，野蒿空滿壞牆匡。旋從古轍成深谷，",
            "殊时異世為儒者，不見文皇与武皇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 10
    },
    {
        "title": "山阴故事",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "坦腹夫君不可逢，千年犹在播英风。紅鵝化鶴青天遠，",
            "吹笙緱嶺登山后，東注清流豈有窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 11
    },
    {
        "title": "溫陵即事",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "早年師友教為文，賣卻魚舟網典墳。國有安危期日諫，",
            "爭得千鐘季孫粟，滄洲归与故人分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 12
    },
    {
        "title": "溫陵残臘书懷寄崔尚书",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "濟川无楫擬何為，三傑還從漢祖推。心學庭槐空發火，",
            "江上年年接君子，一杯春酒一枰棋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 13
    },
    {
        "title": "義通裏寓居即事",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "家住寒梅翠嶺東，長安时節詠途窮。牡丹窠小春餘雨，",
            "長卿甚有淩雲作，谁与清吟繞帝宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 14
    },
    {
        "title": "上阳宮詞",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "點點苔錢上玉墀，日斜空望六龍西。妝台塵暗青鸞掩，",
            "銀蟾借与金波路，得入重輪伴羿妻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 15
    },
    {
        "title": "西寨寓居",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "閑讀南華对酒杯，醉攜筇竹画蒼苔。豪門有利人爭去，",
            "嚴陵万古清风在，好棹東溪詠釣台。",
            "功智爭馳淡薄空，犹懷忠信擬何從。鴟鳶啄腐疑雛鳳，",
            "崇侯入輔嚴陵退，堪憶啼猿万仞峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 16
    },
    {
        "title": "題福州天王閣",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "絕境宜棲独角仙，金张到此亦忘還。三門裏面千層閣，",
            "有时海上看明月，輾出冰輪疊浪間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 17
    },
    {
        "title": "憶薦福寺南院",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "憶昔長安落第春，佛宮南院独遊频。燈前不動惟金像，",
            "啼猿溪上将归去，合问升平詣秉鈞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 18
    },
    {
        "title": "塔院小屋，四壁皆是卿相題名，因成四韵",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "雁塔攙空映九衢，每看華宇每踟躕。題名儘是台衡跡，",
            "谁知遠客思归夢，夜夜无船自過湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 19
    },
    {
        "title": "題名琉璃院",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "一條溪繞翠岩隈，行腳僧言勝五台。農罷樹阴黃犢臥，",
            "三卷貝多金粟语，可能長誦免輪回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 20
    },
    {
        "title": "寺中偶題",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "聽話金仙眉相毫，每來皆得解塵勞。鶴棲雲路看方貴，",
            "銀蟾未出金烏在，更上層樓眺海濤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 21
    },
    {
        "title": "山寺寓居",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "高臥東林最上方，水聲山翠剔愁腸。白雲送雨籠僧閣，",
            "披緇學佛應无分，鶴氅談空亦不妨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 22
    },
    {
        "title": "寄僧寓題",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "佛頂抄經憶惠休，眾人皆謂我悠悠。浮生真個醉中夢，",
            "安眠靜笑思何報，日夜焚修祝郡侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 23
    },
    {
        "title": "遊靈隱天竺二寺",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "丹井冷泉虛易到，两山真界實難名。石和雲霧蓮華气，",
            "更怜童子呼猿去，颯颯蕭蕭下樹行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 24
    },
    {
        "title": "醉題邑宰南塘屋壁",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "万古清淮照遠天，黃河濁浪不相關。縣留東道三千客，",
            "閩王美錦求賢制，未许陶公解印還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 25
    },
    {
        "title": "題泗洲塔",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "十年前事已悠哉，旋被鐘聲早暮催。明月似師生又沒，",
            "惟有南邊山色在，重重依舊上高臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 26
    },
    {
        "title": "東归題屋壁",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "塵埃归去五湖東，還是衡門一畝宮。舊业旋從征賦失，",
            "見说武王天上夢，无情曾与傅岩通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 27
    },
    {
        "title": "寓題",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "酒壺棋局似闲人，竹笏藍衫老此身。托客買书重得卷，",
            "見说天池波浪闊，也應涓滴濺窮鱗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 28
    },
    {
        "title": "偶題",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "閑補亡书見廢興，偶然前古也填膺。秦宮犹自拜张祿，",
            "燕台財力知多少，谁築黃金到九層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 29
    },
    {
        "title": "寓題述懷",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "大道真风早晚還，妖訛成俗汙乾坤。宣尼既沒蘇张起，",
            "堯廷忘卻征元凱，天闕重關十二門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 30
    },
    {
        "title": "将入城靈口道中作",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "路上長安惟咫尺，灞陵西望接秦源。依稀日下分天闕，",
            "高风九万程途近，与報滄洲欲化鯤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 31
    },
    {
        "title": "新屋",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "耳顺何為土木勤，叔孫牆屋有前闻。縱然一世如紅葉，",
            "清甜数尺沙泉井，平与鄰家晝夜分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 32
    },
    {
        "title": "新葺茆堂",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "剪竹誅茆就水濱，靜中還得保天真。只闻神鬼害盈滿，",
            "階前一片泓澄水，借与汀禽活紫鱗。",
            "耨水耕山息故林，壯图嘉話負前心。素絲鬢上分愁色，",
            "同年二十八君子，游楚游秦斷好音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 33
    },
    {
        "title": "茆亭",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "鴛瓦虹梁计已疏，織茅編竹稱貧居。剪平恰似山僧笠，",
            "重門公子應相笑，四壁风霜老讀书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 34
    },
    {
        "title": "客廳",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "移卻松筠致客堂，淨泥環堵貯荷香。衡茅只要免风雨，",
            "燕台漢閣王侯事，青史千年播耿光。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 35
    },
    {
        "title": "詠写真",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "写得衰容似十全，閑開僧舍靜时懸。瘦于南國從军日，",
            "借将前輩真仪比，未愧金鑾李謫仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 36
    },
    {
        "title": "放榜日",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "喧喧車馬欲朝天，人探東堂榜已懸。万里便隨金鸑鷟，",
            "十二街前樓閣上，捲簾谁不看神仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 37
    },
    {
        "title": "曲江宴日呈諸同年",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "鷦鷯驚与鳳凰同，忽向中興遇至公。金榜連名升碧落，",
            "好是慈恩題瞭望，白雲飛盡塔連空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 38
    },
    {
        "title": "渤海賓貢高元固先輩閩中相訪雲本國人…屏障因而有贈",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "折桂何年下月中，閩山來问我雕蟲。肯銷金翠书屏上，",
            "嗟嗟大國金門士，幾個人能振素风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 39
    },
    {
        "title": "偶吟",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "千卷長书万首诗，朝蒸藜藿暮烹葵。清时名立難皆我，",
            "尋常抖擻懷中策，可便降他两鬢絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 40
    },
    {
        "title": "贈表弟黃校书輅",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "產破身窮為學儒，我家諸表愛诗书。嚴陵雖说臨溪隱，",
            "閑來共話无生理，今古悠悠事總虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 41
    },
    {
        "title": "輦下贈屯田何員外",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "封章频得帝咨嗟，報國唯将直破邪。身到西山书幾達，",
            "內翰好才兼好古，秋來應数到君家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 42
    },
    {
        "title": "贈月君",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "出水蓮花比性靈，三生塵夢一时醒。神傳尊勝陀羅咒，",
            "鳴梭軋軋纖纖手，窗戶流光織女星。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 43
    },
    {
        "title": "贈垂光同年",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "丹桂攀來十七春，如今始見茜袍新。須知紅杏園中客，",
            "他时黃閣朝元处，莫忘同年射策人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 44
    },
    {
        "title": "贈楊著",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "藻麗熒煌冠士林，白華榮養有曾參。十年去裏荊門改，",
            "釣魚臺上频相訪，共说長安淚滿襟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 45
    },
    {
        "title": "贈黃校书先輩璞闲居",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "馭得驪龍第四珠，退依僧寺卜貧居。青山入眼不幹祿，",
            "月明掃石吟诗坐，諱卻全无儋石儲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 46
    },
    {
        "title": "尚书榮拜恩命夤疾中輒課惡诗二首以申攀贊",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "明公家鑿鳳凰池，弱冠封侯四海推。富貴有期天授早，",
            "昨日詔书犹漏缺，未言商也最能诗。",
            "東郊迎入紫泥封，此日天仙下九重。三五月明臨闞澤，",
            "借问乘軺何处客，相庭雄幕卷芙蓉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 47
    },
    {
        "title": "府主僕射王摶生日",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "熊羆先兆慶垂休，天地氤氳瑞气浮。李樹影籠周柱史，",
            "勳业定應归鼎鼐，生靈豈独化東甌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 48
    },
    {
        "title": "獻內翰楊侍郎",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "窗開青瑣見瑤台，冷拂星辰逼上臺。丹鳳詔成中使取，",
            "莫擬吟雲避榮貴，廟堂玉鉉待鹽梅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 49
    },
    {
        "title": "送劉常侍",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "懷君何计更留連，忍送文星上碧天。杜預注通三十卷，",
            "他日有书隨雁足，東溪无令訪漁船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 50
    },
    {
        "title": "送盧拾遺归華山",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "紫殿諫多防佞口，清秋假滿別明君。惟憂急詔归青瑣，",
            "門前舊客期相薦，犹望飛书及主文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 51
    },
    {
        "title": "春末送陳先輩之清源",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "貧中惟是長年華，每羨君行自歎嗟。归日捧持明月寶，",
            "千乘侯王若相问，飛书与報白雲家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 52
    },
    {
        "title": "上盧三拾遺以言見黜",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "骨鯁如君道尚存，近來人事不須論。疾危必厭神明药，",
            "因思周廟當时誡，金口三緘示后昆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 53
    },
    {
        "title": "送王校书往清源",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "南國賢侯待德风，長途仍借九花驄。清歌早貫驪龍頷，",
            "吟诗臺上如相问，与说蟠溪直釣翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 54
    },
    {
        "title": "嶽州端午日送人游郴連",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "五月巴陵值積阴，送君千里客於郴。北风吹雨黃梅落，",
            "九嶷雲闊蒼梧暗，与说重華舊德音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 55
    },
    {
        "title": "賀清源太保王延彬",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "蕊珠宮裏謫神仙，八载溫陵万戶閑。心地闊於雲夢澤，",
            "應笑清溪舊門吏，年年扶病掩柴關。",
            "武榮江畔蔭祥雲，寵拜天人慶郡人。五色鶴綾花上敕，",
            "更待春风飛吉语，紫泥分付与陶鈞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 56
    },
    {
        "title": "病中春日即事寄主人尚书二首",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "身比秋荷觉漸枯，致君經國墮前图。層冰照日犹能暖，",
            "庾樓恩化通神圣，何计能教擲得盧。",
            "风拍衰肌久未蠲，破窗频見月團圓。更无舊日同人问，",
            "玄穹若假年齡在，愿捧銅盤為國賢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 57
    },
    {
        "title": "寄華山司空侍郎二首",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "金闕爭權競獻功，独逃征詔臥三峰。雞群未必容於鶴，",
            "风霜落滿千林木，不近青青澗底松。",
            "非雲非鶴不從容，谁敢輕量傲世蹤。紫殿幾征王佐业，",
            "前古負材多為國，滿懷經濟欲何從。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 58
    },
    {
        "title": "寄盧端公同年仁炯，时遷都洛阳，新立幼主",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "上阳宮闕翠華归，百辟傷心序漢仪。昆嶽有炎瓊玉碎，",
            "惆悵宸居遠於日，長籲空摘鬢邊絲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 59
    },
    {
        "title": "寄天臺陳希畋",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "阴山冰凍嘗迎夏，蟄戶雲雷只待春。呂望豈嫌垂釣老，",
            "拍手相思惟大笑，我曹寧比等闲人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 60
    },
    {
        "title": "寄两浙羅书記",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "進即湮沈退卻升，錢塘风月過金陵。鴻才入貢无人换，",
            "怜君道在名長在，不到慈恩最上層。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 61
    },
    {
        "title": "邑宰相訪，翼日有寄",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "淵明深念郤詵貧，踏破莓苔看甑塵。碧沼共攀紅菡萏，",
            "夜半夢醒追複想，欲長攀接有何因。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 62
    },
    {
        "title": "白酒两瓶送崔侍禦",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "雪化霜融好潑醅，滿壺冰凍向春開。求從白石洞中得，",
            "湖邊送与崔夫子，谁見嵇山盡日頹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 63
    },
    {
        "title": "依韵酬常循州",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "早年花縣拜潘郎，尋忝飛鳴出桂堂。日走登天長似箭，",
            "公論一麾将塞詔，且隨征令過瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 64
    },
    {
        "title": "謝主人惠綠酒白魚",
        "author": "徐夤",
        "biography": "",
        "paragraphs": [
            "早起雀聲送喜频，白魚芳酒寄來珍。馨香乍揭春风甕，",
            "不曾垂釣兼親醞，堪愧金台醉飽身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百零九",
        "no#": 65
    }
]