[
    {
        "title": "新政縣",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "新政縣前逢月夜，嘉陵江底看星辰。已闻城上三更鼓，",
            "曾沾幾许名兼利，勞動生涯涉苦辛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 1
    },
    {
        "title": "南昌灘",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "渠江明淨峽逶迤，船到明灘拽zB迟。櫓窡動搖妨作夢，",
            "物色可怜心莫恨，此行都是独行时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 2
    },
    {
        "title": "見樂天诗",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "通州到日日平西，江館无人虎印泥。",
            "忽向破簷残漏处，見君诗在柱心題。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 3
    },
    {
        "title": "夜坐",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "雨滯更愁南瘴毒，月明兼喜北风涼。古城樓影橫空館，",
            "孩提万里何时見，狼藉家书滿臥床。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 4
    },
    {
        "title": "歲日贈拒非",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "君思曲水嗟身老，我望通州感道窮。",
            "同入新年两行淚，白頭翁坐说城中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 6
    },
    {
        "title": "送盧戡",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "紅樹蟬聲滿夕阳，白頭相送倍相傷。老嗟去日光阴促，",
            "紅旗滿眼襄州路，此別淚流千万行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 7
    },
    {
        "title": "雨聲",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "风吹竹葉休還動，雨點荷心暗複明。",
            "曾向西江船上宿，慣闻寒夜滴篷聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 8
    },
    {
        "title": "奉和滎阳公離筵作",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "南郡生徒辭絳帳，東山妓樂擁油旌。",
            "鈞天排比簫韶待，犹顧人間有別情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 9
    },
    {
        "title": "嘉陵水",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "古时應是山頭水，自古流來江路深。",
            "若使江流會人意，也應知我遠來心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 10
    },
    {
        "title": "閬州開元寺壁題樂天诗",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "憶君无计写君诗，写盡千行说向谁。",
            "題在閬州東寺壁，幾时知是見君时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 11
    },
    {
        "title": "凭李忠州寄书樂天",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "万里寄书将出峽，卻凭巫峽寄江州。",
            "傷心最是江頭月，莫把书将上庾樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 12
    },
    {
        "title": "得樂天书",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "遠信入門先有淚，妻驚女哭问何如。",
            "尋常不省曾如此，應是江州司馬书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 13
    },
    {
        "title": "寄樂天",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "无身尚擬魂相就，身在那无夢往還。",
            "直到他生亦相覓，不能空記樹中環。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 14
    },
    {
        "title": "酬知退",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "終須修到无修处，闻盡聲闻始不闻。",
            "莫著妄心銷彼我，我心无我亦无君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 15
    },
    {
        "title": "通州",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "平生欲得山中住，天与通州繞郡山。",
            "睡到日西无一事，月儲三万買教閑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 16
    },
    {
        "title": "酬樂天书后三韵",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "今日廬峰霞繞寺，昔时鸞殿鳳回书。两封相去八年后，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 17
    },
    {
        "title": "相憶淚",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "西江流水到江州，闻道分成九道流。我滴两行相憶淚，",
            "會向伍員潮上見，气充頑石報心仇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 18
    },
    {
        "title": "喜李十一景信到",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "何事相逢翻有淚，念君緣我到通州。",
            "留君剩住君須住，我不自由君自由。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 19
    },
    {
        "title": "与李十一夜飲",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "寒夜燈前賴酒壺，与君相对興犹孤。",
            "忠州刺史應閑臥，江水猿聲睡得无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 20
    },
    {
        "title": "贈李十一",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "淮水連年起戰塵，油旌三换一何频。",
            "共君前后俱從事，羞見功名与別人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 21
    },
    {
        "title": "寒食日",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "今年寒食好风流，此日一家同出遊。",
            "碧水青山无限思，莫将心道是涪州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 22
    },
    {
        "title": "三兄以白角巾寄遺，發不勝冠，因有感歎",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "病瘴年深渾禿盡，那能勝置角頭巾。暗梳蓬發羞臨鏡，",
            "我身四十犹如此，何況吾兄六十身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 23
    },
    {
        "title": "別李十一五絕",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "巴南分与親情別，不料与君床並頭。",
            "為我遠來休悵望，折君災難是通州。",
            "京城每与闲人別，犹自傷心与白頭。",
            "今日別君心更苦，別君緣是在通州。",
            "万里尚能來遠道，一程那忍便分頭。",
            "鳥籠猿檻君應會，十步向前非我州。",
            "來时見我江南岸，今日送君江上頭。",
            "別后料添新夢寐，虎驚蛇伏是通州。",
            "闻君欲去潛銷骨，一夜暗添新白頭。",
            "明朝別后應腸斷，独棹破船归到州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 24
    },
    {
        "title": "酬樂天醉別",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "前回一去五年別，此別又知何日回。",
            "好住樂天休悵望，匹如元不到京來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 25
    },
    {
        "title": "酬樂天雨后見憶",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "雨滑危梁性命愁，差池一步一生休。",
            "黃泉便是通州郡，漸入深泥漸到州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 26
    },
    {
        "title": "和樂天過秘閣书省舊廳",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "闻君西省重徘徊，秘閣书房次第開。壁記欲題三漏合，",
            "司馬見诗心最苦，滿身蚊蚋哭煙埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 27
    },
    {
        "title": "和樂天贈楊秘书",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "舊与楊郎在帝城，搜天斡地覓诗情。曾因並句甘稱小，",
            "因君投贈還相和，老去那能競底名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 28
    },
    {
        "title": "和樂天題王家亭子",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "风吹筍籜飄紅砌，雨打桐花盡綠莎。",
            "都大資人无暇日，泛池全少買池多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 29
    },
    {
        "title": "酬樂天频夢微之",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "山水万重书斷絕，念君怜我夢相闻。",
            "我今因病魂顛倒，唯夢闲人不夢君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 30
    },
    {
        "title": "琵琶",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "學语胡兒撼玉玲，甘州破裏最星星。",
            "使君自恨常多事，不得工夫夜夜聽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 31
    },
    {
        "title": "春詞",
        "author": "元稹",
        "biography": "",
        "paragraphs": [
            "山翠湖光似欲流，蜂聲鳥思卻堪愁。",
            "西施顏色今何在，但看春风百草頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷四百一十五",
        "no#": 32
    }
]