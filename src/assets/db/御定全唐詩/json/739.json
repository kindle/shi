[
    {
        "title": "中酒寄劉行军",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "甚矣频频醉，神昏體亦虛。肺傷徒问药，發落不盈梳。",
            "戀寢嫌明室，修生愧道书。西峰老僧语，相勸合何如。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 1
    },
    {
        "title": "白雁",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "東溪一白雁，毛羽何皎潔。薄暮浴清波，斜阳共明滅。",
            "差池失群久，幽独依人切。旅食賴菰蒲，單棲怯霜雪。",
            "邊风昨夜起，顧影空哀咽。不及牆上烏，相将繞雙闕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 2
    },
    {
        "title": "早春寄懷",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "家山归未得，又是看春過。老觉光阴速，閑悲世路多。",
            "风和吹岸柳，雪盡見庭莎。欲向東溪醉，狂眠一放歌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 3
    },
    {
        "title": "春日東山正堂作",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "身閑贏得出，天气漸暄和。蜀馬登山穩，南朝古寺多。",
            "早花微弄色，新酒欲生波。從此唯行樂，闲愁奈我何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 4
    },
    {
        "title": "春日小園晨看兼招同舍",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "最有杏花繁，枝枝若手摶。須知一春促，莫厭百回看。",
            "鳥囀风潛息，蜂迟露未幹。可容排飲否，兼折贈頭冠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 5
    },
    {
        "title": "惜花寄孫員外",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "朝始一枝開，暮複一枝落。只恐雨淋漓，又見春蕭索。",
            "侵晨結駟攜酒徒，尋芳踏盡長安衢。思量少壯不自樂，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 6
    },
    {
        "title": "春日病中",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "才得归閑去，還教病臥频。无由全勝意，終是負青春。",
            "綠柳漸拂地，黃鶯如喚人。方為醫者勸，斷酒已經旬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 7
    },
    {
        "title": "毆妓",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "自為專房甚，匆匆有所傷。當时心已悔，徹夜手犹香。",
            "恨枕堆雲髻，啼襟搵月黃。起來犹忍惡，剪破繡鴛鴦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 8
    },
    {
        "title": "踏青樽前",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "期君速行樂，不要旋還家。永日雖无雨，東风自落花。",
            "诗毫粘酒淡，歌袖向人斜。薄暮忘归路，垂楊噪乱鴉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 9
    },
    {
        "title": "正月晦日",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "莫倦尋春去，都无百日遊。更堪正月過，已是一分休。",
            "泉暖聲才出，雲寒勢未收。晚來重作雪，翻為杏花愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 10
    },
    {
        "title": "惜花",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "白发今如此，紅芳莫更催。預愁多日謝，翻怕十分開。",
            "點滴无时雨，荒涼滿地苔。閑階一杯酒，惟待故人來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 11
    },
    {
        "title": "金谷園落花",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "愁見清明后，紛紛蓋地紅。惜看難過日，自落不因风。",
            "蝶散餘香在，鶯啼半樹空。堪悲一尊酒，從此似西東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 12
    },
    {
        "title": "柳花寄宋明府",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "每愛江城裏，青春向盡时。一回新雨歇，是处好风吹。",
            "破石黏蟲網，高樓撲酒旗。遙知陶令宅，五樹正離披。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 13
    },
    {
        "title": "送人",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "相見未逾月，堪悲遠別離。非君谁顧我，万里又南之。",
            "雨逼清明日，花阴杜宇时。愁看掛帆处，鸥鳥共迟迟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 14
    },
    {
        "title": "闲遊",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "攜酒複攜觴，朝朝一似忙。馬諳频到路，僧借舊眠床。",
            "道勝他图薄，身閑白日長。扁舟動归思，高处見滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 15
    },
    {
        "title": "柏梁隔句韵诗",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "不喜長亭柳，枝枝擬送君。惟怜北窗□，樹樹解留人。",
            "圓缺都如月，東西只似雲。愁看離席散，归蓋動行塵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 16
    },
    {
        "title": "贈趙學士",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "常欽趙夫子，遠作五侯賓。見面到今日，操心如古人。",
            "醉同華席少，吟訪野僧频。寂寂長河畔，荒齋与廟鄰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 17
    },
    {
        "title": "春阴",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "老雨不肯休，東风勢還作。未放草蒙茸，已遣花蕭索。",
            "浮生何苦勞，觸事妨行樂。寄语達生人，須知酒勝药。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 18
    },
    {
        "title": "春日金谷園",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "火急召親賓，歡游莫厭频。日長徒似歲，花過即非春。",
            "晚雨來何定，東风自不勻。須知三個月，不是負芳晨。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 19
    },
    {
        "title": "夏日酬祥松二公見訪",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "多謝空門客，时时出草堂。從容非有約，淡薄不相忘。",
            "池映春篁老，簷垂夏果香。西峰正清霽，自与拂吟床。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 20
    },
    {
        "title": "懷贈操禪師",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "嘗憶曹溪子，龕居面碧嵩。杉松新夏后，雨雹夜禪中。",
            "道匪因經悟，心能向物空。秋來得音信，又在剡山東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 21
    },
    {
        "title": "闲居秋思呈祥松二公",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "秋光雖即好，客思轉悠哉。去國身将老，流年雁又來。",
            "葉紅堆晚徑，菊冷藉空罍。不得師相訪，難将道自開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 22
    },
    {
        "title": "賦得冬日青溪草堂四十字",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "莫道无幽致，常來到日西。地雖當北闕，天与設東溪。",
            "疏葦寒多折，驚鳧去不齊。坐中皆作者，長愛覓分題。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 23
    },
    {
        "title": "溪齋",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "水木繞吾廬，搴簾晚檻虛。衰條寒露鵲，幽果落驚魚。",
            "愛酒貧還甚，趨时老更疏。乖慵自有素，不是忽簪裾。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 24
    },
    {
        "title": "留題愛敬寺",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "野性竟未改，何以居朝廷。空為百官首，但愛千峰青。",
            "南风新雨后，与客攜觴行。斜阳惜归去，万壑啼鳥聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 25
    },
    {
        "title": "小園",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "小園吾所好，栽植忘勞形。晚果經秋赤，寒蔬近社青。",
            "竹蘿荒引蔓，土井淺生萍。更欲從人勸，凭高置草亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 26
    },
    {
        "title": "宿山房",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "石窗燈欲盡，松檻月還明。就枕渾无睡，披衣卻出行。",
            "岩高泉乱滴，林動鳥时驚。倏忽山鐘曙，喧喧僕馬聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 27
    },
    {
        "title": "金陵所居青溪草堂閑興",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "窗外皆連水，杉松欲作林。自怜趨競地，独有愛闲心。",
            "素壁題看遍，危冠醉不簪。江僧暮相訪，簾卷見秋岑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 28
    },
    {
        "title": "闕下偶书寄孫員外",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "長安驅馳地，貴賤共悠悠。白日谁相促，勞生自不休。",
            "鳳翔雙闕曉，蟬噪六街秋。独有南宮客，时來話釣舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 29
    },
    {
        "title": "寄魏郎中",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "碌碌但隨群，蒿蘭任不分。未嘗矜有道，求遇向吾君。",
            "逸駕秋尋寺，長歌醉望雲。高齋紙屏古，塵暗北山文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 30
    },
    {
        "title": "病中书懷寄王二十六",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "落葉滿山州，閑眠病未瘳。窗阴連竹枕，药气染茶甌。",
            "路匪人遮去，官須自覓休。焉宜更羸老，扶杖作公侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 31
    },
    {
        "title": "采菊",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "簇簇竟相鮮，一枝開幾番。味甘資麹糵，香好勝蘭蓀。",
            "古道风搖遠，荒籬露壓繁。盈筐时采得，服餌近知門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 32
    },
    {
        "title": "送王郎中之官吉水",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "南望廬陵郡，山連五嶺長。吾君怜遠俗，從事輟名郎。",
            "移戶多无土，春蠶不滿筐。惟應勞贊画，溪峒況強梁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 33
    },
    {
        "title": "孤雁",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "欲食不敢食，合棲犹未棲。闻风亦驚過，避繳恨飛低。",
            "水闊緣湘困，雲寒過磧迷。悲鳴感人意，不見夜烏啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 34
    },
    {
        "title": "贈送致仕郎中",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "鶴立瘦棱棱，髭長白似銀。衣冠皆古制，气貌異常人。",
            "聽雪添诗思，看山滯酒巡。西峰重归路，唯许野僧親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 35
    },
    {
        "title": "宿友人山居寄司徒相公",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "雨雪正霏霏，令人不憶归。地爐僧坐暖，山枿火聲肥。",
            "隔紙烘茶蕊，移鐺剝芋衣。知君在霄漢，此興得還稀。",
            "郢客相尋夜，荒庭雪灑篙。虛堂看向曙，吟坐共忘勞。",
            "溪凍聲全減，燈寒焰不高。他人莫相笑，未易會吾曹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 36
    },
    {
        "title": "感故府二首",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "戚戚複戚戚，期懷安可釋。百年金石心，中路生死隔。",
            "新墳應草合，舊地空苔色。白日燈熒熒，凝塵滿幾席。",
            "悒悒複悒悒，思君安可及。永日在階前，披衣隨风立。",
            "高樓暮角斷，遠樹寒鴉集。惆悵幾行书，遺蹤墨犹濕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 37
    },
    {
        "title": "田家三首",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "畢歲知无事，兵銷復舊丁。竹門桑徑狹，春日稻畦青。",
            "犬吠隈籬落，雞飛上碓桯。归田起囗思，蛙叫草冥冥。",
            "不识城中路，熙熙樂有年。木盤擎社酒，瓦鼓送神錢。",
            "霜落牛归屋，禾收雀滿田。遙陂過秋水，閑閣釣魚船。",
            "長愛田家事，时时欲一過。垣籬皆樹槿，廳院亦堆禾。",
            "病果因风落，寒蔬向日多。遙闻数聲笛，牛晚下前坡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 38
    },
    {
        "title": "新竹",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "嫋嫋熏风軟，娟娟湛露光。參差仙子仗，迤邐羽林槍。",
            "迥去侵花地，斜來破蘚牆。籜幹犹抱翠，粉膩若塗裝。",
            "徑曲莖難数，阴疏葉未長。懶嫌吟客倚，甘畏夏蟲傷。",
            "映水如爭立，當軒自著行。北亭尊酒興，還為此君狂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 39
    },
    {
        "title": "归燕詞",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "羽翼勢雖微，雲霄亦可期。飛翻自有路，鴻鵠莫相嗤。",
            "待侶臨书幌，尋泥傍藻池。沖人穿柳徑，捕蝶繞花枝。",
            "廣廈來應遍，深宮去不疑。雕梁聲上下，煙浦影參差。",
            "舊地人潛换，新巢雀謾窺。雙雙暮归处，疏雨滿江湄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 40
    },
    {
        "title": "題魏壇二首",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "不遇至真傳道要，曾看真誥亦何為。舊碑經乱沈荒澗，",
            "蕭條夕景空壇畔，朽檜枝斜綠蔓垂。",
            "一尋遺跡到仙鄉，雲鶴沉沉思渺茫。丹井歲深生草木，",
            "薄暮欲归仍佇立，菖蒲风起水泱泱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 41
    },
    {
        "title": "東樓看雪",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "一上高樓醉複醒，日西江雪更冥冥。化风吹火全无气，",
            "因思舊隱匡廬日，閑看杉檉掩石扃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 42
    },
    {
        "title": "落花",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "惜花无计又花残，独繞芳叢不忍看。暖豔動隨鶯翅落，",
            "忍把一尊重命樂，送春招客亦何歡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 43
    },
    {
        "title": "春雪",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "南國春寒朔气回，霏霏還阻百花開。全移暖律何方去，",
            "不知金勒谁家子，只待晴明賞帝台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 44
    },
    {
        "title": "重戲和春雪寄沈員外",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "谁道江南要雪難，半春犹得倚樓看。卻遮迟日偷鶯暖，",
            "和來瓊什雖无敵，且是儂家比興残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 45
    },
    {
        "title": "春日尊前示從事",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "州中案牘魚鱗密，界上军书竹節稠。眼底好花渾似雪，",
            "最觉此春无气味，不如庭草解忘憂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 46
    },
    {
        "title": "尊前",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "官為将相複何求，世路多端早合休。漸老更知春可惜，",
            "莫厭百壺相勸倒，免教无事結闲愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 47
    },
    {
        "title": "薔薇二首",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "万蕊爭開照檻光，诗家何物可相方。錦江风撼雲霞碎，",
            "彩箋蠻榼旬休日，欲召親賓看一場。",
            "拂簷拖地对前墀，蝶影蜂聲爛熳时。万倍馨香勝玉蕊，",
            "将並舞腰谁得及，惹衣傷手盡從伊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 48
    },
    {
        "title": "残牡丹",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "腸斷題诗如執別，芳茵愁更繞闌鋪。风飄金蕊看全落，",
            "回看池館春休也，又是迢迢看画图。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 49
    },
    {
        "title": "春雨二首",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "春霖未免妨遊賞，唯到诗家自有情。花徑不通新草合，",
            "閑憶昔年為客处，悶留山館阻行行。",
            "蕭蕭春雨密還疏，景象三时固不如，寒入遠林鶯翅重，",
            "唯稱乖慵多睡者，掩門中酒覽闲书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 50
    },
    {
        "title": "醉中惜花更书与諸從事",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "公退尋芳已是迟，莫因他事更來稀。未經旬日唯憂落，",
            "高樓鼓絕重門閉，長為拋回恨解衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 51
    },
    {
        "title": "和判官喜雨",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "去禱山川尚未還，雲雷尋作遠聲寒。人情便似秋登悅，",
            "須知太守重牆內，心极農夫望处歡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 52
    },
    {
        "title": "離闕下日感恩",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "二年塵冒处中台，喜得南归退不才。即路敢期皇子送，",
            "斜日葦汀凝立处，遠波微颺翠如苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 53
    },
    {
        "title": "細雨遙懷故人",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "江雲未散東风暖，溟蒙正在高樓見。細柳緣堤少過人，",
            "昨夜南窗不得眠，閑階點滴回燈坐。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 54
    },
    {
        "title": "春水",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "万派爭流雨過时，晚來春靜更逶迤。輕鸥散繞夫差國，",
            "风鬟倚楫谁家子，愁看鴛鴦望所之。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 55
    },
    {
        "title": "蝶",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "粉蝶翩翩若有期，南園長是到春归。閑依柳帶參差起，",
            "晚來欲雨東风急，回看池塘影漸稀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 56
    },
    {
        "title": "中春写懷寄沈彬員外",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "省從騎竹學謳吟，便殢光阴役此心。寓目不能閑一日，",
            "唯有故人同此興，近來何事懶相尋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 57
    },
    {
        "title": "鐘山寺避暑勉二三子",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "樓臺雖少景何深，滿地青苔勝布金。松影晚留僧共坐，",
            "長愛寄吟經案上，石窗秋霽向千岑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 58
    },
    {
        "title": "道林寺",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "雖向鐘峰数寺連，就中奇勝出其間。不教幽樹妨閑地，",
            "无因得結香燈社，空向王門玷玉班。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 59
    },
    {
        "title": "和致仕沈郎中",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "欲謀休退尚因循，且向東溪種白蘋。謬應星辰居四輔，",
            "残照晚庭沈醉醒，靜吟斜倚老松身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 60
    },
    {
        "title": "醉中詠梅花",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "十月清霜尚未寒，雪英重疊已如摶。還悲独詠東園裏，",
            "交親罕至長安遠，一醉如泥豈自歡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 61
    },
    {
        "title": "閑出书懷",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "闲遊何用问東西，寓興皆非有所期。斷酒只攜僧共去，",
            "應有交親長笑我，独輕人事鬢将衰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 62
    },
    {
        "title": "寺居陸处士相訪，感懷卻寄二三友人",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "湘寺闲居亦半年，就中昨夜好潸然。人归遠岫疏鐘后，",
            "爐煙向冷孤燈下，唯有寒吟到曙天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 63
    },
    {
        "title": "春雪",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "隨风竟日勢漫漫，特地繁於故歲看。幽榭凍黏花屋重，",
            "莫道便為桑麥药，亦勝焦涸到春残。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 64
    },
    {
        "title": "惜花",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "淡淡西園日又垂，一尊何忍負芳枝。莫言风雨長相促，",
            "年年使我成狂叟，腸斷紅箋幾首诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 65
    },
    {
        "title": "梅花寄所親",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "一气才新物未知，每慚青律与先吹。雪霜迷素犹嫌早，",
            "老夫多病无风味，只向尊前詠舊诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 66
    },
    {
        "title": "登升元閣",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "登高始觉太虛寬，白雪須知唱和難。雲渡瑣窗金榜濕，",
            "唯有上層人未到，金烏飛過拂闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 67
    },
    {
        "title": "雪有作",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "霏霏奕奕滿寒空，況是難逢值臘中。未白已堪张宴會，",
            "長愛清華入诗句，預愁迟日放消融。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 68
    },
    {
        "title": "宮詞",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "自遠凝旒守上阳，舞衣頓減舊朝香。簾垂粉閣春将盡，",
            "君王一去不回駕，皓齒青蛾空斷腸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 69
    },
    {
        "title": "晚春送牡丹",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "攜觴邀客繞朱闌，腸斷残春送牡丹。风雨数來留不得，",
            "借问少年能幾许，不许推酒厭杯盤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 70
    },
    {
        "title": "歲暮晚泊，望廬山不見，因懷嶽僧呈察判",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "貪程只為看廬阜，及到停舟恨頗濃。雲暗半空藏万仞，",
            "長愧昔年招我入，共尋香社見芙蓉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 71
    },
    {
        "title": "重台蓮",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "斜倚秋风絕比倫，千英和露染難勻。自為祥瑞生南國，",
            "怜伊不算多时立，贏得馨香暗上身。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 72
    },
    {
        "title": "迎神",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "攂蠻鼉，吟塞笛，女巫結束分行立。空中再拜神且來，",
            "与君降福為豐年，莫教賽祀虧常筵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 73
    },
    {
        "title": "春詞",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "日高闲步下堂階，細草春莎沒繡鞋。",
            "折得玫瑰花一朵，凭君簪向鳳凰釵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 74
    },
    {
        "title": "独夜作",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "佳人一去无消息，夢觉香残愁複入。",
            "空庭悄悄月如霜，独倚闌幹伴花立。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 75
    },
    {
        "title": "竹",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "瓊節高吹宿鳳枝，风流交我立忘归。",
            "最怜瑟瑟斜阳下，花影相和滿客衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 76
    },
    {
        "title": "清明日",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "他皆攜酒尋芳去，我独關門好靜眠。",
            "唯有楊花似相覓，因风时複到床前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 77
    },
    {
        "title": "宮詞",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "宮門長閉舞衣閑，略识君王鬢便斑。",
            "卻羨落花春不管，禦溝流得到人間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 78
    },
    {
        "title": "送喻煉師归茅山",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "休糧知幾载，臉色似桃紅。半醉離城去，單衣行雪中。",
            "水聲茅洞曉，雲影石房空。莫學秦时客，音书便不通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 79
    },
    {
        "title": "和元宗元日大雪登樓",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "紛紛忽降當元會，著物輕明似月華。狂灑玉墀初散絮，",
            "甯意傳來中使出，禦題先賜老僧家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 80
    },
    {
        "title": "遊棲霞寺",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "養花天气近平分，瘦馬來敲白下門。曉色未開山意遠，",
            "此地幾經人聚散，只今王謝独名存。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 81
    },
    {
        "title": "答湯悅",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "司空犹不作，那敢作司徒。幸有山翁號，如何不見呼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 82
    },
    {
        "title": "金山",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "不嗟白发曾遊此，不歎征帆无了期。",
            "盡日凭闌谁會我，只悲不見韓垂诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 83
    },
    {
        "title": "送李冠",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "勻如春澗長流水，怨似秋枝欲斷蟬。",
            "可惜人間容易聽，清聲不到禦樓前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷七百三十九",
        "no#": 84
    },
    {
        "title": "游宋興寺東岩",
        "author": "李建勳",
        "biography": "",
        "paragraphs": [
            "幾年不到東岩下，舊住僧亡屋亦无。",
            "寒日蕭條何物在，朽松經燒石池枯。"
        ],
        "notes": [
