[
    {
        "title": "剡溪行卻寄新別者",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "潺湲寒溪上，自此成離別。回首望归人，移舟逢暮雪。",
            "频行识草樹，漸老傷年發。唯有白雲心，為向東山月。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 1
    },
    {
        "title": "九日陪劉中丞宴昌樂寺送梁廷評",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "独坐三台妙，重阳百越間。水心觀遠俗，霜气入秋山。",
            "不棄遺簪舊，寧辭落帽還。仍闻西上客，咫尺謁天顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 2
    },
    {
        "title": "經故賀賓客鏡湖道士觀",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "已得归鄉里，逍遙一外臣。那隨流水去，不待鏡湖春。",
            "雪裏登山屐，林間漉酒巾。空餘道士觀，谁是學仙人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 3
    },
    {
        "title": "送著公归越",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "谁能愁此別，到越會相逢。長憶雲門寺，門前千万峰。",
            "石床埋積雪，山路倒枯松。莫學白道士，无人知去蹤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 4
    },
    {
        "title": "秣陵送客入京",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "秣陵春已至，君去學归鴻。綠水琴聲切，青袍草色同。",
            "鳥喧金谷樹，花滿洛阳宮。日日相思处，江邊楊柳风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 5
    },
    {
        "title": "靈門寺贈靈一上人",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "所思勞旦夕，惆悵去湘東。禪客知何在，春山幾处同。",
            "独行残雪裏，相見暮雲中。請住東林寺，彌年事遠公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 6
    },
    {
        "title": "江上送別",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "浦邊新見柳搖时，北客相逢只自悲。惆悵空知思后會，",
            "向夕孤城分首处，寂寥橫笛為君吹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 7
    },
    {
        "title": "归桐廬舊居寄嚴長史",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "昨辭天子棹归舟，家在桐廬憶舊丘。三月暖时花競發，",
            "或在醉中逢夜雪，懷賢應向剡川遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 8
    },
    {
        "title": "竹",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "青林何森然，沉沉独曙前。出牆同淅瀝，開戶滿嬋娟。",
            "籜卷初呈粉，苔侵乱上錢。疏中思水過，深处若山連。",
            "疊夜常棲露，清朝乍有蟬。砌阴迎緩策，簷翠对欹眠。",
            "迸筍雙分箭，繁梢一向偏。月過驚散雪，风動极闻泉。",
            "幽谷添诗譜，高人欲制篇。蕭蕭意何恨，不独往湘川。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 9
    },
    {
        "title": "銅雀妓",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "恨唱歌聲咽，愁翻舞袖迟。西陵日欲暮，是妾斷腸时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 10
    },
    {
        "title": "毗陵留別",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "別離非一处，此处最傷情。白发将春草，相隨日日生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 11
    },
    {
        "title": "題竹林寺",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "歲月人間促，煙霞此地多。殷勤竹林寺，能得幾回過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 12
    },
    {
        "title": "答陸澧",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "松葉堪為酒，春來釀幾多。不辭山路遠，踏雪也相過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 13
    },
    {
        "title": "楊子津送人",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "今朝楊子津，忽見五溪人。老病无餘事，丹砂乞五斤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 14
    },
    {
        "title": "山中謁皇甫曾",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "尋源路已盡，笑入白雲間。不解乘軺客，那知有此山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 15
    },
    {
        "title": "剡山夜月",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "月在沃洲山上，人归剡縣溪邊。",
            "漠漠黃花覆水，时时白鹭驚船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 16
    },
    {
        "title": "九日与楊凝、崔淑期登江上山會有故不得往因贈之",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "欲從攜手登高去，一到門前意已无。",
            "那得更将頭上發，學他年少插茱萸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 17
    },
    {
        "title": "山中聽子規",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "幽人自愛山中宿，又近葛洪丹井西。",
            "窗中有個長松樹，半夜子規來上啼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 18
    },
    {
        "title": "乱后經淮阴岸",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "荒村古岸谁家在，野水浮雲处处愁。",
            "唯有河邊衰柳樹，蟬聲相送到揚州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 19
    },
    {
        "title": "送张山人",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "知君住处足风煙，古寺荒村在眼前。",
            "便欲移家逐君去，唯愁未有買山錢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 20
    },
    {
        "title": "別李季蘭",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "古岸新花開一枝，岸傍花下有分離。",
            "莫将羅袖拂花落，便是行人腸斷时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 21
    },
    {
        "title": "游石澗寺",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "闻道幽深石澗寺，不逢流水亦難知。",
            "莫道山僧无伴侶，獼猴長在古松枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 22
    },
    {
        "title": "新安所居答相訪人所居蕭使君為制",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "謝公見我多愁疾，為我開門对碧山。",
            "君若欲來看猿鳥，不須爭把桂枝攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 23
    },
    {
        "title": "送魏校书",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "長恨江南足別離，幾回相送複相隨。",
            "楊花撩乱撲流水，愁殺人行知不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 24
    },
    {
        "title": "送溫台",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "眇眇天涯君去时，浮雲流水自相隨。",
            "人生一世長如客，何必今朝是別離。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 25
    },
    {
        "title": "句",
        "author": "朱放",
        "biography": "",
        "paragraphs": [
            "愛彼雲外人，求取澗底泉。",
            "风吹芭蕉拆，鳥啄梧桐落。。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百一十五",
        "no#": 26
    }
]