[
    {
        "title": "雨后思湖上居",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "前山风雨涼，歇馬坐垂楊。何处芙蓉落，南渠秋水香。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 1
    },
    {
        "title": "闻歌",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "新秋弦管清，时轉遏雲聲。曲盡不知处，月高风滿城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 2
    },
    {
        "title": "思天臺",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "赤城雲雪深，山客負归心。昨夜西齋宿，月明琪樹阴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 3
    },
    {
        "title": "長安早春懷江南",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雲月有归处，故山清洛南。如何一花發，春夢遍江潭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 4
    },
    {
        "title": "塞下",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "夜戰桑幹北，秦兵半不归。朝來有鄉信，犹自寄征衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 5
    },
    {
        "title": "送客南归",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "野寺薜蘿晚，官渠楊柳春。归心已无限，更送洞庭人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 6
    },
    {
        "title": "寄桐江隱者",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "潮去潮來洲渚春，山花如繡草如茵。",
            "嚴陵台下桐江水，解釣鱸魚能幾人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 7
    },
    {
        "title": "送曾主簿归楚州省覲，予亦明日归姑孰",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "帆轉清淮极鳥飛，落帆應换老萊衣。",
            "河亭未醉先惆悵，明日還從此路归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 8
    },
    {
        "title": "重別",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "淚沿紅粉濕羅巾，重系蘭舟勸酒频。",
            "留卻一枝河畔柳，明朝犹有遠行人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 9
    },
    {
        "title": "湖上",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "仿佛欲當三五夕，万蟬清雜乱泉紋。",
            "釣魚船上一尊酒，月出渡頭零落雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 10
    },
    {
        "title": "夜泊永樂有懷",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "蓮渚愁紅蕩碧波，吳娃齊唱採蓮歌。",
            "橫塘一別已千里，蘆葦蕭蕭风雨多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 11
    },
    {
        "title": "宿水閣",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "野客從來不解愁，等闲乘月海西頭。",
            "未知南陌谁家子，夜半吹笙入水樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 12
    },
    {
        "title": "謝亭送別",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "勞歌一曲解行舟，紅葉青山水急流。",
            "日暮酒醒人已遠，滿天风雨下西樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 13
    },
    {
        "title": "酬李當",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "知有瑤華手自開，巴人虛唱懶封回。",
            "山阴一夜滿溪雪，借问扁舟來不來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 14
    },
    {
        "title": "蟬",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "噪柳鳴槐晚未休，不知何事愛悲秋。",
            "朱門大有長吟处，剛傍愁人又送愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 15
    },
    {
        "title": "夜過松江渡寄友人",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "清露白雲明月天，与君齊棹木蘭船。",
            "南湖风雨一相失，夜泊橫塘心渺然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 16
    },
    {
        "title": "守风淮阴",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "遙見江阴夜漁客，因思京口釣魚时。",
            "一潭明月万株柳，自去自來人不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 17
    },
    {
        "title": "亡題",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "商嶺采芝尋四老，紫阳收朮訪三茅。",
            "欲求不死長生訣，骨裏无仙不肯教。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 18
    },
    {
        "title": "送楊發東归",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "紅花半落燕於飛，同客長安今独归。",
            "一紙鄉书報兄弟，還家羞著別时衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 19
    },
    {
        "title": "寄宋邧",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "朱檻煙霜夜坐勞，美人南國舊同袍。",
            "山長水遠无消息，瑤瑟一彈秋月高。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 20
    },
    {
        "title": "題四老廟二首",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "峨峨商嶺采芝人，雪頂霜髯虎豹茵。",
            "山酒一卮歌一曲，漢家天子忌功臣。",
            "避秦安漢出藍關，松桂花阴滿舊山。",
            "自是无人有归意，白雲常在水潺潺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 21
    },
    {
        "title": "夏日寄江上親友",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "雨過前山日未斜，清蟬嘒嘒落槐花。",
            "車輪南北已无限，江上故人才到家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 22
    },
    {
        "title": "下第懷友人",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "独掩衡門花盛时，一封书信緩归期。",
            "南宗更有瀟湘客，夜夜月明闻竹枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 23
    },
    {
        "title": "客有卜居不遂薄遊汧隴因題",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "海燕西飛白日斜，天門遙望五侯家。",
            "樓臺深鎖无人到，落盡春风第一花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 24
    },
    {
        "title": "陳宮怨二首",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "风暖江城白日迟，昔人遺事后人悲。",
            "草生宮闕國无主，玉樹后庭花為谁。",
            "地雄山險水悠悠，不信隋兵到石頭。",
            "玉樹后庭花一曲，与君同上景阳樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 25
    },
    {
        "title": "經故太尉段公廟",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "靜想追兵緩翠華，古碑荒廟閉松花。",
            "紀生不向滎阳死，爭有山河屬漢家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 26
    },
    {
        "title": "途經秦始皇墓",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "龍盤虎踞樹層層，勢入浮雲亦是崩。",
            "一種青山秋草裏，路人唯拜漢文陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 27
    },
    {
        "title": "遊楞伽寺",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "碧煙秋寺泛潮來，水浸城根古堞摧。",
            "盡日傷心人不見，石榴花滿舊琴台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 28
    },
    {
        "title": "緱山廟",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "王子吹簫月滿台，玉簫清轉鶴裴回。",
            "曲終飛去不知处，山下碧桃春自開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 29
    },
    {
        "title": "送薛先輩入關",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "一卮春酒送離歌，花落敬亭芳草多。",
            "欲问归期已深醉，只應孤夢繞關河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 30
    },
    {
        "title": "鴻溝",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "相持未定各為君，秦政山河此地分。",
            "力盡烏江千载后，古溝芳草起寒雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 31
    },
    {
        "title": "韓信廟",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "朝言雲夢暮南巡，已為功名少退身。",
            "盡握兵權犹不得，更将心计托何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 32
    },
    {
        "title": "過湘妃廟",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "古木蒼山掩翠娥，月明南浦起微波。",
            "九疑望斷幾千载，斑竹淚痕今更多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 33
    },
    {
        "title": "寄雲際寺敬上人",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "万山秋雨水縈回，紅葉多從紫閣來。",
            "雲冷竹齋禪衲薄，已應飛錫過天臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 34
    },
    {
        "title": "秋思",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "琪樹西风枕簟秋，楚雲湘水憶同遊。",
            "高歌一曲掩明鏡，昨日少年今白頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 35
    },
    {
        "title": "送宋处士归山",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "賣药修琴归去迟，山风吹盡桂花枝。",
            "世間甲子須臾事，逢著仙人莫看棋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 36
    },
    {
        "title": "聽琵琶",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "欲写明妃万里情，紫槽紅撥夜丁丁。",
            "胡沙望盡漢宮遠，月落天山闻一聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 37
    },
    {
        "title": "秦樓曲",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "秦女夢餘仙路遙，月窗风簟夜迢迢。",
            "潘郎翠鳳雙飛去，三十六宮闻玉簫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 38
    },
    {
        "title": "旌儒廟",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "寒陌阴风万古悲，儒冠相枕死秦时。",
            "廟前亦有商山路，不學老翁歌紫芝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 39
    },
    {
        "title": "覽故人題僧院诗",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "高閣清吟寄遠公，四时雲月一篇中。",
            "今來借问独何处，日暮槿花零落风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 40
    },
    {
        "title": "楚宮怨二首",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "十二山晴花盡開，楚宮雙闕对阳臺。",
            "細腰爭舞君沉醉，白日秦兵天上來。",
            "獵騎秋來在內稀，渚宮雲雨濕龍衣。",
            "騰騰戰鼓動城闕，江畔射麋殊未归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 41
    },
    {
        "title": "聽唱山鷓鴣",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "金谷歌傳第一流，鷓鴣清怨碧煙愁。",
            "夜來省得曾闻处，万里月明湘水秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 42
    },
    {
        "title": "晨起西樓",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "留情深处駐橫波，斂翠凝紅一曲歌。",
            "明月下樓人未散，共愁三徑是天河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 43
    },
    {
        "title": "酬江西盧端公藍口阻风見寄之什",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "又攜刀筆泛膺舟，藍口风高桂楫留。",
            "還似郢中歌一曲，夜來春雪照西樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 44
    },
    {
        "title": "贈何处士",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "東別茅峰北去秦，梅仙书裏说真人。",
            "白頭主印青山下，雖遇唐生不敢親。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 45
    },
    {
        "title": "鹭鷥",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "西风澹澹水悠悠，雪點絲飄帶雨愁。",
            "何限归心倚前合，綠蒲紅蓼練塘秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 46
    },
    {
        "title": "學仙二首",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "漢武迎仙紫禁秋，玉笙瑤瑟祀昆丘。",
            "年年望斷无消息，空閉重城十二樓。",
            "心期仙訣意无窮，采画雲車起壽宮。",
            "闻有三山未知处，茂陵松柏滿西风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 47
    },
    {
        "title": "酬康州韋侍禦同年",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "桂楫美人歌木蘭，西风嫋嫋露漙漙。夜長曲盡意不盡，月在清湘洲渚寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 48
    },
    {
        "title": "紫藤",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "綠蔓穠阴紫袖低，客來留坐小堂西。",
            "醉中掩瑟无人會，家近江南罨画溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 49
    },
    {
        "title": "宿咸宜觀",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "羽袖飄飄杳夜风，翠幢归殿玉壇空。",
            "步虛聲盡天未曉，露壓桃花月滿宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 50
    },
    {
        "title": "金谷園",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "三惑沉身是此園，古藤荒草野禽喧。",
            "二十四友一朝盡，愛妾墜樓何足言。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 51
    },
    {
        "title": "送崔珦入朝",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "书劍功迟白发新，強登蕭寺送归秦。",
            "月斜松桂倚高閣，明夜江南江北人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 52
    },
    {
        "title": "病中和大夫玩江月",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "江上懸光海上生，仙舟迢遞繞军營。",
            "高歌一曲同筵醉，卻是劉楨坐到明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 53
    },
    {
        "title": "讀戾太子傳",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "佞臣巫蠱已相疑，身沒湖邊築望思。",
            "今日更归何处是，年年芳草上臺基。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 54
    },
    {
        "title": "酬对雪見寄",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "飛度龍山下遠空，拂簷縈竹晝濛濛。",
            "知君吟罷意无限，曾聽玉堂歌北风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 55
    },
    {
        "title": "王可封臨終",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "十世為儒少子孫，一生長負信陵恩。",
            "今朝埋骨寒山下，為報慈親休倚門。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 56
    },
    {
        "title": "僧院影堂",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "香銷雲凝舊僧家，僧刹残燈壁半斜。",
            "日暮松煙空漠漠，秋风吹破妙蓮華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 57
    },
    {
        "title": "記夢",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "曉入瑤台露气清，座中唯有许飛瓊。",
            "塵心未盡俗緣在，十裏下山空月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 58
    },
    {
        "title": "三十六灣",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "縹緲臨风思美人，荻花楓葉帶離聲。",
            "夜深吹笛移船去，三十六灣秋月明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 59
    },
    {
        "title": "越中",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "石城花暖鷓鴣飛，征客春帆秋不归。",
            "犹自保郎心似石，綾梭夜夜織寒衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百三十八",
        "no#": 60
    }
]