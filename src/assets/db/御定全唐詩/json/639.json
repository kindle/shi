[
    {
        "title": "興善寺貝多樹",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "還應毫末長，始見拂丹霄。得子從西國，成阴見昔朝。",
            "勢隨雙刹直，寒出四牆遙。帶月啼春鳥，連空噪暝蜩。",
            "遠根穿古井，高頂起涼飆。影動懸燈夜，聲繁過雨朝。",
            "靜迟松桂老，堅任雪霜凋。永共終南在，應隨劫火燒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 1
    },
    {
        "title": "華山",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "青蒼河一隅，气狀杳難图。卓傑三峰出，高奇四嶽无。",
            "力疑擎上界，勢独壓中區。眾水東西走，群山遠近趨。",
            "天回諸宿照，地聳百靈扶。石壁煙霞麗，龍潭雨雹粗。",
            "澄凝臨甸服，險固束神都。淺觉川原異，深應日月殊。",
            "鶴归青靄合，仙去白雲孤。瀑漏斜飛凍，松長倒掛枯。",
            "每來尋洞穴，不擬返江湖。儻有芝田種，岩間老一夫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 2
    },
    {
        "title": "送何道士归山",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "身非絕粒本清羸，束掛仙經杖一枝。落葉独尋流水去，",
            "樵客若能隨洞裏，回归人世始應悲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 3
    },
    {
        "title": "城東寓居寄知己",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "花木閑門苔蘚生，滻川特去得吟情。病來久絕洞庭信，",
            "幹时退出長如此，频愧相憂道姓名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 4
    },
    {
        "title": "再书邊事",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "万里沙西寇已平，犬羊群外築空城。分營夜火燒雲遠，",
            "羌戎不识干戈老，須賀當时圣主明。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 5
    },
    {
        "title": "游邊感懷二首",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "貧游繚繞困邊沙，卻被遼阳戰士嗟。",
            "不是无家归不得，有家归去似无家。",
            "兄弟江南身塞北，雁飛犹自半年餘。",
            "夜來因得思鄉夢，重讀前秋轉海书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 6
    },
    {
        "title": "无題",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "九霄无詔下，何事觸清塵。宅帶松蘿僻，身惟猿鳥親。",
            "吟看仙掌月，期有洞庭人。莫问煙霞句，懸知見嶽神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 7
    },
    {
        "title": "蟬",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "先秋蟬一悲，長是客行时。曾感去年者，又鳴何处枝。",
            "細聽残韵在，回望舊聲迟。斷续谁家樹，涼风送別離。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 8
    },
    {
        "title": "江上逢進士许棠",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "诗人推上第，新榜又无君。鶴發他鄉老，漁歌故國闻。",
            "平江流曉月，独鳥伴餘雲。且了髫年志，沙鸥未可群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 9
    },
    {
        "title": "送河西從事",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "結束佐戎旃，河西住幾年。隴頭隨日去，磧裏寄星眠。",
            "水近沙連帳，程遙馬入天。圣朝思上策，重待奏安邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 10
    },
    {
        "title": "河湟舊卒",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "少年隨将討河湟，頭白时清返故鄉。",
            "十万漢军零落盡，独吹邊曲向残阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 11
    },
    {
        "title": "促織",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "念爾无机自有情，迎寒辛苦弄梭聲。",
            "椒房金屋何曾识，偏向貧家壁下鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 12
    },
    {
        "title": "猿",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "掛月棲雲向楚林，取來全是為清音。",
            "谁知系在黃金索，翻畏侯家不敢吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 13
    },
    {
        "title": "寄薦福寺棲白大師",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "高塔六街无不見，塔邊名出只吾師。",
            "嘗闻朝客多相□，記得□□数句诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 14
    },
    {
        "title": "越中贈別",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "東越相逢幾醉眠，滿樓明月鏡湖邊。",
            "別離吟斷西陵渡，楊柳秋风两岸蟬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 15
    },
    {
        "title": "寄清越上人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "大道本來无所染，白雲那得有心期。",
            "遠公独刻蓮花漏，犹向空山禮六时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 16
    },
    {
        "title": "宿齊山僧舍",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "一宿經窗臥白波，万重归夢隔煙蘿。",
            "若言不得南宗要，長在禪床事更多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 17
    },
    {
        "title": "春日游曲江",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "日暖鴛鴦拍浪春，蒹葭浦際聚青蘋。若論來往鄉心切，須是煙波島上人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 18
    },
    {
        "title": "漁家",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "擁棹思悠悠，更深泛積流。唯将一星火，何处宿蘆洲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 19
    },
    {
        "title": "送人及第归海東",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "東风日邊起，草木一时春。自笑中華路，年年送遠人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 20
    },
    {
        "title": "題河中鸛雀樓",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "高樓懷古動悲歌，鸛雀今无野燕過。樹隔五陵秋色早，",
            "十载重來值搖落，天涯归计欲如何。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 21
    },
    {
        "title": "宿洛都門",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "山川馬上度邊禽，一宿都門永夜吟。",
            "客路不归秋又晚，西风吹動洛阳砧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 22
    },
    {
        "title": "对月二首",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "圓魄上寒空，皆言四海同。安知千裏外，不有雨兼风。",
            "盈缺青冥外，東风万古吹。何人種丹桂，不長出輪枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 23
    },
    {
        "title": "贈友人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "自说安貧归未得，竹邊門掩小池冰。典琴賒酒吟過寺，",
            "幾时獻了相如賦，共向嵩山采茯苓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 24
    },
    {
        "title": "笛",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "剪雨裁煙一節秋，落梅楊柳曲中愁。",
            "尊前暫借殷勤看，明日曾闻向隴頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 25
    },
    {
        "title": "漁者",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "首戴圓荷發不梳，葉舟為宅水為居。",
            "沙頭聚看人如市，釣得澄江一丈魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 26
    },
    {
        "title": "宿潺湲亭",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "走月流煙疊樹西，聽來愁甚聽猿啼。",
            "幾时禦水聲邊住，卻夢潺湲宿此溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 27
    },
    {
        "title": "台城",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "宮殿餘基長草花，景阳宮樹噪村鴉。",
            "雲屯雉堞依然在，空繞漁樵四五家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 28
    },
    {
        "title": "寄山僧",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "閑倚蒲團向日眠，不能归老岳雲邊。",
            "舊时僧侶无人在，惟有長松見少年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 29
    },
    {
        "title": "題上元许棠所任王昌齡廳",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "琉璃堂裏當时客，久絕吟聲繼后塵。",
            "百四十年庭樹老，如今重得見诗人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 30
    },
    {
        "title": "自誚",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "每到花时恨道窮，一生光景半成空。",
            "只應抱璞非良玉，豈得年年不至公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 31
    },
    {
        "title": "贈河南诗友",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "山東令族玉无塵，裁剪煙花筆下春。",
            "不把瑤華借风月，洛阳才子更何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 32
    },
    {
        "title": "寄維揚故人",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "離別河邊綰柳條，千山万水玉人遙。",
            "月明記得相尋处，城鎖東风十五橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 33
    },
    {
        "title": "孤雲",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "舒卷因风何所之，碧天孤影勢迟迟。",
            "莫言長是无心物，還有隨龍作雨时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 34
    },
    {
        "title": "詠棋子贈弈僧",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "黑白谁能用入玄，千回生死體方圓。",
            "空門说得恒沙劫，應笑終年為一先。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 35
    },
    {
        "title": "谷口作",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "巴客青冥過嶺塵，雪崖交映一川春。",
            "晴朝采药尋源去，必恐雲深見異人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 36
    },
    {
        "title": "寄弟",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "故里行人戰后疏，青崖萍寄白雲居。",
            "那堪又是傷春日，把得長安落第书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 37
    },
    {
        "title": "春日有懷",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "高下尋花春景迟，汾阳台榭白雲诗。",
            "看山懷古翻惆悵，未勝遙傳不到时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 38
    },
    {
        "title": "鹭鷥障子",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "剪得机中如雪素，画為江上帶絲禽。",
            "閑來相对茅堂下，引出煙波万里心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 39
    },
    {
        "title": "甘露寺僧房",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "臨水登山路，重尋旅思勞。竹阴行处密，僧臘別來高。",
            "遠岫明寒火，危樓響夜濤。悲秋不成寐，明月上千舠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 40
    },
    {
        "title": "宿江叟島居",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "一家煙島隈，竹裏夜窗開。数派分潮去，千檣聚月來。",
            "石樓雲斷续，澗渚雁徘徊。了得平生志，還归築釣台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 41
    },
    {
        "title": "江村",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "貧遊无定蹤，鄉信轉難逢。寒渚暮煙闊，去帆归思重。",
            "潮平低戌火，木落遠山鐘。況是漁家宿，疏籬響夜舂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 42
    },
    {
        "title": "贈進士顧雲",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "潮檻煙波別釣津，西京同□荻□貧。不知守道归何日，",
            "与君愁寂无消处，賒酒青門送楚人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 43
    },
    {
        "title": "贈頭陀僧",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "自说年深別石橋，遍遊靈跡熟南朝。已知世路皆虛幻，",
            "如今竹院藏衰老，一點寒燈弟子燒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 44
    },
    {
        "title": "尋阳村舍",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "荒林寄遠居，坐臥見樵漁。夜火隨船遠，寒更出郡疏。",
            "雪迷登岳路，风阻轉江书。寂寞高窗下，思鄉歲欲除。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 45
    },
    {
        "title": "江樓作",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "凭檻見天涯，非秋亦可悲。晚天帆去疾，春雪燕來迟。",
            "山水分鄉縣，干戈足別離。南人廢耕織，早晚罷王師。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 46
    },
    {
        "title": "回鸞閣写望",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "古閣上空半，寥寥千里心。多年為客路，盡日倚欄吟。",
            "山壓秦川重，河來虜塞深。回鑾今不見，煙霧杳沉沉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 47
    },
    {
        "title": "題宣州開元寺",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "谁家煙徑長莓苔，金碧虛欄竹上開。流水遠分山色斷，",
            "達理始應盡惆悵，僧閑應得話天臺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 48
    },
    {
        "title": "題友人草堂",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "空山卜隱初，生计亦无餘。三畝水邊竹，一床琴畔书。",
            "深林收晚果，絕頂拾秋蔬。堅話長如此，何年獻子虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 49
    },
    {
        "title": "七松亭",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "七松亭上望秦川，高鳥閑雲滿目前。已比子真耕谷口，",
            "明月影中宮漏近，佩聲應宿使朝天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 50
    },
    {
        "title": "題友人林齋",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "喬木帶涼蟬，來吟暑雨天。不離高枕上，似宿遠山邊。",
            "簟冷窗中月，茶香竹裏泉。吾廬近溪島，憶別動經年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 51
    },
    {
        "title": "經宣城元員外山居",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "无人襲仙隱，石室閉空山。避燒猿犹到，隨雲鶴不還。",
            "澗荒岩影在，橋斷樹阴閑。但有黃河賦，長留在世間。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 52
    },
    {
        "title": "經九華山費征君故居",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "草堂蕪沒后，來往问樵翁。斷石荒林外，孤墳晚照中。",
            "数溪分大野，九子立寒空。煙壁曾行处，青雲路不通。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 53
    },
    {
        "title": "題賈島吟诗台",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "吟魂不復遊，台亦似荒丘。一徑草中出，長江天外流。",
            "暝煙寒鳥集，残月夜蟲愁。愿得生禾黍，鋤平恨即休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 54
    },
    {
        "title": "游南嶽",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "入岩仙境清，行盡複重行。若得闲无事，長來寄此生。",
            "澗松閑易老，籠燭晚生明。一宿泉聲裏，思鄉夢不成。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 55
    },
    {
        "title": "尋桃源",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "武林春草齊，花影隔澄溪。路遠无人去，山空有鳥啼。",
            "水垂青靄斷，松偃綠蘿低。世上迷途客，經茲盡不迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 56
    },
    {
        "title": "青鳥泉",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "只此沉仙翼，瑤池似不遙。有聲懸翠壁，无勢下丹霄。",
            "淨瀨煙霞古，寒原草木凋。山河幾更變，幽咽到唐朝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 57
    },
    {
        "title": "望巫山",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "溪疊雲深轉谷迟，暝投孤店草蟲悲。愁連遠水波濤夜，",
            "東归未必勝羈旅，況是東归未有期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 58
    },
    {
        "title": "省中偶作",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "二轉郎曹自勉旃，莎階吟步想前賢。不如何遜无佳句，",
            "乳毛松雪春來好，直夜清闲且學禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 59
    },
    {
        "title": "秋夕",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "春恨複秋悲，秋悲難到时。每逢明月夜，長起故山思。",
            "巷僻行吟遠，蛩多独臥迟。溪僧与樵客，動別十年期。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 60
    },
    {
        "title": "山中冬夜",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "寒葉风搖盡，空林鳥宿稀。澗冰妨鹿飲，山雪阻僧归。",
            "夜坐塵心定，長吟语力微。人間去多事，何处夢柴扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 61
    },
    {
        "title": "宿劉溫书齋",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "不掩盈窗月，天然格調高。涼风移蟋蟀，落葉在離騷。",
            "回筆挑燈燼，懸图見海濤。因論三國志，空载幾英豪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 62
    },
    {
        "title": "归舊山",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "昔年山下結茅茨，村落重來野徑移。樵客相逢悲往事，",
            "此景一拋吟欲老，可能文字圣朝知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 63
    },
    {
        "title": "潭上作",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "竹島残阳映翠微，雪翎禽過碧潭飛。",
            "人間未有關身事，每到漁家不欲归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 64
    },
    {
        "title": "楊花落",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "北斗南回春物老，紅英落盡綠尚早。韶风澹蕩无所依，",
            "人家女兒出羅幕，淨掃玉除看花落。寶環纖手捧更飛，",
            "東園桃李芳已歇，犹有楊花嬌暮春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 65
    },
    {
        "title": "九華樓晴望",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "一夜江潭风雨后，九華晴望倚天秋。",
            "重來此地知何日，欲別殷勤更上樓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 66
    },
    {
        "title": "終南山",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "帶雪複銜春，橫天占半秦。勢奇看不定，景變写難真。",
            "洞遠皆通嶽，川多更有神。白雲幽絕处，自古屬樵人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 67
    },
    {
        "title": "哭陳陶",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "先生抱衰疾，不起茂陵間。夕臨諸孤少，荒居吊客還。",
            "遺文禪東嶽，留语葬鄉山。多雨銘旌故，残燈素帳閑。",
            "樂章谁与集，隴樹即堪攀。神理今難问，予将叫帝關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 68
    },
    {
        "title": "長門怨",
        "author": "张喬",
        "biography": "",
        "paragraphs": [
            "禦泉長繞鳳凰樓，自是恩波別处流。",
            "閑揲舞衣归未得，夜來砧杵六宮秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百三十九",
        "no#": 69
    }
]