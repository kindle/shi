[
    {
        "title": "星精亭",
        "author": "鄭損",
        "biography": "",
        "paragraphs": [
            "星沈万古痕，孤絕勢无鄰。地窄少留竹，空多剩占雲。",
            "釣篷和雨看，樵斧帶霜闻。莫惜尋常到，清风不負人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 1
    },
    {
        "title": "釣閣",
        "author": "鄭損",
        "biography": "",
        "paragraphs": [
            "小閣愜幽尋，周遭万竹森。谁知一沼內，亦有五湖心。",
            "釣直魚應笑，身閑樂自深。晚來春醉熟，香餌任浮沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 2
    },
    {
        "title": "玉聲亭",
        "author": "鄭損",
        "biography": "",
        "paragraphs": [
            "世間泉石本无價，那更天然落景中。漢佩琮琤寒溜雨，",
            "借问主人能住久，后來好事有谁同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 3
    },
    {
        "title": "藝堂",
        "author": "鄭損",
        "biography": "",
        "paragraphs": [
            "堂開凍石千年翠，藝講秋膠百步威。揖讓未能忘典禮，",
            "莫怪尊前频浩歎，男兒志愿与时違。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 4
    },
    {
        "title": "星精石",
        "author": "鄭損",
        "biography": "",
        "paragraphs": [
            "突險呀空龍虎蹲，由來英气蓄寒根。蒼苔點染雲生靨，",
            "孤岩恰恰容幽構，可愛江南釋子園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 5
    },
    {
        "title": "泛香亭",
        "author": "鄭損",
        "biography": "",
        "paragraphs": [
            "流杯处处稱佳致，何似斯亭出自然。山溜穿雲來幾裏，",
            "莫怪坐中難得醉，醒人心骨有潺湲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 6
    },
    {
        "title": "巴州寒食晚眺",
        "author": "张禕",
        "biography": "",
        "paragraphs": [
            "東望青天周与秦，杏花榆葉故園春。",
            "野寺一傾寒食酒，晚來风景重愁人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 7
    },
    {
        "title": "題擊甌樓",
        "author": "张禕",
        "biography": "",
        "paragraphs": [
            "駐旌元帥遺风在，擊缶高人逸興酣。",
            "水轉巴文清溜急，山連蒙岫翠光涵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 8
    },
    {
        "title": "題司空图壁",
        "author": "盧攜",
        "biography": "",
        "paragraphs": [
            "姓氏司空貴，官班禦史卑。老夫如且在，不用歎屯奇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 9
    },
    {
        "title": "愁诗",
        "author": "李廷璧",
        "biography": "",
        "paragraphs": [
            "到來難遣去難留，著骨黏心万事休。潘嶽愁絲生鬢裏，",
            "更有相思不相見，酒醒燈背月如鉤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 10
    },
    {
        "title": "題菖蒲廢觀",
        "author": "许三畏",
        "biography": "",
        "paragraphs": [
            "本是安期燒药处，今來改作坐禪宮。数僧梵響滿樓月，",
            "我來不見修真客，卻得真如问遠公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 11
    },
    {
        "title": "致孫狀元訴醵罰錢",
        "author": "盧嗣业",
        "biography": "",
        "paragraphs": [
            "未识都知面，频輸複分錢。苦心事筆硯，得志助花鈿。",
            "徒步求秋賦，持杯給暮饘。力微多謝病，非不奉同年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 12
    },
    {
        "title": "紅薔薇",
        "author": "牛嶠",
        "biography": "",
        "paragraphs": [
            "曉啼珠露渾无力，繡簇羅襦不著行。",
            "若綴壽阳公主額，六宮爭肯學梅妝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 13
    },
    {
        "title": "楊柳枝五首",
        "author": "牛嶠",
        "biography": "",
        "paragraphs": [
            "解凍风來末上青，解垂羅袖拜卿卿。",
            "无端嫋娜臨官路，舞送行人過一生。",
            "吳王宮裏色偏深，一簇纖條万縷金。",
            "不憤錢塘蘇小小，引郎松下結同心。",
            "橋北橋南千万條，恨伊张緒不相饒。",
            "金羈白馬臨风望，認得羊家靜婉腰。",
            "狂雪隨风撲馬飛，惹煙无力被春欺。",
            "莫交移入靈和殿，宮女三千又妒伊。",
            "嫋翠籠煙拂暖波，舞裙新染曲塵羅。",
            "章華台畔隋堤上，傍得春风爾许多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 14
    },
    {
        "title": "及第后宿平康裏诗",
        "author": "鄭合",
        "biography": "",
        "paragraphs": [
            "春來无处不閑行，楚潤相看別有情。",
            "好是五更残酒醒，时时闻喚狀頭聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 15
    },
    {
        "title": "賀裴廷裕蜀中登第诗",
        "author": "李搏",
        "biography": "",
        "paragraphs": [
            "銅梁千里曙雲開，仙籙新從紫府來。天上已张新羽翼，",
            "應笑戎藩刀筆吏，至今泥滓曝魚鰓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 16
    },
    {
        "title": "複謔廷裕",
        "author": "李搏",
        "biography": "",
        "paragraphs": [
            "曾隨风水化凡鱗，安上門前一字新。",
            "闻道蜀江风景好，不知何似杏園春。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 17
    },
    {
        "title": "吊賈島",
        "author": "李克恭",
        "biography": "",
        "paragraphs": [
            "一一玄微縹緲成，盡吟方便爽神情。宣宗謫去為闲事，",
            "如何未隔四十载，不遇論量向此生。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 18
    },
    {
        "title": "君山",
        "author": "程賀",
        "biography": "",
        "paragraphs": [
            "曾游方外見麻姑，说道君山此本无。",
            "雲是昆侖山頂石，海风吹落洞庭湖。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 19
    },
    {
        "title": "東归诗",
        "author": "盧尚卿",
        "biography": "",
        "paragraphs": [
            "九重丹詔下塵埃，深鎖文闈罷選才。桂樹放教遮月長，",
            "今日灞陵橋上過，路人應笑臘前回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 20
    },
    {
        "title": "題玉芝雙奉院",
        "author": "顧在鎔",
        "biography": "",
        "paragraphs": [
            "入門如洞府，花木与时稀。夜坐山當戶，秋吟葉滿衣。",
            "犬隨童子出，鳥避俗人飛。至药應将熟，年年火气微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 21
    },
    {
        "title": "宿麻平驛",
        "author": "顧在鎔",
        "biography": "",
        "paragraphs": [
            "及到怡情处，暫忘登陟勞。青山看不厭，明月坐來高。",
            "犬為孤村吠，猿因冷木號。微吟還独酌，多興憶同袍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 22
    },
    {
        "title": "題光福上方塔",
        "author": "顧在鎔",
        "biography": "",
        "paragraphs": [
            "蒼島孤生白浪中，倚天高塔勢翻空。煙凝遠岫列寒翠，",
            "六时金磬落何处，偏傍蘆葦驚釣翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 23
    },
    {
        "title": "枯木诗辭召命作",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "枯木傍溪崖，由來歲月賒。有根盤水石，无葉接煙霞。",
            "二月苔為色，三冬雪作花。不因星使至，谁识是靈槎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 24
    },
    {
        "title": "贈進士王雄",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "河清海晏少波濤，幾载垂鉤不得鼇。空向人間修諫草，",
            "何事明廷有徐庶，總教三徑臥蓬蒿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 25
    },
    {
        "title": "漁者",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "一葉飄然任浪吹，雨蓑煙笠肯忘机。只貪濁水张羅眾，",
            "到頭得喪終須達，谁道漁樵有是非。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 26
    },
    {
        "title": "上子男壽昌宰",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "陶公為政卓潘齊，入縣看花柳滿堤。百里江山聊展驥，",
            "只恐攀轅留不住，明时霄漢有丹梯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 27
    },
    {
        "title": "贈方幹先生",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "由來箕踞任天真，別有诗名出世塵。不愛春宮分桂樹，",
            "独向若耶溪上住，谁知不是釣鼇人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 28
    },
    {
        "title": "贈進士李德新接海棠梨",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "蜀人犹说種難成，何事江東見接生。席上若微桃李伴，",
            "一種呈妍今得地，劍峰梨嶺謾縱橫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 29
    },
    {
        "title": "春日題航頭橋",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "故園橋上絕埃塵，此日凭欄興自新。雲影晚将仙掌曙，",
            "莫怪馬卿題姓字，終朝雲雨化龍津。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 30
    },
    {
        "title": "和方幹題李频莊",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "高情度日非无事，自是高情不觉喧。海气暗蒸蓮葉沼，",
            "閑伴白雲收桂子，每尋流水劚桐孫。犹凭律呂傳心曲，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 31
    },
    {
        "title": "葦叢",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "得地自成叢，那因種植功。有花皆吐雪，无韵不含风。",
            "倒影翹沙鳥，幽根立水蟲。蕭蕭寒雨夜，江漢思无窮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 32
    },
    {
        "title": "春",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "漠漠煙花处处通，遊人南北思无窮。林間鳥奏笙簧月，",
            "此时谁羨神仙客，車馬悠揚九陌中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 33
    },
    {
        "title": "夏",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "觸目皆因長養功，浮生何处问窮通。柳長北闕絲千縷，",
            "身心已在喧闐处，惟羨滄浪把釣翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 34
    },
    {
        "title": "秋",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "宋玉高吟思万重，澄澄寰宇振金风。雲閑日月浮虛白，",
            "侯門处处槐花□，獻賦何时遇至公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 35
    },
    {
        "title": "冬",
        "author": "翁洮",
        "biography": "",
        "paragraphs": [
            "寂寂棲心向杳冥，苦吟寒律句偏清。雲凝止水魚龍蟄，",
            "归飛未得東风力，魂斷三山九万程。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 36
    },
    {
        "title": "過洞庭",
        "author": "李嶼",
        "biography": "",
        "paragraphs": [
            "浩渺注橫流，千潭合万湫。半洪侵楚翼，一汊屬吳頭。",
            "動軸當新霽，漫空正仲秋。勢翻荊口迮，聲擁岳阳浮。",
            "遠脈滋衡嶽，微涼散橘洲。星辰連影動，嵐翠逐隅收。",
            "漸落分行雁，旋添趁伴舟。升騰人莫測，安穩路何憂。",
            "气与塵中別，言堪象外搜。此身如粗了，來把一竿休。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 37
    },
    {
        "title": "嚴塘經乱书事",
        "author": "鄭啟",
        "biography": "",
        "paragraphs": [
            "塵生宮闕霧濛濛，万騎龍飛幸蜀中。在野傅岩君不夢，",
            "星落夜原妖气滿，漢家麟閣待英雄。",
            "梁園皓色月如珪，清景傷时一慘淒。未見山前归牧馬，",
            "正是四郊多壘日，波濤早晚靜鯨鯢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 38
    },
    {
        "title": "鄧表山",
        "author": "鄭啟",
        "biography": "",
        "paragraphs": [
            "白日三清此上时，觀開山下彩雲飛。仙壇丹灶靈犹在，",
            "松花落盡无消息，半夜疏鐘徹翠微。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 39
    },
    {
        "title": "記知闻近過關試",
        "author": "韓仪",
        "biography": "",
        "paragraphs": [
            "短行軸了付三銓，休把新銜惱必先。",
            "今日便稱前進士，好留春色与明年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 40
    },
    {
        "title": "郊居",
        "author": "溫憲",
        "biography": "",
        "paragraphs": [
            "村前村后樹，寓賞有餘情。青麥路初斷，紫花田未耕。",
            "雉聲闻不到，山勢望犹橫。寂寞春风裏，吟酣信馬行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 41
    },
    {
        "title": "杏花",
        "author": "溫憲",
        "biography": "",
        "paragraphs": [
            "團雪上晴梢，紅明映碧寥。店香风起夜，村白雨休朝。",
            "靜落犹和蒂，繁開正蔽條。澹然閑賞久，无以破妖嬈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 42
    },
    {
        "title": "春鳩",
        "author": "溫憲",
        "biography": "",
        "paragraphs": [
            "村南微雨新，平綠淨无塵。散睡桑條暖，閑鳴屋脊春。",
            "遠闻和曉夢，相應在諸鄰。行樂花时節，追飛見亦频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷六百六十七",
        "no#": 43
    },
    {
        "title": "題崇慶寺壁",
        "author": "溫憲",
        "biography": "",
        "paragraphs": [
            "十口溝隍待一身，半年千里絕音塵。",
            "鬢毛如雪心如死，犹作長安下第人。"
        ],
