[
    {
        "title": "古離別",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "下階欲離別，相对映蘭叢。含辭未及吐，淚落蘭叢中。",
            "高堂靜秋日，羅衣飄暮风。谁能待明月，回首見床空。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 1
    },
    {
        "title": "青雀歌",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "林間青雀兒，來往翩翩繞一枝。",
            "莫言不解銜環報，但问君恩今若為。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 2
    },
    {
        "title": "同王昌齡裴迪遊青龍寺曇壁上人兄院集和兄維",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "林中空寂舍，階下終南山。高臥一床上，回看六合間。",
            "浮雲幾处滅，飛鳥何时還。问義天人接，无心世界閑。",
            "谁知大隱者，兄弟自追攀。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 3
    },
    {
        "title": "別輞川別业",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "山月曉仍在，林风涼不絕。殷勤如有情，惆悵令人別。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 4
    },
    {
        "title": "与盧員外象過崔处士興宗林亭",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "身名不问十年餘，老大谁能更讀书。",
            "林中独酌鄰家酒，門外时闻長者車。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 5
    },
    {
        "title": "九日作",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "莫将邊地比京都，八月嚴霜草已枯。",
            "今日登高樽酒裏，不知能有菊花无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 6
    },
    {
        "title": "送孫秀才",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "帝城风日好，況複建平家。玉枕雙紋簟，金盤五色瓜。",
            "山中无魯酒，松下飯胡麻。莫厭田家苦，归期遠複賒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 7
    },
    {
        "title": "遊悟真寺",
        "author": "王縉",
        "biography": "",
        "paragraphs": [
            "闻道黃金地，仍開白玉田。擲山移巨石，咒嶺出飛泉。",
            "猛虎同三徑，愁猿學四禪。買香然綠桂，乞火蹈紅蓮。",
            "草色搖霞上，松聲泛月邊。山河窮百二，世界接三千。",
            "梵宇聊凭視，王城遂渺然。灞陵才出樹，渭水欲連天。",
            "遠縣分朱郭，孤村起白煙。望雲思圣主，披霧憶群賢。",
            "薄宦慚屍素，終身擬尚玄。谁知草庵客，曾和柏梁篇。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 8
    },
    {
        "title": "青龍寺曇壁上人院集",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "靈境信為絕，法堂出塵氛。自然成高致，向下看浮雲。",
            "迤邐峰岫列，參差閭井分。林端遠堞見，风末疏鐘闻。",
            "吾師久禪寂，在世超人群。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 9
    },
    {
        "title": "青雀歌",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "動息自適性，不曾妄与燕雀群。幸忝鵷鸞早相识，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 10
    },
    {
        "title": "遊感化寺曇興上人山院",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "不遠灞陵邊，安居向十年。入門穿竹徑，留客聽山泉。",
            "鳥囀深林裏，心閑落照前。浮名竟何益，從此愿棲禪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 11
    },
    {
        "title": "夏日過青龍寺謁操禪師",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "安禪一室內，左右竹亭幽。有法知不染，无言谁敢酬。",
            "鳥飛爭向夕，蟬噪已先秋。煩暑自茲適，清涼何所求。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 12
    },
    {
        "title": "春日与王右丞過新昌裏訪呂逸人不遇",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "恨不逢君出荷蓑，青松白屋更无他。陶令五男曾不有，",
            "闻说桃源好迷客，不如高臥眄庭柯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 13
    },
    {
        "title": "輞川集二十首：孟城坳",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "結廬古城下，时登古城上。古城非疇昔，今人自來往。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 14
    },
    {
        "title": "輞川集二十首：華子岡",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "落日松风起，還家草露晞。雲光侵履跡，山翠拂人衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 15
    },
    {
        "title": "輞川集二十首：文杏館",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "迢迢文杏館，躋攀日已屡。南嶺与北湖，前看複回顧。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 16
    },
    {
        "title": "輞川集二十首：斤竹嶺",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "明流紆且直，綠筱密複深。一徑通山路，行歌望舊岑。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 17
    },
    {
        "title": "輞川集二十首：鹿柴",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "日夕見寒山，便為独往客。不知深林事，但有麏麚跡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 18
    },
    {
        "title": "輞川集二十首：木蘭柴",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "蒼蒼落日时，鳥聲乱溪水。緣溪路轉深，幽興何时已。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 19
    },
    {
        "title": "輞川集二十首：茱萸沜",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "飄香乱椒桂，布葉間檀欒。雲日雖回照，森沉犹自寒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 20
    },
    {
        "title": "輞川集二十首：宮槐陌",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "門前宮槐陌，是向欹湖道。秋來山雨多，落葉无人掃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 21
    },
    {
        "title": "輞川集二十首：臨湖亭",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "當軒彌滉漾，孤月正裴回。谷口猿聲發，风傳入戶來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 22
    },
    {
        "title": "輞川集二十首：南垞",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "孤舟信一泊，南垞湖水岸。落日下崦嵫，清波殊淼漫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 23
    },
    {
        "title": "輞川集二十首：欹湖",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "空闊湖水廣，青熒天色同。艤舟一長嘯，四面來清风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 24
    },
    {
        "title": "輞川集二十首：柳浪",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "映池同一色，逐吹散如絲。結阴既得地，何謝陶家时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 25
    },
    {
        "title": "輞川集二十首：欒家瀨",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "瀨聲喧极浦，沿涉向南津。泛泛鸥鳧渡，时时欲近人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 26
    },
    {
        "title": "輞川集二十首：金屑泉",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "縈渟澹不流，金碧如可拾。迎晨含素華，独往事朝汲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 27
    },
    {
        "title": "輞川集二十首：白石灘",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "跂石複臨水，弄波情未极。日下川上寒，浮雲澹无色。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 28
    },
    {
        "title": "輞川集二十首：北垞",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "南山北垞下，結宇臨欹湖。每欲采樵去，扁舟出菰蒲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 29
    },
    {
        "title": "輞川集二十首：竹裏館",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "來過竹裏館，日与道相親。出入唯山鳥，幽深无世人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 30
    },
    {
        "title": "輞川集二十首：辛夷塢",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "綠堤春草合，王孫自留玩。況有辛夷花，色与芙蓉乱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 31
    },
    {
        "title": "輞川集二十首：漆園",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "好閑早成性，果此諧宿諾。今日漆園遊，還同莊叟樂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 32
    },
    {
        "title": "輞川集二十首：椒園",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "丹刺罥人衣，芳香留過客。幸堪調鼎用，愿君垂採摘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 33
    },
    {
        "title": "輞口遇雨憶終南山因獻王維",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "積雨晦空曲，平沙滅浮彩。輞水去悠悠，南山複何在。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 34
    },
    {
        "title": "崔九欲往南山馬上口號与別",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "归山深淺去，須盡丘壑美。莫學武陵人，暫遊桃源裏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 35
    },
    {
        "title": "与盧員外象過崔处士興宗林亭",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "喬柯門裏自成阴，散發窗中曾不簪。",
            "逍遙且喜從吾事，榮寵從來非我心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 36
    },
    {
        "title": "西塔寺陸羽茶泉",
        "author": "裴迪",
        "biography": "",
        "paragraphs": [
            "竟陵西塔寺，蹤跡尚空虛。不独支公住，曾經陸羽居。",
            "草堂荒產蛤，茶井冷生魚。一汲清泠水，高风味有餘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 37
    },
    {
        "title": "同王右丞送瑗公南归",
        "author": "崔興宗",
        "biography": "",
        "paragraphs": [
            "行苦神亦秀，泠然溪上松。銅瓶与竹杖，來自祝融峰。",
            "常愿入靈岳，藏經訪遺蹤。南归見長老，且為说心胸。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 38
    },
    {
        "title": "青雀歌",
        "author": "崔興宗",
        "biography": "",
        "paragraphs": [
            "青扈繞青林，翩翾陋體一微禽。",
            "不應常在藩籬下，他日淩雲谁見心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 39
    },
    {
        "title": "和王維敕賜百官櫻桃",
        "author": "崔興宗",
        "biography": "",
        "paragraphs": [
            "未央朝謁正逶迤，天上櫻桃錫此时。朱實初傳九華殿，",
            "闻道令人好顏色，神農本草自應知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 40
    },
    {
        "title": "留別王維",
        "author": "崔興宗",
        "biography": "",
        "paragraphs": [
            "駐馬欲分襟，清寒禦溝上。前山景气佳，独往還惆悵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 41
    },
    {
        "title": "酬王維盧象見過林亭",
        "author": "崔興宗",
        "biography": "",
        "paragraphs": [
            "窮巷空林常閉關，悠然独臥对前山。",
            "今朝忽枉嵇生駕，倒屣開門遙解顏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 42
    },
    {
        "title": "送大理正攝禦史判涼州別駕",
        "author": "苑咸",
        "biography": "",
        "paragraphs": [
            "天子念西疆，咨君去不遑。垂銀棘庭印，持斧柏台綱。",
            "雪下天山白，泉枯塞草黃。佇闻河隴外，還繼海沂康。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 43
    },
    {
        "title": "酬王維",
        "author": "苑鹹",
        "biography": "",
        "paragraphs": [
            "蓮花梵字本從天，華省仙郎早悟禪。三點成伊犹有想，",
            "應同羅漢无名欲，故作馮唐老歲年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 44
    },
    {
        "title": "尋西山隱者不遇",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "絕頂一茅茨，直上三十裏。扣關无僮僕，窺室唯案幾。",
            "若非巾柴車，應是釣秋水。差池不相見，黽勉空仰止。",
            "草色新雨中，松聲晚窗裏。及茲契幽絕，自足蕩心耳。",
            "雖无賓主意，頗得清淨理。興盡方下山，何必待之子。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 45
    },
    {
        "title": "題農父廬舍",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "東风何时至，已綠湖上山。湖上春已早，田家日不閑。",
            "溝塍流水处，耒耜平蕪間。薄暮飯牛罷，归來還閉關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 46
    },
    {
        "title": "泛若耶溪",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "結廬若耶裏，左右若耶水。无日不釣魚，有时向城市。",
            "溪中水流急，渡口水流寬。每得樵风便，往來殊不難。",
            "一川草長綠，四时那得辨。短褐衣妻兒，餘糧及雞犬。",
            "日暮鳥雀稀，稚子呼牛归。住处无鄰里，柴門独掩扉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 47
    },
    {
        "title": "湖中寄王侍禦",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "日日湖水上，好登湖上樓。終年不向郭，過午始梳頭。",
            "嘗自愛杯酒，得无相獻酬。小僮能膾鯉，少妾事蓮舟。",
            "每有南浦信，仍期后月遊。方春轉搖盪，孤興时淹留。",
            "驄馬真傲吏，翛然无所求。晨趨玉階下，心许滄江流。",
            "少別如昨日，何言經数秋。應知方外事，独往非悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 48
    },
    {
        "title": "登潤州城",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "天末江城晚，登臨客望迷。春潮平島嶼，残雨隔虹蜺。",
            "鳥与孤帆遠，煙和独樹低。鄉山何处是，目斷廣陵西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 49
    },
    {
        "title": "尋廬山崔征君",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "日高雞犬靜，門掩向寒塘。夜竹深茅宇，秋亭冷石床。",
            "住山年已遠，服药壽偏長。虛棄浮生者，相逢益自傷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 50
    },
    {
        "title": "留別王維",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "归鞍白雲外，繚繞出前山。今日又明日，自知心不閑。",
            "親勞簪組送，欲趁鶯花還。一步一回首，迟迟向近關。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 51
    },
    {
        "title": "竹下残雪",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "一點消未盡，孤月在竹阴。晴光夜轉瑩，寒气曉仍深。",
            "還对讀书牖，且關乘興心。已能依此地，終不傍瑤琴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 52
    },
    {
        "title": "送閻校书之越",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "南入剡中路，草雲應轉微。湖邊好花照，山口細泉飛。",
            "此地饒古跡，世人多忘归。經年松雪在，永日世情稀。",
            "芸閣應相望，芳时不可違。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 53
    },
    {
        "title": "省試夏日可畏",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "赫赫溫风扇，炎炎夏日徂。火威馳迥野，畏景爍遙途。",
            "勢矯翔阳翰，功分造化爐。禁城千品燭，黃道一輪孤。",
            "落照频空簟，餘暉卷夕梧。如何倦遊子，中路独踟躕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 54
    },
    {
        "title": "左掖梨花",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "冷豔全欺雪，餘香乍入衣。春风且莫定，吹向玉階飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 55
    },
    {
        "title": "渡漢江",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "漾舟漢江上，掛席候风生。臨泛何容与，愛此江水清。",
            "蘆洲隱遙嶂，露日映孤城。自顧疏野性，難忘鸥鳥情。",
            "聊複与时顧，暫欲解塵纓。跋涉非吾愿，虛懷浩已盈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 56
    },
    {
        "title": "冬至下寄舍弟时應赴入京",
        "author": "丘為",
        "biography": "",
        "paragraphs": [
            "去去知未遠，依依甚初別。他鄉至下心，昨夜階前雪。",
            "終日讀书仍少孤，家貧兄弟未當途。適遠才過宿舂料，",
            "莫漫憶柴扉，駟馬高車朝紫微。江南驛使不曾斷，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 57
    },
    {
        "title": "送晁補闕归日本國",
        "author": "趙驊",
        "biography": "",
        "paragraphs": [
            "西掖承休浣，東隅返故林。來稱郯子學，归是越人吟。",
            "馬上秋郊遠，舟中曙海阴。知君懷魏闕，万里独搖心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷一百二十九",
        "no#": 58
    }
]