[
    {
        "title": "渡吳江",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "堠館人稀夜更長，姑蘇城遠樹蒼蒼。江湖潮落高樓迥，",
            "文園诗侶應多思，莫醉笙歌掩華堂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 1
    },
    {
        "title": "元日觀朝",
        "author": "厲玄",
        "biography": "",
        "paragraphs": [
            "玉座臨新歲，朝盈万國人。火連雙闕曉，仗列五門春。",
            "瑞雪銷鴛瓦，祥光在日輪。天顏不敢視，稱慶拜空频。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 2
    },
    {
        "title": "六月",
        "author": "趙璜",
        "biography": "",
        "paragraphs": [
            "六月火雲散，蟬聲鳴樹梢。秋风豈便借，客思已蕭條。",
            "傾國三年別，煙霞一路遙。行人斷消息，更上灞陵橋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 3
    },
    {
        "title": "樊川寒食",
        "author": "喻鳧",
        "biography": "",
        "paragraphs": [
            "新松□綠草，古柏翳黃沙。佩珂客驚鳥，綺羅人間花。",
            "蹙塵南北馬，碾石去來車。川晚悲风動，墳前碎紙斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 4
    },
    {
        "title": "芍药",
        "author": "潘鹹",
        "biography": "",
        "paragraphs": [
            "閑來竹亭賞，賞極蕊珠宮。葉已盡餘翠，花才半展紅。",
            "媚欺桃李色，香奪綺羅风。每到春残日，芳華處處同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 5
    },
    {
        "title": "晚步",
        "author": "劉得仁",
        "biography": "",
        "paragraphs": [
            "野步晚悠悠，山光澹早秋。遠空淪日腳，多稼沒人頭。",
            "古木蟬齊噪，深塍水慢流。幽居回不近，秋策卻堪愁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 6
    },
    {
        "title": "村晚闲步",
        "author": "劉得仁",
        "biography": "",
        "paragraphs": [
            "緩步出居處，過原邊雁行。夕阳投草木，遠水映蒼茫。",
            "野寺同蟾宿，雲溪劚药嘗。蕭條霜景暮，極目盡堪傷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 7
    },
    {
        "title": "冬日題興善寺崔律師院孤松",
        "author": "劉得仁",
        "biography": "",
        "paragraphs": [
            "為此疏名路，频來訪遠公。孤標宜雪後，每見憶山中。",
            "靜影生幽蘚，寒聲入迥空。何年植茲地，曉夕動清风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 8
    },
    {
        "title": "題新栽小松",
        "author": "劉得仁",
        "biography": "",
        "paragraphs": [
            "滿庭蕭颯皆凡木，豈得颼飀似石溪。雪夜枝柯疑画出，",
            "卻向舊山尋得處，白雲根蕟覓應迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 9
    },
    {
        "title": "栽松",
        "author": "劉得仁",
        "biography": "",
        "paragraphs": [
            "翠色凜空庭，披衣独繞行。取從山頂嶮，栽得道心生。",
            "未弱幽泉韵，焉論別木聲。霜天残月在，轉影入池清。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 10
    },
    {
        "title": "十日菊",
        "author": "薛瑩",
        "biography": "",
        "paragraphs": [
            "昨日尊前折，万人酣曉香。今朝籬下見，滿地委残阳。",
            "得失片时痛，榮枯一歲傷。未将同腐草，犹更有重霜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 11
    },
    {
        "title": "赴南巴留別蘇台知己",
        "author": "賈島",
        "biography": "",
        "paragraphs": [
            "人過梅嶺上，歲歲北风寒。落日孤舟去，青山万里看。",
            "猿聲湘水靜，草色洞庭寬。已料生涯事，只應持釣竿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 12
    },
    {
        "title": "紅薔薇",
        "author": "莊南傑",
        "biography": "",
        "paragraphs": [
            "九天碎霞明澤國，造化工夫潛剪刻。翠葉長眉約細枝，",
            "謝豹聲催麥隴秋，熏风吹落猩猩血。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 13
    },
    {
        "title": "曉歌",
        "author": "莊南傑",
        "biography": "",
        "paragraphs": [
            "鶤雞哭樹星河轉，海上金烏翅如電。嫦娥斂發綰雲頭，",
            "魏宮鐘動繡窗明，夢娥驚對残燈立。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 14
    },
    {
        "title": "春草歌",
        "author": "莊南傑",
        "biography": "",
        "paragraphs": [
            "漠漠綿綿幾多思，无言領得春风意。花裁小錦繡晴空，",
            "離人不忍到此處，淚娥滴盡雙真珠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 15
    },
    {
        "title": "古松歌",
        "author": "莊南傑",
        "biography": "",
        "paragraphs": [
            "山上山下松，森沈翠蓋煙。龜鱗犀甲鎖支體，",
            "拏天攫地數千尺，恐作雲雨归維嵩。維嵩成大廈，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 16
    },
    {
        "title": "蒲中霽後晚望",
        "author": "薛能",
        "biography": "",
        "paragraphs": [
            "河邊霽色无人見，身帶春风立岸頭。",
            "濁水茫茫有何意，日斜還向古蒲州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 17
    },
    {
        "title": "龍門八韵",
        "author": "薛能",
        "biography": "",
        "paragraphs": [
            "河浸華夷闊，山橫宇宙雄。高波万丈瀉，夏禹幾年功。",
            "川迸晴明雨，林生旦暮风。人看翻進退，鳥性斷西東。",
            "氣逐雲归海，聲驅石落空。近身毛乍豎，當面语難通。",
            "沸沫归何處，盤渦傍此中。從來化鬐者，攀去路應同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 18
    },
    {
        "title": "新雪",
        "author": "薛能",
        "biography": "",
        "paragraphs": [
            "細落粗和忽複繁，頓清朝市不闻喧。天迷皓色风何乱，",
            "閑吟只愛煎茶澹，斡破平光向近軒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 19
    },
    {
        "title": "送判官赴京",
        "author": "薛能",
        "biography": "",
        "paragraphs": [
            "闕下情偏已絕稀，天涯身遠複相依。庭花每對從容落，",
            "青雲若遇交親話，白璧无心待發揮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 20
    },
    {
        "title": "溪東岑望天都山",
        "author": "朱景玄",
        "biography": "",
        "paragraphs": [
            "目望浮山丘，梯雲上東岑。群峰爭入冥，巉巉生太阴。",
            "昔賢此升仙，結構窮聳深。未曉日先照，當晝色半沉。",
            "风泉雪霜飛，雲樹瓊玉林。大道非閉隔，无路不可尋。",
            "窺鏡澄夙慮，望壇起敬心。一從呼子安，永絕金玉音。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 21
    },
    {
        "title": "夜行次東關逢魏扶東归",
        "author": "许渾",
        "biography": "",
        "paragraphs": [
            "南北斷蓬飄，長亭酒一瓢。残雲归太華，疏雨過中條。",
            "樹色隨關迥，河聲入塞遙。勞歌此分首，风急馬蕭蕭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 22
    },
    {
        "title": "南遊湘漢寄友人",
        "author": "李频",
        "biography": "",
        "paragraphs": [
            "南去遠三京，三湘五月行。巴江雪水下，楚澤火雲生。",
            "向野聊中飲，乘涼探暮程。離懷不可说，已近峽猿聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 23
    },
    {
        "title": "送劉山人归洞庭",
        "author": "李频",
        "biography": "",
        "paragraphs": [
            "卻共孤雲去，高眠最上峰。半湖乘早月，中路入疏鐘。",
            "秋盡蟲聲急，夜深山雨重。當时同隱者，分得幾株松。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 24
    },
    {
        "title": "早發",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "野店星河在，行人道路長。孤燈怜宿處，斜月厭新裝。",
            "草色多寒露，蟲聲似故鄉。清秋无限恨，残菊過重阳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 25
    },
    {
        "title": "題惠山",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "乳洞阴阴碧澗連，杉松六月冷无蟬。",
            "黃昏飛盡白蝙蝠，茶火數星山寂然。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 26
    },
    {
        "title": "雨中看山榴落花",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "山榴逼砌栽，山火一團開。盡日风兼雨，春渠擁作堆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 27
    },
    {
        "title": "寄友人乞菊栽",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "药闌經雨正堪鋤，白菊煩君乞數株。潘嶽賦中芳思在，",
            "□子成仙縱難學，九秋思看集鳩雛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 28
    },
    {
        "title": "江邊柳",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "東风晴色掛闌幹，眉葉初晴畏曉寒。",
            "江上別筵終日有，綠條春在長應難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 29
    },
    {
        "title": "鵝兒",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "臘後閑行村舍邊，黃鵝清水真可怜。何窮散乱隨新草，",
            "风吹楚澤蒹葭暮，看下寒溪逐去船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 30
    },
    {
        "title": "酬友人春暮寄枳花茶",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "昨日東风吹枳花，酒醒春晚一甌茶。如雲正護幽人塹，",
            "相如病渴今全校，不羨生台白頸鴉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 31
    },
    {
        "title": "郢自街西醉归馬鞭墜失崔員外、起秘书…抒短章仰酬珍錫",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "蜀岩阴面冷冥冥，偃雪欺霜半露青。銛刃剪裁多鵲媚，",
            "蘭省貴寮蓬閣吏，一时緘贈到雲亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 32
    },
    {
        "title": "即目",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "自笑騰騰者，非憨又不狂。何為跧似鼠，而複怯於獐。",
            "落拓无生计，伶俜戀酒鄉。冥搜得诗窟，偶戰出文場。",
            "愛雪愁冬盡，懷人覺夜長。石樓多爽氣，檉案有餘香。",
            "运去非關拙，时來不在忙。平生两闲暇，孤趣滿滄浪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 33
    },
    {
        "title": "羅敷東館亭下流泉雲至前山擁咽經歲移时掬弄惆悵成章",
        "author": "李郢",
        "biography": "",
        "paragraphs": [
            "看山亭下小鳴泉，嗚咽難通亦可怜。",
            "惆悵无人為疏鑿，擁愁含恨過年年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 34
    },
    {
        "title": "白櫻樹",
        "author": "于武陵",
        "biography": "",
        "paragraphs": [
            "記得花開雪滿枝，和蜂和蝶帶花移。",
            "如今花落遊蜂去，空作主人惆悵诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 35
    },
    {
        "title": "過南城縣麻姑山",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "似前如卻玉堆堆，薄帶輕煙翠好裁。斜倚兔鉤孤影伴，",
            "驚訝昔人曾羽化，此中爭不接瑤台。",
            "诗手難題画手慚，淺青濃碧疊東南。塵愁世界忙心在，",
            "家风負荷須名宦，可惜千峰綠似藍。",
            "差煙危碧半斜暉，何代仙人此羽飛。高袖鎮長寒柏暗，",
            "聲利系身家系念，今生辜負六銖衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 36
    },
    {
        "title": "和友人題僧院薔薇花三首",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "何人移得在禪家，瑟瑟枝條簇簇霞。爭那寂寥埋草暗，",
            "看取老僧齊物意，一般拋擲等凡花。",
            "忍委芳心此地開，似霞顏色苦低回。风驚少女偷香去，",
            "三清上客知惆悵，勸我春醪一两杯。",
            "露香如醉態如慵，斜壓危闌草色中。試问更谁過野寺，",
            "一日幾回來又去，不能容易舍深紅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 37
    },
    {
        "title": "春晚泊船江村",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "芳草青青古渡頭，漁家住處暫維舟。残花半樹悄无语，",
            "自怜愛失心期約，看取花时更遠遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 38
    },
    {
        "title": "柳",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "风慢日迟迟，拖煙拂水时。惹将千万恨，系在短長枝。",
            "骨軟张郎瘦，腰輕楚女饑。故園归未得，多少斷腸思。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 39
    },
    {
        "title": "蓮花",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "影欹晴浪勢欹煙，恨態緘言日抵年。輕霧曉和香積飯，",
            "何限斷腸名不得，倚风嬌怯醉腰偏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 40
    },
    {
        "title": "残蓮花",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "倚风无力減香时，涵露如啼臥翠池。",
            "金谷樓前馬嵬下，世間殊色一般悲。",
            "不耐高风怕冷煙，瘦紅欹委倒青蓮。",
            "无人解把无塵袖，盛取残香盡日怜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 41
    },
    {
        "title": "惜蓮花",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "半塘前日染來紅，瘦盡金方昨夜风。留樣最嗟无巧筆，",
            "魂斷舊溪憔悴態，冷煙残粉楚台東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 42
    },
    {
        "title": "岳阳雲夢亭看蓮花",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "似醉如慵一水心，斜阳欲暝彩雲深。清明月照羞无语，",
            "當时為汝題诗遍，此地依前泥苦吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 43
    },
    {
        "title": "村路菊花",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "嫋风驚未定，溪影晚來寒。不得重阳節，虛将滿把看。",
            "神仙谁采掇，煙雨惜凋残。牧豎樵童看，應教愛爾難。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 44
    },
    {
        "title": "題山驛新桐花",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "雨餘煙膩暖香浮，影暗斜阳古驛樓。丹鳳總巢阿閣去，",
            "長日老春看落盡，野禽閑哢碧悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 45
    },
    {
        "title": "山路木芙蓉",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "不向橫塘泥裏栽，两株晴笑碧岩隈。枉教絕世深紅色，",
            "緣花更歎人間事，半日江邊悵望回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 46
    },
    {
        "title": "新柳",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "无情柔態任春催，似不勝风倚古台。",
            "多少去年今日恨，禦溝顏色洞庭來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 47
    },
    {
        "title": "臨川見新柳",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "不見江頭三四日，橋邊楊柳老金絲。岸南岸北往來渡，",
            "汀洲草色亦如此，愁殺遠人人不知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 48
    },
    {
        "title": "南阳見柳",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "夜來风入最高枝，罥斷愁腸幾尺絲。楚塞曾吟煙午處，",
            "還把舊年惆悵意，武安城下一吟诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 49
    },
    {
        "title": "別君山",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "點空誇黛妒愁眉，何必浮來結夢思。",
            "慚愧二年青翠色，惹窗粘枕伴吟诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 50
    },
    {
        "title": "宿壽安山阴館闻泉",
        "author": "崔櫓",
        "biography": "",
        "paragraphs": [
            "一支清急万山來，穿竹喧飛破石苔。夢在故鄉臨欲到，",
            "緣憶舊遊相似處，月明山響子陵台。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 51
    },
    {
        "title": "共佳人守歲",
        "author": "劉綺莊",
        "biography": "",
        "paragraphs": [
            "桂華窮北陸，荊豔作東鄰。残妝欲送曉，薄衣已迎春。",
            "舉袖爭流雪，分歌競繞塵。不應将共醉，年去遠催人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷八百八十四",
        "no#": 52
    }
]