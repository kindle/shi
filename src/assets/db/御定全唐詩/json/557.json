[
    {
        "title": "寄宜阳兄弟",
        "author": "易重",
        "biography": "",
        "paragraphs": [
            "六年雁序恨分離，詔下今朝遇已知。上國皇风初喜日，",
            "故里仙才若相问，一春攀得两重枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 1
    },
    {
        "title": "發蕙风館遇阴不見九華山有作",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "我來淮阴城，千江万山无不經。山青水碧千万丈，",
            "人家敲鏡救不得，光阴卻屬貪狼星。恨亦不能通，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 2
    },
    {
        "title": "寄浙右舊幕僚",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "由來惡舌駟難追，自古无媒謗所归。勾踐豈能容範蠡，",
            "慚愧故人同鮑叔，此心江柳尚依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 3
    },
    {
        "title": "壯士吟",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "壯士何曾悲，悲即无回期。如何易水上，未歌淚先垂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 4
    },
    {
        "title": "徐波渡",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "曉月千重樹，春煙十裏溪。過來還過去，此路不知迷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 5
    },
    {
        "title": "題嘉祥驛",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "樹頂煙微綠，山根菊暗香。何人独鞭馬，落日上嘉祥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 6
    },
    {
        "title": "懷鄭洎",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "风蘭舞幽香，雨葉墮寒滴。美人來不來，前山看向夕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 7
    },
    {
        "title": "長信宮",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "君恩已盡欲何归，犹有残香在舞衣。",
            "自恨身輕不如燕，春來還繞禦簾飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 8
    },
    {
        "title": "閨情",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "山上有山归不得，湘江暮雨鷓鴣飛。",
            "蘼蕪亦是王孫草，莫送春香入客衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 9
    },
    {
        "title": "蓮塘",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "脈脈低回殷袖遮，臉橫秋水髻盤鴉。",
            "蓮莖有刺不成折，盡日岸傍空看花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 10
    },
    {
        "title": "還淮卻寄睢阳",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "梁王池苑已蒼然，滿樹斜阳极浦煙。",
            "盡日回頭看不見，两行愁淚上南船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 11
    },
    {
        "title": "烏江",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "中分豈是无遺策，百戰空勞不逝騅。",
            "大业固非人事及，烏江亭長又何知。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 12
    },
    {
        "title": "新安故關",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "漢帝英雄重武材，崇山險处鑿門開。",
            "如今更有将军否，移取潼關向北來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 13
    },
    {
        "title": "廣陵城",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "紅繞高臺綠繞城，城邊春草傍牆生。",
            "隋家不向此中盡，汴水應无東去聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 14
    },
    {
        "title": "過驪山",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "冷日微煙渭水愁，華清宮樹不勝秋。",
            "霓裳一曲千門鎖，白盡梨園弟子頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 15
    },
    {
        "title": "吳故宮",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "越女歌長君且聽，芙蓉香滿水邊城。",
            "豈知一日終非主，犹自如今有怨聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 16
    },
    {
        "title": "蘭昌宮",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "宮門两片掩埃塵，牆上无花草不春。",
            "谁見當时禁中事，阿嬌解佩与何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 17
    },
    {
        "title": "宮人斜",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "雲慘煙愁苑路斜，路傍丘塚盡宮娃。",
            "茂陵不是同归处，空寄香魂著野花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 18
    },
    {
        "title": "句",
        "author": "孟迟",
        "biography": "",
        "paragraphs": [
            "天地有时饒一擲。江山无主任平分。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 19
    },
    {
        "title": "和于興宗登越王樓诗",
        "author": "王鐸",
        "biography": "",
        "paragraphs": [
            "謝脁題诗处，危樓壓郡城。雨餘江水碧，雲斷雪山明。",
            "錦繡來仙境，风光入帝京。恨无青玉案，何以報高情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 20
    },
    {
        "title": "謁梓潼张惡子廟",
        "author": "王鐸",
        "biography": "",
        "paragraphs": [
            "盛唐圣主解青萍，欲振新封濟顺名。夜雨龍拋三尺匣，",
            "惟報關東諸将相，柱天功业賴阴兵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 21
    },
    {
        "title": "罷都統守鎮滑州作",
        "author": "王鐸",
        "biography": "",
        "paragraphs": [
            "用军何事敢遷延，恩重才輕分使然。黜詔已闻來闕下，",
            "正會星辰扶北极，卻驅戈甲鎮南燕。三塵上相逢明主，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 22
    },
    {
        "title": "句",
        "author": "王鐸",
        "biography": "",
        "paragraphs": [
            "華表尚迷丁令鶴，竹坡犹認葛溪龍。。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 23
    },
    {
        "title": "中秋月直禁苑",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "禁署方懷忝，綸闈已再加。暫來西掖路，還整上清槎。",
            "恍惚归丹地，深嚴宿絳霞。幽襟聊自適，閑弄紫薇花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 24
    },
    {
        "title": "麥穗两岐",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "圣慮憂千畝，嘉苗薦两岐。如雲方表盛，成穗忽標奇。",
            "瑞露縱橫滴，祥风左右吹。謳歌連上苑，化日遍平陂。",
            "史冊书堪重，丹青画更宜。愿依連理樹，俱作万年枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 25
    },
    {
        "title": "五月一日紫宸候对时屬禁直穿內而行因书六韵",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "朱夏五更后，步廊三裏餘。有人從翰苑，穿入內中书。",
            "漏響飄銀箭，燈光照玉除。禁扉犹鎖鑰，宮妓已妝梳。",
            "紫府游應似，鈞天夢不如。塵埃九重外，谁信在清虛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 26
    },
    {
        "title": "題緱山王子晉廟",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "有昔靈王子，吹笙溯泬。六宮攀不住，三島去相招。",
            "亡國原陵古，賓天歲月遙。无蹊窺海曲，有廟訪山椒。",
            "石帳龍蛇拱，雲櫳彩翠銷。露壇裝琬琰，真像写松喬。",
            "珠館青童宴，琳宮阿母朝。气輿仙女侍，天馬吏兵調。",
            "湘妓紅絲瑟，秦郎白管簫。西城要綽約，南嶽命嬌嬈。",
            "句曲觴金洞，天臺嘯石橋。晚花珠弄蕊，春茹玉生苗。",
            "二景神光秘，三元寶籙饒。霧垂鴉翅發，冰束虎章腰。",
            "鶴馭爭銜箭，龍妃合獻綃。衣從星渚浣，丹就日宮燒。",
            "物外花嘗滿，人間葉自凋。望台悲漢戾，閱水笑梁昭。",
            "古殿香残灺，荒階柳長條。幾曾期七日，无複降重霄。",
            "嵩嶺連天漢，伊瀾入海潮。何由得真訣，使我佩環飄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 27
    },
    {
        "title": "初秋寓直三首",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "曉星独掛結麟樓，三殿风高药樹秋。",
            "玉笛数聲飄不住，问人依約在東頭。",
            "宿鳥翩翩落照微，石台樓閣鎖重扉。",
            "步廊无限金羈響，應是諸司扈從归。",
            "幽閣焚香万慮凝，下簾胎息過禪僧。",
            "玉堂分照无人后，消盡金盆一碗冰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 28
    },
    {
        "title": "夜景又作",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "鈴絛无響閉珠宮，小閣涼添玉蕊风。",
            "枕簟滿床明月到，自疑身在五雲中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 29
    },
    {
        "title": "杪秋夜直",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "蕊宮裁詔与宵分，雖在青雲憶白雲。",
            "待報君恩了归去，山翁何急草移文。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 30
    },
    {
        "title": "禁直寄崔員外",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "銀台樓北蕊珠宮，夐与人間路不同。",
            "在省五更春睡侶，早來分夢玉堂中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 31
    },
    {
        "title": "闻號",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "陛兵偏近羽林營，夜靜仍傳禁號聲。",
            "應笑執金雙闕下，近南犹隔两重城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 32
    },
    {
        "title": "禁直和人飲酒",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "卉醴陀花物外香，清濃標格勝椒漿。",
            "我來尚有鈞天會，犹得金尊半日嘗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 33
    },
    {
        "title": "下直早出",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "諸司人盡馬蹄稀，紫帕雲竿九釘归。",
            "偏觉石台清貴处，榜懸金字射晴暉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 34
    },
    {
        "title": "金鑾坡上南望",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "玉晨鐘韵上清虛，画戟祥煙拱帝居。",
            "极眼向南无限地，綠煙深处認中书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 35
    },
    {
        "title": "酬隱珪舍人寄紅燭",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "蜜炬殷紅画不如，且将归去照吾廬。",
            "今來並得三般事，靈运诗篇逸少书。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 36
    },
    {
        "title": "馬嵬坡",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "玄宗回馬楊妃死，雲雨雖亡日月新。",
            "終是圣明天子事，景阳宮井又何人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 37
    },
    {
        "title": "句",
        "author": "鄭畋",
        "biography": "",
        "paragraphs": [
            "圓明青z3飯，光潤碧霞漿。。浴殿晴秋倘中謝，残英犹可醉瓊杯。（《紫薇花》。",
            "見《海錄碎事》）"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 38
    },
    {
        "title": "題九華山",
        "author": "譚銖",
        "biography": "",
        "paragraphs": [
            "憶闻九華山，尚在童稚年。浮沉任名路，窺仰會无緣。",
            "罷職池阳时，複遭迎送牽。因茲契誠愿，矚望枕席前。",
            "況值春正濃，气色无不全。或如碧玉靜，或似青靄鮮。",
            "或接白雲堆，或映紅霞天。呈姿既不一，變態何啻千。",
            "巍峨本无動，崇峻性豈偏。外景自隱隱，潛虛固幽玄。",
            "我來暗凝情，務道志更堅。色与山異性，性並山亦然。",
            "境變山不動，性存形自遷。自遷不阻俗，自定不失賢。",
            "浮華与朱紫，安可迷心田。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 39
    },
    {
        "title": "真娘墓",
        "author": "譚銖",
        "biography": "",
        "paragraphs": [
            "武丘山下塚累累，松柏蕭條盡可悲。",
            "何事世人偏重色，真娘墓上独題诗。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 40
    },
    {
        "title": "望九華山",
        "author": "盧嗣立",
        "biography": "",
        "paragraphs": [
            "九華深翠落軒楹，迥眺澄江气象明。不遇阴霾孤岫隱，",
            "得路归山期早訣，夜來潛已告精誠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 41
    },
    {
        "title": "應舉日寄兄弟",
        "author": "朱可名",
        "biography": "",
        "paragraphs": [
            "廢刈鏡湖田，上书紫閣前。愁人久委地，诗道未闻天。",
            "不是燒金手，徒拋釣月船。多慚兄弟意，不敢问林泉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百五十七",
        "no#": 42
    },
    {
        "title": "河出榮光",
        "author": "张良器",
        "biography": "",
        "paragraphs": [
            "引派昆山峻，朝宗海路長。千齡逢圣主，五色瑞榮光。",
            "隱映浮中國，晶明助太阳。坤維連浩漫，天漢接微茫。",
            "丹闕清氛裏，函關紫气旁。位尊常守伯，道泰每呈祥。",
