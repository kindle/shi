[
    {
        "title": "鳥散餘花落",
        "author": "孔溫业",
        "biography": "",
        "paragraphs": [
            "美景春堪賞，芳園白日斜。共看飛好鳥，複見落餘花。",
            "來往驚翻電，經過想散霞。雨餘飄处处，风送滿家家。",
            "求友聲初去，離枝色可嗟。從茲时節换，谁為惜年華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 1
    },
    {
        "title": "鳥散餘花落",
        "author": "趙存約",
        "biography": "",
        "paragraphs": [
            "春曉游禽集，幽庭幾樹花。坐來驚豔色，飛去墮晴霞。",
            "翅拂繁枝落，风添舞影斜。彩雲飄玉砌，絳雪下仙家。",
            "分散音初靜，凋零蕊帶葩。空階瞻玩久，應共惜年華。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 2
    },
    {
        "title": "鳥散餘花落",
        "author": "竇洵直",
        "biography": "",
        "paragraphs": [
            "晚樹春归后，花飛鳥下初。參差分羽翼，零落滿空虛。",
            "风外清香轉，林邊豔影疏。輕盈疑雪舞，仿佛似霞舒。",
            "万片情難极，遷喬思有餘。微臣一何幸，吟賞对寒居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 3
    },
    {
        "title": "公无渡河",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "阴雲颯颯浪花愁，半度驚湍半掛舟。聲盡雲天君不住，",
            "餘魄豈能銜木石，独将遺恨付箜篌。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 4
    },
    {
        "title": "秦王卷衣",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "秦王宮闕靄春煙，珠樹瓊枝近碧天。禦气馨香蘇合啟，",
            "從此咸阳一回首，暮雲愁色已千年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 5
    },
    {
        "title": "婕妤怨",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "掌上恩移玉帳空，香珠滿眼泣春风。飄零怨柳凋眉翠，",
            "笙歌处处回天眷，独自无情長信宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 6
    },
    {
        "title": "飲馬長城窟",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "日日风吹虜騎塵，年年飲馬漢營人。千堆戰骨那知主，",
            "金鞍玉勒无顏色，淚滿征衣怨暴秦。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 7
    },
    {
        "title": "江南行",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "水光春色滿江天，蘋葉风吹荷葉錢。香蟻翠旗臨岸市，",
            "不怕江洲芳草暮，待将秋興折湖蓮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 8
    },
    {
        "title": "長安秋思",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "吳女秋机織曙霜，冰蠶吐絲月盈筐。金刀玉指裁縫促，",
            "唯愁陌上芳菲度，狼藉风池荷葉黃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 9
    },
    {
        "title": "贈元和十三年登第進士",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "春官南院粉牆東，地色初分月色紅。文字一千重馬擁，",
            "莫怪雲泥從此別，總曾惆悵去年中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 10
    },
    {
        "title": "焦桐樹",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "江上烹魚采野樵，鸞枝摧折半曾燒。未經良匠材雖散，",
            "還能万里傳山水，三峽泉聲豈寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 11
    },
    {
        "title": "寄友人",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "杜甫在时貪入蜀，孟郊生处卻归秦。",
            "如今始會麻姑意，借问山川与后人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 12
    },
    {
        "title": "啄木謠",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "丁丁向晚急還稀，啄遍庭槐未肯归。",
            "終日与君除蠹害，莫嫌无事不频飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 13
    },
    {
        "title": "僧院牡丹",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "琉璃地上開紅豔，碧落天頭散曉霞。",
            "應是向西无地種，不然爭肯重蓮花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 14
    },
    {
        "title": "蜀葵",
        "author": "陳標",
        "biography": "",
        "paragraphs": [
            "眼前无奈蜀葵何，淺紫深紅数百窠。",
            "能共牡丹爭幾许，得人嫌处只緣多。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 15
    },
    {
        "title": "離家",
        "author": "袁不約",
        "biography": "",
        "paragraphs": [
            "步步遠晨昏，淒心出裏門。見烏唯有淚，看雁更傷魂。",
            "宿酒寧辭醉，回书諱苦言。野人應怪笑，不解愛田園。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 16
    },
    {
        "title": "送人至嶺南",
        "author": "袁不約",
        "biography": "",
        "paragraphs": [
            "度嶺春风暖，花多不识名。瘴煙迷月色，巴路傍溪聲。",
            "畏药将銀試，防蛟避水行。知君怜酒興，莫殺醉猩猩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 17
    },
    {
        "title": "長安夜遊",
        "author": "袁不約",
        "biography": "",
        "paragraphs": [
            "鳳城連夜九門通，帝女皇妃出漢宮。千乘寶蓮珠箔卷，",
            "長樂曉鐘归騎后，遺簪墮珥滿街中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 18
    },
    {
        "title": "病宮人",
        "author": "袁不約",
        "biography": "",
        "paragraphs": [
            "佳人臥病動經秋，簾幕襤縿不掛鉤。四體強扶藤夾膝，",
            "惆悵近來銷瘦盡，淚珠时傍枕函流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 19
    },
    {
        "title": "句",
        "author": "袁不約",
        "biography": "",
        "paragraphs": [
            "愁聲秋繞杵，寒色碧归山。",
            "送将歡笑去，收得寂寥回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 20
    },
    {
        "title": "臨邛怨",
        "author": "李餘",
        "biography": "",
        "paragraphs": [
            "藕花衫子柳花裙，多著沈香慢火熏。",
            "惆悵妝成君不見，空教綠綺伴文君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 21
    },
    {
        "title": "寒食",
        "author": "李餘",
        "biography": "",
        "paragraphs": [
            "玉輪江上雨絲絲，公子游春醉不知。",
            "翦渡归來风正急，水濺鞍帕嫩鵝兒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 22
    },
    {
        "title": "句",
        "author": "李餘",
        "biography": "",
        "paragraphs": [
            "長安東門別，立馬生白发。",
            "霽后軒蓋繁，南山瑞煙發。",
            "嘗憂車馬繁，土薄闻水聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 23
    },
    {
        "title": "至日上公獻壽酒",
        "author": "白敏中",
        "biography": "",
        "paragraphs": [
            "候曉天門辟，朝天万國同。瑞雲升觀闕，香气映華宮。",
            "日色臨仙籞，龍顏对昊宮。羽仪瞻百姓，獻壽侍三公。",
            "化被君王洽，恩沾草木豐。自欣朝玉座，宴此詠皇风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 24
    },
    {
        "title": "賀收復秦原諸州诗",
        "author": "白敏中",
        "biography": "",
        "paragraphs": [
            "一詔皇城四海頒，醜戎无数束身還。戍樓吹笛人休戰，",
            "西邊北塞今无事，為報東南夷与蠻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 25
    },
    {
        "title": "句",
        "author": "白敏中",
        "biography": "",
        "paragraphs": [
            "南浦花臨水，東樓月映风。（鎮劍南，經忠州，尋樂天",
            "遺跡作。見《紀事》）"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 26
    },
    {
        "title": "遣興",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "果窺丹灶鶴，莫羨白頭翁。日月仙壺外，筋骸药臼中。",
            "雲归无定所，鳥跡不留空。何必勞方寸，嶇崎问遠公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 27
    },
    {
        "title": "勸酒",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "不向花前醉，花應解笑人。只憂連夜雨，又過一年春。",
            "日日无窮事，區區有限身。若非杯酒裏，何以寄天真。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 28
    },
    {
        "title": "近无西耗",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "遠戎兵壓境，遷客淚橫襟。烽候驚春塞，縲囚困越吟。",
            "自怜牛馬走，未识犬羊心。一月无消息，西看日又沈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 29
    },
    {
        "title": "天臺晴望",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "天臺十二旬，一片雨中春。林果黃梅盡，山苗半夏新。",
            "阳烏晴展翅，阴魄夜飛輪。坐冀无雲物，分明見北辰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 30
    },
    {
        "title": "闻高侍禦卒貶所",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "西京高院長，直气似吾徒。走馬論邊備，飛聲感廟謨。",
            "官移人未察，身沒事多符。寂寞他年后，名編野史无。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 31
    },
    {
        "title": "題黃山湯院",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "楚鎮惟黃岫，靈泉浴圣源。煎熬何处所，爐炭孰司存。",
            "沙暖泉長拂，霜籠水更溫。不疏還自決，雖撓未嘗渾。",
            "地啟岩為洞，天開石作盆。常留今日色，不減故年痕。",
            "阴焰潛生海，阳光暗燭坤。定應鄰火宅，非独過焦原。",
            "龍訝經冬潤，鶯疑滿谷暄。善烹寒食茗，能變早春園。",
            "及物功何大，隨流道益尊。潔齋齊物主，療病奪醫門。",
            "外秘千峰秀，旁通百潦奔。禪家休问疾，騷客罷招魂。",
            "臥理黔川守，分憂漢主恩。慘傷因有暇，徒禦誡无喧。",
            "癢悶頭风切，爬搔臂力煩。披榛通白道，束馬置朱幡。",
            "謝屐緣危磴，戎裝逗遠村。慢游登竹徑，高步入山根。",
            "崖巘差行灶，蓬茅過小軒。禦寒增帳幕，甃影盡璵璠。",
            "不与華池语，寧将浴室論。洗心過頃刻，浸發迨朝暾。",
            "汗洽聊箕踞，支羸暫虎蹲。濯纓閑更入，漱齒渴仍吞。",
            "气燠勝重絸，风和敵一尊。適來還蹭蹬，複出又攀援。",
            "形穢忻除垢，神囂喜破昏。明夷征立象，既濟感文言。",
            "已閡眠沙麂，仍妨臥石猿。香驅蒸霧起，煙霿濕雲屯。",
            "破險更祠宇，凭高易廟垣。舊基絕仄足，新構忽行鵷。",
            "勝地非无棟，征途遽改轅。貪程归路遠，折政訟庭繁。",
            "興往留年月，诗成遺子孫。已鐫東壁石，名姓寄无垠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 32
    },
    {
        "title": "太和公主還宮",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "二紀煙塵外，淒涼轉戰归。胡笳悲蔡琰，漢使泣明妃。",
            "金殿更戎幄，青祛换毳衣。登車隨伴仗，謁廟入中闈。",
            "湯沐疏封在，關山故夢非。笑看鴻北向，休詠鵲南飛。",
            "宮髻怜新樣，庭柯想舊圍。生還侍兒少，熟识內家稀。",
            "鳳去樓扃夜，鸞孤匣掩輝。應怜禁園柳，相見倍依依。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 33
    },
    {
        "title": "汴河直進船",
        "author": "李敬方",
        "biography": "",
        "paragraphs": [
            "汴水通淮利最多，生人為害亦相和。",
            "東南四十三州地，取盡脂膏是此河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 34
    },
    {
        "title": "享太廟樂章",
        "author": "李回",
        "biography": "",
        "paragraphs": [
            "受天明命，敷佑下土。化时以儉，衛文以武。",
            "氛消夷夏，俗臻往古。億万斯年，形於律呂。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 35
    },
    {
        "title": "天長路別朱大山路卻寄",
        "author": "李回",
        "biography": "",
        "paragraphs": [
            "驛騎難隨伴，尋山半憶君。蒼崖残月路，犹数過溪雲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 36
    },
    {
        "title": "寄酬朱大后亭夜坐留別",
        "author": "李回",
        "biography": "",
        "paragraphs": [
            "十夜郡城宿，苦吟身未閑。那堪西郭別，雪路问青山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 37
    },
    {
        "title": "祖龍行",
        "author": "常楚老",
        "biography": "",
        "paragraphs": [
            "黑雲兵气射天裂，壯士朝眠夢冤結。祖龍一夜死沙丘，",
            "墓接驪山土未幹，瑞光已向芒碭起。陳勝城中鼓三下，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 38
    },
    {
        "title": "江上蚊子",
        "author": "常楚老",
        "biography": "",
        "paragraphs": [
            "飄搖挾翅亞紅腹，江邊夜起如雷哭。請问貪婪一點心。",
            "臭腐填腹幾多足。越女如花住江曲，嫦娥夜夜凝雙睩。",
            "怕君撩乱錦窗中，十軸輕綃圍夜玉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 39
    },
    {
        "title": "句",
        "author": "常楚老",
        "biography": "",
        "paragraphs": [
            "一從黃帝葬橋山，碧落千門鎖元气。（《天上行》。",
            "《诗話總归》）"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 40
    },
    {
        "title": "九成宮",
        "author": "李甘",
        "biography": "",
        "paragraphs": [
            "中原无鹿海无波，鳳輦鸞旗出幸多。",
            "今日故宮归寂寞，太平功业在山河。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 41
    },
    {
        "title": "謁李相不遇",
        "author": "平曾",
        "biography": "",
        "paragraphs": [
            "老夫三日門前立，珠箔銀屏晝不開。",
            "诗卷卻拋书袋裏，正如閑看華山來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 42
    },
    {
        "title": "留別薛僕射",
        "author": "平曾",
        "biography": "",
        "paragraphs": [
            "梯山航海幾崎嶇，來謁金陵薛大夫。毛发豎时趨劍戟，",
            "明日過江风景好，不堪回首望勾吳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 43
    },
    {
        "title": "縶白馬诗上薛僕射",
        "author": "平曾",
        "biography": "",
        "paragraphs": [
            "白馬披鬃練一團，今朝被絆欲行難。雪中放去空留跡，",
            "自知毛骨還應異，更請孫阳仔細看。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 44
    },
    {
        "title": "題所书黃庭經后",
        "author": "景審",
        "biography": "",
        "paragraphs": [
            "金粉為书重莫過，黃庭舊许右军多。",
            "請看今日酬恩德，何似當年為愛鵝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 45
    },
    {
        "title": "句",
        "author": "景審",
        "biography": "",
        "paragraphs": [
            "暮鴉不噪禁城樹，衙鼓未残兵衛秋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百零八",
        "no#": 46
    }
]