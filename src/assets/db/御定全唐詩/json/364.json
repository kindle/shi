[
    {
        "title": "荊州歌二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "渚宮楊柳暗，麥城朝雉飛。可怜踏青伴，乘暖著輕衣。",
            "今日好南风，商旅相催發。沙頭檣竿上，始見春江闊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 1
    },
    {
        "title": "紀南歌",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "风煙紀南城，塵土荊門路。天寒多獵騎，走上樊姬墓。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 2
    },
    {
        "title": "視刀環歌",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "常恨言语淺，不如人意深。今朝两相視，脈脈万重心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 3
    },
    {
        "title": "三閣辭四首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "貴人三閣上，日晏未梳頭。不應有恨事，嬌甚卻成愁。",
            "珠箔曲瓊鉤，仔細見揚州。北兵那得度，浪話判悠悠。",
            "沉香帖閣柱，金縷画門楣。回首降幡下，已見黍離離。",
            "三人出眢井，一身登檻車。朱門漫臨水，不可見鱸魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 4
    },
    {
        "title": "紇那曲二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "楊柳鬱青青，竹枝无限情。周郎一回顧，聽唱紇那聲。",
            "踏曲興无窮，調同詞不同。愿郎千万壽，長作主人翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 5
    },
    {
        "title": "淮阴行五首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "簇簇淮阴市，竹樓緣岸上。好日起檣竿，烏飛驚五两。",
            "今日轉船頭，金烏指西北。煙波与春草，千里同一色。",
            "船頭大銅鐶，摩挲光陣陣。早早使风來，沙頭一眼認。",
            "何物令儂羨，羨郎船尾燕。銜泥趁檣竿，宿食長相見。",
            "隔浦望行船，頭昂尾幰幰。无奈晚來时，清淮春浪軟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 6
    },
    {
        "title": "渾侍中宅牡丹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "徑尺千餘朵，人間有此花。今朝見顏色，更不向諸家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 7
    },
    {
        "title": "詠紅柿子",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "曉連星影出，晚帶日光懸。本因遺采掇，翻自保天年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 8
    },
    {
        "title": "呂八見寄郡內书懷因而戲和",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "文苑振金聲，循良冠百城。不知今史氏，何處列君名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 9
    },
    {
        "title": "秋风引",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "何處秋风至，蕭蕭送雁群。朝來入庭樹，孤客最先闻。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 10
    },
    {
        "title": "柳花詞三首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "開從綠條上，散逐香风遠。故取花落时，悠揚占春晚。",
            "輕飛不假风，輕落不委地。撩乱舞晴空，發人无限思。",
            "晴天闇闇雪，來送青春暮。无意似多情，千家万家去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 11
    },
    {
        "title": "路傍曲",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "南山宿雨晴，春入鳳凰城。處處闻弦管，无非送酒聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 12
    },
    {
        "title": "君山懷古",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "屬車八十一，此地阻長风。千载威靈盡，赭山寒水中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 13
    },
    {
        "title": "庭竹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "露滌鉛粉節，风搖青玉枝。依依似君子，无地不相宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 14
    },
    {
        "title": "唐郎中宅与諸公同飲酒看牡丹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "今日花前飲，甘心醉數杯。但愁花有语，不為老人開。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 15
    },
    {
        "title": "題壽安甘棠館二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "公館似仙家，池清竹徑斜。山禽忽驚起，沖落半岩花。",
            "門前洛阳道，門裏桃花路。塵土与煙霞，其間十餘步。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 16
    },
    {
        "title": "古詞二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "軒後初冠冕，前旒為蔽明。安知從複道，然後見人情。",
            "簿領乃俗士，清談信古风。吾觀蘇令綽，朱墨一何工。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 17
    },
    {
        "title": "寓興二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "常談即至理，安事非常情。寄语何平叔，无為輕老生。",
            "世途多禮數，鵬鷃各逍遙。何事陶彭澤，拋官為折腰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 18
    },
    {
        "title": "詠史二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "驃騎非无勢，少卿終不去。世道劇頹波，我心如砥柱。",
            "賈生明王道，衛綰工車戲。同遇漢文时，何人居貴位。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 19
    },
    {
        "title": "經檀道濟故壘",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "万里長城壞，荒營野草秋。秣陵多士女，犹唱白符鳩。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 20
    },
    {
        "title": "傷段右丞",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "江海多豪氣，朝廷有直聲。何言馬蹄下，一旦是佳城。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 21
    },
    {
        "title": "傷独孤舍人",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "昔別矜年少，今悲喪國華。遠來同社燕，不見早梅花。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 22
    },
    {
        "title": "再傷龐尹",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "京兆归何處，章台空暮塵。可怜鸞鏡下，哭殺画眉人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 23
    },
    {
        "title": "敬酬微公見寄二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "淒涼沃州僧，憔悴柴桑宰。別來二十年，唯餘两心在。",
            "越江千里鏡，越嶺四时雪。中有逍遙人，夜深觀水月。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 24
    },
    {
        "title": "鄂渚留別李二十一表臣大夫",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "高檣起行色，促柱動離聲。欲问江深淺，應如遠別情。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 25
    },
    {
        "title": "答表臣贈別二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "昔為瑤池侶，飛舞集蓬萊。今作江漢別，风雪一徘徊。",
            "嘶馬立未還，行舟路将轉。江頭暝色深，揮袖依稀見。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 26
    },
    {
        "title": "始發鄂渚寄表臣二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "祖帳管弦絕，客帆西风生。回車已不見，犹聽馬嘶聲。",
            "曉發柳林戍，遙城闻五鼓。憶与故人眠，此时犹晤语。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 27
    },
    {
        "title": "出鄂州界懷錶臣二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "離席一揮杯，別愁今尚醉。迟迟有情處，卻恨江帆駛。",
            "夢覺疑連榻，舟行忽千里。不見黃鶴樓，寒沙雪相似。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 28
    },
    {
        "title": "和游房公舊竹亭闻琴絕句",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "尚有竹間路，永无綦下塵。一闻流水曲，重憶餐霞人。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 29
    },
    {
        "title": "西州李尚书知愚与元武昌有舊遠示二篇吟之泫然因以繼和二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "如何贈琴日，已是絕弦时。无複雙金報，空餘掛劍悲。",
            "寶匣從此閑，朱弦谁複調。只應隨玉樹，同向土中銷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 30
    },
    {
        "title": "別蘇州二首",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "三载為吳郡，臨岐祖帳開。雖非謝桀黠，且為一裴回。",
            "流水閶門外，秋风吹柳條。從來送客處，今日自魂銷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 31
    },
    {
        "title": "罷和州游建康",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "秋水清无力，寒山暮多思。官閑不计程，遍上南朝寺。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 32
    },
    {
        "title": "九日登高",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "世路山河險，君門煙霧深。年年上高處，未省不傷心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 33
    },
    {
        "title": "答柳子厚",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "年方伯玉早，恨比四愁多。會待休車騎，相隨出罻羅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 34
    },
    {
        "title": "館娃宮在舊郡西南硯石山前瞰姑蘇臺傍有采香徑梁天監中置佛寺曰靈巖即故宮也信為絕境因賦二章",
        "author": "劉禹錫",
        "biography": "",
        "paragraphs": [
            "宮館貯嬌娃，當时意大誇。豔傾吳國盡，笑入楚王家。",
            "月殿移椒壁，天花代舜華。唯餘采香徑，一帶繞山斜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百六十四",
        "no#": 35
    }
]