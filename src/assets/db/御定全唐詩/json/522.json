[
    {
        "title": "揚州三首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "煬帝雷塘土，迷藏有舊樓。谁家唱水調，明月滿揚州。",
            "駿馬宜閑出，千金好舊游。喧闐醉年少，半脫紫茸裘。",
            "秋风放螢苑，春草鬥雞台。金絡擎雕去，鸞環拾翠來。",
            "蜀船紅錦重，越橐水沈堆。處處皆華表，淮王奈卻回。",
            "街垂千步柳，霞映两重城。天碧台閣麗，风涼歌管清。",
            "纖腰間長袖，玉佩雜繁纓。拖軸誠為壯，豪華不可名。",
            "自是荒淫罪，何妨作帝京。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 1
    },
    {
        "title": "潤州二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "句吳亭東千里秋，放歌曾作昔年遊。青苔寺裏无馬跡，",
            "月明更想桓伊在，一笛闻吹出塞愁。",
            "謝脁诗中佳麗地，夫差傳裏水犀军。城高鐵甕橫強弩，",
            "揚州塵土試回首，不惜千金借与君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 2
    },
    {
        "title": "題揚州禪智寺",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雨過一蟬噪，飄蕭松桂秋。青苔滿階砌，白鳥故迟留。",
            "暮靄生深樹，斜阳下小樓。谁知竹西路，歌吹是揚州。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 3
    },
    {
        "title": "西江懷古",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "上吞巴漢控瀟湘，怒似連山淨鏡光。魏帝縫囊真戲劇，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 4
    },
    {
        "title": "江南懷古",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "車书混一业无窮，井邑山川今古同。",
            "戊辰年向金陵過，惆悵閑吟憶庾公。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 5
    },
    {
        "title": "江南春絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "千里鶯啼綠映紅，水村山郭酒旗风。",
            "南朝四百八十寺，多少樓臺煙雨中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 6
    },
    {
        "title": "将赴宣州留題揚州禪智寺",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "故里溪頭松柏雙，來时盡日倚松窗。",
            "杜陵隋苑已絕國，秋晚南游更渡江。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 7
    },
    {
        "title": "題宣州開元寺水閣閣下宛溪夾溪居人",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "六朝文物草連空，天淡雲閑今古同。鳥去鳥來山色裏，",
            "惆悵无因見範蠡，參差煙樹五湖東。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 8
    },
    {
        "title": "宣州送裴坦判官往舒州，时牧欲赴官归京",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "日暖泥融雪半銷，行人芳草馬聲驕。九華山路雲遮寺，",
            "同來不得同归去，故國逢春一寂寥。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 9
    },
    {
        "title": "句溪夏日送盧霈秀才归王屋山将欲赴舉",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "野店正紛泊，繭蠶初引絲。行人碧溪渡，系馬綠楊枝。",
            "苒苒跡始去，悠悠心所期。秋山念君別，惆悵桂花时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 10
    },
    {
        "title": "自宣城赴官上京",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "瀟灑江湖十過秋，酒杯无日不淹留。謝公城畔溪驚夢，",
            "塵冠掛卻知闲事，終擬蹉跎訪舊遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 11
    },
    {
        "title": "春末題池州弄水亭",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "使君四十四，两佩左銅魚。為吏非循吏，論书讀底书。",
            "晚花紅豔靜，高樹綠阴初。亭宇清无比，溪山画不如。",
            "嘉賓能嘯詠，宮妓巧妝梳。逐日愁皆碎，隨时醉有餘。",
            "偃須求五鼎，陶只愛吾廬。趣向人皆異，賢豪莫笑渠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 12
    },
    {
        "title": "登池州九峰樓寄张祜",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "百感中來不自由，角聲孤起夕阳樓。碧山終日思无盡，",
            "谁人得似张公子，千首诗輕万戶侯。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 13
    },
    {
        "title": "齊安郡晚秋",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "柳岸风來影漸疏，使君家似野人居。雲容水態還堪賞，",
            "可怜赤壁爭雄渡，唯有蓑翁坐釣魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 14
    },
    {
        "title": "九日齊安登高",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "江涵秋影雁初飛，与客攜壺上翠微。塵世難逢開口笑，",
            "古往今來只如此，牛山何必淚沾衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 15
    },
    {
        "title": "池州春送前進士蒯希逸",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "芳草複芳草，斷腸還斷腸。自然堪下淚，何必更残阳。",
            "楚岸千万里，燕鴻三两行。有家归不得，況舉別君觴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 16
    },
    {
        "title": "齊安郡中偶題二首",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "两竿落日溪橋上，半縷輕煙柳影中。",
            "多少綠荷相倚恨，一时回首背西风。",
            "秋聲无不攪離心，夢澤蒹葭楚雨深。",
            "自滴階前大梧葉，幹君何事動哀吟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 17
    },
    {
        "title": "齊安郡後池絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "菱透浮萍綠錦池，夏鶯千囀弄薔薇。",
            "盡日无人看微雨，鴛鴦相對浴紅衣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 18
    },
    {
        "title": "題齊安城樓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "嗚咽江樓角一聲，微阳瀲瀲落寒汀。",
            "不用凭闌苦回首，故鄉七十五長亭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 19
    },
    {
        "title": "池州李使君沒後十一日處州新命始到後見归妓感而成诗",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "縉雲新命詔初行，才是孤魂壽器成。黃壤不知新雨露，",
            "多少四年遺愛事，鄉閭生子李為名。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 20
    },
    {
        "title": "見劉秀才与池州妓別",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "遠风南浦万重波，未似生離別恨多。楚管能吹柳花怨，",
            "待得枚皋相見日，自應妝鏡笑蹉跎。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 21
    },
    {
        "title": "池州廢林泉寺",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "廢寺林溪上，頹垣倚乱峰。看棲归樹鳥，犹想過山鐘。",
            "石路尋僧去，此生應不逢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 22
    },
    {
        "title": "憶齊安郡",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "平生睡足處，雲夢澤南州。一夜风欺竹，連江雨送秋。",
            "格卑常汩汩，力學強悠悠。終掉塵中手，瀟湘釣漫流。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 23
    },
    {
        "title": "池州清溪",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "弄溪終日到黃昏，照數秋來白发根。",
            "何物賴君千遍洗，筆頭塵土漸无痕。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 24
    },
    {
        "title": "游池州林泉寺金碧洞",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "袖拂霜林下石棱，潺湲聲斷滿溪冰。",
            "攜茶臘月游金碧，合有文章病茂陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 25
    },
    {
        "title": "即事",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "因思上党三年戰，閑詠周公七月诗。竹帛未闻书死節，",
            "莫笑一麾東下计，滿江秋浪碧參差。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 26
    },
    {
        "title": "贈李秀才",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "骨清年少眼如冰，鳳羽參差五色層。",
            "天上麒麟时一下，人間不独有徐陵。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 27
    },
    {
        "title": "寄李起居四韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "楚女梅簪白雪姿，前溪碧水凍醪时。雲罍心凸知難捧，",
            "自怜窮律窮途客，正怯孤燈一局棋。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 28
    },
    {
        "title": "題池州貴池亭",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "勢比淩歊宋武台，分明百里遠帆開。",
            "蜀江雪浪西江滿，強半春寒去卻來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 29
    },
    {
        "title": "蘭溪",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "蘭溪春盡碧泱泱，映水蘭花雨發香。",
            "楚國大夫憔悴日，應尋此路去瀟湘。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 30
    },
    {
        "title": "睦州四韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "州在釣台邊，溪山實可怜。有家皆掩映，无處不潺湲。",
            "好樹鳴幽鳥，晴樓入野煙。残春杜陵客，中酒落花前。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 31
    },
    {
        "title": "秋晚早發新定",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "解印书千軸，重阳酒百缸。涼风滿紅樹，曉月下秋江。",
            "岩壑會归去，塵埃終不降。懸纓未敢濯，嚴瀨碧淙淙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 32
    },
    {
        "title": "除官归京睦州雨霽",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "秋半吳天霽，清凝万里光。水聲侵笑语，嵐翠撲衣裳。",
            "遠樹疑羅帳，孤雲認粉囊。溪山侵两越，时節到重阳。",
            "顧我能甘賤，无由得自強。誤曾公觸尾，不敢夜循牆。",
            "豈意籠飛鳥，還為錦帳郎。網今開傅燮，书舊识黃香。",
            "姹女真虛语，饑兒欲一行。淺深須揭厲，休更學张綱。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 33
    },
    {
        "title": "夜泊桐廬眠先寄蘇台盧郎中",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "水檻桐廬館，归舟系石根。笛吹孤戍月，犬吠隔溪村。",
            "十载違清裁，幽懷未一論。蘇台菊花節，何處与開樽。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 34
    },
    {
        "title": "新轉南曹未敘朝散初秋暑退出守吳興书此篇以自見志",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "捧詔汀洲去，全家羽翼飛。喜拋新錦帳，榮借舊朱衣。",
            "且免材為累，何妨拙有机。宋株聊自守，魯酒怕旁圍。",
            "清尚寧无素，光阴亦未晞。一杯寬幕席，五字弄珠璣。",
            "越浦黃柑嫩，吳溪紫蟹肥。平生江海志，佩得左魚归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 35
    },
    {
        "title": "題白蘋洲",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "山鳥飛紅帶，亭薇拆紫花。溪光初透徹，秋色正清華。",
            "靜處知生樂，喧中見死誇。无多珪組累，終不負煙霞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 36
    },
    {
        "title": "題茶山",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "山實東吳秀，茶稱瑞草魁。剖符雖俗吏，修貢亦仙才。",
            "溪盡停蠻棹，旗张卓翠苔。柳村穿窈窕，松澗渡喧豗。",
            "等級雲峰峻，寬平洞府開。拂天闻笑语，特地見樓臺。",
            "泉嫩黃金湧，牙香紫璧裁。拜章期沃日，輕騎疾奔雷。",
            "舞袖嵐侵澗，歌聲谷答回。磬音藏葉鳥，雪豔照潭梅。",
            "好是全家到，兼為奉詔來。樹阴香作帳，花徑落成堆。",
            "景物残三月，登臨愴一杯。重遊難自克，俯首入塵埃。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 37
    },
    {
        "title": "茶山下作",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "春风最窈窕，日曉柳村西。嬌雲光占岫，健水鳴分溪。",
            "燎岩野花遠，戛瑟幽鳥啼。把酒坐芳草，亦有佳人攜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 38
    },
    {
        "title": "入茶山下題水口草市絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "倚溪侵嶺多高樹，誇酒书旗有小樓。",
            "驚起鴛鴦豈无恨，一雙飛去卻回頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 39
    },
    {
        "title": "春日茶山病不飲酒，因呈賓客",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "笙歌登画船，十日清明前。山秀白雲膩，溪光紅粉鮮。",
            "欲開未開花，半阴半晴天。谁知病太守，犹得作茶仙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 40
    },
    {
        "title": "不飲贈官妓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "芳草正得意，汀洲日欲西。无端千樹柳，更拂一條溪。",
            "幾朵梅堪折，何人手好攜。谁怜佳麗地，春恨卻淒淒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 41
    },
    {
        "title": "早春贈军事薛判官",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雪後新正半，春來四刻長。晴梅朱粉豔，嫩水碧羅光。",
            "弦管開雙調，花鈿坐两行。唯君莫惜醉，認取少年場。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 42
    },
    {
        "title": "代吳興妓春初寄薛军事",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "霧冷侵紅粉，春阴撲翠鈿。自悲臨曉鏡，谁与惜流年。",
            "柳暗霏微雨，花愁黯淡天。金釵有幾隻，抽當酒家錢。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 43
    },
    {
        "title": "八月十二日得替後移居霅溪館，因題長句四韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "万家相慶喜秋成，處處樓臺歌板聲。千歲鶴归犹有恨，",
            "景物登臨閑始見，愿為閑客此閑行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 44
    },
    {
        "title": "初冬夜飲",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "淮阳多病偶求歡，客袖侵霜与燭盤。",
            "砌下梨花一堆雪，明年谁此凭闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 45
    },
    {
        "title": "栽竹",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "本因遮日種，卻似為溪移。歷歷羽林影，疏疏煙露姿。",
            "蕭騷寒雨夜，敲劼晚风时。故國何年到，塵冠掛一枝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 46
    },
    {
        "title": "梅",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "輕盈照溪水，掩斂下瑤台。妒雪聊相比，欺春不逐來。",
            "偶同佳客見，似為凍醪開。若在秦樓畔，堪為弄玉媒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 47
    },
    {
        "title": "山石榴",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "似火山榴映小山，繁中能薄豔中閑。",
            "一朵佳人玉釵上，只疑燒卻翠雲鬟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 48
    },
    {
        "title": "柳長句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "日落水流西複東，春光不盡柳何窮。巫娥廟裏低含雨，",
            "灞上漢南千万樹，幾人遊宦別離中。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 49
    },
    {
        "title": "隋堤柳",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "夾岸垂楊三百里，只應圖画最相宜。",
            "自嫌流落西归疾，不見東风二月时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 50
    },
    {
        "title": "柳絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "數樹新開翠影齊，倚风情態被春迷。",
            "依依故國樊川恨，半掩村橋半掩溪。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 51
    },
    {
        "title": "独柳",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "含煙一株柳，拂地搖风久。佳人不忍折，悵望回纖手。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 52
    },
    {
        "title": "早雁",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "金河秋半虜弦開，雲外驚飛四散哀。仙掌月明孤影過，",
            "莫厭瀟湘少人處，水多菰米岸莓苔。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 53
    },
    {
        "title": "鵁鶄",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "芝莖抽紺趾，清唳擲金梭。日翅閑张錦，风池去罥羅。",
            "靜眠依翠荇，暖戲折高荷。山阴豈无爾，繭字换群鵝。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 54
    },
    {
        "title": "鸚鵡",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "華堂日漸高，雕檻系紅絛。故國隴山樹，美人金剪刀。",
            "避籠交翠尾，罅嘴靜新毛。不念三緘事，世途皆爾曹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 55
    },
    {
        "title": "鶴",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "清音迎曉月，愁思立寒蒲。丹頂西施頰，霜毛四皓須。",
            "碧雲行止躁，白鹭性靈粗。終日无群伴，溪邊吊影孤。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 56
    },
    {
        "title": "鴉",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "擾擾複翻翻，黃昏颺冷煙。毛欺皇后發，聲感楚姬弦。",
            "蔓壘盤风下，霜林接翅眠。只如西旅樣，頭白豈无緣。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 57
    },
    {
        "title": "鹭鷥",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雪衣雪發青玉觜，群捕魚兒溪影中。",
            "驚飛遠映碧山去，一樹梨花落晚风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 58
    },
    {
        "title": "村舍燕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "漢宮一百四十五，多下珠簾閉瑣窗。",
            "何處營巢夏将半，茅簷煙裏语雙雙。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 59
    },
    {
        "title": "归燕",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "画堂歌舞喧喧地，社去社來人不看。",
            "長是江樓使君伴，黃昏犹待倚闌幹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 60
    },
    {
        "title": "傷猿",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "独折南園一朵梅，重尋幽坎已生苔。",
            "无端晚吹驚高樹，似嫋長枝欲下來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 61
    },
    {
        "title": "還俗老僧",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雪發不長寸，秋寒力更微。独尋一徑葉，犹挈衲残衣。",
            "日暮千峰裏，不知何處归。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 62
    },
    {
        "title": "斫竹",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "寺廢竹色死，宦家寧爾留。霜根漸隨斧，风玉尚敲秋。",
            "江南苦吟客，何處送悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 63
    },
    {
        "title": "将赴湖州留題亭菊",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "陶菊手自種，楚蘭心有期。遙知渡江日，正是擷芳时。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 64
    },
    {
        "title": "折菊",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "籬東菊徑深，折得自孤吟。雨中衣半濕，擁鼻自知心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 65
    },
    {
        "title": "雲",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "盡日看雲首不回，无心都大似无才。",
            "可怜光彩一片玉，万里晴天何處來。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 66
    },
    {
        "title": "醉後題僧院",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "離心忽忽複淒淒，雨晦傾瓶取醉泥。",
            "可羨高僧共心语，一如攜稚往東西。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 67
    },
    {
        "title": "題禪院",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "觥船一棹百分空，十歲青春不負公。",
            "今日鬢絲禪榻畔，茶煙輕颺落花风。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 68
    },
    {
        "title": "哭李給事中敏",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "阳陵郭門外，陂阤丈五墳。九泉如結友，茲地好埋君。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 69
    },
    {
        "title": "黃州竹徑鬥",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "竹濁蟠小徑，屈折鬥蛇來。三年得归去，知繞幾千回。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 70
    },
    {
        "title": "題敬愛寺樓",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "暮景千山雪，春寒百尺樓。独登還独下，谁會我悠悠。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 71
    },
    {
        "title": "送劉秀才归江陵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "彩服鮮華覲渚宮，鱸魚新熟別江東。劉郎浦夜侵船月，",
            "谁人世上為金口，借取明时一薦雄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 72
    },
    {
        "title": "見吳秀才与池妓別，因成絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "紅燭短时羌笛怨，清歌咽處蜀弦高。",
            "万里分飛两行淚，滿江寒雨正蕭騷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 73
    },
    {
        "title": "湖南正初招李郢秀才",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "行樂及时时已晚，對酒當歌歌不成。千里暮山重疊翠，",
            "看著白蘋芽欲吐，雪舟相訪勝閑行。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 74
    },
    {
        "title": "贈朱道靈",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "劉根丹篆三千字，郭璞青囊两卷书。",
            "朱渚磯南謝山北，白雲深處有岩居。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 75
    },
    {
        "title": "屏风絕句",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "屏风周昉画纖腰，歲久丹青色半銷。",
            "斜倚玉窗鸞發女，拂塵犹自妒嬌嬈。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 76
    },
    {
        "title": "哭韓綽",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "平明送葬上都門，紼翣交橫逐去魂。",
            "归來冷笑悲身事，喚婦呼兒索酒盆。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 77
    },
    {
        "title": "新定途中",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "无端偶效张文紀，下杜鄉園別五秋。",
            "重過江南更千里，万山深處一孤舟。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 78
    },
    {
        "title": "題新定八松院小石",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "雨滴珠璣碎，苔生紫翠重。故關何日到，且看小三峰。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 79
    },
    {
        "title": "往年隨故府吳興公夜泊蕪湖口今赴官西去再宿蕪湖感舊傷懷因成十六韵",
        "author": "杜牧",
        "biography": "",
        "paragraphs": [
            "南指陵阳路，東流似昔年。重恩山未答，雙鬢雪飄然。",
            "數仞慚投跡，群公愧拍肩。駑駘蒙錦繡，塵土浴潺湲。",
            "郭隗黃金峻，虞卿白璧鮮。貔貅環玉帳，鸚鵡破蠻箋。",
            "極浦沈碑會，秋花落帽筵。旌旗明迥野，冠佩照神仙。",
            "籌画言何補，優容道實全。謳謠人撲地，雞犬樹連天。",
            "紫鳳超如電，青襟散似煙。蒼生未經濟，墳草已芊綿。",
            "往事惟沙月，孤燈但客船。峴山雲影畔，棠葉水聲前。",
            "故國還归去，浮生亦可怜。高歌一曲淚，明日夕阳邊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷五百二十二",
        "no#": 80
    }
]